<Project Sdk="Microsoft.NET.Sdk">

  <!--
    REPRODUCTION PROOF PROJECT. NOT PART OF THE SOLUTION TEST WORKFLOW.

    This project exists solely to reproduce and diagnose the open weight model
    streaming failures observed through the Cline gateway (unknown
    ChatFinishReason values, premature stream termination) against real provider
    configuration rows from the development database. It is deliberately NOT
    referenced by Lorekeeper.sln, is never run by the build/test pipeline, and
    must not be treated as part of the repository's approved automated test
    boundary (see AGENTS.md). Run it manually and explicitly, for example:

      dotnet test Lorekeeper.WireRepro /filter:TestName

    Real gateway tests are additionally gated behind the LK_TEST_CLINE_KEY
    environment variable and skip silently when it is absent.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)repro.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
  </ItemGroup>

</Project>
