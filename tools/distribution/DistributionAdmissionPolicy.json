{
  "schemaVersion": 1,
  "policyId": "lorekeeper-distribution-gate-v1",
  "purpose": "Engineering distribution gate for the exact local release inputs. This is not legal advice and does not select the application's source license or replace review of the complete license text.",
  "prohibitedRestrictionClasses": [
    "source-disclosure",
    "network-use",
    "field-of-use",
    "commercial"
  ],
  "requiredEvidence": [
    "An exact version and source identity is recorded.",
    "A machine-readable SPDX expression or an authoritative retained license text is available.",
    "Attribution and notice obligations are recorded for the shipped closure.",
    "The selected expression has no prohibited restriction class in this policy."
  ],
  "dependencyCategories": [
    {
      "id": "NuGet",
      "description": "Managed .NET packages resolved from project.assets.json and the local NuGet cache."
    },
    {
      "id": "npm",
      "description": "Semantic-editor packages resolved from package-lock.json and installed package metadata."
    },
    {
      "id": "Cargo",
      "description": "Rust crates resolved from the locked Lorekeeper Press graph."
    },
    {
      "id": "native-vendored",
      "description": "Native executables or vendored runtimes shipped in a platform closure."
    },
    {
      "id": "fonts",
      "description": "Bundled font files and their adjacent license/source records."
    },
    {
      "id": "ICC",
      "description": "Bundled ICC profiles and their source/redistribution records."
    },
    {
      "id": "assets",
      "description": "Other shipped web, branding, documentation, and distribution assets."
    }
  ],
