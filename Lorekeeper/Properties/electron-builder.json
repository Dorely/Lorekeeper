{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "productName": "Lorekeeper",
  "appId": "com.lorekeeper.app",
  "compression": "maximum",
  "directories": {
    "buildResources": "bin/wwwroot/branding"
  },
  "publish": {
    "provider": "github",
    "owner": "Dorely",
    "repo": "Lorekeeper-Releases",
    "private": false,
    "releaseType": "release"
  },
  "files": [
    "!bin{,/**/*}",
    "!win-unpacked{,/**/*}",
    "!*.exe",
    "!*.blockmap",
    "!latest*.yml",
    "!latest*.yaml"
  ],
  "win": {
    "icon": "icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico",
    "installerHeaderIcon": "icon.ico"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "icon.png",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Office",
    "executableArgs": [
      "--no-sandbox"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "mac": {
    "icon": "icon.png",
    "identity": "-",
    "target": "dmg",
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
