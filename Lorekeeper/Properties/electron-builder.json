{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "productName": "Lorekeeper",
  "appId": "com.lorekeeper.app",
  "extraMetadata": {
    "desktopName": "com.lorekeeper.app.desktop"
  },
  "compression": "maximum",
  "directories": {
    "buildResources": "bin/wwwroot/branding"
  },
  "publish": {
    "provider": "github",
    "owner": "Dorely",
    "repo": "Lorekeeper",
    "private": false,
    "releaseType": "release"
  },
  "files": [
    "!bin{,/**/*}",
    "!win-unpacked{,/**/*}",
    "!*.exe",
    "!*.blockmap",
    "!latest*.yml",
    "!latest*.yaml"
  ],
  "win": {
    "icon": "icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "installerIcon": "icon.ico",
    "uninstallerIcon": "icon.ico",
    "installerHeaderIcon": "icon.ico"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "icon.png",
    "syncDesktopName": true,
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Office",
    "files": [
      "!packaging{,/**/*}"
    ],
    "extraFiles": [
      {
        "from": "packaging/linux/AppRun.sh",
        "to": "AppRun"
      }
    ],
    "maintainer": "Dorely <Dorely@users.noreply.github.com>",
    "vendor": "Dorely",
    "publish": null
  },
  "appImage": {
    "executableArgs": [],
    "artifactName": "${productName}-${version}-x86_64.${ext}"
  },
  "toolsets": {
    "appimage": "1.0.3"
  },
  "deb": {
    "artifactName": "${productName}-${version}-amd64.${ext}",
    "depends": [
      "libgtk-3-0t64",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64",
      "libuuid1",
      "libsecret-1-0",
      "libfontconfig1",
      "ca-certificates",
      "libc6",
      "libgcc-s1",
      "libgssapi-krb5-2",
      "libicu74",
      "libssl3t64",
      "libstdc++6",
      "tzdata",
      "zlib1g",
      "libasound2t64",
      "libgbm1",
      "libxkbcommon0",
      "libdrm2",
      "libnspr4",
      "libatk-bridge2.0-0t64",
      "libcups2t64"
    ]
  },
  "mac": {
    "icon": "icon.png",
    "files": [
      "!packaging{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "packaging/macos",
        "to": ".",
        "filter": [
          "LICENSE.electron.txt",
          "LICENSES.chromium.html"
        ]
      }
    ],
    "identity": "-",
    "hardenedRuntime": false,
    "publish": null,
    "target": "dmg",
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
