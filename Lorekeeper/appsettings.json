{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lorekeeper.db"
  },
  "Persistence": {
    "Provider": "Sqlite"
  },
  "Blazor": {
    "MaximumReceiveMessageSizeBytes": 67108864
  },
  "Embeddings": {
    "OllamaUrl": "http://localhost:11434",
    "ModelName": "nomic-embed-text",
    "Dimensions": 768,
    "MaxChunkChars": 6000,
    "ChunkSize": 1200,
    "ChunkOverlap": 200
  },
  "AiConsole": {
    "MaxToolIterations": 100
  }
}
