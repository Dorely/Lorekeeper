{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lorekeeper.db"
  },
  "Persistence": {
    "Provider": "Sqlite"
  },
  "Blazor": {
    "MaximumReceiveMessageSizeBytes": 67108864
  },
  "Ingest": {
    "Sectioning": {
      "TargetTokens": 10000,
      "SoftMaxRatio": 1.5,
      "SmallSectionRatio": 0.15
    }
  },
  "Embeddings": {
    "MaxChunkChars": 6000,
    "RequestBatchSize": 8,
    "DelayBetweenRequestsMilliseconds": 250,
    "ChunkSize": 1200,
    "ChunkOverlap": 200,
    "Rebuild": {
      "BatchSize": 4,
      "DelayBetweenBatchesMilliseconds": 500,
      "MaxRetries": 3,
      "RetryDelayMilliseconds": 1000
    }
  },
  "Agents": {
    "MaxToolIterations": 100,
    "IngestMaxTransientRetries": 3,
    "IngestRetryBaseDelayMs": 1000,
    "IngestRetryMaxDelayMs": 8000,
    "EditorChat": {
      "ReadChapterPageMaxChars": 6000,
      "MaxToolResultCharsForModel": 12000,
      "RevisionAgents": {
        "MaxConcurrency": 2,
        "MaxToolIterations": 12
      }
    }
  },
  "Research": {
    "Web": {
      "UserAgent": "LorekeeperResearch/1.0",
      "RequestTimeoutSeconds": 30,
      "MaxPageBytes": 2000000,
      "MaxLinksReturned": 80,
      "ReadPageMaxChars": 10000,
      "RetryAttempts": 1,
      "RetryDelayMilliseconds": 1500,
      "BlockPrivateNetworkTargets": true
    }
  }
}
