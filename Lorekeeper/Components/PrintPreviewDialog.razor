@using Lorekeeper.Printing
@implements IAsyncDisposable
@inject IPrintPreparationService Printing
@inject IPrintHost PrintHost
@inject IJSRuntime JS

@if (_open)
{
    <div class="print-preview-backdrop" @onclick="CloseAsync" @onclick:stopPropagation="true">
        <section class="print-preview-dialog" role="dialog" aria-modal="true" aria-labelledby="print-preview-title" @onclick:stopPropagation="true" @ref="_dialog">
            <header class="print-preview-header">
                <div><span class="eyebrow">Print preview</span><h2 id="print-preview-title">@(_source?.Title ?? "Print")</h2></div>
                <button class="btn-close" type="button" aria-label="Close print preview" @onclick="CloseAsync"></button>
            </header>
            <div class="print-preview-body">
                <aside class="print-preview-settings" aria-label="Print settings">
                    @if (_source is null)
                    { <p role="status">@(_error is null ? "Loading print preview…" : "Could not load print preview.")</p> }
                    else
                    {
                        <fieldset disabled="@_submitting">
                            <label>Paper<select @bind="_settings.Paper" @bind:after="RefreshAsync"><option>Letter</option><option>A4</option><option>Legal</option><option>A3</option></select></label>
                            <label class="check"><input type="checkbox" @bind="_settings.Landscape" @bind:after="RefreshAsync" /> Landscape</label>
                            <label>Margins (in)<input type="number" min="0" max="2" step=".05" @bind="_settings.MarginInches" @bind:after="RefreshAsync" /></label>
                            <label>Fit<select @bind="_settings.Fit" @bind:after="RefreshAsync"><option value="@PrintFit.Fit">Fit entire source</option><option value="@PrintFit.Fill">Fill paper</option>
                                @if (_source.HasPhysicalSize)
                                { <option value="@PrintFit.ActualSize">Actual size</option> }
                            </select></label>
                        @if (_source.Pages.Count > 1)
                        {
                            <label>Pages<select @bind="_settings.Selection" @bind:after="RefreshAsync"><option value="@PrintSelection.Current">Current page</option><option value="@PrintSelection.All">All pages</option><option value="@PrintSelection.Range">Page range</option></select></label>
                        }
                        @if (_settings.Selection == PrintSelection.Range)
                        {
                            <label>Range<input @bind="_settings.Range" @bind:after="RefreshAsync" placeholder="1-3, 5" /></label>
                        }
                        @if (_source.Pages.Count > 1 && _settings.Selection == PrintSelection.Current)
                        {
                            <label>Source current page<input type="number" min="1" max="@_source.Pages.Count" @bind="_settings.CurrentPage" @bind:after="RefreshAsync" /></label>
                        }
                        @if (_job?.Warnings is { Count: > 0 } warnings)
                        { <div class="print-preview-warnings" role="status">@foreach (var warning in warnings) { <p>@warning</p> }</div> }
                        </fieldset>
                    }
                    @if (_error is not null)
                    { <p class="print-preview-error" role="alert">@_error</p> }
                    <p class="print-preview-hint">Choose the printer, copies, and two-sided printing in the system dialog. Changes there determine the final output.</p>
                </aside>
                <main class="print-preview-canvas" aria-live="polite">
                    @if (_busy)
                    {
                        <p role="status">Preparing preview…</p>
                    }
                    else if (_job is { } job && job.PageUrls.Count > 0)
                    {
                        <img src="@job.PageUrls[Math.Clamp(_previewIndex, 0, job.PageUrls.Count - 1)]" alt="Print preview page @(_previewIndex + 1)" />
                    }
                    else if (_source is not null)
                    {
                        <p role="status">Preview unavailable.</p>
                    }
                </main>
            </div>
            <footer class="print-preview-footer">
                @if (_job is { PageUrls.Count: > 1 })
                {
                    <div class="print-preview-nav">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangePageAsync(-1)" disabled="@(_previewIndex == 0 || _busy)">Previous</button>
                        <span>Preview page @(_previewIndex + 1) of @_job.PageUrls.Count</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangePageAsync(1)" disabled="@(_previewIndex >= _job.PageUrls.Count - 1 || _busy)">Next</button>
                    </div>
                }
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Cancel</button>
                <button class="btn btn-primary" @onclick="PrintAsync" disabled="@(_job is null || _busy || _submitting || _error is not null)">@(_submitting ? "Printer dialog open…" : _busy ? "Preparing…" : "Print")</button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public Func<CancellationToken, Task<PrintSource>> SourceFactory { get; set; } = null!;
    [Parameter] public EventCallback Closed { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _operation;
    private PrintSource? _source;
    private PrintPreparedJob? _job;
    private PrintSettings _settings = new();
    private int _previewIndex;
    private long _generation;
    private string? _error;
    private bool _busy;
    private bool _submitting;
    private bool _open = true;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/print-preview.js");
            await _module.InvokeVoidAsync("trapFocus", _dialog);
            var loadedSource = await SourceFactory(_lifetime.Token);
            if (_lifetime.IsCancellationRequested) { loadedSource.Dispose(); return; }
            _source = loadedSource;
            _settings.Paper = await _module.InvokeAsync<string>("defaultPaper");
            var page = _source.Pages.Count == 0 ? null : _source.Pages[Math.Clamp(_source.InitialPage - 1, 0, _source.Pages.Count - 1)];
            _settings.Landscape = page is { } p && p.WidthPoints > p.HeightPoints;
            _settings.CurrentPage = Math.Clamp(_source.InitialPage, 1, Math.Max(1, _source.Pages.Count));
            _previewIndex = 0;
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (!_open || _disposed) { }
        catch (Exception ex) { if (_open && !_disposed) { _error = ex.Message; _busy = false; await InvokeAsync(StateHasChanged); } }
    }

    private async Task RefreshAsync()
    {
        if (_source is null || _submitting || !_open || _disposed) return;
        if (_settings.Fit == PrintFit.ActualSize && !_source.HasPhysicalSize)
            _settings.Fit = PrintFit.Fit;
        var generation = ++_generation;
        if (_job is { } oldJob) { Printing.Release(oldJob); _job = null; }
        _operation?.Cancel();
        using var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _operation = operation;
        var source = _source;
        _busy = true; _error = null; _job = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var settings = new PrintSettings { Paper = _settings.Paper, Landscape = _settings.Landscape, MarginInches = _settings.MarginInches, Fit = _settings.Fit, Selection = _settings.Selection, Range = _settings.Range, CurrentPage = _settings.CurrentPage };
            var job = await Printing.PrepareAsync(source, settings, operation.Token);
            if (generation != _generation || !_open || _disposed) { Printing.Release(job); return; }
            _job = job;
            _previewIndex = 0;
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested) { }
        catch (Exception ex) { if (generation == _generation) _error = ex.Message; }
        finally
        {
            if (ReferenceEquals(_operation, operation)) _operation = null;
            if (generation == _generation && _open && !_disposed) { _busy = false; await InvokeAsync(StateHasChanged); }
        }
    }

    private Task ChangePageAsync(int delta) { if (_job is { PageUrls.Count: > 0 } job) _previewIndex = Math.Clamp(_previewIndex + delta, 0, job.PageUrls.Count - 1); return InvokeAsync(StateHasChanged); }

    private async Task PrintAsync()
    {
        if (_job is null || _busy || _submitting || !_open || _error is not null) return;
        var job = _job;
        _submitting = true; await InvokeAsync(StateHasChanged);
        try { await PrintHost.PrintAsync(job, _lifetime.Token); await CloseAsync(); }
        catch (OperationCanceledException) { await CloseAsync(); }
        catch (Exception ex)
        {
            Printing.Release(job); _job = null;
            if (_open && !_disposed) _error = ex.Message;
        }
        finally
        {
            _submitting = false;
            if (!_open || _disposed) { Printing.Release(job); _job = null; }
            else await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CloseAsync()
    {
        if (!_open || _disposed) return;
        _open = false; ++_generation; _lifetime.Cancel(); _operation?.Cancel();
        if (!_submitting && _job is { } job) { Printing.Release(job); _job = null; }
        _source?.Dispose(); _source = null;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("releaseFocus", _dialog); }
            catch (JSDisconnectedException) { }
        }
        await Closed.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true; _open = false; ++_generation;
        _lifetime.Cancel(); _operation?.Cancel();
        if (!_submitting && _job is { } job) Printing.Release(job);
        _source?.Dispose(); _source = null;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("releaseFocus", _dialog); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _lifetime.Dispose();
    }
}
