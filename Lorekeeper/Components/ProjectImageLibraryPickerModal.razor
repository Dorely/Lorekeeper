@using Lorekeeper.Images
@inject IProjectImageService Images

@if (IsOpen)
{
    <div class="project-image-picker-backdrop" @onclick="CloseAsync">
        <section class="project-image-picker" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <header class="project-image-picker-header">
                <h5>@Title</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
            </header>

            <div class="project-image-picker-toolbar">
                <input type="search" class="form-control form-control-sm" placeholder="Search images..."
                       @bind="_query" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync">Refresh</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger py-2 mb-0">@_error</div>
            }

            @if (_loading)
            {
                <p class="text-muted"><em>Loading images...</em></p>
            }
            else if (FilteredImages.Count == 0)
            {
                <div class="project-image-picker-empty">No available images found.</div>
            }
            else
            {
                <div class="project-image-picker-grid">
                    @foreach (var image in FilteredImages)
                    {
                        var selected = _selected?.Id == image.Id;
                        <button type="button" class="project-image-picker-card @(selected ? "selected" : null)"
                                aria-pressed="@selected" @onclick="() => Select(image)" @key="image.Id">
                            <img src="@image.PreviewUrl" alt="@ImageAlt(image)" />
                            <span class="project-image-picker-card-body">
                                <strong>@image.FileName</strong>
                                @if (!string.IsNullOrWhiteSpace(image.AltText))
                                {
                                    <span>@image.AltText</span>
                                }
                            </span>
                        </button>
                    }
                </div>
            }

            <footer class="project-image-picker-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseAsync">Cancel</button>
                @if (!string.IsNullOrWhiteSpace(SecondaryActionLabel) && OnSecondaryAction.HasDelegate)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            disabled="@(_selected is null || !SecondaryActionEnabled || _acting)"
                            @onclick="RunSecondaryAsync">@SecondaryActionLabel</button>
                }
                <button type="button" class="btn btn-sm btn-primary"
                        disabled="@(_selected is null || !PrimaryActionEnabled || _acting)"
                        @onclick="RunPrimaryAsync">@PrimaryActionLabel</button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Choose an image";
    [Parameter] public string PrimaryActionLabel { get; set; } = "Choose image";
    [Parameter] public bool PrimaryActionEnabled { get; set; } = true;
    [Parameter] public string? SecondaryActionLabel { get; set; }
    [Parameter] public bool SecondaryActionEnabled { get; set; } = true;
    [Parameter] public IReadOnlyCollection<Guid> ExcludedImageIds { get; set; } = [];
    [Parameter] public EventCallback<ProjectImageView> OnPrimaryAction { get; set; }
    [Parameter] public EventCallback<ProjectImageView> OnSecondaryAction { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<ProjectImageView> _images = [];
    private ProjectImageView? _selected;
    private bool _loading;
    private bool _acting;
    private bool _wasOpen;
    private string _query = string.Empty;
    private string? _error;

    private IReadOnlyList<ProjectImageView> FilteredImages => _images
        .Where(image => !ExcludedImageIds.Contains(image.Id))
        .Where(image => string.IsNullOrWhiteSpace(_query)
            || image.FileName.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || image.AltText.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || image.Prompt.Contains(_query, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _selected = null;
            _query = string.Empty;
            await ReloadAsync();
        }
        _wasOpen = IsOpen;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _images = await Images.ListAsync(ProjectId);
            if (_selected is not null && ExcludedImageIds.Contains(_selected.Id))
                _selected = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Select(ProjectImageView image) => _selected = _selected?.Id == image.Id ? null : image;

    private Task RunPrimaryAsync() => RunActionAsync(OnPrimaryAction);

    private Task RunSecondaryAsync() => RunActionAsync(OnSecondaryAction);

    private async Task RunActionAsync(EventCallback<ProjectImageView> action)
    {
        if (_selected is null || _acting || !action.HasDelegate) return;
        _acting = true;
        _error = null;
        try
        {
            await action.InvokeAsync(_selected);
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private static string ImageAlt(ProjectImageView image) =>
        string.IsNullOrWhiteSpace(image.AltText) ? image.FileName : image.AltText;
}
