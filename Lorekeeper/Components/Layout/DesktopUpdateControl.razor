@implements IDisposable
@using Lorekeeper.Desktop
@inject IDesktopUpdateService DesktopUpdates
@inject ILogger<DesktopUpdateControl> Logger

@{
    var snapshot = DesktopUpdates.Snapshot;
    var installedVersion = DesktopUpdates.InstalledVersion ?? snapshot.Version;
    var canCheck = DesktopUpdates.CanCheckForUpdates;
}

@if (snapshot.Status == DesktopUpdateStatus.ManualUpdateAvailable)
{
    <div class="desktop-update-control desktop-update-available">
        @if (!string.IsNullOrWhiteSpace(installedVersion))
        {
            <span class="desktop-update-version" title="@InstalledTitle(installedVersion)">v@(installedVersion)</span>
        }
        <button type="button"
                class="btn btn-sm btn-primary desktop-update-button"
                disabled="@(!RendererInfo.IsInteractive || _openingDownload)"
                title="@DownloadTitle(snapshot.Version)"
                aria-label="@DownloadTitle(snapshot.Version)"
                @onclick="OpenDownloadAsync">
            Download Update
        </button>
    </div>
}
else if (snapshot.Status == DesktopUpdateStatus.StoreManaged)
{
    <div class="desktop-update-control desktop-update-idle">
        @if (!string.IsNullOrWhiteSpace(installedVersion))
        {
            <span class="desktop-update-version" title="@InstalledTitle(installedVersion)">v@(installedVersion)</span>
        }
        <span class="desktop-update-label">Updates managed by Microsoft Store</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(installedVersion) || canCheck || snapshot.Status is DesktopUpdateStatus.Checking or DesktopUpdateStatus.Error)
{
    var checking = snapshot.Status == DesktopUpdateStatus.Checking || _checkingForUpdates;
    var showCheckButton = canCheck && snapshot.Status is DesktopUpdateStatus.Idle or DesktopUpdateStatus.Error or DesktopUpdateStatus.Unsupported;

    <div class="desktop-update-control desktop-update-idle" aria-live="polite">
        @if (!string.IsNullOrWhiteSpace(installedVersion))
        {
            <span class="desktop-update-version" title="@InstalledTitle(installedVersion)">v@(installedVersion)</span>
        }
        @if (checking)
        {
            <button type="button"
                    class="btn btn-sm btn-outline-secondary desktop-update-button"
                    disabled="disabled"
                    title="Checking for Lorekeeper updates">
                Checking…
            </button>
        }
        else if (showCheckButton)
        {
            <button type="button"
                    class="btn btn-sm btn-outline-secondary desktop-update-button"
                    disabled="@(!RendererInfo.IsInteractive)"
                    title="@CheckTitle(snapshot.Error)"
                    aria-label="Check for Lorekeeper updates"
                    @onclick="CheckForUpdatesAsync">
                Check for updates
            </button>
        }
    </div>
}

@code {
    private bool _disposed;
    private bool _openingDownload;
    private bool _checkingForUpdates;

    protected override void OnInitialized()
    {
        DesktopUpdates.StateChanged += OnDesktopUpdateStateChanged;
    }

    private void OnDesktopUpdateStateChanged(object? sender, EventArgs args)
    {
        if (_disposed) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CheckForUpdatesAsync()
    {
        if (!RendererInfo.IsInteractive || _checkingForUpdates) return;

        _checkingForUpdates = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await DesktopUpdates.CheckForUpdatesAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Manual Lorekeeper update check failed.");
        }
        finally
        {
            _checkingForUpdates = false;
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenDownloadAsync()
    {
        if (!RendererInfo.IsInteractive || !DesktopUpdates.Snapshot.CanDownload || _openingDownload) return;

        _openingDownload = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await DesktopUpdates.OpenDownloadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not open the Lorekeeper release download page.");
        }
        finally
        {
            _openingDownload = false;
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private static string InstalledTitle(string? version) =>
        version is { Length: > 0 }
            ? $"Installed Lorekeeper version {version}"
            : "Installed Lorekeeper version";

    private static string CheckTitle(string? error) =>
        error is { Length: > 0 }
            ? $"Check for Lorekeeper updates (last check failed: {error})"
            : "Check for Lorekeeper updates now";

    private static string DownloadTitle(string? version) =>
        version is { Length: > 0 }
            ? $"Download Lorekeeper {version} in your default browser"
            : "Download the latest Lorekeeper update in your default browser";

    public void Dispose()
    {
        _disposed = true;
        DesktopUpdates.StateChanged -= OnDesktopUpdateStateChanged;
    }
}
