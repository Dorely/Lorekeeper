@inherits LayoutComponentBase
@implements IDisposable
@using Lorekeeper.Desktop
@inject IDesktopUpdateService DesktopUpdates
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="app-topbar">
        <a class="app-brand" href="/" aria-label="Lorekeeper projects">
            <span class="app-brand-mark" aria-hidden="true">
                <img src="/branding/icon.svg" alt="" />
            </span>
            <span>Lorekeeper</span>
        </a>

        @if (!IsHomeRoute())
        {
            <nav class="app-topbar-nav" aria-label="Global navigation">
                <a href="/">Projects</a>
                @if (IsSettingsRoute())
                {
                    <span aria-hidden="true">/</span>
                    <span>Configuration</span>
                }
            </nav>
        }

        @if (DesktopUpdates.Snapshot.CanRestart)
        {
            <button type="button"
                    class="btn btn-sm btn-primary app-update-button"
                    disabled="@_restartingToUpdate"
                    title="@(DesktopUpdates.Snapshot.Version is { Length: > 0 } version ? $"Install Lorekeeper {version}" : "Install the downloaded Lorekeeper update")"
                    @onclick="RestartToUpdateAsync">
                @(_restartingToUpdate ? "Restarting…" : "Restart to Update")
            </button>
        }
    </header>

    <main>
        <article class="@ContentClass()">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <strong>Something went wrong.</strong>
    <span>Reload Lorekeeper to reconnect.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>

@code {
    private bool _restartingToUpdate;

    protected override void OnInitialized()
    {
        DesktopUpdates.StateChanged += OnDesktopUpdateStateChanged;
    }

    private void OnDesktopUpdateStateChanged(object? sender, EventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private async Task RestartToUpdateAsync()
    {
        if (_restartingToUpdate || !DesktopUpdates.Snapshot.CanRestart) return;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Lorekeeper will close, install the downloaded update, and restart. Continue?");
        if (!confirmed) return;

        _restartingToUpdate = true;
        try
        {
            await DesktopUpdates.RestartToUpdateAsync();
        }
        catch
        {
            _restartingToUpdate = false;
            throw;
        }
    }

    private string ContentClass() => IsProjectRoute()
        ? "content content--workspace"
        : "content content--page";

    private string CurrentPath()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return relativePath.Split(['?', '#'], 2)[0].Trim('/');
    }

    private bool IsHomeRoute() => string.IsNullOrEmpty(CurrentPath());
    private bool IsSettingsRoute() => CurrentPath().StartsWith("settings/", StringComparison.OrdinalIgnoreCase);
    private bool IsProjectRoute() => CurrentPath().StartsWith("projects/", StringComparison.OrdinalIgnoreCase);

    public void Dispose() => DesktopUpdates.StateChanged -= OnDesktopUpdateStateChanged;
}
