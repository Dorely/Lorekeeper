@implements IAsyncDisposable
@inject IJSRuntime JS

<button type="button"
        class="theme-toggle"
        title="@ToggleTitle"
        aria-label="@ToggleTitle"
        aria-pressed="@(_isDark ? "false" : "true")"
        disabled="@(!RendererInfo.IsInteractive)"
        @onclick="ToggleThemeAsync">
    @if (_isDark)
    {
        <svg class="theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
    }
    else
    {
        <svg class="theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
    }
</button>

@code {
    private IJSObjectReference? _module;
    private bool _isDark;

    private string ToggleTitle => _isDark ? "Switch to light theme" : "Switch to dark theme";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/ThemeToggle.razor.js");
            _isDark = await _module.InvokeAsync<bool>("getIsDark");
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        if (_module is null) return;
        _isDark = await _module.InvokeAsync<bool>("setTheme", !_isDark);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
