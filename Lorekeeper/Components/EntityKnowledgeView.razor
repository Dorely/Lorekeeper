@using Lorekeeper.Ingest

<section class="entity-knowledge">
    <div class="entity-knowledge-title">@Title</div>

    @if (HasContent)
    {
        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <article class="entity-knowledge-item">
                <div class="entity-knowledge-head">Summary</div>
                <p>@Summary</p>
            </article>
        }

        @if (Aliases.Count > 0)
        {
            <div class="entity-knowledge-aliases">
                <span>Aliases</span>
                <strong>@string.Join(", ", Aliases)</strong>
            </div>
        }

        @foreach (var wikiSection in WikiSections)
        {
            <article class="entity-knowledge-item" @key="wikiSection.Id">
                <div class="entity-knowledge-head">@wikiSection.Title</div>
                <p>@wikiSection.Body</p>
                @foreach (var citation in wikiSection.Citations.Take(3))
                {
                    <div class="entity-knowledge-source" @key="CitationKey(citation)">
                        <strong>@citation.SourceTitle</strong>
                        <span>@IngestWikiSheet.CitationPreview(citation)</span>
                    </div>
                }
            </article>
        }

        @if (CanonSources.Count > 0)
        {
            <div class="entity-knowledge-subtitle">Canon Sources</div>
            @foreach (var source in CanonSources)
            {
                <article class="entity-knowledge-item" @key="source.PropertyKey">
                    <div class="entity-knowledge-head">
                        @source.SourceTitle
                        <span>@source.SourceKind</span>
                    </div>
                    <div class="entity-knowledge-markdown">@source.Markdown</div>
                </article>
            }
        }
    }
    else if (ShowEmptyState)
    {
        <div class="entity-knowledge-empty"><em>No structured entity data yet.</em></div>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Entity Data";
    [Parameter] public string Summary { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<string> Aliases { get; set; } = [];
    [Parameter] public IReadOnlyList<IngestWikiSection> WikiSections { get; set; } = [];
    [Parameter] public IReadOnlyList<IngestCanonSource> CanonSources { get; set; } = [];
    [Parameter] public bool ShowEmptyState { get; set; } = true;

    private bool HasContent =>
        !string.IsNullOrWhiteSpace(Summary)
        || Aliases.Count > 0
        || WikiSections.Count > 0
        || CanonSources.Count > 0;

    private static string CitationKey(IngestWikiCitation citation) =>
        $"{citation.SourceId}:{citation.SourceChunkId}:{citation.SourceBlockId}:{citation.PageNumber}:{citation.Locator}";

}
