@namespace Lorekeeper.Components.Chat
@using System.Text.Json
@using Lorekeeper.EditorChat
@inject IEditorRevisionAgentService RevisionAgents

<details class="chat-chip @StateClass" open="@ShouldOpen">
    <summary>
        <span class="chat-chip-icon">@IconText</span>
        <span class="chat-chip-name">@Chip.Name</span>
        @if (Chip.HasArguments)
        {
            <span class="chat-chip-args">@ChatTranscriptHelpers.TruncateInline(Chip.ArgumentsJson, 96)</span>
        }
        @if (Chip.Progress is { } summaryProgress)
        {
            <span class="chat-chip-progress-inline">@ProgressInlineSummary(summaryProgress)</span>
        }
    </summary>
    <div class="chat-chip-body">
        @if (Chip.HasArguments || !Chip.ArgumentsComplete)
        {
            <div class="chat-chip-section">args</div>
            <pre class="chat-chip-pre">@Chip.ArgumentsJson@if (!Chip.ArgumentsComplete) { <span class="chat-cursor">|</span> }</pre>
        }
        @if (Chip.Progress is { } progress)
        {
            <div class="chat-chip-section">@progress.SectionLabel</div>
            <div class="chat-chip-progress">
                @if (!string.IsNullOrWhiteSpace(progress.LatestPreviewImageUrl))
                {
                    <div class="chat-chip-progress-preview">
                        <img src="@progress.LatestPreviewImageUrl" alt="@progress.LatestPreviewAlt" />
                    </div>
                }
                <div class="chat-chip-progress-counts">
                    <span>@progress.CompletedCount completed of @progress.TotalCount @progress.ItemLabel</span>
                    @if (progress.RunningCount > 0)
                    {
                        <span>@progress.RunningCount running</span>
                    }
                    @if (progress.QueuedCount > 0)
                    {
                        <span>@progress.QueuedCount queued</span>
                    }
                    @if (progress.FailedCount > 0)
                    {
                        <span>@progress.FailedCount failed</span>
                    }
                    @if (progress.InvalidCount > 0)
                    {
                        <span>@progress.InvalidCount invalid</span>
                    }
                    @if (progress.CancelledCount > 0)
                    {
                        <span>@progress.CancelledCount cancelled</span>
                    }
                </div>
                <div class="chat-chip-progress-list">
                    @foreach (var row in progress.Rows)
                    {
                        <div class="chat-chip-progress-row">
                            <div class="chat-chip-progress-main">
                                <span class="chat-chip-progress-title">@(row.Order + 1). @row.Title</span>
                                <span class="@ProgressStatusClass(row.Status)">@row.Status</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ProgressSubtext(row)))
                            {
                                <div class="chat-chip-progress-note">@ProgressSubtext(row)</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        @if (Chip.Error is not null)
        {
            <div class="chat-chip-section">error</div>
            <pre class="chat-chip-pre chat-chip-pre-error">@Chip.Error</pre>
        }
        else if (Chip.Result is not null)
        {
            <div class="chat-chip-section">result</div>
            <pre class="chat-chip-pre">@Chip.Result</pre>
        }
        else if (Chip.Progress is null)
        {
            <div class="chat-chip-section text-muted"><em>@PendingText</em></div>
        }
        @if (RevisionJobId is { } revisionJobId)
        {
            <button type="button" class="btn btn-link btn-sm chat-chip-action" @onclick="() => OpenRevisionJobAsync(revisionJobId)">
                Open worker transcripts
            </button>
        }
    </div>
</details>

@if (_showRevisionJob)
{
    <div class="chat-revision-backdrop" @onclick="CloseRevisionJob">
        <div class="chat-revision-modal" @onclick:stopPropagation="true">
            <div class="chat-revision-head">
                <div>
                    <div class="chat-revision-title">Revision Workers</div>
                    @if (_revisionJob is not null)
                    {
                        <div class="chat-revision-meta">@_revisionJob.Status - @_revisionJob.Sessions.Count session(s)</div>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseRevisionJob">Close</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_revisionError))
            {
                <div class="alert alert-danger py-2 small">@_revisionError</div>
            }
            else if (_revisionLoading)
            {
                <p class="text-muted small"><em>Loading...</em></p>
            }
            else if (_revisionJob is null)
            {
                <p class="text-muted small"><em>No revision job found.</em></p>
            }
            else
            {
                <div class="chat-revision-grid">
                    <div class="chat-revision-list">
                        @foreach (var session in _revisionJob.Sessions)
                        {
                            <button type="button"
                                    class="chat-revision-session @(_selectedRevisionSessionId == session.Id ? "selected" : null)"
                                    @onclick="() => SelectRevisionSessionAsync(session.Id)">
                                <span>@(session.Order + 1). @session.ChapterTitle</span>
                                <span>@session.Status</span>
                            </button>
                        }
                    </div>
                    <div class="chat-revision-detail">
                        @if (_revisionTranscript is null)
                        {
                            <p class="text-muted small"><em>Select a worker session.</em></p>
                        }
                        else
                        {
                            <div class="chat-revision-section">Assignment</div>
                            <p><strong>Reason:</strong> @_revisionTranscript.Session.Reason</p>
                            <p><strong>Instructions:</strong> @_revisionTranscript.Session.Instructions</p>

                            <div class="chat-revision-section">Change</div>
                            @if (_revisionTranscript.Session.Status == Lorekeeper.Models.EditorRevisionSessionStatus.Completed)
                            {
                                <p><strong>@_revisionTranscript.Session.Summary</strong></p>
                                <p>@_revisionTranscript.Session.Rationale</p>
                                <pre class="chat-chip-pre">@FormatChange(_revisionTranscript.Session)</pre>
                            }
                            else
                            {
                                <p class="text-danger small">@_revisionTranscript.Session.ErrorMessage</p>
                            }

                            <div class="chat-revision-section">Transcript</div>
                            @foreach (var message in _revisionTranscript.Messages)
                            {
                                <details class="chat-revision-message">
                                    <summary>
                                        <span>@message.Role</span>
                                        <span>@message.Status</span>
                                        @if (!string.IsNullOrWhiteSpace(message.ToolName))
                                        {
                                            <span>@message.ToolName</span>
                                        }
                                    </summary>
                                    @if (!string.IsNullOrWhiteSpace(message.Content))
                                    {
                                        <pre class="chat-chip-pre">@message.Content</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(message.ToolCallsJson) && message.ToolCallsJson != "[]")
                                    {
                                        <div class="chat-chip-section">tool calls</div>
                                        <pre class="chat-chip-pre">@message.ToolCallsJson</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(message.ErrorMessage))
                                    {
                                        <div class="chat-chip-section">error</div>
                                        <pre class="chat-chip-pre chat-chip-pre-error">@message.ErrorMessage</pre>
                                    }
                                </details>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ChatToolChip Chip { get; set; } = null!;

    private bool _showRevisionJob;
    private bool _revisionLoading;
    private string? _revisionError;
    private EditorRevisionJobDetail? _revisionJob;
    private EditorRevisionSessionTranscript? _revisionTranscript;
    private Guid? _selectedRevisionSessionId;
    private int _seenRevisionProgressVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (!_showRevisionJob || RevisionJobId is not { } jobId)
            return;

        var progressVersion = Chip.Progress?.Version ?? 0;
        if (progressVersion == _seenRevisionProgressVersion)
            return;

        _seenRevisionProgressVersion = progressVersion;
        await RefreshRevisionJobAsync(jobId, showLoading: false);
    }

    private string StateClass => Chip.Error is not null
        ? "chat-chip-error"
        : Chip.Completed
            ? "chat-chip-ok"
            : Chip.ArgumentsComplete
                ? "chat-chip-running"
                : "chat-chip-pending";

    private bool ShouldOpen => Chip.Progress is not null && (!Chip.Completed || Chip.Error is not null);

    private string IconText => Chip.Error is not null
        ? "x"
        : Chip.Completed
            ? "ok"
            : Chip.ArgumentsComplete
                ? "run"
                : "...";

    private string PendingText => Chip.ArgumentsComplete ? "running..." : "receiving args...";

    private Guid? RevisionJobId => string.Equals(Chip.Name, "start_revision_agents", StringComparison.Ordinal)
        ? Chip.Progress?.JobId ?? TryReadRevisionJobId(Chip.Result)
        : null;

    private async Task OpenRevisionJobAsync(Guid jobId)
    {
        _showRevisionJob = true;
        _seenRevisionProgressVersion = Chip.Progress?.Version ?? 0;
        await RefreshRevisionJobAsync(jobId, showLoading: true);
    }

    private async Task RefreshRevisionJobAsync(Guid jobId, bool showLoading)
    {
        if (showLoading)
            _revisionLoading = true;

        _revisionError = null;
        try
        {
            _revisionJob = await RevisionAgents.GetJobAsync(jobId);
            if (_revisionJob is null)
            {
                _revisionTranscript = null;
                _selectedRevisionSessionId = null;
                return;
            }

            var selectedSessionId = _selectedRevisionSessionId;
            if (selectedSessionId is null || !_revisionJob.Sessions.Any(session => session.Id == selectedSessionId))
                selectedSessionId = _revisionJob.Sessions.FirstOrDefault()?.Id;

            _selectedRevisionSessionId = selectedSessionId;
            _revisionTranscript = selectedSessionId is { } sessionId
                ? await RevisionAgents.GetSessionTranscriptAsync(sessionId)
                : null;
        }
        catch (Exception ex)
        {
            _revisionError = ex.Message;
        }
        finally
        {
            if (showLoading)
                _revisionLoading = false;
        }
    }

    private async Task SelectRevisionSessionAsync(Guid sessionId)
    {
        _selectedRevisionSessionId = sessionId;
        _revisionTranscript = await RevisionAgents.GetSessionTranscriptAsync(sessionId);
    }

    private void CloseRevisionJob()
    {
        _showRevisionJob = false;
        _revisionTranscript = null;
        _selectedRevisionSessionId = null;
    }

    private static Guid? TryReadRevisionJobId(string? result)
    {
        if (string.IsNullOrWhiteSpace(result)) return null;
        try
        {
            using var document = JsonDocument.Parse(result);
            if (document.RootElement.TryGetProperty("jobId", out var jobId)
                && Guid.TryParse(jobId.GetString(), out var parsed))
            {
                return parsed;
            }
        }
        catch (JsonException) { }

        return null;
    }

    private static string FormatChange(EditorRevisionSessionDetail session) =>
        JsonSerializer.Serialize(new
        {
            session.OperationFormat,
            session.OperationsJson,
            session.Notes,
        }, new JsonSerializerOptions { WriteIndented = true });

    private static string ProgressInlineSummary(ChatToolProgress progress)
    {
        if (progress.TotalCount <= 0)
            return string.IsNullOrWhiteSpace(progress.Status) ? "running" : progress.Status;

        var itemLabel = string.IsNullOrWhiteSpace(progress.ItemLabel) ? "items" : progress.ItemLabel;
        var parts = new List<string> { $"{progress.CompletedCount}/{progress.TotalCount} {itemLabel} completed" };
        if (progress.RunningCount > 0)
            parts.Add($"{progress.RunningCount} running");
        if (progress.QueuedCount > 0)
            parts.Add($"{progress.QueuedCount} queued");

        var attention = progress.FailedCount + progress.InvalidCount + progress.CancelledCount;
        if (attention > 0)
            parts.Add($"{attention} attention");

        return string.Join(" - ", parts);
    }

    private static string ProgressStatusClass(string status) => status switch
    {
        "Completed" or "Succeeded" => "chat-chip-progress-status chat-chip-progress-status-ok",
        "Failed" or "Invalid" => "chat-chip-progress-status chat-chip-progress-status-error",
        "Cancelled" => "chat-chip-progress-status chat-chip-progress-status-muted",
        "Running" or "Generating" => "chat-chip-progress-status chat-chip-progress-status-running",
        "Queued" => "chat-chip-progress-status chat-chip-progress-status-muted",
        _ => "chat-chip-progress-status",
    };

    private static string ProgressSubtext(ChatToolProgressRow row) =>
        !string.IsNullOrWhiteSpace(row.ErrorMessage)
            ? row.ErrorMessage!
            : row.Summary;
}
