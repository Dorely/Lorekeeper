@namespace Lorekeeper.Components.Chat
@using Lorekeeper.ChatTurns
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Lorekeeper.Images.IProjectImageService ProjectImages

<div class="chat-surface @CssClass">
    <div class="chat-header">
        <div class="chat-heading">
            <span class="chat-title">@Title</span>
            @if (!string.IsNullOrWhiteSpace(TokenText))
            {
                <span class="chat-token-count" title="@TokenTitle">@TokenText</span>
            }
        </div>
        @if (HeaderActions is not null)
        {
            <div class="chat-header-actions">@HeaderActions</div>
        }
    </div>

    <div class="chat-scroll" @ref="_scrollEl">
        @if (Loading)
        {
            <div class="chat-empty"><em>@LoadingText</em></div>
        }
        else
        {
            @foreach (var message in Messages)
            {
                @RenderMessage(message)
            }
            @if (Live is not null)
            {
                @RenderLive(Live)
            }
        }
        <div class="chat-bottom-sentinel" aria-hidden="true"></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="chat-error">
            <span>@Error</span>
            <button type="button" class="btn-close btn-close-sm" @onclick="OnClearError"></button>
        </div>
    }

    @if (ExtraControls is not null)
    {
        @ExtraControls
    }

    @if (ShowTokenResetSuggestion && !Running && !Loading)
    {
        <div class="chat-token-reset-suggestion" role="status">
            This chat is over halfway through its configured token allowance. Consider Reset before continuing.
        </div>
    }

    <div class="chat-composer">
        @if (_composerImages.Count > 0)
        {
            <div class="chat-composer-images">
                @foreach (var image in _composerImages)
                {
                    <span class="chat-composer-image" @key="image.ImageId">
                        <img src="@image.PreviewUrl" alt="@image.AltText" />
                        <span title="@image.FileName">@image.FileName</span>
                        <button type="button" title="Remove image" aria-label="Remove image"
                                disabled="@ComposerDisabled" @onclick="() => RemoveComposerImage(image.ImageId)">x</button>
                    </span>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_composerError))
        {
            <div class="chat-composer-error">@_composerError</div>
        }
        <div class="chat-composer-row">
            <button type="button" class="btn btn-outline-secondary chat-attach-button" title="Attach an image"
                    aria-label="Attach an image" disabled="@ComposerDisabled" @onclick="OpenImagePicker">+</button>
            <textarea class="form-control chat-input" rows="1" placeholder="@Placeholder"
                  @ref="_composerEl"
                  disabled="@ComposerDisabled"
                  value="@Input"
                  @oninput="OnInputAsync"></textarea>
        @if (ComposerOptions is not null)
        {
            @ComposerOptions
        }
        @if (Running)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="OnStop">Stop</button>
        }
        else
        {
            <button type="button" class="btn btn-primary" data-chat-send="true" disabled="@SendDisabled" @onclick="SubmitAsync">Send</button>
        }
        </div>
    </div>
</div>

<ProjectImageLibraryPickerModal ProjectId="@ProjectId"
                                IsOpen="@_imagePickerOpen"
                                Title="Attach project image"
                                PrimaryActionLabel="Attach to message"
                                ExcludedImageIds="@ComposerImageIds"
                                OnPrimaryAction="AddPickedImage"
                                OnClose="CloseImagePicker" />

@if (_selectedImageVisual is { } selectedVisual)
{
    <ImageViewerModal ImageUrl="@selectedVisual.FullImageUrl"
                      Title="@selectedVisual.Title"
                      AltText="@selectedVisual.Title"
                      Details="@ViewerDetails(selectedVisual)"
                      Closed="CloseImageModal" />
}

@code {
    [Parameter] public string Title { get; set; } = "Chat";
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public ChatTurnSurface Surface { get; set; }
    [Parameter] public string? TokenText { get; set; }
    [Parameter] public string? TokenTitle { get; set; }
    [Parameter] public bool ShowTokenResetSuggestion { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading...";
    [Parameter] public IReadOnlyList<ChatRenderableMessage> Messages { get; set; } = [];
    [Parameter] public ChatLiveTurn? Live { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string Input { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> InputChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Type a message...";
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool ComposerDisabled { get; set; }
    [Parameter] public bool SendDisabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public int ForceScrollKey { get; set; }
    [Parameter] public int ScrollKey { get; set; }
    [Parameter] public int AutoFollowKey { get; set; }
    [Parameter] public int ResetComposerKey { get; set; }
    [Parameter] public EventCallback<ChatComposerSubmission> OnSend { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    [Parameter] public EventCallback OnClearError { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ExtraControls { get; set; }
    [Parameter] public RenderFragment? ComposerOptions { get; set; }
    [Parameter] public EventCallback OnLibraryImagesChanged { get; set; }

    private ElementReference _scrollEl;
    private ElementReference _composerEl;
    private IJSObjectReference? _module;
    private bool _scrollerAttached;
    private bool _autoSizeAttached;
    private bool _composerAttached;
    private bool _draftPersistenceAttached;
    private string? _draftIdentity;
    private bool _resetComposerKeyInitialized;
    private int _seenForceScrollKey;
    private int _seenScrollKey;
    private int _seenAutoFollowKey;
    private int _seenResetComposerKey;
    private ChatImageVisual? _selectedImageVisual;
    private DotNetObjectReference<ChatSurface>? _selfReference;
    private readonly List<ChatTurnImageAttachment> _composerImages = [];
    private bool _imagePickerOpen;
    private string? _composerError;
    private IReadOnlyCollection<Guid> ComposerImageIds => _composerImages.Select(image => image.ImageId).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Chat/ChatSurface.razor.js");
        }

        if (_module is null) return;

        if (!_scrollerAttached)
        {
            try { await _module.InvokeVoidAsync("attachScroller", _scrollEl); _scrollerAttached = true; }
            catch { }
        }

        if (!_autoSizeAttached)
        {
            try { await _module.InvokeVoidAsync("attachAutoSize", _composerEl); _autoSizeAttached = true; }
            catch { }
        }

        if (!_composerAttached)
        {
            _selfReference ??= DotNetObjectReference.Create(this);
            try { await _module.InvokeVoidAsync("attachComposer", _composerEl, _selfReference); _composerAttached = true; }
            catch { }
        }

        var draftIdentity = $"{ProjectId:N}:{Surface}";
        if (!_draftPersistenceAttached || !string.Equals(_draftIdentity, draftIdentity, StringComparison.Ordinal))
        {
            try
            {
                await _module.InvokeVoidAsync("attachDraftPersistence", _composerEl, ProjectId.ToString("N"), Surface.ToString());
                _draftPersistenceAttached = true;
                _draftIdentity = draftIdentity;
            }
            catch { }
        }

        if (_seenAutoFollowKey != AutoFollowKey)
        {
            _seenAutoFollowKey = AutoFollowKey;
            try { await _module.InvokeVoidAsync("resumeAutoFollow", _scrollEl); }
            catch { }
        }

        if (!_resetComposerKeyInitialized)
        {
            _seenResetComposerKey = ResetComposerKey;
            _resetComposerKeyInitialized = true;
        }
        else if (_seenResetComposerKey != ResetComposerKey)
        {
            _seenResetComposerKey = ResetComposerKey;
            try { await _module.InvokeVoidAsync("clearDraft", _composerEl); }
            catch { }
            try { await _module.InvokeVoidAsync("resetComposer", _composerEl); }
            catch { }
            _composerImages.Clear();
            _composerError = null;
        }

        var force = _seenForceScrollKey != ForceScrollKey;
        if (force)
            _seenForceScrollKey = ForceScrollKey;

        var requested = _seenScrollKey != ScrollKey;
        if (requested)
            _seenScrollKey = ScrollKey;

        if (force || requested)
        {
            try { await _module.InvokeVoidAsync("scrollToBottom", _scrollEl, force); }
            catch { }
        }
    }

    private async Task OnInputAsync(ChangeEventArgs args) =>
        await InputChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task SubmitAsync() => OnSend.InvokeAsync(new ChatComposerSubmission(Input, _composerImages.ToList()));

    private void OpenImagePicker()
    {
        if (_composerImages.Count >= 4)
        {
            _composerError = "Attach no more than four images to one message.";
            return;
        }
        _composerError = null;
        _imagePickerOpen = true;
    }

    private void CloseImagePicker() => _imagePickerOpen = false;

    private void AddPickedImage(Lorekeeper.Images.ProjectImageView image)
    {
        if (_composerImages.Any(item => item.ImageId == image.Id)) return;
        if (_composerImages.Count >= 4)
        {
            _composerError = "Attach no more than four images to one message.";
            return;
        }
        _composerImages.Add(new ChatTurnImageAttachment(
            image.Id,
            image.FileName,
            image.ContentType,
            image.PreviewUrl,
            $"/projects/{ProjectId:N}/images/{image.Id:N}/content",
            image.AltText));
        _composerError = null;
    }

    private void RemoveComposerImage(Guid imageId) =>
        _composerImages.RemoveAll(image => image.ImageId == imageId);

    [JSInvokable]
    public async Task ReceivePastedImageAsync(string fileName, string contentType, byte[] data)
    {
        if (ComposerDisabled) return;
        if (_composerImages.Count >= 4)
        {
            _composerError = "Attach no more than four images to one message.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var uploaded = await ProjectImages.UploadAsync(
                ProjectId,
                new Lorekeeper.Images.ProjectImageUpload(fileName, contentType, data, fileName));
            AddPickedImage(uploaded);
            await OnLibraryImagesChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _composerError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OpenImageModal(ChatImageVisual visual) => _selectedImageVisual = visual;

    private void CloseImageModal() => _selectedImageVisual = null;

    private static IReadOnlyList<string> ViewerDetails(ChatImageVisual visual)
    {
        var details = new List<string>();
        if (!string.IsNullOrWhiteSpace(visual.Caption))
            details.Add(visual.Caption);
        if (visual.Width is int width && visual.Height is int height)
            details.Add($"{width} x {height}");
        return details;
    }

    private RenderFragment RenderMessage(ChatRenderableMessage message) => __builder =>
    {
        var bubbleClass = message.Role == ChatMessageRole.User
            ? "chat-msg chat-msg-user"
            : "chat-msg chat-msg-asst";
        <div class="@bubbleClass">
            @RenderParts(message.Parts)
            @if (message.Status == ChatMessageStatus.Failed)
            {
                <div class="chat-msg-status chat-msg-failed">Failed</div>
            }
            else if (message.Status == ChatMessageStatus.Cancelled)
            {
                <div class="chat-msg-status chat-msg-cancelled">Cancelled</div>
            }
        </div>
    };

    private RenderFragment RenderLive(ChatLiveTurn live) => __builder =>
    {
        if (!live.HasContent)
        {
            @RenderThinkingIndicator()
            return;
        }

        var visibleMessages = live.Messages.Where(message => message.Parts.Count > 0).ToList();
        var lastVisibleMessage = visibleMessages.LastOrDefault();
        @foreach (var liveMessage in visibleMessages)
        {
            var trailingText = ReferenceEquals(liveMessage, lastVisibleMessage)
                ? liveMessage.Parts.LastOrDefault() as ChatTextPart
                : null;
            <div class="chat-msg chat-msg-asst chat-msg-streaming">
                @RenderParts(liveMessage.Parts, trailingText)
            </div>
        }

        if (live.IsThinking)
        {
            @RenderThinkingIndicator()
        }
    };

    private RenderFragment RenderThinkingIndicator() => __builder =>
    {
        <div class="chat-msg chat-msg-asst chat-msg-streaming chat-thinking">
            <span class="chat-typing" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="chat-thinking-label">Thinking...</span>
        </div>
    };

    private RenderFragment RenderParts(IReadOnlyList<ChatMessagePart> parts, ChatTextPart? trailingText = null) => __builder =>
    {
        var index = 0;
        while (index < parts.Count)
        {
            if (parts[index] is not ChatToolPart firstTool)
            {
                @RenderPart(parts[index], ReferenceEquals(parts[index], trailingText))
                index++;
                continue;
            }

            var toolParts = new List<ChatToolChip> { firstTool.Chip };
            index++;
            while (index < parts.Count && parts[index] is ChatToolPart nextTool)
            {
                toolParts.Add(nextTool.Chip);
                index++;
            }

            if (toolParts.Count == 1)
            {
                <ChatToolChipView Chip="toolParts[0]" />
                @if (toolParts[0].Visuals.Count > 0)
                {
                    @RenderVisualStrip(toolParts[0].Visuals)
                }
            }
            else
            {
                @RenderToolGroup(toolParts)
            }
        }
    };

    private RenderFragment RenderPart(ChatMessagePart part, bool showCursor = false) => __builder =>
    {
        if (part is ChatTextPart textPart)
        {
            var text = textPart.Text.ToString();
            if (!string.IsNullOrEmpty(text))
            {
                <div class="chat-msg-text">@text@if (showCursor) { <span class="chat-cursor">|</span> }</div>
            }
        }
        else if (part is ChatToolPart toolPart)
        {
            <ChatToolChipView Chip="toolPart.Chip" />
            @if (toolPart.Chip.Visuals.Count > 0)
            {
                @RenderVisualStrip(toolPart.Chip.Visuals)
            }
        }
        else if (part is ChatImagePart imagePart)
        {
            @RenderVisualStrip(new[] { imagePart.Visual })
        }
    };

    private RenderFragment RenderVisualStrip(IReadOnlyList<ChatImageVisual> visuals) => __builder =>
    {
        <div class="chat-visual-strip">
            @foreach (var visual in visuals)
            {
                <button type="button" class="chat-visual-card" title="@visual.Title" @onclick="() => OpenImageModal(visual)">
                    <span class="chat-visual-thumb">
                        <img src="@visual.PreviewImageUrl" alt="@visual.Title" />
                    </span>
                    <span class="chat-visual-meta">
                        <span class="chat-visual-title">@visual.Title</span>
                        @if (!string.IsNullOrWhiteSpace(visual.Caption))
                        {
                            <span class="chat-visual-caption">@visual.Caption</span>
                        }
                        @if (visual.Width is int width && visual.Height is int height)
                        {
                            <span class="chat-visual-size">@width x @height</span>
                        }
                    </span>
                </button>
            }
        </div>
    };

    private RenderFragment RenderToolGroup(IReadOnlyList<ChatToolChip> chips) => __builder =>
    {
        var duration = chips
            .Where(chip => chip.DurationMs.HasValue)
            .Sum(chip => chip.DurationMs!.Value);
        var hasDuration = duration > 0;
        var stateClass = chips.Any(chip => chip.Error is not null)
            ? "chat-tool-group-error"
            : chips.All(chip => chip.Completed)
                ? "chat-tool-group-ok"
                : "chat-tool-group-running";

        <details class="chat-tool-group @stateClass" open="@ToolGroupOpen(chips)">
            <summary>
                <span class="chat-tool-group-icon">@ToolGroupIcon(chips)</span>
                <span class="chat-tool-group-title">@chips.Count tool calls</span>
                <span class="chat-tool-group-names">@ToolGroupNames(chips)</span>
                @if (hasDuration)
                {
                    <span class="chat-tool-group-duration">@FormatDuration(duration)</span>
                }
                else if (chips.Any(chip => !chip.Completed))
                {
                    <span class="chat-tool-group-duration">running</span>
                }
            </summary>
            <div class="chat-tool-group-body">
                @foreach (var chip in chips)
                {
                    <ChatToolChipView Chip="chip" />
                    @if (chip.Visuals.Count > 0)
                    {
                        @RenderVisualStrip(chip.Visuals)
                    }
                }
            </div>
        </details>
    };

    private static string ToolGroupIcon(IReadOnlyList<ChatToolChip> chips)
    {
        if (chips.Any(chip => chip.Error is not null)) return "x";
        if (chips.All(chip => chip.Completed)) return "ok";
        return "run";
    }

    private static bool ToolGroupOpen(IReadOnlyList<ChatToolChip> chips) =>
        chips.Any(chip => !chip.Completed);

    private static string ToolGroupNames(IReadOnlyList<ChatToolChip> chips)
    {
        var names = chips
            .Select(chip => chip.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.Ordinal)
            .Take(3)
            .ToList();
        if (names.Count == 0) return "tool calls";

        var label = string.Join(", ", names);
        var remaining = chips.Select(chip => chip.Name).Distinct(StringComparer.Ordinal).Count() - names.Count;
        return remaining > 0 ? $"{label} +{remaining}" : label;
    }

    private static string FormatDuration(double durationMs) =>
        durationMs >= 1000
            ? $"{durationMs / 1000:0.0}s"
            : $"{durationMs:0}ms";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detachDraftPersistence", _composerEl); } catch { }
            try { await _module.InvokeVoidAsync("detachComposer", _composerEl); } catch { }
            try { await _module.DisposeAsync(); } catch { }
        }
        _selfReference?.Dispose();
    }
}
