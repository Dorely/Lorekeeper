<!DOCTYPE html>
@using Lorekeeper.Appearance
@using Lorekeeper.Startup
@inject IAppearanceService Appearance
@inject IApplicationStartupState Startup

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function () {
            // crypto.randomUUID exists only in secure contexts (HTTPS or
            // localhost). Deliberate plain-HTTP LAN hosting still needs it for
            // the semantic editor's block IDs and the graph library, so provide
            // the standard v4 construction from crypto.getRandomValues, which
            // is available in every context.
            if (window.crypto && !("randomUUID" in window.crypto)) {
                window.crypto.randomUUID = function () {
                    var bytes = new Uint8Array(16);
                    window.crypto.getRandomValues(bytes);
                    bytes[6] = (bytes[6] & 0x0f) | 0x40;
                    bytes[8] = (bytes[8] & 0x3f) | 0x80;
                    var hex = "";
                    for (var i = 0; i < 16; i++) hex += bytes[i].toString(16).padStart(2, "0");
                    return hex.slice(0, 8) + "-" + hex.slice(8, 12) + "-" + hex.slice(12, 16)
                        + "-" + hex.slice(16, 20) + "-" + hex.slice(20);
                };
            }

            var THEME_KEY = "Lorekeeper.ui.theme";
            var theme = null;
            try {
                theme = window.localStorage.getItem(THEME_KEY);
            } catch (_) { }
            if (theme !== "light" && theme !== "dark") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            var root = document.documentElement;
            root.setAttribute("data-lk-theme", theme);
            root.setAttribute("data-bs-theme", theme);
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", theme === "dark" ? "#14181f" : "#425fce");

            // Blazor enhanced navigation re-renders the <html> element from
            // server HTML, which drops the theme attributes. Watch the root
            // element and re-apply the stored theme whenever the attribute is
            // removed, so the choice survives page-to-page navigation.
            if (window.MutationObserver) {
                new MutationObserver(function () {
                    var stored = null;
                    try {
                        stored = window.localStorage.getItem(THEME_KEY);
                    } catch (_) { }
                    if (stored !== "light" && stored !== "dark") return;
                    if (root.getAttribute("data-lk-theme") === stored) return;
                    root.setAttribute("data-lk-theme", stored);
                    root.setAttribute("data-bs-theme", stored);
                    if (meta) meta.setAttribute("content", stored === "dark" ? "#14181f" : "#425fce");
                }).observe(root, { attributes: true, attributeFilter: ["data-lk-theme"] });
            }
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Lorekeeper.styles.css"]" />
    @if (_customThemeCss is not null)
    {
        <style id="lk-custom-theme">@((MarkupString)_customThemeCss)</style>
    }
    <ImportMap />
    <meta name="theme-color" content="#425fce" />
    <link rel="icon" type="image/svg+xml" href="@Assets["branding/icon.svg"]" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets["branding/favicon-32x32.png"]" />
    <link rel="icon" type="image/png" sizes="16x16" href="@Assets["branding/favicon-16x16.png"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["branding/apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />
    <HeadOutlet />
</head>

<body>
    @if (Startup.Current.CanUseDatabase)
    {
        <Routes />
    }
    else
    {
        <StartupScreen @rendermode="InteractiveServer" />
    }
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string? _customThemeCss;

    protected override async Task OnInitializedAsync() =>
        _customThemeCss = await Appearance.GetCustomCssAsync();
}
