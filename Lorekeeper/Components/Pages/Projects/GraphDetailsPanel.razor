@using Lorekeeper.Graph
@using Lorekeeper.Ingest

<aside class="graph-details" aria-label="Graph details">
    <div class="graph-details-header">
        <div>
            <div class="graph-details-kicker">Graph overview</div>
            <h5>@PanelTitle</h5>
        </div>
        @if (SelectedNode is not null)
        {
            <button type="button" class="btn-close" @onclick="ClearPanelAsync" aria-label="Close details"></button>
        }
    </div>

    <div class="graph-details-body">
        @if (Snapshot is null)
        {
            <div class="text-muted small"><em>Loading graph details...</em></div>
        }
        else if (SelectedNode is { } selected)
        {
            @RenderNodeOverview(selected)
        }
        else
        {
            <div class="graph-details-empty">
                <strong>Select a node</strong>
                <p>Click a node in the graph to inspect it, or create a new graph node.</p>
                <button type="button" class="btn btn-sm btn-primary" @onclick="AddNodeAsync">Add node</button>
            </div>
        }
    </div>
</aside>

@code {
    [Parameter] public ProjectGraphSnapshot? Snapshot { get; set; }
    [Parameter] public long? SelectedNodeId { get; set; }
    [Parameter] public bool ShowAutoLinks { get; set; }
    [Parameter] public EventCallback<long?> OnSelectNode { get; set; }
    [Parameter] public EventCallback<long> OnEditNode { get; set; }
    [Parameter] public EventCallback OnAddNode { get; set; }

    private ProjectGraphNode? SelectedNode =>
        SelectedNodeId is long nodeId ? Snapshot?.Nodes.FirstOrDefault(n => n.NodeId == nodeId) : null;

    private string PanelTitle => SelectedNode is { } selected ? selected.Label : "Details";

    private RenderFragment RenderNodeOverview(ProjectGraphNode selected) => @<div class="graph-node-overview">
        <div class="graph-node-meta">
            <span class="graph-node-type" style="border-color: @selected.Color">@selected.Type</span>
            <span class="text-muted small">@selected.Key</span>
            @if (selected.CanonSourceCount > 0)
            {
                <span class="badge text-bg-info">@selected.CanonSourceCount canon source@(PluralSuffix(selected.CanonSourceCount))</span>
            }
            else if (selected.IsIngestCreated)
            {
                <span class="badge text-bg-info">ingest</span>
            }
        </div>

        <div class="graph-overview-actions">
            <button type="button" class="btn btn-sm btn-primary" @onclick="() => EditNodeAsync(selected.NodeId)">Edit</button>
        </div>

        @RenderProperties(selected)

        <EntityKnowledgeView Summary="@selected.Summary"
                             Aliases="@selected.Aliases"
                             WikiSections="@selected.WikiSections"
                             CanonSources="@selected.CanonSources" />

        <div class="graph-links-section">
            <div class="graph-links-header">
                <div class="graph-section-title">Relationships</div>
            </div>

            @if (!AdjacentEdges(selected).Any())
            {
                <div class="text-muted small"><em>No relationships.</em></div>
            }
            else
            {
                @foreach (var edge in AdjacentEdges(selected))
                {
                    var other = OtherNode(edge, selected.NodeId);
                    <div class="graph-link-row" @key="edge.EdgeId">
                        <div class="graph-link-main">
                            <span class="graph-link-direction">@(edge.FromNodeId == selected.NodeId ? "out" : "in")</span>
                            <span class="graph-link-type">@edge.EdgeType</span>
                            @if (other is not null)
                            {
                                <button type="button" class="graph-link-target" @onclick="() => SelectNodeAsync(other.NodeId)">@other.Label</button>
                                <span class="text-muted small">@other.Type</span>
                            }
                            @if (edge.IsManaged)
                            {
                                <span class="badge text-bg-secondary">managed</span>
                            }
                            @if (edge.IsAutoLink)
                            {
                                <span class="badge text-bg-secondary">auto</span>
                            }
                            @if (edge.CanonSourceCount > 0)
                            {
                                <span class="badge text-bg-info">@edge.CanonSourceCount canon source@(PluralSuffix(edge.CanonSourceCount))</span>
                            }
                            else if (IsExtractedFrom(edge) || edge.IsIngestCreated)
                            {
                                <span class="badge text-bg-info">ingest</span>
                            }
                        </div>
                        @RenderRelationshipCitations(edge)
                        @if (edge.Properties.Count > 0)
                        {
                            <div class="graph-link-props">
                                @foreach (var prop in edge.Properties.OrderBy(p => p.Key, StringComparer.OrdinalIgnoreCase))
                                {
                                    <span>@prop.Key: @(string.IsNullOrWhiteSpace(prop.Value) ? "-" : prop.Value)</span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>;

    private RenderFragment RenderProperties(ProjectGraphNode selected) => @<div>
        @if (selected.Properties.Count > 0)
        {
            <div class="graph-readonly-block">
                <div class="graph-section-title">Properties</div>
                @foreach (var prop in selected.Properties.OrderBy(p => p.Key, StringComparer.OrdinalIgnoreCase))
                {
                    <div class="graph-readonly-row">
                        <span>@prop.Key</span>
                        <strong>@(string.IsNullOrWhiteSpace(prop.Value) ? "-" : prop.Value)</strong>
                    </div>
                }
            </div>
        }
    </div>;

    private RenderFragment RenderRelationshipCitations(ProjectGraphEdge edge) => @<div>
        @if (!string.IsNullOrWhiteSpace(edge.Summary) || edge.Citations.Count > 0)
        {
            <div class="graph-ingest-section">
                @if (!string.IsNullOrWhiteSpace(edge.Summary))
                {
                    <p>@edge.Summary</p>
                }
                @foreach (var citation in edge.Citations.Take(3))
                {
                    <div class="graph-ingest-observation" @key="CitationKey(citation)">
                        <div class="graph-ingest-head">
                            <strong>@citation.SourceTitle</strong>
                            <span>@citation.SourceKind</span>
                            <span>chunk @(citation.SourceChunkIndex + 1)</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>;

    private IEnumerable<ProjectGraphEdge> AdjacentEdges(ProjectGraphNode node) =>
        Snapshot?.Edges
            .Where(e => e.FromNodeId == node.NodeId || e.ToNodeId == node.NodeId)
            .Where(e => ShowAutoLinks || !e.IsAutoLink)
            .OrderBy(e => e.IsAutoLink)
            .ThenByDescending(e => e.IsManaged)
            .ThenBy(e => e.EdgeType, StringComparer.OrdinalIgnoreCase)
            ?? Enumerable.Empty<ProjectGraphEdge>();

    private ProjectGraphNode? OtherNode(ProjectGraphEdge edge, long selectedNodeId)
    {
        var otherId = edge.FromNodeId == selectedNodeId ? edge.ToNodeId : edge.FromNodeId;
        return Snapshot?.Nodes.FirstOrDefault(n => n.NodeId == otherId);
    }

    private async Task ClearPanelAsync() => await OnSelectNode.InvokeAsync(null);

    private async Task SelectNodeAsync(long nodeId) => await OnSelectNode.InvokeAsync(nodeId);

    private async Task EditNodeAsync(long nodeId) => await OnEditNode.InvokeAsync(nodeId);

    private async Task AddNodeAsync() => await OnAddNode.InvokeAsync();

    private static bool IsExtractedFrom(ProjectGraphEdge edge) =>
        string.Equals(edge.EdgeType, IngestGraphSync.ExtractedFromEdgeType, StringComparison.OrdinalIgnoreCase);

    private static string CitationKey(IngestWikiCitation citation) =>
        $"{citation.SourceId}:{citation.SourceChunkId}:{citation.SourceBlockId}:{citation.PageNumber}:{citation.Locator}";

    private static string PluralSuffix(int count) => count == 1 ? string.Empty : "s";
}
