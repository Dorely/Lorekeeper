@using Lorekeeper.Chapters
@using Lorekeeper.Models
@inject IChapterService Chapters
@inject NavigationManager Nav

@if (Project is null)
{
    <p class="text-muted"><em>Loading…</em></p>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">Chapters</h5>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync">+ New chapter</button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @if (_chapters is null)
    {
        <p class="text-muted"><em>Loading chapters…</em></p>
    }
    else if (_chapters.Count == 0)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between">
            <span>No chapters yet.</span>
            <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync">Create first chapter</button>
        </div>
    }
    else
    {
        <div class="outline-list">
            @for (var i = 0; i < _chapters.Count; i++)
            {
                var idx = i;
                var ch = _chapters[idx];
                var isFocus = Focus == ch.Id;
                <div class="outline-row @(isFocus ? "focus" : "") @(_draggingId == ch.Id ? "dragging" : "")"
                     draggable="true"
                     @key="ch.Id"
                     @ondragstart="() => OnDragStart(ch.Id)"
                     @ondragover:preventDefault="true"
                     @ondragover="() => OnDragOver(ch.Id)"
                     @ondrop="OnDropAsync"
                     @ondragend="OnDragEnd">
                    <div class="outline-handle" title="Drag to reorder">☰</div>
                    <div class="outline-order">@(idx + 1)</div>
                    <div class="outline-main">
                        <input class="form-control form-control-sm outline-title"
                               value="@ch.Title"
                               @onchange="@(e => OnTitleChangedAsync(ch, (string?)e.Value))" />
                        <textarea class="form-control form-control-sm outline-synopsis mt-1"
                                  rows="2"
                                  placeholder="Synopsis…"
                                  value="@ch.Synopsis"
                                  @onchange="@(e => OnSynopsisChangedAsync(ch, (string?)e.Value))"></textarea>
                        @if (ch.VectorIndexState == VectorIndexState.Stale)
                        {
                            <span class="badge text-bg-warning mt-1" title="Vector index is being rebuilt.">Indexing…</span>
                        }
                        else if (ch.VectorIndexState == VectorIndexState.Failed)
                        {
                            <span class="badge text-bg-danger mt-1" title="@ch.VectorIndexError">Index failed — retrying</span>
                        }
                    </div>
                    <div class="outline-actions">
                        <a class="btn btn-sm btn-outline-secondary"
                           href="/projects/@Project.Slug/editor/@ch.Id">Open</a>
                        @if (_confirmDeleteId == ch.Id)
                        {
                            <button type="button" class="btn btn-sm btn-danger"
                                    @onclick="() => ConfirmDeleteAsync(ch)">Confirm</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => _confirmDeleteId = null">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => _confirmDeleteId = ch.Id">Delete</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [Parameter] public Guid? Focus { get; set; }

    private List<Chapter>? _chapters;
    private Guid? _confirmDeleteId;
    private Guid? _draggingId;
    private string? _error;
    private Guid? _loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) return;
        if (_loadedProjectId == Project.Id) return;
        _loadedProjectId = Project.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Project is null) return;
        _chapters = (await Chapters.ListAsync(Project.Id)).ToList();
    }

    private async Task CreateAsync()
    {
        if (Project is null) return;
        try
        {
            await Chapters.CreateAsync(Project.Id);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnTitleChangedAsync(Chapter ch, string? value)
    {
        var newTitle = (value ?? string.Empty).Trim();
        if (newTitle.Length == 0 || newTitle == ch.Title) return;
        try
        {
            await Chapters.UpdateAsync(ch.Id, title: newTitle);
            ch.Title = newTitle;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnSynopsisChangedAsync(Chapter ch, string? value)
    {
        var newSyn = value ?? string.Empty;
        if (newSyn == ch.Synopsis) return;
        try
        {
            await Chapters.UpdateAsync(ch.Id, synopsis: newSyn);
            ch.Synopsis = newSyn;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ConfirmDeleteAsync(Chapter ch)
    {
        try
        {
            await Chapters.DeleteAsync(ch.Id);
            _confirmDeleteId = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OnDragStart(Guid id) => _draggingId = id;
    private void OnDragEnd() => _draggingId = null;

    private void OnDragOver(Guid overId)
    {
        if (_chapters is null || _draggingId is not { } dragId || dragId == overId) return;
        var from = _chapters.FindIndex(c => c.Id == dragId);
        var to = _chapters.FindIndex(c => c.Id == overId);
        if (from < 0 || to < 0 || from == to) return;
        var item = _chapters[from];
        _chapters.RemoveAt(from);
        _chapters.Insert(to, item);
    }

    private async Task OnDropAsync()
    {
        if (Project is null || _chapters is null || _draggingId is null) return;
        _draggingId = null;
        try
        {
            var ids = _chapters.Select(c => c.Id).ToList();
            await Chapters.ReorderAsync(Project.Id, null, ids);
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
