    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _workspaceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composition-workspace.js");
            try
            {
                _journalModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composition-authoring-journal.js");
                await RecoverPendingAsync();
            }
            catch (Exception exception)
            {
                FailJournal(exception.Message);
            }
            _journalInitialized = true;
            await OpenAuthoringWriterAsync();
        }
        if (_workspaceModule is not null && !_pointerTrackingConnected && _scene is not null)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await _workspaceModule.InvokeVoidAsync("connectPointerTracking", _stageElement, _dotNetReference);
            _pointerTrackingConnected = true;
        }
    }
    private async Task BeginTransformAsync(PointerEventArgs e, CompositionObject item, CoverTransformMode mode)
    {
        if (IsLocked(item) || _workspaceModule is null || _transform is not null || _pendingTransformPointerId is not null)
            return;
        _selectedId = item.Id;
        var bounds = item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group ? EffectiveBounds(item, group) : item.Bounds;
        _pendingTransformPointerId = e.PointerId;
        var rect = await _workspaceModule.InvokeAsync<CoverStageRect>("begin", _stageElement, e.PointerId, item.Id.ToString("N"));
        if (!rect.Active || _pendingTransformPointerId != e.PointerId)
        {
            if (_pendingTransformPointerId == e.PointerId)
                _pendingTransformPointerId = null;
            await _workspaceModule.InvokeVoidAsync("end", _stageElement, e.PointerId);
            return;
        }
        _pendingTransformPointerId = null;
        Snapshot();
        _transform = new(item.Id, mode, e.ClientX, e.ClientY, bounds, item.Bounds, item.RotationDegrees, item.CropXPercent, item.CropYPercent, e.PointerId, rect);
    }
    [JSInvokable]
    public Task ContinueTrackedTransform(long pointerId, double clientX, double clientY)
    {
        if (_transform is not { } state || state.PointerId != pointerId)
            return Task.CompletedTask;
        var index = _objects.FindIndex(item => item.Id == state.ObjectId);
        if (index < 0)
            return Task.CompletedTask;
        var item = _objects[index];
        var clientDx = clientX - state.StartClientX;
        var clientDy = clientY - state.StartClientY;
        var surfaceDx = clientDx / Math.Max(1, state.Stage.Width) * 100;
        var surfaceDy = clientDy / Math.Max(1, state.Stage.Height) * 100;
        var dx = surfaceDx;
        var dy = surfaceDy;
        if (item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group)
        {
            dx = dx / Math.Max(.01, group.Bounds.WidthPercent) * 100;
            dy = dy / Math.Max(.01, group.Bounds.HeightPercent) * 100;
        }
        item = state.Mode switch
        {
            CoverTransformMode.Move => item with { Bounds = state.LocalBounds with { XPercent = Snap(state.LocalBounds.XPercent + dx), YPercent = Snap(state.LocalBounds.YPercent + dy) } },
            CoverTransformMode.Resize => item with { Bounds = ResizeBounds(item, state, dx, dy, clientDx, clientDy) },
            CoverTransformMode.Rotate => item with { RotationDegrees = state.StartRotation + RotationDelta(clientX, clientY, state) },
            CoverTransformMode.Crop => item with { CropXPercent = Math.Clamp(state.StartCropX - surfaceDx / Math.Max(.01, state.SurfaceBounds.WidthPercent) * 100, 0, 100), CropYPercent = Math.Clamp(state.StartCropY - surfaceDy / Math.Max(.01, state.SurfaceBounds.HeightPercent) * 100, 0, 100) },
            _ => item,
        };
        _objects[index] = item;
        MarkDirty(scheduleAutosave: false);
        return InvokeAsync(StateHasChanged);
    }
    private CompositionBounds ResizeBounds(CompositionObject item, CoverTransformState state, double dx, double dy, double clientDx, double clientDy)
    {
        if (item.Kind != CompositionObjectKind.Image || !RetainsAspectRatio(item) || state.Stage.ImageAspectRatio is not > 0)
            return state.LocalBounds with { WidthPercent = Math.Max(.25, Snap(state.LocalBounds.WidthPercent + dx)), HeightPercent = Math.Max(.25, Snap(state.LocalBounds.HeightPercent + dy)) };
        var ratio = state.Stage.ImageAspectRatio.Value;
        var widthPixels = Math.Max(2, state.SurfaceBounds.WidthPercent / 100 * state.Stage.Width + clientDx);
        var heightPixels = Math.Max(2, state.SurfaceBounds.HeightPercent / 100 * state.Stage.Height + clientDy);
        if (Math.Abs(clientDx) >= Math.Abs(clientDy)) heightPixels = widthPixels / ratio;
        else widthPixels = heightPixels * ratio;
        var surfaceWidth = widthPixels / Math.Max(1, state.Stage.Width) * 100;
        var surfaceHeight = heightPixels / Math.Max(1, state.Stage.Height) * 100;
        return state.LocalBounds with
        {
            WidthPercent = Math.Max(.25, state.LocalBounds.WidthPercent * surfaceWidth / Math.Max(.01, state.SurfaceBounds.WidthPercent)),
            HeightPercent = Math.Max(.25, state.LocalBounds.HeightPercent * surfaceHeight / Math.Max(.01, state.SurfaceBounds.HeightPercent)),
        };
    }
    private static double RotationDelta(double clientX, double clientY, CoverTransformState state) { var centerX = state.Stage.Left + (state.SurfaceBounds.XPercent + state.SurfaceBounds.WidthPercent / 2) / 100 * state.Stage.Width; var centerY = state.Stage.Top + (state.SurfaceBounds.YPercent + state.SurfaceBounds.HeightPercent / 2) / 100 * state.Stage.Height; return (Math.Atan2(clientY - centerY, clientX - centerX) - Math.Atan2(state.StartClientY - centerY, state.StartClientX - centerX)) * 180 / Math.PI; }
    [JSInvokable]
    public async Task EndTrackedTransform(long pointerId)
    {
        if (_pendingTransformPointerId == pointerId)
        {
            _pendingTransformPointerId = null;
            return;
        }
        if (_transform is not { } state || state.PointerId != pointerId)
            return;
        _transform = null;
        if (_workspaceModule is not null)
            await _workspaceModule.InvokeVoidAsync("end", _stageElement, state.PointerId);
        if (_dirty)
        {
            _autosaveCancellation?.Cancel();
            await SaveAsync();
        }
    }
    public async ValueTask DisposeAsync()
    {
        _disposeStarted = true;
        _autosaveCancellation?.Cancel();
        var flushed = false;
        try { flushed = await FlushAsync(); }
        catch { }
        // FlushAsync cancels the pending autosave, so its source must outlive the flush.
        _autosaveCancellation?.Dispose();
        _autosaveCancellation = null;
        if (_authoringWriterLease is not null && flushed)
            await _authoringWriterLease.DisposeAsync();
        else if (_authoringWriterLease is not null)
            MarkAuthoringWriterUnreachable();
        if (_workspaceModule is null)
        {
            _dotNetReference?.Dispose();
            if (_journalModule is not null)
                await _journalModule.DisposeAsync();
            return;
        }
        try
        {
            if (_pointerTrackingConnected)
                await _workspaceModule.InvokeVoidAsync("disconnectPointerTracking", _stageElement);
            await _workspaceModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally
        {
            _dotNetReference?.Dispose();
            if (_journalModule is not null)
                await _journalModule.DisposeAsync();
        }
    }

