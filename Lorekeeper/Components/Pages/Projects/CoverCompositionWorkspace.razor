    private async Task SaveAsync()
    {
        await _saveGate.WaitAsync();
        try
        {
            if (!_dirty || _cover is null || _scene is null)
                return;
            _error = null;
            var changeVersion = _changeVersion;
            var scene = CoverCompositionFactory.KeepArtworkBehindCopy(_scene with { Layers = _layers.ToList(), Styles = _styles.ToList(), Objects = _objects.ToList() });
            var update = new PublicationCoverDesignUpdate(_title, _subtitle, _author, IsPrint ? _spineText : "", IsPrint ? _backCopy : "", _background, IsPrint ? _barcodeMode : PublicationBarcodeMode.None, 50, 50, _cover.Revision, true);
            var saveProjectId = _loadedProjectId == Guid.Empty ? ProjectId : _loadedProjectId;
            _cover = _loadedCoreBook
                ? await Books.SaveCoverAsync(saveProjectId, _cover.CoreBookRevision ?? throw new InvalidOperationException("Core Book revision is unavailable."), update, scene)
                : await Covers.SaveWorkspaceAsync(saveProjectId, _cover.EditionId, update, scene);
            if (_changeVersion == changeVersion)
            {
                _scene = CoverCompositionFactory.KeepArtworkBehindCopy(
                    JsonSerializer.Deserialize<CompositionScene>(
                        _cover.CompositionSceneJson,
                        ManuscriptCodec.JsonOptions)
                    ?? throw new InvalidDataException("The saved cover scene is empty."));
                _objects = _scene.Objects.ToList();
                _layers = _scene.Layers.ToList();
                _styles = _scene.Styles.ToList();
                _dirty = false;
            }
            await Saved.InvokeAsync();
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            var saveProjectId = _loadedProjectId == Guid.Empty ? ProjectId : _loadedProjectId;
            _cover = _loadedCoreBook
                ? await Books.GetCoverAsync(saveProjectId)
                : await Covers.GetAsync(saveProjectId, _loadedEditionId);
            _dirty = true;
            ScheduleAutosave();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saveGate.Release(); }
    }
    public async Task<bool> FlushAsync()
    {
        _autosaveCancellation?.Cancel();
        while (_dirty)
        {
            var changeVersion = _changeVersion;
            await SaveAsync();
            if (!string.IsNullOrWhiteSpace(_error) || (_dirty && _changeVersion == changeVersion))
                break;
        }
        return !_dirty;
    }
