    private async Task SaveAsync()
    {
        await _saveGate.WaitAsync();
        AuthoringDeltaHistoryStage? historyStage = null;
        try
        {
            if (!_dirty || _cover is null || _scene is null)
                return;
            _error = null;
            var changeVersion = _changeVersion;
            var scene = CoverCompositionFactory.KeepArtworkBehindCopy(_scene with { Layers = _layers.ToList(), Styles = _styles.ToList(), Objects = _objects.ToList() });
            var journalToken = Guid.NewGuid().ToString("N");
            if (!await PersistPendingAsync(journalToken, scene))
                return;
            var expectedCoverRevision = _recoveredCoverRevision ?? _cover.Revision;
            var expectedCoreBookRevision = _recoveredCoreBookRevision ?? _cover.CoreBookRevision;
            var update = new PublicationCoverDesignUpdate(_title, _subtitle, _author, IsPrint ? _spineText : "", _background, IsPrint ? _barcodeMode : PublicationBarcodeMode.None, 50, 50, expectedCoverRevision, true, _spineDirection);
            var saveProjectId = _loadedProjectId == Guid.Empty ? ProjectId : _loadedProjectId;
            var delta = CompositionCanvasDeltaAdapter.Create(_scene, scene);
            var coverDelta = CompositionCanvasDeltaAdapter.CreateCoverProperties(
                CoverProperties(_cover), CoverProperties(update));
            var forward = delta.Forward.Concat(coverDelta.Forward).ToList();
            var inverse = delta.Inverse.Concat(coverDelta.Inverse).ToList();
            if (!_replayingCanvasHistory && forward.Count > 0)
            {
                historyStage = DeltaHistory.Stage(
                    saveProjectId,
                    [AuthoringTargetId()],
                    new Dictionary<string, long> { [AuthoringTargetId()] = _authoringGeneration },
                    "Edit cover layout", forward, inverse, null, null);
            }
            using (AuthoringMutations.SuppressHistory())
            {
                _cover = _loadedCoreBook
                    ? await Books.SaveCoverAsync(saveProjectId, expectedCoreBookRevision ?? throw new InvalidOperationException("Core Book revision is unavailable."), update, scene)
                    : await Covers.SaveSurfaceWorkspaceAsync(saveProjectId, _cover.EditionId, _surfaceRole, update, scene);
            }
            if (historyStage is not null)
                _history = DeltaHistory.Confirm(historyStage.StageId).State;
            var savedScene = CoverCompositionFactory.KeepArtworkBehindCopy(
                JsonSerializer.Deserialize<CompositionScene>(
                    _cover.CompositionSceneJson,
                    ManuscriptCodec.JsonOptions)
                ?? throw new InvalidDataException("The saved cover scene is empty."));
            _scene = savedScene;
            if (_changeVersion == changeVersion)
            {
                _objects = savedScene.Objects.ToList();
                _layers = savedScene.Layers.ToList();
                _styles = savedScene.Styles.ToList();
                _dirty = false;
                if (!await RemovePendingAsync(journalToken))
                    return;
                _recoveredCoverRevision = null;
                _recoveredCoreBookRevision = null;
            }
            UpdateAuthoringWriterState();
            await Saved.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            if (historyStage is not null)
                DeltaHistory.Discard(historyStage.StageId);
            _error = "This cover changed elsewhere. The local draft is retained and must be explicitly reloaded or reconciled before saving.";
            _recoveryConflict = true;
            UpdateAuthoringWriterState();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (historyStage is not null)
                DeltaHistory.Discard(historyStage.StageId);
            _error = ex.Message;
        }
        finally { _saveGate.Release(); }
    }
    public async Task<bool> FlushAsync()
    {
        _autosaveCancellation?.Cancel();
        while (_dirty)
        {
            var changeVersion = _changeVersion;
            await SaveAsync();
            if (!string.IsNullOrWhiteSpace(_error) || (_dirty && _changeVersion == changeVersion))
                break;
        }
        return !_dirty;
    }

