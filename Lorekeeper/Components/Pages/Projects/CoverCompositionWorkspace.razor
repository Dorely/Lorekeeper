    private static double RotationDelta(PointerEventArgs e, CoverTransformState state) { var centerX = state.Stage.Left + (state.SurfaceBounds.XPercent + state.SurfaceBounds.WidthPercent / 2) / 100 * state.Stage.Width; var centerY = state.Stage.Top + (state.SurfaceBounds.YPercent + state.SurfaceBounds.HeightPercent / 2) / 100 * state.Stage.Height; return (Math.Atan2(e.ClientY - centerY, e.ClientX - centerX) - Math.Atan2(state.StartClientY - centerY, state.StartClientX - centerX)) * 180 / Math.PI; }
