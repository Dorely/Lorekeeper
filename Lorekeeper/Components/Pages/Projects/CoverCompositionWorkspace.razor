    private async Task OpenAuthoringWriterAsync()
    {
        if (_authoringWriterLease is not null)
            return;
        if (!_journalInitialized || _cover is null)
            return;
        var targetId = AuthoringTargetId();
        _authoringSessionId = _journalModule is null
            ? Guid.NewGuid()
            : await _journalModule.InvokeAsync<Guid>("sessionId", ProjectId.ToString("D"), targetId);
        _authoringGeneration = (await AuthoringGenerations.ReadAsync(ProjectId, [targetId]))[targetId];
        var lease = await AuthoringFence.RegisterWriterAsync(new(
            new(ProjectId, targetId), _authoringSessionId, _authoringWriterId,
            FreezeAndFlushAuthoringAsync,
            async _ => await InvokeAsync(() =>
            {
                _authoringFrozen = false;
                StateHasChanged();
            })));
        // Registration waits out active fences; a workspace disposed meanwhile must not leave its writer behind.
        if (_disposeStarted)
        {
            await lease.DisposeAsync();
            return;
        }
        _authoringWriterLease = lease;
        UpdateAuthoringWriterState();
    }

    private async Task<AuthoringWriterFlushResult> FreezeAndFlushAuthoringAsync(long capturedSequence, CancellationToken cancellationToken)
    {
        _authoringFrozen = true;
        var saved = false;
        await InvokeAsync(async () => saved = await FlushAsync());
        return new(capturedSequence, !saved, IsRecoverable: saved || _journalRecoverable, IsReachable: true,
            saved ? null : "AUTHORING_FLUSH_FAILED",
            saved ? null : _error ?? "Cover changes could not be saved.");
    }

    private void UpdateAuthoringWriterState()
    {
        if (_authoringWriterLease is null || _cover is null)
            return;
        AuthoringFence.UpdateWriterState(new(
            new(ProjectId, AuthoringTargetId()), _authoringSessionId, _authoringWriterId, _authoringGeneration,
            _changeVersion, _changeVersion, _dirty ? 0 : _changeVersion,
            _dirty, IsRecoverable: _journalRecoverable));
    }

    private void MarkAuthoringWriterUnreachable()
    {
        if (_authoringWriterLease is null || _cover is null)
            return;
        AuthoringFence.UpdateWriterState(new(
            new(ProjectId, AuthoringTargetId()), _authoringSessionId, _authoringWriterId, _authoringGeneration,
            _changeVersion, _changeVersion, 0,
            IsDirty: true, IsRecoverable: false, IsReachable: false));
    }

    private async Task<bool> PersistPendingAsync(string token, CompositionScene scene)
    {
        if (_journalModule is null || _cover is null)
            return FailJournal("The local canvas recovery journal is unavailable.");
        try
        {
            await _journalModule.InvokeVoidAsync("write", ProjectId.ToString("D"), AuthoringTargetId(), token,
                new CoverPending(
                    _recoveredCoverRevision ?? _cover.Revision,
                    _recoveredCoreBookRevision ?? _cover.CoreBookRevision,
                    _surfaceRole,
                    CoverProperties(new PublicationCoverDesignUpdate(
                        _title, _subtitle, _author, IsPrint ? _spineText : "", _background,
                        IsPrint ? _barcodeMode : PublicationBarcodeMode.None, 50, 50,
                        _recoveredCoverRevision ?? _cover.Revision, true, _spineDirection)),
                    JsonSerializer.Serialize(scene, ManuscriptCodec.JsonOptions)));
            _journalToken = token;
            _journalRecoverable = true;
            UpdateAuthoringWriterState();
            return true;
        }
        catch (Exception exception) { return FailJournal(exception.Message); }
    }

    private async Task<bool> RemovePendingAsync(string token)
    {
        try
        {
            // Never remove an edit that arrived while a prior server dispatch was
            // pending; the token makes this delete conditional on that dispatch.
            if (_journalToken != token)
                return true;
            if (_journalModule is null || !await _journalModule.InvokeAsync<bool>("remove", ProjectId.ToString("D"), AuthoringTargetId(), token))
                return FailJournal("The saved cover edit could not be cleared from local recovery.");
            _journalToken = null;
            return true;
        }
        catch (Exception exception) { return FailJournal(exception.Message); }
    }

    private async Task ReloadCanonicalAsync()
    {
        if (_journalToken is not null && !await RemovePendingAsync(_journalToken))
            return;
        _dirty = false;
        _recoveryConflict = false;
        _recoveredCoverRevision = null;
        _recoveredCoreBookRevision = null;
        _error = null;
        _loadedRefreshSignal = -1;
        await OnParametersSetAsync();
    }

    private async Task RecoverPendingAsync()
    {
        if (_journalModule is null || _cover is null || _scene is null)
            return;
        try
        {
            var entry = await _journalModule.InvokeAsync<CanvasJournalEntry?>("read", ProjectId.ToString("D"), AuthoringTargetId());
            var pending = entry?.Payload.Deserialize<CoverPending>(ManuscriptCodec.JsonOptions);
            if (pending is null)
                return;
            if (!CoreBook && !string.Equals(pending.SurfaceRole, _surfaceRole, StringComparison.Ordinal)
                && _surfaceRoles.Contains(pending.SurfaceRole, StringComparer.Ordinal))
            {
                _surfaceRole = pending.SurfaceRole;
                _cover = await Covers.GetSurfaceAsync(ProjectId, EditionId, _surfaceRole);
                _scene = CoverCompositionFactory.KeepArtworkBehindCopy(
                    JsonSerializer.Deserialize<CompositionScene>(_cover.CompositionSceneJson, ManuscriptCodec.JsonOptions)
                    ?? throw new InvalidDataException("The current recovered cover scene is empty."));
                // Target adoption must refresh every scene and cover-property
                // backing field before a canonical-equivalence return. The
                // editor otherwise still renders the prior surface's lists or
                // title/background controls and could overwrite this surface.
                _objects = _scene.Objects.ToList();
                _layers = _scene.Layers.ToList();
                _styles = _scene.Styles.ToList();
                _selectedId = _objects.FirstOrDefault()?.Id;
                ApplyCoverProperties(CoverProperties(_cover));
            }
            _journalToken = entry!.Token;
            if (PendingMatchesCanonical(pending))
            {
                // The server save committed before this record could be
                // acknowledged. Its canonical payload wins and clears the
                // stale recovery record without replaying it.
                await RemovePendingAsync(entry.Token);
                return;
            }
            var restoredScene = JsonSerializer.Deserialize<CompositionScene>(pending.SceneJson, ManuscriptCodec.JsonOptions)
                ?? throw new InvalidDataException("The journaled cover scene is empty.");
            _scene = CoverCompositionFactory.KeepArtworkBehindCopy(restoredScene);
            _objects = _scene.Objects.ToList();
            _layers = _scene.Layers.ToList();
            _styles = _scene.Styles.ToList();
            ApplyCoverProperties(pending.Properties);
            _recoveredCoverRevision = pending.CoverRevision;
            _recoveredCoreBookRevision = pending.CoreBookRevision;
            _journalRecoverable = true;
            _dirty = true;
            _changeVersion++;
            ScheduleAutosave();
        }
        catch (Exception exception) { _ = FailJournal(exception.Message); }
    }

    private bool PendingMatchesCanonical(CoverPending pending) => _cover is not null && _scene is not null
        && CoverProperties(_cover) == pending.Properties
        && JsonSerializer.Serialize(_scene, ManuscriptCodec.JsonOptions)
            == JsonSerializer.Serialize(
                JsonSerializer.Deserialize<CompositionScene>(pending.SceneJson, ManuscriptCodec.JsonOptions),
                ManuscriptCodec.JsonOptions);

    private bool FailJournal(string message)
    {
        _journalRecoverable = false;
        _error = $"Local recovery is unavailable: {message}";
        UpdateAuthoringWriterState();
        return false;
    }

    private sealed record CoverPending(long CoverRevision, long? CoreBookRevision, string SurfaceRole, CompositionCoverProperties Properties, string SceneJson);
    private sealed record CanvasJournalEntry(string Token, JsonElement Payload);
    private enum CoverTransformMode { Move, Resize, Rotate, Crop }
    private sealed record CoverTransformState(Guid ObjectId, CoverTransformMode Mode, double StartClientX, double StartClientY, CompositionBounds SurfaceBounds, CompositionBounds LocalBounds, double StartRotation, double StartCropX, double StartCropY, long PointerId, CoverStageRect Stage);
    private sealed record CoverStageRect(double Left, double Top, double Width, double Height, double? ImageAspectRatio, bool Active);
}
