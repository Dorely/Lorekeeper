    private CompositionBounds BarcodeBounds
    {
        get
        {
            var back = RegionBounds(CompositionRegionConstraint.Back);
            var width = _cover!.Template.BarcodeWidthInches / _cover.Template.FullWidthInches * 100;
            var height = _cover.Template.BarcodeHeightInches / _cover.Template.FullHeightInches * 100;
            var insetX = _cover.Template.BarcodeInsetInches / _cover.Template.FullWidthInches * 100;
            var insetY = _cover.Template.BarcodeInsetInches / _cover.Template.FullHeightInches * 100;
            return new CompositionBounds
            {
                XPercent = Math.Max(back.XPercent, back.XPercent + back.WidthPercent - insetX - width),
                YPercent = Math.Max(back.YPercent, back.YPercent + back.HeightPercent - insetY - height),
                WidthPercent = Math.Min(width, back.WidthPercent),
                HeightPercent = Math.Min(height, back.HeightPercent),
            };
        }
    }
