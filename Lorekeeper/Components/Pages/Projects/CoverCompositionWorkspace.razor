@using System.Text.Json
@using Lorekeeper.Authoring
@using Lorekeeper.Composition
@using Lorekeeper.Fonts
@using Lorekeeper.Images
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Publish
@implements IAsyncDisposable
@inject IPublicationCoverService Covers
@inject IPublicationBookService Books
@inject IPublicationEditionService Editions
@inject IPublicationSectionService PublicationSections
@inject IProjectImageService Images
@inject IProjectFontService ProjectFonts
@inject IAuthoringDeltaHistoryRuntime DeltaHistory
@inject IAuthoringMutationFence AuthoringFence
@inject IAuthoringGenerationService AuthoringGenerations
@inject IAuthoringMutationContextAccessor AuthoringMutations
@inject IPrintArtifactProfileRegistry PrintArtifactProfiles
@inject IJSRuntime JS
@inject IPrintPreparationService Printing

<div class="cover-composer @((InteractionLocked || _authoringFrozen) ? "cover-composer--locked" : null)" aria-label="Cover composition editor" aria-disabled="@(InteractionLocked || _authoringFrozen)" inert="@((InteractionLocked || _authoringFrozen) ? string.Empty : null)" tabindex="0" @onkeydown="HandleKeyDown">
    <style>@((MarkupString)FontFaceCss())</style>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="cover-editor-alert" role="alert">
            <span>@PublicationDiagnosticText.SanitizeUserFacing(_error)</span>
            @if (_recoveryConflict)
            {
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ReloadCanonicalAsync">Discard local draft and reload</button>
            }
            <button type="button" title="Dismiss this message" aria-label="Dismiss cover editor error" @onclick="DismissError">&#215;</button>
        </div>
    }
    @if (_cover is null || _scene is null || (!CoreBook && _edition is null))
    {
        <p class="p-3 text-muted">Loading cover composition...</p>
    }
    else
    {
        <CompositionVisualEditorShell AccessibleLabel="Cover visual editor">
            <Toolbar>
                <nav class="cover-toolbar" aria-label="Cover view controls">
                    <button type="button" class="cover-back" title="Return to the publishing workspace" @onclick="NavigateBackAsync"><span aria-hidden="true">&#8592;</span> Back</button>
                    <div class="cover-identity"><strong>@(CoreBook ? "Core cover" : "Release cover")</strong><small>@ModeSummary</small></div>
                    @if (_surfaceRoles.Count > 1)
                    {
                        <div class="cover-surface-tabs" role="tablist" aria-label="Cover surfaces">
                            @foreach (var surface in _surfaceRoles)
                            {
                                <button type="button" role="tab" aria-selected="@(surface == _surfaceRole)" class="@(surface == _surfaceRole ? "selected" : null)" @onclick="() => SelectSurfaceAsync(surface)">@SurfaceLabel(surface)</button>
                            }
                        </div>
                    }
                    <button type="button"
                            class="cover-preview"
                            disabled="@(!CanPreview || _previewing)"
                            title="@PreviewTitle"
                            @onclick="PreviewAsync">@(_previewing ? "Generating…" : "Preview")</button>
                    <button type="button" class="cover-preview" disabled="@(!CanPreview || _previewing)" @onclick="() => _printOpen = true">Print</button>
                    <div class="cover-view-toggles" role="group" aria-label="Cover canvas aids">
                        <label title="Snap objects to the cover regions while moving or resizing"><input type="checkbox" @bind="_snap" /><span aria-hidden="true">&#8982;</span><span>Snap</span></label>
                        <label title="Show or hide safe-area and panel guides"><input type="checkbox" @bind="_guides" /><span aria-hidden="true">&#9638;</span><span>Guides</span></label>
                    </div>
                </nav>
            </Toolbar>
            <Canvas>
                <div class="cover-stage" style="@StageStyle()" @ref="_stageElement">
                    @if (_guides)
                    {
                        @foreach (var region in GuideRegions)
                        {
                            <div class="cover-safe" style="@SafeRegionStyle(region)"></div>
                            <div class="cover-surface-center" style="@RegionCenterStyle(region)"></div>
                        }
                    }
                    @if (IsPrint)
                    {
                        <div class="cover-panel cover-panel-back" style="@BackStyle">Back</div>
                        <div class="cover-panel cover-panel-spine" style="@SpineStyle">Spine</div>
                        <div class="cover-panel cover-panel-front" style="@FrontStyle">Front</div>
                        <div class="cover-barcode" style="@(_surfaceRole == "perfect-bound-inside" ? SpineStyle : BarcodeStyle)">@(_surfaceRole == "perfect-bound-inside" ? "No-ink spine area" : "Barcode reserve")</div>
                    }
                    @foreach (var item in _objects.Where(IsVisible))
                    {
                        <div role="button" tabindex="0" data-composition-object-id="@item.Id.ToString("N")" class="cover-object cover-object--@item.Kind.ToString().ToLowerInvariant() @(item.Id == _selectedId ? "selected" : null) @(IsCropRepositioning(item) ? "crop-repositioning" : null)" style="@ObjectStyle(item)" @onclick:stopPropagation="true" @onclick="() => SelectObject(item.Id)" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true" @onpointerdown="e => BeginTransformAsync(e, item, IsCropRepositioning(item) ? CoverTransformMode.Crop : CoverTransformMode.Move)">
                            @if (item.Kind == CompositionObjectKind.Text) { <span>@BoundText(item)</span> }
                            else if (item.Kind == CompositionObjectKind.Image && item.ImageId is Guid imageId && Image(imageId) is { } image) { <img src="@image.PreviewUrl" alt="" draggable="false" style="@ImageStyle(item)" /> }
                            else if (item.Kind == CompositionObjectKind.Image) { <span>Choose artwork</span> }
                            else if (item.Kind == CompositionObjectKind.Line) { <span class="cover-line" style="@LineStyle(item)"></span> }
                        </div>
                    }
                    @if (Selected is { } transformSelection && !IsLocked(transformSelection) && !IsCropRepositioning(transformSelection))
                    {
                        <div class="cover-selection-frame" style="@SelectionFrameStyle(transformSelection)" aria-hidden="true">
                            <span class="cover-handle cover-handle-resize" title="Drag to resize along the canvas axes" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true" @onpointerdown="e => BeginTransformAsync(e, transformSelection, CoverTransformMode.Resize)"></span>
                            <span class="cover-handle cover-handle-rotate" title="Drag to rotate" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true" @onpointerdown="e => BeginTransformAsync(e, transformSelection, CoverTransformMode.Rotate)"></span>
                        </div>
                    }
                </div>
            </Canvas>
            <Objects>
                <div class="cover-object-pane">
                    <div class="cover-add-tools" aria-label="Add cover content">
                        <button type="button" title="Add a cover text frame" @onclick="() => AddObject(CompositionObjectKind.Text)"><span aria-hidden="true">T</span> Text</button>
                        <button type="button" title="Choose artwork from the project image library" @onclick="OpenAddArtworkPicker"><span aria-hidden="true">▧</span> Image</button>
                        <label class="cover-retain-aspect cover-retain-aspect--compact" title="Keep newly added artwork proportional when it is resized"><input type="checkbox" aria-label="Keep new artwork proportional" @bind="_newRetainAspectRatio" /><span class="visually-hidden">Keep ratio</span></label>
                        <details class="cover-shapes-menu"><summary title="Add a simple shape">◇</summary><div><button type="button" @onclick="() => AddObject(CompositionObjectKind.Rectangle)">Rectangle</button><button type="button" @onclick="() => AddObject(CompositionObjectKind.Ellipse)">Ellipse</button><button type="button" @onclick="() => AddObject(CompositionObjectKind.Line)">Line</button></div></details>
                    </div>
                    <div class="cover-object-strip" role="listbox" aria-label="Cover objects">
                        @foreach (var item in _objects.OrderByDescending(item => item.ZIndex))
                        {
                            <button type="button" role="option" aria-selected="@(item.Id == _selectedId)" class="@(item.Id == _selectedId ? "selected" : null)" title="Select @ObjectLabel(item)" @onclick="() => SelectObject(item.Id)">
                                @if (item.Kind == CompositionObjectKind.Image && item.ImageId is Guid thumbnailId && Image(thumbnailId) is { } thumbnail) { <img src="@thumbnail.PreviewUrl" alt="" /> } else { <span aria-hidden="true">@ObjectIcon(item.Kind)</span> }
                                <small>@ObjectLabel(item)</small>
                            </button>
                        }
                    </div>
                </div>
            </Objects>
            <Selection>
                @if (Selected is { } primarySelection)
                {
                    <div class="cover-selection-controls">
                        @if (primarySelection.Kind == CompositionObjectKind.Image)
                        {
                            <button type="button" title="Choose different artwork for this image" @onclick="() => OpenReplaceArtworkPicker(primarySelection.Id)">Replace</button>
                            <label class="cover-retain-aspect" title="Keep the artwork's original proportions while resizing"><input type="checkbox" checked="@RetainsAspectRatio(primarySelection)" @onchange="e => SetRetainAspectRatioAsync(primarySelection, (bool)e.Value!)" /> Ratio</label>
                            <button type="button" title="Fill the entire cover; proportional artwork is cropped rather than stretched" @onclick="() => FillCanvasAsync(primarySelection)">Fill canvas</button>
                            @if (IsPrint) { <button type="button" title="Choose the Back, Spine, or Front region to crop-to-fill" @onclick="() => OpenFillRegionPicker(primarySelection)">Fill selected region</button> }
                            @if (primarySelection.ImageFit == FigureImageFit.Cover) { <button type="button" class="@(IsCropRepositioning(primarySelection) ? "selected" : null)" title="Drag the artwork within its fixed frame" @onclick="() => ToggleCropReposition(primarySelection)">@(IsCropRepositioning(primarySelection) ? "Finish crop" : "Reposition crop")</button> }
                        }
                        else if (primarySelection.Kind == CompositionObjectKind.Text)
                        {
                            var primaryStyle = Resolved(primarySelection);
                            <label>Text<input value="@primarySelection.TextBinding" @onchange="e => Patch(primarySelection with { TextBinding = e.Value?.ToString() ?? string.Empty })" /></label>
                            <label>Insert field<select value="" @onchange="e => AppendBindableToken(primarySelection, e.Value?.ToString())"><option value="">Choose…</option>@foreach (var token in AvailableTokens) { <option value="@token.Token">@token.Label</option> }</select></label>
                            <label>Font<select value="@primaryStyle.FontFamilyKey" @onchange="e => PatchLocalStyle(primarySelection, current => current with { FontFamilyKey = e.Value?.ToString() ?? string.Empty })">@foreach (var family in _fontFamilies) { <option value="@family.Key">@family.Name</option> }</select></label>
                            <label>Size<input class="cover-number" type="number" min="4" max="144" value="@primaryStyle.FontSizePoints" @onchange="e => PatchLocalStyle(primarySelection, current => current with { FontSizePoints = Number(e) })" /></label>
                            <label>Align<select value="@primaryStyle.TextAlignment" @onchange="e => PatchLocalStyle(primarySelection, current => current with { TextAlignment = Enum.Parse<CompositionTextAlignment>(e.Value!.ToString()!, true) })">@foreach (var alignment in Enum.GetValues<CompositionTextAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                            <label>Text<input type="color" value="@ColorValue(primaryStyle.FillColor)" @onchange="e => PatchLocalStyle(primarySelection, current => current with { FillColor = Color(e) })" /></label>
                            <label title="Choose the text box background color">Background<input type="color" aria-label="Text box background color" value="@ColorValue(primaryStyle.BackgroundColor)" @onchange="e => PatchLocalStyle(primarySelection, current => current with { BackgroundColor = Color(e) })" /></label>
                            <label class="cover-background-opacity" title="Set text box background opacity; 0% is fully transparent">Opacity<span><input type="range" aria-label="Text box background opacity" min="0" max="1" step=".05" value="@primaryStyle.BackgroundOpacity" @onchange="e => PatchLocalStyle(primarySelection, current => current with { BackgroundOpacity = Number(e) })" /><output>@Math.Round(Math.Clamp(primaryStyle.BackgroundOpacity, 0, 1) * 100)%</output></span></label>
                            <button type="button" class="cover-no-background @(primaryStyle.BackgroundOpacity <= 0 ? "selected" : null)" title="Make the text box background fully transparent" @onclick="() => PatchLocalStyle(primarySelection, current => current with { BackgroundOpacity = 0 })">No background</button>
                        }
                        @if (primarySelection.Kind is CompositionObjectKind.Text or CompositionObjectKind.Image)
                        {
                            <button type="button" title="Expand this frame to the full width of its constrained cover surface without stretching artwork" @onclick="() => FitSelectionWidth(primarySelection, false)">Fit width</button>
                            <button type="button" title="Expand this frame to the safe width of its constrained cover surface without stretching artwork" @onclick="() => FitSelectionWidth(primarySelection, true)">Fit safe width</button>
                            <button type="button" title="Center this frame horizontally within its constrained cover surface" @onclick="() => CenterSelection(primarySelection, false)">Center</button>
                            <button type="button" title="Center this frame horizontally within the safe margins of its constrained cover surface" @onclick="() => CenterSelection(primarySelection, true)">Center safe</button>
                            <button type="button" title="Rotate this frame clockwise by 90 degrees" @onclick="() => Patch(CompositionObjectLayout.RotateQuarterTurn(primarySelection))">Rotate 90°</button>
                            <button type="button" disabled="@(Math.Abs(primarySelection.RotationDegrees) <= .001)" title="Reset this frame to zero degrees" @onclick="() => Patch(CompositionObjectLayout.ResetRotation(primarySelection))">Reset rotation</button>
                        }
                        <span class="cover-control-divider" aria-hidden="true"></span>
                        <button type="button" title="Move this object to the back of its artwork or content group" @onclick="() => SendToBack(primarySelection)">Back</button><button type="button" title="Move this object to the front of its artwork or content group" @onclick="() => BringToFront(primarySelection)">Front</button><button type="button" class="@(primarySelection.Locked ? "selected" : null)" title="Lock or unlock this object" @onclick="() => ToggleObjectLock(primarySelection)">@(primarySelection.Locked ? "Unlock" : "Lock")</button><button type="button" class="danger" title="Delete selected object" @onclick="() => Delete(primarySelection.Id)">Delete</button>
                    </div>
                }
                else { <p class="cover-empty-selection">Select an object on the cover to edit it. Drag to move; use the handles to resize or rotate.</p> }
            </Selection>
            <Details>
                <div class="cover-workspace-actions">
                    <div><button type="button" title="@UndoTitle" @onclick="() => MoveHistoryAsync(false)" disabled="@(!_history.CanUndo || InteractionLocked)">↶</button><button type="button" title="@RedoTitle" @onclick="() => MoveHistoryAsync(true)" disabled="@(!_history.CanRedo || InteractionLocked)">↷</button><button type="button" title="Zoom out" @onclick="() => _zoom = Math.Max(.3, _zoom - .1)">−</button><span>@Math.Round(_zoom * 100)%</span><button type="button" title="Zoom in" @onclick="() => _zoom = Math.Min(1.6, _zoom + .1)">+</button></div>
                    <details class="cover-secondary-controls">
                    <summary title="Open cover copy, accessibility, and exact layout settings">Cover details</summary>
                    <div class="cover-details-panel">
                        <h3>Bound cover copy</h3>
                        <label>Title<input @bind="_title" @bind:after="MarkDirty" /></label>
                        <label>Subtitle<input @bind="_subtitle" @bind:after="MarkDirty" /></label>
                        <label>Author<input @bind="_author" @bind:after="MarkDirty" /></label>
                        @if (IsPrint)
                        {
                            <label>Spine text<input @bind="_spineText" @bind:after="MarkDirty" /></label>
                            <label>Spine direction<select @bind="_spineDirection" @bind:after="SpineDirectionChanged"><option value="@SpineReadingDirection.TopToBottom">Top to bottom (US/English default)</option><option value="@SpineReadingDirection.BottomToTop">Bottom to top</option><option value="@SpineReadingDirection.Horizontal">Horizontal</option></select></label>
                            <p class="cover-copy-source">The <code>{{description}}</code> token uses the Description shown in Book details.</p>
                            <label>Barcode behavior<select @bind="_barcodeMode" @bind:after="MarkDirty"><option value="@PublicationBarcodeMode.LorekeeperBarcode">Generate ISBN-13 barcode</option><option value="@PublicationBarcodeMode.VendorOverlay">Reserve vendor overlay area</option></select></label>
                        }
                        <label>Background<input type="color" @bind="_background" @bind:after="MarkDirty" /></label>

                                <h3>Selected object details</h3>
                        @if (Selected is { } selected)
                        {
                            <label>Name<input value="@selected.Name" @onchange="e => Patch(selected with { Name = e.Value?.ToString() ?? string.Empty })" /></label>
                            <div class="cover-grid"><label>X %<input type="number" step=".1" value="@selected.Bounds.XPercent" @onchange="e => PatchBounds(selected, x: Number(e))" /></label><label>Y %<input type="number" step=".1" value="@selected.Bounds.YPercent" @onchange="e => PatchBounds(selected, y: Number(e))" /></label><label>Width %<input type="number" step=".1" value="@selected.Bounds.WidthPercent" @onchange="e => PatchBounds(selected, width: Number(e))" /></label><label>Height %<input type="number" step=".1" value="@selected.Bounds.HeightPercent" @onchange="e => PatchBounds(selected, height: Number(e))" /></label></div>
                            <label>Constrain to<select value="@selected.RegionConstraint" @onchange="e => Patch(selected with { RegionConstraint = Enum.Parse<CompositionRegionConstraint>(e.Value!.ToString()!) })">@foreach (var region in AvailableRegions) { <option value="@region">@region</option> }</select></label>
                            <label>Rotation<input type="number" value="@selected.RotationDegrees" @onchange="e => Patch(selected with { RotationDegrees = Number(e) })" /></label>
                            <label>Opacity<input type="range" min="0" max="1" step=".05" value="@selected.Opacity" @onchange="e => Patch(selected with { Opacity = Number(e) })" /></label>
                            <label><input type="checkbox" checked="@selected.Visible" @onchange="e => Patch(selected with { Visible = (bool)e.Value! })" /> Visible</label>
                            <label><input type="checkbox" checked="@selected.Locked" @onchange="e => Patch(selected with { Locked = (bool)e.Value! })" /> Locked</label>
                            <label>Object style<select value="@selected.StyleId" @onchange="e => SetObjectStyle(selected, e)"><option value="">Local formatting</option>@foreach (var style in _styles) { <option value="@style.Id">@style.Name</option> }</select></label>
                            <div class="cover-actions"><button type="button" @onclick="() => CreateStyleFrom(selected)">Save reusable style</button>@if (selected.StyleId is Guid styleId) { <button type="button" @onclick="() => DeleteStyle(styleId)">Delete style</button> }</div>
                            <label>Semantic role<select value="@selected.SemanticRole" @onchange="e => Patch(selected with { SemanticRole = Enum.Parse<CompositionSemanticRole>(e.Value!.ToString()!) })">@foreach (var role in Enum.GetValues<CompositionSemanticRole>()) { <option value="@role">@role</option> }</select></label>
                            <label>Reading order<input type="number" value="@selected.ReadingOrder" @onchange="e => Patch(selected with { ReadingOrder = NullableInt(e) })" /></label>
                            @if (selected.Kind == CompositionObjectKind.Image)
                            {
                                <div class="cover-current-artwork">
                                    @if (selected.ImageId is Guid currentImageId && Image(currentImageId) is { } currentImage)
                                    {
                                        <img src="@currentImage.PreviewUrl" alt="" />
                                        <span><small>Project artwork</small><strong>@currentImage.FileName</strong></span>
                                    }
                                    else
                                    {
                                        <span><small>Project artwork</small><strong>No artwork selected</strong></span>
                                    }
                                    <button type="button" @onclick="() => OpenReplaceArtworkPicker(selected.Id)">Replace artwork</button>
                                </div>
                                <label><input type="checkbox" checked="@RetainsAspectRatio(selected)" @onchange="e => SetRetainAspectRatioAsync(selected, (bool)e.Value!)" /> Retain aspect ratio</label>
                                <button type="button" title="Fill the entire cover; proportional artwork is cropped rather than stretched" @onclick="() => FillCanvasAsync(selected)">Fill canvas</button>
                                @if (IsPrint) { <button type="button" title="Choose the Back, Spine, or Front region to crop-to-fill" @onclick="() => OpenFillRegionPicker(selected)">Fill selected region</button> }
                                @if (selected.ImageFit == FigureImageFit.Cover)
                                {
                                    <button type="button" class="@(IsCropRepositioning(selected) ? "selected" : null)" @onclick="() => ToggleCropReposition(selected)">@(IsCropRepositioning(selected) ? "Finish repositioning" : "Reposition crop")</button>
                                }
                                <label>Alternative text<textarea value="@selected.AltText" @onchange="e => SetAltText(selected, e.Value?.ToString() ?? string.Empty)"></textarea></label>
                                <label><input type="checkbox" checked="@selected.Decorative" @onchange="e => SetDecorative(selected, (bool)e.Value!)" /> Decorative artwork</label>
                            }
                            @if (selected.Kind == CompositionObjectKind.Text)
                            {
                                var resolved = Resolved(selected);
                                <label>Text template<textarea rows="3" value="@selected.TextBinding" @onchange="e => Patch(selected with { TextBinding = e.Value?.ToString() ?? string.Empty })"></textarea></label>
                                <div class="cover-token-list" aria-label="Bindable cover text fields">
                                    @foreach (var token in AvailableTokens)
                                    {
                                        <button type="button" title="Append @token.Token to this text box" @onclick="() => AppendBindableToken(selected, token.Token)">@token.Token</button>
                                    }
                                </div>
                                <label>Font family<select value="@resolved.FontFamilyKey" @onchange="e => PatchLocalStyle(selected, current => current with { FontFamilyKey = e.Value?.ToString() ?? string.Empty })">@foreach (var family in _fontFamilies) { <option value="@family.Key">@family.Name</option> }</select></label>
                                <label>Font weight<input type="number" min="100" max="900" step="100" value="@resolved.FontWeight" @onchange="e => PatchLocalStyle(selected, current => current with { FontWeight = (int)Number(e) })" /></label>
                                <label>Font size<input type="number" min="4" max="144" value="@resolved.FontSizePoints" @onchange="e => PatchLocalStyle(selected, current => current with { FontSizePoints = Number(e) })" /></label>
                                <label>Line height<input type="number" min=".5" max="4" step=".05" value="@resolved.LineHeight" @onchange="e => PatchLocalStyle(selected, current => current with { LineHeight = Number(e) })" /></label>
                                <label>Letter spacing (em)<input type="number" min="-1" max="10" step=".01" value="@resolved.LetterSpacingEm" @onchange="e => PatchLocalStyle(selected, current => current with { LetterSpacingEm = Number(e) })" /></label>
                                <label>Horizontal alignment<select value="@resolved.TextAlignment" @onchange="e => PatchLocalStyle(selected, current => current with { TextAlignment = Enum.Parse<CompositionTextAlignment>(e.Value!.ToString()!, true) })">@foreach (var alignment in Enum.GetValues<CompositionTextAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                                <label>Vertical alignment<select value="@resolved.VerticalAlignment" @onchange="e => PatchLocalStyle(selected, current => current with { VerticalAlignment = Enum.Parse<CompositionVerticalAlignment>(e.Value!.ToString()!, true) })">@foreach (var alignment in Enum.GetValues<CompositionVerticalAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                                <label>Text shadow<select value="@resolved.TextShadow" @onchange="e => PatchLocalStyle(selected, current => current with { TextShadow = Enum.Parse<CompositionTextShadow>(e.Value!.ToString()!, true) })">@foreach (var shadow in Enum.GetValues<CompositionTextShadow>()) { <option value="@shadow">@shadow</option> }</select></label>
                            }
                            @if (selected.Kind is CompositionObjectKind.Text or CompositionObjectKind.Rectangle or CompositionObjectKind.Ellipse or CompositionObjectKind.Line)
                            {
                                var resolved = Resolved(selected);
                                <label>Fill<input type="color" value="@ColorValue(resolved.FillColor)" @onchange="e => PatchLocalStyle(selected, current => current with { FillColor = Color(e) })" /></label>
                                <label>Stroke<input type="color" value="@ColorValue(resolved.StrokeColor)" @onchange="e => PatchLocalStyle(selected, current => current with { StrokeColor = Color(e) })" /></label>
                                <label>Stroke width<input type="number" min="0" max="72" step=".25" value="@resolved.StrokeWidthPoints" @onchange="e => PatchLocalStyle(selected, current => current with { StrokeWidthPoints = Number(e) })" /></label>
                            }
                            <div class="cover-actions"><button type="button" @onclick="() => SendToBack(selected)">Send back</button><button type="button" @onclick="() => BringToFront(selected)">Bring front</button><button type="button" class="danger" @onclick="() => Delete(selected.Id)">Delete</button></div>
                        }
                        else { <p class="text-muted">Select an object to edit its exact geometry and semantics.</p> }
                        <h3>Logical reading order</h3>
                        @foreach (var item in _objects.Where(item => item.Visible && item.ReadingOrder is not null).OrderBy(item => item.ReadingOrder))
                        {
                            <div class="cover-reading-row"><span>@item.ReadingOrder</span> @ObjectLabel(item) (@item.SemanticRole) <button type="button" @onclick="() => MoveReadingOrder(item, -1)">Up</button><button type="button" @onclick="() => MoveReadingOrder(item, 1)">Down</button></div>
                        }
                        <h3>Geometry</h3>
                        <p>@_cover.Template.FullWidthInches.ToString("0.###") × @_cover.Template.FullHeightInches.ToString("0.###") in</p>
                        @if (IsPrint) { <p>@_cover.Template.PageCount pages; @_cover.Template.SpineWidthInches.ToString("0.###") in spine.</p> }
                        @foreach (var diagnostic in _cover.Diagnostics) { <p class="text-warning-emphasis">@PublicationDiagnosticText.SanitizeUserFacing(diagnostic)</p> }
                    </div>
                    </details>
                </div>
            </Details>
        </CompositionVisualEditorShell>
    }
</div>

<ProjectImageLibraryPickerModal ProjectId="@ProjectId"
                                IsOpen="@(_artworkPickerMode is not null)"
                                Title="@ArtworkPickerTitle"
                                PrimaryActionLabel="@ArtworkPickerActionLabel"
                                AllowedContentTypes="@PublicationImageContentTypes"
                                InitialSelectedImageId="@ArtworkPickerInitialSelection"
                                OnPrimaryAction="UsePickedArtworkAsync"
                                OnClose="CloseArtworkPicker" />

@if (_fillRegionTargetId is not null && IsPrint)
{
    <div class="cover-region-modal-backdrop" @onclick="CloseFillRegionPicker">
        <section class="cover-region-modal" role="dialog" aria-modal="true" aria-labelledby="cover-fill-region-title" @onclick:stopPropagation="true">
            <header>
                <div><h2 id="cover-fill-region-title">Fill a cover region</h2><p>Choose the only region this image should crop-to-fill.</p></div>
                <button type="button" title="Close region picker" aria-label="Close region picker" @onclick="CloseFillRegionPicker">&#215;</button>
            </header>
            <div class="cover-region-options">
                @foreach (var region in CoverRegions)
                {
                    <button type="button" @onclick="() => FillRegionAsync(region)">
                        <strong>@region.Role</strong>
                        <span>@region.WidthInches.ToString("0.###") × @region.HeightInches.ToString("0.###") in</span>
