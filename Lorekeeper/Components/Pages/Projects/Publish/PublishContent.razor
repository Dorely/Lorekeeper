@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Manuscripts
@using Lorekeeper.Composition
@implements IAsyncDisposable
@inject IPublishService Publishing
@inject IPublicationBookService Books
@inject IPublicationEditionService Releases
@inject IPublicationCoverService Covers
@inject IPublicationPreparationService Preparation
@inject IPublicationRenderService Renders
@inject IProjectPageSetupService PageSetups
@inject IJSRuntime JS

@if (Project is null || _loading)
{
    <div class="publish-loading" role="status"><span class="spinner-border spinner-border-sm"></span> Loading Publish…</div>
}
else
{
    <main class="publish-workspace" aria-label="Publish">
        <div class="publish-layout">
            <aside class="publish-assistant-pane" aria-label="Publish assistant">
                @if (!_assistantMounted)
                {
                    <div class="publish-pane-loading" role="status"><span class="spinner-border spinner-border-sm"></span><span>Loading publishing workspace...</span></div>
                }
                else
                {
                    <PublishChatPanel ProjectId="Project.Id"
                                      SelectedEditionId="_assistantSelectedReleaseId"
                                      WorkspaceRefreshing="_targetLoading"
                                      OnBeforeSend="SavePendingAsync"
                                      OnWorkspaceMutated="HandleAssistantMutationAsync" />
                }
            </aside>

            <section class="publish-main">
                <nav class="publish-target-nav" aria-label="Book and publication releases">
                    <button class="target-chip @(_selectedReleaseId is null ? "selected" : null)" disabled="@_targetLoading" @onclick="SelectCoreAsync">
                        <span>Core Book</span><small>Shared book</small>
                    </button>
                    @foreach (var release in _releases.Where(item => item.Status != PublicationEditionStatus.Archived))
                    {
                        <button class="target-chip @(_selectedReleaseId == release.Id ? "selected" : null)" disabled="@_targetLoading" @onclick="() => SelectReleaseAsync(release.Id)">
                            <span>@release.Name</span><small>@ReleaseTypeLabel(release.Format)</small>
                        </button>
                    }
                    <button class="target-chip add" disabled="@_targetLoading" @onclick="() => _addReleaseOpen = true"><span>＋ Add release</span><small>Paperback or ebook</small></button>
                </nav>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <div class="publish-notice" role="status">@_notice</div>
                }

                <div class="publish-scroll">
                    @if (_coverEditorOpen && Project is not null)
                    {
                        <CoverCompositionWorkspace @ref="_coverWorkspace"
                                                   ProjectId="Project.Id"
                                                   EditionId="_selectedReleaseId ?? Guid.Empty"
                                                   CoreBook="@(_selectedReleaseId is null)"
                                                   RefreshSignal="_coverRefreshSignal"
                                                   RequestedSelectionId="_coverSelectionId"
                                                   Saved="HandleCoverSavedAsync"
                                                   Back="CloseCoverEditorAsync" />
                    }
                    else if (_selectedReleaseId is null && _core is not null)
                    {
                        <fieldset class="publish-target-content" disabled="@_targetLoading">@CoreBookView()</fieldset>
                    }
                    else if (_workspace is not null)
                    {
                        <fieldset class="publish-target-content" disabled="@_targetLoading">@ReleaseView()</fieldset>
                    }
                    else if (_targetLoading)
                    {
                        <div class="publish-target-loading" role="status"><span class="spinner-border spinner-border-sm"></span><span>Loading release settings...</span></div>
                    }
                </div>
            </section>
        </div>
    </main>
}

@if (_addReleaseOpen)
{
    <div class="publish-modal-backdrop" role="presentation" @onclick="() => _addReleaseOpen = false">
        <section class="publish-modal" role="dialog" aria-modal="true" aria-labelledby="add-release-title" @onclick:stopPropagation="true">
            <header><div><span class="eyebrow">Publication release</span><h2 id="add-release-title">What are you preparing?</h2></div><button class="btn-close" aria-label="Close" @onclick="() => _addReleaseOpen = false"></button></header>
            <div class="release-cards">
                <button class="release-card @(_newFormat == PublicationEditionFormat.Paperback ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.Paperback)"><strong>Paperback</strong><span>Printer-ready interior, full-wrap cover, and package.</span></button>
                <button class="release-card @(_newFormat == PublicationEditionFormat.Epub ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.Epub)"><strong>EPUB ebook</strong><span>Accessible EPUB 3 for ebook stores and readers.</span></button>
                <button class="release-card @(_newFormat == PublicationEditionFormat.DigitalPdf ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.DigitalPdf)"><strong>PDF ebook</strong><span>Tagged cover-plus-book PDF for digital distribution.</span></button>
            </div>
            <label class="field"><span>Release name</span><input class="form-control" @bind="_newReleaseName" @bind:event="oninput" /></label>
            @if (_newFormat == PublicationEditionFormat.Paperback)
            {
                <label class="field"><span>Printer or service</span><select class="form-select" @bind="_newVendor"><option value="@PublicationVendor.AmazonKdp">Amazon KDP</option><option value="@PublicationVendor.IngramSpark">IngramSpark</option><option value="@PublicationVendor.Generic">Other printer</option></select></label>
            }
            <footer><button class="btn btn-outline-secondary" @onclick="() => _addReleaseOpen = false">Cancel</button><button class="btn btn-primary" disabled="@_busy" @onclick="CreateReleaseAsync">@(_busy ? "Creating…" : "Create release")</button></footer>
        </section>
    </div>
}

@if (_previewArtifact is { } previewArtifact && Project is not null)
{
    <div class="publish-modal-backdrop" role="presentation" @onclick="ClosePdfPreview">
        <section class="publish-modal pdf-preview-modal" role="dialog" aria-modal="true" aria-labelledby="reading-pdf-preview-title" @onclick:stopPropagation="true">
            <header>
                <div><span class="eyebrow">Private review copy</span><h2 id="reading-pdf-preview-title">Reading PDF preview</h2></div>
                <div class="button-row">
                    <a class="btn btn-sm btn-outline-primary" href="@DownloadUrl(previewArtifact.Id)" download="@previewArtifact.FileName">Save reading PDF</a>
                    <button class="btn-close" aria-label="Close reading PDF preview" @onclick="ClosePdfPreview"></button>
                </div>
            </header>
            <iframe src="@ViewUrl(previewArtifact.Id)" title="Core Book reading PDF preview"></iframe>
        </section>
    </div>
}

@if (Project is not null)
{
    <BookTextStylesModal ProjectId="Project.Id"
                         IsOpen="_bookTextStylesModalOpen"
                         RefreshSignal="_bookTextStylesRefreshSignal"
                         BeforeChange="FlushBeforeBookStyleChangeAsync"
                         Changed="HandleBookTextStylesChangedAsync"
                         OnClose="CloseBookTextStylesModal" />
}

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private PublicationBookView? _core;
    private PublishWorkspaceView? _workspace;
    private IReadOnlyList<PublicationEditionSummary> _releases = [];
    private IReadOnlyList<PublicationPreparationJobView> _preparations = [];
    private IReadOnlyList<PublicationArtifactView> _artifacts = [];
    private IReadOnlyList<PublicationBookOutlineView> _coreOutline = [];
    private IReadOnlyList<PublicationMatterView> _coreMatter = [];
    private IReadOnlyList<PublicationImagePlacementView> _corePlacements = [];
    private Dictionary<(PublishOutlineTargetKind Kind, Guid Id), bool> _coreSelections = [];
    private CoreDraft _coreDraft = new();
    private ReleaseDraft _releaseDraft = new();
    private HashSet<PublicationEditionOverrideField> _releaseOverrides = [];
    private HashSet<PublicationEditionOverrideField> _loadedOverrides = [];
    private Dictionary<Guid, bool> _releaseSelections = [];
    private Dictionary<Guid, bool> _loadedReleaseSelections = [];
    private Guid? _loadedProjectId;
    private Guid? _selectedReleaseId;
    private Guid? _assistantSelectedReleaseId;
    private bool _loading = true;
    private bool _targetLoading = true;
    private bool _targetLoadPending;
    private bool _targetLoadRunning;
    private bool _assistantMounted;
    private bool _refreshCoreSummaryOnTargetLoad;
    private bool _coreDetailsLoaded;
    private bool _outputsLoaded;
    private bool _busy;
    private bool _addReleaseOpen;
    private bool _coverEditorOpen;
    private bool _bookTextStylesModalOpen;
    private long _bookTextStylesRefreshSignal;
    private CoverCompositionWorkspace? _coverWorkspace;
    private long _coverRefreshSignal;
    private Guid? _coverSelectionId;
    private PublicationArtifactView? _previewArtifact;
    private bool _coreDirty;
    private bool _coreOutlineDirty;
    private bool _pageSetupDirty;
    private double _pageWidthInches = 6;
    private double _pageHeightInches = 9;
    private double _pageMarginInches = .75;
    private double _bodyFontSizePoints = 12;
    private double _bodyLineHeight = 1.55;
    private bool _releaseDirty;
    private bool _releaseContentDirty;
    private bool _releaseContentOpen;
    private bool _releaseDesignOpen;
    private Guid? _editingCoreMatterId;
    private string _coreMatterTitle = string.Empty;
    private string _coreMatterJson = string.Empty;
    private long _editingCoreMatterRevision;
    private PublicationMatterLocation _coreMatterLocation;
    private PublicationMatterKind _coreMatterKind;
    private int _coreMatterSortOrder;
    private bool _coreMatterIncluded;
    private ChapterBodyEditor? _coreMatterEditor;
    private string? _error;
    private string? _notice;
    private PublicationEditionFormat _newFormat = PublicationEditionFormat.Paperback;
    private PublicationVendor _newVendor = PublicationVendor.AmazonKdp;
    private string _newReleaseName = "Paperback";
    private IJSObjectReference? _downloads;
    private readonly CancellationTokenSource _dispose = new();
    private int _pollGeneration;
    private int _targetLoadGeneration;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null || _loadedProjectId == Project.Id) return;
        _loadedProjectId = Project.Id;
        await LoadCoreAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_targetLoadPending || _targetLoadRunning || Project is null)
            return;
        _targetLoadRunning = true;
        try
        {
            while (_targetLoadPending && !_dispose.IsCancellationRequested)
            {
                _targetLoadPending = false;
                var generation = _targetLoadGeneration;
                try
                {
                    if (_selectedReleaseId is Guid releaseId)
                        await LoadReleaseTargetAsync(releaseId, generation);
                    else
                        await LoadCoreTargetAsync(generation);
                }
                catch (OperationCanceledException) when (_dispose.IsCancellationRequested || generation != _targetLoadGeneration)
                {
                }
                catch (Exception exception)
                {
                    if (generation == _targetLoadGeneration)
                        _error = exception.Message;
                }

                if (generation == _targetLoadGeneration && !_targetLoadPending)
                {
                    _assistantSelectedReleaseId = _selectedReleaseId;
                    _assistantMounted = true;
                    _targetLoading = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _targetLoadRunning = false;
        }
    }

    private async Task LoadCoreAsync()
    {
        if (Project is null) return;
        _previewArtifact = null;
        var initialLoad = _core is null;
        _loading = initialLoad;
        _targetLoading = true;
        _targetLoadPending = false;
        _targetLoadGeneration++;
        _error = null;
        try
        {
            _core = await Books.GetOrCreateAsync(Project.Id);
            _releases = await Releases.ListAsync(Project.Id);
            _coreDraft = CoreDraft.From(_core);
            CopyPageSetupDraft();
            _coreDirty = false;
            _coreOutlineDirty = false;
            _pageSetupDirty = false;
            _coreOutline = [];
            _coreMatter = [];
            _corePlacements = [];
            _coreSelections = [];
            _coreDetailsLoaded = false;
            _outputsLoaded = false;
            _preparations = [];
            _artifacts = [];
            _selectedReleaseId = null;
            _workspace = null;
            _refreshCoreSummaryOnTargetLoad = false;
            _targetLoadPending = true;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally
        {
            _loading = false;
            if (_error is not null)
            {
                _targetLoading = false;
                _assistantSelectedReleaseId = null;
                _assistantMounted = true;
            }
        }
    }

    private async Task SelectCoreAsync()
    {
        await SavePendingAsync();
        _coverEditorOpen = false;
        await LoadCoreAsync();
    }

    private async Task SelectReleaseAsync(Guid id)
    {
        if (Project is null) return;
        await SavePendingAsync();
        _coverEditorOpen = false;
        _previewArtifact = null;
        _selectedReleaseId = id;
        _workspace = null;
        _preparations = [];
        _artifacts = [];
        _outputsLoaded = false;
        _targetLoading = true;
        _targetLoadPending = true;
        _targetLoadGeneration++;
        _error = null;
    }

    private async Task LoadCoreTargetAsync(int generation)
    {
        if (Project is null || generation != _targetLoadGeneration)
            return;
        if (_refreshCoreSummaryOnTargetLoad)
        {
            _core = await Books.GetOrCreateAsync(Project.Id, _dispose.Token);
            _releases = await Releases.ListAsync(Project.Id, _dispose.Token);
            _coreDraft = CoreDraft.From(_core);
            CopyPageSetupDraft();
            _coreDirty = false;
            _pageSetupDirty = false;
            _refreshCoreSummaryOnTargetLoad = false;
        }
        var details = await Books.GetDetailsAsync(Project.Id, _dispose.Token);
        if (generation != _targetLoadGeneration)
            return;
        _coreOutline = details.Outline;
        _coreMatter = details.Matter;
        _corePlacements = details.ImagePlacements;
        _coreSelections = _coreOutline.ToDictionary(item => (item.TargetKind, item.TargetId), item => item.IsIncluded);
        _coreDetailsLoaded = true;
        await InvokeAsync(StateHasChanged);

        _preparations = await Preparation.ListAsync(Project.Id, PublicationTargetKind.CoreBook, cancellationToken: _dispose.Token);
        var jobs = await Renders.ListCoreAsync(Project.Id, _dispose.Token);
        if (generation != _targetLoadGeneration)
            return;
        _artifacts = jobs.SelectMany(item => item.Artifacts).OrderByDescending(item => item.CreatedAt).ToList();
        _outputsLoaded = true;
        ResumeActivePreparation(PublicationTargetKind.CoreBook, null);
    }

    private async Task LoadReleaseTargetAsync(Guid releaseId, int generation)
    {
        if (Project is null || generation != _targetLoadGeneration)
            return;
        _workspace = await Publishing.GetWorkspaceForEditingAsync(Project.Id, releaseId, _dispose.Token);
        if (generation != _targetLoadGeneration)
            return;
        _releaseDraft = ReleaseDraft.From(_workspace.Edition);
        _releaseOverrides = _workspace.OverrideFields.ToHashSet();
        _loadedOverrides = _releaseOverrides.ToHashSet();
        _releaseDirty = false;
        _releaseSelections = _workspace.Sections.SelectMany(section => section.Chapters)
            .ToDictionary(item => item.Id, item => item.IsIncluded);
        _loadedReleaseSelections = _releaseSelections.ToDictionary();
        _releaseContentDirty = false;
        _releaseContentOpen = _workspace.HasContentOverrides;
        _releaseDesignOpen = _workspace.OverrideFields.Any(IsDesignOverride);
        await InvokeAsync(StateHasChanged);

        _preparations = await Preparation.ListAsync(Project.Id, PublicationTargetKind.Release, releaseId, _dispose.Token);
        _artifacts = await Renders.ListArtifactsAsync(Project.Id, releaseId, _dispose.Token);
        _releases = await Releases.ListAsync(Project.Id, _dispose.Token);
        if (generation != _targetLoadGeneration)
            return;
        _outputsLoaded = true;
        ResumeActivePreparation(PublicationTargetKind.Release, releaseId);
    }

    private RenderFragment CoreBookView() => @<div class="workspace-stack">
        <section class="readiness-card">
            <div><span class="eyebrow">Private review copy</span><h1>Core Book</h1><p>Shared book details, content, design, and cover. Publication releases inherit these values live.</p></div>
            <div class="primary-action"><button class="btn btn-primary" disabled="@(_busy || !_outputsLoaded || HasActivePreparation)" @onclick="PrepareCoreAsync">@PreparationButton("Prepare reading PDF")</button><small>A tagged review PDF—not a publication product.</small></div>
            @PreparationStatus()
            @CoreDownloads()
        </section>

        <section class="workspace-card core-book-design-card">
            <header>
                <div><div><span class="eyebrow">Book design</span><h2>Page, text, and cover defaults</h2><p>These shared choices flow into the reading PDF and publication releases unless customized.</p></div></div>
                <button class="btn btn-sm btn-primary" disabled="@(!_pageSetupDirty || _busy)" @onclick="SavePageSetupAsync">Save design</button>
            </header>
            <div class="core-book-design-grid">
                <div class="core-design-pane">
                    <div class="core-design-heading"><div><h3>Page and text defaults</h3><p>Set the regular page geometry and baseline body typography.</p></div><button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenBookTextStylesModal">Manage Book Text Styles</button></div>
                    <div class="page-setup-grid">
                        <label class="field full"><span>Page size</span><select class="form-select" value="@PageSetupPreset()" @onchange="PageSetupPresetChanged"><option value="6x9">6 × 9 in</option><option value="5.5x8.5">5.5 × 8.5 in</option><option value="8.5x11">8.5 × 11 in</option><option value="custom">Custom</option></select></label>
                        <label class="field"><span>Width (in)</span><input class="form-control" type="number" min="3" max="24" step="0.125" @bind="_pageWidthInches" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Height (in)</span><input class="form-control" type="number" min="3" max="24" step="0.125" @bind="_pageHeightInches" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Margins (in)</span><input class="form-control" type="number" min="0.25" max="3" step="0.0625" @bind="_pageMarginInches" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Body size (pt)</span><input class="form-control" type="number" min="6" max="36" step="0.25" @bind="_bodyFontSizePoints" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Line height</span><input class="form-control" type="number" min="0.8" max="3" step="0.05" @bind="_bodyLineHeight" @bind:after="MarkPageSetupDirty" /></label>
                    </div>
                </div>
                <div class="core-design-pane core-cover-summary">
                    <div><span class="eyebrow">Core cover</span><h3>Reusable front cover</h3><p>The front cover flows into EPUB and PDF releases and becomes the front panel of paperback covers.</p></div>
                    <div class="button-row"><button class="btn btn-sm btn-outline-primary" @onclick="OpenCoreCoverAsync">Edit Core cover</button><span class="status-pill">Revision @_core!.CoverRevision</span></div>
                </div>
            </div>
        </section>

        <section class="workspace-card"><header><div><span class="step">01</span><div><h2>Book details</h2><p>Enter these once. Releases use them unless customized.</p></div></div><button class="btn btn-sm btn-primary" disabled="@((!_coreDirty && !_coreOutlineDirty) || _busy)" @onclick="SaveCoreAsync">Save changes</button></header>
            <div class="form-grid">
                <label class="field wide"><span>Title</span><input class="form-control" value="@_coreDraft.Title" @oninput="e => CoreChanged(nameof(CoreDraft.Title), e.Value?.ToString())" /></label>
                <label class="field wide"><span>Subtitle <small>optional</small></span><input class="form-control" value="@_coreDraft.Subtitle" @oninput="e => CoreChanged(nameof(CoreDraft.Subtitle), e.Value?.ToString())" /></label>
                <label class="field"><span>Author</span><input class="form-control" value="@_coreDraft.Author" @oninput="e => CoreChanged(nameof(CoreDraft.Author), e.Value?.ToString())" /></label>
                <label class="field"><span>Language</span>@LanguageSelect(_coreDraft.Language, false, value => CoreChanged(nameof(CoreDraft.Language), value))</label>
                <label class="field"><span>Publisher <small>optional</small></span><input class="form-control" value="@_coreDraft.Publisher" @oninput="e => CoreChanged(nameof(CoreDraft.Publisher), e.Value?.ToString())" /></label>
                <label class="field"><span>Copyright <small>optional</small></span><input class="form-control" value="@_coreDraft.Copyright" @oninput="e => CoreChanged(nameof(CoreDraft.Copyright), e.Value?.ToString())" /></label>
                <label class="field full"><span>Description <small>optional</small></span><textarea class="form-control" rows="4" value="@_coreDraft.Description" @oninput="e => CoreChanged(nameof(CoreDraft.Description), e.Value?.ToString())"></textarea></label>
            </div>
        </section>

        <section class="workspace-card"><header><div><span class="step">02</span><div><h2>Content and structure</h2><p>Choose the book’s shared reading structure.</p></div></div></header>
            <div class="option-grid">
                @Toggle("Include navigation table of contents", _coreDraft.IncludeTableOfContents, value => CoreToggle(nameof(CoreDraft.IncludeTableOfContents), value))
                @Toggle("Show a contents page", _coreDraft.IncludeVisibleTableOfContents, value => CoreToggle(nameof(CoreDraft.IncludeVisibleTableOfContents), value))
                @Toggle("Show act headings", _coreDraft.IncludeActHeadings, value => CoreToggle(nameof(CoreDraft.IncludeActHeadings), value))
                @Toggle("Show chapter headings", _coreDraft.IncludeChapterHeadings, value => CoreToggle(nameof(CoreDraft.IncludeChapterHeadings), value))
                @Toggle("Include act summaries", _coreDraft.IncludeActSynopses, value => CoreToggle(nameof(CoreDraft.IncludeActSynopses), value))
                @Toggle("Include chapter summaries", _coreDraft.IncludeChapterSynopses, value => CoreToggle(nameof(CoreDraft.IncludeChapterSynopses), value))
                @Toggle("Number acts", _coreDraft.NumberActs, value => CoreToggle(nameof(CoreDraft.NumberActs), value))
                @Toggle("Number chapters", _coreDraft.NumberChapters, value => CoreToggle(nameof(CoreDraft.NumberChapters), value))
                <label class="field"><span>Title page</span><select class="form-select" @bind="_coreDraft.TitlePageMode" @bind:after="() => _coreDirty = true"><option value="@PublishTitlePageMode.Automatic">Automatic</option><option value="@PublishTitlePageMode.Include">Always include</option><option value="@PublishTitlePageMode.Omit">Omit</option></select></label>
            </div>
            <div class="summary-strip"><span><strong>@_core!.IncludedChapterCount</strong> chapters included</span><span><strong>@_core.MatterCount</strong> front/back matter items</span><span><strong>@_core.ImagePlacementCount</strong> opening/ending images</span></div>
            <details class="content-choices"><summary>Choose included chapters</summary>
                @if (!_coreDetailsLoaded){<div class="deferred-section-loading"><span class="spinner-border spinner-border-sm"></span> Loading chapter choices…</div>}else{<div class="content-choice-list">@foreach (var item in _coreOutline){<label class="check-row"><input type="checkbox" checked="@_coreSelections.GetValueOrDefault((item.TargetKind, item.TargetId))" @onchange="e => CoreOutlineChanged(item, (bool)e.Value!)" /><span><small>@item.TargetKind</small>@item.Title</span></label>}</div>}
            </details>
        </section>

        <section class="workspace-card"><header><div><span class="step">03</span><div><h2>PDF presentation</h2><p>Defaults for the Core reading PDF and inheriting PDF ebook releases.</p></div></div></header>
            <div class="option-grid pdf-presentation-options">
                <label class="check-row"><input type="checkbox" checked="@_coreDraft.AllowDesignedPageOverrides" @onchange="e => CoreToggle(nameof(CoreDraft.AllowDesignedPageOverrides), (bool)e.Value!)" /><span><strong>Preserve Designed Page sizes</strong><small>Full-art facing spreads stay one wide PDF page, and custom Designed Pages keep their own geometry instead of being fitted into regular book pages.</small></span></label>
                <div class="plain-setting"><strong>Regular pages</strong><span>@_core!.PageSetup.PageWidthInches × @_core.PageSetup.PageHeightInches in, from Project Page Setup</span></div>
                <div class="plain-setting"><strong>When disabled</strong><span>Facing spreads are divided into two regular book pages while preserving artwork across the seam.</span></div>
                <div class="plain-setting"><strong>Reader navigation and accessibility</strong><span>Tagged text, bookmarks, internal contents links, language, and logical reading order are included automatically.</span></div>
            </div>
        </section>

        <section class="workspace-card"><header><div><span class="step">04</span><div><h2>Front and back matter</h2><p>Shared dedication, acknowledgements, notes, and other book material.</p></div></div><div class="button-row"><button class="btn btn-sm btn-outline-primary" @onclick="() => AddCoreMatterAsync(PublicationMatterKind.Dedication)">Add dedication</button><button class="btn btn-sm btn-outline-primary" @onclick="() => AddCoreMatterAsync(PublicationMatterKind.Acknowledgments)">Add acknowledgements</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => AddCoreMatterAsync(PublicationMatterKind.Custom)">Add page</button></div></header>
            @if (!_coreDetailsLoaded){<div class="deferred-section-loading"><span class="spinner-border spinner-border-sm"></span> Loading front and back matter…</div>}else if (_coreMatter.Count == 0){<p class="muted">No custom matter has been added. Title, copyright, and contents pages are generated from Core Book settings.</p>}else{<div class="compact-list">@foreach (var item in _coreMatter){<div><div><strong>@item.Title</strong><span>@item.Location · @item.Kind · @(item.IsIncluded ? "Included" : "Excluded")</span></div><div class="button-row"><button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginCoreMatterEdit(item)">Edit</button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCoreMatterAsync(item)">Remove</button></div></div>}</div>}
            @if (_editingCoreMatterId is not null)
            {
                <div class="matter-editor">
                    <div class="form-grid">
                        <label class="field"><span>Title</span><input class="form-control" @bind="_coreMatterTitle" /></label>
                        <label class="field"><span>Location</span><select class="form-select" @bind="_coreMatterLocation"><option value="@PublicationMatterLocation.Front">Front</option><option value="@PublicationMatterLocation.Back">Back</option></select></label>
                        <label class="field"><span>Page type</span><select class="form-select" @bind="_coreMatterKind">@foreach (var kind in Enum.GetValues<PublicationMatterKind>().Where(kind => !PublicationMatterFormatting.IsGeneratedPageKind(kind))){<option value="@kind">@kind</option>}</select></label>
                        <label class="field"><span>Order</span><input class="form-control" type="number" min="0" @bind="_coreMatterSortOrder" /></label>
                        <label class="check-row"><input type="checkbox" @bind="_coreMatterIncluded" /><span>Include this page</span></label>
                    </div>
                    <ChapterBodyEditor @ref="_coreMatterEditor" @key="_editingCoreMatterId.Value"
                                       ChapterId="_editingCoreMatterId.Value" ProjectId="Project!.Id" ProjectSlug="Project.Slug"
                                       InitialManuscriptJson="_coreMatterJson" SaveAsync="SaveCoreMatterDocumentAsync" />
                    <div class="button-row"><button class="btn btn-sm btn-primary" @onclick="SaveCoreMatterAsync">Save page</button><button class="btn btn-sm btn-outline-secondary" @onclick="CancelCoreMatterEdit">Close</button></div>
                </div>
            }
            @if (_corePlacements.Count > 0){<h3 class="subheading">Opening and ending images</h3><div class="compact-list">@foreach (var item in _corePlacements){<div><strong>@item.AssetFileName</strong><span>@item.PlacementKind · @item.TargetTitle</span></div>}</div>}
        </section>

    </div>;

    private RenderFragment ReleaseView() => @<div class="workspace-stack">
        <section class="readiness-card">
            <div><span class="eyebrow">@ReleaseTypeLabel(_workspace!.Edition.Format)</span><h1>@_workspace.Edition.Name</h1><p>@ReleaseSummary(_workspace.Edition)</p></div>
            <div class="primary-action"><button class="btn btn-primary" disabled="@(_busy || !_outputsLoaded || HasActivePreparation)" @onclick="PrepareReleaseAsync">@PreparationButton("Prepare files")</button><small>Renders, validates, and packages in one step.</small></div>
            @PreparationStatus()
            @ArtifactDownloads(ReleaseArtifactKinds(_workspace.Edition.Format))
        </section>

        <section class="workspace-card"><header><div><span class="step">01</span><div><h2>Release setup</h2><p>Only settings that belong to this publication product.</p></div></div><button class="btn btn-sm btn-primary" disabled="@((!_releaseDirty && !_releaseContentDirty) || _busy)" @onclick="SaveReleaseAsync">Save release</button></header>
            <div class="form-grid">
                <label class="field"><span>Release name</span><input class="form-control" @bind="_releaseDraft.Name" @bind:after="MarkReleaseDirty" /></label>
                @if (_workspace.Edition.Format == PublicationEditionFormat.Paperback)
                {
                    <label class="field"><span>Printer or service</span><select class="form-select" @bind="_releaseDraft.Vendor" @bind:after="MarkReleaseDirty"><option value="@PublicationVendor.AmazonKdp">Amazon KDP</option><option value="@PublicationVendor.IngramSpark">IngramSpark</option><option value="@PublicationVendor.Generic">Other printer</option></select></label>
                    <label class="field"><span>Paper</span><select class="form-select" @bind="_releaseDraft.Paper" @bind:after="MarkReleaseDirty"><option value="@PublicationPaper.White">White</option><option value="@PublicationPaper.Cream">Cream</option></select></label>
                    <label class="field"><span>Interior color</span><select class="form-select" @bind="_releaseDraft.Ink" @bind:after="MarkReleaseDirty"><option value="@PublicationInk.BlackAndWhite">Black and white</option><option value="@PublicationInk.Color">Color</option></select></label>
                    <label class="field"><span>ISBN <small>@(_releaseDraft.Vendor == PublicationVendor.IngramSpark ? "required" : "optional")</small></span><input class="form-control" @bind="_releaseDraft.Isbn" @bind:after="MarkReleaseDirty" /></label>
                }
                else if (_workspace.Edition.Format == PublicationEditionFormat.DigitalPdf)
                {
                    <label class="field"><span>ISBN <small>optional</small></span><input class="form-control" @bind="_releaseDraft.Isbn" @bind:after="MarkReleaseDirty" /></label>
                }
                else
                {
                    <label class="field"><span>ISBN <small>optional</small></span><input class="form-control" @bind="_releaseDraft.Isbn" @bind:after="MarkReleaseDirty" /></label>
                    <div class="plain-setting"><strong>EPUB 3</strong><span>Reflowable navigation and accessibility are managed automatically.</span></div>
                }
            </div>
        </section>

        <section class="workspace-card"><header><div><span class="step">02</span><div><h2>Book details</h2><p>Inherited from Core Book. Customize only the fields that differ for this release.</p></div></div></header>
            <div class="inherit-grid">
                @InheritedText("Title", PublicationEditionOverrideField.Title, _releaseDraft.Title, value => ReleaseText(nameof(ReleaseDraft.Title), value))
                @InheritedText("Subtitle", PublicationEditionOverrideField.Subtitle, _releaseDraft.Subtitle, value => ReleaseText(nameof(ReleaseDraft.Subtitle), value))
                @InheritedText("Author", PublicationEditionOverrideField.Author, _releaseDraft.Author, value => ReleaseText(nameof(ReleaseDraft.Author), value))
                @InheritedLanguage()
                @InheritedText("Publisher", PublicationEditionOverrideField.Publisher, _releaseDraft.Publisher, value => ReleaseText(nameof(ReleaseDraft.Publisher), value))
                @InheritedText("Copyright", PublicationEditionOverrideField.Copyright, _releaseDraft.Copyright, value => ReleaseText(nameof(ReleaseDraft.Copyright), value))
                @InheritedText("Description", PublicationEditionOverrideField.Description, _releaseDraft.Description, value => ReleaseText(nameof(ReleaseDraft.Description), value))
            </div>
        </section>

        <section class="workspace-card split"><div><span class="eyebrow">Content</span><h2>@(_workspace.HasContentOverrides ? "Release content customized" : "Uses Core Book")</h2><p>@_workspace.Sections.Sum(section => section.Chapters.Count(chapter => chapter.IsIncluded)) chapters · @_workspace.Matter.Count matter items · @_workspace.Placements.Count image placements</p><p class="muted">Customize only when this product deliberately differs from Core Book.</p><div class="button-row"><button class="btn btn-sm btn-outline-primary" @onclick="() => _releaseContentOpen = !_releaseContentOpen">@(_releaseContentOpen ? "Hide content choices" : "Customize content")</button>@if (_workspace.HasContentOverrides){<button class="btn btn-sm btn-outline-secondary" @onclick="UseCoreContentAsync">Use Core Book content</button>}</div>@if (_releaseContentOpen){<div class="release-presentation-options">@InheritedToggle("Navigation contents", PublicationEditionOverrideField.IncludeTableOfContents, _releaseDraft.IncludeTableOfContents, value => ReleaseToggle(nameof(ReleaseDraft.IncludeTableOfContents), value))@InheritedToggle("Visible contents page", PublicationEditionOverrideField.IncludeVisibleTableOfContents, _releaseDraft.IncludeVisibleTableOfContents, value => ReleaseToggle(nameof(ReleaseDraft.IncludeVisibleTableOfContents), value))@InheritedToggle("Act headings", PublicationEditionOverrideField.IncludeActHeadings, _releaseDraft.IncludeActHeadings, value => ReleaseToggle(nameof(ReleaseDraft.IncludeActHeadings), value))@InheritedToggle("Chapter headings", PublicationEditionOverrideField.IncludeChapterHeadings, _releaseDraft.IncludeChapterHeadings, value => ReleaseToggle(nameof(ReleaseDraft.IncludeChapterHeadings), value))@InheritedToggle("Number acts", PublicationEditionOverrideField.NumberActs, _releaseDraft.NumberActs, value => ReleaseToggle(nameof(ReleaseDraft.NumberActs), value))@InheritedToggle("Number chapters", PublicationEditionOverrideField.NumberChapters, _releaseDraft.NumberChapters, value => ReleaseToggle(nameof(ReleaseDraft.NumberChapters), value))</div><div class="content-choice-list release-content">@foreach (var chapter in _workspace.Sections.SelectMany(section => section.Chapters)){<label class="check-row"><input type="checkbox" checked="@_releaseSelections.GetValueOrDefault(chapter.Id)" @onchange="e => ReleaseContentChanged(chapter.Id, (bool)e.Value!)" /><span>@chapter.Title</span></label>}</div>}</div><div><span class="eyebrow">@(_workspace.Edition.Format == PublicationEditionFormat.Paperback ? "Full-wrap cover" : "Digital cover")</span><h2>@(_workspace.Edition.InheritsCoreCover ? "Front inherited from Core" : "Customized for this release")</h2><p>@CoverHelp(_workspace.Edition.Format)</p><div class="button-row">@if (_workspace.Edition.InheritsCoreCover){<button class="btn btn-sm btn-outline-primary" @onclick="CustomizeReleaseCoverAsync">Customize for this release</button>}else{<button class="btn btn-sm btn-outline-primary" @onclick="OpenReleaseCoverAsync">Edit release cover</button><button class="btn btn-sm btn-outline-secondary" @onclick="UseCoreCoverAsync">Use Core Book cover</button>}<span class="status-pill">@(_workspace.Edition.InheritsCoreCover ? "From Core Book" : "Release override")</span></div></div></section>

        @if (_workspace.Edition.Format != PublicationEditionFormat.Epub)
        {
            @if (_workspace.Edition.Format == PublicationEditionFormat.DigitalPdf)
            {
                <section class="workspace-card"><header><div><span class="step">03</span><div><h2>PDF presentation</h2><p>Uses Core Book defaults until deliberately customized for this PDF release.</p></div></div></header>
                    <div class="release-presentation-options">
                        @InheritedToggle("Preserve Designed Page sizes", PublicationEditionOverrideField.AllowDesignedPageOverrides, _releaseDraft.AllowDesignedPageOverrides, value => ReleaseToggle(nameof(ReleaseDraft.AllowDesignedPageOverrides), value))
                        <div class="plain-setting"><strong>Page behavior</strong><span>When enabled, full-art spreads remain one wide PDF page and custom Designed Pages retain their geometry. When disabled, spreads use regular book leaves.</span></div>
                        <div class="plain-setting"><strong>Accessibility</strong><span>Tagged text, bookmarks, links, and logical reading order remain automatic.</span></div>
                    </div>
                </section>
            }
            <section class="workspace-card"><header><div><span class="step">@(_workspace.Edition.Format == PublicationEditionFormat.DigitalPdf ? "04" : "03")</span><div><h2>Page and text design</h2><p>@(_releaseDesignOpen ? "Customized for this release." : "Uses Core Book page setup and Book Text Styles.")</p></div></div><button class="btn btn-sm btn-outline-primary" @onclick="ToggleReleaseDesign">@(_releaseDesignOpen ? "Use Core Book design" : "Customize for this release")</button></header>
                @if (_releaseDesignOpen)
                {
                    <div class="form-grid">
                        <label class="field"><span>Page width (in)</span><input class="form-control" type="number" min="3" max="18" step="0.01" @bind="_releaseDraft.PageWidthInches" @bind:after="MarkReleaseDirty" /></label>
                        <label class="field"><span>Page height (in)</span><input class="form-control" type="number" min="3" max="24" step="0.01" @bind="_releaseDraft.PageHeightInches" @bind:after="MarkReleaseDirty" /></label>
                        <label class="field"><span>Margin (in)</span><input class="form-control" type="number" min="0.25" max="3" step="0.01" @bind="_releaseDraft.PageMarginInches" @bind:after="MarkReleaseDirty" /></label>
                        <label class="field"><span>Body text (pt)</span><input class="form-control" type="number" min="7" max="24" step="0.25" @bind="_releaseDraft.BodyFontSizePoints" @bind:after="MarkReleaseDirty" /></label>
                        <label class="field"><span>Line spacing</span><input class="form-control" type="number" min="1" max="3" step="0.05" @bind="_releaseDraft.BodyLineHeight" @bind:after="MarkReleaseDirty" /></label>
                    </div>
                }
            </section>
        }

        <details class="technical"><summary>Advanced and technical details</summary><dl><div><dt>Profile</dt><dd>Managed automatically for @_workspace.Edition.Vendor</dd></div><div><dt>Source state</dt><dd>Calculated when files are prepared</dd></div><div><dt>Release revision</dt><dd>@_workspace.Edition.Revision</dd></div></dl><div class="button-row"><button class="btn btn-sm btn-outline-secondary" @onclick="CloneReleaseAsync">Clone release</button><button class="btn btn-sm btn-outline-danger" @onclick="ArchiveReleaseAsync">Archive release</button></div></details>
    </div>;

    private RenderFragment Toggle(string Label, bool Value, Action<bool> Changed) => @<label class="check-row"><input type="checkbox" checked="@Value" @onchange="e => Changed((bool)e.Value!)" /><span>@Label</span></label>;

    private RenderFragment InheritedText(string Label, PublicationEditionOverrideField Field, string Value, Action<string?> Changed) => @<div class="inherited-field">
        <div class="inherited-heading"><label>@Label</label><label class="customize"><input type="checkbox" checked="@_releaseOverrides.Contains(Field)" @onchange="e => ToggleOverride(Field, (bool)e.Value!)" /><span>@(_releaseOverrides.Contains(Field) ? "Customized" : "From Core Book")</span></label></div>
        <input class="form-control" disabled="@(!_releaseOverrides.Contains(Field))" value="@Value" @oninput="e => Changed(e.Value?.ToString())" />
    </div>;

    private RenderFragment InheritedLanguage() => @<div class="inherited-field">
        <div class="inherited-heading"><label>Language</label><label class="customize"><input type="checkbox" checked="@_releaseOverrides.Contains(PublicationEditionOverrideField.Language)" @onchange="e => ToggleOverride(PublicationEditionOverrideField.Language, (bool)e.Value!)" /><span>@(_releaseOverrides.Contains(PublicationEditionOverrideField.Language) ? "Customized" : "From Core Book")</span></label></div>
        @LanguageSelect(_releaseDraft.Language, !_releaseOverrides.Contains(PublicationEditionOverrideField.Language), value => ReleaseText(nameof(ReleaseDraft.Language), value))
    </div>;

    private RenderFragment LanguageSelect(string Value, bool Disabled, Action<string?> Changed) => @<select class="form-select" disabled="@Disabled" value="@PublicationLanguage.Normalize(Value)" @onchange="e => Changed(e.Value?.ToString())">
        @if (!PublicationLanguage.IsPressSupported(Value))
        {
            <option value="@PublicationLanguage.Normalize(Value)" disabled>Unsupported saved value (@Value)</option>
        }
        @foreach (var option in PublicationLanguage.SupportedOptions)
        {
            <option value="@option.Tag">@option.Label</option>
        }
    </select>;

    private RenderFragment InheritedToggle(string Label, PublicationEditionOverrideField Field, bool Value, Action<bool> Changed) => @<div class="inherited-toggle"><label class="check-row"><input type="checkbox" disabled="@(!_releaseOverrides.Contains(Field))" checked="@Value" @onchange="e => Changed((bool)e.Value!)" /><span>@Label</span></label><label class="customize"><input type="checkbox" checked="@_releaseOverrides.Contains(Field)" @onchange="e => ToggleOverride(Field, (bool)e.Value!)" /><span>@(_releaseOverrides.Contains(Field) ? "Customized" : "From Core Book")</span></label></div>;

    private RenderFragment PreparationStatus() => @<text>@if (!_outputsLoaded)
    {
        <div class="preparation loading"><span class="spinner-border spinner-border-sm"></span><span>Checking prepared files…</span></div>
    }
    else if (_preparations.FirstOrDefault() is { } job)
    {
        <div class="preparation @job.Status.ToString().ToLowerInvariant()"><strong>@job.Message</strong>@if (job.Status is PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing){<span>@job.ProgressPercent% · @job.Step</span><button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelPreparationAsync(job.Id)">Cancel</button>}@foreach (var diagnostic in job.Diagnostics.Take(3)){<span>@diagnostic.Message</span>}</div>
    }</text>;

    private RenderFragment ArtifactDownloads(IReadOnlyList<PublicationArtifactKind> Kinds) => @<text>@if (_artifacts.Any(item => Kinds.Contains(item.Kind) && !item.IsLegacy && !item.IsStale))
    {
        <div class="downloads">@foreach (var artifact in _artifacts.Where(item => Kinds.Contains(item.Kind) && !item.IsLegacy && !item.IsStale).GroupBy(item => item.Kind).Select(group => group.First())){<a class="btn btn-sm btn-outline-primary" href="@DownloadUrl(artifact.Id)" download="@artifact.FileName">@DownloadLabel(artifact.Kind)</a>}</div>
    }</text>;

    private RenderFragment CoreDownloads() => @<div class="downloads core-downloads">
        @if (CurrentArtifact(PublicationArtifactKind.ReadingPdf) is { } readingPdf)
        {
            <a class="btn btn-sm btn-outline-primary" href="@DownloadUrl(readingPdf.Id)" download="@readingPdf.FileName">Save reading PDF</a>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => _previewArtifact = readingPdf">Preview PDF</button>
        }
        <button class="btn btn-sm btn-outline-primary" @onclick="() => ExportCoreAsync(PublishExportFormat.Markdown)">Download Markdown</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="() => ExportCoreAsync(PublishExportFormat.PlainText)">Download plain text</button>
    </div>;

    private void BeginCoreMatterEdit(PublicationMatterView item)
    {
        _editingCoreMatterId = item.Id;
        _coreMatterTitle = item.Title;
        _coreMatterJson = ManuscriptCodec.Serialize(item.Manuscript);
        _editingCoreMatterRevision = item.Revision;
        _coreMatterLocation = item.Location;
        _coreMatterKind = item.Kind;
        _coreMatterSortOrder = item.SortOrder;
        _coreMatterIncluded = item.IsIncluded;
    }

    private void CancelCoreMatterEdit() => _editingCoreMatterId = null;

    private async Task AddCoreMatterAsync(PublicationMatterKind kind)
    {
        if (Project is null || _core is null) return;
        await SavePendingAsync();
        try
        {
            var location = kind is PublicationMatterKind.Acknowledgments or PublicationMatterKind.AboutAuthor
                or PublicationMatterKind.AlsoBy or PublicationMatterKind.References
                ? PublicationMatterLocation.Back : PublicationMatterLocation.Front;
            var title = kind == PublicationMatterKind.Custom ? "Custom page" : kind.ToString();
            var saved = await Books.UpsertMatterAsync(Project.Id, new PublicationMatterInput(
                null, location, kind, title, ManuscriptCodec.Serialize(ManuscriptCodec.CreateEmpty(Guid.Empty)),
                true, _coreMatter.Count), _core.Revision);
            await RefreshCoreDataAsync();
            BeginCoreMatterEdit(saved);
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task SaveCoreMatterAsync()
    {
        if (Project is null || _core is null || _editingCoreMatterId is not Guid matterId) return;
        try
        {
            if (_coreMatterEditor is not null && !await _coreMatterEditor.FlushAsync())
                throw new InvalidOperationException("The matter page could not be saved yet.");
            var document = ManuscriptCodec.Deserialize(_coreMatterJson, matterId, _editingCoreMatterRevision);
            var saved = await Books.UpsertMatterAsync(Project.Id, new PublicationMatterInput(
                matterId, _coreMatterLocation, _coreMatterKind, _coreMatterTitle,
                ManuscriptCodec.Serialize(document), _coreMatterIncluded, _coreMatterSortOrder,
                _editingCoreMatterRevision), _core.Revision);
            await RefreshCoreDataAsync();
            BeginCoreMatterEdit(saved);
            _notice = "Core Book matter saved.";
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task<ChapterBodyEditor.SemanticEditorSaveResult> SaveCoreMatterDocumentAsync(
        Guid matterId,
        long expectedRevision,
        string manuscriptJson)
    {
        if (Project is null || _core is null)
            return new(false, expectedRevision);
        try
        {
            var saved = await Books.UpsertMatterAsync(Project.Id, new PublicationMatterInput(
                matterId, _coreMatterLocation, _coreMatterKind, _coreMatterTitle, manuscriptJson,
                _coreMatterIncluded, _coreMatterSortOrder, expectedRevision), _core.Revision);
            _coreMatterJson = ManuscriptCodec.Serialize(saved.Manuscript);
            _editingCoreMatterRevision = saved.Revision;
            _core = await Books.GetOrCreateAsync(Project.Id);
            _coreMatter = await Books.ListMatterAsync(Project.Id);
            return new(true, saved.Revision);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            await RefreshCoreDataAsync();
            var current = _coreMatter.FirstOrDefault(item => item.Id == matterId);
            return new(false, expectedRevision, true, current is null ? null : ManuscriptCodec.Serialize(current.Manuscript));
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            await InvokeAsync(StateHasChanged);
            return new(false, expectedRevision);
        }
    }

    private async Task DeleteCoreMatterAsync(PublicationMatterView item)
    {
        if (Project is null || _core is null) return;
        try
        {
            await Books.DeleteMatterAsync(Project.Id, item.Id, _core.Revision);
            if (_editingCoreMatterId == item.Id) _editingCoreMatterId = null;
            await RefreshCoreDataAsync();
            _notice = $"{item.Title} removed from Core Book.";
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task RefreshCoreDataAsync()
    {
        if (Project is null) return;
        _core = await Books.GetOrCreateAsync(Project.Id);
        var details = await Books.GetDetailsAsync(Project.Id);
        _coreMatter = details.Matter;
        _corePlacements = details.ImagePlacements;
        _coreOutline = details.Outline;
        _coreSelections = _coreOutline.ToDictionary(item => (item.TargetKind, item.TargetId), item => item.IsIncluded);
        _coreDetailsLoaded = true;
        _coreDraft = CoreDraft.From(_core);
        _coreDirty = false;
        _coreOutlineDirty = false;
        _releases = await Releases.ListAsync(Project.Id);
    }

    private async Task SaveCoreAsync()
    {
        if (Project is null || _core is null || (!_coreDirty && !_coreOutlineDirty)) return;
        _busy = true; _error = null;
        try
        {
            if (_coreDirty)
                _core = await Books.UpdateAsync(Project.Id, new PublicationBookPatch(_core.Revision, _coreDraft.Title, _coreDraft.Subtitle, _coreDraft.Author, _coreDraft.Language, _coreDraft.Publisher, _coreDraft.Copyright, _coreDraft.Description, _coreDraft.IncludeTableOfContents, _coreDraft.IncludeVisibleTableOfContents, _coreDraft.IncludeActSynopses, _coreDraft.IncludeChapterSynopses, _coreDraft.IncludeActHeadings, _coreDraft.IncludeChapterHeadings, _coreDraft.NumberActs, _coreDraft.NumberChapters, _coreDraft.TitlePageMode, _coreDraft.AllowDesignedPageOverrides));
            if (_coreOutlineDirty)
                _core = await Books.SetOutlineSelectionsAsync(Project.Id, _coreSelections.Select(item => new PublicationEditionOutlineItemUpdate(item.Key.Kind, item.Key.Id, item.Value)).ToList(), _core.Revision);
            _coreDraft = CoreDraft.From(_core); _coreDirty = false; _coreOutlineDirty = false; _notice = "Core Book saved. Inheriting releases now use these values.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task SavePageSetupAsync()
    {
        if (Project is null || _core is null || !_pageSetupDirty)
            return;
        _busy = true;
        _error = null;
        try
        {
            await PageSetups.UpdateAsync(
                Project.Id,
                _core.PageSetup.Revision,
                new ProjectPageSetupInput(
                    _pageWidthInches,
                    _pageHeightInches,
                    _pageMarginInches,
                    _bodyFontSizePoints,
                    _bodyLineHeight));
            _core = await Books.GetOrCreateAsync(Project.Id);
            CopyPageSetupDraft();
            _pageSetupDirty = false;
            _releases = await Releases.ListAsync(Project.Id);
            _artifacts = (await Renders.ListCoreAsync(Project.Id))
                .SelectMany(item => item.Artifacts)
                .OrderByDescending(item => item.CreatedAt)
                .ToList();
            _notice = "Core Book page and text defaults saved. Inheriting releases now use these values.";
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CopyPageSetupDraft()
    {
        if (_core is null)
            return;
        _pageWidthInches = _core.PageSetup.PageWidthInches;
        _pageHeightInches = _core.PageSetup.PageHeightInches;
        _pageMarginInches = _core.PageSetup.PageMarginInches;
        _bodyFontSizePoints = _core.PageSetup.BodyFontSizePoints;
        _bodyLineHeight = _core.PageSetup.BodyLineHeight;
    }

    private void MarkPageSetupDirty() => _pageSetupDirty = true;

    private string PageSetupPreset() => (_pageWidthInches, _pageHeightInches) switch
    {
        (6, 9) => "6x9",
        (5.5, 8.5) => "5.5x8.5",
        (8.5, 11) => "8.5x11",
        _ => "custom",
    };

    private void PageSetupPresetChanged(ChangeEventArgs e)
    {
        switch (e.Value?.ToString())
        {
            case "6x9":
                _pageWidthInches = 6;
                _pageHeightInches = 9;
                break;
            case "5.5x8.5":
                _pageWidthInches = 5.5;
                _pageHeightInches = 8.5;
                break;
            case "8.5x11":
                _pageWidthInches = 8.5;
                _pageHeightInches = 11;
                break;
            default:
                return;
        }
        _pageSetupDirty = true;
    }

    private void OpenBookTextStylesModal() => _bookTextStylesModalOpen = true;
    private void CloseBookTextStylesModal() => _bookTextStylesModalOpen = false;

    private async Task<bool> FlushBeforeBookStyleChangeAsync()
    {
        await SavePendingAsync();
        return !_coreDirty && !_coreOutlineDirty && !_pageSetupDirty
            && !_releaseDirty && !_releaseContentDirty;
    }

    private async Task HandleBookTextStylesChangedAsync()
    {
        if (Project is null)
            return;
        _bookTextStylesRefreshSignal++;
        _releases = await Releases.ListAsync(Project.Id);
        _artifacts = (await Renders.ListCoreAsync(Project.Id))
            .SelectMany(item => item.Artifacts)
            .OrderByDescending(item => item.CreatedAt)
            .ToList();
        _notice = "Book Text Styles saved. Existing reading and release files may need to be prepared again.";
    }

    private async Task SaveReleaseAsync()
    {
        if (Project is null || _workspace is null || _selectedReleaseId is not Guid id || (!_releaseDirty && !_releaseContentDirty)) return;
        _busy = true; _error = null;
        try
        {
            var revision = _workspace.Edition.Revision;
            if (_releaseDirty)
            {
                var reset = _loadedOverrides.Except(_releaseOverrides).ToList();
                var patch = new PublicationReleaseOverridePatch(
                    revision, _releaseDraft.Name, _releaseDraft.Vendor, _releaseDraft.Isbn,
                    _releaseDraft.Paper, _releaseDraft.Ink, BoolValue(PublicationEditionOverrideField.AllowDesignedPageOverrides, _releaseDraft.AllowDesignedPageOverrides),
                    Value(PublicationEditionOverrideField.Title, _releaseDraft.Title), Value(PublicationEditionOverrideField.Subtitle, _releaseDraft.Subtitle),
                    Value(PublicationEditionOverrideField.Author, _releaseDraft.Author), Value(PublicationEditionOverrideField.Language, _releaseDraft.Language),
                    Value(PublicationEditionOverrideField.Publisher, _releaseDraft.Publisher), Value(PublicationEditionOverrideField.Copyright, _releaseDraft.Copyright),
                    Value(PublicationEditionOverrideField.Description, _releaseDraft.Description),
                    IncludeTableOfContents: BoolValue(PublicationEditionOverrideField.IncludeTableOfContents, _releaseDraft.IncludeTableOfContents),
                    IncludeVisibleTableOfContents: BoolValue(PublicationEditionOverrideField.IncludeVisibleTableOfContents, _releaseDraft.IncludeVisibleTableOfContents),
                    IncludeActSynopses: BoolValue(PublicationEditionOverrideField.IncludeActSynopses, _releaseDraft.IncludeActSynopses),
                    IncludeChapterSynopses: BoolValue(PublicationEditionOverrideField.IncludeChapterSynopses, _releaseDraft.IncludeChapterSynopses),
                    IncludeActHeadings: BoolValue(PublicationEditionOverrideField.IncludeActHeadings, _releaseDraft.IncludeActHeadings),
                    IncludeChapterHeadings: BoolValue(PublicationEditionOverrideField.IncludeChapterHeadings, _releaseDraft.IncludeChapterHeadings),
                    NumberActs: BoolValue(PublicationEditionOverrideField.NumberActs, _releaseDraft.NumberActs),
                    NumberChapters: BoolValue(PublicationEditionOverrideField.NumberChapters, _releaseDraft.NumberChapters),
                    PageWidthInches: DesignValue(PublicationEditionOverrideField.PageWidthInches, _releaseDraft.PageWidthInches),
                    PageHeightInches: DesignValue(PublicationEditionOverrideField.PageHeightInches, _releaseDraft.PageHeightInches),
                    PageMarginInches: DesignValue(PublicationEditionOverrideField.PageMarginInches, _releaseDraft.PageMarginInches),
                    BodyFontSizePoints: DesignValue(PublicationEditionOverrideField.BodyFontSizePoints, _releaseDraft.BodyFontSizePoints),
                    BodyLineHeight: DesignValue(PublicationEditionOverrideField.BodyLineHeight, _releaseDraft.BodyLineHeight),
                    ResetFields: reset);
                revision = (await Releases.PatchOverridesAsync(Project.Id, id, patch)).Revision;
            }
            if (_releaseContentDirty)
            {
                var changes = _releaseSelections.Where(item => !_loadedReleaseSelections.TryGetValue(item.Key, out var loaded) || loaded != item.Value)
                    .Select(item => new PublicationEditionOutlineItemUpdate(PublishOutlineTargetKind.Chapter, item.Key, item.Value)).ToList();
                if (changes.Count > 0)
                    await Releases.SetOutlineSelectionsAsync(Project.Id, id, changes, revision);
            }
            _releaseDirty = false;
            _releaseContentDirty = false;
            await SelectReleaseAsync(id); _notice = "Release saved.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private string? Value(PublicationEditionOverrideField field, string value) => _releaseOverrides.Contains(field) ? value : null;
    private bool? BoolValue(PublicationEditionOverrideField field, bool value) => _releaseOverrides.Contains(field) ? value : null;
    private double? DesignValue(PublicationEditionOverrideField field, double value) => _releaseOverrides.Contains(field) ? value : null;

    private void ToggleReleaseDesign()
    {
        _releaseDesignOpen = !_releaseDesignOpen;
        foreach (var field in Enum.GetValues<PublicationEditionOverrideField>().Where(IsDesignOverride))
        {
            if (_releaseDesignOpen) _releaseOverrides.Add(field);
            else _releaseOverrides.Remove(field);
        }
        _releaseDirty = true;
    }

    private async Task UseCoreContentAsync()
    {
        if (Project is null) return;
        var core = await Books.ListOutlineAsync(Project.Id);
        var chapters = core.Where(item => item.TargetKind == PublishOutlineTargetKind.Chapter)
            .ToDictionary(item => item.TargetId, item => item.IsIncluded);
        foreach (var id in _releaseSelections.Keys.ToList())
            if (chapters.TryGetValue(id, out var included)) _releaseSelections[id] = included;
        _releaseContentDirty = true;
        _releaseContentOpen = true;
    }

    private static bool IsDesignOverride(PublicationEditionOverrideField field) => field is
        PublicationEditionOverrideField.PageWidthInches or PublicationEditionOverrideField.PageHeightInches
        or PublicationEditionOverrideField.PageMarginInches or PublicationEditionOverrideField.BodyFontSizePoints
        or PublicationEditionOverrideField.BodyLineHeight;

    private async Task SavePendingAsync()
    {
        if (_coverEditorOpen && _coverWorkspace is not null)
            await _coverWorkspace.FlushAsync();
        if (_coreDirty || _coreOutlineDirty)
            await SaveCoreAsync();
        if (_coreDirty || _coreOutlineDirty)
            return;
        if (_pageSetupDirty)
            await SavePageSetupAsync();
        if (_pageSetupDirty)
            return;
        if (_releaseDirty || _releaseContentDirty)
            await SaveReleaseAsync();
    }

    private async Task PrepareCoreAsync()
    {
        if (Project is null) return; await SavePendingAsync(); _busy = true; _error = null;
        try { var job = await Preparation.PrepareCoreAsync(Project.Id); await PollAsync(job.Id, PublicationTargetKind.CoreBook, null, ++_pollGeneration); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task PrepareReleaseAsync()
    {
        if (Project is null || _selectedReleaseId is not Guid id) return; await SavePendingAsync(); _busy = true; _error = null;
        try { var job = await Preparation.PrepareReleaseAsync(Project.Id, id); await PollAsync(job.Id, PublicationTargetKind.Release, id, ++_pollGeneration); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task CancelPreparationAsync(Guid jobId)
    {
        if (Project is null) return;
        try
        {
            await Preparation.CancelAsync(Project.Id, jobId);
            _preparations = await Preparation.ListAsync(Project.Id,
                _selectedReleaseId is null ? PublicationTargetKind.CoreBook : PublicationTargetKind.Release,
                _selectedReleaseId);
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private void ResumeActivePreparation(PublicationTargetKind kind, Guid? releaseId)
    {
        var generation = ++_pollGeneration;
        if (_preparations.FirstOrDefault(item => item.Status is PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing) is { } job)
            _ = ResumeActivePreparationAsync(job.Id, kind, releaseId, generation);
    }

    private async Task ResumeActivePreparationAsync(Guid jobId, PublicationTargetKind kind, Guid? releaseId, int generation)
    {
        try { await PollAsync(jobId, kind, releaseId, generation); }
        catch (OperationCanceledException) when (_dispose.IsCancellationRequested || generation != _pollGeneration) { }
        catch (Exception exception)
        {
            if (generation == _pollGeneration)
            {
                _error = exception.Message;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task PollAsync(Guid jobId, PublicationTargetKind kind, Guid? editionId, int generation)
    {
        if (Project is null) return;
        while (!_dispose.IsCancellationRequested && generation == _pollGeneration)
        {
            _preparations = await Preparation.ListAsync(Project.Id, kind, editionId, _dispose.Token);
            var job = _preparations.First(item => item.Id == jobId);
            await InvokeAsync(StateHasChanged);
            if (job.Status is not (PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing)) break;
            await Task.Delay(350, _dispose.Token);
        }
        if (generation != _pollGeneration) return;
        _artifacts = kind == PublicationTargetKind.CoreBook
            ? (await Renders.ListCoreAsync(Project.Id, _dispose.Token)).SelectMany(item => item.Artifacts).OrderByDescending(item => item.CreatedAt).ToList()
            : await Renders.ListArtifactsAsync(Project.Id, editionId!.Value, _dispose.Token);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateReleaseAsync()
    {
        if (Project is null) return; _busy = true; _error = null;
        try
        {
            var vendor = _newFormat == PublicationEditionFormat.Paperback ? _newVendor : PublicationVendor.Generic;
            var created = await Releases.CreateAsync(Project.Id, new PublicationEditionCreate(string.IsNullOrWhiteSpace(_newReleaseName) ? ReleaseTypeLabel(_newFormat) : _newReleaseName.Trim(), _newFormat, vendor));
            _addReleaseOpen = false; await SelectReleaseAsync(created.Id); _notice = "Release created with safe defaults from Core Book.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task CloneReleaseAsync()
    {
        if (Project is null || _workspace is null) return;
        var clone = await Releases.CloneAsync(Project.Id, _workspace.Edition.Id, $"{_workspace.Edition.Name} copy", _workspace.Edition.Revision);
        await SelectReleaseAsync(clone.Id);
    }

    private async Task ArchiveReleaseAsync()
    {
        if (Project is null || _workspace is null) return;
        await Releases.ArchiveAsync(Project.Id, _workspace.Edition.Id, _workspace.Edition.Revision);
        await LoadCoreAsync(); _notice = "Release archived.";
    }

    private async Task OpenCoreCoverAsync()
    {
        await SavePendingAsync();
        if (_coreDirty || _coreOutlineDirty || _pageSetupDirty)
            return;
        _selectedReleaseId = null;
        _coverEditorOpen = true;
    }

    private async Task CustomizeReleaseCoverAsync()
    {
        if (Project is null || _workspace is null) return;
        _busy = true; _error = null;
        try
        {
            await Covers.CustomizeFromCoreAsync(Project.Id, _workspace.Edition.Id, _workspace.Edition.Revision);
            await SelectReleaseAsync(_workspace.Edition.Id);
            _coverEditorOpen = true;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task OpenReleaseCoverAsync()
    {
        await SavePendingAsync();
        if (_selectedReleaseId is not null)
            _coverEditorOpen = true;
    }

    private async Task UseCoreCoverAsync()
    {
        if (Project is null || _workspace is null) return;
        _busy = true; _error = null;
        try
        {
            await Covers.UseCoreAsync(Project.Id, _workspace.Edition.Id, _workspace.Edition.Revision);
            await SelectReleaseAsync(_workspace.Edition.Id);
            _notice = "This release now inherits the Core cover live.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task HandleCoverSavedAsync()
    {
        if (Project is null)
            return;
        if (_selectedReleaseId is null)
        {
            _core = await Books.GetOrCreateAsync(Project.Id);
            _coreDraft = CoreDraft.From(_core);
        }
        else
        {
            _releases = await Releases.ListAsync(Project.Id);
        }
    }

    private async Task CloseCoverEditorAsync()
    {
        var releaseId = _selectedReleaseId;
        _coverEditorOpen = false;
        if (releaseId is Guid id)
            await SelectReleaseAsync(id);
        else
            await LoadCoreAsync();
    }

    private async Task ExportCoreAsync(PublishExportFormat format)
    {
        if (Project is null) return;
        try
        {
            _downloads ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownloads.js");
            var file = await Publishing.ExportCoreAsync(Project.Id, format);
            await _downloads.InvokeVoidAsync("downloadBytes", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private Task HandleAssistantMutationAsync(PublishWorkspaceMutated mutation)
    {
        if (_coreDirty || _coreOutlineDirty || _pageSetupDirty || _releaseDirty || _releaseContentDirty)
        {
            _notice = "The assistant changed publishing settings. Your unsaved form edits were kept; save or reload to reconcile them.";
            return Task.CompletedTask;
        }
        var coverWasOpen = _coverEditorOpen;
        var targetReleaseId = mutation.SelectEdition && mutation.EditionId is Guid id
            ? id
            : _selectedReleaseId;
        QueueAssistantTargetRefresh(targetReleaseId);
        if (mutation.Kind == PublishWorkspaceMutationKind.Edition && coverWasOpen)
        {
            _coverEditorOpen = true;
            _coverSelectionId = mutation.SelectedObjectId;
            _coverRefreshSignal++;
        }
        return Task.CompletedTask;
    }

    private void QueueAssistantTargetRefresh(Guid? releaseId)
    {
        _previewArtifact = null;
        if (_selectedReleaseId != releaseId)
        {
            _selectedReleaseId = releaseId;
            _workspace = null;
            _coverEditorOpen = false;
        }
        _preparations = [];
        _artifacts = [];
        _outputsLoaded = false;
        _targetLoading = true;
        _targetLoadPending = true;
        _refreshCoreSummaryOnTargetLoad = releaseId is null;
        _targetLoadGeneration++;
        _error = null;
        StateHasChanged();
    }

    private void CoreChanged(string field, string? value) { typeof(CoreDraft).GetProperty(field)!.SetValue(_coreDraft, value ?? string.Empty); _coreDirty = true; }
    private void CoreToggle(string field, bool value) { typeof(CoreDraft).GetProperty(field)!.SetValue(_coreDraft, value); _coreDirty = true; }
    private void CoreOutlineChanged(PublicationBookOutlineView item, bool value) { _coreSelections[(item.TargetKind, item.TargetId)] = value; _coreOutlineDirty = true; }
    private void ReleaseText(string field, string? value) { typeof(ReleaseDraft).GetProperty(field)!.SetValue(_releaseDraft, value ?? string.Empty); _releaseDirty = true; }
    private void ReleaseToggle(string field, bool value) { typeof(ReleaseDraft).GetProperty(field)!.SetValue(_releaseDraft, value); _releaseDirty = true; }
    private void MarkReleaseDirty() => _releaseDirty = true;
    private void ReleaseContentChanged(Guid chapterId, bool value) { _releaseSelections[chapterId] = value; _releaseContentDirty = true; }
    private void ToggleOverride(PublicationEditionOverrideField field, bool enabled) { if (enabled) _releaseOverrides.Add(field); else _releaseOverrides.Remove(field); _releaseDirty = true; }
    private void ChooseFormat(PublicationEditionFormat format) { _newFormat = format; _newReleaseName = ReleaseTypeLabel(format); if (format != PublicationEditionFormat.Paperback) _newVendor = PublicationVendor.Generic; }
    private string PreparationButton(string idle) => _preparations.FirstOrDefault()?.Status is PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing ? "Preparing…" : idle;
    private bool HasActivePreparation => _preparations.FirstOrDefault()?.Status is PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing;
    private PublicationArtifactView? CurrentArtifact(PublicationArtifactKind kind) => _artifacts.FirstOrDefault(item => item.Kind == kind && !item.IsLegacy && !item.IsStale);
    private void ClosePdfPreview() => _previewArtifact = null;
    private string ViewUrl(Guid artifactId) => $"/projects/{Project!.Id:N}/publish/artifacts/{artifactId:N}";
    private string DownloadUrl(Guid artifactId) => $"/projects/{Project!.Id:N}/publish/artifacts/{artifactId:N}/download";
    private static string DownloadLabel(PublicationArtifactKind kind) => kind switch { PublicationArtifactKind.ReadingPdf => "Save reading PDF", PublicationArtifactKind.InteriorPdf => "Save interior PDF", PublicationArtifactKind.CoverPdf => "Save cover PDF", PublicationArtifactKind.BookPdf => "Save book PDF", PublicationArtifactKind.Epub => "Save EPUB", PublicationArtifactKind.PublicationPackage => "Save package", _ => $"Save {kind}" };
    private static IReadOnlyList<PublicationArtifactKind> ReleaseArtifactKinds(PublicationEditionFormat format) => format switch { PublicationEditionFormat.Paperback => [PublicationArtifactKind.InteriorPdf, PublicationArtifactKind.CoverPdf, PublicationArtifactKind.PublicationPackage], PublicationEditionFormat.Epub => [PublicationArtifactKind.Epub, PublicationArtifactKind.PublicationPackage], _ => [PublicationArtifactKind.BookPdf, PublicationArtifactKind.PublicationPackage] };
    private static string ReleaseTypeLabel(PublicationEditionFormat format) => format switch { PublicationEditionFormat.Paperback => "Paperback", PublicationEditionFormat.Epub => "EPUB ebook", _ => "PDF ebook" };
    private static string ReleaseSummary(PublicationEditionView edition) => edition.Format switch { PublicationEditionFormat.Paperback => $"{edition.Vendor switch { PublicationVendor.AmazonKdp => "Amazon KDP", PublicationVendor.IngramSpark => "IngramSpark", _ => "Other printer" }} paperback with printer-ready interior and full-wrap cover.", PublicationEditionFormat.Epub => "Accessible EPUB 3 ebook with reflowable text and navigation.", _ => "Tagged single-file PDF ebook with the front cover as page one." };
    private static string CoverHelp(PublicationEditionFormat format) => format == PublicationEditionFormat.Paperback ? "Core artwork supplies the front; this release adds back, spine, bleed, and barcode areas." : "Uses the reusable Core front cover until you customize this release.";

    public async ValueTask DisposeAsync() { _dispose.Cancel(); _dispose.Dispose(); if (_downloads is not null) await _downloads.DisposeAsync(); }

