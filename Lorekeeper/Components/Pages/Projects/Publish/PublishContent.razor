        _preparations = await Preparation.ListAsync(Project.Id, targetKind, editionId, _dispose.Token);
        _preparationDiagnostics = _preparations.FirstOrDefault() is { } latest
            ? await DiagnosticPresentation.ResolveAsync(
                Project.Id,
                editionId,
                latest.Diagnostics,
                _dispose.Token)
