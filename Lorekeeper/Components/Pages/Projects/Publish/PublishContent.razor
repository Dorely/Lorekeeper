    private async Task UseCoreContentAsync()
    {
        if (Project is null) return;
        var core = await Books.ListOutlineAsync(Project.Id);
        var chapters = core.Where(item => item.TargetKind == PublishOutlineTargetKind.Chapter)
            .ToDictionary(item => item.TargetId, item => item.IsIncluded);
        foreach (var id in _releaseSelections.Keys.ToList())
            if (chapters.TryGetValue(id, out var included)) _releaseSelections[id] = included;
        _releaseContentDirty = true;
        QueueFormAutosave();
    }

    private static bool IsDesignOverride(PublicationEditionOverrideField field) => field is
        PublicationEditionOverrideField.PageWidthInches or PublicationEditionOverrideField.PageHeightInches
        or PublicationEditionOverrideField.PageMarginInches;

    private async Task SavePendingAsync()
    {
        await _formSaveGate.WaitAsync(_dispose.Token);
        try
        {
            if (_publicationSectionEditor is not null && !await _publicationSectionEditor.FlushAsync())
                return;
            if (_sectionPageWorkspace is not null && !await _sectionPageWorkspace.FlushAsync())
                return;
            if (_coverEditorOpen && _coverWorkspace is not null)
                await _coverWorkspace.FlushAsync();
            if (_coreDirty || _coreOutlineDirty)
                await SaveCoreAsync();
            if (_coreDirty || _coreOutlineDirty)
                return;
            if (_pageSetupDirty)
                await SavePageSetupAsync();
            if (_pageSetupDirty)
                return;
            if (_releaseDirty || _releaseContentDirty)
                await SaveReleaseAsync();
        }
        finally
        {
            _formSaveGate.Release();
        }
    }

    private async Task<PublishAssistantWorkspaceContext?> PrepareAssistantTurnAsync()
    {
        if (_publicationSectionEditor is not null && !await _publicationSectionEditor.FlushAsync())
            throw new InvalidOperationException("The open publication-section draft could not be saved. Resolve its save error before starting the assistant.");
        if (_sectionPageWorkspace is not null && !await _sectionPageWorkspace.FlushAsync())
            throw new InvalidOperationException("The open publication page could not be saved. Resolve its save error before starting the assistant.");
        if (_coverEditorOpen && _coverWorkspace is not null && !await _coverWorkspace.FlushAsync())
            throw new InvalidOperationException("The open cover could not be saved. Resolve its save error before starting the assistant.");
        await SavePendingAsync();
        return AssistantWorkspaceContext();
    }

    private async Task PrepareCoreAsync()
    {
        if (Project is null) return; await SavePendingAsync(); _busy = true; _error = null;
        try { var job = await Preparation.PrepareCoreAsync(Project.Id); await PollAsync(job.Id, PublicationTargetKind.CoreBook, null, ++_pollGeneration); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task PrepareReleaseAsync()
    {
        if (Project is null || _selectedReleaseId is not Guid id) return; await SavePendingAsync(); _busy = true; _error = null;
        try { var job = await Preparation.PrepareReleaseAsync(Project.Id, id); await PollAsync(job.Id, PublicationTargetKind.Release, id, ++_pollGeneration); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

