    private async Task OnAssetSelectedAsync(InputFileChangeEventArgs e)
    {
        if (Project is null) return;
        _assetError = null;
        _assetStatus = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: MaxAssetBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await Publishing.UploadAssetAsync(Project.Id, new PublishAssetUpload(file.Name, file.ContentType, memory.ToArray(), _uploadAltText));
            _uploadAltText = string.Empty;
            _assetStatus = "Asset uploaded.";
            await ReloadAsync(resetProfile: false);
        }
        catch (Exception ex)
        {
            _assetError = ex.Message;
        }
    }

