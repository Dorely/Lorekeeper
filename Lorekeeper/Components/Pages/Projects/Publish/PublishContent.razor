    private bool IsPublicationSectionIncluded(PublicationSectionView item)
    {
        if (item.InclusionMode == PublicationSectionInclusionMode.Omitted)
            return false;
        if (item.InclusionMode == PublicationSectionInclusionMode.Included)
            return true;
        var titlePageMode = _selectedReleaseId is null ? _coreDraft.TitlePageMode : _workspace!.Edition.TitlePageMode;
        var copyright = _selectedReleaseId is null ? _coreDraft.Copyright : _releaseDraft.Copyright;
        var includeContents = _selectedReleaseId is null
            ? _coreDraft.IncludeVisibleTableOfContents
            : _releaseDraft.IncludeVisibleTableOfContents;
        return item.SystemRole switch
        {
            PublicationSectionSystemRole.Title => titlePageMode != PublishTitlePageMode.Omit,
            PublicationSectionSystemRole.Copyright => !string.IsNullOrWhiteSpace(copyright),
            PublicationSectionSystemRole.Contents => includeContents,
            _ => item.IsIncluded,
        };
    }

    private int IncludedPublicationSectionCount(PublicationContentArea area) =>
        PublicationSectionsFor(area).Count(IsPublicationSectionIncluded);

