    private async Task SaveReleaseAsync()
    {
        if (Project is null || _workspace is null || _selectedReleaseId is not Guid id || (!_releaseDirty && !_releaseContentDirty)) return;
        var saveVersion = _formChangeVersion;
        _busy = true; _error = null;
        try
        {
            var revision = _workspace.Edition.Revision;
            if (_releaseDirty)
            {
                var reset = _loadedOverrides.Except(_releaseOverrides).ToList();
                var patch = new PublicationReleaseOverridePatch(
                    revision, _releaseDraft.Name, _releaseDraft.Vendor, _releaseDraft.Isbn,
                    _releaseDraft.PrintProductKey, _releaseDraft.PrintFinish, _releaseDraft.PrintCoverMode, _releaseDraft.GenericPrintTemplateJson,
                    BoolValue(PublicationEditionOverrideField.AllowDesignedPageOverrides, _releaseDraft.AllowDesignedPageOverrides),
                    Value(PublicationEditionOverrideField.Title, _releaseDraft.Title), Value(PublicationEditionOverrideField.Subtitle, _releaseDraft.Subtitle),
                    Value(PublicationEditionOverrideField.Author, _releaseDraft.Author), Value(PublicationEditionOverrideField.Language, _releaseDraft.Language),
                    Value(PublicationEditionOverrideField.Publisher, _releaseDraft.Publisher), Value(PublicationEditionOverrideField.Copyright, _releaseDraft.Copyright),
                    Value(PublicationEditionOverrideField.Description, _releaseDraft.Description),
                    IncludeTableOfContents: BoolValue(PublicationEditionOverrideField.IncludeTableOfContents, _releaseDraft.IncludeTableOfContents),
                    IncludeVisibleTableOfContents: BoolValue(PublicationEditionOverrideField.IncludeVisibleTableOfContents, _releaseDraft.IncludeVisibleTableOfContents),
                    IncludeActSynopses: BoolValue(PublicationEditionOverrideField.IncludeActSynopses, _releaseDraft.IncludeActSynopses),
                    IncludeChapterSynopses: BoolValue(PublicationEditionOverrideField.IncludeChapterSynopses, _releaseDraft.IncludeChapterSynopses),
                    IncludeActHeadings: BoolValue(PublicationEditionOverrideField.IncludeActHeadings, _releaseDraft.IncludeActHeadings),
                    IncludeChapterHeadings: BoolValue(PublicationEditionOverrideField.IncludeChapterHeadings, _releaseDraft.IncludeChapterHeadings),
                    NumberActs: BoolValue(PublicationEditionOverrideField.NumberActs, _releaseDraft.NumberActs),
                    NumberChapters: BoolValue(PublicationEditionOverrideField.NumberChapters, _releaseDraft.NumberChapters),
                    PageWidthInches: DesignValue(PublicationEditionOverrideField.PageWidthInches, _releaseDraft.PageWidthInches),
                    PageHeightInches: DesignValue(PublicationEditionOverrideField.PageHeightInches, _releaseDraft.PageHeightInches),
                    PageMarginInches: DesignValue(PublicationEditionOverrideField.PageMarginInches, _releaseDraft.PageMarginInches),
                    ResetFields: reset);
                revision = (await Releases.PatchOverridesAsync(Project.Id, id, patch)).Revision;
            }
            if (_releaseContentDirty)
            {
                var changes = _releaseSelections.Where(item => !_loadedReleaseSelections.TryGetValue(item.Key, out var loaded) || loaded != item.Value)
                    .Select(item => new PublicationEditionOutlineItemUpdate(PublishOutlineTargetKind.Chapter, item.Key, item.Value)).ToList();
                if (changes.Count > 0)
                    await Releases.SetOutlineSelectionsAsync(Project.Id, id, changes, revision);
            }
            _workspace = await Publishing.GetWorkspaceForEditingAsync(Project.Id, id, _dispose.Token);
            if (saveVersion == _formChangeVersion)
            {
                _releaseDirty = false;
                _releaseContentDirty = false;
                _releaseDraft = ReleaseDraft.From(_workspace.Edition);
                _releaseOverrides = _workspace.OverrideFields.ToHashSet();
                _loadedOverrides = _releaseOverrides.ToHashSet();
                _loadedReleaseSelections = _releaseSelections.ToDictionary();
            }
            _releases = await Releases.ListAsync(Project.Id, _dispose.Token);
            await ReloadPreparationsAsync(PublicationTargetKind.Release, id);
            _artifacts = await Renders.ListArtifactsAsync(Project.Id, id, _dispose.Token);
            _outputsLoaded = true;
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            _workspace = await Publishing.GetWorkspaceForEditingAsync(Project.Id, id, _dispose.Token);
            _releaseDraft = ReleaseDraft.From(_workspace.Edition);
            _releaseOverrides = _workspace.OverrideFields.ToHashSet();
            _loadedOverrides = _releaseOverrides.ToHashSet();
            _releaseSelections = _workspace.Sections.SelectMany(section => section.Chapters)
                .ToDictionary(item => item.Id, item => item.IsIncluded);
            _loadedReleaseSelections = _releaseSelections.ToDictionary();
            _releaseDirty = false;
            _releaseContentDirty = false;
            _error = null;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleEditionContentAsync(ChangeEventArgs args)
    {
        if (Project is null || _workspace is null || _selectedReleaseId is not Guid editionId)
            return;
        var enabled = args.Value is bool value && value;
        if (!enabled && _editionDifferences.Count > 0)
        {
            _pendingDisableEditionContentId = editionId;
            _disableEditionContentConfirmationOpen = true;
            return;
        }

        await SetEditionContentEnabledAsync(editionId, enabled, confirmDiscard: false);
    }

    private async Task ConfirmDisableEditionContentAsync()
    {
        if (_pendingDisableEditionContentId is not Guid editionId
            || _selectedReleaseId != editionId)
        {
            CancelDisableEditionContent();
            return;
        }

        await SetEditionContentEnabledAsync(editionId, enabled: false, confirmDiscard: true);
        _disableEditionContentConfirmationOpen = false;
        _pendingDisableEditionContentId = null;
    }

