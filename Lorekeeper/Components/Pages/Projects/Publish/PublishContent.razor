    private PublicationSectionTarget CurrentPublicationSectionTarget() =>
        new(Project!.Id, _selectedReleaseId);

    private async Task AddPublicationSectionAsync(bool designedPage, PublicationSectionAnchor anchor)
    {
        if (Project is null) return;
        try
        {
            var target = anchor is PublicationSectionAnchor.Front or PublicationSectionAnchor.Back
                ? null
                : _coreOutline.FirstOrDefault();
            if (target is null && anchor is not (PublicationSectionAnchor.Front or PublicationSectionAnchor.Back))
                throw new InvalidOperationException("Add a chapter before placing a section in the main content.");
            var id = Guid.NewGuid();
            var document = new ManuscriptDocument
            {
                ManuscriptId = id,
                Content = designedPage ? [] :
                [
                    new ManuscriptBlock
                    {
                        Id = $"paragraph-{Guid.NewGuid():N}",
                        Type = ManuscriptBlockType.Paragraph,
                        StyleRole = ManuscriptStyleRoles.Body,
                        Content = [new ManuscriptInline { Text = string.Empty }],
                    },
                ],
            };
            var saved = await PublicationSections.UpsertAsync(CurrentPublicationSectionTarget(), new(
                null, designedPage ? "Designed page" : "New section", PublicationSectionKind.Custom,
                anchor, target?.TargetKind, target?.TargetId, PublicationSectionInclusionMode.Included,
                PublicationSectionStartSide.Next,
                ManuscriptCodec.Serialize(document)));
            if (designedPage)
            {
                var created = await PublicationSections.CreateDesignedPageAsync(
                    CurrentPublicationSectionTarget(), saved.Id, 0, "Designed page",
                    DesignedPageLayoutMode.SinglePage, saved.Revision);
                saved = created.Section;
                _selectedSectionCompositionId = created.Composition.Id;
            }
            await RefreshPublicationSectionsAsync();
            BeginPublicationSectionEdit(saved);
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task BeginPublicationSectionEditAsync(PublicationSectionView item)
    {
        try
        {
            await SavePendingAsync();
            if (item.IsInherited && _selectedReleaseId is Guid releaseId)
                item = await PublicationSections.CustomizeAsync(Project!.Id, releaseId, item.Id);
            if (item.SystemRole is PublicationSectionSystemRole.Title or PublicationSectionSystemRole.Copyright)
                item = await PublicationSections.EnsureSystemDesignedPageAsync(CurrentPublicationSectionTarget(), item.Id, _dispose.Token);
            BeginPublicationSectionEdit(item);
            await RefreshPublicationSectionsAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private void BeginPublicationSectionEdit(PublicationSectionView item)
    {
        var preserveWorkspace = _editingSection?.Id == item.Id;
        var previousCompositionId = _selectedSectionCompositionId;
        var previousVariantId = _selectedSectionVariantId;
        var previousVariantRevision = _selectedSectionVariantRevision;
        var previousSelectionId = _sectionPageSelectionId;
        var previousSettingsOpen = _sectionSettingsOpen;
        _editingSection = item;
        _sectionTitle = item.Title;
        _sectionKind = item.Kind;
        _sectionAnchor = item.Anchor;
        _sectionTargetKind = item.TargetKind;
        _sectionTargetId = item.TargetId;
        _sectionInclusion = item.InclusionMode;
        _sectionStartSide = item.StartSide;
        var compositionIds = item.Manuscript.Content
            .Where(block => block.PageCompositionId.HasValue)
            .Select(block => block.PageCompositionId!.Value)
            .Distinct()
            .ToList();
        _selectedSectionCompositionId = preserveWorkspace
            && previousCompositionId is Guid selectedCompositionId
            && compositionIds.Contains(selectedCompositionId)
                ? selectedCompositionId
                : compositionIds.FirstOrDefault() is var firstCompositionId && firstCompositionId != Guid.Empty
                    ? firstCompositionId
                    : null;
        var retainedSameComposition = preserveWorkspace && _selectedSectionCompositionId == previousCompositionId;
        _selectedSectionVariantId = retainedSameComposition ? previousVariantId : null;
        _selectedSectionVariantRevision = retainedSameComposition ? previousVariantRevision : null;
        _sectionPageSelectionId = retainedSameComposition ? previousSelectionId : null;
        _sectionSettingsOpen = preserveWorkspace && previousSettingsOpen;
    }

    private async Task ClosePublicationSectionEditorAsync()
    {
        if (_publicationSectionEditor is not null)
            await _publicationSectionEditor.FlushAsync();
        _editingSection = null;
        _publicationSectionEditor = null;
        _sectionPageWorkspace = null;
        _selectedSectionCompositionId = null;
        _selectedSectionVariantId = null;
        _selectedSectionVariantRevision = null;
        _sectionPageSelectionId = null;
        _sectionSettingsOpen = false;
        _publicationSectionImageModalOpen = false;
        await RefreshPublicationSectionsAsync();
    }

    private IReadOnlyList<Guid> SectionCompositionIds() => _editingSection?.Manuscript.Content
        .Where(block => block.PageCompositionId.HasValue)
        .Select(block => block.PageCompositionId!.Value)
        .Distinct()
        .ToList() ?? [];

    private static bool IsDesignedPublicationSection(PublicationSectionView section) =>
        section.SystemRole is PublicationSectionSystemRole.Title or PublicationSectionSystemRole.Copyright
        || (section.Manuscript.Content.Count > 0
            && section.Manuscript.Content.All(block => block.Type == ManuscriptBlockType.DesignedPage
                && block.PageCompositionId.HasValue));

    private string SectionCompositionLabel(Guid compositionId)
    {
        var index = SectionCompositionIds().ToList().IndexOf(compositionId);
        return index < 0 ? "Designed page" : $"Page {index + 1}";
    }

    private Task SelectSectionCompositionAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var compositionId)
            && SectionCompositionIds().Contains(compositionId))
        {
            _selectedSectionCompositionId = compositionId;
            _selectedSectionVariantId = null;
            _selectedSectionVariantRevision = null;
            _sectionPageSelectionId = null;
        }
        return Task.CompletedTask;
    }

    private EditorContentTarget SectionEditorContentTarget() => _selectedReleaseId is Guid releaseId
        ? EditorContentTarget.ForEdition(releaseId)
        : EditorContentTarget.Core;

    private void OpenPublicationSectionImageModal() => _publicationSectionImageModalOpen = true;
    private void ClosePublicationSectionImageModal() => _publicationSectionImageModalOpen = false;

    private async Task SelectPublicationSectionImageAsync(Lorekeeper.Images.ProjectImageView image)
    {
        if (_publicationSectionEditor is not null)
            await _publicationSectionEditor.SelectProjectImageAsync(image);
        _publicationSectionImageModalOpen = false;
    }

    private Task<ManuscriptDocument> ReadPublicationSectionDocumentAsync(long expectedRevision)
    {
        if (_editingSection is null || _editingSection.Revision != expectedRevision)
            throw new ManuscriptRevisionConflictException(expectedRevision, _editingSection?.Revision ?? 0);
        return Task.FromResult(_editingSection.Manuscript);
    }

    private async Task<ChapterBodyEditor.SemanticEditorSaveResult> SavePublicationSectionDocumentAsync(
        Guid sectionId,
        long expectedRevision,
        string manuscriptJson)
    {
        if (Project is null || _editingSection is null || _editingSection.Id != sectionId)
            return new(false, expectedRevision);
        try
        {
            var saved = await PublicationSections.UpsertAsync(CurrentPublicationSectionTarget(), new(
                sectionId, _sectionTitle, _sectionKind, _sectionAnchor, _sectionTargetKind, _sectionTargetId,
                _sectionInclusion, _sectionStartSide, manuscriptJson, expectedRevision));
            _editingSection = saved;
            await RefreshPublicationSectionsAsync(updateEditing: false);
            return new(true, saved.Revision);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            await RefreshPublicationSectionsAsync();
            var current = _publicationSections.FirstOrDefault(item => item.Id == sectionId);
            return current is null
                ? new(false, expectedRevision)
                : new(
                    true,
                    current.Revision,
                    Applied: false,
                    CurrentManuscriptJson: ManuscriptCodec.Serialize(current.Manuscript));
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            return new(false, expectedRevision);
        }
    }

    private Task<Lorekeeper.Authoring.AuthoringHistoryState> ReadPublicationSectionHistoryAsync() =>
        _editingSection is null
            ? Task.FromResult(new Lorekeeper.Authoring.AuthoringHistoryState(0, false, false, null, null, 0, 0))
            : PublicationSections.GetHistoryStateAsync(CurrentPublicationSectionTarget(), _editingSection.Id);

    private Task<ChapterBodyEditor.SemanticEditorHistoryResult> UndoPublicationSectionAsync() =>
        MovePublicationSectionHistoryAsync(redo: false);

    private Task<ChapterBodyEditor.SemanticEditorHistoryResult> RedoPublicationSectionAsync() =>
        MovePublicationSectionHistoryAsync(redo: true);

    private async Task<ChapterBodyEditor.SemanticEditorHistoryResult> MovePublicationSectionHistoryAsync(bool redo)
    {
        if (_editingSection is null)
            return new(false, null, 0, false, false, null, null, null, "No publication section is open.");
        try
        {
            var result = redo
                ? await PublicationSections.RedoAsync(CurrentPublicationSectionTarget(), _editingSection.Id)
                : await PublicationSections.UndoAsync(CurrentPublicationSectionTarget(), _editingSection.Id);
            _editingSection = result.Section;
            await RefreshPublicationSectionsAsync(updateEditing: false);
            return new(true, ManuscriptCodec.Serialize(result.Section.Manuscript), result.Section.Revision,
                result.History.CanUndo, result.History.CanRedo, result.History.UndoLabel, result.History.RedoLabel,
                result.SelectionJson, null);
        }
        catch (Exception exception)
        {
            return new(false, null, 0, false, false, null, null, null, exception.Message);
        }
    }

    private async Task SavePublicationSectionMetadataAsync()
    {
        if (_editingSection is null) return;
        if (_publicationSectionEditor is not null && !await _publicationSectionEditor.FlushAsync())
            return;
        try
        {
            var saved = await PublicationSections.UpsertAsync(CurrentPublicationSectionTarget(), new(
                _editingSection.Id, _sectionTitle, _sectionKind, _sectionAnchor, _sectionTargetKind, _sectionTargetId,
                _sectionInclusion, _sectionStartSide, ManuscriptCodec.Serialize(_editingSection.Manuscript), _editingSection.Revision));
            BeginPublicationSectionEdit(saved);
            await RefreshPublicationSectionsAsync(updateEditing: false);
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task SectionTitleChangedAsync(ChangeEventArgs args) { _sectionTitle = args.Value?.ToString() ?? string.Empty; await SavePublicationSectionMetadataAsync(); }
    private async Task SectionKindChangedAsync(ChangeEventArgs args) { if (Enum.TryParse<PublicationSectionKind>(args.Value?.ToString(), out var value)) _sectionKind = value; await SavePublicationSectionMetadataAsync(); }
    private async Task SectionInclusionChangedAsync(ChangeEventArgs args) { if (Enum.TryParse<PublicationSectionInclusionMode>(args.Value?.ToString(), out var value)) _sectionInclusion = value; await SavePublicationSectionMetadataAsync(); }
    private async Task SectionStartSideChangedAsync(ChangeEventArgs args) { if (Enum.TryParse<PublicationSectionStartSide>(args.Value?.ToString(), out var value)) _sectionStartSide = value; await SavePublicationSectionMetadataAsync(); }
    private async Task SectionAnchorChangedAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<PublicationSectionAnchor>(args.Value?.ToString(), out var value))
            _sectionAnchor = value;
        var target = SectionAnchorTargets().FirstOrDefault();
        _sectionTargetKind = target?.TargetKind;
        _sectionTargetId = target?.TargetId;
        if (_sectionAnchor is PublicationSectionAnchor.Front or PublicationSectionAnchor.Back)
        {
            _sectionTargetKind = null;
            _sectionTargetId = null;
        }
        await SavePublicationSectionMetadataAsync();
    }

    private async Task SectionTargetChangedAsync(ChangeEventArgs args)
    {
        var parts = (args.Value?.ToString() ?? string.Empty).Split('|');
        if (parts.Length == 2 && Enum.TryParse<PublishOutlineTargetKind>(parts[0], out var kind) && Guid.TryParse(parts[1], out var id))
        {
            _sectionTargetKind = kind;
            _sectionTargetId = id;
            await SavePublicationSectionMetadataAsync();
        }
    }

    private IEnumerable<PublicationBookOutlineView> SectionAnchorTargets() => _coreOutline.Where(item =>
        _sectionAnchor is PublicationSectionAnchor.BeforeAct or PublicationSectionAnchor.AfterAct
            ? item.TargetKind == PublishOutlineTargetKind.Act
            : item.TargetKind == PublishOutlineTargetKind.Chapter);

    private string SectionTargetValue() => _sectionTargetKind is { } kind && _sectionTargetId is Guid id ? $"{kind}|{id}" : string.Empty;

    private IEnumerable<PublicationSectionKind> EditableSectionKinds() => _editingSection switch
    {
        null => [],
        { SystemRole: PublicationSectionSystemRole.None } => Enum.GetValues<PublicationSectionKind>()
            .Where(kind => kind is not (PublicationSectionKind.TitlePage or PublicationSectionKind.Copyright or PublicationSectionKind.Contents)),
        _ => [_editingSection.Kind],
    };

    private Task ResetPublicationSectionAsync(PublicationSectionView item)
    {
        _pendingSectionRemoval = item;
        _pendingSectionReset = true;
        return Task.CompletedTask;
    }

    private async Task MovePublicationSectionAsync(PublicationSectionView item, int delta)
    {
        var ordered = _publicationSections
            .Where(candidate => candidate.Anchor == item.Anchor && candidate.TargetId == item.TargetId)
            .ToList();
        var index = ordered.FindIndex(candidate => candidate.Id == item.Id);
        var destination = index + delta;
        if (index < 0 || destination < 0 || destination >= ordered.Count)
            return;
        (ordered[index], ordered[destination]) = (ordered[destination], ordered[index]);
        try
        {
            await PublicationSections.ReorderWithinAnchorAsync(
                CurrentPublicationSectionTarget(), ordered.Select(candidate => candidate.Id).ToList(), _dispose.Token);
            await RefreshPublicationSectionsAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private bool CanMovePublicationSection(PublicationSectionView item, int delta)
    {
        var ordered = _publicationSections
            .Where(candidate => candidate.Anchor == item.Anchor && candidate.TargetId == item.TargetId)
            .ToList();
        var index = ordered.FindIndex(candidate => candidate.Id == item.Id);
        var destination = index + delta;
        if (index < 0 || destination < 0 || destination >= ordered.Count)
            return false;
        return true;
    }

    private async Task SetPublicationSectionIncludedAsync(PublicationSectionView item, bool included)
    {
        try
        {
            var saved = await PublicationSections.SetInclusionAsync(
                CurrentPublicationSectionTarget(),
                item.Id,
                included ? PublicationSectionInclusionMode.Included : PublicationSectionInclusionMode.Omitted,
                item.Revision,
                _dispose.Token);
            if (_editingSection?.Id == item.Id)
                BeginPublicationSectionEdit(saved);
            await RefreshPublicationSectionsAsync(updateEditing: false);
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task MovePublicationSectionAreaAsync(PublicationSectionView item, ChangeEventArgs args)
    {
        var area = args.Value?.ToString();
        var anchor = area switch
        {
            "Front" => PublicationSectionAnchor.Front,
            "Back" => PublicationSectionAnchor.Back,
            _ when item.Anchor is not (PublicationSectionAnchor.Front or PublicationSectionAnchor.Back) => item.Anchor,
            _ => PublicationSectionAnchor.BeforeChapter,
        };
        PublicationBookOutlineView? target = null;
        if (anchor is not (PublicationSectionAnchor.Front or PublicationSectionAnchor.Back))
        {
            target = item.TargetId is Guid targetId
                ? _coreOutline.FirstOrDefault(candidate => candidate.TargetId == targetId)
                : _coreOutline.FirstOrDefault();
            if (target is null)
            {
                _error = "Add a chapter before moving a section into the main content.";
                return;
            }
        }
        try
        {
            var saved = await PublicationSections.UpsertAsync(CurrentPublicationSectionTarget(), new(
                item.Id, item.Title, item.Kind, anchor, target?.TargetKind, target?.TargetId,
                item.InclusionMode, item.StartSide, ManuscriptCodec.Serialize(item.Manuscript), item.Revision));
            if (_editingSection?.Id == item.Id)
                BeginPublicationSectionEdit(saved);
            await RefreshPublicationSectionsAsync(updateEditing: false);
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private Task DeletePublicationSectionAsync(PublicationSectionView item)
    {
        _pendingSectionRemoval = item;
        _pendingSectionReset = false;
        return Task.CompletedTask;
    }

    private string SectionRemovalMessage() => _pendingSectionRemoval is not { } item
        ? string.Empty
        : _pendingSectionReset
            ? $"This discards the release-specific copy of '{item.Title}' and resumes live inheritance from Core Book."
            : _selectedReleaseId is null
                ? $"This removes '{item.Title}' from Core Book and every release that inherits it. This cannot be undone."
                : $"This removes '{item.Title}' from this release. Core Book content is not deleted.";

    private async Task ConfirmSectionRemovalAsync()
    {
        if (Project is null || _pendingSectionRemoval is not { } item)
            return;
        _sectionRemovalBusy = true;
        try
        {
            if (_pendingSectionReset && _selectedReleaseId is Guid releaseId)
                await PublicationSections.ResetAsync(Project.Id, releaseId, item.Id);
            else
                await PublicationSections.DeleteAsync(CurrentPublicationSectionTarget(), item.Id);
            if (_editingSection?.Id == item.Id) _editingSection = null;
            CancelSectionRemoval();
            await RefreshPublicationSectionsAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _sectionRemovalBusy = false; }
    }

    private void CancelSectionRemoval()
    {
        _pendingSectionRemoval = null;
        _pendingSectionReset = false;
    }

    private async Task RefreshPublicationSectionsAsync(bool updateEditing = true)
    {
        if (Project is null) return;
        _publicationSections = await PublicationSections.ListAsync(CurrentPublicationSectionTarget(), _dispose.Token);
        if (_selectedReleaseId is Guid releaseId && !_releaseDirty && !_releaseContentDirty)
            _workspace = await Publishing.GetWorkspaceForEditingAsync(Project.Id, releaseId, _dispose.Token);
        else if (_selectedReleaseId is null && !_coreDirty && !_coreOutlineDirty)
            _core = await Books.GetOrCreateAsync(Project.Id, _dispose.Token);
        if (updateEditing && _editingSection is not null)
            _editingSection = _publicationSections.FirstOrDefault(item => item.Id == _editingSection.Id);
        _outputsLoaded = false;
        await ReloadPreparationsAsync(
            _selectedReleaseId is null ? PublicationTargetKind.CoreBook : PublicationTargetKind.Release,
            _selectedReleaseId);
        _outputsLoaded = true;
    }

