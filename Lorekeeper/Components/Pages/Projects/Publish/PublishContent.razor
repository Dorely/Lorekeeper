    private async Task HandleAssistantMutationAsync(PublishWorkspaceMutated mutation)
    {
        if (_coreDirty || _coreOutlineDirty || _pageSetupDirty || _releaseDirty || _releaseContentDirty)
        {
            _notice = "The assistant changed publishing settings while your form edits were pending. Your edits were kept and will continue saving automatically.";
            QueueFormAutosave();
            return;
        }
        if (Project is not null && mutation.EditionId == _selectedReleaseId
            && (mutation.SelectedSectionId is not null || mutation.SelectedCompositionId is not null))
        {
            _publicationSections = await PublicationSections.ListAsync(new(Project.Id, _selectedReleaseId), _dispose.Token);
            var selectedSection = mutation.SelectedSectionId is Guid sectionId
                ? _publicationSections.FirstOrDefault(item => item.Id == sectionId)
                : _editingSection is null
                    ? null
                    : _publicationSections.FirstOrDefault(item => item.Id == _editingSection.Id);
            if (selectedSection is not null)
                BeginPublicationSectionEdit(selectedSection);
            if (mutation.SelectedCompositionId is Guid compositionId)
                _selectedSectionCompositionId = compositionId;
            if (mutation.SelectedVariantId is Guid variantId)
                _selectedSectionVariantId = variantId;
            _sectionPageSelectionId = mutation.SelectedObjectId;
            _sectionPageRefreshSignal++;
            if (_selectedReleaseId is Guid releaseId)
            {
                _workspace = await Publishing.GetWorkspaceForEditingAsync(Project.Id, releaseId, _dispose.Token);
                await ReloadPreparationsAsync(PublicationTargetKind.Release, releaseId);
                _artifacts = await Renders.ListArtifactsAsync(Project.Id, releaseId, _dispose.Token);
            }
            else
            {
                _core = await Books.GetOrCreateAsync(Project.Id, _dispose.Token);
                await ReloadPreparationsAsync(PublicationTargetKind.CoreBook, null);
                _artifacts = (await Renders.ListCoreAsync(Project.Id, _dispose.Token)).SelectMany(item => item.Artifacts).OrderByDescending(item => item.CreatedAt).ToList();
            }
            _outputsLoaded = true;
            StateHasChanged();
            return;
        }
        var coverWasOpen = _coverEditorOpen;
        var targetReleaseId = mutation.SelectEdition && mutation.EditionId is Guid id
            ? id
            : _selectedReleaseId;
        QueueAssistantTargetRefresh(targetReleaseId);
        if (mutation.Kind == PublishWorkspaceMutationKind.Edition && coverWasOpen)
        {
            _coverEditorOpen = true;
            _coverSelectionId = mutation.SelectedObjectId;
            _coverRefreshSignal++;
        }
    }

    private void QueueAssistantTargetRefresh(Guid? releaseId)
    {
        _previewArtifact = null;
        if (_selectedReleaseId != releaseId)
        {
            _selectedReleaseId = releaseId;
            _workspace = null;
        }
        _preparations = [];
        _preparationDiagnostics = [];
        _artifacts = [];
        _outputsLoaded = false;
        _targetLoading = true;
        _targetLoadPending = true;
        _refreshCoreSummaryOnTargetLoad = releaseId is null;
        _targetLoadGeneration++;
        _error = null;
        StateHasChanged();
    }

