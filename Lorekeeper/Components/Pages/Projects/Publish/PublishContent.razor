@using Lorekeeper.Images
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Publish
@implements IAsyncDisposable
@inject IPublishService Publishing
@inject IPublicationEditionService Editions
@inject IManuscriptStyleService ManuscriptStyles
@inject IPublishAssistantService PublishAssistant
@inject IProjectImageService ProjectImages
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Project is null)
{
    <div class="publish-loading" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Loading project…</span>
    </div>
}
else if (_loading)
{
    <div class="publish-loading" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Preparing your publishing workspace…</span>
    </div>
}
else if (_editionSummaries.Count == 0)
{
    <section class="publish-load-error" aria-labelledby="edition-empty-title">
        <div>
            <h2 id="edition-empty-title">Create the first publication edition</h2>
            <p>An edition owns its format, vendor, ISBN, included content, matter, styles, cover, and artifacts.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <input class="form-control" aria-label="Edition name" placeholder="Paperback"
                   @bind="_newEditionName" @bind:event="oninput" />
            <select class="form-select" aria-label="Edition format" @bind="_newEditionFormat">
                <option value="@PublicationEditionFormat.Paperback">Paperback</option>
                <option value="@PublicationEditionFormat.Epub">EPUB</option>
            </select>
            <button type="button" class="btn btn-primary" disabled="@_creatingEdition" @onclick="CreateEditionAsync">
                @(_creatingEdition ? "Creatingâ€¦" : "Create edition")
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_editionActionError))
        {
            <p class="text-danger" role="alert">@_editionActionError</p>
        }
    </section>
}
else if (_workspace is null)
{
    <div class="publish-load-error" role="alert">
        <div>
            <h2>We couldn’t load Publish</h2>
            <p>@(string.IsNullOrWhiteSpace(_loadError) ? "The publishing setup is unavailable right now." : _loadError)</p>
        </div>
        <button type="button" class="btn btn-primary" disabled="@_loading" @onclick="RetryLoadAsync">Try again</button>
    </div>
}
else
{
    <main class="publish-workspace" aria-labelledby="publish-title">
        <header class="publish-header">
            <div class="publish-heading">
                <span class="publish-eyebrow">Book publishing</span>
                <h1 id="publish-title">Prepare your manuscript</h1>
                <p>Choose what belongs in the book, review its presentation, and export when everything is ready.</p>
                <label class="publish-field">
                    <span>Publication edition</span>
                    <select class="form-select" value="@_selectedEditionId" @onchange="SelectEditionAsync">
                        @foreach (var edition in _editionSummaries)
                        {
                            <option value="@edition.Id">@edition.Name · @edition.Format · @edition.Vendor@(edition.IsDefault ? " · default" : null)</option>
                        }
                    </select>
                </label>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@HasBusyMutation" @onclick="CloneEditionAsync">Clone</button>
                    @if (!_workspace.Edition.IsDefault)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                disabled="@HasBusyMutation" @onclick="SetDefaultEditionAsync">Make default</button>
                    }
                    @if (_editionSummaries.Count > 1)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                disabled="@HasBusyMutation" @onclick="CompareEditionAsync">Compare</button>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                disabled="@HasBusyMutation" @onclick="ArchiveEditionAsync">Archive</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_editionActionError))
                {
                    <div class="small mt-2" role="status">@_editionActionError</div>
                }
            </div>

            <div class="publish-header-status" aria-live="polite" aria-atomic="true">
                <span class="publish-status-dot @SaveStatusDotClass" aria-hidden="true"></span>
                <span class="@SaveStatusTextClass">@SaveStatusText</span>
                @if (_editionSaveState == SaveState.SaveFailed)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@EditionSaveInProgress" @onclick="RetryEditionSaveAsync">
                        Retry save
                    </button>
                }
            </div>
        </header>

        <div class="publish-layout">
            <div class="publish-main">
                <section class="publish-card" aria-labelledby="publish-assistant-title">
                    <div class="publish-card-heading">
                        <div><span class="publish-step">AI</span><h2 id="publish-assistant-title">Publish assistant</h2></div>
                        <p>The assistant uses the same revision-aware edition services as these controls.</p>
                    </div>
                    <textarea class="form-control" rows="3" @bind="_assistantPrompt"
                              placeholder="Compare this edition, update its settings, or inspect its matter and audit history."></textarea>
                    <button class="btn btn-sm btn-primary mt-2" disabled="@_assistantBusy" @onclick="AskPublishAssistantAsync">
                        @(_assistantBusy ? "Working…" : "Ask Publish assistant")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_assistantResponse))
                    {
                        <div class="alert alert-secondary mt-2 mb-0">@_assistantResponse</div>
                    }
                </section>
                <section class="publish-card" aria-labelledby="edition-settings-title">
                    <div class="publish-card-heading">
                        <div>
                            <span class="publish-step">Edition</span>
                            <h2 id="edition-settings-title">Product settings</h2>
                        </div>
                        <p>These choices belong only to @_editionDraft.Name.</p>
                    </div>
                    <div class="publish-form-grid">
                        <label class="publish-field">
                            <span>Edition name</span>
                            <input class="form-control" @bind="_editionDraft.Name" @bind:event="oninput"
                                   @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field">
                            <span>Format</span>
                            <select class="form-select" @bind="_editionDraft.Format" @bind:after="ScheduleEditionAutosave">
                                <option value="@PublicationEditionFormat.Paperback">Paperback</option>
                                <option value="@PublicationEditionFormat.Epub">EPUB</option>
                            </select>
                        </label>
                        <label class="publish-field">
                            <span>Vendor</span>
                            <select class="form-select" @bind="_editionDraft.Vendor" @bind:after="ScheduleEditionAutosave">
                                <option value="@PublicationVendor.Generic">Generic</option>
                                <option value="@PublicationVendor.AmazonKdp">Amazon KDP</option>
                                <option value="@PublicationVendor.IngramSpark">IngramSpark</option>
                            </select>
                        </label>
                        <label class="publish-field">
                            <span>Vendor profile version</span>
                            <input class="form-control" @bind="_editionDraft.VendorProfileVersion" @bind:event="oninput"
                                   @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field">
                            <span>Binding</span>
                            <select class="form-select" @bind="_editionDraft.Binding" @bind:after="ScheduleEditionAutosave">
                                <option value="@PublicationBinding.PerfectBound">Perfect bound</option>
                                <option value="@PublicationBinding.Digital">Digital</option>
                            </select>
                        </label>
                        <label class="publish-field">
                            <span>Paper</span>
                            <select class="form-select" @bind="_editionDraft.Paper" @bind:after="ScheduleEditionAutosave">
                                <option value="@PublicationPaper.White">White</option>
                                <option value="@PublicationPaper.Cream">Cream</option>
                                <option value="@PublicationPaper.Digital">Digital</option>
                            </select>
                        </label>
                        <label class="publish-field">
                            <span>Ink</span>
                            <select class="form-select" @bind="_editionDraft.Ink" @bind:after="ScheduleEditionAutosave">
                                <option value="@PublicationInk.BlackAndWhite">Black &amp; white</option>
                                <option value="@PublicationInk.Color">Color</option>
                                <option value="@PublicationInk.Digital">Digital</option>
                            </select>
                        </label>
                        <label class="publish-toggle">
                            <input class="form-check-input" type="checkbox" @bind="_editionDraft.Bleed"
                                   @bind:after="ScheduleEditionAutosave" />
                            <span><strong>Include bleed</strong></span>
                        </label>
                    </div>
                </section>

                <section class="publish-card" aria-labelledby="identity-title">
                    <div class="publish-card-heading">
                        <div>
                            <span class="publish-step">01</span>
                            <h2 id="identity-title">Book identity</h2>
                        </div>
                        <p>The title and author information readers see first.</p>
                    </div>

                    <div class="publish-form-grid">
                        <label class="publish-field publish-field-wide">
                            <span>Title</span>
                            <input class="form-control" autocomplete="off" placeholder="@_workspace.Edition.ProjectName"
                                   @bind="_editionDraft.TitleOverride" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                            <small>Leave blank to use the project name.</small>
                        </label>
                        <label class="publish-field publish-field-wide">
                            <span>Subtitle <em>Optional</em></span>
                            <input class="form-control" autocomplete="off" placeholder="A subtitle for your book"
                                   @bind="_editionDraft.Subtitle" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field">
                            <span>Author</span>
                            <input class="form-control" autocomplete="name" placeholder="Author name"
                                   @bind="_editionDraft.Author" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field">
                            <span>Language</span>
                            <input class="form-control" autocomplete="off" placeholder="en" aria-describedby="language-help"
                                   @bind="_editionDraft.Language" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                            <small id="language-help">Use a language tag such as en or en-US.</small>
                        </label>
                    </div>
                </section>

                <section class="publish-card" aria-labelledby="metadata-title">
                    <div class="publish-card-heading">
                        <div>
                            <span class="publish-step">02</span>
                            <h2 id="metadata-title">Publishing metadata</h2>
                        </div>
                        <p>Optional catalog and storefront information.</p>
                    </div>

                    <div class="publish-form-grid">
                        <label class="publish-field">
                            <span>Publisher <em>Optional</em></span>
                            <input class="form-control" autocomplete="organization"
                                   @bind="_editionDraft.Publisher" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field">
                            <span>ISBN <em>Optional</em></span>
                            <input class="form-control" autocomplete="off" inputmode="numeric"
                                   @bind="_editionDraft.Isbn" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field publish-field-wide">
                            <span>Copyright notice <em>Optional</em></span>
                            <input class="form-control" autocomplete="off" placeholder="© 2026 Author name"
                                   @bind="_editionDraft.Copyright" @bind:event="oninput" @bind:after="ScheduleEditionAutosave" />
                        </label>
                        <label class="publish-field publish-field-wide">
                            <span>Description <em>Optional</em></span>
                            <textarea class="form-control" data-autosize data-autosize-resize="vertical" rows="3"
                                      placeholder="A short description of the book"
                                      @bind="_editionDraft.Description" @bind:event="oninput" @bind:after="ScheduleEditionAutosave"></textarea>
                        </label>
                    </div>
                </section>

                <section class="publish-card" aria-labelledby="matter-title">
                    <div class="publish-card-heading">
                        <div>
                            <span class="publish-step">03</span>
                            <h2 id="matter-title">Front &amp; back matter</h2>
                        </div>
                        <p>Add the supporting pages that frame the manuscript.</p>
                    </div>

                    <div class="publish-stack">
                        @foreach (var item in _workspace.Matter.OrderBy(item => item.Location).ThenBy(item => item.SortOrder))
                        {
                            <div class="publish-inline-row">
                                <div>
                                    <strong>@item.Title</strong>
                                    <div class="small text-muted">@item.Location · @item.Kind · revision @item.Revision</div>
                                    <div class="small">@MatterPlainText(item)</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        disabled="@HasBusyMutation"
                                        @onclick="() => DeleteMatterAsync(item)">Remove</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        disabled="@HasBusyMutation"
                                        @onclick="() => BeginEditMatter(item)">Edit</button>
                            </div>
                        }
                        @if (_editingMatterId is not null)
                        {
                            <div class="publish-form-grid border rounded p-3">
                                <label class="publish-field"><span>Title</span>
                                    <input class="form-control" @bind="_matterTitle" /></label>
                                <label class="publish-field"><span>Location</span>
                                    <select class="form-select" @bind="_matterLocation">
                                        <option value="@PublicationMatterLocation.Front">Front</option>
                                        <option value="@PublicationMatterLocation.Back">Back</option>
                                    </select></label>
                                <label class="publish-field"><span>Kind</span>
                                    <select class="form-select" @bind="_matterKind">
                                        @foreach (var kind in Enum.GetValues<PublicationMatterKind>())
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select></label>
                                <label class="publish-field"><span>Order</span>
                                    <input class="form-control" type="number" @bind="_matterSortOrder" /></label>
                                <label class="publish-field"><span><input type="checkbox" @bind="_matterIncluded" /> Include</span></label>
                                <label class="publish-field publish-field-wide">
                                    <span>Semantic document JSON</span>
                                    <textarea class="form-control font-monospace" rows="10" @bind="_matterJson"></textarea>
                                    <small>All blocks, marks, styles, links, and figures are preserved and schema-validated on save.</small>
                                </label>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" @onclick="SaveMatterAsync">Save matter</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelMatterEdit">Cancel</button>
                                </div>
                            </div>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    disabled="@HasBusyMutation"
                                    @onclick="() => AddMatterAsync(PublicationMatterKind.Dedication)">Add dedication</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    disabled="@HasBusyMutation"
                                    @onclick="() => AddMatterAsync(PublicationMatterKind.Acknowledgments)">Add acknowledgments</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    disabled="@HasBusyMutation"
                                    @onclick="() => AddMatterAsync(PublicationMatterKind.Custom)">Add custom page</button>
                        </div>
                    </div>
                </section>

                <section class="publish-card" aria-labelledby="edition-style-title">
                    <div class="publish-card-heading">
                        <div><span class="publish-step">Styles</span><h2 id="edition-style-title">Edition style mappings</h2></div>
                        <p>Override named manuscript styles for this edition without changing the source manuscript.</p>
                    </div>
                    @foreach (var mapping in _workspace.StyleMappings)
                    {
                        <div class="publish-inline-row">
                            <span><strong>@mapping.StyleName</strong> · @mapping.SemanticRole ·
                                @(mapping.Override.FontSizePoints?.ToString() ?? "inherited") pt ·
                                line @(mapping.Override.LineHeight?.ToString() ?? "inherited") · revision @mapping.Revision</span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteStyleMappingAsync(mapping)">Remove</button>
                        </div>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <select class="form-select" @bind="_styleMappingStyleId">
                            <option value="">Choose named style</option>
                            @foreach (var style in _namedStyles)
                            {
                                <option value="@style.Id">@style.Name · @style.Kind</option>
                            }
                        </select>
                        <input class="form-control" type="number" step="0.1" placeholder="Font pt"
                               title="Override font size in points" @bind="_styleFontSize" />
                        <input class="form-control" type="number" step="0.05" placeholder="Line height"
                               title="Override line height" @bind="_styleLineHeight" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="AddStyleMappingAsync">Map style</button>
                    </div>
                    @if (_editionAudit.Count > 0)
                    {
                        <details class="mt-3">
                            <summary>Audit history (@_editionAudit.Count)</summary>
                            @foreach (var entry in _editionAudit.Take(10))
                            {
                                <div class="small">@entry.CreatedAt.ToLocalTime(): @entry.Action · @entry.AfterHash[..Math.Min(12, entry.AfterHash.Length)]</div>
                            }
                        </details>
                    }
                </section>

                <section class="publish-card" aria-labelledby="formatting-title">
                    <div class="publish-card-heading">
                        <div>
                            <span class="publish-step">04</span>
                            <h2 id="formatting-title">Contents &amp; formatting</h2>
                        </div>
                        <p>Control title pages, navigation, headings, numbering, and Picture Page spreads.</p>
                    </div>

                    <div class="publish-option-groups">
                        <fieldset class="publish-option-group">
                            <legend>Table of contents</legend>
                            <label class="publish-toggle">
                                <input class="form-check-input" type="checkbox"
                                       @bind="_editionDraft.IncludeTableOfContents" @bind:after="ScheduleEditionAutosave" />
                                <span>
                                    <strong>Include navigation table of contents</strong>
                                    <small>Add linked navigation to supported exports.</small>
                                </span>
                            </label>
                            <label class="publish-toggle publish-dependent @(!_editionDraft.IncludeTableOfContents ? "is-disabled" : null)">
                                <input class="form-check-input" type="checkbox" disabled="@(!_editionDraft.IncludeTableOfContents)"
                                       @bind="_editionDraft.IncludeVisibleTableOfContents" @bind:after="ScheduleEditionAutosave" />
                                <span>
                                    <strong>Show a visible contents page</strong>
                                    <small>Render the contents as a page in EPUB and print.</small>
                                </span>
                            </label>
                        </fieldset>

                        <fieldset class="publish-option-group">
                            <legend>Act presentation</legend>
                            <label class="publish-toggle">
                                <input class="form-check-input" type="checkbox"
                                       @bind="_editionDraft.IncludeActHeadings" @bind:after="ScheduleEditionAutosave" />
                                <span><strong>Show act headings</strong></span>
                            </label>
                            <label class="publish-toggle publish-dependent @(!_editionDraft.IncludeActHeadings ? "is-disabled" : null)">
                                <input class="form-check-input" type="checkbox" disabled="@(!_editionDraft.IncludeActHeadings)"
                                       @bind="_editionDraft.NumberActs" @bind:after="ScheduleEditionAutosave" />
                                <span><strong>Number acts</strong></span>
                            </label>
                            <label class="publish-toggle">
                                <input class="form-check-input" type="checkbox"
                                       @bind="_editionDraft.IncludeActSynopses" @bind:after="ScheduleEditionAutosave" />
                                <span><strong>Include act synopses</strong></span>
                            </label>
                        </fieldset>

                        <fieldset class="publish-option-group">
                            <legend>Chapter presentation</legend>
                            <label class="publish-toggle">
                                <input class="form-check-input" type="checkbox"
                                       @bind="_editionDraft.IncludeChapterHeadings" @bind:after="ScheduleEditionAutosave" />
                                <span><strong>Show chapter headings</strong></span>
                            </label>
                            <label class="publish-toggle publish-dependent @(!_editionDraft.IncludeChapterHeadings ? "is-disabled" : null)">
                                <input class="form-check-input" type="checkbox" disabled="@(!_editionDraft.IncludeChapterHeadings)"
                                       @bind="_editionDraft.NumberChapters" @bind:after="ScheduleEditionAutosave" />
                                <span><strong>Number chapters</strong></span>
                            </label>
                            <label class="publish-toggle">
                                <input class="form-check-input" type="checkbox"
                                       @bind="_editionDraft.IncludeChapterSynopses" @bind:after="ScheduleEditionAutosave" />
                                <span><strong>Include chapter synopses</strong></span>
                            </label>
                        </fieldset>

                        <fieldset class="publish-option-group">
                            <legend>Title page</legend>
                            <label class="publish-toggle">
                                <input class="form-check-input" type="checkbox" checked="@IncludeTitlePageEffective"
                                       @onchange="SetTitlePageMode" />
                                <span>
                                    <strong>Include a separate title page</strong>
                                    <small>@TitlePageOptionHelp</small>
                                </span>
                            </label>
                        </fieldset>

                        <fieldset class="publish-option-group publish-option-group-wide">
                            <legend>Page geometry &amp; body type</legend>
                            <div class="publish-form-grid">
                                <label class="publish-field">
                                    <span>Page width (inches)</span>
                                    <input class="form-control" type="number" min="3" max="24" step="0.125"
                                           @bind="_editionDraft.PageWidthInches" @bind:after="ScheduleEditionAutosave" />
                                </label>
                                <label class="publish-field">
                                    <span>Page height (inches)</span>
                                    <input class="form-control" type="number" min="3" max="24" step="0.125"
                                           @bind="_editionDraft.PageHeightInches" @bind:after="ScheduleEditionAutosave" />
                                </label>
                                <label class="publish-field">
                                    <span>Page margin (inches)</span>
                                    <input class="form-control" type="number" min="0.125" max="8" step="0.0625"
                                           @bind="_editionDraft.PageMarginInches" @bind:after="ScheduleEditionAutosave" />
                                </label>
                                <label class="publish-field">
                                    <span>Body type (points)</span>
                                    <input class="form-control" type="number" min="7" max="72" step="0.5"
                                           @bind="_editionDraft.BodyFontSizePoints" @bind:after="ScheduleEditionAutosave" />
                                </label>
                                <label class="publish-field">
                                    <span>Body line height</span>
                                    <input class="form-control" type="number" min="1" max="2.4" step="0.05"
                                           @bind="_editionDraft.BodyLineHeight" @bind:after="ScheduleEditionAutosave" />
                                    <small>A multiplier such as 1.45, not a point value.</small>
                                </label>
                            </div>
                            <small>These values drive editor pagination, snapshots, Picture Page geometry, image guidance, diagnostics, and export rendering.</small>
                        </fieldset>

                        <fieldset class="publish-option-group publish-option-group-wide">
                            <legend>Picture Page spreads</legend>
                            <div class="publish-spread-options">
                                <label class="publish-field">
                                    <span>Print / PDF double spreads</span>
                                    <select class="form-select" @bind="_editionDraft.PrintPicturePageSpreadMode" @bind:after="ScheduleEditionAutosave">
                                        <option value="@PrintPicturePageSpreadMode.WholeSpread">Whole spread unrotated on one normal page</option>
                                        <option value="@PrintPicturePageSpreadMode.SidewaysWholeSpread">Whole spread rotated on one tall page</option>
                                        <option value="@PrintPicturePageSpreadMode.SplitLeaves">Split into separate pages</option>
                                    </select>
                                    <small>Whole-spread modes fit proportionally on the configured portrait page and may include whitespace.</small>
                                </label>
                                <label class="publish-field">
                                    <span>EPUB double spreads</span>
                                    <select class="form-select" @bind="_editionDraft.EpubPicturePageSpreadMode" @bind:after="ScheduleEditionAutosave">
                                        <option value="@EpubPicturePageSpreadMode.RequestLandscape">Whole spread with landscape requested</option>
                                        <option value="@EpubPicturePageSpreadMode.SidewaysPortrait">Whole spread rotated sideways</option>
                                    </select>
                                    <small>Sideways portrait bakes in the rotation so readers can turn the device to view a larger spread.</small>
                                </label>
                            </div>
                        </fieldset>
                    </div>
                </section>

                <section class="publish-card" aria-labelledby="cover-title">
                    <div class="publish-card-heading publish-card-heading-actions">
                        <div>
                            <span class="publish-step">05</span>
                            <h2 id="cover-title">Cover</h2>
                            <p>Use a Picture Page as the first page of the exported book.</p>
                        </div>
                        @if (SelectedCoverCandidate is not null)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@EditorUrl(SelectedCoverCandidate.Id)">Edit picture page</a>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_coverError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@_coverError</div>
                    }

                    @if (_workspace.CoverCandidates.Count == 0)
                    {
                        <div class="publish-empty-state">
                            <div class="publish-empty-icon" aria-hidden="true">▧</div>
                            <div>
                                <h3>Create a Picture Page for your cover</h3>
                                <p>In Outline, create a chapter, then open it in Editor and change its visual mode to Picture page. Design the complete cover there and return here to select it.</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-sm btn-primary" href="@OutlineUrl">Open Outline</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="@EditorRootUrl">Open Editor</a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="publish-cover-grid">
                            <div>
                                <label class="publish-field">
                                    <span>Cover picture page</span>
                                    <select class="form-select" value="@SelectedCoverValue" disabled="@_coverBusy" @onchange="SetCoverChapterAsync">
                                        <option value="">No cover</option>
                                        @foreach (var candidate in _workspace.CoverCandidates)
                                        {
                                            <option value="@candidate.Id.ToString("N")">@candidate.OutlineLabel</option>
                                        }
                                    </select>
                                    <small>The chosen page is exported as the cover only and is omitted from the manuscript body.</small>
                                </label>

                                @if (SelectedCoverCandidate is { } selectedCover)
                                {
                                    <div class="publish-cover-meta">
                                        <span class="publish-badge publish-badge-picture">Picture page</span>
                                        <span class="publish-badge">@PageLayoutLabel(selectedCover.PageLayoutKind)</span>
                                    </div>
                                    @if (IsNonPortraitCover(selectedCover.PageLayoutKind))
                                    {
                                        <div class="publish-advisory" role="status">
                                            <strong>Check the cover shape.</strong>
                                            <span>This @PageLayoutLabel(selectedCover.PageLayoutKind).ToLowerInvariant() layout can be used, but most book covers are single portrait pages.</span>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="publish-cover-preview @(SelectedCoverCandidate is null ? "is-empty" : null)">
                                @if (SelectedCoverCandidate is { } cover)
                                {
                                    <img src="@cover.PreviewUrl" alt="Preview of @cover.Title" />
                                }
                                else
                                {
                                    <div>
                                        <span aria-hidden="true">No cover</span>
                                        <small>Select a Picture Page to preview it here.</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>

                <section class="publish-card" aria-labelledby="outline-title">
                    <div class="publish-card-heading publish-card-heading-actions">
                        <div>
                            <span class="publish-step">06</span>
                            <h2 id="outline-title">Manuscript outline</h2>
                            <p>Select chapter content and optional act divider pages independently.</p>
                        </div>
                        <div class="publish-bulk-actions" aria-label="Bulk outline actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@OutlineBusy" @onclick="() => SetAllOutlineSelectionsAsync(true)">Select all</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@OutlineBusy" @onclick="() => SetAllOutlineSelectionsAsync(false)">Clear all</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_outlineError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@_outlineError</div>
                    }

                    <div class="publish-outline-summary">
                        <strong>@IncludedChapterCount of @SelectableChapterCount chapters included</strong>
                        @if (SelectedCoverCandidate is not null)
                        {
                            <span>The cover is counted separately.</span>
                        }
                    </div>

                    <div class="publish-outline-list">
                        @foreach (var publishSection in _workspace.Sections)
                        {
                            <section class="publish-outline-section" aria-label="@publishSection.Title">
                                <div class="publish-outline-section-header">
                                    <div>
                                        <span class="publish-outline-kicker">@(publishSection.IsUnassigned ? "Ungrouped chapters" : "Act")</span>
                                        <h3>@publishSection.Title</h3>
                                    </div>
                                    @if (publishSection.ActId is Guid actId)
                                    {
                                        <label class="publish-outline-act-toggle">
                                            <input class="form-check-input" type="checkbox" checked="@publishSection.IsIncluded"
                                                   disabled="@OutlineBusy"
                                                   @onchange="e => SetOutlineSelectionAsync(PublishOutlineTargetKind.Act, actId, e)" />
                                            <span>Include act divider page</span>
                                        </label>
                                    }
                                </div>

                                <div class="publish-chapter-list">
                                    @foreach (var chapter in publishSection.Chapters)
                                    {
                                        var isCover = IsCoverChapter(chapter.Id);
                                        <div class="publish-chapter-row @(isCover ? "is-cover" : null)">
                                            <div class="publish-chapter-control">
                                                @if (isCover)
                                                {
                                                    <span class="publish-cover-marker" aria-hidden="true">C</span>
                                                }
                                                else
                                                {
                                                    <input class="form-check-input" type="checkbox" checked="@chapter.IsIncluded"
                                                           aria-label="Include @chapter.Title"
                                                           disabled="@OutlineBusy"
                                                           @onchange="e => SetOutlineSelectionAsync(PublishOutlineTargetKind.Chapter, chapter.Id, e)" />
                                                }
                                            </div>
                                            <div class="publish-chapter-info">
                                                <strong>@chapter.Title</strong>
                                                <div class="publish-chapter-badges">
                                                    <span class="publish-badge @VisualModeBadgeClass(chapter.VisualMode)">@VisualModeLabel(chapter.VisualMode)</span>
                                                    @if (chapter.VisualMode == ChapterVisualMode.PicturePage)
                                                    {
                                                        <span class="publish-badge">@PageLayoutLabel(chapter.PageLayoutKind)</span>
                                                    }
                                                    @if (isCover)
                                                    {
                                                        <span class="publish-badge publish-badge-cover">Cover only</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (isCover)
                                            {
                                                <a class="btn btn-sm btn-link" href="@EditorUrl(chapter.Id)">Edit</a>
                                            }
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </section>

                <section class="publish-card" aria-labelledby="images-title">
                    <div class="publish-card-heading publish-card-heading-actions">
                        <div>
                            <span class="publish-step">07</span>
                            <h2 id="images-title">Interior images</h2>
                            <p>Place project images around included act and chapter content.</p>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(!HasPlacementTargets || _placementActionBusy)" @onclick="OpenAddPlacementAsync">
                            Add image placement
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_placementError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@_placementError</div>
                    }

                    @if (!HasPlacementTargets)
                    {
                        <div class="publish-inline-empty">
                            Include at least one act divider or chapter to add interior images.
                        </div>
                    }
                    else if (_placements.Count == 0)
                    {
                        <div class="publish-inline-empty">
                            No publish-only images have been placed. Picture Page and illustrated chapter images are already included from the Editor.
                        </div>
                    }
                    else
                    {
                        <ol class="publish-placement-list">
                            @foreach (var placement in _placements)
                            {
                                var deleting = _deletingPlacementIds.Contains(placement.Id);
                                <li class="publish-placement-row" @key="placement.Id">
                                    <img src="@placement.AssetPreviewUrl" alt="" loading="lazy" />
                                    <div class="publish-placement-info">
                                        <strong>@placement.AssetFileName</strong>
                                        <span>@HumanizePlacement(placement.PlacementKind) · @placement.TargetTitle</span>
                                        @if (!PlacementIsActive(placement))
                                        {
                                            <span class="publish-placement-inactive">Not exported with the current cover and outline selection</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(placement.Caption))
                                        {
                                            <p>“@placement.Caption”</p>
                                        }
                                    </div>
                                    <div class="publish-placement-actions">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Reorder @placement.AssetFileName">
                                            <button type="button" class="btn btn-outline-secondary" title="Move up"
                                                    aria-label="Move @placement.AssetFileName up"
                                                    disabled="@(!CanMovePlacement(placement, -1) || _placementActionBusy)"
                                                    @onclick="() => MovePlacementAsync(placement, -1)">↑</button>
                                            <button type="button" class="btn btn-outline-secondary" title="Move down"
                                                    aria-label="Move @placement.AssetFileName down"
                                                    disabled="@(!CanMovePlacement(placement, 1) || _placementActionBusy)"
                                                    @onclick="() => MovePlacementAsync(placement, 1)">↓</button>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_placementActionBusy" @onclick="() => OpenEditPlacementAsync(placement)">Edit</button>
                                        @if (_confirmDeletePlacementId == placement.Id)
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" disabled="@deleting" @onclick="() => DeletePlacementAsync(placement.Id)">
                                                @(deleting ? "Deleting…" : "Confirm")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-link" disabled="@deleting" @onclick="CancelPlacementDelete">Cancel</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_placementActionBusy" @onclick="() => ConfirmPlacementDelete(placement.Id)">Delete</button>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>

            <aside class="publish-sidebar" aria-labelledby="summary-title">
                <div class="publish-summary-card">
                    <div class="publish-summary-heading">
                        <span class="publish-eyebrow">Export summary</span>
                        <h2 id="summary-title">@DisplayTitle</h2>
                        @if (!string.IsNullOrWhiteSpace(_editionDraft.Author))
                        {
                            <p>by @_editionDraft.Author</p>
                        }
                    </div>

                    <dl class="publish-summary-stats">
                        <div>
                            <dt>Manuscript</dt>
                            <dd>@IncludedChapterCount chapter@(IncludedChapterCount == 1 ? string.Empty : "s")</dd>
                        </div>
                        <div>
                            <dt>Cover</dt>
                            <dd>@(SelectedCoverCandidate?.Title ?? "Not selected")</dd>
                        </div>
                        <div>
                            <dt>Interior images</dt>
                            <dd>@ActivePlacementCount placement@(ActivePlacementCount == 1 ? string.Empty : "s")</dd>
                        </div>
                    </dl>

                    @if (ReadinessMessages.Count > 0)
                    {
                        <div class="publish-readiness">
                            <h3>Before you export</h3>
                            <ul>
                                @foreach (var message in ReadinessMessages)
                                {
                                    <li>@message</li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="publish-ready-message">
                            <span aria-hidden="true">✓</span>
                            <span>Your publishing setup looks ready.</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_exportError))
                    {
                        <div class="alert alert-danger py-2 small" role="alert">@_exportError</div>
                    }

                    <div class="publish-export-actions" aria-label="Export formats">
                        <button type="button" class="btn btn-primary" disabled="@(!CanExport)" @onclick="() => ExportAsync(PublishExportFormat.Epub)">
                            <span>EPUB</span>
                            <small>@ExportButtonDetail(PublishExportFormat.Epub, "For e-readers")</small>
                        </button>
                        <button type="button" class="btn btn-outline-primary" disabled="@(!CanExport)" @onclick="() => ExportAsync(PublishExportFormat.Markdown)">
                            <span>Markdown</span>
                            <small>@ExportButtonDetail(PublishExportFormat.Markdown, "With linked images")</small>
                        </button>
                        <button type="button" class="btn btn-outline-primary" disabled="@(!CanExport)" @onclick="() => ExportAsync(PublishExportFormat.PlainText)">
                            <span>Plain text</span>
                            <small>@ExportButtonDetail(PublishExportFormat.PlainText, "Text only")</small>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@(!CanPrint)"
                                @ref="_publishPreviewButtonElement" @onclick="() => OpenPrintAsync(autoprint: false)">
                            <span>Publish preview</span>
                            <small>@(_printing ? "Opening…" : "Review the finished layout")</small>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@(!CanPrint)"
                                @ref="_printPdfButtonElement" @onclick="() => OpenPrintAsync(autoprint: true)">
                            <span>Print / PDF</span>
                            <small>@(_printing ? "Opening…" : "Browser print layout")</small>
                        </button>
                    </div>

                    @if (!CanExport && !_exportingFormat.HasValue && !_printing)
                    {
                        <p class="publish-export-note">@ExportBlockedMessage</p>
                    }
                </div>
            </aside>
        </div>

        <div class="visually-hidden" aria-live="polite" aria-atomic="true">@_liveMessage</div>
    </main>

    @if (_placementDialogOpen)
    {
        <div class="publish-modal-backdrop" aria-hidden="true"></div>
        <div class="publish-modal-shell" role="presentation" @onkeydown="HandlePlacementDialogKeyDown">
            <section class="publish-modal" role="dialog" aria-modal="true" aria-labelledby="placement-dialog-title" tabindex="-1" @ref="_placementDialogElement">
                <header class="publish-modal-header">
                    <div>
                        <span class="publish-eyebrow">Interior image</span>
                        <h2 id="placement-dialog-title">@(_editingPlacementId is null ? "Add image placement" : "Edit image placement")</h2>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_placementSaving" @onclick="ClosePlacementDialog"></button>
                </header>

                <div class="publish-modal-body">
                    @if (!string.IsNullOrWhiteSpace(_placementDialogError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@_placementDialogError</div>
                    }

                    <div class="publish-dialog-step">
                        <span class="publish-dialog-step-number">1</span>
                        <div>
                            <label class="publish-field">
                                <span>Choose a target</span>
                                <select class="form-select" value="@_placementTargetKey" disabled="@_placementSaving" @onchange="PlacementTargetChanged">
                                    <option value="">Select an included act or chapter</option>
                                    @foreach (var target in PlacementTargets)
                                    {
                                        <option value="@TargetKey(target.Kind, target.Id)">@target.Label</option>
                                    }
                                </select>
                            </label>
                        </div>
                    </div>

                    @if (HasSelectedPlacementTarget)
                    {
                        <div class="publish-dialog-step">
                            <span class="publish-dialog-step-number">2</span>
                            <div>
                                <label class="publish-field">
                                    <span>Choose a position</span>
                                    <select class="form-select" @bind="_placementKind" disabled="@_placementSaving">
                                        @foreach (var position in ValidPlacementKinds)
                                        {
                                            <option value="@position">@HumanizePlacement(position)</option>
                                        }
                                    </select>
                                </label>
                            </div>
                        </div>

                        <div class="publish-dialog-step">
                            <span class="publish-dialog-step-number">3</span>
                            <div>
                                <div class="publish-image-picker-heading">
                                    <label class="publish-field">
                                        <span>Choose an image</span>
                                        <input class="form-control" type="search" placeholder="Search project images" autocomplete="off"
                                               @bind="_imageSearch" @bind:event="oninput" disabled="@_imagesLoading" />
                                    </label>
                                    <a class="btn btn-sm btn-link" href="@ImagesUrl">Manage images</a>
                                </div>

                                @if (_imagesLoading)
                                {
                                    <div class="publish-image-loading" role="status">
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Loading project images…</span>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_imagesLoadError))
                                {
                                    <div class="publish-inline-error" role="alert">
                                        <span>@_imagesLoadError</span>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LoadPlacementImagesAsync">Retry</button>
                                    </div>
                                }
                                else if (FilteredImages.Count == 0)
                                {
                                    <div class="publish-inline-empty">
                                        @(_projectImageLibrary.Count == 0 ? "This project has no images yet." : "No images match your search.")
                                    </div>
                                }
                                else
                                {
                                    <div class="publish-image-grid" role="listbox" aria-label="Project images">
                                        @foreach (var image in FilteredImages)
                                        {
                                            var selected = _placementAssetId == image.Id;
                                            <button type="button" class="publish-image-option @(selected ? "is-selected" : null)"
                                                    role="option" aria-selected="@selected" disabled="@_placementSaving"
                                                    @onclick="() => SelectPlacementImage(image.Id)">
                                                <img src="@image.PreviewUrl" alt="" loading="lazy" />
                                                <span>@image.FileName</span>
                                                @if (selected)
                                                {
                                                    <strong aria-hidden="true">✓</strong>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="publish-dialog-step">
                            <span class="publish-dialog-step-number">4</span>
                            <div>
                                <label class="publish-field">
                                    <span>Caption <em>Optional</em></span>
                                    <textarea class="form-control" data-autosize data-autosize-resize="vertical" rows="2"
                                              placeholder="A caption displayed with this image"
                                              @bind="_placementCaption" @bind:event="oninput" disabled="@_placementSaving"></textarea>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <footer class="publish-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_placementSaving" @onclick="ClosePlacementDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@(!CanSavePlacement)" @onclick="SavePlacementAsync">
                        @(_placementSaving ? "Saving…" : _editingPlacementId is null ? "Add placement" : "Save changes")
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_printDialogOpen)
    {
        <div class="publish-modal-backdrop" aria-hidden="true"></div>
        <div class="publish-modal-shell publish-print-modal-shell" role="presentation" @onkeydown="HandlePrintDialogKeyDown">
            <section class="publish-modal publish-print-modal" role="dialog" aria-modal="true"
                     aria-labelledby="print-dialog-title" tabindex="-1" @ref="_printDialogElement">
                <header class="publish-modal-header">
                    <div>
                        <span class="publish-eyebrow">Finished layout</span>
                        <h2 id="print-dialog-title">Publish preview</h2>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close publish preview" @onclick="ClosePrintDialogAsync"></button>
                </header>

                <div class="publish-print-modal-body" aria-busy="@(_printDialogLoading ? "true" : "false")">
                    @if (_printDialogLoading)
                    {
                        <div class="publish-print-loading" role="status">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>Preparing publish preview...</span>
                        </div>
                    }
                    <iframe class="publish-print-frame" src="@_printDialogUrl" title="Publish preview"
                            @onload="PrintDialogLoaded"></iframe>
                </div>
            </section>
        </div>
    }
}

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private static readonly TimeSpan EditionAutosaveDelay = TimeSpan.FromMilliseconds(900);

    private readonly SemaphoreSlim _editionSaveGate = new(1, 1);
    private readonly HashSet<Guid> _deletingPlacementIds = [];
    private PublishWorkspaceView? _workspace;
    private IReadOnlyList<PublicationEditionSummary> _editionSummaries = [];
    private IReadOnlyList<PublicationImagePlacementView> _placements = [];
    private IReadOnlyList<ProjectImageView> _projectImageLibrary = [];
    private IReadOnlyList<ManuscriptStyleView> _namedStyles = [];
    private IReadOnlyList<PublicationEditionAuditView> _editionAudit = [];
    private EditionDraft _editionDraft = new();
    private Guid? _loadedProjectId;
    private Guid? _selectedEditionId;
    private Guid? _editingPlacementId;
    private Guid? _editingMatterId;
    private Guid? _placementAssetId;
    private Guid? _confirmDeletePlacementId;
    private bool _loading;
    private bool _coverBusy;
    private bool _outlineBusy;
    private bool _placementDialogOpen;
    private bool _printDialogOpen;
    private bool _printDialogLoading;
    private bool _imagesLoading;
    private bool _placementSaving;
    private bool _placementActionBusy;
    private bool _printing;
    private bool _disposing;
    private bool _creatingEdition;
    private bool _assistantBusy;
    private string? _loadError;
    private string? _editionDraftError;
    private string? _coverError;
    private string? _outlineError;
    private string? _placementError;
    private string? _placementDialogError;
    private string? _imagesLoadError;
    private string? _exportError;
    private string? _editionActionError;
    private string _newEditionName = "Paperback";
    private PublicationEditionFormat _newEditionFormat = PublicationEditionFormat.Paperback;
    private string _printDialogUrl = string.Empty;
    private string _placementTargetKey = string.Empty;
    private string _placementCaption = string.Empty;
    private string _imageSearch = string.Empty;
    private string _assistantPrompt = string.Empty;
    private string _assistantResponse = string.Empty;
    private string _styleMappingStyleId = string.Empty;
    private double? _styleFontSize;
    private double? _styleLineHeight;
    private string _matterTitle = string.Empty;
    private string _matterJson = string.Empty;
    private PublicationMatterLocation _matterLocation;
    private PublicationMatterKind _matterKind;
    private int _matterSortOrder;
    private bool _matterIncluded;
    private string _liveMessage = string.Empty;
    private PublicationImagePlacementKind _placementKind = PublicationImagePlacementKind.ChapterOpening;
    private PublishExportFormat? _exportingFormat;
    private ElementReference _placementDialogElement;
    private ElementReference _printDialogElement;
    private ElementReference _publishPreviewButtonElement;
    private ElementReference _printPdfButtonElement;
    private ElementReference _printDialogReturnFocusElement;
    private IJSObjectReference? _downloadModule;
    private IJSObjectReference? _autoSizer;
    private CancellationTokenSource? _editionDraftAutosaveCts;
    private IDisposable? _navHandlerRegistration;
    private long _editionDraftVersion;
    private long _editionSavedVersion;
    private SaveState _editionSaveState = SaveState.Idle;
    private DateTime? _editionDraftLastSavedAt;
    private bool _focusPlacementDialog;
    private bool _focusPrintDialog;

    private bool EditionSaveInProgress => _editionSaveState == SaveState.Saving;
    private bool HasPendingEditionSave => _editionSavedVersion != _editionDraftVersion;
    private bool OutlineBusy => _outlineBusy || _coverBusy;
    private bool HasSelectedPlacementTarget => TryParseTargetKey(_placementTargetKey, out var kind, out var id)
        && PlacementTargets.Any(target => target.Kind == kind && target.Id == id);
    private bool CanSavePlacement => !_placementSaving
        && HasSelectedPlacementTarget
        && _placementAssetId is not null
        && ValidPlacementKinds.Contains(_placementKind);
    private bool HasPlacementTargets => PlacementTargets.Count > 0;
    private bool HasBusyMutation => _coverBusy || _outlineBusy || _placementActionBusy || _placementSaving;
    private bool CanExport => _downloadModule is not null
        && _exportingFormat is null
        && !_printing
        && !HasBusyMutation
        && _editionSaveState is not SaveState.Dirty and not SaveState.Saving and not SaveState.SaveFailed
        && !HasPendingEditionSave;
    private bool CanPrint => _exportingFormat is null
        && !_printing
        && !HasBusyMutation
        && _editionSaveState is not SaveState.Dirty and not SaveState.Saving and not SaveState.SaveFailed
        && !HasPendingEditionSave;

    private string DisplayTitle => string.IsNullOrWhiteSpace(_editionDraft.TitleOverride)
        ? _workspace?.Edition.ProjectName ?? Project?.Name ?? "Untitled book"
        : _editionDraft.TitleOverride.Trim();

    private bool IncludeTitlePageEffective => _editionDraft.TitlePageMode switch
    {
        PublishTitlePageMode.Include => true,
        PublishTitlePageMode.Omit => false,
        _ => _workspace?.Edition.SelectedCoverChapterId is null,
    };

    private string TitlePageOptionHelp => _editionDraft.TitlePageMode switch
    {
        PublishTitlePageMode.Automatic when _workspace?.Edition.SelectedCoverChapterId is not null =>
            "Automatically omitted because a cover is selected. Changing this saves an explicit choice.",
        PublishTitlePageMode.Automatic =>
            "Automatically included because no cover is selected. Changing this saves an explicit choice.",
        _ => "This explicit choice is kept when the cover changes.",
    };

    private string SelectedCoverValue => _workspace?.Edition.SelectedCoverChapterId?.ToString("N") ?? string.Empty;

    private PublishCoverCandidateView? SelectedCoverCandidate =>
        _workspace?.Edition.SelectedCoverChapterId is Guid coverId
            ? _workspace.CoverCandidates.FirstOrDefault(candidate => candidate.Id == coverId)
            : null;

    private int IncludedChapterCount => _workspace?.Sections
        .SelectMany(section => section.Chapters)
        .Count(chapter => chapter.IsIncluded && !IsCoverChapter(chapter.Id)) ?? 0;

    private int SelectableChapterCount => _workspace?.Sections
        .SelectMany(section => section.Chapters)
        .Count(chapter => !IsCoverChapter(chapter.Id)) ?? 0;

    private int ActivePlacementCount => _placements.Count(PlacementIsActive);

    private IReadOnlyList<string> ReadinessMessages
    {
        get
        {
            var messages = new List<string>();
            if (IncludedChapterCount == 0)
                messages.Add("Include at least one manuscript chapter.");
            if (SelectedCoverCandidate is null)
                messages.Add("No cover is selected. Exports can still be created without one.");
            if (string.IsNullOrWhiteSpace(_editionDraft.Author))
                messages.Add("Add an author name if this is a reader-facing edition.");
            return messages;
        }
    }

    private IReadOnlyList<PlacementTarget> PlacementTargets
    {
        get
        {
            if (_workspace is null) return [];
            var targets = new List<PlacementTarget>();
            foreach (var section in _workspace.Sections)
            {
                if (section.ActId is Guid actId && section.IsIncluded)
                    targets.Add(new(PublishOutlineTargetKind.Act, actId, $"Act: {section.Title}"));

                targets.AddRange(section.Chapters
                    .Where(chapter => chapter.IsIncluded && !IsCoverChapter(chapter.Id))
                    .Select(chapter => new PlacementTarget(PublishOutlineTargetKind.Chapter, chapter.Id, $"Chapter: {chapter.Title}")));
            }
            return targets;
        }
    }

    private IReadOnlyList<PublicationImagePlacementKind> ValidPlacementKinds
    {
        get
        {
            if (!TryParseTargetKey(_placementTargetKey, out var kind, out _)) return [];
            return kind == PublishOutlineTargetKind.Act
                ? [PublicationImagePlacementKind.BeforeAct, PublicationImagePlacementKind.AfterAct]
                : [
                    PublicationImagePlacementKind.BeforeChapter,
                    PublicationImagePlacementKind.ChapterOpening,
                    PublicationImagePlacementKind.ChapterEnding,
                    PublicationImagePlacementKind.AfterChapter,
                ];
        }
    }

    private IReadOnlyList<ProjectImageView> FilteredImages
    {
        get
        {
            var search = _imageSearch.Trim();
            if (search.Length == 0) return _projectImageLibrary;
            return _projectImageLibrary.Where(image =>
                image.FileName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || image.AltText.Contains(search, StringComparison.OrdinalIgnoreCase)
                || image.Prompt.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

