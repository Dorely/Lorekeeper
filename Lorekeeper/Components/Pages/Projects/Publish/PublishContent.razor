@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Manuscripts
@using Lorekeeper.Composition
@implements IAsyncDisposable
@inject IPublishService Publishing
@inject IPublicationBookService Books
@inject IPublicationSectionService PublicationSections
@inject IPublicationEditionService Releases
@inject IEditionContentService EditionContent
@inject IPublicationCoverService Covers
@inject IPublicationPreparationService Preparation
@inject IPublicationDiagnosticPresentationService DiagnosticPresentation
@inject IPublicationRenderService Renders
@inject IProjectPageSetupService PageSetups
@inject IPrintProductRegistry PrintProducts
@inject IPrintGeometryService PrintGeometry
@inject IJSRuntime JS

@if (Project is null || _loading)
{
    <div class="publish-loading" role="status"><span class="spinner-border spinner-border-sm"></span> Loading Publish…</div>
}
else
{
    <main class="publish-workspace" aria-label="Publish">
        <div class="publish-layout">
            <aside class="publish-assistant-pane" aria-label="Publish assistant">
                @if (!_assistantMounted)
                {
                    <div class="publish-pane-loading" role="status"><span class="spinner-border spinner-border-sm"></span><span>Loading publishing workspace...</span></div>
                }
                else
                {
                    <PublishChatPanel ProjectId="Project.Id"
                                      SelectedEditionId="_assistantSelectedReleaseId"
                                      WorkspaceContext="@AssistantWorkspaceContext()"
                                      WorkspaceRefreshing="_targetLoading"
                                      PrepareTurnAsync="PrepareAssistantTurnAsync"
                                      OnRunningChanged="HandleAssistantRunningChangedAsync"
                                      OnWorkspaceMutated="HandleAssistantMutationAsync" />
                }
            </aside>

            <section class="publish-main">
                <nav class="publish-target-nav" aria-label="Book and publication releases">
                    <button class="target-chip @(_selectedReleaseId is null ? "selected" : null)" disabled="@(_targetLoading || _assistantRunning)" @onclick="SelectCoreAsync">
                        <span>Core Book</span><small>Shared book</small>
                    </button>
                    @foreach (var release in _releases.Where(item => item.Status != PublicationEditionStatus.Archived))
                    {
                        <button class="target-chip @(_selectedReleaseId == release.Id ? "selected" : null)" disabled="@(_targetLoading || _assistantRunning)" @onclick="() => SelectReleaseAsync(release.Id)">
                            <span>@release.Name</span><small>@ReleaseTypeLabel(release.Format)</small>
                        </button>
                    }
                    <button class="target-chip add" disabled="@(_targetLoading || _assistantRunning)" @onclick="OpenAddRelease"><span>＋ Add release</span><small>Print or ebook</small></button>
                </nav>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                @if (!string.IsNullOrWhiteSpace(_notice))
                {
                    <div class="publish-notice" role="status">@_notice</div>
                }

                <div class="publish-scroll @((_coverEditorOpen || _editingSection is not null) ? "publish-scroll--editor" : null)">
                    @if (_editingSection is not null && Project is not null)
                    {
                        @PublicationSectionEditorView()
                    }
                    else if (_coverEditorOpen && Project is not null)
                    {
                        <CoverCompositionWorkspace @ref="_coverWorkspace"
                                                   ProjectId="Project.Id"
                                                   EditionId="_selectedReleaseId ?? Guid.Empty"
                                                   CoreBook="@(_selectedReleaseId is null)"
                                                   RefreshSignal="_coverRefreshSignal"
                                                   RequestedSelectionId="_coverSelectionId"
                                                   InteractionLocked="_assistantRunning"
                                                   Saved="HandleCoverSavedAsync"
                                                   Back="CloseCoverEditorAsync" />
                    }
                    else if (_selectedReleaseId is null && _core is not null)
                    {
                        <fieldset class="publish-target-content" disabled="@(_targetLoading || _assistantRunning)">@CoreBookView()</fieldset>
                    }
                    else if (_workspace is not null)
                    {
                        <fieldset class="publish-target-content" disabled="@(_targetLoading || _assistantRunning)">@ReleaseView()</fieldset>
                    }
                    else if (_targetLoading)
                    {
                        <div class="publish-target-loading" role="status"><span class="spinner-border spinner-border-sm"></span><span>Loading release settings...</span></div>
                    }
                </div>
            </section>
        </div>
    </main>
}

@if (_addReleaseOpen)
{
    <div class="publish-modal-backdrop" role="presentation" @onclick="CloseAddRelease">
        <section class="publish-modal" role="dialog" aria-modal="true" aria-labelledby="add-release-title" @onclick:stopPropagation="true">
            <header><div><span class="eyebrow">Publication release</span><h2 id="add-release-title">What are you preparing?</h2></div><button class="btn-close" aria-label="Close" @onclick="CloseAddRelease"></button></header>
            <div class="release-cards">
                <button class="release-card @(_newFormat == PublicationEditionFormat.Paperback ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.Paperback)"><strong>Paperback</strong><span>Printer-ready interior, full-wrap cover, and package.</span></button>
                <button class="release-card @(_newFormat == PublicationEditionFormat.Hardcover ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.Hardcover)"><strong>Hardcover</strong><span>Case laminate, Digital Cloth, or jacketed production files.</span></button>
                <button class="release-card @(_newFormat == PublicationEditionFormat.Epub ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.Epub)"><strong>EPUB ebook</strong><span>Accessible EPUB 3 for ebook stores and readers.</span></button>
                <button class="release-card @(_newFormat == PublicationEditionFormat.DigitalPdf ? "selected" : null)" @onclick="() => ChooseFormat(PublicationEditionFormat.DigitalPdf)"><strong>PDF ebook</strong><span>Tagged cover-plus-book PDF for digital distribution.</span></button>
            </div>
            <label class="field"><span>Release name</span><input class="form-control" value="@_newReleaseName" @oninput="HandleNewReleaseNameInput" /><small>Defaults to the selected publishing profile. Matching names are numbered automatically.</small></label>
            @if (_newFormat is PublicationEditionFormat.Paperback or PublicationEditionFormat.Hardcover)
            {
                <label class="field"><span>Printer or service</span><select class="form-select" @bind="_newVendor" @bind:after="HandleNewReleaseProfileChanged"><option value="@PublicationVendor.AmazonKdp">Amazon KDP</option><option value="@PublicationVendor.IngramSpark">IngramSpark</option><option value="@PublicationVendor.Generic">Other printer</option></select></label>
                <label class="field"><span>Print product</span><select @key="(_newFormat, _newVendor)" class="form-select" @bind="_newPrintProductKey" @bind:after="NewPrintProductChanged">@foreach (var product in CompatiblePrintProducts(_newFormat, _newVendor)){<option value="@product.Key">@product.DisplayName</option>}</select><small>@NewPrintProductDescription()</small></label>
                @if (NewPrintProduct() is { TrimSizes.Count: > 0 } trimProduct)
                {
                    <label class="field"><span>Trim size</span><select @key="_newPrintProductKey" class="form-select" @bind="_newPrintTrim">@foreach (var trim in trimProduct.TrimSizes){<option value="@trim">@(trim.Replace("x", " x ")) in</option>}</select></label>
                }
                @if (NewPrintProduct() is { } configuredProduct)
                {
                    <label class="field"><span>Finish</span><select class="form-select" @bind="_newPrintFinish">@foreach (var finish in configuredProduct.Finishes){<option value="@finish">@finish</option>}</select></label>
                    @if (configuredProduct.CoverModes.Count > 1)
                    {
                        <label class="field"><span>Cover printing</span><select class="form-select" @bind="_newPrintCoverMode">@foreach (var mode in configuredProduct.CoverModes){<option value="@mode">@(mode == PrintCoverMode.Duplex ? "Outside and inside" : "Outside only")</option>}</select></label>
                    }
                }
            }
            @if (!string.IsNullOrWhiteSpace(_addReleaseError))
            {
                <div class="alert alert-danger" role="alert">@_addReleaseError</div>
            }
            <footer><button class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseAddRelease">Cancel</button><button class="btn btn-primary" disabled="@_busy" @onclick="CreateReleaseAsync">@(_busy ? "Creating…" : "Create release")</button></footer>
        </section>
    </div>
}

@if (_previewArtifact is { } previewArtifact && Project is not null)
{
    <div class="publish-modal-backdrop" role="presentation" @onclick="ClosePdfPreview">
        <section class="publish-modal pdf-preview-modal" role="dialog" aria-modal="true" aria-labelledby="artifact-preview-title" @onclick:stopPropagation="true">
            <header>
                <div><span class="eyebrow">Prepared artifact</span><h2 id="artifact-preview-title">@PreviewLabel(previewArtifact.Kind)</h2><small>@previewArtifact.FileName · @FormatBytes(previewArtifact.ByteLength)@if (previewArtifact.PageCount is int pages){<text> · @pages pages</text>}</small></div>
                <div class="button-row">
                    <a class="btn btn-sm btn-outline-primary" href="@DownloadUrl(previewArtifact.Id)" download="@previewArtifact.FileName">@DownloadLabel(previewArtifact.Kind)</a>
                    <button class="btn-close" aria-label="Close artifact preview" @onclick="ClosePdfPreview"></button>
                </div>
            </header>
            @if (previewArtifact.MediaType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                <div class="artifact-image-preview"><img src="@ViewUrl(previewArtifact.Id)" alt="@PreviewLabel(previewArtifact.Kind)" /></div>
            }
            else if (previewArtifact.Kind == PublicationArtifactKind.Epub)
            {
                <PublicationEpubPreview @key="previewArtifact.Id"
                                        ProjectId="Project.Id"
                                        ArtifactId="previewArtifact.Id" />
            }
            else
            {
                <PublicationPdfPreview @key="previewArtifact.Id"
                                       ProjectId="Project.Id"
                                       ArtifactId="previewArtifact.Id"
                                       PageCount="@(previewArtifact.PageCount ?? 0)" />
            }
        </section>
    </div>
}

@if (Project is not null)
{
    <BookTextStylesModal ProjectId="Project.Id"
                         IsOpen="_bookTextStylesModalOpen"
                         RefreshSignal="_bookTextStylesRefreshSignal"
                         BeforeChange="FlushBeforeBookStyleChangeAsync"
                         Changed="HandleBookTextStylesChangedAsync"
                         OnClose="CloseBookTextStylesModal" />

    <ProjectImageLibraryPickerModal ProjectId="Project.Id"
                                    IsOpen="_publicationSectionImageModalOpen"
                                    Title="Choose a publication-section image"
                                    PrimaryActionLabel="Use image"
                                    PrimaryActionEnabled="@(_publicationSectionEditor is not null)"
                                    OnClose="ClosePublicationSectionImageModal"
                                    OnPrimaryAction="SelectPublicationSectionImageAsync" />
}

<ConfirmationDialog IsOpen="_disableEditionContentConfirmationOpen"
                    Title="Disable edition-specific content?"
                    Message="This permanently discards every edition chapter copy, edition-only Designed Page, and pending edition review. Saved Book Text Styles and project images are kept."
                    ConfirmLabel="Disable and discard"
                    Destructive="true"
                    Busy="_editionContentBusy"
                    OnConfirm="ConfirmDisableEditionContentAsync"
                    OnCancel="CancelDisableEditionContent" />

<ConfirmationDialog IsOpen="@(_pendingSectionRemoval is not null)"
                    Title="@(_pendingSectionReset ? "Use the Core Book section?" : "Remove this publication section?")"
                    Message="@SectionRemovalMessage()"
                    ConfirmLabel="@(_pendingSectionReset ? "Use Core Book" : "Remove section")"
                    Destructive="true"
                    Busy="_sectionRemovalBusy"
                    OnConfirm="ConfirmSectionRemovalAsync"
                    OnCancel="CancelSectionRemoval" />

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private PublicationBookView? _core;
    private PublishWorkspaceView? _workspace;
    private IReadOnlyList<PublicationEditionSummary> _releases = [];
    private IReadOnlyList<PublicationPreparationJobView> _preparations = [];
    private IReadOnlyList<PublicationDiagnosticPresentation> _preparationDiagnostics = [];
    private IReadOnlyList<PublicationArtifactView> _artifacts = [];
    private IReadOnlyList<PublicationBookOutlineView> _coreOutline = [];
    private IReadOnlyList<PublicationSectionView> _publicationSections = [];
    private PublicationSectionView? _editingSection;
    private ChapterBodyEditor? _publicationSectionEditor;
    private DesignedPageWorkspace? _sectionPageWorkspace;
    private bool _sectionSettingsOpen;
    private bool _publicationSectionImageModalOpen;
    private Guid? _selectedSectionCompositionId;
    private Guid? _selectedSectionVariantId;
    private long? _selectedSectionVariantRevision;
    private int _sectionPageRefreshSignal;
    private Guid? _sectionPageSelectionId;
    private string _sectionTitle = string.Empty;
    private PublicationSectionKind _sectionKind = PublicationSectionKind.Custom;
    private PublicationSectionAnchor _sectionAnchor = PublicationSectionAnchor.Back;
    private PublishOutlineTargetKind? _sectionTargetKind;
    private Guid? _sectionTargetId;
    private PublicationSectionInclusionMode _sectionInclusion = PublicationSectionInclusionMode.Automatic;
    private PublicationSectionStartSide _sectionStartSide = PublicationSectionStartSide.Next;
    private Dictionary<(PublishOutlineTargetKind Kind, Guid Id), bool> _coreSelections = [];
    private CoreDraft _coreDraft = new();
    private ReleaseDraft _releaseDraft = new();
    private HashSet<PublicationEditionOverrideField> _releaseOverrides = [];
    private HashSet<PublicationEditionOverrideField> _loadedOverrides = [];
    private Dictionary<Guid, bool> _releaseSelections = [];
    private Dictionary<Guid, bool> _loadedReleaseSelections = [];
    private Guid? _loadedProjectId;
    private Guid? _selectedReleaseId;
    private Guid? _assistantSelectedReleaseId;
    private bool _loading = true;
    private bool _targetLoading = true;
    private bool _targetLoadPending;
    private bool _targetLoadRunning;
    private bool _assistantMounted;
    private bool _assistantRunning;
    private bool _refreshCoreSummaryOnTargetLoad;
    private bool _coreDetailsLoaded;
    private bool _outputsLoaded;
    private bool _busy;
    private bool _addReleaseOpen;
    private bool _coverEditorOpen;
    private bool _bookTextStylesModalOpen;
    private long _bookTextStylesRefreshSignal;
    private CoverCompositionWorkspace? _coverWorkspace;
    private long _coverRefreshSignal;
    private Guid? _coverSelectionId;
    private PublicationArtifactView? _previewArtifact;
    private bool _coreDirty;
    private bool _coreOutlineDirty;
    private bool _pageSetupDirty;
    private double _pageWidthInches = 6;
    private double _pageHeightInches = 9;
    private double _pageMarginInches = .75;
    private double _bodyFontSizePoints = 12;
    private double _bodyLineHeight = 1.55;
    private bool _releaseDirty;
    private bool _releaseContentDirty;
    private bool _releaseDesignOpen;
    private IReadOnlyList<EditionChapterDifference> _editionDifferences = [];
    private bool _editionContentBusy;
    private bool _disableEditionContentConfirmationOpen;
    private Guid? _pendingDisableEditionContentId;
    private PublicationSectionView? _pendingSectionRemoval;
    private bool _pendingSectionReset;
    private bool _sectionRemovalBusy;
    private string? _error;
    private string? _notice;
    private string? _addReleaseError;
    private PublicationEditionFormat _newFormat = PublicationEditionFormat.Paperback;
    private PublicationVendor _newVendor = PublicationVendor.AmazonKdp;
    private string _newPrintProductKey = "kdp-pb-bw-white";
    private string _newPrintTrim = "6x9";
    private PrintFinish _newPrintFinish = PrintFinish.Matte;
    private PrintCoverMode _newPrintCoverMode = PrintCoverMode.Simplex;
    private string _newReleaseName = PublicationReleaseNaming.DefaultName(
        PublicationEditionFormat.Paperback,
        PublicationVendor.AmazonKdp);
    private bool _newReleaseNameCustomized;
    private IJSObjectReference? _downloads;
    private readonly CancellationTokenSource _dispose = new();
    private CancellationTokenSource? _formAutosave;
    private readonly SemaphoreSlim _formSaveGate = new(1, 1);
    private long _formChangeVersion;
    private int _pollGeneration;
    private int _targetLoadGeneration;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null || _loadedProjectId == Project.Id) return;
        _loadedProjectId = Project.Id;
        await LoadCoreAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_targetLoadPending || _targetLoadRunning || Project is null)
            return;
        _targetLoadRunning = true;
        try
        {
            while (_targetLoadPending && !_dispose.IsCancellationRequested)
            {
                _targetLoadPending = false;
                var generation = _targetLoadGeneration;
                try
                {
                    if (_selectedReleaseId is Guid releaseId)
                        await LoadReleaseTargetAsync(releaseId, generation);
                    else
                        await LoadCoreTargetAsync(generation);
                }
                catch (OperationCanceledException) when (_dispose.IsCancellationRequested || generation != _targetLoadGeneration)
                {
                }
                catch (Exception exception)
                {
                    if (generation == _targetLoadGeneration)
                        _error = exception.Message;
                }

                if (generation == _targetLoadGeneration && !_targetLoadPending)
                {
                    _assistantSelectedReleaseId = _selectedReleaseId;
                    _assistantMounted = true;
                    _targetLoading = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _targetLoadRunning = false;
        }
    }

    private async Task LoadCoreAsync()
    {
        if (Project is null) return;
        _previewArtifact = null;
        var initialLoad = _core is null;
        _loading = initialLoad;
        _targetLoading = true;
        _targetLoadPending = false;
        _targetLoadGeneration++;
        _error = null;
        try
        {
            _core = await Books.GetOrCreateAsync(Project.Id);
            _releases = await Releases.ListAsync(Project.Id);
            _coreDraft = CoreDraft.From(_core);
            CopyPageSetupDraft();
            _coreDirty = false;
            _coreOutlineDirty = false;
            _pageSetupDirty = false;
            _coreOutline = [];
            _publicationSections = [];
            _editingSection = null;
            _coreSelections = [];
            _coreDetailsLoaded = false;
            _outputsLoaded = false;
            _preparations = [];
            _preparationDiagnostics = [];
            _artifacts = [];
            _selectedReleaseId = null;
            _workspace = null;
            _refreshCoreSummaryOnTargetLoad = false;
            _targetLoadPending = true;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally
        {
            _loading = false;
            if (_error is not null)
            {
                _targetLoading = false;
                _assistantSelectedReleaseId = null;
                _assistantMounted = true;
            }
        }
    }

    private async Task SelectCoreAsync()
    {
        var keepCoverOpen = _coverEditorOpen;
        await SavePendingAsync();
        await LoadCoreAsync();
        _coverEditorOpen = keepCoverOpen;
    }

    private async Task SelectReleaseAsync(Guid id)
    {
        if (Project is null) return;
        var keepCoverOpen = _coverEditorOpen;
        await SavePendingAsync();
        _previewArtifact = null;
        _selectedReleaseId = id;
        _workspace = null;
        _preparations = [];
        _preparationDiagnostics = [];
        _artifacts = [];
        _outputsLoaded = false;
        _targetLoading = true;
        _targetLoadPending = true;
        _targetLoadGeneration++;
        _error = null;
        _coverEditorOpen = keepCoverOpen;
    }

    private async Task LoadCoreTargetAsync(int generation)
    {
        if (Project is null || generation != _targetLoadGeneration)
            return;
        if (_refreshCoreSummaryOnTargetLoad)
        {
            _core = await Books.GetOrCreateAsync(Project.Id, _dispose.Token);
            _releases = await Releases.ListAsync(Project.Id, _dispose.Token);
            _coreDraft = CoreDraft.From(_core);
            CopyPageSetupDraft();
            _coreDirty = false;
            _pageSetupDirty = false;
            _refreshCoreSummaryOnTargetLoad = false;
        }
        var details = await Books.GetDetailsAsync(Project.Id, _dispose.Token);
        if (generation != _targetLoadGeneration)
            return;
        _coreOutline = details.Outline;
        _publicationSections = await PublicationSections.ListAsync(new(Project.Id), _dispose.Token);
        _coreSelections = _coreOutline.ToDictionary(item => (item.TargetKind, item.TargetId), item => item.IsIncluded);
        _coreDetailsLoaded = true;
        await InvokeAsync(StateHasChanged);

        await ReloadPreparationsAsync(PublicationTargetKind.CoreBook, null);
        var jobs = await Renders.ListCoreAsync(Project.Id, _dispose.Token);
        if (generation != _targetLoadGeneration)
            return;
        _artifacts = jobs.SelectMany(item => item.Artifacts).OrderByDescending(item => item.CreatedAt).ToList();
        _outputsLoaded = true;
        ResumeActivePreparation(PublicationTargetKind.CoreBook, null);
    }

    private async Task LoadReleaseTargetAsync(Guid releaseId, int generation)
    {
        if (Project is null || generation != _targetLoadGeneration)
            return;
        _workspace = await Publishing.GetWorkspaceForEditingAsync(Project.Id, releaseId, _dispose.Token);
        _coreOutline = await Books.ListOutlineAsync(Project.Id, _dispose.Token);
        _coreSelections = _coreOutline.ToDictionary(item => (item.TargetKind, item.TargetId), item => item.IsIncluded);
        _coreDetailsLoaded = true;
        if (generation != _targetLoadGeneration)
            return;
        _releaseDraft = ReleaseDraft.From(_workspace.Edition);
        _releaseOverrides = _workspace.OverrideFields.ToHashSet();
        _loadedOverrides = _releaseOverrides.ToHashSet();
        _releaseDirty = false;
        _releaseSelections = _workspace.Sections.SelectMany(section => section.Chapters)
            .ToDictionary(item => item.Id, item => item.IsIncluded);
        _loadedReleaseSelections = _releaseSelections.ToDictionary();
        _releaseContentDirty = false;
        _releaseDesignOpen = _workspace.OverrideFields.Any(IsDesignOverride);
        _publicationSections = await PublicationSections.ListAsync(new(Project.Id, releaseId), _dispose.Token);
        _editingSection = null;
        await InvokeAsync(StateHasChanged);

        await ReloadPreparationsAsync(PublicationTargetKind.Release, releaseId);
        _artifacts = await Renders.ListArtifactsAsync(Project.Id, releaseId, _dispose.Token);
        _releases = await Releases.ListAsync(Project.Id, _dispose.Token);
        _editionDifferences = _workspace.Edition.EditionSpecificContentEnabled
            ? await EditionContent.ReadDifferencesAsync(Project.Id, releaseId, cancellationToken: _dispose.Token)
            : [];
        if (generation != _targetLoadGeneration)
            return;
        _outputsLoaded = true;
        ResumeActivePreparation(PublicationTargetKind.Release, releaseId);
    }

    private RenderFragment CoreBookView() => @<div class="workspace-stack">
        <section class="readiness-card">
            <div><span class="eyebrow">Private review copy</span><h1>Core Book</h1><p>Shared book details, content, design, and cover. Publication releases inherit these values live.</p></div>
            <div class="primary-action"><button class="btn btn-primary" disabled="@(_busy || !_outputsLoaded || HasActivePreparation)" @onclick="PrepareCoreAsync">@PreparationButton("Prepare reading PDF")</button><small>A tagged review PDF—not a publication product.</small></div>
            @PreparationStatus()
            @CoreDownloads()
        </section>

        <section class="workspace-card core-book-design-card">
            <header>
                <div><div><span class="eyebrow">Book design</span><h2>Page, text, and cover defaults</h2><p>These shared choices flow into the reading PDF and publication releases unless customized.</p></div></div>
            </header>
            <div class="core-book-design-grid">
                <div class="core-design-pane">
                    <div class="core-design-heading"><div><h3>Page and text defaults</h3><p>Set the regular page geometry and baseline body typography.</p></div><button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenBookTextStylesModal">Manage Book Text Styles</button></div>
                    <div class="page-setup-grid">
                        <label class="field full"><span>Page size</span><select class="form-select" value="@PageSetupPreset()" @onchange="PageSetupPresetChanged"><option value="6x9">6 × 9 in</option><option value="5.5x8.5">5.5 × 8.5 in</option><option value="8.5x11">8.5 × 11 in</option><option value="custom">Custom</option></select></label>
                        <label class="field"><span>Width (in)</span><input class="form-control" type="number" min="3" max="24" step="0.125" @bind="_pageWidthInches" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Height (in)</span><input class="form-control" type="number" min="3" max="24" step="0.125" @bind="_pageHeightInches" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Margins (in)</span><input class="form-control" type="number" min="0.25" max="3" step="0.0625" @bind="_pageMarginInches" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Body size (pt)</span><input class="form-control" type="number" min="6" max="36" step="0.25" @bind="_bodyFontSizePoints" @bind:after="MarkPageSetupDirty" /></label>
                        <label class="field"><span>Line height</span><input class="form-control" type="number" min="0.8" max="3" step="0.05" @bind="_bodyLineHeight" @bind:after="MarkPageSetupDirty" /></label>
                    </div>
                </div>
                <div class="core-design-pane core-cover-summary">
                    <div><span class="eyebrow">Core cover</span><h3>Reusable front cover</h3><p>The front cover flows into EPUB and PDF releases and becomes the front panel of paperback covers.</p></div>
                    <div class="button-row"><button class="btn btn-sm btn-outline-primary" @onclick="OpenCoreCoverAsync">Edit Core cover</button><span class="status-pill">Revision @_core!.CoverRevision</span></div>
                </div>
            </div>
        </section>

        <section class="workspace-card"><header><div><span class="step">01</span><div><h2>Book details</h2><p>Enter these once. Releases use them unless customized.</p></div></div></header>
            <div class="form-grid">
                <label class="field wide"><span>Title</span><input class="form-control" value="@_coreDraft.Title" @oninput="e => CoreChanged(nameof(CoreDraft.Title), e.Value?.ToString())" /></label>
                <label class="field wide"><span>Subtitle <small>optional</small></span><input class="form-control" value="@_coreDraft.Subtitle" @oninput="e => CoreChanged(nameof(CoreDraft.Subtitle), e.Value?.ToString())" /></label>
                <label class="field"><span>Author</span><input class="form-control" value="@_coreDraft.Author" @oninput="e => CoreChanged(nameof(CoreDraft.Author), e.Value?.ToString())" /></label>
                <label class="field"><span>Language</span>@LanguageSelect(_coreDraft.Language, false, value => CoreChanged(nameof(CoreDraft.Language), value))</label>
                <label class="field"><span>Publisher <small>optional</small></span><input class="form-control" value="@_coreDraft.Publisher" @oninput="e => CoreChanged(nameof(CoreDraft.Publisher), e.Value?.ToString())" /></label>
                <label class="field"><span>Copyright <small>optional</small></span><input class="form-control" value="@_coreDraft.Copyright" @oninput="e => CoreChanged(nameof(CoreDraft.Copyright), e.Value?.ToString())" /></label>
                <label class="field full"><span>Description <small>optional</small></span><textarea class="form-control" rows="4" value="@_coreDraft.Description" @oninput="e => CoreChanged(nameof(CoreDraft.Description), e.Value?.ToString())"></textarea></label>
            </div>
        </section>

        @PublicationFlowCard()

        <section class="workspace-card"><header><div><span class="step">03</span><div><h2>PDF presentation</h2><p>Defaults for the Core reading PDF and inheriting PDF ebook releases.</p></div></div></header>
            <div class="option-grid pdf-presentation-options">
                <label class="check-row"><input type="checkbox" checked="@_coreDraft.AllowDesignedPageOverrides" @onchange="e => CoreToggle(nameof(CoreDraft.AllowDesignedPageOverrides), (bool)e.Value!)" /><span><strong>Preserve Designed Page sizes</strong><small>Full-art facing spreads stay one wide PDF page, and custom Designed Pages keep their own geometry instead of being fitted into regular book pages.</small></span></label>
                <div class="plain-setting"><strong>Regular pages</strong><span>@_core!.PageSetup.PageWidthInches × @_core.PageSetup.PageHeightInches in, from Project Page Setup</span></div>
                <div class="plain-setting"><strong>When disabled</strong><span>Facing spreads are divided into two regular book pages while preserving artwork across the seam.</span></div>
                <div class="plain-setting"><strong>Reader navigation and accessibility</strong><span>Tagged text, bookmarks, internal contents links, language, and logical reading order are included automatically.</span></div>
            </div>
        </section>

    </div>;

    private RenderFragment ReleaseView() => @<div class="workspace-stack release-workspace-stack">
        <section class="readiness-card">
            <div><span class="eyebrow">@ReleaseTypeLabel(_workspace!.Edition.Format)</span><h1>@_workspace.Edition.Name</h1><p>@ReleaseSummary(_workspace.Edition)</p></div>
            <div class="primary-action"><button class="btn btn-primary" disabled="@(_busy || !_outputsLoaded || HasActivePreparation)" @onclick="PrepareReleaseAsync">@PreparationButton("Prepare files")</button><small>Renders, validates, and packages in one step.</small></div>
            @PreparationStatus()
            @ArtifactDownloads(ReleaseArtifactKinds(_workspace.Edition.Format))
        </section>

        <section class="workspace-card edition-content-card">
            <header>
                <div><span class="step">03</span><div><h2>Edition-specific content</h2><p>Keep this release live with Core Book, or opt in to chapter-level edition copies edited in Editor.</p></div></div>
                <label class="edition-content-switch"><input type="checkbox" checked="@_workspace!.Edition.EditionSpecificContentEnabled" disabled="@(_editionContentBusy || _workspace.Edition.Status == PublicationEditionStatus.Archived)" @onchange="ToggleEditionContentAsync" /><span>Enable</span></label>
            </header>
            @if (_workspace.Edition.EditionSpecificContentEnabled)
            {
                <div class="edition-content-summary @(_editionDifferences.Count > 0 ? "divergent" : "inherited")">
                    <strong>@(_editionDifferences.Count > 0 ? $"{_editionDifferences.Count} chapter(s) differ from Core Book" : "All chapters currently inherit Core Book")</strong>
                    <a class="btn btn-sm btn-outline-primary" href="@EditionEditorHref(_editionDifferences.FirstOrDefault()?.ChapterId)">Edit edition content</a>
                </div>
                @if (_editionDifferences.Count > 0)
                {
                    <div class="edition-difference-list">
                        @foreach (var difference in _editionDifferences)
                        {
                            <div class="edition-difference-item">
                                <a href="@DifferenceEditorHref(difference)">
                                    <strong>@difference.ChapterTitle</strong>
                                    <span>@DifferenceSummary(difference)</span>
                                </a>
                                @foreach (var issue in difference.LayoutIssues)
                                {
                                    <a class="edition-layout-issue" href="@EditionEditorHref(difference.ChapterId, "pages", issue.CompositionId, issue.ObjectId)">
                                        <span>@issue.Message</span><strong>Fix in Pages</strong>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </section>

        @PublicationFlowCard()

        <section class="workspace-card release-setup-card"><header><div><span class="step">04</span><div><h2>Release setup</h2><p>Only settings that belong to this publication product. Changes save automatically.</p></div></div></header>
            <div class="form-grid">
                <label class="field"><span>Release name</span><input class="form-control" @bind="_releaseDraft.Name" @bind:event="oninput" @bind:after="MarkReleaseDirty" /></label>
                @if (_workspace.Edition.Format is PublicationEditionFormat.Paperback or PublicationEditionFormat.Hardcover)
                {
                    <label class="field"><span>Printer or service</span><select class="form-select" @bind="_releaseDraft.Vendor" @bind:after="ReleaseVendorChanged"><option value="@PublicationVendor.AmazonKdp">Amazon KDP</option><option value="@PublicationVendor.IngramSpark">IngramSpark</option><option value="@PublicationVendor.Generic">Other printer</option></select></label>
                    <label class="field product-field"><span>Print product</span><select @key="(_workspace.Edition.Format, _releaseDraft.Vendor)" class="form-select" @bind="_releaseDraft.PrintProductKey" @bind:after="ReleaseProductChanged">@foreach (var product in CompatiblePrintProducts(_workspace.Edition.Format, _releaseDraft.Vendor)){<option value="@product.Key">@product.DisplayName</option>}</select><small>@SelectedProductDescription() @CurrentSpineDescription()</small></label>
                    @if (SelectedProduct() is { } selectedPrintProduct && selectedPrintProduct.TrimSizes.Count > 0)
                    {
                        <label class="field"><span>Trim size</span><select @key="_releaseDraft.PrintProductKey" class="form-select" value="@CurrentTrimKey()" @onchange="PrintTrimChanged">@foreach (var trim in selectedPrintProduct.TrimSizes){<option value="@trim">@(trim.Replace("x", " x ")) in</option>}@if(selectedPrintProduct.AllowsCustomTrim){<option value="custom">Custom printer trim</option>}</select></label>
                    }
                    <label class="field"><span>Finish</span><select class="form-select" @bind="_releaseDraft.PrintFinish" @bind:after="MarkReleaseDirty">@foreach (var finish in SelectedProduct()?.Finishes ?? []){<option value="@finish">@finish</option>}</select></label>
                    @if (SelectedProduct()?.CoverModes.Count > 1)
                    {
                        <label class="field"><span>Cover printing</span><select class="form-select" @bind="_releaseDraft.PrintCoverMode" @bind:after="MarkReleaseDirty">@foreach (var mode in SelectedProduct()!.CoverModes){<option value="@mode">@(mode == PrintCoverMode.Duplex ? "Outside and inside" : "Outside only")</option>}</select></label>
                    }
                    <label class="field"><span>ISBN <small>@(_releaseDraft.Vendor == PublicationVendor.IngramSpark ? "required" : "optional")</small></span><input class="form-control" @bind="_releaseDraft.Isbn" @bind:event="oninput" @bind:after="MarkReleaseDirty" /></label>
                    @if (_releaseDraft.Vendor == PublicationVendor.Generic)
                    {
                        <label class="field field-wide"><span>Printer geometry manifest</span><textarea class="form-control font-monospace" rows="7" placeholder="Paste or import a Lorekeeper print-template manifest." @bind="_releaseDraft.GenericPrintTemplateJson" @bind:event="oninput" @bind:after="MarkReleaseDirty"></textarea><small>Generic output is Template validated. This manifest supplies the printer-specific spine and cover geometry.</small></label>
                    }
                }
                else if (_workspace.Edition.Format == PublicationEditionFormat.DigitalPdf)
                {
                    <label class="field"><span>ISBN <small>optional</small></span><input class="form-control" @bind="_releaseDraft.Isbn" @bind:event="oninput" @bind:after="MarkReleaseDirty" /></label>
                }
                else
                {
                    <label class="field"><span>ISBN <small>optional</small></span><input class="form-control" @bind="_releaseDraft.Isbn" @bind:event="oninput" @bind:after="MarkReleaseDirty" /></label>
                    <div class="plain-setting"><strong>EPUB 3</strong><span>Reflowable navigation and accessibility are managed automatically.</span></div>
                }
            </div>
        </section>

        <section class="workspace-card release-book-details-card"><header><div><span class="step">02</span><div><h2>Book details</h2><p>Inherited from Core Book. Customize only the fields that differ for this release.</p></div></div></header>
            <div class="inherit-grid">
                @InheritedText("Title", PublicationEditionOverrideField.Title, _releaseDraft.Title, value => ReleaseText(nameof(ReleaseDraft.Title), value))
                @InheritedText("Subtitle", PublicationEditionOverrideField.Subtitle, _releaseDraft.Subtitle, value => ReleaseText(nameof(ReleaseDraft.Subtitle), value))
                @InheritedText("Author", PublicationEditionOverrideField.Author, _releaseDraft.Author, value => ReleaseText(nameof(ReleaseDraft.Author), value))
                @InheritedLanguage()
                @InheritedText("Publisher", PublicationEditionOverrideField.Publisher, _releaseDraft.Publisher, value => ReleaseText(nameof(ReleaseDraft.Publisher), value))
                @InheritedText("Copyright", PublicationEditionOverrideField.Copyright, _releaseDraft.Copyright, value => ReleaseText(nameof(ReleaseDraft.Copyright), value))
                @InheritedText("Description", PublicationEditionOverrideField.Description, _releaseDraft.Description, value => ReleaseText(nameof(ReleaseDraft.Description), value))
            </div>
        </section>

        <section class="workspace-card release-cover-card"><div><span class="eyebrow">@CoverEyebrow(_workspace.Edition.Format)</span><h2>@(_workspace.Edition.InheritsCoreCover ? "Front inherited from Core" : "Customized for this release")</h2><p>@CoverHelp(_workspace.Edition.Format)</p><div class="button-row">@if (_workspace.Edition.InheritsCoreCover){<button class="btn btn-sm btn-outline-primary" @onclick="CustomizeReleaseCoverAsync">Customize for this release</button>}else{<button class="btn btn-sm btn-outline-primary" @onclick="OpenReleaseCoverAsync">Edit release cover</button><button class="btn btn-sm btn-outline-secondary" @onclick="UseCoreCoverAsync">Use Core Book cover</button>}<span class="status-pill">@(_workspace.Edition.InheritsCoreCover ? "From Core Book" : "Release override")</span></div></div></section>

        @if (_workspace.Edition.Format != PublicationEditionFormat.Epub)
        {
            @if (_workspace.Edition.Format == PublicationEditionFormat.DigitalPdf)
            {
                <section class="workspace-card"><header><div><span class="step">05</span><div><h2>PDF presentation</h2><p>Uses Core Book defaults until deliberately customized for this PDF release.</p></div></div></header>
                    <div class="release-presentation-options">
                        @InheritedToggle("Preserve Designed Page sizes", PublicationEditionOverrideField.AllowDesignedPageOverrides, _releaseDraft.AllowDesignedPageOverrides, value => ReleaseToggle(nameof(ReleaseDraft.AllowDesignedPageOverrides), value))
                        <div class="plain-setting"><strong>Page behavior</strong><span>When enabled, full-art spreads remain one wide PDF page and custom Designed Pages retain their geometry. When disabled, spreads use regular book leaves.</span></div>
                        <div class="plain-setting"><strong>Accessibility</strong><span>Tagged text, bookmarks, links, and logical reading order remain automatic.</span></div>
                    </div>
                </section>
            }
            <section class="workspace-card"><header><div><span class="step">@(_workspace.Edition.Format == PublicationEditionFormat.DigitalPdf ? "06" : "05")</span><div><h2>Page geometry</h2><p>@(_releaseDesignOpen ? "Page size and margins are customized for this release." : "Uses Core Book page size and margins. Edition-specific typography is applied in Editor.")</p></div></div><button class="btn btn-sm btn-outline-primary" @onclick="ToggleReleaseDesign">@(_releaseDesignOpen ? "Use Core Book geometry" : "Customize geometry")</button></header>
                @if (_releaseDesignOpen)
                {
                    <div class="form-grid">
                        <label class="field"><span>Page width (in)</span><input class="form-control" type="number" min="3" max="18" step="0.01" @bind="_releaseDraft.PageWidthInches" @bind:after="MarkReleaseDirty" /></label>
                        <label class="field"><span>Page height (in)</span><input class="form-control" type="number" min="3" max="24" step="0.01" @bind="_releaseDraft.PageHeightInches" @bind:after="MarkReleaseDirty" /></label>
                        <label class="field"><span>Margin (in)</span><input class="form-control" type="number" min="0.25" max="3" step="0.01" @bind="_releaseDraft.PageMarginInches" @bind:after="MarkReleaseDirty" /></label>
                    </div>
                }
            </section>
        }

        <details class="technical"><summary>Advanced and technical details</summary><dl><div><dt>Profile</dt><dd>Managed automatically for @_workspace.Edition.Vendor</dd></div><div><dt>Source state</dt><dd>Calculated when files are prepared</dd></div><div><dt>Release revision</dt><dd>@_workspace.Edition.Revision</dd></div></dl><div class="button-row"><button class="btn btn-sm btn-outline-secondary" @onclick="CloneReleaseAsync">Clone release</button><button class="btn btn-sm btn-outline-danger" @onclick="ArchiveReleaseAsync">Archive release</button></div></details>
    </div>;

    private RenderFragment PublicationFlowCard() => @<section class="workspace-card publication-flow-card">
        <header>
            <div><span class="step">@(_selectedReleaseId is null ? "02" : "01")</span><div><h2>Book content</h2><p>Choose what appears in the front, main content, and back of this book.</p></div></div>
        </header>
        @if (!_coreDetailsLoaded && _selectedReleaseId is null)
        {
            <div class="deferred-section-loading"><span class="spinner-border spinner-border-sm"></span> Loading book content...</div>
        }
        else
        {
            <div class="publication-flow-groups">
                <details class="publication-flow-group" open>
                    <summary><span><strong>Front of book</strong><small>@IncludedPublicationSectionCount(PublicationContentArea.Front) included</small></span></summary>
                    <div class="publication-flow-body">
                        <div class="publication-flow-actions"><span>Title pages, copyright, dedications, and other opening material.</span><div class="button-row"><button class="btn btn-sm btn-outline-primary" disabled="@_assistantRunning" @onclick="() => AddPublicationSectionAsync(false, PublicationSectionAnchor.Front)">Add prose</button><button class="btn btn-sm btn-outline-primary" disabled="@_assistantRunning" @onclick="() => AddPublicationSectionAsync(true, PublicationSectionAnchor.Front)">Add designed page</button></div></div>
                        @PublicationSectionRows(PublicationSectionsFor(PublicationContentArea.Front))
                    </div>
                </details>

                <details class="publication-flow-group" open>
                    <summary><span><strong>Main content</strong><small>@IncludedChapterCount() chapters included</small></span></summary>
                    <div class="publication-flow-body">
                        <div class="publication-structure-options">
                            <h3>Structure and presentation</h3>
                            @ContentStructureOptions()
                        </div>
                        <div class="publication-chapter-list">
                            <div class="publication-list-heading"><h3>Chapters</h3>@if (_selectedReleaseId is not null && _workspace!.HasContentOverrides){<button class="btn btn-sm btn-outline-secondary" disabled="@_assistantRunning" @onclick="UseCoreContentAsync">Use Core Book selections</button>}</div>
                            @ChapterRows()
                        </div>
                        <div class="publication-content-sections">
                            <div class="publication-flow-actions"><span>Material placed immediately before or after a chapter.</span><div class="button-row"><button class="btn btn-sm btn-outline-primary" disabled="@(_assistantRunning || _coreOutline.Count == 0)" @onclick="() => AddPublicationSectionAsync(false, PublicationSectionAnchor.BeforeChapter)">Add prose</button><button class="btn btn-sm btn-outline-primary" disabled="@(_assistantRunning || _coreOutline.Count == 0)" @onclick="() => AddPublicationSectionAsync(true, PublicationSectionAnchor.BeforeChapter)">Add designed page</button></div></div>
                            @PublicationSectionRows(PublicationSectionsFor(PublicationContentArea.Content), showPosition: true)
                        </div>
                    </div>
                </details>

                <details class="publication-flow-group" open>
                    <summary><span><strong>Back of book</strong><small>@IncludedPublicationSectionCount(PublicationContentArea.Back) included</small></span></summary>
                    <div class="publication-flow-body">
                        <div class="publication-flow-actions"><span>Acknowledgements, author notes, references, and other closing material.</span><div class="button-row"><button class="btn btn-sm btn-outline-primary" disabled="@_assistantRunning" @onclick="() => AddPublicationSectionAsync(false, PublicationSectionAnchor.Back)">Add prose</button><button class="btn btn-sm btn-outline-primary" disabled="@_assistantRunning" @onclick="() => AddPublicationSectionAsync(true, PublicationSectionAnchor.Back)">Add designed page</button></div></div>
                        @PublicationSectionRows(PublicationSectionsFor(PublicationContentArea.Back))
                    </div>
                </details>
            </div>
        }
    </section>;

    private RenderFragment ContentStructureOptions() => @<div class="option-grid publication-option-grid">
        @if (_selectedReleaseId is null)
        {
            @Toggle("Include navigation table of contents", _coreDraft.IncludeTableOfContents, value => CoreToggle(nameof(CoreDraft.IncludeTableOfContents), value))
            @Toggle("Show a contents page", _coreDraft.IncludeVisibleTableOfContents, value => CoreToggle(nameof(CoreDraft.IncludeVisibleTableOfContents), value))
            @Toggle("Show act headings", _coreDraft.IncludeActHeadings, value => CoreToggle(nameof(CoreDraft.IncludeActHeadings), value))
            @Toggle("Show chapter headings", _coreDraft.IncludeChapterHeadings, value => CoreToggle(nameof(CoreDraft.IncludeChapterHeadings), value))
            @Toggle("Include act summaries", _coreDraft.IncludeActSynopses, value => CoreToggle(nameof(CoreDraft.IncludeActSynopses), value))
            @Toggle("Include chapter summaries", _coreDraft.IncludeChapterSynopses, value => CoreToggle(nameof(CoreDraft.IncludeChapterSynopses), value))
            @Toggle("Number acts", _coreDraft.NumberActs, value => CoreToggle(nameof(CoreDraft.NumberActs), value))
            @Toggle("Number chapters", _coreDraft.NumberChapters, value => CoreToggle(nameof(CoreDraft.NumberChapters), value))
        }
        else
        {
            @InheritedToggle("Navigation contents", PublicationEditionOverrideField.IncludeTableOfContents, _releaseDraft.IncludeTableOfContents, value => ReleaseToggle(nameof(ReleaseDraft.IncludeTableOfContents), value))
            @InheritedToggle("Visible contents page", PublicationEditionOverrideField.IncludeVisibleTableOfContents, _releaseDraft.IncludeVisibleTableOfContents, value => ReleaseToggle(nameof(ReleaseDraft.IncludeVisibleTableOfContents), value))
            @InheritedToggle("Act headings", PublicationEditionOverrideField.IncludeActHeadings, _releaseDraft.IncludeActHeadings, value => ReleaseToggle(nameof(ReleaseDraft.IncludeActHeadings), value))
            @InheritedToggle("Chapter headings", PublicationEditionOverrideField.IncludeChapterHeadings, _releaseDraft.IncludeChapterHeadings, value => ReleaseToggle(nameof(ReleaseDraft.IncludeChapterHeadings), value))
            @InheritedToggle("Act summaries", PublicationEditionOverrideField.IncludeActSynopses, _releaseDraft.IncludeActSynopses, value => ReleaseToggle(nameof(ReleaseDraft.IncludeActSynopses), value))
            @InheritedToggle("Chapter summaries", PublicationEditionOverrideField.IncludeChapterSynopses, _releaseDraft.IncludeChapterSynopses, value => ReleaseToggle(nameof(ReleaseDraft.IncludeChapterSynopses), value))
            @InheritedToggle("Number acts", PublicationEditionOverrideField.NumberActs, _releaseDraft.NumberActs, value => ReleaseToggle(nameof(ReleaseDraft.NumberActs), value))
            @InheritedToggle("Number chapters", PublicationEditionOverrideField.NumberChapters, _releaseDraft.NumberChapters, value => ReleaseToggle(nameof(ReleaseDraft.NumberChapters), value))
        }
    </div>;

    private RenderFragment ChapterRows() => @<div class="publication-section-groups chapter-groups">
        @if (_selectedReleaseId is null)
        {
            @foreach (var item in _coreOutline)
            {
                var included = _coreSelections.GetValueOrDefault((item.TargetKind, item.TargetId));
                <div class="publication-section-row publication-chapter-row @(!included ? "omitted" : null)">
                    <div><strong>@item.Title</strong><span>Chapter · @(included ? "Included" : "Omitted")</span></div>
                    <button class="btn btn-sm @(included ? "btn-outline-secondary" : "btn-outline-primary")" disabled="@_assistantRunning" @onclick="() => CoreOutlineChanged(item, !included)">@(included ? "Omit" : "Include")</button>
                </div>
            }
        }
        else
        {
            @foreach (var chapterGroup in _workspace!.Sections)
            {
                <div class="publication-chapter-group">
                    @if (!string.IsNullOrWhiteSpace(chapterGroup.Title)){<h4>@chapterGroup.Title</h4>}
                    @foreach (var chapter in chapterGroup.Chapters)
                    {
                        var included = _releaseSelections.GetValueOrDefault(chapter.Id);
                        var coreIncluded = _coreSelections.GetValueOrDefault((PublishOutlineTargetKind.Chapter, chapter.Id));
                        <div class="publication-section-row publication-chapter-row @(!included ? "omitted" : null)">
                            <div><strong>@chapter.Title</strong><span>Chapter · @(included ? "Included" : "Omitted") · @(included == coreIncluded ? "From Core Book" : "Release choice")</span></div>
                            <button class="btn btn-sm @(included ? "btn-outline-secondary" : "btn-outline-primary")" disabled="@_assistantRunning" @onclick="() => ReleaseContentChanged(chapter.Id, !included)">@(included ? "Omit" : "Include")</button>
                        </div>
                    }
                </div>
            }
        }
    </div>;

    private RenderFragment PublicationSectionRows(IEnumerable<PublicationSectionView> sections, bool showPosition = false) => @<div class="publication-section-groups">
        @if (!sections.Any())
        {
            <div class="publication-empty-row">No additional sections.</div>
        }
        else
        {
            @foreach (var group in sections.GroupBy(item => (item.Anchor, item.TargetId, item.TargetTitle)))
            {
                <div class="publication-section-group">
                    @if (showPosition){<h3>@SectionPositionLabel(group.Key.Anchor, group.Key.TargetTitle)</h3>}
                    @foreach (var item in group)
                    {
                        var included = IsPublicationSectionIncluded(item);
                        <div class="publication-section-row @(!included ? "omitted" : null)">
                            <div><strong>@item.Title</strong><span>@SectionTypeLabel(item) · @(item.IsInherited ? item.HasOrderOverride ? "From Core Book · Release order" : "From Core Book" : included ? "Included" : "Omitted") · @SectionStartSideSummary(item.StartSide)</span></div>
                            <div class="button-row">
                                <button class="btn btn-sm btn-outline-secondary section-order-button" title="Move section earlier" aria-label="Move @item.Title earlier" disabled="@(!CanMovePublicationSection(item, -1))" @onclick="() => MovePublicationSectionAsync(item, -1)">↑</button>
                                <button class="btn btn-sm btn-outline-secondary section-order-button" title="Move section later" aria-label="Move @item.Title later" disabled="@(!CanMovePublicationSection(item, 1))" @onclick="() => MovePublicationSectionAsync(item, 1)">↓</button>
                                <button class="btn btn-sm @(included ? "btn-outline-secondary" : "btn-outline-primary")" disabled="@_assistantRunning" @onclick="() => SetPublicationSectionIncludedAsync(item, !included)">@(included ? "Omit" : "Include")</button>
                                @if (item.SystemRole == PublicationSectionSystemRole.Contents)
                                {
                                    <span class="status-pill">Generated automatically</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" disabled="@_assistantRunning" @onclick="() => BeginPublicationSectionEditAsync(item)">@(item.IsInherited ? "Customize" : "Edit")</button>
                                }
                                @if (item.SystemRole == PublicationSectionSystemRole.None)
                                {
                                    <select class="form-select form-select-sm section-area-select" disabled="@_assistantRunning" value="@PublicationArea(item.Anchor)" aria-label="Move @item.Title" @onchange="e => MovePublicationSectionAreaAsync(item, e)"><option value="Front">Front</option><option value="Content" disabled="@(_coreOutline.Count == 0)">Content</option><option value="Back">Back</option></select>
                                }
                                @if (item.CoreSectionId is not null && !item.IsInherited)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_assistantRunning" @onclick="() => ResetPublicationSectionAsync(item)">Use Core Book</button>
                                }
                                @if (item.SystemRole == PublicationSectionSystemRole.None)
                                {
                                    <button class="btn btn-sm btn-outline-danger" disabled="@_assistantRunning" @onclick="() => DeletePublicationSectionAsync(item)">Remove</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>;

    private RenderFragment PublicationSectionEditorView() => @<section class="publication-section-editor" aria-label="Publication section editor">
        <header class="publication-section-editor-header">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_assistantRunning" @onclick="ClosePublicationSectionEditorAsync">&#8592; Back to sections</button>
            <div class="publication-section-editor-identity">
                <strong>@_editingSection!.Title</strong>
                <small>@(IsDesignedPublicationSection(_editingSection) ? "Designed page" : "Prose section") &middot; @(_selectedReleaseId is null ? "Core Book" : _workspace?.Edition.Name ?? "Release")</small>
            </div>
            @if (IsDesignedPublicationSection(_editingSection) && SectionCompositionIds().Count > 1)
            {
                <label class="publication-section-page-picker"><span>Page</span><select class="form-select form-select-sm" disabled="@_assistantRunning" value="@_selectedSectionCompositionId" @onchange="SelectSectionCompositionAsync">@foreach (var compositionId in SectionCompositionIds()){<option value="@compositionId">@SectionCompositionLabel(compositionId)</option>}</select></label>
            }
            <button type="button" class="btn btn-sm @(_sectionSettingsOpen ? "btn-primary" : "btn-outline-primary")" disabled="@_assistantRunning" aria-expanded="@_sectionSettingsOpen" @onclick="() => _sectionSettingsOpen = !_sectionSettingsOpen">Section settings</button>
        </header>
        @if (_sectionSettingsOpen)
        {
            <div class="publication-section-settings publication-section-settings--dedicated">
                <label class="field"><span>Section name</span><input class="form-control" disabled="@_assistantRunning" value="@_sectionTitle" @onchange="SectionTitleChangedAsync" /></label>
                <label class="field"><span>Type</span><select class="form-select" value="@_sectionKind" disabled="@(_assistantRunning || _editingSection.SystemRole != PublicationSectionSystemRole.None)" @onchange="SectionKindChangedAsync">@foreach (var kind in EditableSectionKinds()){<option value="@kind">@SectionKindLabel(kind)</option>}</select></label>
                <label class="field"><span>Position</span><select class="form-select" value="@_sectionAnchor" disabled="@(_assistantRunning || _editingSection.SystemRole != PublicationSectionSystemRole.None)" @onchange="SectionAnchorChangedAsync">@foreach (var anchor in Enum.GetValues<PublicationSectionAnchor>()){<option value="@anchor">@SectionAnchorLabel(anchor)</option>}</select></label>
                @if (_sectionAnchor is not (PublicationSectionAnchor.Front or PublicationSectionAnchor.Back))
                {
                    <label class="field"><span>Place near</span><select class="form-select" disabled="@_assistantRunning" value="@SectionTargetValue()" @onchange="SectionTargetChangedAsync">@foreach (var item in SectionAnchorTargets()){<option value="@($"{item.TargetKind}|{item.TargetId}")">@item.Title</option>}</select></label>
                }
                <label class="field"><span>Include</span><select class="form-select" disabled="@_assistantRunning" value="@_sectionInclusion" @onchange="SectionInclusionChangedAsync"><option value="@PublicationSectionInclusionMode.Automatic">Automatic</option><option value="@PublicationSectionInclusionMode.Included">Included</option><option value="@PublicationSectionInclusionMode.Omitted">Omitted</option></select></label>
                <label class="field"><span>Start on</span><select class="form-select" disabled="@_assistantRunning" value="@_sectionStartSide" @onchange="SectionStartSideChangedAsync"><option value="@PublicationSectionStartSide.Next">Next available page</option><option value="@PublicationSectionStartSide.Recto">Right-hand page (recto)</option><option value="@PublicationSectionStartSide.Verso">Left-hand page (verso)</option></select><small>A two-page facing spread always begins on a left page so both leaves face each other.</small></label>
            </div>
        }
        <div class="publication-section-editor-body">
            @if (IsDesignedPublicationSection(_editingSection))
            {
                @if (_selectedSectionCompositionId is Guid compositionId)
                {
                    <DesignedPageWorkspace @key="compositionId" @ref="_sectionPageWorkspace" ProjectId="Project!.Id" CompositionId="compositionId" ContentTarget="@SectionEditorContentTarget()"
                                           RefreshSignal="_sectionPageRefreshSignal" RequestedSelectionId="_sectionPageSelectionId"
                                           RequestedVariantId="_selectedSectionVariantId" InteractionLocked="_assistantRunning"
                                           WorkspaceChanged="HandleSectionPageWorkspaceChangedAsync" />
                }
                else
                {
                    <div class="publication-section-editor-error" role="alert">This designed section does not contain a page canvas.</div>
                }
            }
            else
            {
                <ChapterBodyEditor @ref="_publicationSectionEditor" @key="_editingSection.Id"
                                   ChapterId="_editingSection.Id" ProjectId="Project!.Id"
                                   InitialManuscriptJson="@ManuscriptCodec.Serialize(_editingSection.Manuscript)"
                                   IsReadOnly="_assistantRunning"
                                   SaveAsync="SavePublicationSectionDocumentAsync"
                                   ReadDocumentOverrideAsync="ReadPublicationSectionDocumentAsync"
                                   ReadHistoryOverrideAsync="ReadPublicationSectionHistoryAsync"
                                   HistoryDocumentKindOverride="AuthoringHistoryDocumentKind.PublicationSection"
                                   UndoOverrideAsync="UndoPublicationSectionAsync"
                                   RedoOverrideAsync="RedoPublicationSectionAsync"
                                   AllowDesignedPages="false"
                                   OpenProjectImagePicker="OpenPublicationSectionImageModal"
                                   OpenBookTextStyles="OpenBookTextStylesModal"
                                   StyleCatalogChanged="HandleBookTextStylesChangedAsync" />
            }
        </div>
    </section>;

