    {
        _disableEditionContentConfirmationOpen = false;
        _pendingDisableEditionContentId = null;
    }

    private async Task SetEditionContentEnabledAsync(Guid editionId, bool enabled, bool confirmDiscard)
    {
        if (Project is null || _workspace is null || _selectedReleaseId != editionId)
            return;
        _editionContentBusy = true;
        _error = null;
        try
        {
            if (_releaseDirty || _releaseContentDirty)
                await SaveReleaseAsync();
            await EditionContent.SetEnabledAsync(Project.Id, editionId, _workspace.Edition.Revision, enabled, confirmDiscard, _dispose.Token);
            await SelectReleaseAsync(editionId);
            _notice = enabled
                ? "Edition-specific content is ready in Editor. Chapters continue inheriting Core until their first real edit."
                : "Edition-specific content was discarded. This release now inherits Core Book chapters.";
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            await SelectReleaseAsync(editionId);
        }
        finally
        {
            _editionContentBusy = false;
        }
    }

    private string EditionEditorHref(Guid? chapterId, string? mode = null, Guid? compositionId = null, Guid? objectId = null)
    {
        if (Project is null || _selectedReleaseId is not Guid editionId)
            return string.Empty;
        chapterId ??= _workspace?.Sections.SelectMany(section => section.Chapters).FirstOrDefault()?.Id;
        var path = chapterId is Guid id
            ? $"/projects/{Project.Slug}/editor/{id}"
            : $"/projects/{Project.Slug}/editor";
        var query = new List<string> { $"edition={editionId:D}" };
        if (!string.IsNullOrWhiteSpace(mode)) query.Add($"mode={Uri.EscapeDataString(mode)}");
        if (compositionId.HasValue) query.Add($"composition={compositionId:D}");
        if (objectId.HasValue) query.Add($"object={objectId:D}");
        return $"{path}?{string.Join('&', query)}";
    }

    private string DiagnosticEditorHref(PublicationDiagnosticPresentation diagnostic, Guid chapterId)
    {
        if (Project is null)
            return string.Empty;
        var path = $"/projects/{Project.Slug}/editor/{chapterId}";
        var query = new List<string>();
        if (diagnostic.EditionId is Guid editionId)
            query.Add($"edition={editionId:D}");
        if (diagnostic.CompositionId is Guid compositionId)
        {
            query.Add("mode=pages");
            query.Add($"composition={compositionId:D}");
        }
        if (diagnostic.ObjectId is Guid objectId)
            query.Add($"object={objectId:D}");
        return query.Count == 0 ? path : $"{path}?{string.Join('&', query)}";
    }

    private async Task OpenDiagnosticTargetAsync(PublicationDiagnosticPresentation diagnostic)
    {
        if (Project is null)
            return;
        switch (diagnostic.TargetKind)
        {
            case PublicationDiagnosticTargetKind.PublicationSectionPage
                when diagnostic.PublicationSectionId is Guid sectionId:
                if (_selectedReleaseId != diagnostic.EditionId)
                {
                    if (diagnostic.EditionId is Guid releaseId)
                        await SelectReleaseAsync(releaseId);
                    else
                        await SelectCoreAsync();
                    await LoadPendingTargetNowAsync();
                }
                var section = _publicationSections.FirstOrDefault(item => item.Id == sectionId);
                if (section is null)
                {
                    _error = "The publication section for this note is no longer available.";
                    return;
                }
                BeginPublicationSectionEdit(section);
                if (diagnostic.CompositionId is Guid compositionId)
                    _selectedSectionCompositionId = compositionId;
                _sectionPageSelectionId = diagnostic.ObjectId;
                _sectionPageRefreshSignal++;
                break;
            case PublicationDiagnosticTargetKind.Cover:
                if (_selectedReleaseId != diagnostic.EditionId)
                {
                    if (diagnostic.EditionId is Guid releaseId)
                        await SelectReleaseAsync(releaseId);
                    else
                        await SelectCoreAsync();
                    await LoadPendingTargetNowAsync();
                }
                _coverSelectionId = diagnostic.ObjectId;
                _coverEditorOpen = true;
                _coverRefreshSignal++;
                break;
        }
    }

    private async Task LoadPendingTargetNowAsync()
    {
        var generation = _targetLoadGeneration;
        if (_selectedReleaseId is Guid releaseId)
            await LoadReleaseTargetAsync(releaseId, generation);
        else
            await LoadCoreTargetAsync(generation);
        if (generation == _targetLoadGeneration)
        {
            _targetLoadPending = false;
            _targetLoading = false;
            _assistantSelectedReleaseId = _selectedReleaseId;
            _assistantMounted = true;
        }
    }

    private static string DifferenceSummary(EditionChapterDifference difference)
    {
        var parts = new List<string>();
        if (difference.TextEdited > 0) parts.Add($"{difference.TextEdited} text edit(s)");
        if (difference.Added > 0) parts.Add($"{difference.Added} added");
        if (difference.Removed > 0) parts.Add($"{difference.Removed} removed");
        if (difference.Moved > 0) parts.Add($"{difference.Moved} moved");
        if (difference.Figures > 0) parts.Add($"{difference.Figures} Figure change(s)");
        if (difference.DesignedPages > 0) parts.Add($"{difference.DesignedPages} Designed Page change(s)");
        if (difference.StyleReferences + difference.DirectFormatting > 0) parts.Add("styling differs");
        return parts.Count == 0 ? "Structured content differs" : string.Join(" · ", parts);
    }

    private string DifferenceEditorHref(EditionChapterDifference difference)
    {
        var compositionId = difference.ChangedCompositionIds.FirstOrDefault();
        return compositionId != Guid.Empty
            ? EditionEditorHref(difference.ChapterId, "pages", compositionId)
            : EditionEditorHref(difference.ChapterId);
    }

