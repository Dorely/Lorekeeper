    private async Task SaveCoreAsync()
    {
        if (Project is null || _core is null || (!_coreDirty && !_coreOutlineDirty)) return;
        var saveVersion = _formChangeVersion;
        _busy = true; _error = null;
        try
        {
            if (_coreDirty)
                _core = await Books.UpdateAsync(Project.Id, new PublicationBookPatch(_core.Revision, _coreDraft.Title, _coreDraft.Subtitle, _coreDraft.Author, _coreDraft.Language, _coreDraft.Publisher, _coreDraft.Copyright, _coreDraft.Description, _coreDraft.IncludeTableOfContents, _coreDraft.IncludeVisibleTableOfContents, _coreDraft.IncludeActSynopses, _coreDraft.IncludeChapterSynopses, _coreDraft.IncludeActHeadings, _coreDraft.IncludeChapterHeadings, _coreDraft.NumberActs, _coreDraft.NumberChapters, _coreDraft.TitlePageMode, _coreDraft.AllowDesignedPageOverrides));
            if (_coreOutlineDirty)
                _core = await Books.SetOutlineSelectionsAsync(Project.Id, _coreSelections.Select(item => new PublicationEditionOutlineItemUpdate(item.Key.Kind, item.Key.Id, item.Value)).ToList(), _core.Revision);
            if (saveVersion == _formChangeVersion)
            {
                _coreDraft = CoreDraft.From(_core);
                _coreDirty = false;
                _coreOutlineDirty = false;
            }
            _releases = await Releases.ListAsync(Project.Id, _dispose.Token);
            _artifacts = (await Renders.ListCoreAsync(Project.Id, _dispose.Token))
                .SelectMany(item => item.Artifacts)
                .OrderByDescending(item => item.CreatedAt)
