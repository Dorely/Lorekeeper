    private async Task ExportAsync()
    {
        if (Project is null || _downloadModule is null) return;
        _exporting = true;
        _exportError = null;
        try
        {
            await FlushProfileSaveAsync();
            await FlushCoverLayoutSaveAsync();
            var file = await Publishing.ExportAsync(Project.Id, _exportFormat);
            await _downloadModule.InvokeVoidAsync("downloadBytes", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        }
        catch (Exception ex)
        {
            _exportError = ex.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string TargetKey(PublishOutlineTargetKind kind, Guid id) =>
        $"{kind}:{id:N}";

    private static (PublishOutlineTargetKind Kind, Guid Id) ParseTargetKey(string value)
    {
        var parts = value.Split(':', 2);
        if (parts.Length != 2
            || !Enum.TryParse<PublishOutlineTargetKind>(parts[0], out var kind)
            || !Guid.TryParseExact(parts[1], "N", out var id))
        {
            throw new InvalidOperationException("Select a target.");
        }

        return (kind, id);
    }

    private static string FormatBytes(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private static string AssetAlt(PublishAssetView asset) =>
        string.IsNullOrWhiteSpace(asset.AltText) ? asset.FileName : asset.AltText;

    private void OpenAssetModal(PublishAssetView asset) => _selectedAsset = asset;

    private void CloseAssetModal() => _selectedAsset = null;

    private async Task DownloadAssetAsync(PublishAssetView asset)
    {
        if (_downloadModule is null) return;
        await _downloadModule.InvokeVoidAsync("downloadBytes", asset.FileName, asset.ContentType, AssetBase64(asset));
    }

    private bool IsReferenceSelected(Guid assetId) => _selectedReferenceAssetIds.Contains(assetId);

    private void SetReferenceSelection(Guid assetId, ChangeEventArgs e)
    {
        var selected = e.Value is bool value && value;
        if (selected)
        {
            if (!_selectedReferenceAssetIds.Contains(assetId) && _selectedReferenceAssetIds.Count < MaxReferenceAssets)
                _selectedReferenceAssetIds.Add(assetId);
            return;
        }

        _selectedReferenceAssetIds.Remove(assetId);
    }

    private void PruneAssetSelections()
    {
        if (_workspace is null) return;
        var assetIds = _workspace.Assets.Select(asset => asset.Id).ToHashSet();
        _selectedReferenceAssetIds = _selectedReferenceAssetIds.Where(assetIds.Contains).ToList();
        if (!string.IsNullOrEmpty(_placementAssetId)
            && (!Guid.TryParse(_placementAssetId, out var placementAssetId) || !assetIds.Contains(placementAssetId)))
        {
            _placementAssetId = _workspace.Assets.FirstOrDefault()?.Id.ToString() ?? string.Empty;
        }

        if (_selectedAsset is not null)
            _selectedAsset = _workspace.Assets.FirstOrDefault(asset => asset.Id == _selectedAsset.Id);
    }

    private static string AssetBase64(PublishAssetView asset)
    {
        var comma = asset.PreviewDataUrl.IndexOf(',', StringComparison.Ordinal);
        return comma < 0 ? asset.PreviewDataUrl : asset.PreviewDataUrl[(comma + 1)..];
    }

    public async ValueTask DisposeAsync()
    {
        _disposing = true;
        _navHandlerRegistration?.Dispose();
        try { await FlushProfileSaveAsync(); } catch { }
        try { await FlushCoverLayoutSaveAsync(); } catch { }

        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }

