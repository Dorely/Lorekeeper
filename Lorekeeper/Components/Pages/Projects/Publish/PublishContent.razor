    private async Task SetAllOutlineSelectionsAsync(bool included)
    {
        if (_workspace is null) return;
        var updates = new List<PublicationEditionOutlineItemUpdate>();
        foreach (var section in _workspace.Sections)
        {
            if (section.ActId is Guid actId)
                updates.Add(new(PublishOutlineTargetKind.Act, actId, included));
            updates.AddRange(section.Chapters
                .Where(chapter => !IsCoverChapter(chapter.Id))
                .Select(chapter => new PublicationEditionOutlineItemUpdate(PublishOutlineTargetKind.Chapter, chapter.Id, included)));
        }
        await ApplyOutlineSelectionsAsync(updates);
    }

