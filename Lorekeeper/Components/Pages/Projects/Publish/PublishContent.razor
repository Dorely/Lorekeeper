    private async Task SaveMatterAsync()
    {
        if (Project is null
            || _selectedEditionId is not Guid editionId
            || _workspace?.Matter.FirstOrDefault(item => item.Id == _editingMatterId) is not { } current)
            return;
        try
        {
            var document = ManuscriptCodec.Deserialize(
                _matterJson,
                current.Id,
                current.Revision);
            _ = await Editions.UpsertMatterAsync(
                Project.Id,
                editionId,
                new PublicationMatterInput(
                    current.Id,
                    _matterLocation,
                    _matterKind,
                    _matterTitle,
                    ManuscriptCodec.Serialize(document),
                    _matterIncluded,
                    _matterSortOrder,
                    current.Revision),
                _editionDraft.Revision);
            _editingMatterId = null;
            await RefreshWorkspaceAsync();
            _liveMessage = "Publication matter saved.";
        }
        catch (Exception exception)
        {
            _editionActionError = exception.Message;
        }
    }

    private async Task AddMatterAsync(PublicationMatterKind kind)
    {
        if (Project is null || _selectedEditionId is not Guid editionId || _workspace is null) return;
        try
        {
            var location = kind is PublicationMatterKind.Acknowledgments
                or PublicationMatterKind.AboutAuthor
                or PublicationMatterKind.AlsoBy
                or PublicationMatterKind.References
                    ? PublicationMatterLocation.Back
                    : PublicationMatterLocation.Front;
            var title = kind == PublicationMatterKind.Custom ? "Custom page" : kind.ToString();
            var empty = ManuscriptCodec.CreateEmpty(Guid.Empty);
            _ = await Editions.UpsertMatterAsync(
                Project.Id,
                editionId,
                new PublicationMatterInput(
                    null,
                    location,
                    kind,
                    title,
                    ManuscriptCodec.Serialize(empty),
                    true,
                    _workspace.Matter.Count,
                    0),
                _editionDraft.Revision);
            await RefreshWorkspaceAsync();
            _liveMessage = $"{title} added.";
        }
        catch (Exception ex)
        {
            _editionActionError = ex.Message;
        }
