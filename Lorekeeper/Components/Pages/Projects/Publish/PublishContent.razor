    private async Task LoadWorkspaceAsync(bool resetProfile)
    {
        if (Project is null) return;
        _loading = true;
        _loadError = null;
        try
        {
            _editionSummaries = await Editions.ListAsync(Project.Id);
            if (_editionSummaries.Count == 0)
            {
                _selectedEditionId = null;
                _workspace = null;
                return;
            }
            if (_selectedEditionId is not Guid selectedId
                || _editionSummaries.All(edition => edition.Id != selectedId))
            {
                _selectedEditionId = _editionSummaries
                    .FirstOrDefault(edition => edition.IsDefault)?.Id
                    ?? _editionSummaries[0].Id;
            }
            var workspace = await Publishing.GetWorkspaceAsync(
                Project.Id,
                _selectedEditionId.Value);
            _workspace = workspace;
            _namedStyles = await ManuscriptStyles.ListAsync(Project.Id);
            _editionAudit = await Editions.GetAuditAsync(Project.Id, _selectedEditionId.Value);
            _placements = OrderPlacementViews(workspace.Placements);
            if (resetProfile)
            {
                CancelEditionAutosave();
                _editionDraft = EditionDraft.From(workspace.Edition);
                _editionDraftVersion = 0;
                _editionSavedVersion = 0;
                _editionSaveState = SaveState.Idle;
                _editionDraftLastSavedAt = null;
                _editionDraftError = null;
            }
            PrunePlacementDraft();
        }
        catch (Exception ex)
        {
            _workspace = null;
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshWorkspaceAsync()
    {
        if (Project is null || _selectedEditionId is not Guid editionId) return;
        var workspace = await Publishing.GetWorkspaceAsync(Project.Id, editionId);
        _workspace = workspace;
        _editionAudit = await Editions.GetAuditAsync(Project.Id, editionId);
        _editionDraft.Revision = workspace.Edition.Revision;
        _editionSummaries = workspace.Editions;
        _placements = OrderPlacementViews(workspace.Placements);
        PrunePlacementDraft();
    }

    private void ScheduleEditionAutosave()
    {
        if (_loadedProjectId is null && Project is null) return;
        _editionDraftVersion++;
        _editionDraftError = null;
        _editionSaveState = SaveState.Dirty;
        CancelEditionAutosave();
        _editionDraftAutosaveCts = new CancellationTokenSource();
        _ = DebouncedEditionSaveAsync(_editionDraftAutosaveCts.Token);
    }

    private void SetTitlePageMode(ChangeEventArgs e)
    {
        _editionDraft.TitlePageMode = e.Value is bool value && value
            ? PublishTitlePageMode.Include
            : PublishTitlePageMode.Omit;
        ScheduleEditionAutosave();
    }

    private async Task DebouncedEditionSaveAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(EditionAutosaveDelay, cancellationToken);
            if (_disposing) return;
            await InvokeAsync(SaveEditionCoreAsync);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task RetryEditionSaveAsync()
    {
        _editionDraftError = null;
        await FlushEditionSaveAsync();
    }

    private async Task FlushEditionSaveAsync()
    {
        CancelEditionAutosave();
        await SaveEditionCoreAsync();
    }

    private async Task SaveEditionCoreAsync()
    {
        var projectId = _loadedProjectId ?? Project?.Id;
        if (projectId is not Guid targetProjectId) return;

        await _editionSaveGate.WaitAsync();
        try
        {
            while (_editionSavedVersion != _editionDraftVersion)
            {
                var versionToSave = _editionDraftVersion;
                _editionDraftError = null;
                _editionSaveState = SaveState.Saving;
                await NotifyStateChangedAsync();

                if (_selectedEditionId is not Guid editionId)
                    throw new InvalidOperationException("Select a publication edition before saving.");
                var updated = await Editions.UpdateAsync(
                    targetProjectId,
                    editionId,
                    _editionDraft.ToUpdate());
                _editionDraft.Revision = updated.Revision;
                if (_workspace is not null)
                    _workspace = _workspace with { Edition = updated };
                _editionSummaries = await Editions.ListAsync(targetProjectId);
                _editionSavedVersion = versionToSave;
                _editionDraftLastSavedAt = DateTime.Now;
                _editionSaveState = _editionSavedVersion == _editionDraftVersion ? SaveState.Saved : SaveState.Dirty;
                _liveMessage = _editionSaveState == SaveState.Saved ? "Publishing settings saved." : "More publishing changes are waiting to save.";
            }
        }
        catch (Exception ex)
        {
            _editionDraftError = ex.Message;
            _editionSaveState = SaveState.SaveFailed;
            _liveMessage = $"Publishing settings could not be saved. {ex.Message}";
        }
        finally
        {
            _editionSaveGate.Release();
            await NotifyStateChangedAsync();
        }
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        await FlushEditionSaveAsync();
        if (_editionSaveState == SaveState.SaveFailed && HasPendingEditionSave)
            context.PreventNavigation();
    }

    private async Task NotifyStateChangedAsync()
    {
        if (_disposing) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void CancelEditionAutosave()
    {
        var cts = _editionDraftAutosaveCts;
        if (cts is null) return;
        _editionDraftAutosaveCts = null;
        cts.Cancel();
        cts.Dispose();
    }

