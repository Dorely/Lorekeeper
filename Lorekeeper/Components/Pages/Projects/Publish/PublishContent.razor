@using Lorekeeper.Models
@using Lorekeeper.Llm
@using Lorekeeper.Publish
@implements IAsyncDisposable
@inject IPublishService Publishing
@inject ILlmProviderService Providers
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Project is null)
{
    <p class="text-muted"><em>Loading...</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading publish setup...</em></p>
}
else if (_workspace is null)
{
    <div class="alert alert-danger">Publish setup could not be loaded.</div>
}
else
{
    <div class="publish-pane">
        <section class="publish-column publish-main">
            <div class="publish-card">
                <div class="publish-card-title">Book Details</div>
                @if (!string.IsNullOrWhiteSpace(_profileError))
                {
                    <div class="alert alert-danger py-2 small">@_profileError</div>
                }

                <div class="publish-form-grid">
                    <label>
                        <span>Title</span>
                        <input class="form-control form-control-sm" @bind="_profile.TitleOverride" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                    </label>
                    <label>
                        <span>Subtitle</span>
                        <input class="form-control form-control-sm" @bind="_profile.Subtitle" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                    </label>
                    <label>
                        <span>Author</span>
                        <input class="form-control form-control-sm" @bind="_profile.Author" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                    </label>
                    <label>
                        <span>Language</span>
                        <input class="form-control form-control-sm" @bind="_profile.Language" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                    </label>
                    <label>
                        <span>Publisher</span>
                        <input class="form-control form-control-sm" @bind="_profile.Publisher" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                    </label>
                    <label>
                        <span>ISBN</span>
                        <input class="form-control form-control-sm" @bind="_profile.Isbn" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                    </label>
                </div>

                <label class="publish-full">
                    <span>Copyright</span>
                    <input class="form-control form-control-sm" @bind="_profile.Copyright" @bind:event="oninput" @bind:after="ScheduleProfileAutosave" />
                </label>
                <label class="publish-full">
                    <span>Description</span>
                    <textarea class="form-control form-control-sm" rows="3" @bind="_profile.Description" @bind:event="oninput" @bind:after="ScheduleProfileAutosave"></textarea>
                </label>
                <label class="publish-full">
                    <span>Dedication</span>
                    <textarea class="form-control form-control-sm" rows="3" @bind="_profile.Dedication" @bind:event="oninput" @bind:after="ScheduleProfileAutosave"></textarea>
                </label>
                <label class="publish-full">
                    <span>Acknowledgments</span>
                    <textarea class="form-control form-control-sm" rows="3" @bind="_profile.Acknowledgments" @bind:event="oninput" @bind:after="ScheduleProfileAutosave"></textarea>
                </label>
                <label class="publish-full">
                    <span>References</span>
                    <textarea class="form-control form-control-sm" rows="4" @bind="_profile.References" @bind:event="oninput" @bind:after="ScheduleProfileAutosave"></textarea>
                </label>

                <div class="publish-check-grid">
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.IncludeTableOfContents" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Table of contents</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.IncludeVisibleTableOfContents" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Visible EPUB/print TOC page</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.IncludeActSynopses" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Act synopses</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.IncludeChapterSynopses" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Chapter synopses</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.IncludeActHeadings" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Act headings</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.IncludeChapterHeadings" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Chapter headings</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.NumberActs" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Number acts</span>
                    </label>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_profile.NumberChapters" @bind:after="ScheduleProfileAutosave" />
                        <span class="form-check-label">Number chapters</span>
                    </label>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-primary" disabled="@ProfileSaveInProgress" @onclick="SaveProfileAsync">
                        @(ProfileSaveInProgress ? "Saving..." : "Save now")
                    </button>
                    <span class="@ProfileSaveStatusClass">@ProfileSaveStatusText()</span>
                </div>
            </div>

            <div class="publish-card">
                <div class="publish-card-title">Outline</div>
                @if (!string.IsNullOrWhiteSpace(_outlineError))
                {
                    <div class="alert alert-danger py-2 small">@_outlineError</div>
                }
                @foreach (var publishSection in _workspace.Sections)
                {
                    <div class="publish-outline-section">
                        @if (publishSection.ActId is Guid actId)
                        {
                            <label class="form-check publish-outline-act">
                                <input class="form-check-input" type="checkbox" checked="@publishSection.IsIncluded" @onchange="@(e => SetOutlineSelectionAsync(PublishOutlineTargetKind.Act, actId, e))" />
                                <span class="form-check-label">@publishSection.Title</span>
                            </label>
                        }
                        else
                        {
                            <div class="publish-outline-act text-muted">@publishSection.Title</div>
                        }

                        <div class="publish-outline-chapters">
                            @foreach (var chapter in publishSection.Chapters)
                            {
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" checked="@chapter.IsIncluded" @onchange="@(e => SetOutlineSelectionAsync(PublishOutlineTargetKind.Chapter, chapter.Id, e))" />
                                    <span class="form-check-label">@chapter.Title</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="publish-column publish-side">
            <div class="publish-card">
                <div class="publish-card-title">Export</div>
                @if (!string.IsNullOrWhiteSpace(_exportError))
                {
                    <div class="alert alert-danger py-2 small">@_exportError</div>
                }
                <div class="publish-export-row">
                    <select class="form-select form-select-sm" @bind="_exportFormat">
                        <option value="@PublishExportFormat.PlainText">TXT</option>
                        <option value="@PublishExportFormat.Markdown">Markdown</option>
                        <option value="@PublishExportFormat.Epub">EPUB</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-primary" disabled="@_exporting" @onclick="ExportAsync">
                        @(_exporting ? "Exporting..." : "Download")
                    </button>
                </div>
                <a class="btn btn-sm btn-outline-secondary publish-print-link" href="@PrintUrl" target="_blank" rel="noopener" @onclick="FlushAllSavesAsync">Print / PDF</a>
            </div>

            <div class="publish-card">
                <div class="publish-card-title">Cover Text</div>
                @if (!string.IsNullOrWhiteSpace(_coverLayoutError))
                {
                    <div class="alert alert-danger py-2 small">@_coverLayoutError</div>
                }
                <CoverTextEditor CoverAsset="SelectedCoverAsset"
                                 Layout="CurrentCoverLayout"
                                 Title="@CoverTitleText"
                                 Subtitle="@_profile.Subtitle"
                                 Author="@_profile.Author"
                                 SaveStatus="@CoverLayoutSaveStatusText()"
                                 SaveStatusClass="@CoverLayoutSaveStatusClass"
                                 LayoutChanged="OnCoverLayoutChangedAsync" />
            </div>

            <div class="publish-card">
                <div class="publish-card-title">Assets</div>
                @if (!string.IsNullOrWhiteSpace(_assetError))
                {
                    <div class="alert alert-danger py-2 small">@_assetError</div>
                }
                @if (!string.IsNullOrWhiteSpace(_assetStatus))
                {
                    <div class="alert alert-success py-2 small">@_assetStatus</div>
                }

                <label class="publish-full">
                    <span>Upload alt text</span>
                    <input class="form-control form-control-sm" @bind="_uploadAltText" />
                </label>
                <InputFile OnChange="OnAssetSelectedAsync" class="form-control form-control-sm mb-3" />

                @if (_codexConnected)
                {
                    <label class="publish-full">
                        <span>Image prompt</span>
                        <textarea class="form-control form-control-sm" rows="4" @bind="_imagePrompt"></textarea>
                    </label>
                    @if (_workspace.Assets.Count > 0)
                    {
                        <div class="publish-reference-list">
                            <div class="publish-reference-title">Reference images</div>
                            @foreach (var asset in _workspace.Assets)
                            {
                                var selected = IsReferenceSelected(asset.Id);
                                <label class="form-check publish-reference-row">
                                    <input class="form-check-input" type="checkbox" checked="@selected" disabled="@(!selected && _selectedReferenceAssetIds.Count >= MaxReferenceAssets)" @onchange="@(e => SetReferenceSelection(asset.Id, e))" />
                                    <img src="@asset.PreviewDataUrl" alt="@AssetAlt(asset)" />
                                    <span>@asset.FileName</span>
                                </label>
                            }
                        </div>
                    }
                    <div class="publish-form-grid compact">
                        <label>
                            <span>Size</span>
                            <select class="form-select form-select-sm" @bind="_imageSize">
                                <option value="auto">Auto</option>
                                <option value="1024x1024">Square</option>
                                <option value="1024x1536">Portrait</option>
                                <option value="1536x1024">Landscape</option>
                            </select>
                        </label>
                        <label>
                            <span>Quality</span>
                            <select class="form-select form-select-sm" @bind="_imageQuality">
                                <option value="auto">Auto</option>
                                <option value="low">Low</option>
                                <option value="medium">Medium</option>
                                <option value="high">High</option>
                            </select>
                        </label>
                        <label>
                            <span>Format</span>
                            <select class="form-select form-select-sm" @bind="_imageFormat">
                                <option value="png">PNG</option>
                                <option value="jpeg">JPEG</option>
                            </select>
                        </label>
                        <label>
                            <span>JPEG compression</span>
                            <input class="form-control form-control-sm" type="number" min="0" max="100" @bind="_imageCompression" disabled="@(_imageFormat != "jpeg")" />
                        </label>
                    </div>
                    <label class="publish-full">
                        <span>Generated alt text</span>
                        <input class="form-control form-control-sm" @bind="_generatedAltText" />
                    </label>
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_generatingImage" @onclick="GenerateImageAsync">
                        @(_generatingImage ? "Generating..." : "Generate image")
                    </button>
                }

                <div class="publish-asset-list">
                    @foreach (var asset in _workspace.Assets)
                    {
                        var isCover = _workspace.Profile.SelectedCoverAssetId == asset.Id;
                        <div class="publish-asset-row">
                            <button type="button" class="publish-asset-preview-button" title="Open image" @onclick="() => OpenAssetModal(asset)">
                                <img class="publish-asset-preview" src="@asset.PreviewDataUrl" alt="@AssetAlt(asset)" />
                            </button>
                            <div class="publish-asset-info">
                                <strong>@asset.FileName</strong>
                                <span>@asset.Source - @FormatBytes(asset.SizeBytes)</span>
                            </div>
                            <div class="publish-asset-actions">
                                <button type="button" class="btn btn-sm @(isCover ? "btn-success" : "btn-outline-secondary")" @onclick="() => SetCoverAsync(asset.Id)">
                                    @(isCover ? "Cover" : "Set cover")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAssetAsync(asset.Id)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="publish-card">
                <div class="publish-card-title">Interior Images</div>
                @if (!string.IsNullOrWhiteSpace(_placementError))
                {
                    <div class="alert alert-danger py-2 small">@_placementError</div>
                }
                @if (_workspace.Assets.Count == 0)
                {
                    <p class="text-muted small">Add an asset before placing images.</p>
                }
                else
                {
                    <label class="publish-full">
                        <span>Asset</span>
                        <select class="form-select form-select-sm" @bind="_placementAssetId">
                            <option value="">Select asset</option>
                            @foreach (var asset in _workspace.Assets)
                            {
                                <option value="@asset.Id">@asset.FileName</option>
                            }
                        </select>
                    </label>
                    <label class="publish-full">
                        <span>Target</span>
                        <select class="form-select form-select-sm" @bind="_placementTargetKey">
                            <option value="">Select target</option>
                            @foreach (var publishSection in _workspace.Sections.Where(candidate => candidate.ActId is not null))
                            {
                                <option value="@TargetKey(PublishOutlineTargetKind.Act, publishSection.ActId!.Value)">Act: @publishSection.Title</option>
                            }
                            @foreach (var chapter in _workspace.Sections.SelectMany(candidate => candidate.Chapters))
                            {
                                <option value="@TargetKey(PublishOutlineTargetKind.Chapter, chapter.Id)">Chapter: @chapter.Title</option>
                            }
                        </select>
                    </label>
                    <label class="publish-full">
                        <span>Placement</span>
                        <select class="form-select form-select-sm" @bind="_placementKind">
                            <option value="@PublishImagePlacementKind.BeforeAct">Before act</option>
                            <option value="@PublishImagePlacementKind.AfterAct">After act</option>
                            <option value="@PublishImagePlacementKind.BeforeChapter">Before chapter</option>
                            <option value="@PublishImagePlacementKind.ChapterOpening">Chapter opening</option>
                            <option value="@PublishImagePlacementKind.ChapterEnding">Chapter ending</option>
                            <option value="@PublishImagePlacementKind.AfterChapter">After chapter</option>
                        </select>
                    </label>
                    <label class="publish-full">
                        <span>Caption</span>
                        <input class="form-control form-control-sm" @bind="_placementCaption" />
                    </label>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddPlacementAsync">Add placement</button>
                }

                <div class="publish-placement-list">
                    @foreach (var placement in _workspace.Placements)
                    {
                        <div class="publish-placement-row">
                            <div>
                                <strong>@placement.PlacementKind</strong>
                                <span>@placement.TargetKind: @placement.TargetTitle</span>
                                <span>@placement.AssetFileName</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePlacementAsync(placement.Id)">Delete</button>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>

    @if (_selectedAsset is not null)
    {
        <div class="modal-backdrop fade show" @onclick="CloseAssetModal"></div>
        <div class="modal d-block publish-asset-modal" tabindex="-1" role="dialog" aria-modal="true" @onclick="CloseAssetModal">
            <div class="modal-dialog modal-fullscreen" role="document" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="publish-modal-title">
                            <h5 class="modal-title">@_selectedAsset.FileName</h5>
                            <span>@_selectedAsset.Source - @FormatBytes(_selectedAsset.SizeBytes)</span>
                        </div>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAssetModal"></button>
                    </div>
                    <div class="modal-body publish-asset-modal-body">
                        <img src="@_selectedAsset.PreviewDataUrl" alt="@AssetAlt(_selectedAsset)" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAssetModal">Close</button>
                        <button type="button" class="btn btn-primary" @onclick="() => DownloadAssetAsync(_selectedAsset)">Download</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private const long MaxAssetBytes = 15L * 1024 * 1024;
    private const int MaxReferenceAssets = 4;
    private static readonly TimeSpan ProfileAutosaveDelay = TimeSpan.FromMilliseconds(900);
    private static readonly TimeSpan CoverLayoutAutosaveDelay = TimeSpan.FromMilliseconds(500);

    private readonly SemaphoreSlim _profileSaveGate = new(1, 1);
    private readonly SemaphoreSlim _coverLayoutSaveGate = new(1, 1);
    private PublishWorkspaceView? _workspace;
    private ProfileDraft _profile = new();
    private PublishCoverLayoutView? _coverLayout;
    private PublishAssetView? _selectedAsset;
    private Guid? _loadedProjectId;
    private bool _loading;
    private bool _exporting;
    private bool _generatingImage;
    private bool _codexConnected;
    private string? _profileError;
    private string? _coverLayoutError;
    private string? _outlineError;
    private string? _assetError;
    private string? _assetStatus;
    private string? _placementError;
    private string? _exportError;
    private string _uploadAltText = string.Empty;
    private string _imagePrompt = string.Empty;
    private string _imageSize = "auto";
    private string _imageQuality = "auto";
    private string _imageFormat = "png";
    private int? _imageCompression = 75;
    private string _generatedAltText = string.Empty;
    private string _placementAssetId = string.Empty;
    private string _placementTargetKey = string.Empty;
    private List<Guid> _selectedReferenceAssetIds = [];
    private PublishImagePlacementKind _placementKind = PublishImagePlacementKind.ChapterOpening;
    private string _placementCaption = string.Empty;
    private PublishExportFormat _exportFormat = PublishExportFormat.Epub;
    private IJSObjectReference? _downloadModule;
    private CancellationTokenSource? _profileAutosaveCts;
    private CancellationTokenSource? _coverLayoutAutosaveCts;
    private IDisposable? _navHandlerRegistration;
    private long _profileDraftVersion;
    private long _profileSavedVersion;
    private long _coverLayoutDraftVersion;
    private long _coverLayoutSavedVersion;
    private ProfileSaveState _profileSaveState = ProfileSaveState.Idle;
    private CoverLayoutSaveState _coverLayoutSaveState = CoverLayoutSaveState.Idle;
    private DateTime? _profileLastSavedAt;
    private DateTime? _coverLayoutLastSavedAt;
    private bool _disposing;

    private bool ProfileSaveInProgress => _profileSaveState == ProfileSaveState.Saving;

    private string ProfileSaveStatusClass => _profileSaveState switch
    {
        ProfileSaveState.Dirty => "small text-warning",
        ProfileSaveState.Saved => "small text-success",
        ProfileSaveState.SaveFailed => "small text-danger",
        _ => "small text-muted",
    };

    private string CoverLayoutSaveStatusClass => _coverLayoutSaveState switch
    {
        CoverLayoutSaveState.Dirty => "small text-warning",
        CoverLayoutSaveState.Saved => "small text-success",
        CoverLayoutSaveState.SaveFailed => "small text-danger",
        _ => "small text-muted",
    };

    private string PrintUrl => Project is null
        ? "#"
        : $"/projects/{Uri.EscapeDataString(Project.Slug)}/manuscript/print?autoprint=true";

    private PublishCoverLayoutView? CurrentCoverLayout => _coverLayout ?? _workspace?.Profile.CoverLayout;

    private PublishAssetView? SelectedCoverAsset =>
        _workspace?.Profile.SelectedCoverAssetId is Guid coverId
            ? _workspace.Assets.FirstOrDefault(asset => asset.Id == coverId)
            : null;

    private string CoverTitleText =>
        string.IsNullOrWhiteSpace(_profile.TitleOverride)
            ? _workspace?.Profile.ProjectName ?? string.Empty
            : _profile.TitleOverride;

    private string ProfileSaveStatusText() => _profileSaveState switch
    {
        ProfileSaveState.Dirty => "Unsaved changes",
        ProfileSaveState.Saving => "Saving...",
        ProfileSaveState.Saved when _profileLastSavedAt is { } savedAt => $"Saved {savedAt:HH:mm:ss}",
        ProfileSaveState.SaveFailed when !string.IsNullOrWhiteSpace(_profileError) => $"Save failed: {_profileError}",
        ProfileSaveState.SaveFailed => "Save failed",
        _ => string.Empty,
    };

    private string CoverLayoutSaveStatusText() => _coverLayoutSaveState switch
    {
        CoverLayoutSaveState.Dirty => "Unsaved changes",
        CoverLayoutSaveState.Saving => "Saving...",
        CoverLayoutSaveState.Saved when _coverLayoutLastSavedAt is { } savedAt => $"Saved {savedAt:HH:mm:ss}",
        CoverLayoutSaveState.SaveFailed when !string.IsNullOrWhiteSpace(_coverLayoutError) => $"Save failed: {_coverLayoutError}",
        CoverLayoutSaveState.SaveFailed => "Save failed",
        _ => string.Empty,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null || _loadedProjectId == Project.Id) return;
        if (_loadedProjectId is not null)
        {
            await FlushProfileSaveAsync();
            await FlushCoverLayoutSaveAsync();
        }

        _loadedProjectId = Project.Id;
        await ReloadAsync(resetProfile: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _navHandlerRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
            _downloadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownloads.js");
        }
    }

    private async Task ReloadAsync(bool resetProfile)
    {
        if (Project is null) return;
        if (!resetProfile)
            await FlushCoverLayoutSaveAsync();

        _loading = true;
        try
        {
            _codexConnected = await Providers.IsCodexConnectedAsync();
            _workspace = await Publishing.GetWorkspaceAsync(Project.Id);
            CancelCoverLayoutAutosave();
            _coverLayout = _workspace.Profile.CoverLayout;
            _coverLayoutDraftVersion = 0;
            _coverLayoutSavedVersion = 0;
            _coverLayoutSaveState = CoverLayoutSaveState.Idle;
            _coverLayoutLastSavedAt = null;
            _coverLayoutError = null;
            if (resetProfile)
            {
                CancelProfileAutosave();
                _profile = ProfileDraft.From(_workspace.Profile);
                _profileDraftVersion = 0;
                _profileSavedVersion = 0;
                _profileSaveState = ProfileSaveState.Idle;
                _profileLastSavedAt = null;
                _profileError = null;
            }
            PruneAssetSelections();
            if (string.IsNullOrEmpty(_placementAssetId) && _workspace.Assets.Count > 0)
                _placementAssetId = _workspace.Assets[0].Id.ToString();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        await FlushProfileSaveAsync();
    }

    private void ScheduleProfileAutosave()
    {
        if (_loadedProjectId is null && Project is null) return;

        _profileDraftVersion++;
        _profileError = null;
        _profileSaveState = ProfileSaveState.Dirty;
        CancelProfileAutosave();

        _profileAutosaveCts = new CancellationTokenSource();
        _ = DebouncedProfileSaveAsync(_profileAutosaveCts.Token);
    }

    private async Task DebouncedProfileSaveAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(ProfileAutosaveDelay, cancellationToken);
            if (_disposing) return;

            await InvokeAsync(SaveProfileCoreAsync);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task FlushProfileSaveAsync()
    {
        CancelProfileAutosave();
        await SaveProfileCoreAsync();
    }

    private async Task SaveProfileCoreAsync()
    {
        var projectId = _loadedProjectId ?? Project?.Id;
        if (projectId is not Guid targetProjectId) return;

        await _profileSaveGate.WaitAsync();
        try
        {
            while (_profileSavedVersion != _profileDraftVersion)
            {
                var versionToSave = _profileDraftVersion;
                var update = _profile.ToUpdate();
                _profileError = null;
                _profileSaveState = ProfileSaveState.Saving;
                await NotifyProfileSaveStateChangedAsync();

                await Publishing.SaveProfileAsync(targetProjectId, update);
                _profileSavedVersion = versionToSave;
                _profileLastSavedAt = DateTime.Now;
                _profileSaveState = _profileSavedVersion == _profileDraftVersion
                    ? ProfileSaveState.Saved
                    : ProfileSaveState.Dirty;
            }
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
            _profileSaveState = ProfileSaveState.SaveFailed;
        }
        finally
        {
            _profileSaveGate.Release();
            await NotifyProfileSaveStateChangedAsync();
        }
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        await FlushProfileSaveAsync();
        await FlushCoverLayoutSaveAsync();
        if ((_profileSaveState == ProfileSaveState.SaveFailed && _profileSavedVersion != _profileDraftVersion)
            || (_coverLayoutSaveState == CoverLayoutSaveState.SaveFailed && _coverLayoutSavedVersion != _coverLayoutDraftVersion))
        {
            context.PreventNavigation();
        }
    }

    private async Task NotifyProfileSaveStateChangedAsync()
    {
        if (_disposing) return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private void CancelProfileAutosave()
    {
        var cts = _profileAutosaveCts;
        if (cts is null) return;

        _profileAutosaveCts = null;
        cts.Cancel();
        cts.Dispose();
    }

    private Task OnCoverLayoutChangedAsync(PublishCoverLayoutView layout)
    {
        _coverLayout = layout;
        _coverLayoutDraftVersion++;
        _coverLayoutError = null;
        _coverLayoutSaveState = CoverLayoutSaveState.Dirty;
        CancelCoverLayoutAutosave();

        _coverLayoutAutosaveCts = new CancellationTokenSource();
        _ = DebouncedCoverLayoutSaveAsync(_coverLayoutAutosaveCts.Token);
        return Task.CompletedTask;
    }

    private async Task DebouncedCoverLayoutSaveAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(CoverLayoutAutosaveDelay, cancellationToken);
            if (_disposing) return;

            await InvokeAsync(SaveCoverLayoutCoreAsync);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task FlushCoverLayoutSaveAsync()
    {
        CancelCoverLayoutAutosave();
        await SaveCoverLayoutCoreAsync();
    }

    private async Task SaveCoverLayoutCoreAsync()
    {
        var projectId = _loadedProjectId ?? Project?.Id;
        if (projectId is not Guid targetProjectId || _coverLayout is null) return;

        await _coverLayoutSaveGate.WaitAsync();
        try
        {
            while (_coverLayoutSavedVersion != _coverLayoutDraftVersion)
            {
                var versionToSave = _coverLayoutDraftVersion;
                var layout = _coverLayout;
                _coverLayoutError = null;
                _coverLayoutSaveState = CoverLayoutSaveState.Saving;
                await NotifyProfileSaveStateChangedAsync();

                await Publishing.SaveCoverLayoutAsync(targetProjectId, layout);
                _coverLayoutSavedVersion = versionToSave;
                _coverLayoutLastSavedAt = DateTime.Now;
                _coverLayoutSaveState = _coverLayoutSavedVersion == _coverLayoutDraftVersion
                    ? CoverLayoutSaveState.Saved
                    : CoverLayoutSaveState.Dirty;
            }
        }
        catch (Exception ex)
        {
            _coverLayoutError = ex.Message;
            _coverLayoutSaveState = CoverLayoutSaveState.SaveFailed;
        }
        finally
        {
            _coverLayoutSaveGate.Release();
            await NotifyProfileSaveStateChangedAsync();
        }
    }

    private void CancelCoverLayoutAutosave()
    {
        var cts = _coverLayoutAutosaveCts;
        if (cts is null) return;

        _coverLayoutAutosaveCts = null;
        cts.Cancel();
        cts.Dispose();
    }

    private async Task FlushAllSavesAsync()
    {
        await FlushProfileSaveAsync();
        await FlushCoverLayoutSaveAsync();
    }

