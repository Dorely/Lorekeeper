    private void ResumeActivePreparation(PublicationTargetKind kind, Guid? releaseId)
    {
        var generation = ++_pollGeneration;
        if (_preparations.FirstOrDefault(item => item.Status is PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing) is { } job)
            _ = ResumeActivePreparationAsync(job.Id, kind, releaseId, generation);
    }

    private async Task ResumeActivePreparationAsync(Guid jobId, PublicationTargetKind kind, Guid? releaseId, int generation)
    {
        try { await PollAsync(jobId, kind, releaseId, generation); }
        catch (OperationCanceledException) when (_dispose.IsCancellationRequested || generation != _pollGeneration) { }
        catch (Exception exception)
        {
            if (generation == _pollGeneration)
            {
                _error = exception.Message;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task PollAsync(Guid jobId, PublicationTargetKind kind, Guid? editionId, int generation)
    {
        if (Project is null) return;
        while (!_dispose.IsCancellationRequested && generation == _pollGeneration)
        {
            await ReloadPreparationsAsync(kind, editionId);
            var job = _preparations.First(item => item.Id == jobId);
            await InvokeAsync(StateHasChanged);
            if (job.Status is not (PublicationPreparationStatus.Queued or PublicationPreparationStatus.Preparing)) break;
            await Task.Delay(350, _dispose.Token);
        }
        if (generation != _pollGeneration) return;
        _artifacts = kind == PublicationTargetKind.CoreBook
            ? (await Renders.ListCoreAsync(Project.Id, _dispose.Token)).SelectMany(item => item.Artifacts).OrderByDescending(item => item.CreatedAt).ToList()
            : await Renders.ListArtifactsAsync(Project.Id, editionId!.Value, _dispose.Token);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateReleaseAsync()
    {
        if (Project is null) return; _busy = true; _addReleaseError = null;
        try
        {
            var vendor = _newFormat is PublicationEditionFormat.Paperback or PublicationEditionFormat.Hardcover ? _newVendor : PublicationVendor.Generic;
            var requestedName = string.IsNullOrWhiteSpace(_newReleaseName)
                ? PublicationReleaseNaming.DefaultName(_newFormat, vendor)
                : _newReleaseName.Trim();
            var created = await Releases.CreateAsync(Project.Id, new PublicationEditionCreate(requestedName, _newFormat, vendor));
            if (_newFormat is PublicationEditionFormat.Paperback or PublicationEditionFormat.Hardcover
                && NewPrintProduct() is { } product)
            {
                var trim = ParseTrim(_newPrintTrim);
                created = await Releases.PatchOverridesAsync(Project.Id, created.Id, new(
                    ExpectedRevision: created.Revision,
                    PrintProductKey: product.Key,
                    PrintFinish: _newPrintFinish,
                    PrintCoverMode: _newPrintCoverMode,
                    PageWidthInches: trim?.Width,
                    PageHeightInches: trim?.Height));
            }
            _addReleaseOpen = false;
            _addReleaseError = null;
            await SelectReleaseAsync(created.Id);
            _notice = $"{created.Name} created with safe defaults from Core Book.";
        }
        catch (Exception exception) { _addReleaseError = exception.Message; }
        finally { _busy = false; }
    }

