    private bool? BoolValue(PublicationEditionOverrideField field, bool value) => _releaseOverrides.Contains(field) ? value : null;
    private double? DesignValue(PublicationEditionOverrideField field, double value) => _releaseOverrides.Contains(field) ? value : null;

