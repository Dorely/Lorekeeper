            ? _newPrintTrim
            : product.TrimSizes.FirstOrDefault(trim => trim == "6x9") ?? product.TrimSizes.FirstOrDefault() ?? string.Empty;
        _newPrintFinish = product.Finishes.Contains(_newPrintFinish) ? _newPrintFinish : product.Finishes.FirstOrDefault();
        _newPrintCoverMode = product.CoverModes.Contains(_newPrintCoverMode) ? _newPrintCoverMode : product.CoverModes.FirstOrDefault();
