    private void QueueFormAutosave()
    {
        var version = ++_formChangeVersion;
        _formAutosave?.Cancel();
        _formAutosave?.Dispose();
        _formAutosave = CancellationTokenSource.CreateLinkedTokenSource(_dispose.Token);
        _ = AutosaveFormsAsync(version, _formAutosave.Token);
    }

    private async Task AutosaveFormsAsync(long version, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(500, cancellationToken);
            await InvokeAsync(async () =>
            {
                await SavePendingAsync();
                if (version != _formChangeVersion && !_dispose.IsCancellationRequested)
                    QueueFormAutosave();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }
