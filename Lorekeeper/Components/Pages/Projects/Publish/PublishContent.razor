    public async ValueTask DisposeAsync()
    {
        _disposing = true;
        _navHandlerRegistration?.Dispose();
        try { await FlushProfileSaveAsync(); } catch { }

        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_autoSizer is not null)
        {
            try { await _autoSizer.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

