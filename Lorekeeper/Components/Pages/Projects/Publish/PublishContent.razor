    private string CurrentTrimKey() => SelectedProduct()?.TrimSizes.FirstOrDefault(TrimMatches)
        ?? (SelectedProduct()?.AllowsCustomTrim == true ? "custom" : string.Empty);
    private bool TrimMatches(string trim)
    {
        var parts = trim.Split('x', StringSplitOptions.TrimEntries);
        return parts.Length == 2
            && double.TryParse(parts[0], System.Globalization.CultureInfo.InvariantCulture, out var width)
            && double.TryParse(parts[1], System.Globalization.CultureInfo.InvariantCulture, out var height)
            && Math.Abs(width - _releaseDraft.PageWidthInches) < .0001
            && Math.Abs(height - _releaseDraft.PageHeightInches) < .0001;
    }
    private void EnsureProductTrim(PrintProductDefinition product)
    {
        if (product.AllowsCustomTrim || product.TrimSizes.Any(TrimMatches) || product.TrimSizes.Count == 0) return;
        ApplyTrim(product.TrimSizes[0]);
    }
    private void PrintTrimChanged(ChangeEventArgs args)
    {
        var trim = args.Value?.ToString() ?? string.Empty;
        if (trim != "custom") ApplyTrim(trim);
        MarkReleaseDirty();
    }
    private void ApplyTrim(string trim)
    {
        var parts = trim.Split('x', StringSplitOptions.TrimEntries);
        if (parts.Length != 2
            || !double.TryParse(parts[0], System.Globalization.CultureInfo.InvariantCulture, out var width)
            || !double.TryParse(parts[1], System.Globalization.CultureInfo.InvariantCulture, out var height)) return;
        _releaseDraft.PageWidthInches = width;
        _releaseDraft.PageHeightInches = height;
    }
    private string SelectedProductDescription() { var item = SelectedProduct(); return item is null ? "Choose an exact printer product." : $"{item.PaperName} - {(item.BasisWeightPounds is int pounds ? $"{pounds} lb / {item.Gsm} gsm" : "printer supplied weight")} - registry {PrintProducts.Version}"; }
    private string CurrentSpineDescription()
    {
        var pages = _artifacts.FirstOrDefault(item => item.Kind == PublicationArtifactKind.InteriorPdf && !item.IsLegacy && !item.IsStale)?.PageCount;
        if (pages is not > 0 || _workspace is null) return "Spine width is calculated after the interior layout.";
        try
        {
            var edition = new PublicationEdition
            {
                Name = _releaseDraft.Name,
                PrintProductKey = _releaseDraft.PrintProductKey,
                PrintFinish = _releaseDraft.PrintFinish,
                PrintCoverMode = _releaseDraft.PrintCoverMode,
                GenericPrintTemplateJson = _releaseDraft.GenericPrintTemplateJson,
                PageWidthInches = _releaseDraft.PageWidthInches,
                PageHeightInches = _releaseDraft.PageHeightInches,
            };
            var geometry = PrintGeometry.Calculate(edition, pages.Value);
            return $"Current interior: {geometry.SubmittedPageCount} submitted / {geometry.NormalizedCoverPageCount} cover-calculation pages - {geometry.SpineWidthInches:0.#####} in spine.";
        }
        catch (InvalidOperationException)
        {
            return "Spine width needs a compatible page count and printer template.";
        }
    }
    private IReadOnlyList<PublicationArtifactKind> ReleaseArtifactKinds(PublicationEditionFormat format)
    {
        if (format == PublicationEditionFormat.Epub) return [PublicationArtifactKind.Epub, PublicationArtifactKind.FrontCoverImage, PublicationArtifactKind.PublicationPackage];
        if (format == PublicationEditionFormat.DigitalPdf) return [PublicationArtifactKind.BookPdf, PublicationArtifactKind.PublicationPackage];
        var product = SelectedProduct();
        var kinds = new List<PublicationArtifactKind> { PublicationArtifactKind.InteriorPdf };
        if (product?.RequiresPerfectBoundCover == true) kinds.Add(PublicationArtifactKind.PerfectBoundCoverPdf);
        if (product?.RequiresCaseCover == true) kinds.Add(PublicationArtifactKind.CaseCoverPdf);
        if (product?.RequiresDustJacket == true) kinds.Add(PublicationArtifactKind.DustJacketPdf);
        if (product?.RequiresClothManifest == true) kinds.Add(PublicationArtifactKind.PrintSetupManifest);
        kinds.Add(PublicationArtifactKind.PublicationPackage);
        return kinds;
    }
