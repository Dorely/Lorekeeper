@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IPrintPreparationService Printing

<section class="publication-pdf-preview" aria-label="PDF pages" @ref="_root">
    <header class="publication-pdf-preview-toolbar">
        <div class="btn-group btn-group-sm" role="group" aria-label="Page display">
            <button type="button" class="btn @ButtonClass(!_facingPages)" @onclick="() => _facingPages = false">Single page</button>
            <button type="button" class="btn @ButtonClass(_facingPages)" @onclick="() => _facingPages = true">Facing pages</button>
        </div>
        @if (_facingPages)
        {
            <button type="button"
                    class="btn btn-sm @ButtonClass(_showFacingSeam)"
                    aria-pressed="@_showFacingSeam"
                    title="Add space between the left and right pages"
                    @onclick="() => _showFacingSeam = !_showFacingSeam">
                @(_showFacingSeam ? "Hide page seam" : "Show page seam")
            </button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(PageCount <= 0)" @onclick="() => _printOpen = true">Print</button>
        <span aria-live="polite">Page @_currentPage of @PageCount.ToString("N0")</span>
    </header>

    @if (PageCount <= 0)
    {
        <div class="publication-pdf-preview-empty" role="status">
            Page information is unavailable. Regenerate this PDF before previewing it.
        </div>
    }
    else
    {
        <div class="publication-pdf-preview-scroll @(_facingPages ? "facing" : "single") @(_facingPages && _showFacingSeam ? "show-seam" : null)">
            @if (_facingPages)
            {
                @foreach (var spread in BuildFacingSpreads(PageCount))
                {
                    <div class="publication-pdf-preview-spread">
                        @foreach (var pageNumber in spread)
                        {
                            if (pageNumber is int page)
                            {
                                @RenderPage(page)
                            }
                            else
                            {
                                <span class="publication-pdf-preview-page blank" aria-hidden="true"></span>
                            }
                        }
                    </div>
                }
            }
            else
            {
                @for (var page = 1; page <= PageCount; page++)
                {
                    <div class="publication-pdf-preview-spread">
                        @RenderPage(page)
                    </div>
                }
            }
        </div>
    }
</section>

@if (_printOpen)
{
    <PrintPreviewDialog SourceFactory="CreatePrintSourceAsync" Closed="() => _printOpen = false" />
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid ArtifactId { get; set; }
    [Parameter, EditorRequired] public int PageCount { get; set; }

    private bool _facingPages;
    private bool _showFacingSeam;
    private bool _initialized;
    private bool _printOpen;
    private int _currentPage = 1;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PublicationPdfPreview>? _reference;
    private Guid _loadedArtifact;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/pdf-print-selection.js");
            _reference = DotNetObjectReference.Create(this);
        }
        if (_module is not null)
            await _module.InvokeVoidAsync("observe", _root, _reference);
    }

    [JSInvokable]
    public Task SetCurrentPage(int page)
    {
        if (page >= 1 && page <= PageCount && page != _currentPage)
        {
            _currentPage = page;
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    private Task<PrintSource> CreatePrintSourceAsync(CancellationToken cancellationToken) =>
        Printing.CreatePdfAsync(ProjectId, ArtifactId, _currentPage, cancellationToken);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }

    protected override void OnParametersSet()
    {
        if (_initialized && _loadedArtifact == ArtifactId)
            return;
        _loadedArtifact = ArtifactId;
        _currentPage = 1;
        _printOpen = false;
        _facingPages = PageCount > 1;
        _initialized = true;
    }

    private static IEnumerable<int?[]> BuildFacingSpreads(int pageCount)
    {
        yield return [null, 1];
        for (var page = 2; page <= pageCount; page += 2)
            yield return [page, page + 1 <= pageCount ? page + 1 : null];
    }

    // A single-page PDF has no page to choose, so it shows no print-selection ring over its artwork.
    private RenderFragment RenderPage(int pageNumber) => @<figure class="publication-pdf-preview-page @(PageCount > 1 && pageNumber == _currentPage ? "print-current" : null)" data-page-number="@pageNumber" aria-label="PDF page @pageNumber" tabindex="0" role="button" aria-pressed="@(pageNumber == _currentPage)">
        <img src="@PageUrl(pageNumber)"
             alt="PDF page @pageNumber"
             loading="@(pageNumber <= 3 ? "eager" : "lazy")"
             decoding="async" />
    </figure>;

    private string PageUrl(int pageNumber) =>
        $"/projects/{ProjectId:N}/publish/artifacts/{ArtifactId:N}/pages/{pageNumber}.png?width=1200";

    private static string ButtonClass(bool active) => active ? "btn-primary" : "btn-outline-secondary";
}
