@using Lorekeeper.ChatTurns
@using Lorekeeper.Components.Chat
@using Lorekeeper.Components.Pages.Projects.Outline
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Tokens
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IPublishChatService Chat
@inject IPublishChatTurnRunner ChatTurns
@inject IChatImageAttachmentService ImageAttachments
@inject ILlmProviderService Providers
@inject ITokenCounter TokenCounter
@inject ChatTokenLimitResolver TokenLimits

<ChatSurface Title="Publish Assistant"
             ProjectId="@ProjectId"
             Surface="ChatTurnSurface.Publish"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel, ConversationTokenLimit)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel, ConversationTokenLimit, ActiveModelId)"
             ShowTokenResetSuggestion="@_conversationTokens.ShouldSuggestReset(ConversationTokenLimit)"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Ask about Core Book, releases, or prepared files..."
             Running="@_running"
             ComposerDisabled="@(ChatDisabled || _running || WorkspaceRefreshing)"
             SendDisabled="@(ChatDisabled || WorkspaceRefreshing || string.IsNullOrWhiteSpace(_input))"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
        <button type="button" class="btn btn-link btn-sm publish-chat-reset"
                title="Start over" disabled="@(ChatDisabled || TurnActive)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        @if (ChatDisabled)
        {
            <div class="alert alert-warning py-2 small mb-2">
                LLM chat is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
            </div>
        }
        <div class="publish-chat-context">
            <span>@(WorkspaceContext?.TargetLabel ?? (SelectedEditionId is null ? "Core Book" : "Selected release"))</span>
        </div>
    </ExtraControls>
</ChatSurface>

@code {
    private const string ConversationTokenUnitLabel = "chat tokens";
    private const string ConversationTokenTitleLabel = "model input token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? SelectedEditionId { get; set; }
    [Parameter] public PublishAssistantWorkspaceContext? WorkspaceContext { get; set; }
    [Parameter] public bool WorkspaceRefreshing { get; set; }
    [Parameter] public Func<Task<PublishAssistantWorkspaceContext?>>? PrepareTurnAsync { get; set; }
    [Parameter] public EventCallback<PublishWorkspaceMutated> OnWorkspaceMutated { get; set; }
    [Parameter] public EventCallback<bool> OnRunningChanged { get; set; }

    private PublishConversation? _conversation;
    private List<PublishMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private IReadOnlyDictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>> _messageImages =
        new Dictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>>();
    private ChatLiveTurn? _live;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private ChatProviderAvailability? _chatAvailability;
    private CancellationTokenSource? _listenCts;
    private Guid? _listeningTurnId;
    private Guid? _loadedProjectId;
    private Guid? _promptEditionId;
    private PublishAssistantWorkspaceContext? _promptWorkspaceContext;
    private string _systemPrompt = string.Empty;
    private string _input = string.Empty;
    private string? _pendingUserText;
    private string? _error;
    private bool _loading = true;
    private bool _running;
    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;

    private string? ActiveModelId => _chatAvailability?.Provider?.ModelId;
    private int ConversationTokenLimit => TokenLimits.Resolve(ActiveModelId);
    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private bool TurnActive => _running || ChatTurns.GetActiveTurn(ProjectId) is not null;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty)
            return;
        if (_loadedProjectId != ProjectId)
        {
            _loadedProjectId = ProjectId;
            await LoadAsync();
            return;
        }
        if (_promptEditionId != SelectedEditionId || _promptWorkspaceContext != WorkspaceContext)
        {
            _promptEditionId = SelectedEditionId;
            _promptWorkspaceContext = WorkspaceContext;
            _systemPrompt = await Chat.GetSystemPromptAsync(ProjectId, SelectedEditionId, WorkspaceContext);
            UpdateConversationTokenCount();
        }
    }

    private async Task LoadAsync()
    {
        StopListening();
        _loading = true;
        _error = null;
        try
        {
            _conversation = await Chat.GetOrCreateAsync(ProjectId);
            _messages = (await Chat.LoadMessagesAsync(_conversation.Id)).ToList();
            _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Publish);
            _chatAvailability = await Providers.GetDefaultChatProviderAvailabilityAsync();
            _promptEditionId = SelectedEditionId;
            _promptWorkspaceContext = WorkspaceContext;
            _systemPrompt = await Chat.GetSystemPromptAsync(ProjectId, SelectedEditionId, WorkspaceContext);
            var activeTurn = ChatTurns.GetActiveTurn(ProjectId);
            RebuildRenderable(activeTurn?.StartedAtUtc);
            if (activeTurn is not null)
            {
                _renderable.Add(new ChatRenderableMessage(
                    Guid.NewGuid(),
                    ChatMessageRole.User,
                    ChatMessageStatus.Completed,
                    ChatImageParts.BuildUserParts(activeTurn.UserText, activeTurn.Images)));
                _pendingUserText = activeTurn.UserText;
                _live = new ChatLiveTurn();
                _running = true;
                await ListenToActiveTurnAsync(activeTurn);
            }
            else
            {
                _pendingUserText = null;
                _live = null;
                _running = false;
            }
            await OnRunningChanged.InvokeAsync(_running);
            UpdateConversationTokenCount();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync(ChatComposerSubmission submission)
    {
        var text = submission.Text.Trim();
        if (_running || string.IsNullOrWhiteSpace(text))
            return;
        if (ChatDisabled)
        {
            _error = ChatDisabledMessage;
            return;
        }
        if (submission.Images.Count > 0
            && (_chatAvailability?.Provider is null
                || !await Providers.IsVisionProviderWorkingAsync(_chatAvailability.Provider.Id)))
        {
            _error = "The active chat provider has not passed the vision check. Run Test in Settings > Providers before sending images.";
            return;
        }

        var turnWorkspaceContext = WorkspaceContext;
        try
        {
            if (PrepareTurnAsync is not null)
                turnWorkspaceContext = await PrepareTurnAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            return;
        }

        _input = string.Empty;
        _running = true;
        await OnRunningChanged.InvokeAsync(true);
        _error = null;
        _resetComposerKey++;
        _renderable.Add(new ChatRenderableMessage(
            Guid.NewGuid(),
            ChatMessageRole.User,
            ChatMessageStatus.Completed,
            ChatImageParts.BuildUserParts(text, submission.Images)));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        _autoFollowKey++;
        RequestScroll(force: true);
        StateHasChanged();

        if (!ChatTurns.TryStart(ProjectId, SelectedEditionId, turnWorkspaceContext, text, submission.Images))
        {
            _error = "Publish Assistant already has a running turn.";
            if (ChatTurns.GetActiveTurn(ProjectId) is { } existingTurn)
            {
                _running = true;
                await OnRunningChanged.InvokeAsync(true);
                await ListenToActiveTurnAsync(existingTurn);
            }
            else
            {
                await ReleaseRunningUiAsync();
            }
            return;
        }

        if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
            await ListenToActiveTurnAsync(activeTurn);
    }

    private async Task ResetAsync()
    {
        if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
        {
            _error = "Publish Assistant is still working in another window. Stop or wait for that turn before resetting the conversation.";
            _running = true;
            await OnRunningChanged.InvokeAsync(true);
            await ListenToActiveTurnAsync(activeTurn);
            return;
        }
        try
        {
            await Chat.ResetAsync(ProjectId);
            _loadedProjectId = null;
            await LoadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
    }

    private async Task ListenToActiveTurnAsync(ChatTurnSnapshot activeTurn)
    {
        if (_listeningTurnId == activeTurn.TurnId)
            return;
        StopListening();
        var subscription = ChatTurns.Subscribe(ProjectId);
        if (subscription is null)
        {
            await ReleaseRunningUiAsync();
            return;
        }
        _listeningTurnId = subscription.TurnId;
        _listenCts = new CancellationTokenSource();
        _ = ListenToTurnAsync(subscription, _listenCts.Token);
        await Task.CompletedTask;
    }

    private async Task ListenToTurnAsync(
        IChatTurnSubscription<PublishTurnUpdate> subscription,
        CancellationToken cancellationToken)
    {
        await using (subscription)
        {
            try
            {
                await foreach (var update in subscription.ReadAllAsync(cancellationToken))
                    await InvokeAsync(async () => await ApplyTurnUpdateAsync(update));
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task ApplyTurnUpdateAsync(PublishTurnUpdate update)
    {
        switch (update)
        {
            case PublishTextDelta delta:
                _live!.AppendText(delta.Text);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case PublishToolCallStarted started:
                _live!.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case PublishToolCallArgumentsDelta arguments:
                _live!.AppendToolArguments(arguments.CallId, arguments.ArgumentsDelta, arguments.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case PublishToolCallCompleted completed:
                _live!.CompleteToolCall(
                    completed.CallId,
                    completed.Result,
                    completed.Error,
                    completed.DurationMs,
                    completed.Visuals.Select(ToChatImageVisual).ToList());
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case PublishWorkspaceMutated mutation:
                await OnWorkspaceMutated.InvokeAsync(mutation);
                break;
            case PublishAssistantMessageCompleted:
                await ReleaseRunningUiAsync();
                await ReloadFromDbAsync();
                RequestScroll();
                StateHasChanged();
                break;
            case PublishTurnError turnError:
                _error = turnError.Cancelled ? null : turnError.Message;
                await ReleaseRunningUiAsync();
                await ReloadFromDbAsync();
                RequestScroll();
                StateHasChanged();
                break;
        }
    }

    private void CancelAsync() => ChatTurns.Cancel(ProjectId);

    private async Task ReleaseRunningUiAsync()
    {
        _running = false;
        _live = null;
        _pendingUserText = null;
        await OnRunningChanged.InvokeAsync(false);
        UpdateConversationTokenCount();
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null)
            return;
        _messages = (await Chat.LoadMessagesAsync(_conversation.Id)).ToList();
        _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Publish);
        _promptWorkspaceContext = WorkspaceContext;
        _systemPrompt = await Chat.GetSystemPromptAsync(ProjectId, SelectedEditionId, WorkspaceContext);
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private void RebuildRenderable(DateTime? excludeMessagesCreatedAtOrAfter = null)
    {
        var messages = excludeMessagesCreatedAtOrAfter is { } cutoff
            ? _messages.Where(message => message.CreatedAt < cutoff).ToList()
            : _messages;
        var byCallId = messages
            .Where(message => message.Role == PublishMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);
        _renderable = [];
        foreach (var message in messages)
        {
            if (message.Role is PublishMessageRole.Tool or PublishMessageRole.System)
                continue;
            var parts = BuildMessageParts(message, byCallId);
            if (message.Role == PublishMessageRole.User
                && _messageImages.TryGetValue(message.Id, out var images))
            {
                ChatImageParts.Append(parts, images);
            }
            _renderable.Add(new ChatRenderableMessage(
                message.Id,
                message.Role == PublishMessageRole.User ? ChatMessageRole.User : ChatMessageRole.Assistant,
                ToChatStatus(message.Status),
                parts));
        }
    }

    private List<ChatMessagePart> BuildMessageParts(
        PublishMessage message,
        IReadOnlyDictionary<string, PublishMessage> byCallId)
    {
        if (message.Role != PublishMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];
        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls.Select((call, index) => new { Call = call, Index = index })
                         .OrderBy(item => item.Call.TextOffset!.Value)
                         .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));
            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls)
            parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private ChatToolChip BuildToolChip(
        ChatPersistedToolCall call,
        IReadOnlyDictionary<string, PublishMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var result);
        var chip = new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = result?.Status == PublishMessageStatus.Completed ? result.Content : null,
            Error = result?.Status == PublishMessageStatus.Failed ? result.ErrorMessage ?? result.Content : null,
            Completed = result is not null,
        };
        if (result is not null)
            chip.Visuals.AddRange(result.Visuals.OrderBy(visual => visual.SortOrder).Select(ToChatImageVisual));
        return chip;
    }

    private static ChatImageVisual ToChatImageVisual(PublishChatVisualAttachment visual) => new(
        visual.Id,
        visual.Title,
        visual.Caption,
        visual.PreviewImageUrl,
        visual.FullImageUrl,
        visual.Width,
        visual.Height);

    private ChatImageVisual ToChatImageVisual(PublishMessageVisual visual)
    {
        var contentUrl = $"/projects/{ProjectId:N}/publish-chat-visuals/{visual.Id:N}/content";
        return new ChatImageVisual(
            visual.Id,
            visual.Title,
            visual.Caption,
            $"{contentUrl}?maxEdge=640",
            contentUrl,
            visual.Width,
            visual.Height);
    }

    private static ChatMessageStatus ToChatStatus(PublishMessageStatus status) => status switch
    {
        PublishMessageStatus.Failed => ChatMessageStatus.Failed,
        PublishMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        PublishMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            ChatTranscriptTokenCounter.ModelReplayMessages(
                _messages,
                message => message.Role.ToString(),
                message => message.Content),
            message => message,
            _live,
            _pendingUserText,
            _systemPrompt);
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force)
            _forceScrollKey++;
    }

    private void StopListening()
    {
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        _listenCts = null;
        _listeningTurnId = null;
    }

    private void SetInput(string value) => _input = value;
    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        StopListening();
        return ValueTask.CompletedTask;
    }
}
