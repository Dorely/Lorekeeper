@using Lorekeeper.Chapters
@using Lorekeeper.Context
@using Lorekeeper.Ingest
@using Lorekeeper.Models
@using Lorekeeper.Outline
@using Lorekeeper.Projects
@inject IEntityService Entities
@inject IChapterService Chapters
@inject IActService Acts
@inject IIngestService Ingest
@inject IProjectService Projects
@inject IBookBriefService BookBriefs

@if (IsOpen && CurrentKind is not null)
{
    <div class="modal-backdrop fade show" @onclick="CloseAsync"></div>
    <div class="modal d-block context-detail-modal" tabindex="-1" role="dialog" aria-modal="true" @onclick="CloseAsync">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="context-detail-title-wrap">
                        <div class="text-muted small context-detail-kicker">@HeaderKicker</div>
                        <h5 class="modal-title">@HeaderTitle</h5>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (DetailReasons().Any())
                    {
                        <div class="context-detail-reasons">
                            @foreach (var reason in DetailReasons())
                            {
                                <span>@reason</span>
                            }
                        </div>
                    }
                    @if (FeedItem is not null)
                    {
                        <div class="context-detail-reasons">
                            <span>Origin: @FeedItem.Origin</span>
                            <span>Estimated tokens: @FeedItem.EstimatedTokens.ToString("N0")</span>
                            @if (FeedItem.IsProtected)
                            {
                                <span>Protected from automatic pruning</span>
                            }
                        </div>
                    }

                    @if (_loading)
                    {
                        <p class="text-muted small mb-0"><em>Loading...</em></p>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(_loadError))
                        {
                            <div class="alert alert-danger context-detail-alert">@_loadError</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_actionError))
                        {
                            <div class="alert alert-danger alert-dismissible context-detail-alert">
                                @_actionError
                                <button type="button" class="btn-close" @onclick="() => _actionError = null"></button>
                            </div>
                        }

                        @switch (CurrentKind.Value)
                        {
                            case ContextItemKind.Entity:
                                @RenderEntityDetail()
                                break;
                            case ContextItemKind.ChapterReference:
                                @RenderChapterDetail()
                                break;
                            case ContextItemKind.ActReference:
                                @RenderActDetail()
                                break;
                            case ContextItemKind.IngestSourceReference:
                                @RenderSourceDetail()
                                break;
                            case ContextItemKind.IngestSourceChunkReference:
                                @RenderSourceChunkDetail()
                                break;
                            case ContextItemKind.ProjectGuidance:
                                @RenderProjectGuidanceDetail()
                                break;
                            case ContextItemKind.BookBrief:
                                @RenderBookBriefDetail()
                                break;
                            default:
                                @RenderContextBodyDetail()
                                break;
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (CanSaveProjectGuidance)
                    {
                        <button type="button" class="btn btn-link" disabled="@_saving" @onclick="CloseAsync">Close</button>
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="SaveProjectGuidanceAsync">
                            @(_saving ? "Saving..." : "Save guidance")
                        </button>
                    }
                    else if (CanSaveBookBrief)
                    {
                        <button type="button" class="btn btn-link" disabled="@_saving" @onclick="CloseAsync">Close</button>
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="SaveBookBriefAsync">
                            @(_saving ? "Saving..." : "Save brief")
                        </button>
                    }
                    else if (CanSaveEntity)
                    {
                        <button type="button" class="btn btn-link" disabled="@_saving" @onclick="CloseAsync">Close</button>
                        <button type="button" class="btn btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_editEntityName))" @onclick="SaveEntityAsync">
                            @(_saving ? "Saving..." : "Save entity")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="CloseAsync">Close</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Project? Project { get; set; }
    [Parameter] public ContextItem? FeedItem { get; set; }
    [Parameter] public ContextRecommendation? Recommendation { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool AllowProjectGuidanceEdit { get; set; }
    [Parameter] public bool AllowBookBriefEdit { get; set; }
    [Parameter] public bool AllowEntityEdit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private StoryEntity? _entity;
    private List<EntityLink> _entityLinks = [];
    private Chapter? _chapter;
    private Act? _chapterAct;
    private Act? _act;
    private List<Chapter> _actChapters = [];
    private IngestSource? _source;
    private List<IngestSourceChunk> _sourceChunks = [];
    private IngestSourceChunk? _sourceChunk;
    private IngestSource? _chunkSource;
    private IngestSourceChunkExcerpt? _sourceChunkExcerpt;
    private BookBrief? _bookBrief;

    private string _promptDraft = string.Empty;
    private bool _promptDirty;
    private string _editEntityName = string.Empty;
    private List<KeyValuePair<string, string>> _editProps = [];
    private IReadOnlyDictionary<string, string?> _editOriginalProps = new Dictionary<string, string?>();

    private string? _loadedSignature;
    private bool _loading;
    private bool _saving;
    private string? _loadError;
    private string? _actionError;

    private ContextItemKind? CurrentKind => FeedItem?.Kind ?? Recommendation?.Kind;
    private string CurrentKey => FeedItem?.Key ?? Recommendation?.Key ?? string.Empty;
    private string HeaderKicker => FeedItem?.Badge ?? Recommendation?.Type ?? CurrentKind?.ToString() ?? "Context";
    private string HeaderTitle => CurrentKind == ContextItemKind.Entity && _entity is not null
        ? _entity.Name
        : FeedItem?.Label ?? Recommendation?.Name ?? "Context item";

    private bool CanSaveProjectGuidance =>
        IsOpen && AllowProjectGuidanceEdit && CurrentKind == ContextItemKind.ProjectGuidance;

    private bool CanSaveBookBrief =>
        IsOpen && AllowBookBriefEdit && CurrentKind == ContextItemKind.BookBrief && _bookBrief is not null;

    private bool CanSaveEntity =>
        IsOpen && AllowEntityEdit && CurrentKind == ContextItemKind.Entity && _entity is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen || CurrentKind is null)
        {
            ResetLoadedState();
            _loadedSignature = null;
            return;
        }

        if (CurrentKind == ContextItemKind.ProjectGuidance && !_promptDirty)
        {
            _promptDraft = Project?.ProjectGuidance ?? string.Empty;
        }

        var signature = $"{ProjectId:N}|{CurrentKind}|{CurrentKey}|{AllowEntityEdit}|{AllowProjectGuidanceEdit}|{AllowBookBriefEdit}";
        if (!string.Equals(signature, _loadedSignature, StringComparison.Ordinal))
        {
            _loadedSignature = signature;
            await LoadDetailAsync();
        }
    }

    private async Task LoadDetailAsync()
    {
        ResetLoadedState(keepPromptDraft: CurrentKind == ContextItemKind.ProjectGuidance);
        _loading = true;
        _loadError = null;
        _actionError = null;

        try
        {
            switch (CurrentKind)
            {
                case ContextItemKind.Entity:
                    await LoadEntityAsync();
                    break;
                case ContextItemKind.ChapterReference:
                    await LoadChapterAsync();
                    break;
                case ContextItemKind.ActReference:
                    await LoadActAsync();
                    break;
                case ContextItemKind.IngestSourceReference:
                    await LoadSourceAsync();
                    break;
                case ContextItemKind.IngestSourceChunkReference:
                    await LoadSourceChunkAsync();
                    break;
                case ContextItemKind.BookBrief:
                    _bookBrief = await BookBriefs.GetOrCreateAsync(ProjectId);
                    break;
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadEntityAsync()
    {
        if (!EditorContextKeys.TryParseEntity(CurrentKey, out var entityId))
        {
            _loadError = "This context item does not contain a valid entity id.";
            return;
        }

        _entity = await Entities.GetAsync(ProjectId, entityId);
        if (_entity is null)
        {
            _loadError = "Entity not found.";
            return;
        }

        _entityLinks = (await Entities.ListLinksAsync(ProjectId, _entity.Id)).ToList();
        InitializeEntityEditState(_entity);
    }

    private async Task LoadChapterAsync()
    {
        if (!EditorContextKeys.TryParseChapterReference(CurrentKey, out var chapterId))
        {
            _loadError = "This context item does not contain a valid chapter id.";
            return;
        }

        _chapter = await Chapters.GetAsync(chapterId);
        if (_chapter is null || _chapter.ProjectId != ProjectId)
        {
            _chapter = null;
            _loadError = "Chapter not found.";
            return;
        }

        if (_chapter.ActId is { } actId)
        {
            _chapterAct = await Acts.GetAsync(actId);
        }
    }

    private async Task LoadActAsync()
    {
        if (!EditorContextKeys.TryParseActReference(CurrentKey, out var actId))
        {
            _loadError = "This context item does not contain a valid act id.";
            return;
        }

        _act = await Acts.GetAsync(actId);
        if (_act is null || _act.ProjectId != ProjectId)
        {
            _act = null;
            _loadError = "Act not found.";
            return;
        }

        _actChapters = (await Chapters.ListAsync(ProjectId))
            .Where(chapter => chapter.ActId == _act.Id)
            .OrderBy(chapter => chapter.Order)
            .ToList();
    }

    private async Task LoadSourceAsync()
    {
        if (!EditorContextKeys.TryParseIngestSourceReference(CurrentKey, out var sourceId))
        {
            _loadError = "This context item does not contain a valid source id.";
            return;
        }

        _source = await Ingest.GetSourceAsync(sourceId);
        if (_source is null || _source.ProjectId != ProjectId)
        {
            _source = null;
            _loadError = "Source not found.";
            return;
        }

        _sourceChunks = (await Ingest.ListSourceChunksAsync(_source.Id))
            .OrderBy(chunk => chunk.Index)
            .ToList();
    }

    private async Task LoadSourceChunkAsync()
    {
        if (!EditorContextKeys.TryParseIngestSourceChunkReference(CurrentKey, out var sourceChunkId))
        {
            _loadError = "This context item does not contain a valid source chunk id.";
            return;
        }

        _sourceChunk = await Ingest.GetSourceChunkAsync(sourceChunkId);
        if (_sourceChunk is null)
        {
            _loadError = "Source chunk not found.";
            return;
        }

        _chunkSource = await Ingest.GetSourceAsync(_sourceChunk.SourceId);
        if (_chunkSource is null || _chunkSource.ProjectId != ProjectId)
        {
            _sourceChunk = null;
            _chunkSource = null;
            _loadError = "Source chunk not found.";
            return;
        }

        _sourceChunkExcerpt = await Ingest.GetSourceChunkExcerptAsync(_sourceChunk.Id, maxChars: 8_000);
    }

    private void ResetLoadedState(bool keepPromptDraft = false)
    {
        _entity = null;
        _entityLinks = [];
        _chapter = null;
        _chapterAct = null;
        _act = null;
        _actChapters = [];
        _source = null;
        _sourceChunks = [];
        _sourceChunk = null;
        _chunkSource = null;
        _sourceChunkExcerpt = null;
        _bookBrief = null;
        _editEntityName = string.Empty;
        _editProps = [];
        _editOriginalProps = new Dictionary<string, string?>();
        _loading = false;
        _saving = false;
        _loadError = null;
        _actionError = null;

        if (!keepPromptDraft)
        {
            _promptDraft = string.Empty;
            _promptDirty = false;
        }
    }

    private IEnumerable<string> DetailReasons()
    {
        if (!string.IsNullOrWhiteSpace(FeedItem?.Reason))
        {
            yield return FeedItem.Reason;
        }

        if (Recommendation is not null)
        {
            foreach (var reason in Recommendation.Reasons.Where(reason => !string.IsNullOrWhiteSpace(reason)))
            {
                yield return reason;
            }
        }
    }

    private RenderFragment RenderEntityDetail() => @<div class="context-detail-stack">
        @if (_entity is null)
        {
            @RenderContextBodyDetail()
        }
        else
        {
            @if (CanSaveEntity)
            {
                <div class="context-detail-field">
                    <label class="form-label small text-muted">Name</label>
                    <input type="text" class="form-control" value="@_editEntityName" @oninput="OnEntityNameInput" />
                </div>

                <div class="context-detail-field">
                    <label class="form-label small text-muted">Properties</label>
                    <div class="context-detail-props-edit">
                        @for (var i = 0; i < _editProps.Count; i++)
                        {
                            var idx = i;
                            <div class="context-detail-prop-row">
                                <input type="text" class="form-control form-control-sm" placeholder="key" value="@_editProps[idx].Key" @onchange="@(ev => UpdatePropKey(idx, (string?)ev.Value))" />
                                <textarea class="form-control form-control-sm" placeholder="value" rows="@RowsFor(_editProps[idx].Value)" @onchange="@(ev => UpdatePropVal(idx, (string?)ev.Value))">@_editProps[idx].Value</textarea>
                                <button type="button" class="btn btn-sm btn-link text-danger context-detail-prop-remove" title="Remove" @onclick="() => RemoveProp(idx)">x</button>
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-link context-detail-add-prop" @onclick="AddPropRow">+ property</button>
                    </div>
                </div>
            }
            else
            {
                @RenderProperties(_entity.Properties)
            }

            <EntityKnowledgeView Summary="@_entity.Summary"
                                 Aliases="@_entity.Aliases"
                                 WikiSections="@_entity.WikiSections"
                                 CanonSources="@_entity.CanonSources" />
            <EntityVisualExamples ProjectId="@ProjectId" EntityId="@_entity.Id" Editable="@AllowEntityEdit" />
            @RenderEntityLinks()
        }
    </div>;

    private RenderFragment RenderChapterDetail() => @<div class="context-detail-stack">
        @if (_chapter is null)
        {
            @RenderContextBodyDetail()
        }
        else
        {
            <div class="context-detail-meta">
                <div><span>Act</span><strong>@(_chapterAct?.Title ?? "Unassigned")</strong></div>
                <div><span>Order</span><strong>@(_chapter.Order + 1)</strong></div>
                <div><span>Vector index</span><strong>@_chapter.VectorIndexState</strong></div>
                @if (_chapter.VectorIndexedAt is not null)
                {
                    <div><span>Indexed</span><strong>@FormatDate(_chapter.VectorIndexedAt)</strong></div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_chapter.Synopsis))
            {
                <section class="context-detail-section">
                    <h6>Synopsis</h6>
                    <p>@_chapter.Synopsis</p>
                </section>
            }

            <section class="context-detail-section">
                <h6>Body</h6>
                <pre class="context-detail-text"><code>@(string.IsNullOrWhiteSpace(_chapter.PlainText) ? "(empty)" : ChapterFormatting.WithLineNumbers(_chapter.PlainText))</code></pre>
            </section>
        }
    </div>;

    private RenderFragment RenderActDetail() => @<div class="context-detail-stack">
        @if (_act is null)
        {
            @RenderContextBodyDetail()
        }
        else
        {
            <div class="context-detail-meta">
                <div><span>Order</span><strong>@(_act.Order + 1)</strong></div>
                <div><span>Chapters</span><strong>@_actChapters.Count</strong></div>
                <div><span>Updated</span><strong>@FormatDate(_act.UpdatedAt)</strong></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_act.Synopsis))
            {
                <section class="context-detail-section">
                    <h6>Synopsis</h6>
                    <p>@_act.Synopsis</p>
                </section>
            }

            <section class="context-detail-section">
                <h6>Chapters</h6>
                @if (_actChapters.Count == 0)
                {
                    <p class="text-muted small mb-0"><em>No chapters assigned.</em></p>
                }
                else
                {
                    <ol class="context-detail-list">
                        @foreach (var chapter in _actChapters)
                        {
                            <li>
                                <strong>@chapter.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(chapter.Synopsis))
                                {
                                    <p>@chapter.Synopsis</p>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </div>;

    private RenderFragment RenderSourceDetail() => @<div class="context-detail-stack">
        @if (_source is null)
        {
            @RenderContextBodyDetail()
        }
        else
        {
            <div class="context-detail-meta">
                <div><span>Kind</span><strong>@BlankFallback(_source.SourceKind)</strong></div>
                <div><span>Chunks</span><strong>@_sourceChunks.Count</strong></div>
                <div><span>Vector index</span><strong>@_source.VectorIndexState</strong></div>
                @if (_source.FetchedAt is not null)
                {
                    <div><span>Fetched</span><strong>@FormatDate(_source.FetchedAt)</strong></div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_source.Description))
            {
                <section class="context-detail-section">
                    <h6>Description</h6>
                    <p>@_source.Description</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_source.Synopsis))
            {
                <section class="context-detail-section">
                    <h6>Synopsis</h6>
                    <p>@_source.Synopsis</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_source.UserInstructions))
            {
                <section class="context-detail-section">
                    <h6>Instructions</h6>
                    <p>@_source.UserInstructions</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_source.SourceUrl) || !string.IsNullOrWhiteSpace(_source.FinalUrl) || !string.IsNullOrWhiteSpace(_source.CanonicalUrl))
            {
                <section class="context-detail-section">
                    <h6>Source URLs</h6>
                    <div class="context-detail-key-values">
                        @RenderKeyValue("Original", _source.SourceUrl)
                        @RenderKeyValue("Final", _source.FinalUrl)
                        @RenderKeyValue("Canonical", _source.CanonicalUrl)
                    </div>
                </section>
            }

            <section class="context-detail-section">
                <h6>Source Chunks</h6>
                @if (_sourceChunks.Count == 0)
                {
                    <p class="text-muted small mb-0"><em>No source chunks.</em></p>
                }
                else
                {
                    <ol class="context-detail-list">
                        @foreach (var chunk in _sourceChunks)
                        {
                            <li>
                                <strong>Part @(chunk.Index + 1): @BlankFallback(chunk.Title)</strong>
                                @if (!string.IsNullOrWhiteSpace(chunk.HeadingPath))
                                {
                                    <div class="text-muted small">@chunk.HeadingPath</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(chunk.Summary))
                                {
                                    <p>@chunk.Summary</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(chunk.AgentNotes))
                                {
                                    <p class="text-muted">@chunk.AgentNotes</p>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(_source.SourceText))
            {
                <section class="context-detail-section">
                    <h6>@(IsTruncated(_source.SourceText, 12_000) ? "Source text (truncated)" : "Source text")</h6>
                    <pre class="context-detail-text"><code>@LimitText(_source.SourceText, 12_000)</code></pre>
                </section>
            }
        }
    </div>;

    private RenderFragment RenderSourceChunkDetail() => @<div class="context-detail-stack">
        @if (_sourceChunk is null || _chunkSource is null)
        {
            @RenderContextBodyDetail()
        }
        else
        {
            <div class="context-detail-meta">
                <div><span>Source</span><strong>@_chunkSource.Title</strong></div>
                <div><span>Part</span><strong>@(_sourceChunk.Index + 1)</strong></div>
                <div><span>Tokens</span><strong>@TokenCountLabel(_sourceChunk)</strong></div>
                <div><span>Status</span><strong>@_sourceChunk.StructureStatus</strong></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_sourceChunk.HeadingPath))
            {
                <section class="context-detail-section">
                    <h6>Heading</h6>
                    <p>@_sourceChunk.HeadingPath</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_sourceChunk.Summary))
            {
                <section class="context-detail-section">
                    <h6>Summary</h6>
                    <p>@_sourceChunk.Summary</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_sourceChunk.AgentNotes))
            {
                <section class="context-detail-section">
                    <h6>Notes</h6>
                    <p>@_sourceChunk.AgentNotes</p>
                </section>
            }

            @if (_sourceChunkExcerpt is not null)
            {
                <section class="context-detail-section">
                    <h6>@(_sourceChunkExcerpt.IsTruncated ? "Excerpt (truncated)" : "Excerpt")</h6>
                    <pre class="context-detail-text"><code>@_sourceChunkExcerpt.Text</code></pre>
                </section>
            }
        }
    </div>;

    private RenderFragment RenderProjectGuidanceDetail() => @<div class="context-detail-stack">
        @if (CanSaveProjectGuidance)
        {
            <p class="text-muted small">Optional author direction appended to Lorekeeper's code-owned professional system instructions. Clearing this does not remove the editor's role or standards.</p>
            <textarea class="form-control context-detail-edit-textarea" rows="16" value="@_promptDraft" @oninput="OnPromptInput"></textarea>
        }
        else
        {
            @RenderContextBodyDetail()
        }
    </div>;

    private RenderFragment RenderBookBriefDetail() => @<div class="context-detail-stack">
        @if (_bookBrief is null)
        {
            <p class="text-muted small mb-0"><em>The Book Brief could not be loaded.</em></p>
        }
        else if (!CanSaveBookBrief)
        {
            @RenderContextBodyDetail()
        }
        else
        {
            <p class="text-muted small">The Book Brief is the canonical high-level creative target. Outline Chat maintains it conversationally as decisions become clear; you can also edit it here. Blank optional fields do not block writing.</p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Book kind</label>
                    <select class="form-select" @bind="_bookBrief.BookKind">
                        @foreach (var kind in Enum.GetValues<BookKind>())
                        {
                            <option value="@kind">@kind</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Genre</label>
                    <input class="form-control" @bind="_bookBrief.Genre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Target audience</label>
                    <input class="form-control" @bind="_bookBrief.TargetAudience" />
                </div>
                <div class="col-12">
                    <label class="form-label">Premise</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.Premise"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Purpose</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.Purpose"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Primary themes</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.PrimaryThemes"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Non-negotiable creative constraints</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.CreativeConstraints"></textarea>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Minimum reader age</label>
                    <input type="number" min="0" max="120" class="form-control" @bind="_bookBrief.MinimumReaderAge" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Maximum reader age</label>
                    <input type="number" min="0" max="120" class="form-control" @bind="_bookBrief.MaximumReaderAge" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Target word count</label>
                    <input type="number" min="1" class="form-control" @bind="_bookBrief.TargetWordCount" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Read-aloud priority</label>
                    <select class="form-select" value="@NullableBooleanValue(_bookBrief.ReadAloudPriority)" @onchange="OnReadAloudPriorityChanged">
                        <option value="">Unspecified</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Reading-level guidance</label>
                    <input class="form-control" @bind="_bookBrief.ReadingLevelGuidance" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Language / locale</label>
                    <input class="form-control" @bind="_bookBrief.LanguageLocale" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Point of view</label>
                    <input class="form-control" @bind="_bookBrief.PointOfView" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tense</label>
                    <input class="form-control" @bind="_bookBrief.Tense" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Voice / tone</label>
                    <input class="form-control" @bind="_bookBrief.VoiceAndTone" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">House style</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.HouseStyle"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Accessibility goals</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.AccessibilityGoals"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Visual direction</label>
                    <textarea class="form-control" rows="3" @bind="_bookBrief.VisualDirection"></textarea>
                </div>
            </div>
