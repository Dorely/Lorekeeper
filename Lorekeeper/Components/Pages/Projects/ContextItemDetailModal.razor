    private RenderFragment RenderContextBodyDetail() => @<section class="context-detail-section">
        @if (!string.IsNullOrWhiteSpace(FeedItem?.Body))
        {
            <pre class="context-detail-text"><code>@FeedItem.Body</code></pre>
        }
        else if (!string.IsNullOrWhiteSpace(Recommendation?.Preview))
        {
            <p>@Recommendation.Preview</p>
        }
        else
        {
            <p class="text-muted small mb-0"><em>No details available.</em></p>
        }
    </section>;

    private RenderFragment RenderProperties(IReadOnlyDictionary<string, string?> properties) => @<section class="context-detail-section">
        <h6>Properties</h6>
        @if (properties.Count == 0)
        {
            <p class="text-muted small mb-0"><em>No properties.</em></p>
        }
        else
        {
            <div class="context-detail-key-values">
                @foreach (var property in properties.OrderBy(property => property.Key, StringComparer.OrdinalIgnoreCase))
                {
                    @RenderKeyValue(property.Key, property.Value)
                }
            </div>
        }
    </section>;

    private RenderFragment RenderKeyValue(string label, string? value) => @<div class="context-detail-key-value">
        <span>@label</span>
        <strong>@BlankFallback(value)</strong>
    </div>;

    private RenderFragment RenderEntityLinks() => @<section class="context-detail-section">
        <h6>Links</h6>
        @if (_entityLinks.Count == 0)
        {
            <p class="text-muted small mb-0"><em>No graph links.</em></p>
        }
        else
        {
            <ul class="context-detail-links list-unstyled mb-0">
                @foreach (var link in _entityLinks)
                {
                    <li class="context-detail-link" @key="link.EdgeId">
                        <span class="context-detail-link-dir">@(link.Direction == EntityLinkDirection.Outgoing ? "->" : "<-")</span>
                        <span class="context-detail-link-edge">@link.EdgeType</span>
                        <span class="context-detail-link-other">@link.OtherEntityName</span>
                        <span class="context-detail-link-type text-muted small">@link.OtherEntityType</span>
                        @if (link.CanonSourceCount > 0)
                        {
                            <span class="context-detail-link-badge">@link.CanonSourceCount canon source@(PluralSuffix(link.CanonSourceCount))</span>
                        }
                        else if (link.IsIngestCreated)
                        {
                            <span class="context-detail-link-badge">ingest</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(link.Summary) || link.RelationshipCitations.Count > 0)
                        {
                            <div class="context-detail-link-observations">
                                @if (!string.IsNullOrWhiteSpace(link.Summary))
                                {
                                    <div>@link.Summary</div>
                                }
                                @foreach (var citation in link.RelationshipCitations.Take(3))
                                {
                                    <div><strong>@citation.SourceTitle:</strong> @IngestWikiSheet.CitationPreview(citation)</div>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>;

    private void OnPromptInput(ChangeEventArgs e)
    {
        _promptDraft = e.Value?.ToString() ?? string.Empty;
        _promptDirty = true;
        _actionError = null;
    }

    private void OnEntityNameInput(ChangeEventArgs e)
    {
        _editEntityName = e.Value?.ToString() ?? string.Empty;
        _actionError = null;
    }

    private void InitializeEntityEditState(StoryEntity entity)
    {
        _editEntityName = entity.Name;
        _editOriginalProps = entity.Properties;
        _editProps = entity.Properties
            .OrderBy(property => property.Key, StringComparer.OrdinalIgnoreCase)
            .Select(property => new KeyValuePair<string, string>(property.Key, property.Value ?? string.Empty))
            .ToList();
    }

    private void AddPropRow() => _editProps.Add(new KeyValuePair<string, string>(string.Empty, string.Empty));

    private void RemoveProp(int idx)
    {
        if (idx >= 0 && idx < _editProps.Count)
        {
            _editProps.RemoveAt(idx);
        }
    }

    private void UpdatePropKey(int idx, string? value)
    {
        _editProps[idx] = new KeyValuePair<string, string>(value ?? string.Empty, _editProps[idx].Value);
        _actionError = null;
    }

    private void UpdatePropVal(int idx, string? value)
    {
        _editProps[idx] = new KeyValuePair<string, string>(_editProps[idx].Key, value ?? string.Empty);
        _actionError = null;
    }

    private async Task SaveProjectGuidanceAsync()
    {
        if (!CanSaveProjectGuidance) return;

        _saving = true;
        _actionError = null;
        try
        {
            var updated = await Projects.UpdateProjectGuidanceAsync(ProjectId, _promptDraft);
            if (Project is not null)
            {
                Project.ProjectGuidance = updated.ProjectGuidance;
            }

            _promptDirty = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveBookBriefAsync()
    {
        if (!CanSaveBookBrief || _bookBrief is null) return;

        _saving = true;
        _actionError = null;
        try
        {
            var clearFields = new List<BookBriefField>();
            if (_bookBrief.MinimumReaderAge is null) clearFields.Add(BookBriefField.MinimumReaderAge);
            if (_bookBrief.MaximumReaderAge is null) clearFields.Add(BookBriefField.MaximumReaderAge);
            if (_bookBrief.TargetWordCount is null) clearFields.Add(BookBriefField.TargetWordCount);
            if (_bookBrief.ReadAloudPriority is null) clearFields.Add(BookBriefField.ReadAloudPriority);

            _bookBrief = await BookBriefs.UpdateAsync(ProjectId, new BookBriefPatch
            {
                BookKind = _bookBrief.BookKind,
                Premise = _bookBrief.Premise,
                Genre = _bookBrief.Genre,
                PrimaryThemes = _bookBrief.PrimaryThemes,
                Purpose = _bookBrief.Purpose,
                CreativeConstraints = _bookBrief.CreativeConstraints,
                TargetAudience = _bookBrief.TargetAudience,
                MinimumReaderAge = _bookBrief.MinimumReaderAge,
                MaximumReaderAge = _bookBrief.MaximumReaderAge,
                ReadingLevelGuidance = _bookBrief.ReadingLevelGuidance,
                TargetWordCount = _bookBrief.TargetWordCount,
                PointOfView = _bookBrief.PointOfView,
                Tense = _bookBrief.Tense,
                VoiceAndTone = _bookBrief.VoiceAndTone,
                LanguageLocale = _bookBrief.LanguageLocale,
                HouseStyle = _bookBrief.HouseStyle,
                ReadAloudPriority = _bookBrief.ReadAloudPriority,
                AccessibilityGoals = _bookBrief.AccessibilityGoals,
                VisualDirection = _bookBrief.VisualDirection,
                ClearFields = clearFields,
            });
            if (Project is not null)
                Project.BookBrief = _bookBrief;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnReadAloudPriorityChanged(ChangeEventArgs args)
    {
        if (_bookBrief is null) return;
        _bookBrief.ReadAloudPriority = bool.TryParse(args.Value?.ToString(), out var value) ? value : null;
    }

    private async Task SaveEntityAsync()
    {
        if (!CanSaveEntity || _entity is null) return;

        var next = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var kv in _editProps)
        {
            var key = kv.Key.Trim();
            if (key.Length == 0) continue;
            next[key] = kv.Value;
        }

        var toSet = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var (key, value) in next)
        {
            if (!_editOriginalProps.TryGetValue(key, out var old) || (old ?? string.Empty) != (value ?? string.Empty))
            {
                toSet[key] = value;
            }
        }

        var toRemove = _editOriginalProps.Keys.Where(key => !next.ContainsKey(key)).ToList();
        var newName = _editEntityName.Trim();
        var nameChanged = newName.Length > 0 && !string.Equals(newName, _entity.Name, StringComparison.Ordinal);

        if (!nameChanged && toSet.Count == 0 && toRemove.Count == 0)
        {
            await CloseAsync();
            return;
        }

        _saving = true;
        _actionError = null;
        try
        {
            var updated = await Entities.UpdateAsync(
                ProjectId,
                _entity.Id,
                name: nameChanged ? newName : null,
                propertiesToSet: toSet.Count > 0 ? toSet : null,
                propertiesToRemove: toRemove.Count > 0 ? toRemove : null);

            _entity = updated;
            _entityLinks = (await Entities.ListLinksAsync(ProjectId, updated.Id)).ToList();
            InitializeEntityEditState(updated);
            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CloseAsync()
    {
        ResetLoadedState();
        _loadedSignature = null;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static int RowsFor(string value) => Math.Clamp(1 + value.Count(c => c == '\n'), 2, 10);

    private static string ObservationPreview(IngestSourceObservation observation) =>
        !string.IsNullOrWhiteSpace(observation.Summary) ? observation.Summary
        : !string.IsNullOrWhiteSpace(observation.Notes) ? observation.Notes
        : observation.ObservedProperties.Values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string PluralSuffix(int count) => count == 1 ? string.Empty : "s";

    private static string FormatDate(DateTime? value) => value is null ? "-" : value.Value.ToLocalTime().ToString("g");

    private static string BlankFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static string NullableBooleanValue(bool? value) => value switch
    {
        true => "true",
        false => "false",
        null => string.Empty,
    };

    private static bool IsTruncated(string? value, int maxChars) => value?.Length > maxChars;

    private static string LimitText(string? value, int maxChars)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var text = value.Trim();
        return text.Length <= maxChars ? text : text[..maxChars] + "...";
    }

    private static string TokenCountLabel(IngestSourceChunk chunk) =>
        $"{(chunk.TokenCountIsExact ? string.Empty : "~")}{chunk.EstimatedTokenCount:N0}";
}
