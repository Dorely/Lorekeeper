@using System.Text.Json
@using Lorekeeper.Composition
@using Lorekeeper.Fonts
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Images
@implements IAsyncDisposable
@inject ICompositionService Compositions
@inject IPublicationEditionService Editions
@inject IProjectImageService Images
@inject IProjectFontService ProjectFonts
@inject IJSRuntime JS

<div class="composition-workspace" role="dialog" aria-modal="true" aria-label="Designed page workspace" tabindex="0" @onkeydown="HandleKeyDown">
    <style>@((MarkupString)FontFaceCss())</style>
    <header>
        <div>
            <strong>@(_composition?.Name ?? "Designed page")</strong>
            <small>@(_variant is null ? "Loading geometry" : $"Geometry {_variant.GeometryKey}")</small>
        </div>
        <select class="form-select form-select-sm" value="@_editionId" @onchange="ChangeEditionAsync">
            @foreach (var edition in _editions)
            {
                <option value="@edition.Id">@edition.Name (@edition.Format)</option>
            }
        </select>
        <a class="btn btn-sm btn-outline-primary" href="@GenerationUrl("page-surface", CompositionId)">Generate surface art</a>
        <button type="button" class="btn btn-sm btn-primary" disabled="@(!_dirty)" @onclick="SaveAsync">Save</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseAsync">Close</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_scene is null)
    {
        <p class="text-muted">Loading composition...</p>
    }
    else
    {
        <div class="composition-main">
            <aside class="composition-layers">
                <div class="composition-heading-row"><h3>Layers</h3><button type="button" @onclick="AddLayer">Add</button></div>
                @foreach (var layer in _layers.OrderByDescending(layer => layer.Order))
                {
                    <div class="composition-layer-row @(layer.Id == _selectedLayerId ? "selected" : null)">
                        <button type="button" @onclick="() => _selectedLayerId = layer.Id">@layer.Name</button>
                        <button type="button" title="Toggle visibility" @onclick="() => ToggleLayerVisibility(layer)">@(layer.Visible ? "Eye" : "Hidden")</button>
                        <button type="button" title="Toggle lock" @onclick="() => ToggleLayerLock(layer)">@(layer.Locked ? "Locked" : "Open")</button>
                    </div>
                }
                <h3>Objects</h3>
                <div class="composition-add-row">
                    <button type="button" @onclick="() => AddObject(CompositionObjectKind.Text)">Text</button>
                    <button type="button" @onclick="() => AddObject(CompositionObjectKind.Image)">Image</button>
                    <button type="button" @onclick="() => AddObject(CompositionObjectKind.Rectangle)">Rectangle</button>
                    <button type="button" @onclick="() => AddObject(CompositionObjectKind.Ellipse)">Ellipse</button>
                    <button type="button" @onclick="() => AddObject(CompositionObjectKind.Line)">Line</button>
                </div>
                @foreach (var item in _objects.OrderByDescending(item => item.ZIndex))
                {
                    <div class="composition-object-row @(item.Id == _selectedId ? "selected" : null)">
                        <input type="checkbox" title="Select for grouping" checked="@_groupSelection.Contains(item.Id)" @onchange="e => ToggleGroupSelection(item.Id, (bool)e.Value!)" />
                        <button type="button" @onclick="() => _selectedId = item.Id"><span>@item.Kind</span><small>@(string.IsNullOrWhiteSpace(item.Name) ? item.Id.ToString("N")[..8] : item.Name)</small></button>
                    </div>
                }
                <div class="composition-add-row"><button type="button" disabled="@(_groupSelection.Count < 2)" @onclick="GroupSelected">Group selected</button><button type="button" disabled="@(_groupSelection.Count == 0)" @onclick="UngroupSelected">Ungroup</button></div>
                <h3>Reading order</h3>
                @foreach (var item in _objects.Where(item => item.ReadingOrder is not null).OrderBy(item => item.ReadingOrder))
                {
                    <div class="reading-row"><span>@item.ReadingOrder</span> @item.SemanticRole <button type="button" @onclick="() => MoveReadingOrder(item, -1)">Up</button><button type="button" @onclick="() => MoveReadingOrder(item, 1)">Down</button></div>
                }
                <h3>Semantic content</h3>
                <p class="composition-hint">Text lives here once. Frames bind to these stable blocks.</p>
                <div class="composition-add-row">
                    <button type="button" @onclick="() => AddSemanticBlock(ManuscriptBlockType.Paragraph)">Paragraph</button>
                    <button type="button" @onclick="() => AddSemanticBlock(ManuscriptBlockType.Heading)">Heading</button>
                    <button type="button" @onclick="() => AddSemanticBlock(ManuscriptBlockType.BlockQuote)">Caption</button>
                </div>
                @foreach (var block in _semanticBlocks)
                {
                    <button type="button" class="composition-content-row @(block.Id == _selectedSemanticId ? "selected" : null)" @onclick="() => SelectSemantic(block)">
                        <span>@block.Type</span><small>@ShortText(block)</small><em>@PlacementStatus(block.Id)</em>
                    </button>
                }
                @if (UnplacedCount > 0)
                {
                    <p class="composition-unplaced" role="status">@UnplacedCount unplaced content block@(UnplacedCount == 1 ? string.Empty : "s") must be bound before output.</p>
                }
                <h3>Guides</h3>
                @foreach (var guide in _guides)
                {
                    <div class="composition-guide-row"><select value="@guide.Axis" @onchange="e => PatchGuide(guide with { Axis = Enum.Parse<CompositionGuideAxis>(e.Value!.ToString()!) })"><option value="Horizontal">Horizontal</option><option value="Vertical">Vertical</option></select><input type="number" min="0" max="100" step=".25" value="@guide.PositionPercent" @onchange="e => PatchGuide(guide with { PositionPercent = Math.Clamp(Number(e), 0, 100) })" /><button type="button" title="Delete guide" @onclick="() => DeleteGuide(guide.Id)">Delete</button></div>
                }
            </aside>

            <section class="composition-stage-shell">
                <nav class="composition-page-strip" aria-label="Page and spread mode">
                    <button type="button" class="@SurfaceClass(CompositionSurfaceKind.SinglePage)" @onclick="() => SetSurfaceKind(CompositionSurfaceKind.SinglePage)"><span class="page-thumb single"></span>Single page</button>
                    <button type="button" class="@SurfaceClass(CompositionSurfaceKind.FacingSpread)" @onclick="() => SetSurfaceKind(CompositionSurfaceKind.FacingSpread)"><span class="page-thumb spread"></span>Facing spread</button>
                    @if (_scene.Surface.AllowIndependentPdfPage)
                    {
                        <button type="button" class="@SurfaceClass(CompositionSurfaceKind.IndependentPage)" @onclick="() => SetSurfaceKind(CompositionSurfaceKind.IndependentPage)"><span class="page-thumb custom"></span>Digital override</button>
                    }
                    @foreach (var candidate in _editionVariants)
                    {
                        <button type="button" class="@(candidate.Id == _variant?.Id ? "selected" : null)" title="Select saved exact-geometry variant" @onclick="() => SelectVariantAsync(candidate.Id)">@VariantLabel(candidate)</button>
                    }
                </nav>
                <div class="composition-toolbar">
                    <button type="button" @onclick="Undo" disabled="@(_undo.Count == 0)">Undo</button>
                    <button type="button" @onclick="Redo" disabled="@(_redo.Count == 0)">Redo</button>
                    <button type="button" @onclick="() => _zoom = Math.Max(.25, _zoom - .1)">-</button>
                    <span>@Math.Round(_zoom * 100)%</span>
                    <button type="button" @onclick="() => _zoom = Math.Min(2, _zoom + .1)">+</button>
                    <label><input type="checkbox" @bind="_snapToGuides" /> Snap</label>
                    <label><input type="checkbox" @bind="_showGuides" /> Guides</label>
                    <button type="button" @onclick="() => AddGuide(CompositionGuideAxis.Horizontal)">Add horizontal guide</button>
                    <button type="button" @onclick="() => AddGuide(CompositionGuideAxis.Vertical)">Add vertical guide</button>
                    <span>Trim</span><span>Bleed</span><span>Safe area</span><span>Gutter</span>
                </div>
                <div class="composition-stage" style="@StageStyle()" @ref="_stageElement" @onpointermove="ContinueTransform" @onpointerup="EndTransform" @onpointercancel="EndTransform">
                    @if (_showGuides)
                    {
                        <div class="composition-ruler composition-ruler-x"></div><div class="composition-ruler composition-ruler-y"></div>
                        @foreach (var guide in _guides)
                        {
                            <div class="composition-guide @(guide.Axis == CompositionGuideAxis.Horizontal ? "composition-guide-x" : "composition-guide-y")" style="@GuideStyle(guide)"></div>
                        }
                    }
                    <div class="composition-safe"></div>
                    @if (_scene.Surface.Kind == CompositionSurfaceKind.FacingSpread)
                    {
                        <div class="composition-gutter"></div>
                    }
                    @foreach (var item in _objects.Where(item => item.LayerId != Guid.Empty && IsVisible(item)))
                    {
                        <div role="button" tabindex="0"
                                class="composition-object composition-object--@item.Kind.ToString().ToLowerInvariant() @(item.Id == _selectedId ? "selected" : null)"
                                style="@ObjectStyle(item)"
                                @onclick:stopPropagation="true"
                                @onclick="() => _selectedId = item.Id"
                                @onpointerdown:stopPropagation="true"
                                @onpointerdown="e => BeginTransformAsync(e, item, TransformMode.Move)">
                            @if (item.Kind == CompositionObjectKind.Text)
                            {
                                <span>@RenderedText(item)</span>
                            }
                            else if (item.Kind == CompositionObjectKind.Image)
                            {
                                @if (item.ImageId is Guid imageId && Image(imageId) is { } image)
                                {
                                    <img src="@image.PreviewUrl" alt="" style="@ImageStyle(item)" />
                                }
                                else
                                {
                                    <span>Choose image</span>
                                }
                            }
                            else if (item.Kind == CompositionObjectKind.Line)
                            {
                                <span class="composition-line" style="@LineStyle(item)"></span>
                            }
                            @if (item.Id == _selectedId && !IsLocked(item))
                            {
                                <span class="composition-handle composition-handle-resize" title="Drag to resize" @onpointerdown:stopPropagation="true" @onpointerdown="e => BeginTransformAsync(e, item, TransformMode.Resize)"></span>
                                <span class="composition-handle composition-handle-rotate" title="Drag to rotate" @onpointerdown:stopPropagation="true" @onpointerdown="e => BeginTransformAsync(e, item, TransformMode.Rotate)"></span>
                            }
                        </div>
                    }
                </div>
            </section>

            <aside class="composition-inspector">
                <h3>Inspector</h3>
                @if (Selected is { } selected)
                {
                    <label>Name<input value="@selected.Name" @onchange="e => Patch(selected with { Name = e.Value?.ToString() ?? string.Empty })" /></label>
                    <div class="composition-grid-2">
                        <label>X %<input type="number" value="@selected.Bounds.XPercent" @onchange="e => PatchBounds(selected, x: Number(e))" /></label>
                        <label>Y %<input type="number" value="@selected.Bounds.YPercent" @onchange="e => PatchBounds(selected, y: Number(e))" /></label>
                        <label>Width %<input type="number" value="@selected.Bounds.WidthPercent" @onchange="e => PatchBounds(selected, width: Number(e))" /></label>
                        <label>Height %<input type="number" value="@selected.Bounds.HeightPercent" @onchange="e => PatchBounds(selected, height: Number(e))" /></label>
                    </div>
                    <label>Rotation<input type="number" value="@selected.RotationDegrees" @onchange="e => Patch(selected with { RotationDegrees = Number(e) })" /></label>
                    <label>Opacity<input type="range" min="0" max="1" step=".05" value="@selected.Opacity" @onchange="e => Patch(selected with { Opacity = Number(e) })" /></label>
                    <label><input type="checkbox" checked="@selected.Visible" @onchange="e => Patch(selected with { Visible = (bool)e.Value! })" /> Visible</label>
                    <label><input type="checkbox" checked="@selected.Locked" @onchange="e => Patch(selected with { Locked = (bool)e.Value! })" /> Locked</label>
                    <label>Layer<select value="@selected.LayerId" @onchange="e => MoveToLayer(selected, e)">@foreach (var layer in _layers.OrderBy(layer => layer.Order)) { <option value="@layer.Id">@layer.Name</option> }</select></label>
                    <label>Object style<select value="@selected.StyleId" @onchange="e => SetObjectStyle(selected, e)"><option value="">Local formatting</option>@foreach (var style in _styles) { <option value="@style.Id">@style.Name</option> }</select></label>
                    <div class="composition-action-row"><button type="button" @onclick="() => CreateStyleFrom(selected)">Save as reusable style</button>@if (selected.StyleId is Guid styleId) { <button type="button" @onclick="() => DeleteStyle(styleId)">Delete style</button> }</div>
                    <label>Semantic role<select value="@selected.SemanticRole" @onchange="e => Patch(selected with { SemanticRole = Enum.Parse<CompositionSemanticRole>(e.Value!.ToString()!) })">@foreach (var role in Enum.GetValues<CompositionSemanticRole>()) { <option value="@role">@role</option> }</select></label>
                    <label>Reading order<input type="number" value="@selected.ReadingOrder" @onchange="e => Patch(selected with { ReadingOrder = NullableInt(e) })" /></label>
                    @if (selected.Kind == CompositionObjectKind.Image)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@GenerationUrl("page-frame", selected.Id)">Generate for this frame</a>
                        <label>Project image<select value="@selected.ImageId" @onchange="e => Patch(selected with { ImageId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null })"><option value="">Choose image</option>@foreach (var image in _images) { <option value="@image.Id">@image.FileName</option> }</select></label>
                        <label>Fit<select value="@selected.ImageFit" @onchange="e => Patch(selected with { ImageFit = Enum.Parse<FigureImageFit>(e.Value!.ToString()!) })">@foreach (var fit in Enum.GetValues<FigureImageFit>()) { <option value="@fit">@fit</option> }</select></label>
                        <label>Focal X<input type="range" min="0" max="100" value="@selected.FocalXPercent" @onchange="e => Patch(selected with { FocalXPercent = Number(e) })" /></label>
                        <label>Focal Y<input type="range" min="0" max="100" value="@selected.FocalYPercent" @onchange="e => Patch(selected with { FocalYPercent = Number(e) })" /></label>
                        <label>Alternative text<textarea value="@selected.AltText" @onchange="e => SetAltText(selected, e.Value?.ToString() ?? string.Empty)"></textarea></label>
                        <label><input type="checkbox" checked="@selected.Decorative" @onchange="e => SetDecorative(selected, (bool)e.Value!)" /> Decorative</label>
                    }
                    @if (selected.Kind == CompositionObjectKind.Text)
                    {
                        var resolved = Resolved(selected);
                        <label>Content binding<select value="@BoundBlockId(selected)" @onchange="e => BindTextBlock(selected, e)"><option value="">Choose semantic content</option>@foreach (var block in _semanticBlocks) { <option value="@block.Id">@ShortText(block)</option> }</select></label>
                        @foreach (var indexed in selected.ContentReferences.Select((reference, index) => (reference, index)))
                        {
                            <div class="composition-range-editor">
                                <strong>@indexed.reference.BlockId</strong>
                                <label>Start offset<input type="number" min="0" value="@indexed.reference.StartOffset" @onchange="e => PatchReference(selected, indexed.index, start: NullableInt(e))" /></label>
                                <label>End offset<input type="number" min="1" value="@indexed.reference.EndOffset" @onchange="e => PatchReference(selected, indexed.index, end: NullableInt(e))" /></label>
                                <button type="button" @onclick="() => RemoveReference(selected, indexed.index)">Remove range</button>
                            </div>
                        }
                        @if (SelectedSemantic is { } selectedBlock)
                        {
                            <button type="button" @onclick="() => AddReference(selected, selectedBlock.Id)">Add selected content range</button>
                        }
                        <label>Font family<select value="@resolved.FontFamilyKey" @onchange="e => Patch(selected with { StyleId = null, FontFamilyKey = e.Value?.ToString() ?? string.Empty })">@foreach (var family in _fontFamilies) { <option value="@family.Key">@family.Name</option> }</select></label>
                        <label>Font weight<input type="number" min="100" max="900" step="100" value="@resolved.FontWeight" @onchange="e => Patch(selected with { StyleId = null, FontWeight = (int)Number(e) })" /></label>
                        <label>Font size<input type="number" value="@resolved.FontSizePoints" @onchange="e => Patch(selected with { StyleId = null, FontSizePoints = Number(e) })" /></label>
                        <label>Line height<input type="number" min=".5" max="4" step=".05" value="@resolved.LineHeight" @onchange="e => Patch(selected with { StyleId = null, LineHeight = Number(e) })" /></label>
                        <label>Letter spacing (em)<input type="number" min="-1" max="10" step=".01" value="@resolved.LetterSpacingEm" @onchange="e => Patch(selected with { StyleId = null, LetterSpacingEm = Number(e) })" /></label>
                        <label>Horizontal alignment<select value="@resolved.TextAlignment" @onchange="e => Patch(selected with { StyleId = null, TextAlignment = Enum.Parse<CompositionTextAlignment>(e.Value!.ToString()!) })">@foreach (var alignment in Enum.GetValues<CompositionTextAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                        <label>Vertical alignment<select value="@resolved.VerticalAlignment" @onchange="e => Patch(selected with { StyleId = null, VerticalAlignment = Enum.Parse<CompositionVerticalAlignment>(e.Value!.ToString()!) })">@foreach (var alignment in Enum.GetValues<CompositionVerticalAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                        <label>Text shadow<select value="@resolved.TextShadow" @onchange="e => Patch(selected with { StyleId = null, TextShadow = Enum.Parse<CompositionTextShadow>(e.Value!.ToString()!) })">@foreach (var shadow in Enum.GetValues<CompositionTextShadow>()) { <option value="@shadow">@shadow</option> }</select></label>
                        <label>Background<input type="color" value="@ColorValue(resolved.BackgroundColor)" @onchange="e => Patch(selected with { StyleId = null, BackgroundColor = Color(e) })" /></label>
                        <label>Background opacity<input type="range" min="0" max="1" step=".05" value="@resolved.BackgroundOpacity" @onchange="e => Patch(selected with { StyleId = null, BackgroundOpacity = Number(e) })" /></label>
                        @if (TextOverflows(selected)) { <p class="composition-unplaced">Text is likely to overflow this frame at the current size.</p> }
                    }
                    @if (selected.Kind is CompositionObjectKind.Text or CompositionObjectKind.Rectangle or CompositionObjectKind.Ellipse or CompositionObjectKind.Line)
                    {
                        var resolved = Resolved(selected);
                        <label>Fill<input type="color" value="@ColorValue(resolved.FillColor)" @onchange="e => Patch(selected with { StyleId = null, FillColor = Color(e) })" /></label>
                        <label>Stroke<input type="color" value="@ColorValue(resolved.StrokeColor)" @onchange="e => Patch(selected with { StyleId = null, StrokeColor = Color(e) })" /></label>
                        <label>Stroke width<input type="number" min="0" max="72" step=".25" value="@resolved.StrokeWidthPoints" @onchange="e => Patch(selected with { StyleId = null, StrokeWidthPoints = Number(e) })" /></label>
                    }
                    <div class="composition-action-row">
                        <button type="button" @onclick="() => Nudge(selected, -1, 0)">Left</button>
                        <button type="button" @onclick="() => Nudge(selected, 0, -1)">Up</button>
                        <button type="button" @onclick="() => Nudge(selected, 0, 1)">Down</button>
                        <button type="button" @onclick="() => Nudge(selected, 1, 0)">Right</button>
                        <button type="button" class="danger" @onclick="() => Delete(selected.Id)">Delete</button>
                    </div>
                }
                @if (SelectedSemantic is { } semantic)
                {
                    <h3>Content editor</h3>
                    <label>Semantic role<select value="@semantic.Type" @onchange="e => ChangeSemanticType(semantic, e)"><option value="Paragraph">Paragraph</option><option value="Heading">Heading</option><option value="BlockQuote">Caption / quote</option><option value="ListItem">List item</option></select></label>
                    <label>Text<textarea rows="6" value="@ManuscriptCodec.Text(semantic)" @onchange="e => ChangeSemanticText(semantic, e.Value?.ToString() ?? string.Empty)"></textarea></label>
                    <fieldset class="composition-mark-editor">
                        <legend>Inline formatting</legend>
                        <div class="composition-grid-2">
                            <label>Start<input type="number" min="0" max="@ManuscriptCodec.Text(semantic).Length" @bind="_markStart" /></label>
                            <label>End<input type="number" min="0" max="@ManuscriptCodec.Text(semantic).Length" @bind="_markEnd" /></label>
                        </div>
                        <label>Format<select @bind="_markType">@foreach (var mark in Enum.GetValues<ManuscriptMarkType>()) { <option value="@mark">@MarkLabel(mark)</option> }</select></label>
                        @if (MarkNeedsValue(_markType))
                        {
                            <label>@MarkValueLabel(_markType)<input @bind="_markValue" placeholder="@MarkValuePlaceholder(_markType)" /></label>
                        }
                        <div class="composition-action-row">
                            <button type="button" @onclick="SelectWholeSemanticText">Select all text</button>
                            <button type="button" @onclick="() => ApplySemanticMark(true)">Apply</button>
                            <button type="button" @onclick="() => ApplySemanticMark(false)">Remove</button>
                        </div>
                        <small>Offsets count characters in the semantic text. Formatting is preserved in EPUB, Digital PDF, and text frames.</small>
                    </fieldset>
                    <button type="button" class="danger" @onclick="() => DeleteSemanticBlock(semantic.Id)" disabled="@IsReferenced(semantic.Id)">Delete unplaced block</button>
                }
                <h3>Surface</h3>
                <label>Page mode<select value="@_scene.Surface.Kind" @onchange="ChangeSurfaceKind"><option value="SinglePage">Single page</option><option value="FacingSpread">Facing spread</option>@if (_scene.Surface.AllowIndependentPdfPage) { <option value="IndependentPage">Independent Digital PDF page</option> }</select></label>
                @if (_scene.Surface.Kind == CompositionSurfaceKind.IndependentPage)
                {
                    <div class="composition-grid-2">
                        <label>Width (in)<input type="number" min="1" max="40" step=".125" value="@(_scene.Surface.WidthPoints / 72)" @onchange="e => ChangeIndependentDimension(e, true)" /></label>
                        <label>Height (in)<input type="number" min="1" max="40" step=".125" value="@(_scene.Surface.HeightPoints / 72)" @onchange="e => ChangeIndependentDimension(e, false)" /></label>
                    </div>
                    <small>Custom page boxes apply only to this Digital PDF Designed Page.</small>
                }
                <p>@(_scene.Surface.WidthPoints / 72).ToString("0.###") × @(_scene.Surface.HeightPoints / 72).ToString("0.###") in</p>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public string ProjectSlug { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Guid CompositionId { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private PageComposition? _composition;
    private PageCompositionVariant? _variant;
    private IReadOnlyList<PageCompositionVariant> _editionVariants = [];
    private CompositionScene? _scene;
    private List<CompositionObject> _objects = [];
    private List<CompositionLayer> _layers = [];
    private List<CompositionObjectStyle> _styles = [];
    private List<CompositionGuide> _guides = [];
    private List<ManuscriptBlock> _semanticBlocks = [];
    private IReadOnlyList<PublicationEditionSummary> _editions = [];
    private CompositionEditionGeometry? _editionGeometry;
    private IReadOnlyList<ProjectImageView> _images = [];
    private IReadOnlyList<ProjectFontFamilyView> _fontFamilies = [];
    private readonly Stack<WorkspaceSnapshot> _undo = new();
    private readonly Stack<WorkspaceSnapshot> _redo = new();
    private Guid _editionId;
    private Guid? _selectedId;
    private Guid? _selectedLayerId;
    private readonly HashSet<Guid> _groupSelection = [];
    private string? _selectedSemanticId;
    private Guid _loadedProjectId;
    private Guid _loadedCompositionId;
    private int _markStart;
    private int _markEnd;
    private ManuscriptMarkType _markType = ManuscriptMarkType.Emphasis;
    private string _markValue = string.Empty;
    private bool _dirty;
    private double _zoom = .8;
    private bool _snapToGuides = true;
    private bool _showGuides = true;
    private string? _error;
    private ElementReference _stageElement;
    private IJSObjectReference? _workspaceModule;
    private TransformState? _transform;
    private CompositionObject? Selected => _objects.FirstOrDefault(item => item.Id == _selectedId);
    private string GenerationUrl(string targetKind, Guid targetId) =>
        $"/projects/{Uri.EscapeDataString(ProjectSlug)}/images?editionId={_editionId:N}&targetKind={targetKind}&targetId={targetId:N}&variantId={_variant!.Id:N}";
    private ManuscriptBlock? SelectedSemantic => _semanticBlocks.FirstOrDefault(item => item.Id == _selectedSemanticId);
    private HashSet<string> UnplacedIds
    {
        get
        {
            try
            {
                return ManuscriptRangeResolver.ValidateCoverage(
                    new ManuscriptDocument { ManuscriptId = CompositionId, Content = _semanticBlocks },
                    _objects.Where(item => item.Kind == CompositionObjectKind.Text && IsVisible(item)).Select(item => item.ContentReferences))
                    .ToHashSet(StringComparer.Ordinal);
            }
            catch (InvalidDataException)
            {
                return _semanticBlocks.Select(block => block.Id).ToHashSet(StringComparer.Ordinal);
            }
        }
    }
    private int UnplacedCount => UnplacedIds.Count;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId && _loadedCompositionId == CompositionId)
            return;
        if (_dirty)
        {
            await SaveAsync();
            if (_dirty)
                return;
        }
        _error = null;
        try
        {
            _composition = await Compositions.GetAsync(ProjectId, CompositionId)
                ?? throw new InvalidOperationException("Designed page was not found.");
            _semanticBlocks = ManuscriptCodec.Deserialize(
                _composition.SemanticManuscriptJson,
                _composition.Id,
                _composition.Revision).Content.ToList();
            _editions = await Editions.ListAsync(ProjectId);
            _images = (await Images.ListAsync(ProjectId)).Where(image => image.ContentType is "image/png" or "image/jpeg").ToList();
            _fontFamilies = await ProjectFonts.ListAsync(ProjectId);
            var edition = _editions.FirstOrDefault(item => item.IsDefault)
