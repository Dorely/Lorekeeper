    private static string InlineHtml(ManuscriptInline inline)
    {
        var html = EncodeText(inline.Text);
        foreach (var mark in inline.Marks.OrderBy(candidate => candidate.Type))
        {
            html = mark.Type switch
            {
                ManuscriptMarkType.Strong => $"<strong>{html}</strong>",
                ManuscriptMarkType.Emphasis => $"<em>{html}</em>",
                ManuscriptMarkType.Underline => $"<u>{html}</u>",
                ManuscriptMarkType.Strikethrough => $"<s>{html}</s>",
                ManuscriptMarkType.Code => $"<code>{html}</code>",
                ManuscriptMarkType.SmallCaps => $"<span class=\"composition-small-caps\">{html}</span>",
                ManuscriptMarkType.Superscript => $"<sup>{html}</sup>",
                ManuscriptMarkType.Subscript => $"<sub>{html}</sub>",
                ManuscriptMarkType.Link => $"<span class=\"composition-inline-link\">{html}</span>",
                ManuscriptMarkType.Language => $"<span lang=\"{System.Net.WebUtility.HtmlEncode(mark.Value ?? string.Empty)}\">{html}</span>",
                ManuscriptMarkType.CharacterStyle => $"<span data-character-style=\"{System.Net.WebUtility.HtmlEncode(mark.Value ?? string.Empty)}\">{html}</span>",
                _ => html,
            };
        }
        return html;
    }

    private static string EncodeText(string text) => System.Net.WebUtility.HtmlEncode(text)
