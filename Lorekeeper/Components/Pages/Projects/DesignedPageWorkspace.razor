    private void PatchBounds(CompositionObject item, double? x = null, double? y = null, double? width = null, double? height = null) =>
        Patch(item with { Bounds = item.Bounds with { XPercent = Snap(x ?? item.Bounds.XPercent, CompositionGuideAxis.Vertical), YPercent = Snap(y ?? item.Bounds.YPercent, CompositionGuideAxis.Horizontal), WidthPercent = Snap(width ?? item.Bounds.WidthPercent), HeightPercent = Snap(height ?? item.Bounds.HeightPercent) } });
    private double Snap(double value, CompositionGuideAxis? axis = null)
    {
        if (!_snapToGuides) return value;
        var grid = Math.Round(value * 2, MidpointRounding.AwayFromZero) / 2;
        var guide = axis is null ? null : _guides.Where(item => item.Axis == axis).OrderBy(item => Math.Abs(item.PositionPercent - value)).FirstOrDefault();
        return guide is not null && Math.Abs(guide.PositionPercent - value) <= 1 ? guide.PositionPercent : grid;
    }

    private void Nudge(CompositionObject item, double x, double y) => PatchBounds(item, item.Bounds.XPercent + x, item.Bounds.YPercent + y);
    private void Delete(Guid id) { if (_objects.FirstOrDefault(item => item.Id == id)?.Kind == CompositionObjectKind.Group) { _groupSelection.Clear(); _groupSelection.Add(id); UngroupSelected(); return; } Snapshot(); _objects.RemoveAll(item => item.Id == id); _selectedId = null; _dirty = true; }
