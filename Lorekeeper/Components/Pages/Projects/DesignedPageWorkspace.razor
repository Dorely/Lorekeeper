    private async Task SetSurfaceKind(CompositionSurfaceKind kind)
    {
        if (_scene is null) return;
        if (_authoringGeometry is null) return;
        if (kind is not CompositionSurfaceKind.SinglePage and not CompositionSurfaceKind.FacingSpread) return;
        if (_scene.Surface.Kind == kind) return;
        var existing = _variants.FirstOrDefault(candidate =>
        {
            var candidateScene = JsonSerializer.Deserialize<CompositionScene>(candidate.SceneJson, ManuscriptCodec.JsonOptions);
            return candidateScene?.Surface.Kind == kind;
        });
        if (existing is not null)
        {
            await SelectVariantAsync(existing.Id);
            return;
        }
        Snapshot();
        var current = _scene.Surface;
        var leafWidth = _authoringGeometry.LeafWidthPoints;
        var leafHeight = _authoringGeometry.LeafHeightPoints;
        var targetWidth = kind == CompositionSurfaceKind.FacingSpread ? leafWidth * 2 : leafWidth;
        var targetHeight = leafHeight;
        RemapSurfaceContents(current.WidthPoints, current.HeightPoints, targetWidth, targetHeight);
        _scene = _scene with
        {
            Surface = current with
            {
                Kind = kind,
                WidthPoints = targetWidth,
                HeightPoints = targetHeight,
                OutputPageMode = CompositionOutputPageMode.EditionLeaves,
                AllowIndependentPdfPage = false,
            },
        };
        MarkDirty();
    }

