    private static List<ManuscriptInline> ReplaceTextPreservingMarks(IReadOnlyList<ManuscriptInline> source, string replacement)
    {
        var original = string.Concat(source.Select(item => item.Text));
        var prefix = 0;
        while (prefix < original.Length && prefix < replacement.Length && original[prefix] == replacement[prefix]) prefix++;
        if (prefix > 0 && prefix < original.Length && char.IsLowSurrogate(original[prefix])) prefix--;
        var suffix = 0;
        while (suffix < original.Length - prefix && suffix < replacement.Length - prefix
            && original[^(suffix + 1)] == replacement[^(suffix + 1)]) suffix++;
        if (suffix > 0 && suffix < original.Length && char.IsHighSurrogate(original[original.Length - suffix - 1])) suffix--;
        var result = SliceInlines(source, 0, prefix);
        var inserted = replacement[prefix..(replacement.Length - suffix)];
        if (inserted.Length > 0) result.Add(new ManuscriptInline { Text = inserted });
        result.AddRange(SliceInlines(source, original.Length - suffix, original.Length));
        if (result.Count == 0) result.Add(new ManuscriptInline { Text = string.Empty });
        return CoalesceInlines(result);
    }

    private static List<ManuscriptInline> SliceInlines(IReadOnlyList<ManuscriptInline> source, int start, int end)
    {
        var result = new List<ManuscriptInline>();
        var cursor = 0;
        foreach (var inline in source)
        {
            var localStart = Math.Max(0, start - cursor);
            var localEnd = Math.Min(inline.Text.Length, end - cursor);
            if (localEnd > localStart)
                result.Add(inline with { Text = inline.Text[localStart..localEnd] });
            cursor += inline.Text.Length;
            if (cursor >= end) break;
        }
        return result;
    }

    private static List<ManuscriptInline> CoalesceInlines(IEnumerable<ManuscriptInline> source)
    {
        var result = new List<ManuscriptInline>();
        foreach (var inline in source.Where(item => item.Text.Length > 0))
        {
            if (result.LastOrDefault() is { } previous
                && previous.Type == inline.Type
                && previous.Marks.SequenceEqual(inline.Marks))
                result[^1] = previous with { Text = previous.Text + inline.Text };
            else
                result.Add(inline);
        }
        return result;
    }
    private string GuideStyle(CompositionGuide guide) => (guide.Axis == CompositionGuideAxis.Horizontal ? "top:" : "left:") + guide.PositionPercent.ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";
    private void AddGuide(CompositionGuideAxis axis) { Snapshot(); _guides.Add(new CompositionGuide(Guid.NewGuid(), axis, 50)); _dirty = true; }
    private void PatchGuide(CompositionGuide guide) { Snapshot(); var index = _guides.FindIndex(item => item.Id == guide.Id); if (index >= 0) _guides[index] = guide; _dirty = true; }
    private void DeleteGuide(Guid id) { Snapshot(); _guides.RemoveAll(item => item.Id == id); _dirty = true; }
    private CompositionBounds EffectiveBounds(CompositionObject item, CompositionObject group) =>
        CompositionSceneResolver.ResolveBounds(_scene!.Surface, item.Bounds, group.Bounds, group.RotationDegrees);
    private void MoveReadingOrder(CompositionObject item, int delta) { var ordered = _objects.Where(candidate => candidate.ReadingOrder is not null).OrderBy(candidate => candidate.ReadingOrder).ToList(); var index = ordered.FindIndex(candidate => candidate.Id == item.Id); var target = index + delta; if (index < 0 || target < 0 || target >= ordered.Count) return; Snapshot(); var other = ordered[target]; var order = item.ReadingOrder; _objects = _objects.Select(candidate => candidate.Id == item.Id ? candidate with { ReadingOrder = other.ReadingOrder } : candidate.Id == other.Id ? candidate with { ReadingOrder = order } : candidate).ToList(); _dirty = true; }
    private bool TextOverflows(CompositionObject item) { var text = string.IsNullOrWhiteSpace(item.TextBinding) ? ManuscriptRangeResolver.ResolveText(new ManuscriptDocument { ManuscriptId = CompositionId, Content = _semanticBlocks }, item.ContentReferences) : item.TextBinding; var resolved = Resolved(item); var widthPoints = _scene!.Surface.WidthPoints * item.Bounds.WidthPercent / 100; var heightPoints = _scene.Surface.HeightPoints * item.Bounds.HeightPercent / 100; var charsPerLine = Math.Max(1, (int)(widthPoints / Math.Max(1, resolved.FontSizePoints * .55))); var lines = Math.Max(1, (int)Math.Ceiling((double)text.Length / charsPerLine)); return lines * resolved.FontSizePoints * resolved.LineHeight > heightPoints; }
    private static string ColorValue(string value) => value.StartsWith('#') && value.Length == 7 ? value : "#000000";
    private static string Color(ChangeEventArgs e) => e.Value?.ToString() ?? "#000000";

    private void ChangeSurfaceKind(ChangeEventArgs e)
    {
        if (_scene is null || !Enum.TryParse<CompositionSurfaceKind>(e.Value?.ToString(), out var kind)) return;
        SetSurfaceKind(kind);
    }

    private string SurfaceClass(CompositionSurfaceKind kind) => _scene?.Surface.Kind == kind ? "selected" : string.Empty;

    private void SetSurfaceKind(CompositionSurfaceKind kind)
    {
        if (_scene is null) return;
        if (_editionGeometry is null) return;
        if (kind == CompositionSurfaceKind.IndependentPage && !_editionGeometry.AllowIndependentPdfPage) return;
        Snapshot();
        var current = _scene.Surface;
        var leafWidth = _editionGeometry.LeafWidthPoints;
        var leafHeight = _editionGeometry.LeafHeightPoints;
        var keepCustomDimensions = kind == CompositionSurfaceKind.IndependentPage
            && current.Kind == CompositionSurfaceKind.IndependentPage;
        var targetWidth = keepCustomDimensions ? current.WidthPoints : kind == CompositionSurfaceKind.FacingSpread ? leafWidth * 2 : leafWidth;
        var targetHeight = keepCustomDimensions ? current.HeightPoints : leafHeight;
        RemapSurfaceContents(current.WidthPoints, current.HeightPoints, targetWidth, targetHeight);
        _scene = _scene with
        {
            Surface = current with
            {
                Kind = kind,
                WidthPoints = targetWidth,
                HeightPoints = targetHeight,
                OutputPageMode = kind == CompositionSurfaceKind.IndependentPage
                    ? CompositionOutputPageMode.SingleSurface
                    : CompositionOutputPageMode.EditionLeaves,
            },
        };
        _dirty = true;
    }

    private void ChangeIndependentDimension(ChangeEventArgs e, bool width)
    {
        if (_scene?.Surface.Kind != CompositionSurfaceKind.IndependentPage) return;
        var inches = Math.Clamp(Number(e), 1, 40);
        var current = _scene.Surface;
        var targetWidth = width ? inches * 72 : current.WidthPoints;
        var targetHeight = width ? current.HeightPoints : inches * 72;
        Snapshot();
        RemapSurfaceContents(current.WidthPoints, current.HeightPoints, targetWidth, targetHeight);
        _scene = _scene with
        {
            Surface = current with { WidthPoints = targetWidth, HeightPoints = targetHeight },
        };
        _dirty = true;
    }

    private void RemapSurfaceContents(double sourceWidth, double sourceHeight, double targetWidth, double targetHeight)
    {
        if (Math.Abs(targetWidth - sourceWidth) <= .01 && Math.Abs(targetHeight - sourceHeight) <= .01)
            return;
        var scale = Math.Min(targetWidth / sourceWidth, targetHeight / sourceHeight);
        var contentWidth = sourceWidth * scale;
        var contentHeight = sourceHeight * scale;
        var offsetX = (targetWidth - contentWidth) / 2;
        var offsetY = (targetHeight - contentHeight) / 2;
        CompositionBounds Map(CompositionBounds bounds) => new()
        {
            XPercent = (offsetX + bounds.XPercent / 100 * contentWidth) / targetWidth * 100,
            YPercent = (offsetY + bounds.YPercent / 100 * contentHeight) / targetHeight * 100,
            WidthPercent = bounds.WidthPercent / 100 * contentWidth / targetWidth * 100,
            HeightPercent = bounds.HeightPercent / 100 * contentHeight / targetHeight * 100,
        };
        _objects = _objects.Select(item => item.GroupId is null ? item with { Bounds = Map(item.Bounds) } : item).ToList();
        _guides = _guides.Select(guide => guide.Axis == CompositionGuideAxis.Vertical
            ? guide with { PositionPercent = (offsetX + guide.PositionPercent / 100 * contentWidth) / targetWidth * 100 }
            : guide with { PositionPercent = (offsetY + guide.PositionPercent / 100 * contentHeight) / targetHeight * 100 }).ToList();
    }

    private sealed record WorkspaceSnapshot(
        List<CompositionObject> Objects,
        List<CompositionLayer> Layers,
        List<CompositionObjectStyle> Styles,
        List<CompositionGuide> Guides,
        List<ManuscriptBlock> SemanticBlocks,
        CompositionSurface Surface);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _workspaceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composition-workspace.js");
    }

    private async Task BeginTransformAsync(PointerEventArgs e, CompositionObject item, TransformMode mode)
    {
        if (IsLocked(item) || _workspaceModule is null) return;
        Snapshot();
        _selectedId = item.Id;
        var bounds = item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group ? EffectiveBounds(item, group) : item.Bounds;
        var rect = await _workspaceModule.InvokeAsync<StageRect>("begin", _stageElement, e.PointerId);
        _transform = new TransformState(item.Id, mode, e.ClientX, e.ClientY, bounds, item.Bounds, item.RotationDegrees, rect);
    }

    private void ContinueTransform(PointerEventArgs e)
    {
        if (_transform is not { } state) return;
        var index = _objects.FindIndex(item => item.Id == state.ObjectId);
        if (index < 0) return;
        var item = _objects[index];
        var dx = (e.ClientX - state.StartClientX) / Math.Max(1, state.Stage.Width) * 100;
        var dy = (e.ClientY - state.StartClientY) / Math.Max(1, state.Stage.Height) * 100;
        if (item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group)
        {
            dx = dx / Math.Max(.01, group.Bounds.WidthPercent) * 100;
            dy = dy / Math.Max(.01, group.Bounds.HeightPercent) * 100;
        }
        item = state.Mode switch
        {
            TransformMode.Move => item with { Bounds = state.LocalBounds with { XPercent = Snap(state.LocalBounds.XPercent + dx, CompositionGuideAxis.Vertical), YPercent = Snap(state.LocalBounds.YPercent + dy, CompositionGuideAxis.Horizontal) } },
            TransformMode.Resize => item with { Bounds = state.LocalBounds with { WidthPercent = Math.Max(.25, Snap(state.LocalBounds.WidthPercent + dx)), HeightPercent = Math.Max(.25, Snap(state.LocalBounds.HeightPercent + dy)) } },
            TransformMode.Rotate => item with { RotationDegrees = state.StartRotation + RotationDelta(e, state) },
            _ => item,
        };
        _objects[index] = item;
        _dirty = true;
    }

    private static double RotationDelta(PointerEventArgs e, TransformState state)
    {
        var centerX = state.Stage.Left + (state.SurfaceBounds.XPercent + state.SurfaceBounds.WidthPercent / 2) / 100 * state.Stage.Width;
        var centerY = state.Stage.Top + (state.SurfaceBounds.YPercent + state.SurfaceBounds.HeightPercent / 2) / 100 * state.Stage.Height;
        var start = Math.Atan2(state.StartClientY - centerY, state.StartClientX - centerX);
        var current = Math.Atan2(e.ClientY - centerY, e.ClientX - centerX);
        return (current - start) * 180 / Math.PI;
    }

    private void EndTransform(PointerEventArgs _) => _transform = null;

    public async ValueTask DisposeAsync()
    {
        if (_workspaceModule is null) return;
        try
        {
            await _workspaceModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit already owns cleanup after disconnect.
        }
    }

    private enum TransformMode { Move, Resize, Rotate }
    private sealed record TransformState(Guid ObjectId, TransformMode Mode, double StartClientX, double StartClientY, CompositionBounds SurfaceBounds, CompositionBounds LocalBounds, double StartRotation, StageRect Stage);
    private sealed record StageRect(double Left, double Top, double Width, double Height);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Selected is not { Locked: false } selected) return;
        var delta = e.ShiftKey ? 1d : .25;
        switch (e.Key)
        {
            case "ArrowLeft": Nudge(selected, -delta, 0); break;
            case "ArrowRight": Nudge(selected, delta, 0); break;
            case "ArrowUp": Nudge(selected, 0, -delta); break;
            case "ArrowDown": Nudge(selected, 0, delta); break;
        }
    }
