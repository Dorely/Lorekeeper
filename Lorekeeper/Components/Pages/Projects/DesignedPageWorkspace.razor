    private static string CssVerticalAlignment(CompositionVerticalAlignment alignment) => alignment switch { CompositionVerticalAlignment.Center => "center", CompositionVerticalAlignment.Bottom => "flex-end", _ => "flex-start" };
    private static string CssTextShadow(CompositionTextShadow shadow) => shadow switch { CompositionTextShadow.Soft => "0 1px 2px #0006", CompositionTextShadow.Strong => "0 2px 4px #000b", CompositionTextShadow.Glow => "0 0 4px currentColor", _ => "none" };
    private static string CssColor(string color, double opacity) => color.StartsWith('#') && color.Length == 7 ? $"rgb({Convert.ToInt32(color[1..3], 16)} {Convert.ToInt32(color[3..5], 16)} {Convert.ToInt32(color[5..7], 16)} / {Math.Clamp(opacity, 0, 1).ToString(System.Globalization.CultureInfo.InvariantCulture)})" : "transparent";
    private static List<ManuscriptInline> ReplaceTextPreservingMarks(IReadOnlyList<ManuscriptInline> source, string replacement)
    {
        var original = string.Concat(source.Select(item => item.Text));
        var prefix = 0;
        while (prefix < original.Length && prefix < replacement.Length && original[prefix] == replacement[prefix]) prefix++;
        if (prefix > 0 && prefix < original.Length && char.IsLowSurrogate(original[prefix])) prefix--;
        var suffix = 0;
        while (suffix < original.Length - prefix && suffix < replacement.Length - prefix
            && original[^(suffix + 1)] == replacement[^(suffix + 1)]) suffix++;
        if (suffix > 0 && suffix < original.Length && char.IsHighSurrogate(original[original.Length - suffix - 1])) suffix--;
        var result = SliceInlines(source, 0, prefix);
        var inserted = replacement[prefix..(replacement.Length - suffix)];
        if (inserted.Length > 0)
        {
            result.Add(new ManuscriptInline
            {
                Text = inserted,
                Marks = InheritedInsertionMarks(source, prefix),
            });
        }
        result.AddRange(SliceInlines(source, original.Length - suffix, original.Length));
        if (result.Count == 0) result.Add(new ManuscriptInline { Text = string.Empty });
        return CoalesceInlines(result);
    }

    private static List<ManuscriptMark> InheritedInsertionMarks(
        IReadOnlyList<ManuscriptInline> source,
        int insertionOffset)
    {
        if (source.Count == 0)
            return [];
        var targetOffset = insertionOffset > 0 ? insertionOffset - 1 : 0;
        var cursor = 0;
        for (var index = 0; index < source.Count; index++)
        {
            var inline = source[index];
            if (targetOffset < cursor + inline.Text.Length || index == source.Count - 1)
                return inline.Marks.Select(mark => mark with { }).ToList();
            cursor += inline.Text.Length;
        }
        return [];
    }

    private static List<ManuscriptInline> SliceInlines(IReadOnlyList<ManuscriptInline> source, int start, int end)
    {
        var result = new List<ManuscriptInline>();
        var cursor = 0;
        foreach (var inline in source)
        {
            var localStart = Math.Max(0, start - cursor);
            var localEnd = Math.Min(inline.Text.Length, end - cursor);
            if (localEnd > localStart)
                result.Add(inline with { Text = inline.Text[localStart..localEnd] });
            cursor += inline.Text.Length;
            if (cursor >= end) break;
        }
        return result;
    }

    private static List<ManuscriptInline> CoalesceInlines(IEnumerable<ManuscriptInline> source)
    {
        var result = new List<ManuscriptInline>();
        foreach (var inline in source.Where(item => item.Text.Length > 0))
        {
            if (result.LastOrDefault() is { } previous
                && previous.Type == inline.Type
                && previous.Marks.SequenceEqual(inline.Marks))
                result[^1] = previous with { Text = previous.Text + inline.Text };
            else
                result.Add(inline);
        }
        return result;
    }
