    private async Task BeginTransformAsync(PointerEventArgs e, CompositionObject item, TransformMode mode)
    {
        if (IsLocked(item) || _workspaceModule is null) return;
        _selectedId = item.Id;
        var bounds = item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group ? EffectiveBounds(item, group) : item.Bounds;
        var attempt = ++_transformAttempt;
        _pendingTransformAttempt = attempt;
        var rect = await _workspaceModule.InvokeAsync<StageRect>("begin", _stageElement, e.PointerId, item.Id.ToString("N"));
        if (_pendingTransformAttempt != attempt)
        {
            if (_pendingTransformAttempt is null && _transform is null)
                await _workspaceModule.InvokeVoidAsync("end", _stageElement, e.PointerId);
            return;
        }
        _pendingTransformAttempt = null;
        Snapshot();
        _transform = new TransformState(item.Id, mode, e.PointerId, e.ClientX, e.ClientY, bounds, item.Bounds, item.RotationDegrees, item.CropXPercent, item.CropYPercent, rect);
    }

    private async Task ContinueTransform(PointerEventArgs e)
    {
        if (_transform is not { } state) return;
        // A release outside the stage never reaches EndTransform; a buttonless move proves it happened.
        if (e.Buttons == 0 && e.PointerType == "mouse")
        {
            await EndTransform(e);
            return;
        }
        var index = _objects.FindIndex(item => item.Id == state.ObjectId);
        if (index < 0) return;
        var item = _objects[index];
        var surfaceDx = (e.ClientX - state.StartClientX) / Math.Max(1, state.Stage.Width) * 100;
        var surfaceDy = (e.ClientY - state.StartClientY) / Math.Max(1, state.Stage.Height) * 100;
        var dx = surfaceDx;
        var dy = surfaceDy;
        if (item.Kind == CompositionObjectKind.Text && Math.Abs(dx) + Math.Abs(dy) > .15)
            _suppressTextEditId = item.Id;
        if (item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group)
        {
            dx = dx / Math.Max(.01, group.Bounds.WidthPercent) * 100;
            dy = dy / Math.Max(.01, group.Bounds.HeightPercent) * 100;
        }
        item = state.Mode switch
        {
            TransformMode.Move => item with { Bounds = state.LocalBounds with { XPercent = Snap(state.LocalBounds.XPercent + dx, CompositionGuideAxis.Vertical), YPercent = Snap(state.LocalBounds.YPercent + dy, CompositionGuideAxis.Horizontal) } },
            TransformMode.Resize => item with { Bounds = ResizeBounds(item, state, dx, dy, e.ClientX - state.StartClientX, e.ClientY - state.StartClientY) },
            TransformMode.Rotate => item with { RotationDegrees = state.StartRotation + RotationDelta(e, state) },
            TransformMode.Crop => item with
            {
                CropXPercent = Math.Clamp(state.StartCropX - surfaceDx / Math.Max(.01, state.SurfaceBounds.WidthPercent) * 100, 0, 100),
                CropYPercent = Math.Clamp(state.StartCropY - surfaceDy / Math.Max(.01, state.SurfaceBounds.HeightPercent) * 100, 0, 100),
            },
            _ => item,
        };
        _objects[index] = item;
        MarkDirty();
    }

    private CompositionBounds ResizeBounds(CompositionObject item, TransformState state, double dx, double dy, double clientDx, double clientDy)
    {
        if (item.Kind != CompositionObjectKind.Image || !RetainsAspectRatio(item) || state.Stage.ImageAspectRatio is not > 0)
            return state.LocalBounds with
            {
                WidthPercent = Math.Max(.25, Snap(state.LocalBounds.WidthPercent + dx)),
                HeightPercent = Math.Max(.25, Snap(state.LocalBounds.HeightPercent + dy)),
            };

        var ratio = state.Stage.ImageAspectRatio.Value;
        var widthPixels = Math.Max(2, state.SurfaceBounds.WidthPercent / 100 * state.Stage.Width + clientDx);
        var heightPixels = Math.Max(2, state.SurfaceBounds.HeightPercent / 100 * state.Stage.Height + clientDy);
        if (Math.Abs(clientDx) >= Math.Abs(clientDy))
            heightPixels = widthPixels / ratio;
        else
            widthPixels = heightPixels * ratio;
        var surfaceWidth = widthPixels / Math.Max(1, state.Stage.Width) * 100;
        var surfaceHeight = heightPixels / Math.Max(1, state.Stage.Height) * 100;
        var widthScale = surfaceWidth / Math.Max(.01, state.SurfaceBounds.WidthPercent);
        var heightScale = surfaceHeight / Math.Max(.01, state.SurfaceBounds.HeightPercent);
        return state.LocalBounds with
        {
            WidthPercent = Math.Max(.25, state.LocalBounds.WidthPercent * widthScale),
            HeightPercent = Math.Max(.25, state.LocalBounds.HeightPercent * heightScale),
        };
    }

    private static double RotationDelta(PointerEventArgs e, TransformState state)
    {
        var centerX = state.Stage.Left + (state.SurfaceBounds.XPercent + state.SurfaceBounds.WidthPercent / 2) / 100 * state.Stage.Width;
        var centerY = state.Stage.Top + (state.SurfaceBounds.YPercent + state.SurfaceBounds.HeightPercent / 2) / 100 * state.Stage.Height;
        var start = Math.Atan2(state.StartClientY - centerY, state.StartClientX - centerX);
        var current = Math.Atan2(e.ClientY - centerY, e.ClientX - centerX);
        return (current - start) * 180 / Math.PI;
    }

    private async Task EndTransform(PointerEventArgs _)
    {
        _pendingTransformAttempt = null;
        if (_transform is not { } state)
            return;
        _transform = null;
        if (_workspaceModule is not null)
            await _workspaceModule.InvokeVoidAsync("end", _stageElement, state.PointerId);
        if (_dirty)
        {
            _autosaveCancellation?.Cancel();
            await SaveAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposing || _disposed) return;
        _disposing = true;
        // Drain an in-flight registration before flushing or releasing its lease.
        await _authoringWriterGate.WaitAsync();
        _authoringWriterGate.Release();
        _autosaveCancellation?.Cancel();
        var flushed = false;
        try
        {
            flushed = await FlushAsync();
            await _saveGate.WaitAsync();
            _saveGate.Release();
            flushed &= !_dirty && _journalRecoverable;
        }
        catch { }
        _autosaveCancellation?.Dispose();
        _autosaveCancellation = null;
        await _authoringWriterGate.WaitAsync();
        try
        {
            if (_authoringWriterLease is not null && flushed)
                await _authoringWriterLease.DisposeAsync();
            else if (_authoringWriterLease is not null)
                MarkAuthoringWriterUnreachable();
            _authoringWriterLease = null;
            _registeredAuthoringTarget = null;
            _disposed = true;
        }
        finally { _authoringWriterGate.Release(); }
        if (_workspaceModule is null)
        {
            _dotNetReference?.Dispose();
            if (_journalModule is not null)
                await _journalModule.DisposeAsync();
            return;
        }
        try
        {
            await _workspaceModule.InvokeVoidAsync("disconnectTextOverflow", _stageElement);
            await _workspaceModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit already owns cleanup after disconnect.
        }
        finally
        {
            _dotNetReference?.Dispose();
            if (_journalModule is not null)
                await _journalModule.DisposeAsync();
        }
    }

    private string AuthoringTargetId() => ContentTarget.EditionId is { } editionId
        ? $"release:{editionId:D}:designed-page-content:{_composition!.Id:D}"
        : $"designed-page-content:{_composition!.Id:D}";

    private async Task OpenAuthoringWriterAsync(bool allowDuringDisposal = false)
    {
        await _authoringWriterGate.WaitAsync();
        try
        {
            if (_disposed || (_disposing && !allowDuringDisposal) || !_journalInitialized || _composition is null)
                return;
            var target = new AuthoringTargetReferenceV1(ProjectId, AuthoringTargetId());
            if (_authoringWriterLease is not null && _registeredAuthoringTarget == target)
                return;
            _openingAuthoringWriter = true;
            if (_authoringWriterLease is not null)
            {
                await _authoringWriterLease.DisposeAsync();
                _authoringWriterLease = null;
                _registeredAuthoringTarget = null;
            }
            var sessionId = _journalModule is null
                ? Guid.NewGuid()
                : await _journalModule.InvokeAsync<Guid>("sessionId", target.ProjectId.ToString("D"), target.TargetId);
            var generation = (await AuthoringGenerations.ReadAsync(target.ProjectId, [target.TargetId]))[target.TargetId];
            if (_disposed || (_disposing && !allowDuringDisposal)
                || target.ProjectId != ProjectId || target.TargetId != AuthoringTargetId())
                return;
            _authoringWriterLease = await AuthoringFence.RegisterWriterAsync(new(
                target, sessionId, _authoringWriterId, FreezeAndFlushAuthoringAsync,
                async _ => await InvokeAsync(() =>
                {
                    _authoringFrozen = false;
                    if (!_disposing && !_disposed) StateHasChanged();
                })));
            _registeredAuthoringTarget = target;
            _authoringSessionId = sessionId;
            _authoringGeneration = generation;
            _authoringWriterError = null;
            UpdateAuthoringWriterState();
        }
        catch (AuthoringMutationFenceException exception)
        {
            // Never steal another live writer or let an ownership conflict end the circuit.
            _authoringWriterError = exception.Message;
        }
        finally
        {
            _openingAuthoringWriter = false;
            _authoringWriterGate.Release();
        }
    }

    private async Task RetryAuthoringWriterAsync()
    {
        if (_disposing || _disposed || InteractionLocked) return;
        // Refresh a clean canvas before resuming after another writer released it.
        _loadedRefreshSignal = -1;
        await OnParametersSetAsync();
        await OpenAuthoringWriterAsync();
    }

    private async Task<AuthoringWriterFlushResult> FreezeAndFlushAuthoringAsync(long capturedSequence, CancellationToken cancellationToken)
    {
        _authoringFrozen = true;
        var saved = false;
        await InvokeAsync(async () => saved = await FlushAsync());
        return new(capturedSequence, !saved, IsRecoverable: saved || _journalRecoverable, IsReachable: true,
            saved ? null : "AUTHORING_FLUSH_FAILED",
            saved ? null : _error ?? "Designed Page changes could not be saved.");
    }

    private void UpdateAuthoringWriterState()
    {
        if (_authoringWriterLease is null || _registeredAuthoringTarget is null)
            return;
        AuthoringFence.UpdateWriterState(new(
            _registeredAuthoringTarget, _authoringSessionId, _authoringWriterId, _authoringGeneration,
            _changeVersion, _changeVersion, _dirty ? 0 : _changeVersion,
            _dirty, IsRecoverable: _journalRecoverable));
    }

    private void MarkAuthoringWriterUnreachable()
    {
        if (_authoringWriterLease is null || _registeredAuthoringTarget is null)
            return;
        AuthoringFence.UpdateWriterState(new(
            _registeredAuthoringTarget, _authoringSessionId, _authoringWriterId, _authoringGeneration,
            _changeVersion, _changeVersion, 0,
            IsDirty: true, IsRecoverable: false, IsReachable: false));
    }

    private async Task<bool> PersistPendingAsync(string token, IReadOnlyList<ManuscriptBlock> semanticBlocks, CompositionScene scene)
    {
        if (_journalModule is null || _composition is null || _variant is null)
            return FailJournal("The local canvas recovery journal is unavailable.");
        try
        {
            await _journalModule.InvokeVoidAsync("write", ProjectId.ToString("D"), AuthoringTargetId(), token,
                new DesignedPagePending(_recoveredContentRevision ?? _composition.Revision,
                    _recoveredVariantRevision ?? _variant.Revision, _variant.Id,
                    ManuscriptCodec.Serialize(new ManuscriptDocument { ManuscriptId = _composition.Id, Revision = _composition.Revision, Content = semanticBlocks.ToList() }),
                    JsonSerializer.Serialize(scene, ManuscriptCodec.JsonOptions)));
            _journalToken = token;
            _journalRecoverable = true;
            UpdateAuthoringWriterState();
            return true;
        }
        catch (Exception exception) { return FailJournal(exception.Message); }
    }

    private async Task<bool> RemovePendingAsync(string token)
    {
        try
        {
            // A later edit can supersede this record while an older dispatch is
            // in flight. Only that later record is eligible for removal now.
            if (_journalToken != token)
                return true;
            if (_journalModule is null || !await _journalModule.InvokeAsync<bool>("remove", ProjectId.ToString("D"), AuthoringTargetId(), token))
                return FailJournal("The saved page edit could not be cleared from local recovery.");
            if (_journalToken == token) _journalToken = null;
            return true;
        }
        catch (Exception exception) { return FailJournal(exception.Message); }
    }

    private async Task ReloadCanonicalAsync()
    {
        if (_journalToken is not null && !await RemovePendingAsync(_journalToken))
            return;
        _dirty = false;
        _recoveryConflict = false;
        _recoveredContentRevision = null;
        _recoveredVariantRevision = null;
        _error = null;
        _loadedRefreshSignal = -1;
        await OnParametersSetAsync();
    }

    private async Task RecoverPendingAsync()
    {
        if (_journalModule is null || _composition is null || _variant is null) return;
        try
        {
            var entry = await _journalModule.InvokeAsync<CanvasJournalEntry?>("read", ProjectId.ToString("D"), AuthoringTargetId());
            var pending = entry?.Payload.Deserialize<DesignedPagePending>(ManuscriptCodec.JsonOptions);
            if (pending is null) return;
            if (pending.VariantId != _variant.Id)
            {
                var recoveredVariant = await DesignedPages.ReadVariantAsync(ProjectId, pending.VariantId);
                if (recoveredVariant.ContentId != _composition.Id)
                    throw new InvalidDataException("The local page recovery record targets a different composition.");
                _variant = recoveredVariant;
                // The recovery entry may select another saved layout of the
                // same content. Hydrate all scene-backed editor collections
                // before the equivalence shortcut below can return; otherwise
                // the next edit would save the old variant's objects over it.
                _scene = JsonSerializer.Deserialize<CompositionScene>(_variant.SceneJson, ManuscriptCodec.JsonOptions)
                    ?? throw new InvalidDataException("The current recovered Designed Page scene is empty.");
                _objects = _scene.Objects.ToList();
                _layers = _scene.Layers.ToList();
                _styles = _scene.Styles.ToList();
                _groupSelection.Clear();
                _selectedId = _objects.FirstOrDefault()?.Id;
            }
            _journalToken = entry!.Token;
            if (PendingMatchesCanonical(pending))
            {
                // The commit succeeded before a crash or disconnect prevented
                // acknowledgement. Reconcile the durable canonical state rather
                // than replaying this now-stale draft.
                await RemovePendingAsync(entry.Token);
                return;
            }
            _semanticBlocks = ManuscriptCodec.Deserialize(pending.SemanticJson, _composition.Id, _composition.Revision).Content.ToList();
            var restoredScene = JsonSerializer.Deserialize<CompositionScene>(pending.SceneJson, ManuscriptCodec.JsonOptions)
                ?? _scene
                ?? throw new InvalidDataException("The journaled Designed Page scene is empty.");
            _scene = restoredScene;
            _objects = restoredScene.Objects.ToList(); _layers = restoredScene.Layers.ToList(); _styles = restoredScene.Styles.ToList();
            _recoveredContentRevision = pending.ContentRevision;
            _recoveredVariantRevision = pending.VariantRevision;
            _journalRecoverable = true;
            _dirty = true;
            _changeVersion++;
            ScheduleAutosave();
        }
        catch (Exception exception) { _ = FailJournal(exception.Message); }
    }

    private bool PendingMatchesCanonical(DesignedPagePending pending)
    {
        if (_composition is null || _variant is null)
            return false;
        var pendingDocument = ManuscriptCodec.Deserialize(pending.SemanticJson, _composition.Id, pending.ContentRevision);
        var canonicalDocument = ManuscriptCodec.Deserialize(_composition.SemanticManuscriptJson, _composition.Id, _composition.Revision);
        var pendingScene = JsonSerializer.Deserialize<CompositionScene>(pending.SceneJson, ManuscriptCodec.JsonOptions);
        var canonicalScene = JsonSerializer.Deserialize<CompositionScene>(_variant.SceneJson, ManuscriptCodec.JsonOptions);
        return JsonSerializer.Serialize(pendingDocument with { Revision = canonicalDocument.Revision }, ManuscriptCodec.JsonOptions)
                   == JsonSerializer.Serialize(canonicalDocument, ManuscriptCodec.JsonOptions)
            && JsonSerializer.Serialize(pendingScene, ManuscriptCodec.JsonOptions)
                   == JsonSerializer.Serialize(canonicalScene, ManuscriptCodec.JsonOptions);
    }

    private bool FailJournal(string message)
    {
        _journalRecoverable = false;
        _error = $"Local recovery is unavailable: {message}";
        UpdateAuthoringWriterState();
        return false;
    }

    private sealed record DesignedPagePending(long ContentRevision, long VariantRevision, Guid VariantId, string SemanticJson, string SceneJson);
    private sealed record CanvasJournalEntry(string Token, JsonElement Payload);

    private enum TransformMode { Move, Resize, Rotate, Crop }
    private enum ImagePickerMode { Add, Replace }
    private sealed record TransformState(Guid ObjectId, TransformMode Mode, long PointerId, double StartClientX, double StartClientY, CompositionBounds SurfaceBounds, CompositionBounds LocalBounds, double StartRotation, double StartCropX, double StartCropY, StageRect Stage);
    private sealed record StageRect(double Left, double Top, double Width, double Height, double? ImageAspectRatio);
    private sealed record TextEditState(string Text, int Start, int End);
    private sealed record TextSelectionRestore(Guid ObjectId, int Start, int End);
    private sealed record TextFocusRequest(Guid ObjectId, double ClientX, double ClientY);
    // Object IDs arrive in the stage's "N" attribute format, which JSON Guid binding rejects.
    public sealed record TextOverflowMeasurement(string ObjectId, bool Overflows);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (CanvasInteractionLocked) return;
        if (Selected is not { Locked: false } selected) return;
        var delta = e.ShiftKey ? 1d : .25;
        if (IsCropRepositioning(selected))
        {
            switch (e.Key)
            {
                case "ArrowLeft": Patch(selected with { CropXPercent = Math.Clamp(selected.CropXPercent + delta, 0, 100) }); break;
                case "ArrowRight": Patch(selected with { CropXPercent = Math.Clamp(selected.CropXPercent - delta, 0, 100) }); break;
                case "ArrowUp": Patch(selected with { CropYPercent = Math.Clamp(selected.CropYPercent + delta, 0, 100) }); break;
                case "ArrowDown": Patch(selected with { CropYPercent = Math.Clamp(selected.CropYPercent - delta, 0, 100) }); break;
            }
            return;
        }
        switch (e.Key)
        {
            case "ArrowLeft": Nudge(selected, -delta, 0); break;
            case "ArrowRight": Nudge(selected, delta, 0); break;
            case "ArrowUp": Nudge(selected, 0, -delta); break;
            case "ArrowDown": Nudge(selected, 0, delta); break;
        }
    }
}
