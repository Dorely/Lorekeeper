    private void RemapSurfaceContents(double sourceWidth, double sourceHeight, double targetWidth, double targetHeight)
    {
        if (Math.Abs(targetWidth - sourceWidth) <= .01 && Math.Abs(targetHeight - sourceHeight) <= .01)
            return;
        var scale = Math.Min(targetWidth / sourceWidth, targetHeight / sourceHeight);
        var contentWidth = sourceWidth * scale;
        var contentHeight = sourceHeight * scale;
        var offsetX = (targetWidth - contentWidth) / 2;
        var offsetY = (targetHeight - contentHeight) / 2;
        CompositionBounds Map(CompositionBounds bounds) => new()
        {
            XPercent = (offsetX + bounds.XPercent / 100 * contentWidth) / targetWidth * 100,
            YPercent = (offsetY + bounds.YPercent / 100 * contentHeight) / targetHeight * 100,
            WidthPercent = bounds.WidthPercent / 100 * contentWidth / targetWidth * 100,
            HeightPercent = bounds.HeightPercent / 100 * contentHeight / targetHeight * 100,
        };
        _objects = _objects.Select(item => item.GroupId is null ? item with { Bounds = Map(item.Bounds) } : item).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposing || _disposed) return;
        if (firstRender)
        {
            _workspaceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composition-workspace.js");
            if (_disposing || _disposed)
            {
                await _workspaceModule.DisposeAsync();
                return;
            }
            _dotNetReference = DotNetObjectReference.Create(this);
            try
            {
                _journalModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composition-authoring-journal.js");
                if (_disposing || _disposed)
                {
                    await _journalModule.DisposeAsync();
                    return;
                }
                await RecoverPendingAsync();
            }
            catch (Exception exception)
            {
                FailJournal(exception.Message);
            }
            _journalInitialized = true;
            await OpenAuthoringWriterAsync();
            if (_disposing || _disposed) return;
            await InvokeAsync(StateHasChanged);
        }
        // The stage renders only once the scene has loaded, which can be after the first render.
        if (_workspaceModule is not null && _dotNetReference is not null
            && _stageElement.Id is { } stageId && stageId != _observedTextOverflowStageId)
        {
            _observedTextOverflowStageId = stageId;
            await _workspaceModule.InvokeVoidAsync("observeTextOverflow", _stageElement, _dotNetReference);
        }
        if (_workspaceModule is not null && _focusTextId is Guid focusId)
        {
            _focusTextId = null;
            if (_textFocusRequest is { } focus && focus.ObjectId == focusId)
            {
                _textFocusRequest = null;
                await _workspaceModule.InvokeVoidAsync(
                    "focusTextEditorAt",
                    _stageElement,
                    focusId,
                    focus.ClientX,
                    focus.ClientY);
            }
            else
            {
                await _workspaceModule.InvokeVoidAsync("focusTextEditor", _stageElement, focusId);
            }
        }
        if (_workspaceModule is not null && _textSelectionRestore is { } restore)
        {
            _textSelectionRestore = null;
            await _workspaceModule.InvokeVoidAsync(
                "restoreTextSelection",
                _stageElement,
                restore.ObjectId,
                restore.Start,
                restore.End);
        }
    }

    private Task BeginObjectTransformAsync(PointerEventArgs e, CompositionObject item)
    {
        return BeginTransformAsync(
            e,
            item,
            IsCropRepositioning(item)
                ? TransformMode.Crop
                : TransformMode.Move);
