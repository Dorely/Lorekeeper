    private async Task BeginTransformAsync(PointerEventArgs e, CompositionObject item, TransformMode mode)
    {
        if (IsLocked(item) || _workspaceModule is null) return;
        Snapshot();
        _selectedId = item.Id;
        var bounds = item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId) is { } group ? EffectiveBounds(item, group) : item.Bounds;
        var rect = await _workspaceModule.InvokeAsync<StageRect>("begin", _stageElement, e.PointerId, item.Id.ToString("N"));
        _transform = new TransformState(item.Id, mode, e.PointerId, e.ClientX, e.ClientY, bounds, item.Bounds, item.RotationDegrees, item.CropXPercent, item.CropYPercent, rect);
