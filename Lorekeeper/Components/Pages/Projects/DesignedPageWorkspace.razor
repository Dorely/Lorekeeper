    [JSInvokable]
    public Task UpdateTextOverflowAsync(IReadOnlyList<TextOverflowMeasurement> measurements)
    {
        var measured = measurements.Select(item => Guid.Parse(item.ObjectId)).ToHashSet();
        var overflowing = measurements.Where(item => item.Overflows).Select(item => Guid.Parse(item.ObjectId)).ToHashSet();
        if (_measuredTextObjects.SetEquals(measured) && _overflowingTextObjects.SetEquals(overflowing))
            return Task.CompletedTask;
        _measuredTextObjects.Clear();
        _measuredTextObjects.UnionWith(measured);
        _overflowingTextObjects.Clear();
        _overflowingTextObjects.UnionWith(overflowing);
        return InvokeAsync(StateHasChanged);
    }
