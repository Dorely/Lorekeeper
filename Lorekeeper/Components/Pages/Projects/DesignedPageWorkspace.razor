    private void MarkDirty()
    {
        _dirty = true;
        _changeVersion++;
        ScheduleAutosave();
    }

    private void ScheduleAutosave()
    {
        _autosaveCancellation?.Cancel();
        _autosaveCancellation?.Dispose();
        _autosaveCancellation = new CancellationTokenSource();
        _ = AutosaveAsync(_autosaveCancellation);
    }

    private async Task AutosaveAsync(CancellationTokenSource autosave)
    {
        try
        {
            await Task.Delay(250, autosave.Token);
            await InvokeAsync(SaveAsync);
        }
        catch (OperationCanceledException) when (autosave.IsCancellationRequested)
        {
        }
    }

    private async Task SaveAsync()
    {
        await _saveGate.WaitAsync();
        try
        {
            if (!_dirty || _scene is null || _variant is null)
                return;
            var changeVersion = _changeVersion;
            var scene = _scene with { Layers = _layers.ToList(), Styles = _styles.ToList(), Guides = [], Objects = _objects.ToList() };
            var semanticBlocks = _semanticBlocks.ToList();
            Guid? forkedCompositionId = null;
            if (ContentTarget.EditionId is not null && _composition!.EditionId is null)
            {
                CompositionId = await Manuscripts.EnsureEditionCompositionAsync(
                    ContentTarget,
                    _composition.ChapterId ?? throw new InvalidOperationException("This Designed Page belongs to a publication section."),
                    _composition.Id);
                _composition = await Compositions.GetAsync(ProjectId, CompositionId)
                    ?? throw new InvalidOperationException("The release Designed Page could not be loaded.");
                _variant = await Compositions.GetOrCreateVariantAsync(
                    ProjectId,
                    CompositionId,
                    ContentTarget.EditionId.Value);
                forkedCompositionId = CompositionId;
            }
            var saved = await Compositions.SaveWorkspaceAsync(
                ContentTarget,
                ProjectId,
                _composition!.Id,
                _composition.Revision,
                semanticBlocks,
                _variant.Id,
                _variant.Revision,
                scene);
            _composition = saved.Composition;
            _variant = saved.Variant;
            _variants = await Compositions.ListVariantsAsync(ProjectId, _composition.Id);
            if (_changeVersion == changeVersion)
            {
                _scene = scene;
                _dirty = false;
            }
            _error = null;
            if (forkedCompositionId is Guid forkedId)
                await CompositionForked.InvokeAsync(forkedId);
            await NotifyWorkspaceChangedAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saveGate.Release(); }
    }

    public async Task<bool> FlushAsync()
    {
        _autosaveCancellation?.Cancel();
        while (_dirty)
        {
            var changeVersion = _changeVersion;
            await SaveAsync();
            if (!string.IsNullOrWhiteSpace(_error) || (_dirty && _changeVersion == changeVersion))
                break;
        }
        return !_dirty;
    }

