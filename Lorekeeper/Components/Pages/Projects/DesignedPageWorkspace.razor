    private void ApplySemanticMark(bool enabled)
    {
        if (SelectedSemantic is not { } block)
            return;
        var text = ManuscriptCodec.Text(block);
        if (_markStart < 0 || _markEnd <= _markStart || _markEnd > text.Length)
        {
            _error = "Choose a valid non-empty character range before changing inline formatting.";
            return;
        }
        if (enabled && MarkNeedsValue(_markType) && string.IsNullOrWhiteSpace(_markValue))
        {
            _error = $"{MarkValueLabel(_markType)} is required for this format.";
            return;
        }
        try
        {
            Snapshot();
            var source = new ManuscriptDocument
            {
                ManuscriptId = CompositionId,
                Revision = _composition?.Revision ?? 0,
                Content = _semanticBlocks,
            };
            var (updated, _) = ManuscriptOperations.Apply(
                source,
                [new SetManuscriptInlineMark(
                    block.Id,
                    _markStart,
                    _markEnd,
                    _markType,
                    enabled,
                    enabled && MarkNeedsValue(_markType) ? _markValue.Trim() : null)]);
            _semanticBlocks = updated.Content;
            _dirty = true;
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

