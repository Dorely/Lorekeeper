@using System.Text.Json
@using Lorekeeper.Authoring
@using Lorekeeper.Composition
@using Lorekeeper.Fonts
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Images
@implements IAsyncDisposable
@inject IDesignedPageService DesignedPages
@inject IManuscriptService Manuscripts
@inject IPublicationBookService Books
@inject IPublicationSectionService PublicationSections
@inject IProjectImageService Images
@inject IProjectFontService ProjectFonts
@inject IAuthoringDeltaHistoryRuntime DeltaHistory
@inject IAuthoringMutationFence AuthoringFence
@inject IAuthoringGenerationService AuthoringGenerations
@inject IAuthoringMutationContextAccessor AuthoringMutations
@inject IJSRuntime JS
@inject IPrintPreparationService Printing

@if (_authoringWriterError is not null)
{
    <div class="alert alert-warning" role="status">
        <span>@_authoringWriterError The page is read-only until editing can be resumed.</span>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" disabled="@(_openingAuthoringWriter || InteractionLocked)" @onclick="RetryAuthoringWriterAsync">Retry editing</button>
    </div>
}
<section class="composition-workspace @(CanvasInteractionLocked ? "composition-workspace--locked" : null)" aria-label="Designed page workspace" aria-disabled="@CanvasInteractionLocked" inert="@(CanvasInteractionLocked ? string.Empty : null)" tabindex="0" @onkeydown="HandleKeyDown">
    <style>@((MarkupString)FontFaceCss())</style>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">
            @PublicationDiagnosticText.SanitizeIdentifiers(_error)
            @if (_recoveryConflict)
            {
                <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="ReloadCanonicalAsync">Discard local draft and reload</button>
            }
        </div>
    }
    @if (IsInheritedReleasePage)
    {
        <div class="alert alert-info" role="status">This release is currently inheriting the Core Designed Page. Your first saved change creates an independent release copy; Core content and layout stay unchanged.</div>
    }
    @if (_scene is null) { <p class="text-muted">Loading composition...</p> }
    else
    {
        <CompositionVisualEditorShell AccessibleLabel="Designed page visual editor">
            <Toolbar>
                <nav class="composition-page-strip" aria-label="Page and spread mode">
                    <div class="composition-page-identity"><strong>@(_page?.Name ?? "Designed page")</strong><small>@($"{_scene.Surface.WidthPoints / 72:0.##} × {_scene.Surface.HeightPoints / 72:0.##} in")</small></div>
                    <div class="composition-view-modes" role="group" aria-label="Page surface">
                        <button type="button" class="@SurfaceClass(CompositionSurfaceKind.SinglePage)" @onclick="() => SetSurfaceKind(CompositionSurfaceKind.SinglePage)"><span class="page-thumb single"></span>Single page</button>
                        <button type="button" class="@SurfaceClass(CompositionSurfaceKind.FacingSpread)" @onclick="() => SetSurfaceKind(CompositionSurfaceKind.FacingSpread)"><span class="page-thumb spread"></span>Facing spread</button>
                    </div>
                    <label class="composition-guide-toggle" title="Show or hide trim, safe-area, gutter, and measurement guides"><input type="checkbox" @bind="_showGuides" /><span class="composition-guides-icon" aria-hidden="true">&#9638;</span><span>Guides</span></label>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@InteractionLocked" @onclick="() => _printOpen = true">Print</button>
                </nav>
            </Toolbar>
            <Canvas>
                <div class="composition-stage" style="@StageStyle()" @ref="_stageElement" @onpointermove="ContinueTransform" @onpointerup="EndTransform" @onpointercancel="EndTransform">
                    @if (_showGuides)
                    {
                        <div class="composition-ruler composition-ruler-x"></div><div class="composition-ruler composition-ruler-y"></div>
                        @foreach (var center in SurfaceCenterGuidePositions)
                        {
                            <div class="composition-guide composition-guide-y" style="@CenterGuideStyle(center)"></div>
                        }
                        <div class="composition-guide composition-guide-x" style="top:50%"></div>
                        @foreach (var surface in PageSurfaceBounds)
                        {
                            <div class="composition-safe" style="@BoundsStyle(SafePageSurfaceBounds(surface))"></div>
                        }
                        @if (_scene.Surface.Kind == CompositionSurfaceKind.FacingSpread)
                        {
                            <div class="composition-gutter"></div>
                        }
                    }
                    @foreach (var item in _objects.Where(item => item.LayerId != Guid.Empty && IsVisible(item)))
                    {
                        <div role="button" tabindex="0"
                                data-composition-object-id="@item.Id.ToString("N")"
                                class="composition-object composition-object--@item.Kind.ToString().ToLowerInvariant() @(item.Id == _selectedId ? "selected" : null) @(IsCropRepositioning(item) ? "crop-repositioning" : null)"
                                style="@ObjectStyle(item)"
                                @onclick:stopPropagation="true"
                                @onclick="e => SelectOrEditObject(item, e)"
                                @onpointerdown:stopPropagation="true"
                                @onpointerdown:preventDefault="true"
                                @onpointerdown="e => BeginObjectTransformAsync(e, item)">
                            @if (item.Kind == CompositionObjectKind.Text)
                            {
                                @if (_editingTextId == item.Id)
                                {
                                    <div class="composition-text-editor"
                                         data-composition-text-id="@item.Id"
                                         contenteditable="true"
                                         role="textbox"
                                         aria-multiline="true"
                                         spellcheck="true"
                                         @onclick:stopPropagation="true"
                                         @onpointerdown:stopPropagation="true"
                                         @onkeydown:stopPropagation="true"
                                         @onblur="() => FinishTextEditAsync(item.Id)">@((MarkupString)RenderedInlineHtml(item))</div>
                                }
                                else
                                {
                                    <span class="composition-rendered-text">@((MarkupString)RenderedInlineHtml(item))</span>
                                }
                            }
                            else if (item.Kind == CompositionObjectKind.Image)
                            {
                                @if (item.ImageId is Guid imageId && Image(imageId) is { } image)
                                {
                                    <img src="@image.PreviewUrl" alt="" draggable="false" style="@ImageStyle(item)" />
                                }
                                else
                                {
                                    <span>Choose image</span>
                                }
                            }
                            else if (item.Kind == CompositionObjectKind.Line)
                            {
                                <span class="composition-line" style="@LineStyle(item)"></span>
                            }
                            @if (item.Id == _selectedId && !IsLocked(item) && !IsCropRepositioning(item))
                            {
                                <span class="composition-handle composition-handle-resize" title="Drag to resize" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true" @onpointerdown="e => BeginTransformAsync(e, item, TransformMode.Resize)"></span>
                                <span class="composition-handle composition-handle-rotate" title="Drag to rotate" @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true" @onpointerdown="e => BeginTransformAsync(e, item, TransformMode.Rotate)"></span>
                            }
                        </div>
                    }
                </div>
            </Canvas>
            <Objects>
                <div class="composition-object-pane">
                    <div class="composition-add-tools" aria-label="Add page content">
                        <button type="button" title="Add a text frame" @onclick="AddTextObject"><span aria-hidden="true">T</span> Text</button>
                        <button type="button" title="Choose artwork from the project image library" @onclick="OpenAddImagePicker"><span aria-hidden="true">▧</span> Image</button>
                        <label class="composition-retain-aspect composition-retain-aspect--compact" title="Keep newly added artwork proportional when it is resized"><input type="checkbox" aria-label="Keep new artwork proportional" @bind="_newRetainAspectRatio" /><span class="visually-hidden">Keep ratio</span></label>
                        <details class="composition-shapes-menu"><summary title="Add a simple shape">◇</summary><div><button type="button" @onclick="() => AddObject(CompositionObjectKind.Rectangle)">Rectangle</button><button type="button" @onclick="() => AddObject(CompositionObjectKind.Ellipse)">Ellipse</button><button type="button" @onclick="() => AddObject(CompositionObjectKind.Line)">Line</button></div></details>
                    </div>
                    <div class="composition-object-strip" role="listbox" aria-label="Page objects">
                        @foreach (var item in _objects.Where(item => item.Kind != CompositionObjectKind.Group).OrderByDescending(item => item.ZIndex))
                        {
                            <button type="button" role="option" aria-selected="@(item.Id == _selectedId)" class="@(item.Id == _selectedId ? "selected" : null)" title="Select @ObjectLabel(item)" @onclick="() => SelectObject(item.Id)">
                                @if (item.Kind == CompositionObjectKind.Image && item.ImageId is Guid thumbnailId && Image(thumbnailId) is { } thumbnail) { <img src="@thumbnail.PreviewUrl" alt="" /> } else { <span aria-hidden="true">@ObjectIcon(item.Kind)</span> }
                                <small>@ObjectLabel(item)</small>
                            </button>
                        }
                    </div>
                </div>
            </Objects>
            <Selection>
                @if (Selected is { } primarySelection)
                {
                    <div class="composition-selection-controls">
                        @if (primarySelection.Kind == CompositionObjectKind.Image)
                        {
                            <button type="button" title="Choose different artwork for this image" @onclick="() => OpenReplaceImagePicker(primarySelection.Id)">Replace</button>
                            <label class="composition-retain-aspect" title="Keep the artwork's original proportions while resizing"><input type="checkbox" checked="@RetainsAspectRatio(primarySelection)" @onchange="e => SetRetainAspectRatioAsync(primarySelection, (bool)e.Value!)" /> Ratio</label>
                            <button type="button" title="Fill the entire page; proportional artwork is cropped rather than stretched" @onclick="() => FillCanvasAsync(primarySelection)">Fill canvas</button>
                            @if (primarySelection.ImageFit == FigureImageFit.Cover) { <button type="button" class="@(IsCropRepositioning(primarySelection) ? "selected" : null)" title="Drag the artwork within its fixed frame to choose the crop" @onclick="() => ToggleCropReposition(primarySelection)">@(IsCropRepositioning(primarySelection) ? "Finish crop" : "Reposition crop")</button> }
                        }
                        else if (primarySelection.Kind == CompositionObjectKind.Text)
                        {
                            var primaryStyle = Resolved(primarySelection);
                            <button type="button" disabled="@IsBoundText(primarySelection)" class="@(_editingTextId == primarySelection.Id ? "selected" : null)" title="@(IsBoundText(primarySelection) ? "This copy comes from Core Book details" : "Edit the text directly in this frame")" @onclick="() => BeginTextEdit(primarySelection)">@(IsBoundText(primarySelection) ? "Linked book text" : _editingTextId == primarySelection.Id ? "Editing text" : "Edit text")</button>
                            <label title="@(IsProtectedBoundText(primarySelection) ? "Generated publication fields remain linked to Book details" : "Fill this frame from a Book details field")">Linked field<select disabled="@IsProtectedBoundText(primarySelection)" value="@BoundFieldValue(primarySelection)" @onchange="e => SetBoundFieldAsync(primarySelection, e.Value?.ToString())"><option value="">Not linked</option>@foreach (var binding in PublicationTextBindings.CanonicalDefinitions) { <option value="@binding.PublicationField!.Value">@binding.Label</option> }</select></label>
                            <div class="composition-inline-formatting" aria-label="Inline text formatting">
                                <button type="button" disabled="@IsBoundText(primarySelection)" title="Bold selected text" aria-label="Bold selected text" @onpointerdown:preventDefault="true" @onclick="() => ToggleInlineMarkAsync(primarySelection, ManuscriptMarkType.Strong)"><strong>B</strong></button>
                                <button type="button" disabled="@IsBoundText(primarySelection)" title="Italicize selected text" aria-label="Italicize selected text" @onpointerdown:preventDefault="true" @onclick="() => ToggleInlineMarkAsync(primarySelection, ManuscriptMarkType.Emphasis)"><em>I</em></button>
                                <button type="button" disabled="@IsBoundText(primarySelection)" title="Underline selected text" aria-label="Underline selected text" @onpointerdown:preventDefault="true" @onclick="() => ToggleInlineMarkAsync(primarySelection, ManuscriptMarkType.Underline)"><u>U</u></button>
                                <button type="button" disabled="@IsBoundText(primarySelection)" title="Strike through selected text" aria-label="Strike through selected text" @onpointerdown:preventDefault="true" @onclick="() => ToggleInlineMarkAsync(primarySelection, ManuscriptMarkType.Strikethrough)"><s>S</s></button>
                            </div>
                            <label>Font<select value="@primaryStyle.FontFamilyKey" @onchange="e => Patch(primarySelection with { StyleId = null, FontFamilyKey = e.Value?.ToString() ?? string.Empty })">@foreach (var family in _fontFamilies) { <option value="@family.Key">@family.Name</option> }</select></label>
                            <label>Size<input class="composition-number" type="number" min="4" max="240" value="@primaryStyle.FontSizePoints" @onchange="e => Patch(primarySelection with { StyleId = null, FontSizePoints = Number(e) })" /></label>
                            <label>Align<select value="@primaryStyle.TextAlignment" @onchange="e => Patch(primarySelection with { StyleId = null, TextAlignment = Enum.Parse<CompositionTextAlignment>(e.Value!.ToString()!) })">@foreach (var alignment in Enum.GetValues<CompositionTextAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                            <label>Text<input type="color" title="Text color" value="@ColorValue(primaryStyle.FillColor)" @onchange="e => Patch(primarySelection with { StyleId = null, FillColor = Color(e) })" /></label>
                            @if (TextOverflows(primarySelection)) { <span class="composition-warning">Text may overflow</span> }
                        }
                        else if (primarySelection.Kind is CompositionObjectKind.Rectangle or CompositionObjectKind.Ellipse or CompositionObjectKind.Line)
                        {
                            var primaryStyle = Resolved(primarySelection);
                            <label>Fill<input type="color" value="@ColorValue(primaryStyle.FillColor)" @onchange="e => Patch(primarySelection with { StyleId = null, FillColor = Color(e) })" /></label><label>Border<input type="color" value="@ColorValue(primaryStyle.StrokeColor)" @onchange="e => Patch(primarySelection with { StyleId = null, StrokeColor = Color(e) })" /></label>
                        }
                        @if (primarySelection.Kind is CompositionObjectKind.Text or CompositionObjectKind.Image)
                        {
                            <button type="button" title="Expand this frame to the full width of its current page without stretching artwork" @onclick="() => FitSelectionWidth(primarySelection, false)">Fit width</button>
                            <button type="button" title="Expand this frame to the safe width of its current page without stretching artwork" @onclick="() => FitSelectionWidth(primarySelection, true)">Fit safe width</button>
                            <button type="button" title="Center this frame horizontally within its current page" @onclick="() => CenterSelection(primarySelection, false)">Center</button>
                            <button type="button" title="Center this frame horizontally within the safe page margins" @onclick="() => CenterSelection(primarySelection, true)">Center safe</button>
                            <button type="button" title="Rotate this frame clockwise by 90 degrees" @onclick="() => Patch(CompositionObjectLayout.RotateQuarterTurn(primarySelection))">Rotate 90°</button>
                            <button type="button" disabled="@(Math.Abs(primarySelection.RotationDegrees) <= .001)" title="Reset this frame to zero degrees" @onclick="() => Patch(CompositionObjectLayout.ResetRotation(primarySelection))">Reset rotation</button>
                        }
                        <span class="composition-control-divider" aria-hidden="true"></span>
                        <button type="button" title="Move this object behind every other object" @onclick="() => SendToBack(primarySelection)">Back</button><button type="button" title="Move this object in front of every other object" @onclick="() => BringToFront(primarySelection)">Front</button><button type="button" class="@(!primarySelection.Visible ? "selected" : null)" title="Show or hide this object" @onclick="() => ToggleObjectVisibility(primarySelection)">@(primarySelection.Visible ? "Hide" : "Show")</button><button type="button" class="@(primarySelection.Locked ? "selected" : null)" title="Lock or unlock this object's position" @onclick="() => ToggleObjectLock(primarySelection)">@(primarySelection.Locked ? "Unlock" : "Lock")</button><button type="button" class="danger" disabled="@IsProtectedBoundText(primarySelection)" title="@(IsProtectedBoundText(primarySelection) ? "Generated publication fields cannot be removed" : "Delete selected object")" @onclick="() => Delete(primarySelection.Id)">Delete</button>
                    </div>
                }
                else { <p class="composition-empty-selection">Select an object on the page to edit it. Drag to move; use the handles to resize or rotate.</p> }
            </Selection>
            <Details>
                <div class="composition-workspace-actions">
                    <div><button type="button" title="@UndoTitle" @onclick="() => MoveHistoryAsync(false)" disabled="@(!_history.CanUndo || InteractionLocked)">↶</button><button type="button" title="@RedoTitle" @onclick="() => MoveHistoryAsync(true)" disabled="@(!_history.CanRedo || InteractionLocked)">↷</button><button type="button" title="Zoom out" @onclick="() => _zoom = Math.Max(.5, _zoom - .1)">−</button><span>@Math.Round(_zoom * 100)%</span><button type="button" title="Zoom in" @onclick="() => _zoom = Math.Min(2, _zoom + .1)">+</button></div>
                    <details class="composition-secondary-controls">
                        <summary title="Open accessibility, content, and exact layout settings">Page details</summary>
                        <div class="composition-details-panel">
                                <h3>Selected object details</h3>
                        @if (Selected is { } selected)
                        {
                            <label>Name<input value="@selected.Name" @onchange="e => Patch(selected with { Name = e.Value?.ToString() ?? string.Empty })" /></label>
                            <details class="composition-advanced">
                                <summary>Advanced layout</summary>
                                <div class="composition-grid-2">
                                    <label>X %<input type="number" value="@selected.Bounds.XPercent" @onchange="e => PatchBounds(selected, x: Number(e))" /></label>
                                    <label>Y %<input type="number" value="@selected.Bounds.YPercent" @onchange="e => PatchBounds(selected, y: Number(e))" /></label>
                                    <label>Width %<input type="number" value="@selected.Bounds.WidthPercent" @onchange="e => PatchBounds(selected, width: Number(e))" /></label>
                                    <label>Height %<input type="number" value="@selected.Bounds.HeightPercent" @onchange="e => PatchBounds(selected, height: Number(e))" /></label>
                                </div>
                                <label>Rotation<input type="number" value="@selected.RotationDegrees" @onchange="e => Patch(selected with { RotationDegrees = Number(e) })" /></label>
                                <label>Opacity<input type="range" min="0" max="1" step=".05" value="@selected.Opacity" @onchange="e => Patch(selected with { Opacity = Number(e) })" /></label>
                                <label>Object style<select value="@selected.StyleId" @onchange="e => SetObjectStyle(selected, e)"><option value="">Local formatting</option>@foreach (var style in _styles) { <option value="@style.Id">@style.Name</option> }</select></label>
                                <div class="composition-action-row"><button type="button" @onclick="() => CreateStyleFrom(selected)">Save as reusable style</button>@if (selected.StyleId is Guid styleId) { <button type="button" @onclick="() => DeleteStyle(styleId)">Delete style</button> }</div>
                                <label>Semantic role<select value="@selected.SemanticRole" @onchange="e => Patch(selected with { SemanticRole = Enum.Parse<CompositionSemanticRole>(e.Value!.ToString()!) })">@foreach (var role in Enum.GetValues<CompositionSemanticRole>()) { <option value="@role">@role</option> }</select></label>
                                <label>Reading order<input type="number" value="@selected.ReadingOrder" @onchange="e => Patch(selected with { ReadingOrder = NullableInt(e) })" /></label>
                            </details>
                            @if (selected.Kind == CompositionObjectKind.Image)
                            {
                                <div class="composition-current-image">
                                    @if (selected.ImageId is Guid currentImageId && Image(currentImageId) is { } currentImage)
                                    {
                                        <img src="@currentImage.PreviewUrl" alt="" />
                                        <span><small>Project image</small><strong>@currentImage.FileName</strong></span>
                                    }
                                    else
                                    {
                                        <span><small>Project image</small><strong>No image selected</strong></span>
                                    }
                                    <button type="button" @onclick="() => OpenReplaceImagePicker(selected.Id)">Replace image</button>
                                </div>
                                <button type="button" title="Fill the entire page; proportional artwork is cropped rather than stretched" @onclick="() => FillCanvasAsync(selected)">Fill canvas</button>
                                @if (selected.ImageFit == FigureImageFit.Cover)
                                {
                                    <button type="button" class="@(IsCropRepositioning(selected) ? "selected" : null)" @onclick="() => ToggleCropReposition(selected)">@(IsCropRepositioning(selected) ? "Finish repositioning" : "Reposition crop")</button>
                                }
                                <label>Alternative text<textarea value="@selected.AltText" @onchange="e => SetAltText(selected, e.Value?.ToString() ?? string.Empty)"></textarea></label>
                            }
                            @if (selected.Kind == CompositionObjectKind.Text)
                            {
                                var resolved = Resolved(selected);
                                <details class="composition-advanced">
                                    <summary>Advanced typography</summary>
                                    <label>Font family<select value="@resolved.FontFamilyKey" @onchange="e => Patch(selected with { StyleId = null, FontFamilyKey = e.Value?.ToString() ?? string.Empty })">@foreach (var family in _fontFamilies) { <option value="@family.Key">@family.Name</option> }</select></label>
                                    <label>Font weight<input type="number" min="100" max="900" step="100" value="@resolved.FontWeight" @onchange="e => Patch(selected with { StyleId = null, FontWeight = (int)Number(e) })" /></label>
                                    <label>Font size<input type="number" value="@resolved.FontSizePoints" @onchange="e => Patch(selected with { StyleId = null, FontSizePoints = Number(e) })" /></label>
                                    <label>Line height<input type="number" min=".5" max="4" step=".05" value="@resolved.LineHeight" @onchange="e => Patch(selected with { StyleId = null, LineHeight = Number(e) })" /></label>
                                    <label>Letter spacing (em)<input type="number" min="-1" max="10" step=".01" value="@resolved.LetterSpacingEm" @onchange="e => Patch(selected with { StyleId = null, LetterSpacingEm = Number(e) })" /></label>
                                    <label>Horizontal alignment<select value="@resolved.TextAlignment" @onchange="e => Patch(selected with { StyleId = null, TextAlignment = Enum.Parse<CompositionTextAlignment>(e.Value!.ToString()!) })">@foreach (var alignment in Enum.GetValues<CompositionTextAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                                    <label>Vertical alignment<select value="@resolved.VerticalAlignment" @onchange="e => Patch(selected with { StyleId = null, VerticalAlignment = Enum.Parse<CompositionVerticalAlignment>(e.Value!.ToString()!) })">@foreach (var alignment in Enum.GetValues<CompositionVerticalAlignment>()) { <option value="@alignment">@alignment</option> }</select></label>
                                    <label>Text shadow<select value="@resolved.TextShadow" @onchange="e => Patch(selected with { StyleId = null, TextShadow = Enum.Parse<CompositionTextShadow>(e.Value!.ToString()!) })">@foreach (var shadow in Enum.GetValues<CompositionTextShadow>()) { <option value="@shadow">@shadow</option> }</select></label>
                                    <label>Background<input type="color" value="@ColorValue(resolved.BackgroundColor)" @onchange="e => Patch(selected with { StyleId = null, BackgroundColor = Color(e) })" /></label>
                                    <label>Background opacity<input type="range" min="0" max="1" step=".05" value="@resolved.BackgroundOpacity" @onchange="e => Patch(selected with { StyleId = null, BackgroundOpacity = Number(e) })" /></label>
                                </details>
                                @if (TextOverflows(selected)) { <p class="composition-unplaced">Text is likely to overflow this frame at the current size.</p> }
                            }
                            @if (selected.Kind is CompositionObjectKind.Text or CompositionObjectKind.Rectangle or CompositionObjectKind.Ellipse or CompositionObjectKind.Line)
                            {
                                var resolved = Resolved(selected);
                                <label>Fill<input type="color" value="@ColorValue(resolved.FillColor)" @onchange="e => Patch(selected with { StyleId = null, FillColor = Color(e) })" /></label>
                                <label>Stroke<input type="color" value="@ColorValue(resolved.StrokeColor)" @onchange="e => Patch(selected with { StyleId = null, StrokeColor = Color(e) })" /></label>
                                <label>Stroke width<input type="number" min="0" max="72" step=".25" value="@resolved.StrokeWidthPoints" @onchange="e => Patch(selected with { StyleId = null, StrokeWidthPoints = Number(e) })" /></label>
                            }
                            <div class="composition-action-row">
                                <button type="button" @onclick="() => Nudge(selected, -1, 0)">Left</button>
                                <button type="button" @onclick="() => Nudge(selected, 0, -1)">Up</button>
                                <button type="button" @onclick="() => Nudge(selected, 0, 1)">Down</button>
                                <button type="button" @onclick="() => Nudge(selected, 1, 0)">Right</button>
                                <button type="button" class="danger" disabled="@IsProtectedBoundText(selected)" title="@(IsProtectedBoundText(selected) ? "Generated publication fields cannot be removed" : "Delete selected object")" @onclick="() => Delete(selected.Id)">Delete</button>
                            </div>
                        }
                                <h3>Objects and grouping</h3>
                        @foreach (var item in _objects.OrderByDescending(item => item.ZIndex))
                        {
                            <div class="composition-object-row @(item.Id == _selectedId ? "selected" : null)">
                                <input type="checkbox" title="Select for grouping" checked="@_groupSelection.Contains(item.Id)" @onchange="e => ToggleGroupSelection(item.Id, (bool)e.Value!)" />
                                <button type="button" @onclick="() => _selectedId = item.Id"><span>@item.Kind</span><small>@(string.IsNullOrWhiteSpace(item.Name) ? item.Id.ToString("N")[..8] : item.Name)</small></button>
                            </div>
                        }
                        <div class="composition-add-row"><button type="button" disabled="@(_groupSelection.Count < 2)" @onclick="GroupSelected">Group selected</button><button type="button" disabled="@(_groupSelection.Count == 0)" @onclick="UngroupSelected">Ungroup</button></div>

                        <h3>Reading order</h3>
                        @foreach (var item in _objects.Where(item => item.ReadingOrder is not null).OrderBy(item => item.ReadingOrder))
                        {
                            <div class="reading-row"><span>@item.ReadingOrder</span> @item.SemanticRole <button type="button" @onclick="() => MoveReadingOrder(item, -1)">Up</button><button type="button" @onclick="() => MoveReadingOrder(item, 1)">Down</button></div>
                        }

                        @if (UnplacedCount > 0)
                        {
                            <p class="composition-unplaced" role="status">This page contains text left over from an older layout. It is preserved, but must be placed before publication.</p>
                        }
                        <h3>Saved layouts</h3>
                        <div class="composition-variant-list">
                            @foreach (var candidate in _variants)
                            {
                                <button type="button" class="@(candidate.Id == _variant?.Id ? "selected" : null)" title="Select saved exact-geometry layout" @onclick="() => SelectVariantAsync(candidate.Id)">@VariantLabel(candidate)</button>
                            }
                        </div>
                        <p>@SurfaceSizeLabel(_scene.Surface)</p>
                        </div>
                    </details>
                </div>
            </Details>
        </CompositionVisualEditorShell>
    }
</section>

<ProjectImageLibraryPickerModal ProjectId="@ProjectId"
                                IsOpen="@(_imagePickerMode is not null)"
                                Title="@ImagePickerTitle"
                                PrimaryActionLabel="@ImagePickerActionLabel"
                                AllowedContentTypes="@CompositionImageContentTypes"
                                InitialSelectedImageId="@ImagePickerInitialSelection"
                                OnPrimaryAction="UsePickedImageAsync"
                                OnClose="CloseImagePicker" />

@if (_printOpen)
{
    <PrintPreviewDialog SourceFactory="CreatePrintSourceAsync" Closed="() => _printOpen = false" />
}

@code {
    private bool _printOpen;

    private async Task<PrintSource> CreatePrintSourceAsync(CancellationToken cancellationToken)
    {
        if (!await FlushAsync() || _scene is null || _composition is null || _variant is null)
            throw new InvalidOperationException(_error ?? "Save this page before printing.");
        var scene = _scene with { Layers = _layers.ToList(), Styles = _styles.ToList(), Objects = _objects.ToList(), Guides = [] };
        var semantic = ManuscriptCodec.Deserialize(_composition.SemanticManuscriptJson, _composition.Id, _composition.Revision);
        return await Printing.CreateCompositionAsync(ProjectId, PageId, _variant.Revision,
            _page?.Name ?? "Designed page", scene, semantic, null, cancellationToken);
    }

    [Parameter] public int RefreshSignal { get; set; }
    [Parameter] public Guid? RequestedSelectionId { get; set; }
    [Parameter] public Guid? RequestedVariantId { get; set; }
    [Parameter] public bool InteractionLocked { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid PageId { get; set; }
    [Parameter, EditorRequired] public string PlacementBlockId { get; set; } = string.Empty;
    [Parameter] public EditorContentTarget ContentTarget { get; set; } = EditorContentTarget.Core;
    [Parameter] public EventCallback<WorkspaceState> WorkspaceChanged { get; set; }

    private DesignedPage? _page;
    private DesignedPageContent? _composition;
    private DesignedPageVariant? _variant;
    private IReadOnlyList<DesignedPageVariant> _variants = [];
    private CompositionScene? _scene;
    private List<CompositionObject> _objects = [];
    private List<CompositionLayer> _layers = [];
    private List<CompositionObjectStyle> _styles = [];
    private List<ManuscriptBlock> _semanticBlocks = [];
    private readonly HashSet<PublicationBoundField> _protectedBoundFields = [];
    private CompositionEditionGeometry? _authoringGeometry;
    private IReadOnlyList<ProjectImageView> _images = [];
    private IReadOnlyList<ProjectFontFamilyView> _fontFamilies = [];
    private Lorekeeper.Authoring.AuthoringHistoryState _history = new(false, false, null, null);
    private string UndoTitle => _history.UndoLabel is null ? "Nothing to undo" : $"Undo {_history.UndoLabel}";
    private string RedoTitle => _history.RedoLabel is null ? "Nothing to redo" : $"Redo {_history.RedoLabel}";
    private bool _newRetainAspectRatio = true;
    private ImagePickerMode? _imagePickerMode;
    private Guid? _imagePickerTargetId;
    private Guid? _selectedId;
    private readonly HashSet<Guid> _groupSelection = [];
    private Guid? _editingTextId;
    private Guid? _focusTextId;
    private TextFocusRequest? _textFocusRequest;
    private Guid? _suppressTextEditId;
    private TextSelectionRestore? _textSelectionRestore;
    private Guid _loadedProjectId;
    private Guid _loadedPageId;
    private EditorContentTarget _loadedContentTarget = EditorContentTarget.Core;
    private int _loadedRefreshSignal = -1;
    private string? _loadedPlacementBlockId;
    private Guid? _loadedRequestedVariantId;
    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private CancellationTokenSource? _autosaveCancellation;
    private IAsyncDisposable? _authoringWriterLease;
    private readonly SemaphoreSlim _authoringWriterGate = new(1, 1);
    private AuthoringTargetReferenceV1? _registeredAuthoringTarget;
    private bool _openingAuthoringWriter;
    private string? _authoringWriterError;
    private bool _disposing;
    private bool _disposed;
    private bool CanvasInteractionLocked => InteractionLocked || _authoringFrozen || _authoringWriterLease is null || _authoringWriterError is not null || _disposing || _disposed;
    private Guid _authoringSessionId;
    private readonly Guid _authoringWriterId = Guid.NewGuid();
    private long _authoringGeneration;
    private bool _authoringFrozen;
    private bool _replayingCanvasHistory;
    private bool _dirty;
    private long _changeVersion;
    private double _zoom = 1;
    private bool _showGuides = true;
    private bool _cropReposition;
    private string? _error;
    private ElementReference _stageElement;
    private string? _observedTextOverflowStageId;
    private IJSObjectReference? _workspaceModule;
    private DotNetObjectReference<DesignedPageWorkspace>? _dotNetReference;
    private IJSObjectReference? _journalModule;
    private bool _journalInitialized;
    private bool _journalRecoverable = true;
    private string? _journalToken;
    private bool _recoveryConflict;
    private long? _recoveredContentRevision;
    private long? _recoveredVariantRevision;
    private readonly HashSet<Guid> _measuredTextObjects = [];
    private readonly HashSet<Guid> _overflowingTextObjects = [];
    private TransformState? _transform;
    // A pointer can be released while "begin" is still in flight; that release cancels the attempt.
    private long _transformAttempt;
    private long? _pendingTransformAttempt;
    private CompositionObject? Selected => _objects.FirstOrDefault(item => item.Id == _selectedId);
    private void SelectObject(Guid id)
    {
        if (_selectedId != id)
        {
            _editingTextId = null;
            _cropReposition = false;
        }
        _selectedId = id;
    }
    private void SelectOrEditObject(CompositionObject item, MouseEventArgs e)
    {
        if (_suppressTextEditId == item.Id)
        {
            _suppressTextEditId = null;
            SelectObject(item.Id);
            return;
        }
        if (_selectedId == item.Id && item.Kind == CompositionObjectKind.Text && !IsLocked(item))
            BeginTextEdit(item, e.ClientX, e.ClientY);
        else
            SelectObject(item.Id);
    }
    private static string ObjectLabel(CompositionObject item) => string.IsNullOrWhiteSpace(item.Name) ? item.Kind.ToString() : item.Name;
    private static string ObjectIcon(CompositionObjectKind kind) => kind switch { CompositionObjectKind.Text => "T", CompositionObjectKind.Image => "▧", CompositionObjectKind.Rectangle => "□", CompositionObjectKind.Ellipse => "○", CompositionObjectKind.Line => "—", _ => "◇" };
    private static bool RetainsAspectRatio(CompositionObject item) => CompositionImageLayout.RetainsAspectRatio(item);
    private async Task SetRetainAspectRatioAsync(CompositionObject item, bool retain)
    {
        _cropReposition = false;
        if (!retain)
        {
            Patch(item with { ImageFit = FigureImageFit.Stretch });
            return;
        }
        var aspectRatio = await ImageAspectRatioAsync(item);
        Patch(item with
        {
            ImageFit = FigureImageFit.Contain,
            Bounds = FitInsideBounds(item.Bounds, aspectRatio),
        });
    }
    private Task FillCanvasAsync(CompositionObject item)
    {
        Patch(CompositionImageLayout.FillCanvas(item, RetainsAspectRatio(item)));
        return Task.CompletedTask;
    }
    private async Task<double> ImageAspectRatioAsync(CompositionObject item)
    {
        if (_workspaceModule is not null)
        {
            var ratio = await _workspaceModule.InvokeAsync<double?>(
                "imageAspectRatio",
                _stageElement,
                item.Id.ToString("N"));
            if (ratio is > 0 && double.IsFinite(ratio.Value))
                return ratio.Value;
        }
        return Math.Max(.01, item.Bounds.WidthPercent * _scene!.Surface.WidthPoints)
            / Math.Max(.01, item.Bounds.HeightPercent * _scene.Surface.HeightPoints);
    }
    private CompositionBounds FitInsideBounds(CompositionBounds bounds, double imageAspectRatio)
    {
        var surface = _scene!.Surface;
        var availableWidth = bounds.WidthPercent * surface.WidthPoints / 100;
        var availableHeight = bounds.HeightPercent * surface.HeightPoints / 100;
        var width = availableWidth;
        var height = availableHeight;
        if (availableWidth / Math.Max(.01, availableHeight) > imageAspectRatio)
            width = availableHeight * imageAspectRatio;
        else
            height = availableWidth / Math.Max(.01, imageAspectRatio);
        var widthPercent = width / surface.WidthPoints * 100;
        var heightPercent = height / surface.HeightPoints * 100;
        return bounds with
        {
            XPercent = bounds.XPercent + (bounds.WidthPercent - widthPercent) / 2,
            YPercent = bounds.YPercent + (bounds.HeightPercent - heightPercent) / 2,
            WidthPercent = widthPercent,
            HeightPercent = heightPercent,
        };
    }
    private bool IsCropRepositioning(CompositionObject item) =>
        _cropReposition
        && item.Id == _selectedId
        && item.Kind == CompositionObjectKind.Image
        && item.ImageFit == FigureImageFit.Cover;
    private void ToggleCropReposition(CompositionObject item)
    {
        if (item.Id != _selectedId)
            SelectObject(item.Id);
        _cropReposition = !IsCropRepositioning(item);
    }
    private void ToggleObjectLock(CompositionObject item) => Patch(item with { Locked = !item.Locked });
    private void ToggleObjectVisibility(CompositionObject item)
    {
        if (item.Visible)
            _editingTextId = null;
        Patch(item with { Visible = !item.Visible });
    }
    private HashSet<string> UnplacedIds
    {
        get
        {
            try
            {
                return ManuscriptRangeResolver.ValidateCoverage(
                    new ManuscriptDocument { ManuscriptId = _composition?.Id ?? PageId, Content = _semanticBlocks },
                    _objects.Where(item => item.Kind == CompositionObjectKind.Text && IsVisible(item)).Select(item => item.ContentReferences))
                    .ToHashSet(StringComparer.Ordinal);
            }
            catch (InvalidDataException)
            {
                return _semanticBlocks.Select(block => block.Id).ToHashSet(StringComparer.Ordinal);
            }
        }
    }
    private int UnplacedCount => UnplacedIds.Count;

    protected override async Task OnParametersSetAsync()
    {
        if (_disposing || _disposed) return;
        if (_loadedProjectId == ProjectId
            && _loadedPageId == PageId
            && _loadedPlacementBlockId == PlacementBlockId
            && _loadedContentTarget == ContentTarget
            && _loadedRefreshSignal == RefreshSignal
            && _loadedRequestedVariantId == RequestedVariantId)
            return;
        if (_dirty)
        {
            await SaveAsync();
            if (_dirty)
                return;
        }
        _error = null;
        try
        {
            var view = await DesignedPages.GetAsync(ProjectId, PageId, ContentTarget)
                ?? throw new InvalidOperationException("Designed page was not found.");
            _page = view.Page;
            _composition = view.Content;
            _semanticBlocks = ManuscriptCodec.Deserialize(
                _composition.SemanticManuscriptJson,
                _composition.Id,
                _composition.Revision).Content.ToList();
            await LoadProtectedBoundFieldsAsync();
            await ResolveBoundPageTextAsync();
            _images = (await Images.ListAsync(ProjectId)).Where(image => image.ContentType is "image/png" or "image/jpeg").ToList();
            _fontFamilies = await ProjectFonts.ListAsync(ProjectId);
            await LoadVariantAsync();
            await OpenAuthoringWriterAsync();
            _history = DeltaHistory.Read(AuthoringTargetId()).State;
            if (RequestedSelectionId is Guid requestedSelectionId
                && _objects.Any(item => item.Id == requestedSelectionId))
            {
                _selectedId = requestedSelectionId;
            }
            _loadedProjectId = ProjectId;
            _loadedPageId = PageId;
            _loadedPlacementBlockId = PlacementBlockId;
            _loadedContentTarget = ContentTarget;
            _loadedRefreshSignal = RefreshSignal;
            _loadedRequestedVariantId = RequestedVariantId;
            await NotifyWorkspaceChangedAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task LoadVariantAsync()
    {
        _authoringGeometry = ContentTarget.EditionId is Guid editionId
            ? await DesignedPages.GetEditionGeometryAsync(ProjectId, editionId)
            : await DesignedPages.GetAuthoringGeometryAsync(ProjectId);
        _variant = await ResolveRequestedOrDefaultVariantAsync();
        _variants = await DesignedPages.ListVariantsAsync(ProjectId, _composition!.Id);
        _scene = JsonSerializer.Deserialize<CompositionScene>(_variant.SceneJson, ManuscriptCodec.JsonOptions)
            ?? throw new InvalidDataException("Composition scene is empty.");
        _objects = _scene.Objects.ToList();
        _layers = _scene.Layers.ToList();
        _styles = _scene.Styles.ToList();
        _groupSelection.Clear();
        _selectedId = _objects.FirstOrDefault()?.Id;
        _dirty = false;
    }

    private async Task SelectVariantAsync(Guid variantId)
    {
        if (_variant?.Id == variantId) return;
        if (_dirty)
        {
            await SaveAsync();
            if (_dirty) return;
        }
        _variant = ContentTarget.EditionId is Guid editionId
            ? await DesignedPages.SelectVariantAsync(ProjectId, _composition!.Id, editionId, variantId)
            : await DesignedPages.SelectAuthoringVariantAsync(ProjectId, _composition!.Id, variantId);
        _scene = JsonSerializer.Deserialize<CompositionScene>(_variant.SceneJson, ManuscriptCodec.JsonOptions)
            ?? throw new InvalidDataException("Composition scene is empty.");
        _objects = _scene.Objects.ToList();
        _layers = _scene.Layers.ToList();
        _styles = _scene.Styles.ToList();
        _selectedId = _objects.FirstOrDefault()?.Id;
        _history = DeltaHistory.Read(AuthoringTargetId()).State;
        await NotifyWorkspaceChangedAsync();
    }

    private async Task<DesignedPageVariant> ResolveRequestedOrDefaultVariantAsync()
    {
        if (RequestedVariantId is Guid requestedVariantId)
        {
            var requested = await DesignedPages.ReadVariantAsync(ProjectId, requestedVariantId);
            if (requested.ContentId == _composition!.Id)
                return requested;
        }

        return ContentTarget.EditionId is Guid targetEditionId
            ? _composition!.EditionId is null
                ? await DesignedPages.PreviewEditionVariantAsync(ProjectId, _composition!.Id, targetEditionId)
                : await DesignedPages.GetOrCreateVariantAsync(ProjectId, _composition!.Id, targetEditionId)
            : await DesignedPages.GetOrCreateAuthoringVariantAsync(ProjectId, _composition!.Id);
    }

    private static string VariantLabel(DesignedPageVariant variant)
    {
        var scene = JsonSerializer.Deserialize<CompositionScene>(variant.SceneJson, ManuscriptCodec.JsonOptions);
        return scene is null ? "Saved layout" : $"{scene.Surface.Kind} {scene.Surface.WidthPoints / 72:0.##} x {scene.Surface.HeightPoints / 72:0.##} in";
    }

    private void AddObject(CompositionObjectKind kind)
    {
        if (_scene is null) return;
        if (kind == CompositionObjectKind.Image)
            throw new InvalidOperationException("Images must be created with a project image and fit.");
        Snapshot();
        var layer = ContentLayerId;
        var readingOrder = kind is CompositionObjectKind.Text or CompositionObjectKind.Image
            ? _objects.Where(item => item.ReadingOrder is not null).Select(item => item.ReadingOrder!.Value).DefaultIfEmpty().Max() + 1
            : (int?)null;
        var item = new CompositionObject
        {
            Id = Guid.NewGuid(), LayerId = layer, Kind = kind, Name = kind.ToString(),
            Bounds = new CompositionBounds { XPercent = 10, YPercent = 10, WidthPercent = 40, HeightPercent = 20 },
            ZIndex = NextFrontZIndex(),
            ReadingOrder = readingOrder,
            Decorative = false,
            AccessibilityDecisionPending = kind == CompositionObjectKind.Image,
            SemanticRole = kind == CompositionObjectKind.Image ? CompositionSemanticRole.Figure : kind == CompositionObjectKind.Text ? CompositionSemanticRole.Paragraph : CompositionSemanticRole.Artifact,
        };
        _objects.Add(item); _selectedId = item.Id; MarkDirty();
    }

    private void AddImageObject(ProjectImageView image)
    {
        if (_scene is null)
        {
            return;
        }

        RememberImage(image);
        Snapshot();
        var zIndex = ReserveNewImageZIndex();
        var layer = ContentLayerId;
        var item = new CompositionObject
        {
            Id = Guid.NewGuid(),
            LayerId = layer,
            Kind = CompositionObjectKind.Image,
            Name = image.FileName,
            ImageId = image.Id,
            ImageFit = _newRetainAspectRatio ? FigureImageFit.Contain : FigureImageFit.Stretch,
            Bounds = new CompositionBounds(),
            ZIndex = zIndex,
            ReadingOrder = NextReadingOrder(),
            Decorative = false,
            AccessibilityDecisionPending = true,
            SemanticRole = CompositionSemanticRole.Figure,
        };
        _objects.Add(item);
        _selectedId = item.Id;
        MarkDirty();
        _error = null;
    }

    private void AddTextObject()
    {
        if (_scene is null)
            return;
        Snapshot();
        var blockId = Guid.NewGuid().ToString("N");
        _semanticBlocks.Add(NewTextBlock(blockId));
        var item = new CompositionObject
        {
            Id = Guid.NewGuid(),
            LayerId = ContentLayerId,
            Kind = CompositionObjectKind.Text,
            Name = "Text",
            Bounds = new CompositionBounds { XPercent = 10, YPercent = 10, WidthPercent = 40, HeightPercent = 20 },
            ZIndex = NextFrontZIndex(),
            ContentReferences = [new ManuscriptRangeReference(blockId)],
            ReadingOrder = NextReadingOrder(),
            SemanticRole = CompositionSemanticRole.Paragraph,
        };
        _objects.Add(item);
        _selectedId = item.Id;
        _editingTextId = item.Id;
        _focusTextId = item.Id;
        MarkDirty();
    }

    private void OpenAddImagePicker() { _imagePickerMode = ImagePickerMode.Add; _imagePickerTargetId = null; }
    private void OpenReplaceImagePicker(Guid targetId) { _imagePickerMode = ImagePickerMode.Replace; _imagePickerTargetId = targetId; }
    private void CloseImagePicker() { _imagePickerMode = null; _imagePickerTargetId = null; }
    private Task UsePickedImageAsync(ProjectImageView image)
    {
        if (_imagePickerMode == ImagePickerMode.Add)
            AddImageObject(image);
        else if (_imagePickerMode == ImagePickerMode.Replace
            && _imagePickerTargetId is Guid targetId
            && _objects.FirstOrDefault(item => item.Id == targetId && item.Kind == CompositionObjectKind.Image) is { } target)
        {
            RememberImage(image);
            Patch(target with { ImageId = image.Id, Name = image.FileName });
        }
        return Task.CompletedTask;
    }
    private void RememberImage(ProjectImageView image)
    {
        if (_images.All(candidate => candidate.Id != image.Id))
            _images = _images.Append(image).OrderBy(candidate => candidate.FileName).ToList();
    }
    private string ImagePickerTitle => _imagePickerMode == ImagePickerMode.Replace ? "Replace page image" : "Choose a page image";
    private string ImagePickerActionLabel => _imagePickerMode == ImagePickerMode.Replace ? "Replace image" : "Add image";
    private Guid? ImagePickerInitialSelection => _imagePickerMode == ImagePickerMode.Replace
        && _imagePickerTargetId is Guid targetId
        ? _objects.FirstOrDefault(item => item.Id == targetId)?.ImageId
        : null;
    private static readonly string[] CompositionImageContentTypes = ["image/png", "image/jpeg"];

    private static ManuscriptBlock NewTextBlock(string id, IReadOnlyList<ManuscriptInline>? content = null) => new()
    {
        Id = id,
        Type = ManuscriptBlockType.Paragraph,
        StyleRole = ManuscriptStyleRoles.Body,
        Content = content?.ToList() ?? [new ManuscriptInline { Text = string.Empty }],
    };

    private void BeginTextEdit(CompositionObject item, double? clientX = null, double? clientY = null)
    {
        if (item.Kind != CompositionObjectKind.Text || IsLocked(item) || IsBoundText(item))
            return;
        try
        {
            EnsureOwnedTextBlock(item.Id);
            _selectedId = item.Id;
            _editingTextId = item.Id;
            _focusTextId = item.Id;
            _textFocusRequest = clientX is not null && clientY is not null
                ? new TextFocusRequest(item.Id, clientX.Value, clientY.Value)
                : null;
            _error = null;
        }
        catch (Exception exception)
        {
            _replayingCanvasHistory = false;
            _error = exception.Message;
        }
    }

    private IReadOnlyList<PublicationBoundField> BoundFields(CompositionObject item) => item.ContentReferences
        .Select(reference => _semanticBlocks.FirstOrDefault(block => block.Id == reference.BlockId))
        .Where(block => block?.PublicationField is not null)
        .Select(block => block!.PublicationField!.Value)
        .Distinct()
        .ToList();

    private PublicationBoundField? BoundField(CompositionObject item)
    {
        var fields = BoundFields(item);
        return fields.Count == 1 ? fields[0] : null;
    }

    private bool IsBoundText(CompositionObject item) => BoundFields(item).Count > 0;

    private bool IsProtectedBoundText(CompositionObject item) =>
        BoundFields(item).Any(_protectedBoundFields.Contains);

    private string BoundFieldValue(CompositionObject item) => BoundField(item)?.ToString() ?? string.Empty;

    private async Task SetBoundFieldAsync(CompositionObject item, string? value)
    {
        try
        {
            if (IsProtectedBoundText(item))
                throw new InvalidOperationException("Linked fields in a generated publication page cannot be removed or rebound.");
            if (IsBoundText(item) && BoundField(item) is null)
                throw new InvalidOperationException("This frame contains multiple linked fields and cannot be rebound safely.");
            PublicationBoundField? field = Enum.TryParse<PublicationBoundField>(value, out var parsed)
                && Enum.IsDefined(parsed)
                    ? parsed
                    : null;
            string? text = null;
            if (field is { } selectedField)
            {
                _ = await Books.GetOrCreateAsync(ProjectId);
                text = PublicationTextBindings.NormalizeSemanticText(await PublicationSections.ResolveBoundFieldAsync(
                    new PublicationSectionTarget(ProjectId, ContentTarget.EditionId),
                    selectedField));
            }
            Snapshot();
            var block = EnsureOwnedTextBlock(item.Id);
            var index = _semanticBlocks.FindIndex(candidate => candidate.Id == block.Id);
            if (index < 0)
                throw new InvalidOperationException("The selected text frame no longer has semantic content.");
            _semanticBlocks[index] = block with
            {
                PublicationField = field,
                Content = text is null ? block.Content : [new ManuscriptInline { Text = text }],
            };
            _editingTextId = null;
            MarkDirty();
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private async Task LoadProtectedBoundFieldsAsync()
    {
        _protectedBoundFields.Clear();
        var placement = _page?.PlacementReferences.FirstOrDefault(item => item.Id == PlacementBlockId);
        if (placement is null || placement.ContainerKind != DesignedPageContainerKind.PublicationSection)
            return;

        var section = await PublicationSections.GetAsync(
            new PublicationSectionTarget(ProjectId, ContentTarget.EditionId),
            placement.ContainerId);
        _protectedBoundFields.UnionWith(section.SystemRole switch
        {
            PublicationSectionSystemRole.Title =>
                [PublicationBoundField.Title, PublicationBoundField.Subtitle, PublicationBoundField.Author],
            PublicationSectionSystemRole.Copyright =>
                [PublicationBoundField.Copyright, PublicationBoundField.Publisher, PublicationBoundField.Isbn],
            _ => [],
        });
    }

    private async Task ResolveBoundPageTextAsync()
    {
        if (_semanticBlocks.All(block => block.PublicationField is null))
            return;
        _ = await Books.GetOrCreateAsync(ProjectId);
        var target = new PublicationSectionTarget(ProjectId, ContentTarget.EditionId);
        // Materialize the fields first: the loop replaces list entries, which
        // invalidates any live enumerator over _semanticBlocks.
        var fields = _semanticBlocks.Where(block => block.PublicationField is not null)
            .Select(block => block.PublicationField!.Value)
            .Distinct()
            .ToList();
        foreach (var field in fields)
        {
            var value = PublicationTextBindings.NormalizeSemanticText(
                await PublicationSections.ResolveBoundFieldAsync(target, field));
            for (var index = 0; index < _semanticBlocks.Count; index++)
            {
                if (_semanticBlocks[index].PublicationField == field)
                {
                    _semanticBlocks[index] = _semanticBlocks[index] with
                    {
                        Content = [new ManuscriptInline { Text = value }],
                    };
                }
            }
        }
    }

    private ManuscriptBlock EnsureOwnedTextBlock(Guid objectId)
    {
        var item = _objects.FirstOrDefault(candidate => candidate.Id == objectId && candidate.Kind == CompositionObjectKind.Text)
            ?? throw new InvalidOperationException("The selected text frame no longer exists.");
        if (item.ContentReferences.Count == 1
            && item.ContentReferences[0] is { StartOffset: null, EndOffset: null } reference
            && _objects.Count(candidate => candidate.Kind == CompositionObjectKind.Text
                && candidate.ContentReferences.Any(content => content.BlockId == reference.BlockId)) == 1
            && _semanticBlocks.FirstOrDefault(block => block.Id == reference.BlockId) is { } owned)
        {
            return owned;
        }

        Snapshot();
        if (item.ContentReferences.Count == 0)
        {
            var block = NewTextBlock(Guid.NewGuid().ToString("N"),
                [new ManuscriptInline { Text = item.TextBinding }]);
            _semanticBlocks.Add(block);
            ReplaceObject(item with { TextBinding = string.Empty, ContentReferences = [new ManuscriptRangeReference(block.Id)] });
            MarkDirty();
            return block;
        }

        var sourceBlockIds = item.ContentReferences.Select(reference => reference.BlockId).Distinct(StringComparer.Ordinal).ToList();
        if (sourceBlockIds.Count != 1)
            return MaterializeLegacyMultiBlockFrame(item, sourceBlockIds);
        var sourceBlockId = sourceBlockIds[0];
        if (UnplacedIds.Contains(sourceBlockId))
            throw new InvalidDataException("This older layout contains preserved text outside its frames. Place that text before editing this frame.");

        var sourceDocument = new ManuscriptDocument { ManuscriptId = _composition!.Id, Content = _semanticBlocks };
        var sourceFrames = _objects.Where(candidate => candidate.Kind == CompositionObjectKind.Text
            && candidate.ContentReferences.Any(reference => reference.BlockId == sourceBlockId))
            .OrderBy(candidate => candidate.ReadingOrder ?? int.MaxValue)
            .ThenBy(candidate => candidate.ZIndex)
            .ToList();
        var sourceIndex = _semanticBlocks.FindIndex(block => block.Id == sourceBlockId);
        var materialized = new List<ManuscriptBlock>();
        ManuscriptBlock? requested = null;
        foreach (var frame in sourceFrames)
        {
            var slices = ManuscriptRangeResolver.ResolveBlocks(sourceDocument, frame.ContentReferences);
            var content = JoinInlineSlices(slices.Select(slice => slice.Content));
            var template = slices.FirstOrDefault() ?? _semanticBlocks.First(block => block.Id == sourceBlockId);
            var block = template with { Id = Guid.NewGuid().ToString("N"), Content = content };
            materialized.Add(block);
            ReplaceObject(frame with { TextBinding = string.Empty, ContentReferences = [new ManuscriptRangeReference(block.Id)] });
            if (frame.Id == objectId)
                requested = block;
        }
        _semanticBlocks.RemoveAll(block => block.Id == sourceBlockId);
        _semanticBlocks.InsertRange(Math.Max(0, sourceIndex), materialized);
        MarkDirty();
        return requested ?? throw new InvalidOperationException("The selected text frame could not be prepared for editing.");
    }

    private ManuscriptBlock MaterializeLegacyMultiBlockFrame(
        CompositionObject item,
        IReadOnlyList<string> sourceBlockIds)
    {
        if (sourceBlockIds.Count == 0
            || item.ContentReferences.Any(reference => reference.StartOffset is not null || reference.EndOffset is not null)
            || sourceBlockIds.Any(UnplacedIds.Contains))
        {
            throw new InvalidDataException(
                "This text frame contains incompatible legacy content and cannot be edited safely.");
        }

        var sourceIdSet = sourceBlockIds.ToHashSet(StringComparer.Ordinal);
        if (_objects.Any(candidate => candidate.Id != item.Id
            && candidate.Kind == CompositionObjectKind.Text
            && candidate.ContentReferences.Any(reference => sourceIdSet.Contains(reference.BlockId))))
        {
            throw new InvalidDataException(
                "This text frame shares legacy content with another frame and cannot be edited safely.");
        }

        var sourceDocument = new ManuscriptDocument { ManuscriptId = _composition!.Id, Content = _semanticBlocks };
        var slices = ManuscriptRangeResolver.ResolveBlocks(sourceDocument, item.ContentReferences);
        var template = slices.FirstOrDefault()
            ?? throw new InvalidDataException("This text frame has no readable legacy content.");
        if (slices.Any(block => block.Type != ManuscriptBlockType.Paragraph
            || !string.Equals(block.StyleRole, template.StyleRole, StringComparison.Ordinal)))
        {
            throw new InvalidDataException(
                "This text frame mixes incompatible legacy content roles and cannot be edited safely.");
        }

        var insertionIndex = _semanticBlocks.FindIndex(block => sourceIdSet.Contains(block.Id));
        var materialized = template with
        {
            Id = Guid.NewGuid().ToString("N"),
            Content = JoinInlineSlices(slices.Select(slice => slice.Content)),
        };
        _semanticBlocks.RemoveAll(block => sourceIdSet.Contains(block.Id));
        _semanticBlocks.Insert(Math.Max(0, insertionIndex), materialized);
        ReplaceObject(item with
        {
            TextBinding = string.Empty,
            ContentReferences = [new ManuscriptRangeReference(materialized.Id)],
        });
        MarkDirty();
        return materialized;
    }

    private static List<ManuscriptInline> JoinInlineSlices(IEnumerable<IReadOnlyList<ManuscriptInline>> slices)
    {
        var result = new List<ManuscriptInline>();
        foreach (var slice in slices)
        {
            if (result.Count > 0)
                result.Add(new ManuscriptInline { Text = " " });
            result.AddRange(slice.Select(inline => inline with
            {
                Marks = inline.Marks.Select(mark => mark with { }).ToList(),
            }));
        }
        return CoalesceInlines(result);
    }

    private async Task FinishTextEditAsync(Guid objectId)
    {
        if (_editingTextId != objectId || _workspaceModule is null)
            return;
        if (_objects.All(item => item.Id != objectId))
        {
            _editingTextId = null;
            return;
        }
        var state = await _workspaceModule.InvokeAsync<TextEditState?>("readTextEditor", _stageElement, objectId);
        if (_editingTextId != objectId || _objects.All(item => item.Id != objectId))
        {
            if (_editingTextId == objectId)
                _editingTextId = null;
            return;
        }
        if (state is not null)
            UpdateFrameText(objectId, state.Text, takeSnapshot: true);
        _editingTextId = null;
        if (_dirty)
            await SaveAsync();
    }

    private async Task ToggleInlineMarkAsync(CompositionObject item, ManuscriptMarkType mark)
    {
        if (_workspaceModule is null)
            return;
        if (_editingTextId != item.Id)
        {
            BeginTextEdit(item);
            _error = "Select text inside the frame, then choose a formatting button.";
            return;
        }
        var state = await _workspaceModule.InvokeAsync<TextEditState?>("readTextEditor", _stageElement, item.Id);
        if (state is null || state.End <= state.Start)
        {
            _error = "Select the text you want to format inside the frame.";
            return;
        }
        try
        {
            Snapshot();
            var block = UpdateFrameText(item.Id, state.Text, takeSnapshot: false);
            var enabled = !SelectionHasMark(block.Content, state.Start, state.End, mark);
            var source = new ManuscriptDocument
            {
                ManuscriptId = _composition?.Id ?? PageId,
                Revision = _composition?.Revision ?? 0,
                Content = _semanticBlocks,
            };
            var (updated, _) = ManuscriptOperations.Apply(
                source,
                [new SetManuscriptInlineMark(block.Id, state.Start, state.End, mark, enabled)]);
            _semanticBlocks = updated.Content;
            _textSelectionRestore = new TextSelectionRestore(item.Id, state.Start, state.End);
            MarkDirty();
            _error = null;
            await SaveAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private ManuscriptBlock UpdateFrameText(Guid objectId, string text, bool takeSnapshot)
    {
        var block = EnsureOwnedTextBlock(objectId);
        var normalized = text.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n');
        if (ManuscriptCodec.Text(block) == normalized)
            return block;
        if (takeSnapshot)
            Snapshot();
        var index = _semanticBlocks.FindIndex(candidate => candidate.Id == block.Id);
        _semanticBlocks[index] = block with { Content = ReplaceTextPreservingMarks(block.Content, normalized) };
        MarkDirty();
        return _semanticBlocks[index];
    }

    private static bool SelectionHasMark(
        IReadOnlyList<ManuscriptInline> content,
        int start,
        int end,
        ManuscriptMarkType mark)
    {
        var cursor = 0;
        var touched = false;
        foreach (var inline in content)
        {
            var inlineEnd = cursor + inline.Text.Length;
            if (start < inlineEnd && cursor < end)
            {
                touched = true;
                if (inline.Marks.All(candidate => candidate.Type != mark))
                    return false;
            }
            cursor = inlineEnd;
        }
        return touched;
    }

    private void ReplaceObject(CompositionObject replacement)
    {
        var index = _objects.FindIndex(candidate => candidate.Id == replacement.Id);
        if (index >= 0)
            _objects[index] = replacement;
    }
    private bool LayerVisible(Guid layerId) => _layers.FirstOrDefault(layer => layer.Id == layerId)?.Visible != false;
    private bool LayerLocked(Guid layerId) => _layers.FirstOrDefault(layer => layer.Id == layerId)?.Locked == true;
    private bool IsVisible(CompositionObject item) => item.Visible && LayerVisible(item.LayerId)
        && (item.GroupId is not Guid groupId || _objects.FirstOrDefault(candidate => candidate.Id == groupId)?.Visible == true);
    private bool IsLocked(CompositionObject item) => item.Locked || LayerLocked(item.LayerId)
        || (item.GroupId is Guid groupId && _objects.FirstOrDefault(candidate => candidate.Id == groupId)?.Locked == true);

    private Guid ContentLayerId => _layers.FirstOrDefault(layer => layer.Visible && !layer.Locked)?.Id
        ?? _layers.FirstOrDefault()?.Id
        ?? Guid.Empty;
    private void SetObjectStyle(CompositionObject item, ChangeEventArgs e) => Patch(item with { StyleId = Guid.TryParse(e.Value?.ToString(), out var styleId) ? styleId : null });
    private CompositionObject Resolved(CompositionObject item)
    {
        var style = item.StyleId is Guid styleId ? _styles.FirstOrDefault(candidate => candidate.Id == styleId) : null;
        return style is null ? item : item with { FontFamilyKey = style.FontFamilyKey, FontWeight = style.FontWeight, Italic = style.Italic, FontSizePoints = style.FontSizePoints, LineHeight = style.LineHeight, LetterSpacingEm = style.LetterSpacingEm, FillColor = style.FillColor, BackgroundColor = style.BackgroundColor, BackgroundOpacity = style.BackgroundOpacity, StrokeColor = style.StrokeColor, StrokeWidthPoints = style.StrokeWidthPoints, TextAlignment = style.TextAlignment, VerticalAlignment = style.VerticalAlignment, TextShadow = style.TextShadow };
    }
    private void CreateStyleFrom(CompositionObject item)
    {
        Snapshot();
        var resolved = Resolved(item);
        var style = new CompositionObjectStyle { Id = Guid.NewGuid(), Name = $"Style {_styles.Count + 1}", FontFamilyKey = resolved.FontFamilyKey, FontWeight = resolved.FontWeight, Italic = resolved.Italic, FontSizePoints = resolved.FontSizePoints, LineHeight = resolved.LineHeight, LetterSpacingEm = resolved.LetterSpacingEm, FillColor = resolved.FillColor, BackgroundColor = resolved.BackgroundColor, BackgroundOpacity = resolved.BackgroundOpacity, StrokeColor = resolved.StrokeColor, StrokeWidthPoints = resolved.StrokeWidthPoints, TextAlignment = resolved.TextAlignment, VerticalAlignment = resolved.VerticalAlignment, TextShadow = resolved.TextShadow };
        _styles.Add(style); var index = _objects.FindIndex(candidate => candidate.Id == item.Id); if (index >= 0) _objects[index] = item with { StyleId = style.Id }; MarkDirty();
    }
    private void DeleteStyle(Guid styleId) { Snapshot(); _styles.RemoveAll(style => style.Id == styleId); _objects = _objects.Select(item => item.StyleId == styleId ? item with { StyleId = null } : item).ToList(); MarkDirty(); }
    private void SetAltText(CompositionObject item, string altText) { altText = altText.Trim(); Patch(item with { AltText = altText, Decorative = false, AccessibilityDecisionPending = altText.Length == 0, SemanticRole = CompositionSemanticRole.Figure, ReadingOrder = item.ReadingOrder ?? NextReadingOrder() }); }
    private int NextReadingOrder() => _objects.Where(o => o.ReadingOrder is not null).Select(o => o.ReadingOrder!.Value).DefaultIfEmpty().Max() + 1;
    private void ToggleGroupSelection(Guid id, bool selected) { if (selected) _groupSelection.Add(id); else _groupSelection.Remove(id); }
    private void GroupSelected()
    {
        var selected = _objects.Where(item => _groupSelection.Contains(item.Id) && item.Kind != CompositionObjectKind.Group && item.GroupId is null).ToList();
        if (selected.Count < 2) return;
        Snapshot();
        var left = selected.Min(item => item.Bounds.XPercent); var top = selected.Min(item => item.Bounds.YPercent);
        var right = selected.Max(item => item.Bounds.XPercent + item.Bounds.WidthPercent); var bottom = selected.Max(item => item.Bounds.YPercent + item.Bounds.HeightPercent);
        var width = Math.Max(.01, right - left); var height = Math.Max(.01, bottom - top); var groupId = Guid.NewGuid(); var layerId = selected[0].LayerId;
        _objects = _objects.Select(item => _groupSelection.Contains(item.Id) ? item with { GroupId = groupId, LayerId = layerId, Bounds = new CompositionBounds { XPercent = (item.Bounds.XPercent - left) / width * 100, YPercent = (item.Bounds.YPercent - top) / height * 100, WidthPercent = item.Bounds.WidthPercent / width * 100, HeightPercent = item.Bounds.HeightPercent / height * 100 } } : item).ToList();
        _objects.Add(new CompositionObject { Id = groupId, LayerId = layerId, Kind = CompositionObjectKind.Group, Name = "Group", Bounds = new CompositionBounds { XPercent = left, YPercent = top, WidthPercent = width, HeightPercent = height }, Decorative = true, SemanticRole = CompositionSemanticRole.Artifact, ZIndex = selected.Min(item => item.ZIndex) });
        _groupSelection.Clear(); _selectedId = groupId; MarkDirty();
    }
    private void UngroupSelected()
    {
        var groupIds = _objects.Where(item => _groupSelection.Contains(item.Id)).Select(item => item.Kind == CompositionObjectKind.Group ? item.Id : item.GroupId).Where(id => id is not null).Select(id => id!.Value).Distinct().ToList();
        if (groupIds.Count == 0 && Selected?.Kind == CompositionObjectKind.Group) groupIds.Add(Selected.Id);
        if (groupIds.Count == 0) return;
        Snapshot();
        foreach (var groupId in groupIds)
        {
            var group = _objects.FirstOrDefault(item => item.Id == groupId); if (group is null) continue;
            _objects = _objects.Select(item => item.GroupId == groupId ? item with { GroupId = null, Bounds = EffectiveBounds(item, group), RotationDegrees = item.RotationDegrees + group.RotationDegrees, Opacity = item.Opacity * group.Opacity } : item).ToList();
            _objects.RemoveAll(item => item.Id == groupId);
        }
        _groupSelection.Clear(); _selectedId = null; MarkDirty();
    }

    private void Patch(CompositionObject item)
    {
        Snapshot();
        var index = _objects.FindIndex(candidate => candidate.Id == item.Id);
        if (index >= 0) { _objects[index] = item; MarkDirty(); }
    }

    private void PatchBounds(CompositionObject item, double? x = null, double? y = null, double? width = null, double? height = null) =>
        Patch(item with { Bounds = item.Bounds with { XPercent = Snap(x ?? item.Bounds.XPercent, CompositionGuideAxis.Vertical), YPercent = Snap(y ?? item.Bounds.YPercent, CompositionGuideAxis.Horizontal), WidthPercent = Snap(width ?? item.Bounds.WidthPercent), HeightPercent = Snap(height ?? item.Bounds.HeightPercent) } });
    private void FitSelectionWidth(CompositionObject item, bool useSafeArea)
    {
        var surface = PageSurfaceFor(item);
        Patch(CompositionObjectLayout.FitWidth(item, useSafeArea ? SafePageSurfaceBounds(surface) : surface));
    }
    private void CenterSelection(CompositionObject item, bool useSafeArea)
    {
        var surface = PageSurfaceFor(item);
        Patch(CompositionObjectLayout.CenterHorizontally(item, useSafeArea ? SafePageSurfaceBounds(surface) : surface));
    }
    private CompositionBounds PageSurfaceFor(CompositionObject item)
    {
        var center = item.Bounds.XPercent + item.Bounds.WidthPercent / 2;
        return PageSurfaceBounds.FirstOrDefault(bounds => center >= bounds.XPercent
                && center <= bounds.XPercent + bounds.WidthPercent)
            ?? PageSurfaceBounds[0];
    }
    private IReadOnlyList<CompositionBounds> PageSurfaceBounds => _scene!.Surface.Kind == CompositionSurfaceKind.FacingSpread
        ?
        [
            new CompositionBounds { WidthPercent = 50 },
            new CompositionBounds { XPercent = 50, WidthPercent = 50 },
        ]
        : [new CompositionBounds()];
    private IReadOnlyList<double> SurfaceCenterGuidePositions => _scene!.Surface.Kind == CompositionSurfaceKind.FacingSpread
        ? [25, 75]
        : [50];
    private CompositionBounds SafePageSurfaceBounds(CompositionBounds surface)
    {
        var insetX = Math.Clamp(_scene!.Surface.SafeInsetPoints / _scene.Surface.WidthPoints * 100, 0, surface.WidthPercent / 2);
        var insetY = Math.Clamp(_scene.Surface.SafeInsetPoints / _scene.Surface.HeightPoints * 100, 0, 49);
        return surface with
        {
            XPercent = surface.XPercent + insetX,
            YPercent = insetY,
            WidthPercent = Math.Max(0, surface.WidthPercent - insetX * 2),
            HeightPercent = 100 - insetY * 2,
        };
    }
    private static string BoundsStyle(CompositionBounds bounds) => FormattableString.Invariant($"left:{bounds.XPercent}%;top:{bounds.YPercent}%;width:{bounds.WidthPercent}%;height:{bounds.HeightPercent}%");
    private static string CenterGuideStyle(double center) => FormattableString.Invariant($"left:{center}%");
    private double Snap(double value, CompositionGuideAxis? axis = null)
    {
        var grid = Math.Round(value * 2, MidpointRounding.AwayFromZero) / 2;
        return axis is not null && Math.Abs(50 - value) <= 1 ? 50 : grid;
    }

    private void Nudge(CompositionObject item, double x, double y) => PatchBounds(item, item.Bounds.XPercent + x, item.Bounds.YPercent + y);
    private void SendToBack(CompositionObject item)
    {
        var others = _objects.Where(candidate => candidate.Id != item.Id).ToList();
        if (others.Count == 0 || item.ZIndex < others.Min(candidate => candidate.ZIndex))
            return;
        MoveToZIndex(item, others.Min(candidate => candidate.ZIndex) - 1);
    }
    private void BringToFront(CompositionObject item)
    {
        var others = _objects.Where(candidate => candidate.Id != item.Id).ToList();
        if (others.Count == 0 || item.ZIndex > others.Max(candidate => candidate.ZIndex))
            return;
        MoveToZIndex(item, others.Max(candidate => candidate.ZIndex) + 1);
    }
    private void MoveToZIndex(CompositionObject item, int zIndex)
    {
        if (zIndex == item.ZIndex)
            return;
        Patch(item with { ZIndex = zIndex });
    }
    private int NextFrontZIndex() => _objects.Select(candidate => candidate.ZIndex).DefaultIfEmpty(0).Max() + 1;
    private int ReserveNewImageZIndex()
    {
        var imageZIndex = _objects.Where(candidate => candidate.Kind == CompositionObjectKind.Image).Select(candidate => candidate.ZIndex).DefaultIfEmpty(-1).Max() + 1;
        var foreground = _objects.Where(candidate => candidate.Kind != CompositionObjectKind.Image).ToList();
        if (foreground.Count == 0)
            return imageZIndex;
        var lowestForeground = foreground.Min(candidate => candidate.ZIndex);
        if (imageZIndex < lowestForeground)
            return imageZIndex;
        var offset = imageZIndex - lowestForeground + 1;
        _objects = _objects.Select(candidate => candidate.Kind == CompositionObjectKind.Image ? candidate : candidate with { ZIndex = candidate.ZIndex + offset }).ToList();
        return imageZIndex;
    }
    private void Delete(Guid id)
    {
        var item = _objects.FirstOrDefault(candidate => candidate.Id == id);
        if (item?.Kind == CompositionObjectKind.Group)
        {
            _groupSelection.Clear();
            _groupSelection.Add(id);
            UngroupSelected();
            return;
        }
        if (item is null)
            return;
        try
        {
            if (IsProtectedBoundText(item))
                throw new InvalidOperationException("Linked fields in a generated publication page cannot be removed.");
            var ownedBlockId = item.Kind == CompositionObjectKind.Text
                ? EnsureOwnedTextBlock(item.Id).Id
                : null;
            Snapshot();
            _objects.RemoveAll(candidate => candidate.Id == id);
            if (ownedBlockId is not null)
                _semanticBlocks.RemoveAll(block => block.Id == ownedBlockId);
            _selectedId = null;
            _editingTextId = null;
            MarkDirty();
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }
    private void Snapshot()
    {
        if (!_dirty)
            return;
        _autosaveCancellation?.Cancel();
        _ = SaveAsync();
    }

    private async Task MoveHistoryAsync(bool redo)
    {
        if (CanvasInteractionLocked)
            return;
        if (!await FlushAsync())
            return;
        AuthoringDeltaHistoryMove? move = null;
        try
        {
            move = redo ? DeltaHistory.Redo(AuthoringTargetId()) : DeltaHistory.Undo(AuthoringTargetId());
            if (move is null || _scene is null)
                return;
            var operations = move.IsUndo ? move.Action.Inverse : move.Action.Forward;
            _scene = CompositionCanvasDeltaAdapter.Apply(
                _scene,
                operations.Where(operation => operation.Kind.Contains("Canvas", StringComparison.OrdinalIgnoreCase)).ToList());
            var semanticOperations = operations
                .Where(operation => !operation.Kind.Contains("Canvas", StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (semanticOperations.Count > 0)
            {
                var semantic = new ManuscriptDocument
                {
                    ManuscriptId = _composition!.Id,
                    Revision = _composition.Revision,
                    Content = _semanticBlocks,
                };
                _semanticBlocks = AuthoringBatchReducer.Apply(
                    semantic,
                    semanticOperations,
                    allowCanonicalInverseOperations: true).Document.Content.ToList();
            }
            _objects = _scene.Objects.ToList();
            _layers = _scene.Layers.ToList();
            _styles = _scene.Styles.ToList();
            _history = move.State;
            _replayingCanvasHistory = true;
            MarkDirty();
            await SaveAsync();
            _replayingCanvasHistory = false;
            if (_dirty || _error is not null)
                throw new InvalidOperationException(_error ?? "The canvas history move was not saved.");
            DeltaHistory.ConfirmMove(move.ReservationId);
            _error = null;
            await NotifyWorkspaceChangedAsync();
        }
        catch (Exception exception)
        {
            if (move is not null)
                DeltaHistory.DiscardMove(move.ReservationId);
            _replayingCanvasHistory = false;
            _error = exception.Message;
        }
    }
    private static double Number(ChangeEventArgs e) => double.TryParse(e.Value?.ToString(), out var value) ? value : 0;
    private static int? NullableInt(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var value) ? value : null;

    private void MarkDirty()
    {
        _dirty = true;
        _changeVersion++;
        UpdateAuthoringWriterState();
        ScheduleAutosave();
    }

    private void ScheduleAutosave()
    {
        _autosaveCancellation?.Cancel();
        _autosaveCancellation?.Dispose();
        _autosaveCancellation = new CancellationTokenSource();
        _ = AutosaveAsync(_autosaveCancellation);
    }

    private async Task AutosaveAsync(CancellationTokenSource autosave)
    {
        try
        {
            await Task.Delay(250, autosave.Token);
            await InvokeAsync(SaveAsync);
        }
        catch (OperationCanceledException) when (autosave.IsCancellationRequested)
        {
        }
    }

    private async Task SaveAsync()
    {
        await _saveGate.WaitAsync();
        try
        {
            if (!_dirty || _scene is null || _variant is null)
                return;
            if (_authoringWriterLease is null)
                throw new InvalidOperationException(_authoringWriterError ?? "The page has no writable authoring session.");
            await EnsureWritableReleaseContentAsync();
            if (_authoringWriterLease is null)
                throw new InvalidOperationException(_authoringWriterError ?? "The release page could not acquire a writable authoring session.");
            var changeVersion = _changeVersion;
            var scene = _scene with { Layers = _layers.ToList(), Styles = _styles.ToList(), Guides = [], Objects = _objects.ToList() };
            var semanticBlocks = _semanticBlocks.ToList();
            var journalToken = Guid.NewGuid().ToString("N");
            if (!await PersistPendingAsync(journalToken, semanticBlocks, scene))
                return;
            var expectedContentRevision = _recoveredContentRevision ?? _composition!.Revision;
            var expectedVariantRevision = _recoveredVariantRevision ?? _variant.Revision;
            DesignedPageWorkspaceSaveResult saved;
            using var historySuppression = _replayingCanvasHistory
                ? AuthoringMutations.SuppressHistory()
                : null;
            saved = await DesignedPages.SaveWorkspaceAsync(
                ContentTarget,
                ProjectId,
                _composition!.Id,
                expectedContentRevision,
                semanticBlocks,
                _variant.Id,
                expectedVariantRevision,
                scene);
            _history = DeltaHistory.Read(AuthoringTargetId()).State;
            if (!saved.Applied)
            {
                // Keep the recorded base revisions. Retrying this recovered draft
                // against a newly read revision would overwrite canonical work.
                _error = "This page changed elsewhere. The local recovery draft is retained and must be reconciled before saving.";
                _recoveryConflict = true;
                UpdateAuthoringWriterState();
                await InvokeAsync(StateHasChanged);
                return;
            }
            _composition = saved.Content;
            _variant = saved.Variant;
            _variants = await DesignedPages.ListVariantsAsync(ProjectId, _composition.Id);
            UpdateAuthoringWriterState();
            if (_changeVersion == changeVersion)
            {
                _scene = scene;
                _dirty = false;
                if (!await RemovePendingAsync(journalToken))
                    return;
                _recoveredContentRevision = null;
                _recoveredVariantRevision = null;
            }
            UpdateAuthoringWriterState();
            _error = null;
            await NotifyWorkspaceChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally { _saveGate.Release(); }
    }

    private bool IsInheritedReleasePage => ContentTarget.EditionId is not null && _composition?.EditionId is null;

    private async Task EnsureWritableReleaseContentAsync()
    {
        if (!IsInheritedReleasePage || ContentTarget.EditionId is not { } editionId)
            return;

        var overrideView = await DesignedPages.EnsureReleaseOverrideAsync(ProjectId, PageId, editionId);
        _page = overrideView.Page;
        _composition = overrideView.Content;
        _variant = await DesignedPages.GetOrCreateVariantAsync(ProjectId, _composition.Id, editionId);
        _variants = await DesignedPages.ListVariantsAsync(ProjectId, _composition.Id);
        await OpenAuthoringWriterAsync(allowDuringDisposal: true);
        _history = DeltaHistory.Read(AuthoringTargetId()).State;
    }

    public async Task<bool> FlushAsync()
    {
        _autosaveCancellation?.Cancel();
        await CaptureOpenTextEditAsync();
        while (_dirty)
        {
            var changeVersion = _changeVersion;
            await SaveAsync();
            if (!string.IsNullOrWhiteSpace(_error) || (_dirty && _changeVersion == changeVersion))
                break;
        }
        return !_dirty;
    }

    // Frame text lives only in the browser until the editor blurs, so a save point must
    // collect it; otherwise a tab switch or authoring fence would drop the typed text.
    private async Task CaptureOpenTextEditAsync()
    {
        if (_editingTextId is not { } objectId || _workspaceModule is null || _objects.All(item => item.Id != objectId))
            return;
        try
        {
            var state = await _workspaceModule.InvokeAsync<TextEditState?>("readTextEditor", _stageElement, objectId);
            if (state is null || _editingTextId != objectId || _objects.All(item => item.Id != objectId))
                return;
            UpdateFrameText(objectId, state.Text, takeSnapshot: true);
            if (_disposing)
                _editingTextId = null;
        }
        catch (JSDisconnectedException) { }
    }

    private string StageStyle() => $"--surface-ratio:{_scene!.Surface.WidthPoints / _scene.Surface.HeightPoints:R};--zoom:{_zoom:R}";
