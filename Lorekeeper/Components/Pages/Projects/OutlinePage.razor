@page "/projects/{Slug}/outline"
@rendermode InteractiveServer
@using Lorekeeper.Components.Pages.Projects.Outline

<PageTitle>Outline</PageTitle>

<ProjectLayout Slug="@Slug" Tab="outline">
    <OutlineContent Focus="@Focus" />
</ProjectLayout>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public Guid? Focus { get; set; }
}
