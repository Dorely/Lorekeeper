@using Lorekeeper.Context
@using Lorekeeper.Models
@using Lorekeeper.Projects
@using Lorekeeper.Tokens
@inject IProjectService Projects
@inject IEditorContextService EditorContext
@inject ITokenCounter TokenCounter

@if (_assembly is null)
{
    <p class="text-muted small mb-0"><em>Loading…</em></p>
}
else
{
    <div class="ctx-feed-summary" title="@ContextTokenTitle()">
        Combined context tokens: @TokenPrefix(_contextTokenIsExact)@_contextTokenCount.ToString("N0")
    </div>

    @foreach (var item in _assembly.Items)
    {
        var collapsed = IsCollapsed(item.Key);
        <div class="ctx-card @(item.IsEnabled ? "" : "ctx-card--disabled")">
            <div class="ctx-card-head">
                <button type="button" class="ctx-caret" @onclick="() => ToggleCollapsed(item.Key)">
                    @(collapsed ? "▸" : "▾")
                </button>
                <input type="checkbox"
                       class="form-check-input ctx-check"
                       checked="@item.IsEnabled"
                       disabled="@(!item.IsRemovable && item.Kind == ContextItemKind.SystemPrompt)"
                       @onchange="@(e => OnToggleAsync(item, (bool)(e.Value ?? false)))" />
                <span class="ctx-label">@item.Label</span>
                @if (!string.IsNullOrWhiteSpace(item.Badge))
                {
                    <span class="ctx-badge">@item.Badge</span>
                }
            </div>
            @if (!collapsed)
            {
                <div class="ctx-body">
                    @if (!string.IsNullOrWhiteSpace(item.Reason))
                    {
                        <div class="ctx-reason">@item.Reason</div>
                    }
                    @if (item.Kind == ContextItemKind.SystemPrompt)
                    {
                        <textarea class="form-control ctx-prompt-edit"
                                  rows="10"
                                  value="@_promptDraft"
                                  @oninput="OnPromptInput"
                                  @onblur="SavePromptAsync"></textarea>
                        @if (!string.IsNullOrEmpty(_promptError))
                        {
                            <div class="text-danger small mt-1">@_promptError</div>
                        }
                        else if (_promptSaving)
                        {
                            <div class="text-muted small mt-1"><em>Saving…</em></div>
                        }
                        else if (_promptDirty)
                        {
                            <div class="text-muted small mt-1"><em>Unsaved — blur to save.</em></div>
                        }
                    }
                    else
                    {
                        <pre class="ctx-text-block"><code>@(string.IsNullOrEmpty(item.Body) ? "(empty)" : item.Body)</code></pre>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter] public Chapter? CurrentChapter { get; set; }
    [Parameter] public EventCallback OnContextChanged { get; set; }

    private ContextAssembly? _assembly;
    private readonly HashSet<string> _collapsed = [EditorContextKeys.CurrentChapter];

    private string _promptDraft = string.Empty;
    private bool _promptDirty;
    private bool _promptSaving;
    private string? _promptError;
    private int _contextTokenCount;
    private bool _contextTokenIsExact = true;

    protected override async Task OnParametersSetAsync()
    {
        await RebuildAsync();
        if (!_promptDirty) _promptDraft = Project.SystemPrompt;
    }

    /// <summary>Called by the editor when the chapter body changes so the preview stays current.</summary>
    public async Task RefreshAsync()
    {
        await RebuildAsync();
        StateHasChanged();
    }

    private async Task RebuildAsync()
    {
        _assembly = await EditorContext.BuildAsync(Project, CurrentChapter);
        UpdateContextTokenCount();
    }

    private void UpdateContextTokenCount()
    {
        var result = TokenCounter.Count(_assembly?.Assemble() ?? string.Empty);
        _contextTokenCount = result.TokenCount;
        _contextTokenIsExact = result.IsExact;
    }

    private string ContextTokenTitle() => _contextTokenIsExact
        ? "Enabled context token count"
        : "Enabled context token count is estimated";

    private static string TokenPrefix(bool isExact) => isExact ? string.Empty : "~";

    private bool IsCollapsed(string key) => _collapsed.Contains(key);

    private void ToggleCollapsed(string key)
    {
        if (!_collapsed.Add(key)) _collapsed.Remove(key);
    }

    private async Task OnToggleAsync(ContextItem item, bool include)
    {
        if (CurrentChapter is null || item.Kind == ContextItemKind.SystemPrompt) return;
        await EditorContext.SetItemIncludedAsync(Project.Id, CurrentChapter.Id, item.Kind, item.Key, include);
        await RebuildAsync();
        await OnContextChanged.InvokeAsync();
    }

    private void OnPromptInput(ChangeEventArgs e)
    {
        _promptDraft = e.Value?.ToString() ?? string.Empty;
        _promptDirty = true;
        _promptError = null;
    }

    private async Task SavePromptAsync()
    {
        if (!_promptDirty) return;
        if (string.IsNullOrWhiteSpace(_promptDraft))
        {
            _promptError = "System prompt cannot be empty.";
            _promptDraft = Project.SystemPrompt;
            _promptDirty = false;
            return;
        }

        _promptSaving = true;
        try
        {
            await Projects.UpdateSystemPromptAsync(Project.Id, _promptDraft);
            Project.SystemPrompt = _promptDraft;
            _promptDirty = false;
            await RebuildAsync();
            await OnContextChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _promptError = ex.Message;
        }
        finally
        {
            _promptSaving = false;
        }
    }
}
