@using Lorekeeper.Context
@using Lorekeeper.Chapters
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Projects
@using Lorekeeper.Tokens
@implements IDisposable
@inject IEditorContextService EditorContext
@inject IServiceScopeFactory ScopeFactory
@inject ITokenCounter TokenCounter

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger py-2 small mb-2">
        @_error
        <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="StartReload">Retry</button>
    </div>
}

@if (_assembly is null)
{
    <p class="text-muted small mb-0"><em>Loading…</em></p>
}
else
{
    <div class="ctx-feed-summary" title="@ContextTokenTitle()">
        Combined context tokens: @TokenPrefix(_contextTokenIsExact)@_contextTokenCount.ToString("N0")
    </div>

    <div class="ctx-card">
        <div class="ctx-card-head">
            <div class="ctx-open"
                 role="button"
                 tabindex="0"
                 aria-label="Open assembled system prompt preview"
                 @onclick="OpenAssembledPrompt"
                 @onkeydown="OnAssembledPromptKeyDown">
                <span class="ctx-label">Assembled system prompt preview</span>
                <span class="ctx-badge">Read only</span>
            </div>
        </div>
    </div>

    @foreach (var item in _assembly.Items)
    {
        var canChange = CanChangeContextItem(item);
        <div class="ctx-card @(item.IsEnabled ? "" : "ctx-card--disabled")">
            <div class="ctx-card-head">
                <div class="ctx-open"
                     role="button"
                     tabindex="0"
                     aria-label="Open @item.Label details"
                     @onclick="() => OpenDetail(item)"
                     @onkeydown="e => OnOpenKeyDown(e, item)">
                    <span class="ctx-label">@item.Label</span>
                    @if (!string.IsNullOrWhiteSpace(item.Badge))
                    {
                        <span class="ctx-badge">@item.Badge</span>
                    }
                    @if (item.IsTransient)
                    {
                        <span class="ctx-badge">@item.Origin</span>
                    }
                    <span class="ctx-badge">~@item.EstimatedTokens.ToString("N0") tokens</span>
                </div>
                @if (canChange)
                {
                    <button type="button"
                            class="@ContextActionButtonClass(item)"
                            title="@ContextActionTitle(item)"
                            aria-label="@ContextActionTitle(item)"
                            @onclick="() => ChangeContextItemAsync(item)">
                        @if (IsRemoveAction(item))
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M5 12h14" />
                            </svg>
                        }
                        else if (item.IsEnabled)
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M2.3 11.4C3.5 9.1 7 5 12 5s8.5 4.1 9.7 6.4a1.3 1.3 0 0 1 0 1.2C20.5 14.9 17 19 12 19s-8.5-4.1-9.7-6.4a1.3 1.3 0 0 1 0-1.2Z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                <path d="M9.1 5.3A9.8 9.8 0 0 1 12 5c5 0 8.5 4.1 9.7 6.4a1.3 1.3 0 0 1 0 1.2 15 15 0 0 1-2.4 3.2" />
                                <path d="M6.6 6.6A15.3 15.3 0 0 0 2.3 11.4a1.3 1.3 0 0 0 0 1.2C3.5 14.9 7 19 12 19a9.7 9.7 0 0 0 4-.8" />
                            </svg>
                        }
                    </button>
                }
            </div>
            @if (item.Visuals is { Count: > 0 })
            {
                <div class="ctx-visuals" title="@($"{item.Visuals.Count} visual example(s)")">
                    @foreach (var visual in item.Visuals.Take(4))
                    {
                        <img src="@($"/projects/{Project.Id:N}/images/{visual.ImageId:N}/content?maxEdge=160")" alt="@visual.AltText" title="@visual.Label" />
                    }
                    <span>@item.Visuals.Count visual@(item.Visuals.Count == 1 ? string.Empty : "s")</span>
                </div>
            }
        </div>
    }
}

<ContextItemDetailModal ProjectId="Project.Id"
                        Project="Project"
                        FeedItem="_selectedDetail"
                        IsOpen="_detailOpen"
                        AllowProjectGuidanceEdit="true"
                        AllowBookBriefEdit="true"
                        AllowEntityEdit="true"
                        OnClose="CloseDetail"
                        OnSaved="OnDetailSavedAsync" />

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
    [Parameter] public Chapter? CurrentChapter { get; set; }
    [Parameter] public EditorContentTarget ContentTarget { get; set; } = EditorContentTarget.Core;
    [Parameter] public EventCallback OnContextChanged { get; set; }

    private ContextAssembly? _assembly;
    private ContextItem? _selectedDetail;
    private bool _detailOpen;
    private int _contextTokenCount;
    private bool _contextTokenIsExact = true;
    private string? _error;
    private Guid _loadedProjectId;
    private Guid? _loadedChapterId;
    private EditorContentTarget _loadedContentTarget = EditorContentTarget.Core;
    private CancellationTokenSource? _reloadCts;
    private int _reloadVersion;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        var chapterId = CurrentChapter?.Id;
        if (_loadedProjectId == Project.Id
            && _loadedChapterId == chapterId
            && _loadedContentTarget == ContentTarget)
            return;

        _loadedProjectId = Project.Id;
        _loadedChapterId = chapterId;
        _loadedContentTarget = ContentTarget;
        _assembly = null;
        StartReload();
    }

    /// <summary>Called by the editor when the chapter body changes so the preview stays current.</summary>
    public async Task RefreshAsync()
    {
        if (_disposed) return;

        var reload = BeginReload();
        await LoadAssemblyAsync(
            reload.Version,
            reload.ProjectId,
            reload.ChapterId,
            reload.ContentTarget,
            reload.CancellationToken);
    }

    private void StartReload()
    {
        if (_disposed) return;

        var reload = BeginReload();
        _ = Task.Run(() => LoadAssemblyAsync(
            reload.Version,
            reload.ProjectId,
            reload.ChapterId,
            reload.ContentTarget,
            reload.CancellationToken));
    }

    private void OpenAssembledPrompt()
    {
        if (_assembly is null) return;
        OpenDetail(new ContextItem(
            "assembled-system-prompt-preview",
            ContextItemKind.SystemInstructions,
            "Assembled system prompt preview",
            _assembly.Assemble(),
            IsEnabled: true,
            IsRemovable: false,
            Badge: "Read only"));
    }

    private void OnAssembledPromptKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            OpenAssembledPrompt();
    }

    private ContextReload BeginReload()
    {
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
        _reloadCts = new CancellationTokenSource();
        _error = null;

        return new ContextReload(
            ++_reloadVersion,
            Project.Id,
            CurrentChapter?.Id,
            ContentTarget,
            _reloadCts.Token);
    }

    private async Task LoadAssemblyAsync(
        int version,
        Guid projectId,
        Guid? chapterId,
        EditorContentTarget contentTarget,
        CancellationToken cancellationToken)
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var projects = scope.ServiceProvider.GetRequiredService<IProjectService>();
            var chapters = scope.ServiceProvider.GetRequiredService<IChapterService>();
            var context = scope.ServiceProvider.GetRequiredService<IEditorContextService>();

            var project = await projects.GetByIdAsync(projectId, cancellationToken);
            if (project is null)
                throw new InvalidOperationException("Project was not found.");

            var chapter = chapterId is { } id
                ? await chapters.GetAsync(id, cancellationToken)
                : null;
            if (chapterId is not null && (chapter is null || chapter.ProjectId != projectId))
                throw new InvalidOperationException("Chapter was not found in this project.");

            var assembly = await context.BuildAsync(
                new ContextBuildRequest(project, chapter, ContentTarget: contentTarget),
                cancellationToken);
            if (!IsCurrentReload(version, cancellationToken)) return;

            await InvokeAsync(() =>
            {
                if (!IsCurrentReload(version, cancellationToken)) return;
                _assembly = assembly;
                _error = null;
                UpdateContextTokenCount();
                RefreshOpenDetail();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (!IsCurrentReload(version, cancellationToken)) return;

            await InvokeAsync(() =>
            {
                if (!IsCurrentReload(version, cancellationToken)) return;
                _error = $"Assistant Memory could not be loaded: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private void RefreshOpenDetail()
    {
        if (_assembly is null)
            return;

        if (_detailOpen && _selectedDetail is not null)
        {
            var updated = _assembly.Items.FirstOrDefault(item => IsSameContextItem(item, _selectedDetail));
            if (updated is null)
            {
                CloseDetail();
            }
            else
            {
                _selectedDetail = updated;
            }
        }
    }

    private bool IsCurrentReload(int version, CancellationToken cancellationToken) =>
        !_disposed && !cancellationToken.IsCancellationRequested && version == _reloadVersion;

    private void UpdateContextTokenCount()
    {
        var result = TokenCounter.Count(_assembly?.Assemble() ?? string.Empty);
        _contextTokenCount = result.TokenCount;
        _contextTokenIsExact = result.IsExact;
    }

    private string ContextTokenTitle() => _contextTokenIsExact
        ? "Enabled context token count"
        : "Enabled context token count is estimated";

    private static string TokenPrefix(bool isExact) => isExact ? string.Empty : "~";

    private bool CanChangeContextItem(ContextItem item) =>
        CurrentChapter is not null && item.IsRemovable;

    private static bool IsRemoveAction(ContextItem item) =>
        item.Kind is ContextItemKind.Entity
            or ContextItemKind.ChapterReference
            or ContextItemKind.ActReference
            or ContextItemKind.IngestSourceReference
            or ContextItemKind.IngestSourceChunkReference
            or ContextItemKind.ProjectImage;

    private static string ContextActionButtonClass(ContextItem item) =>
        IsRemoveAction(item)
            ? "ctx-action-icon ctx-action-icon--remove"
            : item.IsEnabled
                ? "ctx-action-icon ctx-action-icon--enabled"
                : "ctx-action-icon ctx-action-icon--disabled";

    private static string ContextActionTitle(ContextItem item) =>
        IsRemoveAction(item) ? "Remove from Assistant Memory" : item.IsEnabled ? "Disable in Assistant Memory" : "Enable in Assistant Memory";

    private async Task ChangeContextItemAsync(ContextItem item)
    {
        if (!CanChangeContextItem(item) || CurrentChapter is null) return;

        var include = IsRemoveAction(item) ? false : !item.IsEnabled;
        await EditorContext.SetItemIncludedAsync(Project.Id, CurrentChapter.Id, item.Kind, item.Key, include);
        await NotifyContextChangedAsync();
    }

    private void OpenDetail(ContextItem item)
    {
        _selectedDetail = item;
        _detailOpen = true;
    }

    private void CloseDetail()
    {
        _detailOpen = false;
        _selectedDetail = null;
    }

    private void OnOpenKeyDown(KeyboardEventArgs e, ContextItem item)
    {
        if (e.Key is "Enter" or " ")
        {
            OpenDetail(item);
        }
    }

    private async Task OnDetailSavedAsync()
    {
        await NotifyContextChangedAsync();
    }

    private async Task NotifyContextChangedAsync()
    {
        if (OnContextChanged.HasDelegate)
        {
            await OnContextChanged.InvokeAsync();
            return;
        }

        await RefreshAsync();
    }

    private static bool IsSameContextItem(ContextItem left, ContextItem right) =>
        left.Kind == right.Kind && string.Equals(left.Key, right.Key, StringComparison.Ordinal);

    public void Dispose()
    {
        _disposed = true;
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
        _reloadCts = null;
    }

    private sealed record ContextReload(
        int Version,
        Guid ProjectId,
        Guid? ChapterId,
        EditorContentTarget ContentTarget,
        CancellationToken CancellationToken);
}
