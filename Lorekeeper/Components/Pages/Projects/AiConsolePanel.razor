@using System.Text.Json
@using Lorekeeper.AiConsole
@using Lorekeeper.Models
@implements IAsyncDisposable
@inject IAiConsoleService AiConsole
@inject IAiConsoleHistoryService History

<div class="aic-row">
    <input type="text"
           class="form-control aic-input"
           placeholder="> What would you like the assistant to do?"
           value="@_input"
           disabled="@_running"
           @oninput="@(e => _input = e.Value?.ToString() ?? string.Empty)"
           @onkeydown="OnInputKeyDownAsync" />
    @if (_running)
    {
        <button type="button" class="btn btn-outline-danger" @onclick="CancelAsync">Cancel</button>
    }
    else
    {
        <button type="button" class="btn btn-primary" @onclick="SendAsync"
                disabled="@string.IsNullOrWhiteSpace(_input)">Send</button>
    }
    <button type="button" class="btn btn-outline-secondary" @onclick="OpenHistoryAsync">History</button>
</div>

@if (_running)
{
    <div class="small text-muted mt-2"><em>Running…</em></div>
}
else if (_lastEntry is not null)
{
    <div class="aic-result mt-2">
        <div class="small text-muted">
            @StatusBadgeText(_lastEntry.Status) · @_lastEntry.CompletedAt?.ToLocalTime().ToString("HH:mm:ss")
        </div>
        @if (!string.IsNullOrEmpty(_lastEntry.ResponseText))
        {
            <div class="aic-response">@_lastEntry.ResponseText</div>
        }
        @if (!string.IsNullOrEmpty(_lastEntry.ErrorMessage))
        {
            <div class="text-danger small">@_lastEntry.ErrorMessage</div>
        }
    </div>
}

@if (_historyOpen)
{
    <div class="modal-backdrop fade show" @onclick="CloseHistory"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" @onclick="CloseHistory">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document"
             @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">AI Console History</h5>
                    <button type="button" class="btn-close" @onclick="CloseHistory"></button>
                </div>
                <div class="modal-body">
                    @if (_historyEntries is null)
                    {
                        <p class="text-muted"><em>Loading…</em></p>
                    }
                    else if (_historyEntries.Count == 0)
                    {
                        <p class="text-muted">No turns yet for this project.</p>
                    }
                    else
                    {
                        @foreach (var entry in _historyEntries)
                        {
                            var open = _expandedHistoryId == entry.Id;
                            <div class="aic-hist-row @(open ? "open" : "")">
                                <button type="button" class="aic-hist-head"
                                        @onclick="() => ToggleHistory(entry.Id)">
                                    <span class="aic-hist-time">@entry.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                    <span class="aic-hist-status badge bg-@StatusColor(entry.Status)">
                                        @entry.Status
                                    </span>
                                    <span class="aic-hist-cmd">@Truncate(entry.Command, 80)</span>
                                </button>
                                @if (open)
                                {
                                    <div class="aic-hist-detail">
                                        <h6>Command</h6>
                                        <pre class="aic-pre">@entry.Command</pre>

                                        <h6>System prompt snapshot</h6>
                                        <pre class="aic-pre aic-collapsed-pre">@entry.SystemPromptSnapshot</pre>

                                        <h6>Tool calls</h6>
                                        @{
                                            var calls = ParseTools(entry.ToolCallsJson);
                                        }
                                        @if (calls.Count == 0)
                                        {
                                            <p class="text-muted small mb-2">None.</p>
                                        }
                                        else
                                        {
                                            @foreach (var c in calls)
                                            {
                                                <div class="aic-tool">
                                                    <div class="fw-semibold small">@c.Name</div>
                                                    <div class="small text-muted">args: <code>@c.Arguments</code></div>
                                                    @if (c.Error is not null)
                                                    {
                                                        <pre class="aic-pre text-danger">@c.Error</pre>
                                                    }
                                                    else
                                                    {
                                                        <pre class="aic-pre aic-collapsed-pre">@c.Result</pre>
                                                    }
                                                </div>
                                            }
                                        }

                                        <h6>Response</h6>
                                        <pre class="aic-pre">@(entry.ResponseText ?? "(none)")</pre>

                                        @if (!string.IsNullOrEmpty(entry.ErrorMessage))
                                        {
                                            <h6>Error</h6>
                                            <pre class="aic-pre text-danger">@entry.ErrorMessage</pre>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? CurrentChapterId { get; set; }

    /// <summary>Raised before the LLM call begins so the editor can flush + lock.</summary>
    [Parameter] public EventCallback OnAiTurnStarting { get; set; }

    /// <summary>Raised after the LLM call ends (success/cancel/fail) so the editor can refresh + unlock.</summary>
    [Parameter] public EventCallback<AiConsoleEntry> OnAiTurnCompleted { get; set; }

    private string _input = string.Empty;
    private bool _running;
    private AiConsoleEntry? _lastEntry;
    private CancellationTokenSource? _cts;

    private bool _historyOpen;
    private IReadOnlyList<AiConsoleEntry>? _historyEntries;
    private Guid? _expandedHistoryId;

    private async Task OnInputKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_running) await SendAsync();
    }

    private async Task SendAsync()
    {
        if (_running || string.IsNullOrWhiteSpace(_input)) return;
        var command = _input.Trim();
        _input = string.Empty;
        _running = true;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        await OnAiTurnStarting.InvokeAsync();

        AiConsoleEntry? result = null;
        try
        {
            result = await AiConsole.RunAsync(ProjectId, CurrentChapterId, command, _cts.Token);
        }
        catch (Exception ex)
        {
            result = new AiConsoleEntry
            {
                ProjectId = ProjectId,
                ChapterId = CurrentChapterId,
                Command = command,
                SystemPromptSnapshot = string.Empty,
                Status = AiConsoleEntryStatus.Failed,
                ErrorMessage = ex.Message,
                CompletedAt = DateTime.UtcNow,
            };
        }
        finally
        {
            _lastEntry = result;
            _running = false;
            _cts?.Dispose();
            _cts = null;
        }

        if (result is not null) await OnAiTurnCompleted.InvokeAsync(result);
        StateHasChanged();
    }

    private void CancelAsync()
    {
        _cts?.Cancel();
    }

    private async Task OpenHistoryAsync()
    {
        _historyOpen = true;
        _historyEntries = null;
        _expandedHistoryId = null;
        StateHasChanged();
        _historyEntries = await History.ListAsync(ProjectId);
    }

    private void CloseHistory() => _historyOpen = false;

    private void ToggleHistory(Guid id)
    {
        _expandedHistoryId = _expandedHistoryId == id ? null : id;
    }

    private static List<AiToolCallRecord> ParseTools(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            return JsonSerializer.Deserialize<List<AiToolCallRecord>>(json) ?? [];
        }
        catch
        {
            return [];
        }
    }

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";

    private static string StatusBadgeText(AiConsoleEntryStatus s) => s switch
    {
        AiConsoleEntryStatus.Completed => "Completed",
        AiConsoleEntryStatus.Cancelled => "Cancelled",
        AiConsoleEntryStatus.Failed => "Failed",
        _ => "Pending",
    };

    private static string StatusColor(AiConsoleEntryStatus s) => s switch
    {
        AiConsoleEntryStatus.Completed => "success",
        AiConsoleEntryStatus.Cancelled => "secondary",
        AiConsoleEntryStatus.Failed => "danger",
        _ => "info",
    };

    public ValueTask DisposeAsync()
    {
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
