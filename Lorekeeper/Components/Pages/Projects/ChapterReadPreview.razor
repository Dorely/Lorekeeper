@using Lorekeeper.Composition
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IChapterPreviewService Preview
@inject IProjectPageSetupService PageSetups
@inject IManuscriptService Manuscripts
@inject IManuscriptAnnotationService Annotations
@inject IJSRuntime JS

<section class="chapter-read-preview" aria-label="Chapter print preview" @ref="_root">
    <style>@((MarkupString)PreviewFontCss())</style>
    <header class="chapter-preview-toolbar">
        <div class="btn-group btn-group-sm" role="group" aria-label="Page display">
            <button type="button" class="btn @ButtonClass(!FacingPages)" @onclick="() => ChangeFacingAsync(false)">Single page</button>
            <button type="button" class="btn @ButtonClass(FacingPages)" @onclick="() => ChangeFacingAsync(true)">Facing pages</button>
        </div>
        @if (FacingPages)
        {
            <button type="button"
                    class="btn btn-sm @ButtonClass(_showFacingSeam)"
                    aria-pressed="@_showFacingSeam"
                    title="Add space between the left and right pages"
                    @onclick="() => _showFacingSeam = !_showFacingSeam">
                @(_showFacingSeam ? "Hide page seam" : "Show page seam")
            </button>
        }
        <select class="form-select form-select-sm" value="@_fit" @onchange="ChangeFit">
            <option value="page">Fit page</option>
            <option value="width">Fit width</option>
            <option value="zoom">Custom zoom</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeZoom(-.1)">−</button>
        <span class="chapter-preview-zoom">@Math.Round(_zoom * 100)%</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeZoom(.1)">+</button>
        @if (_setup is not null)
        {
            <select class="form-select form-select-sm chapter-preview-preset" value="@PresetValue()" @onchange="ChangePresetAsync">
                <option value="6x9">6 × 9 in</option>
                <option value="5.5x8.5">5.5 × 8.5 in</option>
                <option value="8.5x11">8.5 × 11 in</option>
                <option value="custom">Custom</option>
            </select>
            <details class="chapter-preview-setup">
                <summary>Page setup</summary>
                <div>
                    <label>Width (in)<input type="number" min="3" max="24" step=".125" @bind="_setupWidth" /></label>
                    <label>Height (in)<input type="number" min="3" max="24" step=".125" @bind="_setupHeight" /></label>
                    <label>Margins (in)<input type="number" min=".25" max="3" step=".0625" @bind="_setupMargin" /></label>
                    <label>Body size (pt)<input type="number" min="6" max="36" step=".25" @bind="_setupFontSize" /></label>
                    <label>Line height<input type="number" min=".8" max="3" step=".05" @bind="_setupLineHeight" /></label>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveSetupAsync">Apply</button>
                </div>
            </details>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
        <div class="btn-group btn-group-sm" role="group" aria-label="Review selected preview text">
            <button type="button" class="btn btn-outline-warning" @onmousedown:preventDefault @onclick="() => CreateReadAnnotationAsync(ManuscriptAnnotationKind.Highlight)">Highlight</button>
            <button type="button" class="btn btn-outline-secondary" @onmousedown:preventDefault @onclick="OpenReadNoteAsync">Note</button>
        </div>
    </header>

    @if (_noteOpen)
    {
        <div class="chapter-preview-note-form" role="dialog" aria-label="Add review note">
            <label>Note<textarea class="form-control form-control-sm" maxlength="8000" rows="3" @bind="_noteDraft"></textarea></label>
            <button type="button" class="btn btn-sm btn-primary" @onclick="() => CreateReadAnnotationAsync(ManuscriptAnnotationKind.Note)">Add note</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelReadNote">Cancel</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_selectionError))
    {
        <div class="chapter-preview-selection-error" role="status">@_selectionError</div>
    }

    @if (_loading)
    {
        <div class="chapter-preview-status"><span class="spinner-border spinner-border-sm"></span> Typesetting chapter preview…</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="chapter-preview-error" role="alert">
            <strong>Preview could not be generated.</strong>
            <p>@_error</p>
            <button type="button" class="btn btn-sm btn-primary" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else if (_result is null || _result.Pages.Count == 0)
    {
        <div class="chapter-preview-status">This chapter has no preview pages.</div>
    }
    else
    {
        @if (_result.Diagnostics.Count > 0)
        {
            <div class="chapter-preview-diagnostics" role="status">
                @foreach (var diagnostic in _result.Diagnostics)
                {
                    <p><strong>Preview note:</strong> @PublicationDiagnosticText.SanitizeIdentifiers(diagnostic.Message)</p>
                }
            </div>
        }
        <div class="chapter-preview-scroll @(FacingPages ? "facing" : "single") @(FacingPages && _showFacingSeam ? "show-seam" : null) @($"fit-{_fit}")">
            @if (FacingPages)
            {
                @foreach (var spread in BuildFacingSpreads(_result.Pages))
                {
                    <div class="chapter-preview-spread">
                        @foreach (var page in spread)
                        {
                            if (page is null)
                            {
                                <span class="chapter-preview-page chapter-preview-page-blank" style="@PageStyle(spread.First(item => item is not null)!)" aria-hidden="true"></span>
                            }
                            else
                            {
                                @RenderPage(page)
                            }
                        }
                    </div>
                }
            }
            else
            {
                @foreach (var page in _result.Pages)
                {
                    @RenderPage(page)
                }
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter] public EditorContentTarget ContentTarget { get; set; } = EditorContentTarget.Core;
    [Parameter] public long RefreshSignal { get; set; }
    [Parameter] public bool FacingPages { get; set; }
    [Parameter] public EventCallback<bool> FacingPagesChanged { get; set; }
    [Parameter] public EventCallback AnnotationsChanged { get; set; }
    [Parameter] public EventCallback<Guid> AnnotationSelected { get; set; }

    private static IEnumerable<ChapterPreviewPage?[]> BuildFacingSpreads(IReadOnlyList<ChapterPreviewPage> pages)
    {
        ChapterPreviewPage? left = null;
        foreach (var page in pages)
        {
            if (page.PhysicalPage % 2 == 0)
            {
                if (left is not null)
                    yield return [left, null];
                left = page;
                continue;
            }

            yield return [left, page];
            left = null;
        }

        if (left is not null)
            yield return [left, null];
    }

    private RenderFragment RenderPage(ChapterPreviewPage page) => @<article id="@($"page-{page.PhysicalPage}")" class="chapter-preview-page" data-page-kind="@(page.Kind)" style="@PageStyle(page)" aria-label="Page @(page.PageLabel ?? page.PhysicalPage.ToString())">
                @foreach (var shape in page.Shapes)
                {
                    <span class="chapter-preview-shape" style="@ShapeStyle(page, shape)"></span>
                }
                @foreach (var image in page.Images)
                {
                    <span class="chapter-preview-image-frame" style="@ImageFrameStyle(page, image)">
                        <img class="chapter-preview-image" src="/projects/@ProjectId.ToString("N")/images/@image.AssetId.ToString("N")/content" alt="@(image.Decorative ? string.Empty : image.AltText)" style="@ImageContentStyle(image)" />
                    </span>
                }
                @foreach (var line in page.Lines)
                {
                    @if (line.Link is { } link)
                    {
                        <a class="chapter-preview-line" href="@link" style="@LineStyle(page, line)" data-block-id="@FlowBlockId(line)" data-source-start-utf16="@line.SourceStartUtf16" data-source-end-utf16="@line.SourceEndUtf16">@RunContent(line)</a>
                    }
                    else
                    {
                        <span class="chapter-preview-line" style="@LineStyle(page, line)" data-block-id="@FlowBlockId(line)" data-source-start-utf16="@line.SourceStartUtf16" data-source-end-utf16="@line.SourceEndUtf16">@RunContent(line)</span>
                    }
                }
                <footer>@(page.PageLabel ?? string.Empty)</footer>
            </article>;

    private ChapterPreviewResult? _result;
    private ProjectPageSetup? _setup;
    private Guid _loadedProject;
    private Guid _loadedChapter;
    private EditorContentTarget _loadedTarget = EditorContentTarget.Core;
    private long _loadedSignal = -1;
    private bool _loading;
    private bool _showFacingSeam;
    private string _fit = "width";
    private double _zoom = 1;
    private string? _error;
    private double _setupWidth = 6;
    private double _setupHeight = 9;
    private double _setupMargin = .75;
    private double _setupFontSize = 12;
    private double _setupLineHeight = 1.55;
    private CancellationTokenSource? _loadCancellation;
    private long _loadGeneration;
    private bool _disposed;
    private ElementReference _root;
    private IJSObjectReference? _selectionModule;
    private IReadOnlyList<ManuscriptAnnotationView> _annotations = [];
    private readonly Dictionary<string, int> _blockOrder = new(StringComparer.Ordinal);
    private long _manuscriptRevision;
    private bool _noteOpen;
    private string _noteDraft = string.Empty;
    private ManuscriptAnnotationRange? _noteRange;
    private string? _selectionError;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId && _loadedChapter == ChapterId && _loadedTarget == ContentTarget && _loadedSignal == RefreshSignal)
            return;
        _loadedProject = ProjectId;
        _loadedChapter = ChapterId;
        _loadedTarget = ContentTarget;
        _loadedSignal = RefreshSignal;
        _setup = await PageSetups.GetOrCreateAsync(ProjectId);
        CopySetup();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        var cancellation = _loadCancellation;
        var generation = ++_loadGeneration;
        _loading = true;
        _error = null;
        try
        {
            var manuscript = await Manuscripts.GetManuscriptAsync(ContentTarget, ChapterId, cancellation.Token)
                ?? throw new InvalidOperationException("The chapter manuscript was not found.");
            _manuscriptRevision = manuscript.Revision;
            _blockOrder.Clear();
            for (var index = 0; index < manuscript.Document.Content.Count; index++)
                _blockOrder[manuscript.Document.Content[index].Id] = index;
            var previewTask = Preview.LayoutAsync(ProjectId, ChapterId, ContentTarget, cancellation.Token);
            var annotationsTask = Annotations.ListChapterAsync(ProjectId, ContentTarget, ChapterId, cancellation.Token);
            await Task.WhenAll(previewTask, annotationsTask);
            _result = await previewTask;
            _annotations = await annotationsTask;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            if (!_disposed && generation == _loadGeneration)
            {
                _result = null;
                _error = "Chapter preview took too long. Retry after closing other active renders.";
            }
        }
        catch (Exception exception)
        {
            if (!_disposed && generation == _loadGeneration)
            {
                _result = null;
                _error = PublicationDiagnosticText.SanitizeIdentifiers(exception.Message);
            }
        }
        finally
        {
            if (!_disposed && generation == _loadGeneration)
                _loading = false;
        }
    }

    private async Task ChangePresetAsync(ChangeEventArgs e)
    {
        switch (e.Value?.ToString())
        {
            case "6x9": _setupWidth = 6; _setupHeight = 9; break;
            case "5.5x8.5": _setupWidth = 5.5; _setupHeight = 8.5; break;
            case "8.5x11": _setupWidth = 8.5; _setupHeight = 11; break;
            default: return;
        }
        await SaveSetupAsync();
    }

    private async Task SaveSetupAsync()
    {
        if (_setup is null) return;
        try
        {
            _setup = await PageSetups.UpdateAsync(ProjectId, _setup.Revision, new(_setupWidth, _setupHeight, _setupMargin, _setupFontSize, _setupLineHeight));
            await LoadAsync();
        }
        catch (Exception exception) { _error = PublicationDiagnosticText.SanitizeIdentifiers(exception.Message); }
    }

    private void CopySetup()
    {
        if (_setup is null) return;
        _setupWidth = _setup.PageWidthInches;
        _setupHeight = _setup.PageHeightInches;
        _setupMargin = _setup.PageMarginInches;
        _setupFontSize = _setup.BodyFontSizePoints;
        _setupLineHeight = _setup.BodyLineHeight;
    }

    private string PresetValue() => (_setupWidth, _setupHeight) switch
    {
        (6, 9) => "6x9",
        (5.5, 8.5) => "5.5x8.5",
        (8.5, 11) => "8.5x11",
        _ => "custom",
    };
    private static string ButtonClass(bool active) => active ? "btn-primary" : "btn-outline-secondary";
    private async Task ChangeFacingAsync(bool facing)
    {
        if (FacingPages == facing) return;
        await FacingPagesChanged.InvokeAsync(facing);
    }
    private void ChangeFit(ChangeEventArgs e) { _fit = e.Value?.ToString() ?? "page"; if (_fit != "zoom") _zoom = 1; }
    private void ChangeZoom(double amount) { _fit = "zoom"; _zoom = Math.Clamp(_zoom + amount, .35, 2.5); }
    private string PageStyle(ChapterPreviewPage page)
    {
        var ratio = page.WidthPoints / page.HeightPoints;
        var fitWidthVh = 64 * ratio * _zoom;
        var facingWidthVh = 62 * ratio * _zoom;
        var fitMaximumPercent = 90 * _zoom;
        var fullWidthPercent = 100 * _zoom;
        return FormattableString.Invariant($"--page-ratio:{ratio:R};--page-width:{page.WidthPoints:R};--page-height:{page.HeightPoints:R};--page-fit-width:{fitWidthVh:R}vh;--page-facing-width:{facingWidthVh:R}vh;--page-fit-maximum:{fitMaximumPercent:R}%;--page-full-width:{fullWidthPercent:R}%");
    }
    private static string Percent(double value, double total) => (value / total * 100).ToString("R", System.Globalization.CultureInfo.InvariantCulture) + "%";
    private static string Color(double[]? rgb) => rgb is { Length: >= 3 } ? $"rgb({rgb[0] * 255:0} {rgb[1] * 255:0} {rgb[2] * 255:0})" : "transparent";
    private static string ShapeStyle(ChapterPreviewPage page, ChapterPreviewShape shape) => $"left:{Percent(shape.X, page.WidthPoints)};bottom:{Percent(shape.Y, page.HeightPoints)};width:{Percent(shape.Width, page.WidthPoints)};height:{Percent(shape.Height, page.HeightPoints)};z-index:{shape.ZIndex};opacity:{shape.Opacity:R};transform:rotate({shape.RotationDegrees:R}deg);background:{Color(shape.FillRgb)};border:{shape.StrokeWidth / page.WidthPoints * 100:R}cqw solid {Color(shape.StrokeRgb)}";
    private static string ImageFrameStyle(ChapterPreviewPage page, ChapterPreviewImage image) => $"left:{Percent(image.X, page.WidthPoints)};bottom:{Percent(image.Y, page.HeightPoints)};width:{Percent(image.Width, page.WidthPoints)};height:{Percent(image.Height, page.HeightPoints)};z-index:{image.ZIndex};opacity:{image.Opacity:R};transform:rotate({image.RotationDegrees:R}deg)";
    private static string ImageContentStyle(ChapterPreviewImage image)
    {
        var sourceWidth = image.SourceWidthFraction is > 0 and <= 1
            ? image.SourceWidthFraction
            : 1;
        var sourceLeft = Math.Clamp(image.SourceLeftFraction, 0, 1 - sourceWidth);
        var virtualWidth = 100 / sourceWidth;
        var virtualLeft = -sourceLeft / sourceWidth * 100;
        var fit = image.Fit.Equals("Cover", StringComparison.OrdinalIgnoreCase)
            ? "cover"
            : image.Fit.Equals("Stretch", StringComparison.OrdinalIgnoreCase)
                ? "fill"
                : "contain";
        var cropXPercent = Math.Clamp(image.CropX, 0, 1) * 100;
        var cropYPercent = Math.Clamp(image.CropY, 0, 1) * 100;
        return $"left:{virtualLeft:R}%;top:0;width:{virtualWidth:R}%;height:100%;object-fit:{fit};object-position:{cropXPercent:R}% {cropYPercent:R}%";
    }
    private string LineStyle(ChapterPreviewPage page, ChapterPreviewLine line) => $"left:{Percent(line.X, page.WidthPoints)};bottom:{Percent(line.Y - line.Size * .25, page.HeightPoints)};z-index:{line.ZIndex};font-size:{line.Size / page.WidthPoints * 100:R}cqw;font-family:{FontFamily(line.Face)};font-weight:{FontWeight(line.Face)};font-style:{FontStyle(line.Face)};word-spacing:{line.WordSpacing / page.WidthPoints * 100:R}cqw;letter-spacing:{line.CharacterSpacing / page.WidthPoints * 100:R}cqw;opacity:{line.Opacity:R};transform-origin:{((line.RotationOriginX ?? line.X) - line.X) / page.WidthPoints * 100:R}cqw {(line.Y + line.Size * .75 - (line.RotationOriginY ?? line.Y)) / page.WidthPoints * 100:R}cqw;transform:rotate({line.RotationDegrees:R}deg);color:{(line.FillRgb is null ? "#202534" : Color(line.FillRgb))}";
    private static string FontFamily(string? face)
    {
        if (face?.StartsWith("Custom", StringComparison.Ordinal) == true
            && int.TryParse(face["Custom".Length..], out var customIndex)
            && customIndex >= 0)
            return $"'LorekeeperPreviewCustom{customIndex}', serif";
        return face?.StartsWith("Mono", StringComparison.OrdinalIgnoreCase) == true
            ? "'Lorekeeper Preview Mono', monospace"
            : face?.StartsWith("Sans", StringComparison.OrdinalIgnoreCase) == true
                ? "'Lorekeeper Preview Sans', sans-serif"
                : "'Lorekeeper Preview Serif', Georgia, serif";
    }
    private string PreviewFontCss()
    {
        var css = new System.Text.StringBuilder(
            "@font-face{font-family:'Lorekeeper Preview Serif';src:url('/fonts/lora/Lora-Regular.ttf') format('truetype');font-weight:400;font-style:normal}"
            + "@font-face{font-family:'Lorekeeper Preview Serif';src:url('/fonts/lora/Lora-Italic.ttf') format('truetype');font-weight:400;font-style:italic}"
            + "@font-face{font-family:'Lorekeeper Preview Serif';src:url('/fonts/lora/Lora-Bold.ttf') format('truetype');font-weight:700;font-style:normal}"
            + "@font-face{font-family:'Lorekeeper Preview Serif';src:url('/fonts/lora/Lora-BoldItalic.ttf') format('truetype');font-weight:700;font-style:italic}"
            + "@font-face{font-family:'Lorekeeper Preview Sans';src:url('/fonts/nunito/Nunito-Regular.ttf') format('truetype');font-weight:400;font-style:normal}"
            + "@font-face{font-family:'Lorekeeper Preview Sans';src:url('/fonts/nunito/Nunito-Italic.ttf') format('truetype');font-weight:400;font-style:italic}"
            + "@font-face{font-family:'Lorekeeper Preview Sans';src:url('/fonts/nunito/Nunito-Bold.ttf') format('truetype');font-weight:700;font-style:normal}"
            + "@font-face{font-family:'Lorekeeper Preview Sans';src:url('/fonts/nunito/Nunito-BoldItalic.ttf') format('truetype');font-weight:700;font-style:italic}"
            + "@font-face{font-family:'Lorekeeper Preview Mono';src:url('/fonts/roboto-mono/RobotoMono-Regular.ttf') format('truetype');font-weight:400;font-style:normal}"
            + "@font-face{font-family:'Lorekeeper Preview Mono';src:url('/fonts/roboto-mono/RobotoMono-Italic.ttf') format('truetype');font-weight:400;font-style:italic}"
            + "@font-face{font-family:'Lorekeeper Preview Mono';src:url('/fonts/roboto-mono/RobotoMono-Bold.ttf') format('truetype');font-weight:700;font-style:normal}"
            + "@font-face{font-family:'Lorekeeper Preview Mono';src:url('/fonts/roboto-mono/RobotoMono-BoldItalic.ttf') format('truetype');font-weight:700;font-style:italic}");
        foreach (var font in _result?.Fonts ?? [])
        {
            if (!font.Face.StartsWith("Custom", StringComparison.Ordinal)
                || !int.TryParse(font.Face["Custom".Length..], out var index)
                || index < 0)
                continue;
            var format = font.ContentType == "font/otf" ? "opentype" : "truetype";
            css.Append($"@font-face{{font-family:'LorekeeperPreviewCustom{index}';src:url('{font.ContentUrl}') format('{format}');font-weight:{font.Weight};font-style:{(font.Italic ? "italic" : "normal")}}}");
        }
        return css.ToString();
    }
    private int FontWeight(string? face) => _result?.Fonts.FirstOrDefault(item => item.Face == face)?.Weight
        ?? (face?.Contains("Bold", StringComparison.OrdinalIgnoreCase) == true ? 700 : 400);
    private string FontStyle(string? face) => _result?.Fonts.FirstOrDefault(item => item.Face == face)?.Italic == true
        || face?.Contains("Italic", StringComparison.OrdinalIgnoreCase) == true ? "italic" : "normal";
    private RenderFragment RunContent(ChapterPreviewLine line) => builder =>
    {
        var sequence = 0;
        foreach (var piece in SplitLine(line))
        {
            builder.OpenElement(sequence++, "span");
            if (!string.IsNullOrEmpty(piece.Style))
                builder.AddAttribute(sequence++, "style", piece.Style);
            if (piece.Highlighted)
            {
                builder.AddAttribute(sequence++, "class", "chapter-preview-review-highlight");
                builder.AddAttribute(sequence++, "data-annotation-id", piece.AnnotationId);
                builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(
                    this,
                    () => AnnotationSelected.InvokeAsync(piece.AnnotationId!.Value)));
                builder.AddEventPreventDefaultAttribute(sequence++, "onclick", true);
                builder.AddEventStopPropagationAttribute(sequence++, "onclick", true);
            }
            builder.AddContent(sequence++, piece.Text);
            builder.CloseElement();
        }
    };
    private string RunStyle(ChapterPreviewRun run) => $"font-family:{FontFamily(run.Face)};font-weight:{FontWeight(run.Face)};font-style:{FontStyle(run.Face)};font-size:{run.SizeScale:R}em;vertical-align:{run.BaselineShiftEm:R}em;text-decoration:{(run.Underline && run.Strikethrough ? "underline line-through" : run.Underline ? "underline" : run.Strikethrough ? "line-through" : "none")}";

    private IReadOnlyList<PreviewTextPiece> SplitLine(ChapterPreviewLine line)
    {
        var blockId = FlowBlockId(line);
        if (blockId is null || line.SourceStartUtf16 is not int lineStart || line.SourceEndUtf16 is not int lineEnd)
            return line.Runs.Count == 0
                ? [new PreviewTextPiece(line.Text, string.Empty, false)]
                : line.Runs.Select(run => new PreviewTextPiece(run.Text, RunStyle(run), false)).ToList();
        var intervals = AnnotationIntervals(blockId)
            .Where(interval => interval.Start < lineEnd && interval.End > lineStart)
            .ToList();
        var prefix = line.Text.StartsWith("• ", StringComparison.Ordinal) ? 2 : 0;
        var displayContentLength = Math.Max(0, line.Text.Length - prefix);
        var boundaries = intervals.SelectMany(interval => new[]
            {
                prefix + Math.Clamp(interval.Start - lineStart, 0, displayContentLength),
                prefix + Math.Clamp(interval.End - lineStart, 0, displayContentLength),
            })
            .Append(0)
            .Append(line.Text.Length)
            .Distinct()
            .Order()
            .ToList();
        IReadOnlyList<ChapterPreviewRun> sourceRuns = line.Runs.Count == 0
            ? [new ChapterPreviewRun(line.Text, line.Face ?? "Serif", false, false, 0, 1)]
            : line.Runs;
        var result = new List<PreviewTextPiece>();
        var runStart = 0;
        foreach (var run in sourceRuns)
        {
            var runEnd = runStart + run.Text.Length;
            var runBoundaries = boundaries
                .Where(value => value > runStart && value < runEnd)
                .Append(runStart)
                .Append(runEnd)
                .Distinct()
                .Order()
                .ToList();
            for (var boundaryIndex = 0; boundaryIndex < runBoundaries.Count - 1; boundaryIndex++)
            {
                var start = runBoundaries[boundaryIndex];
                var end = runBoundaries[boundaryIndex + 1];
                var sourceStart = lineStart + Math.Max(0, start - prefix);
                var sourceEnd = lineStart + Math.Max(0, end - prefix);
                var matching = intervals.FirstOrDefault(interval => sourceStart < interval.End && sourceEnd > interval.Start);
                result.Add(new PreviewTextPiece(
                    run.Text[(start - runStart)..(end - runStart)],
                    RunStyle(run),
                    matching != default,
                    matching == default ? null : matching.Id));
            }
            runStart = runEnd;
        }
        return result;
    }

    private IReadOnlyList<(int Start, int End, Guid Id)> AnnotationIntervals(string blockId)
    {
        if (!_blockOrder.TryGetValue(blockId, out var blockIndex))
            return [];
        var result = new List<(int Start, int End, Guid Id)>();
        foreach (var annotation in _annotations.Where(item => item.AnchorState == ManuscriptAnnotationAnchorState.Current))
        {
            if (!_blockOrder.TryGetValue(annotation.Range.StartBlockId, out var startIndex)
                || !_blockOrder.TryGetValue(annotation.Range.EndBlockId, out var endIndex)
                || blockIndex < startIndex || blockIndex > endIndex)
                continue;
            result.Add((
                blockIndex == startIndex ? annotation.Range.StartOffset : 0,
                blockIndex == endIndex ? annotation.Range.EndOffset : int.MaxValue,
                annotation.Id));
        }
        return result;
    }

    private static string? FlowBlockId(ChapterPreviewLine line) => line.SemanticId switch
    {
        null or "" => null,
        var id when id.EndsWith(":caption", StringComparison.Ordinal) => id[..^":caption".Length],
        var id => id,
    };

    private async Task OpenReadNoteAsync()
    {
        _noteRange = await GetAnnotationRangeAsync();
        if (_noteRange is null)
            return;
        _noteOpen = true;
        _selectionError = null;
    }

    private void CancelReadNote()
    {
        _noteOpen = false;
        _noteDraft = string.Empty;
        _noteRange = null;
    }

    private async Task CreateReadAnnotationAsync(ManuscriptAnnotationKind kind)
    {
        if (kind == ManuscriptAnnotationKind.Note && string.IsNullOrWhiteSpace(_noteDraft))
        {
            _selectionError = "Enter note text before adding the annotation.";
            return;
        }
        var range = kind == ManuscriptAnnotationKind.Note
            ? _noteRange
            : await GetAnnotationRangeAsync();
        if (range is null)
            return;
        try
        {
            await Annotations.CreateAsync(
                ProjectId, ContentTarget, ChapterId, kind, _noteDraft, range, _manuscriptRevision);
            CancelReadNote();
            _selectionError = null;
            _annotations = await Annotations.ListChapterAsync(ProjectId, ContentTarget, ChapterId);
            await AnnotationsChanged.InvokeAsync();
        }
        catch (Exception exception)
        {
            _selectionError = exception.Message;
        }
    }

    public async Task<ManuscriptAnnotationRange?> GetAnnotationRangeAsync()
    {
        try
        {
            _selectionModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/read-annotation-selection.js");
            var result = await _selectionModule.InvokeAsync<ReadSelectionResult>("readSelection", _root);
            _selectionError = result.Error;
            return result.Range;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            _selectionError = "The preview selection could not be read. Refresh the preview and try again.";
            return null;
        }
    }

    public async Task SelectAnnotationAsync(Guid annotationId)
    {
        var annotation = _annotations.FirstOrDefault(item => item.Id == annotationId);
        if (annotation is null || annotation.AnchorState != ManuscriptAnnotationAnchorState.Current)
            return;
        try
        {
            _selectionModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/read-annotation-selection.js");
            await _selectionModule.InvokeVoidAsync("selectRange", _root, annotation.Range);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            _selectionError = "The annotated preview range could not be selected. Refresh the preview and try again.";
        }
    }

    public void SetAnnotations(IReadOnlyList<ManuscriptAnnotationView> annotations)
    {
        _annotations = annotations;
        StateHasChanged();
    }

    private sealed record PreviewTextPiece(string Text, string Style, bool Highlighted, Guid? AnnotationId = null);
    private sealed record ReadSelectionResult(ManuscriptAnnotationRange? Range, string? Error);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = null;
        if (_selectionModule is not null)
            await _selectionModule.DisposeAsync();
    }
}
