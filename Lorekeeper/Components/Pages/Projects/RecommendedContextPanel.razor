@using Lorekeeper.Context
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject IEditorContextService EditorContext

<div class="recommended-context">
    <input type="search"
           class="form-control form-control-sm recommended-search"
           placeholder="Search context..."
           value="@_query"
           @oninput="OnSearchInput" />

    @if (ChapterId is null)
    {
        <p class="text-muted small mb-0"><em>Select a chapter to see recommendations.</em></p>
    }
    else if (_loading)
    {
        <p class="text-muted small mb-0"><em>Loading…</em></p>
    }
    else if (_items.Count == 0)
    {
        <p class="text-muted small mb-0"><em>No context recommendations.</em></p>
    }
    else
    {
        <div class="recommended-list">
            @foreach (var item in _items)
            {
                <article class="recommended-item" @key="item.Key">
                    <div class="recommended-open"
                         role="button"
                         tabindex="0"
                         aria-label="Open @item.Name details"
                         @onclick="() => OpenDetail(item)"
                         @onkeydown="e => OnOpenKeyDown(e, item)">
                        <div class="recommended-item-head">
                            <div class="recommended-name">@item.Name</div>
                            <span class="recommended-type">@item.Type</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Preview))
                        {
                            <div class="recommended-preview">@item.Preview</div>
                        }
                        <div class="recommended-reasons">
                            @foreach (var reason in item.Reasons)
                            {
                                <span>@reason</span>
                            }
                        </div>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline-primary recommended-add"
                            @onclick="() => AddAsync(item)">
                        Add to context
                    </button>
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger alert-dismissible recommended-error">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }
</div>

<ContextItemDetailModal ProjectId="ProjectId"
                        Recommendation="_selectedDetail"
                        IsOpen="_detailOpen"
                        OnClose="CloseDetail" />

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? ChapterId { get; set; }
    [Parameter] public int RefreshSignal { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<ContextRecommendation> _items = [];
    private string _query = string.Empty;
    private string? _error;
    private bool _loading;
    private Guid _lastProjectId;
    private Guid? _lastChapterId;
    private int _lastRefreshSignal = -1;
    private CancellationTokenSource? _reloadCts;
    private int _reloadVersion;
    private bool _disposed;
    private ContextRecommendation? _selectedDetail;
    private bool _detailOpen;

    protected override void OnParametersSet()
    {
        if (ProjectId != _lastProjectId || ChapterId != _lastChapterId || RefreshSignal != _lastRefreshSignal)
        {
            _lastProjectId = ProjectId;
            _lastChapterId = ChapterId;
            _lastRefreshSignal = RefreshSignal;
            StartReload();
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        StartReload();
    }

    private void StartReload()
    {
        if (_disposed) return;

        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
        _reloadCts = null;

        if (ChapterId is null)
        {
            _items = [];
            _loading = false;
            _error = null;
            return;
        }

        _loading = true;
        _error = null;

        var projectId = ProjectId;
        var chapterId = ChapterId.Value;
        var query = _query;
        var version = ++_reloadVersion;
        var cts = new CancellationTokenSource();
        _reloadCts = cts;

        _ = Task.Run(() => LoadRecommendationsAsync(projectId, chapterId, query, version, cts.Token));
    }

    private async Task LoadRecommendationsAsync(
        Guid projectId,
        Guid chapterId,
        string query,
        int version,
        CancellationToken cancellationToken)
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var recommendations = scope.ServiceProvider.GetRequiredService<IContextRecommendationService>();
            var items = (await recommendations.ListAsync(projectId, chapterId, query, cancellationToken)).ToList();

            if (!IsCurrentLoad(version, cancellationToken)) return;

            await InvokeAsync(() =>
            {
                if (!IsCurrentLoad(version, cancellationToken)) return;
                _items = items;
                _loading = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!IsCurrentLoad(version, cancellationToken)) return;

            await InvokeAsync(() =>
            {
                if (!IsCurrentLoad(version, cancellationToken)) return;
                _error = ex.Message;
                _loading = false;
                StateHasChanged();
            });
        }
    }

    private bool IsCurrentLoad(int version, CancellationToken cancellationToken) =>
        !_disposed && !cancellationToken.IsCancellationRequested && version == _reloadVersion;

    private void CancelReload()
    {
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
        _reloadCts = null;
    }

    private async Task NotifyChangedAsync()
    {
        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
            return;
        }

        StartReload();
    }

    private async Task AddAsync(ContextRecommendation item)
    {
        if (ChapterId is null) return;
        try
        {
            await EditorContext.SetItemIncludedAsync(ProjectId, ChapterId.Value, item.Kind, item.Key, isIncluded: true);
            await NotifyChangedAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenDetail(ContextRecommendation item)
    {
        _selectedDetail = item;
        _detailOpen = true;
    }

    private void CloseDetail()
    {
        _detailOpen = false;
        _selectedDetail = null;
    }

    private void OnOpenKeyDown(KeyboardEventArgs e, ContextRecommendation item)
    {
        if (e.Key is "Enter" or " ")
        {
            OpenDetail(item);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        CancelReload();
    }
}
