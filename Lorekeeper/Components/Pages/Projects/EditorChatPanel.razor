    private bool IsWorkingProvider(int providerId) =>
        _providers.Any(provider => provider.Id == providerId);

    private void RebuildRenderable(DateTime? excludeMessagesCreatedAtOrAfter = null)
    {
        var messages = excludeMessagesCreatedAtOrAfter is { } cutoff
            ? _messages.Where(message => message.CreatedAt < cutoff).ToList()
            : _messages;

        var byCallId = messages
            .Where(message => message.Role == EditorMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<ChatRenderableMessage>(messages.Count);
        foreach (var message in messages)
        {
            if (message.Role is EditorMessageRole.Tool or EditorMessageRole.System) continue;

            _renderable.Add(new ChatRenderableMessage(
                Id: message.Id,
                Role: ToChatRole(message.Role),
                Status: ToChatStatus(message.Status),
                Parts: BuildPartsWithImages(message, byCallId)));
        }
    }

    private List<ChatMessagePart> BuildPartsWithImages(EditorMessage message, IReadOnlyDictionary<string, EditorMessage> byCallId)
    {
        var parts = BuildMessageParts(message, byCallId, ProjectId);
        if (message.Role == EditorMessageRole.Assistant && !string.IsNullOrWhiteSpace(message.Reasoning))
        {
            var reasoningPart = new ChatReasoningPart();
            reasoningPart.Append(message.Reasoning);
            parts.Insert(0, reasoningPart);
        }
        if (message.Role == EditorMessageRole.User && _messageImages.TryGetValue(message.Id, out var images))
            ChatImageParts.Append(parts, images);
        return parts;
    }

    private static ChatMessageRole ToChatRole(EditorMessageRole role) => role == EditorMessageRole.User
        ? ChatMessageRole.User
        : ChatMessageRole.Assistant;

    private static ChatMessageStatus ToChatStatus(EditorMessageStatus status) => status switch
    {
        EditorMessageStatus.Failed => ChatMessageStatus.Failed,
        EditorMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        EditorMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private async Task LoadChatProviderStateAsync(CancellationToken cancellationToken = default)
    {
        _chatAvailability = await Chat.GetChatProviderAvailabilityAsync(ProjectId, cancellationToken);
        _chatSelection = await ProviderService.ResolveChatModelSelectionAsync(_selectedProviderId, cancellationToken);
        _modelOptions = (await ProviderService.ListChatModelOptionsAsync(cancellationToken))
            .Select(option => new ChatModelPickerOption(option.ProviderId, option.ConnectionLabel, option.ModelLabel, option.IsDefault))
            .ToList();
    }

    private int? PickerSelectedProviderId => _activeTurnModel?.ProviderId ?? _selectedProviderId ?? _chatSelection?.ProviderId;

    private void IncludeActiveModelOption()
    {
        if (_activeTurnModel is not { } active
            || _modelOptions.Any(option => option.ProviderId == active.ProviderId))
            return;
        _modelOptions = _modelOptions
            .Append(new ChatModelPickerOption(active.ProviderId, "Active model", active.ModelId, IsDefault: false))
            .ToList();
    }

    private async Task OnModelChangedAsync(int? providerId)
    {
        if (_loading || _running || _resetting || ContestCandidateCount > 0) return;
        if (ChatTurns.GetActiveTurn(ProjectId) is not null)
        {
            _error = "Editor Chat is still working in another window. Stop or wait for that turn before changing its model.";
            return;
        }
        try
        {
            await Chat.SetSelectedProviderAsync(ProjectId, providerId);
            _selectedProviderId = await ProviderService.NormalizeChatModelSelectionAsync(providerId);
            await LoadChatProviderStateAsync();
            UpdateConversationTokenCount();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private ChatTurnModelSnapshot Snapshot(LlmProvider provider) =>
        new(provider.Id, provider.ModelId, _chatSelection?.Label ?? $"{provider.DisplayName ?? provider.Name} · {provider.ModelId}", provider.EffectiveMaxInputTokens, provider.ResolvedMetadata);

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            ChatTranscriptTokenCounter.ModelReplayMessages(
                _messages,
                message => message.Role.ToString(),
                message => message.Content),
            message => message,
            _live,
            _pendingUserText,
            systemPrompt: _systemPrompt);
    }

    private async Task RefreshSystemPromptAsync(CancellationToken cancellationToken = default)
    {
        _systemPrompt = string.Empty;
        var project = await Projects.GetByIdAsync(ProjectId, cancellationToken);
        if (project is null) return;

        Chapter? currentChapter = null;
        if (CurrentChapterId is { } chapterId)
        {
            currentChapter = await Chapters.GetAsync(chapterId, cancellationToken);
            if (currentChapter is null || currentChapter.ProjectId != ProjectId)
                currentChapter = null;
        }

        var assembly = await ContextBuilder.BuildAsync(
            new ContextBuildRequest(project, currentChapter),
            cancellationToken);
        _systemPrompt = assembly.Assemble();
    }

    private static ChatToolProgress ToChatToolProgress(EditorRevisionJobProgress progress) => new()
    {
        JobId = progress.JobId,
        SectionLabel = "workers",
        ItemLabel = "workers",
        Status = progress.Status.ToString(),
        UpdatedAt = progress.UpdatedAt,
        TotalCount = progress.TotalSessions,
        QueuedCount = progress.QueuedCount,
        RunningCount = progress.RunningCount,
        CompletedCount = progress.CompletedCount,
        FailedCount = progress.FailedCount,
        InvalidCount = progress.InvalidCount,
        CancelledCount = progress.CancelledCount,
        Rows = progress.Sessions
            .OrderBy(session => session.Order)
            .Select(session => new ChatToolProgressRow(
                session.SessionId,
                session.Order,
                session.ChapterTitle,
                session.Status.ToString(),
                session.Summary,
                session.ErrorMessage))
            .ToList(),
    };

    private static ChatToolProgress ToChatToolProgress(EditorChatImageGenerationJobUpdated progress) => new()
    {
        JobId = progress.JobId,
        SectionLabel = "image generation",
        ItemLabel = progress.TotalCount == 1 ? "image" : "images",
        Status = progress.Status,
        UpdatedAt = progress.UpdatedAtUtc,
        LatestPreviewImageUrl = progress.LatestPartialImageUrl,
        LatestPreviewAlt = "Partial image preview",
        TotalCount = progress.TotalCount,
        QueuedCount = progress.QueuedCount,
        RunningCount = progress.RunningCount,
        CompletedCount = progress.CompletedCount,
        FailedCount = progress.FailedCount,
        CancelledCount = progress.CancelledCount,
        Rows = progress.Outputs
            .OrderBy(output => output.OutputIndex)
            .Select(output => new ChatToolProgressRow(
                ImageOutputProgressRowId(progress.JobId, output.OutputIndex),
                output.OutputIndex,
                $"Output {output.OutputIndex + 1}",
                output.Status,
                output.Attempt > 0 ? $"{output.Message} Attempt {output.Attempt}." : output.Message,
                output.ErrorMessage))
            .ToList(),
    };

    private static Guid ImageOutputProgressRowId(Guid jobId, int outputIndex)
    {
        var bytes = jobId.ToByteArray();
        var indexBytes = BitConverter.GetBytes(outputIndex);
        Array.Copy(indexBytes, 0, bytes, 12, indexBytes.Length);
        return new Guid(bytes);
    }

    private static List<ChatMessagePart> BuildMessageParts(EditorMessage message, IReadOnlyDictionary<string, EditorMessage> byCallId, Guid projectId)
    {
        if (message.Role != EditorMessageRole.Assistant)
        {
            var messageParts = new List<ChatMessagePart>();
            if (!string.IsNullOrEmpty(message.Content))
                messageParts.Add(new ChatTextPart(message.Content));
            messageParts.AddRange(message.Visuals.OrderBy(visual => visual.SortOrder).Select(visual => new ChatImagePart(ToChatImageVisual(visual, projectId))));
            return messageParts;
        }

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
        {
            var messageParts = new List<ChatMessagePart>();
            if (!string.IsNullOrEmpty(message.Content))
                messageParts.Add(new ChatTextPart(message.Content));
            messageParts.AddRange(message.Visuals.OrderBy(visual => visual.SortOrder).Select(visual => new ChatImagePart(ToChatImageVisual(visual, projectId))));
            return messageParts;
        }

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            DateTime? previousToolCompletedAt = message.CreatedAt;
            foreach (var item in calls
                .Select((call, index) => new { Call = call, Index = index })
                .OrderBy(item => item.Call.TextOffset!.Value)
                .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId, projectId, previousToolCompletedAt, out previousToolCompletedAt)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));

            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new ChatTextPart(message.Content));
        DateTime? previousCompletedAt = message.CreatedAt;
        foreach (var call in calls)
            parts.Add(new ChatToolPart(BuildToolChip(call, byCallId, projectId, previousCompletedAt, out previousCompletedAt)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(
        ChatPersistedToolCall call,
        IReadOnlyDictionary<string, EditorMessage> byCallId,
        Guid projectId,
        DateTime? startedAt,
        out DateTime? completedAt)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        completedAt = resultMessage?.CreatedAt;
        var chip = new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMessage is null
                ? "No persisted result was found for this tool call. The previous turn was interrupted before this tool completed."
                : resultMessage.Status == EditorMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == EditorMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = true,
        };
        if (startedAt is { } start && completedAt is { } end && end > start)
        {
            chip.DurationMs = (end - start).TotalMilliseconds;
        }
        if (resultMessage is not null)
            chip.Visuals.AddRange(resultMessage.Visuals.OrderBy(visual => visual.SortOrder).Select(visual => ToChatImageVisual(visual, projectId)));

        return chip;
    }

    private static ChatImageVisual ToChatImageVisual(EditorChatVisualAttachment visual) =>
        new(
            visual.Id,
            visual.Title,
            visual.Caption,
            visual.PreviewImageUrl,
            visual.FullImageUrl,
            visual.Width,
            visual.Height,
            visual.ToolCallId);

    private static ChatImageVisual ToChatImageVisual(EditorMessageVisual visual, Guid projectId)
    {
        var (previewUrl, fullUrl) = VisualUrls(visual, projectId);
        return new ChatImageVisual(
            visual.Id,
            visual.Title,
            visual.Caption,
            previewUrl,
            fullUrl,
            visual.Width,
            visual.Height,
            visual.ToolCallId);
    }

    private static (string PreviewUrl, string FullUrl) VisualUrls(EditorMessageVisual visual, Guid projectId)
    {
        if (string.Equals(visual.SourceKind, "projectImage", StringComparison.Ordinal)
            && visual.SourceRefId is { } imageId)
        {
            return ($"/projects/{projectId:N}/images/{imageId:N}/content?maxEdge=640", $"/projects/{projectId:N}/images/{imageId:N}/content");
        }

        return ($"/projects/{projectId:N}/editor-chat-visuals/{visual.Id:N}/content?maxEdge=640", $"/projects/{projectId:N}/editor-chat-visuals/{visual.Id:N}/content");
    }

