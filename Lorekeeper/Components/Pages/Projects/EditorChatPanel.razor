    {
        _disposed = true;
        _deferredWorkCts?.Cancel();
        _deferredWorkCts?.Dispose();
        _deferredWorkCts = null;
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        return ValueTask.CompletedTask;
    }
