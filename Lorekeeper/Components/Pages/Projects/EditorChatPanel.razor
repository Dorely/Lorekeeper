@using System.Text
@using Lorekeeper.Components.Pages.Projects.Outline
@using Lorekeeper.EditorChat
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Lorekeeper.Tokens
@implements IAsyncDisposable
@inject IEditorChatService Chat
@inject ILlmProviderService ProviderService
@inject ITokenCounter TokenCounter

<ChatSurface Title="Editor Chat"
             TokenText="@ConversationTokenText()"
             TokenTitle="@ConversationTokenTitle()"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Type a message..."
             Running="@_running"
             ComposerDisabled="@(_running || PendingChangeCount > 0)"
             SendDisabled="@(string.IsNullOrWhiteSpace(_input) || PendingChangeCount > 0 || !ContestCanSend)"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
            @if (PendingChangeCount > 0)
            {
                <button type="button" class="btn btn-link btn-sm editor-chat-review" @onclick="OpenPendingChanges">
                    Review @PendingChangeCount
                </button>
            }
            @if (ContestCandidateCount > 0)
            {
                <button type="button" class="btn btn-link btn-sm editor-chat-review" @onclick="OpenContestReview">
                    Contest @ContestCandidateCount
                </button>
            }
            @if (ContestHistoryBatchCount > 0)
            {
                <button type="button" class="btn btn-link btn-sm editor-chat-review" title="Review previous Contest Mode turns" @onclick="OpenContestHistory">
                    History @ContestHistoryBatchCount
                </button>
            }
            <button type="button" class="btn btn-link btn-sm editor-chat-reset" title="Start over"
                    disabled="@(_running || PendingChangeCount > 0)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        <div class="editor-chat-contest-config @(_contestEnabled ? "enabled" : null)">
            <label class="editor-chat-contest-toggle" title="Use read-only chat preparation, then compare up to three model candidates before staging one edit">
                <input class="form-check-input" type="checkbox" checked="@_contestEnabled"
                       disabled="@_running" @onchange="OnContestEnabledChangedAsync" />
                <span>Contest Mode</span>
            </label>
            @if (_contestEnabled)
            {
                <div class="editor-chat-contest-slots" aria-label="Contest models">
                    @RenderContestProviderSelect(1, _contestProviderSlot1Id)
                    @RenderContestProviderSelect(2, _contestProviderSlot2Id)
                    @RenderContestProviderSelect(3, _contestProviderSlot3Id)
                </div>
            }
        </div>
    </ExtraControls>
    <ComposerOptions>
        <label class="editor-chat-approval" title="Queue AI tool edits for review before applying them">
            <input class="form-check-input" type="checkbox" checked="@_approvalEnabled"
                   disabled="@_running" @onchange="OnApprovalChangedAsync" />
            <span>Review edits</span>
        </label>
    </ComposerOptions>
</ChatSurface>

<ContestReviewModal ProjectId="@ProjectId"
                    Batches="@_contestBatches"
                    IsOpen="@_showContestReview"
                    Title="Contest Review"
                    Subtitle="Compare candidate chapter edits from the current contest turn, then stage one for normal change review."
                    EmptyText="No current contest candidates yet."
                    OnClose="CloseContestReview"
                    OnChanged="HandleContestChangedAsync" />

<ContestReviewModal ProjectId="@ProjectId"
                    Batches="@_contestHistoryBatches"
                    IsOpen="@_showContestHistory"
                    Title="Contest History"
                    Subtitle="Review candidate chapter edits from previous contest turns."
                    EmptyText="No previous contest candidates yet."
                    ShowBatchDetails="true"
                    OnClose="CloseContestHistory"
                    OnChanged="HandleContestChangedAsync" />

<PendingAiChangesModal ProjectId="@ProjectId"
                       Batches="@_pendingBatches"
                       IsOpen="@_showPendingChanges"
                       OnClose="ClosePendingChanges"
                       OnChanged="HandlePendingChangesChangedAsync" />

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? CurrentChapterId { get; set; }
    [Parameter] public EventCallback OnAiTurnStarting { get; set; }
    [Parameter] public EventCallback OnAiTurnCompleted { get; set; }
    [Parameter] public EventCallback OnAiChangesApplied { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;

    private EditorConversation? _conversation;
    private List<EditorMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;

    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private bool _approvalEnabled = true;
    private bool _showPendingChanges;
    private string? _error;
    private CancellationTokenSource? _cts;
    private Guid? _loadedProjectId;
    private List<AiChangeBatch> _pendingBatches = [];
    private List<ContestBatch> _contestBatches = [];
    private List<ContestBatch> _contestHistoryBatches = [];
    private List<LlmProvider> _providers = [];
    private string? _pendingUserText;
    private int _conversationTokenCount;
    private bool _conversationTokenIsExact = true;
    private bool _contestEnabled;
    private bool _showContestReview;
    private bool _showContestHistory;
    private int? _contestProviderSlot1Id;
    private int? _contestProviderSlot2Id;
    private int? _contestProviderSlot3Id;

    private int PendingChangeCount => _pendingBatches.Sum(batch => batch.Changes.Count(change => change.Status == AiChangeStatus.Pending));
    private int ContestCandidateCount => _contestBatches.Sum(batch => batch.Candidates.Count);
    private int ContestHistoryBatchCount => _contestHistoryBatches.Count;
    private int ContestHistoryCandidateCount => _contestHistoryBatches.Sum(batch => batch.Candidates.Count);
    private bool ContestCanSend => !_contestEnabled || ContestProviderIds().Any();

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty) return;
        if (_loadedProjectId == ProjectId) return;

        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _conversation = await Chat.GetOrCreateAsync(ProjectId);
            _messages = (await Chat.LoadMessagesAsync(_conversation.Id)).ToList();
            _approvalEnabled = await Chat.GetAiChangeApprovalEnabledAsync(ProjectId);
            _providers = await ProviderService.GetAllAsync();
            var contestSettings = await Chat.GetContestSettingsAsync(ProjectId);
            _contestEnabled = contestSettings.Enabled;
            _contestProviderSlot1Id = contestSettings.ProviderSlot1Id;
            _contestProviderSlot2Id = contestSettings.ProviderSlot2Id;
            _contestProviderSlot3Id = contestSettings.ProviderSlot3Id;
            await LoadPendingChangesAsync(openIfPending: false);
            await LoadContestBatchesAsync(openIfAvailable: false);
            RebuildRenderable();
            _pendingUserText = null;
            _live = null;
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync()
    {
        var text = _input?.Trim();
        if (_running || string.IsNullOrEmpty(text)) return;
        if (!ContestCanSend)
        {
            _error = "Choose at least one Contest Mode model before sending.";
            return;
        }
        if (PendingChangeCount > 0)
        {
            _showPendingChanges = true;
            return;
        }

        _input = string.Empty;
        _running = true;
        _error = null;
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Id: Guid.NewGuid(),
            Role: ChatMessageRole.User,
            Status: ChatMessageStatus.Completed,
            Parts: [new ChatTextPart(text)]));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        if (OnAiTurnStarting.HasDelegate)
            await OnAiTurnStarting.InvokeAsync();

        try
        {
            await foreach (var update in Chat.SendAsync(ProjectId, CurrentChapterId, text, _cts.Token))
            {
                switch (update)
                {
                    case EditorChatTextDelta delta:
                        _live!.AppendText(delta.Text);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case EditorChatToolCallStarted started:
                        _live!.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case EditorChatToolCallArgumentsDelta delta:
                        _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case EditorChatToolCallCompleted completed:
                        _live!.CompleteToolCall(completed.CallId, completed.Result, completed.Error);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case EditorChatMutated:
                        if (OnAiChangesApplied.HasDelegate)
                            await OnAiChangesApplied.InvokeAsync();
                        break;

                    case EditorChatPendingAiChangeCreated:
                        await LoadPendingChangesAsync(openIfPending: false);
                        StateHasChanged();
                        break;

                    case EditorChatContestStarted:
                        await LoadContestBatchesAsync(openIfAvailable: true);
                        StateHasChanged();
                        break;

                    case EditorChatContestCandidateUpdated:
                        await LoadContestBatchesAsync(openIfAvailable: true);
                        StateHasChanged();
                        break;

                    case EditorChatContestCandidateJsonDelta delta:
                        ApplyContestCandidateRawResponseDelta(delta.CandidateId, delta.RawResponse);
                        StateHasChanged();
                        break;

                    case EditorChatContestCompleted:
                        await LoadContestBatchesAsync(openIfAvailable: true);
                        StateHasChanged();
                        break;

                    case EditorChatAssistantMessageCompleted:
                        await ReloadFromDbAsync();
                        await LoadPendingChangesAsync(openIfPending: true);
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case EditorChatTurnError error:
                        _error = error.Cancelled ? null : error.Message;
                        await ReloadFromDbAsync();
                        await LoadPendingChangesAsync(openIfPending: false);
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            _live = null;
            UpdateConversationTokenCount();
            _cts?.Dispose();
            _cts = null;
            if (OnAiTurnCompleted.HasDelegate)
                await OnAiTurnCompleted.InvokeAsync();
            RequestScroll();
            StateHasChanged();
        }
    }

    private void CancelAsync() => _cts?.Cancel();

    private async Task ResetAsync()
    {
        if (_running) return;
        await Chat.ResetAsync(ProjectId);
        _loadedProjectId = null;
        await LoadAsync();
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _messages = (await Chat.LoadMessagesAsync(_conversation.Id)).ToList();
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private async Task LoadPendingChangesAsync(bool openIfPending)
    {
        _pendingBatches = (await Chat.ListPendingChangesAsync(ProjectId)).ToList();
        if (openIfPending && PendingChangeCount > 0)
            _showPendingChanges = true;
        if (PendingChangeCount == 0)
            _showPendingChanges = false;
    }

    private async Task LoadContestBatchesAsync(bool openIfAvailable)
    {
        _contestBatches = (await Chat.ListCurrentContestBatchesAsync(ProjectId)).ToList();
        _contestHistoryBatches = (await Chat.ListContestHistoryAsync(ProjectId)).ToList();
        if (openIfAvailable && ContestCandidateCount > 0)
        {
            _showContestHistory = false;
            _showContestReview = true;
        }
        if (ContestCandidateCount == 0)
            _showContestReview = false;
        if (ContestHistoryCandidateCount == 0)
            _showContestHistory = false;
    }

    private void ApplyContestCandidateRawResponseDelta(Guid candidateId, string rawResponse)
    {
        var candidate = _contestBatches
            .SelectMany(batch => batch.Candidates)
            .FirstOrDefault(candidate => candidate.Id == candidateId);
        if (candidate is null) return;

        candidate.RawResponse = rawResponse;
        candidate.UpdatedAt = DateTime.UtcNow;
    }

    private async Task OnApprovalChangedAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        _approvalEnabled = enabled;
        await Chat.SetAiChangeApprovalEnabledAsync(ProjectId, enabled);
    }

    private async Task OnContestEnabledChangedAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        _contestEnabled = enabled;
        await Chat.SetContestModeEnabledAsync(ProjectId, enabled);
    }

    private async Task OnContestProviderChangedAsync(int slot, ChangeEventArgs args)
    {
        var providerId = int.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (int?)null;
        SetLocalContestProvider(slot, providerId);
        await Chat.SetContestProviderAsync(ProjectId, slot, providerId);
    }

    private void OpenPendingChanges() => _showPendingChanges = true;

    private void ClosePendingChanges() => _showPendingChanges = false;

    private void OpenContestReview()
    {
        _showContestHistory = false;
        _showContestReview = true;
    }

    private void CloseContestReview() => _showContestReview = false;

    private void OpenContestHistory()
    {
        _showContestReview = false;
        _showContestHistory = true;
    }

    private void CloseContestHistory() => _showContestHistory = false;

    private async Task HandlePendingChangesChangedAsync()
    {
        await LoadPendingChangesAsync(openIfPending: false);
        await ReloadFromDbAsync();
        if (OnAiChangesApplied.HasDelegate)
            await OnAiChangesApplied.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleContestChangedAsync()
    {
        await LoadContestBatchesAsync(openIfAvailable: false);
        await LoadPendingChangesAsync(openIfPending: true);
        _showContestReview = false;
        _showContestHistory = false;
        StateHasChanged();
    }

    private IEnumerable<int> ContestProviderIds()
    {
        if (_contestProviderSlot1Id is { } slot1) yield return slot1;
        if (_contestProviderSlot2Id is { } slot2) yield return slot2;
        if (_contestProviderSlot3Id is { } slot3) yield return slot3;
    }

    private void SetLocalContestProvider(int slot, int? providerId)
    {
        switch (slot)
        {
            case 1:
                _contestProviderSlot1Id = providerId;
                break;
            case 2:
                _contestProviderSlot2Id = providerId;
                break;
            case 3:
                _contestProviderSlot3Id = providerId;
                break;
        }
    }

    private RenderFragment RenderContestProviderSelect(int slot, int? selectedProviderId) => __builder =>
    {
        <select class="form-select form-select-sm editor-chat-contest-select"
                value="@(selectedProviderId?.ToString() ?? string.Empty)"
                disabled="@_running"
                @onchange="args => OnContestProviderChangedAsync(slot, args)">
            <option value="">Model @slot</option>
            @foreach (var provider in _providers)
            {
                <option value="@provider.Id">@(provider.DisplayName ?? provider.Name) - @provider.ModelId</option>
            }
        </select>
    };

    private void RebuildRenderable()
    {
        var byCallId = _messages
            .Where(message => message.Role == EditorMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<ChatRenderableMessage>(_messages.Count);
        foreach (var message in _messages)
        {
            if (message.Role is EditorMessageRole.Tool or EditorMessageRole.System) continue;

            _renderable.Add(new ChatRenderableMessage(
                Id: message.Id,
                Role: ToChatRole(message.Role),
                Status: ToChatStatus(message.Status),
                Parts: BuildMessageParts(message, byCallId)));
        }
    }

    private static ChatMessageRole ToChatRole(EditorMessageRole role) => role == EditorMessageRole.User
        ? ChatMessageRole.User
        : ChatMessageRole.Assistant;

    private static ChatMessageStatus ToChatStatus(EditorMessageStatus status) => status switch
    {
        EditorMessageStatus.Failed => ChatMessageStatus.Failed,
        EditorMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        EditorMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        var result = TokenCounter.Count(BuildConversationTokenText());
        _conversationTokenCount = result.TokenCount;
        _conversationTokenIsExact = result.IsExact;
    }

    private string BuildConversationTokenText()
    {
        var sb = new StringBuilder();
        foreach (var message in _messages)
            AppendMessageForTokenCount(sb, message);

        if (!string.IsNullOrWhiteSpace(_pendingUserText))
        {
            sb.AppendLine("User:");
            sb.AppendLine(_pendingUserText);
        }

        ChatTranscriptHelpers.AppendLiveTurnForTokenCount(sb, _live);
        return sb.ToString();
    }

    private static void AppendMessageForTokenCount(StringBuilder sb, EditorMessage message)
    {
        sb.Append(message.Role).AppendLine(":");
        if (!string.IsNullOrEmpty(message.Content))
            sb.AppendLine(message.Content);
        if (!string.IsNullOrWhiteSpace(message.ToolCallsJson) && message.ToolCallsJson != "[]")
        {
            sb.AppendLine("Tool calls:");
            sb.AppendLine(message.ToolCallsJson);
        }
        if (!string.IsNullOrWhiteSpace(message.ToolName) || !string.IsNullOrWhiteSpace(message.ToolCallId))
            sb.Append("Tool: ").Append(message.ToolName).Append(' ').AppendLine(message.ToolCallId);
        if (!string.IsNullOrWhiteSpace(message.ErrorMessage))
            sb.Append("Error: ").AppendLine(message.ErrorMessage);
    }

    private string ConversationTokenText() =>
        $"{TokenPrefix(_conversationTokenIsExact)}{_conversationTokenCount:N0} chat tokens";

    private string ConversationTokenTitle() => _conversationTokenIsExact
        ? "Current chat transcript token count"
        : "Current chat transcript token count is estimated";

    private static string TokenPrefix(bool isExact) => isExact ? string.Empty : "~";

    private static List<ChatMessagePart> BuildMessageParts(EditorMessage message, IReadOnlyDictionary<string, EditorMessage> byCallId)
    {
        if (message.Role != EditorMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls
                .Select((call, index) => new { Call = call, Index = index })
                .OrderBy(item => item.Call.TextOffset!.Value)
                .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));

            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls)
            parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, EditorMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        return new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMessage?.Status == EditorMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == EditorMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = resultMessage is not null,
        };
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force)
            _forceScrollKey++;
    }

    private Task ResumeAutoFollowAsync()
    {
        _autoFollowKey++;
        return Task.CompletedTask;
    }

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }
}