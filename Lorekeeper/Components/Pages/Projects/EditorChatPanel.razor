@using Lorekeeper.ChatTurns
@using Lorekeeper.Chapters
@using Lorekeeper.Context
@using Lorekeeper.EditorChat
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Lorekeeper.Manuscripts
@using Lorekeeper.Projects
@using Lorekeeper.Tokens
@implements IAsyncDisposable
@inject IEditorChatService Chat
@inject IEditorChatTurnRunner ChatTurns
@inject IChatImageAttachmentService ImageAttachments
@inject IContextBuilder ContextBuilder
@inject IProjectService Projects
@inject IChapterService Chapters
@inject ILlmProviderService ProviderService
@inject ITokenCounter TokenCounter
@inject ChatTokenLimitResolver TokenLimits
@inject ILogger<EditorChatPanel> Logger

<ChatSurface Title="Editor Chat"
             ProjectId="@ProjectId"
             Surface="ChatTurnSurface.Editor"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel, ConversationTokenLimit)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel, ConversationTokenLimit, ActiveModelId)"
             ShowTokenResetSuggestion="@_conversationTokens.ShouldSuggestReset(ConversationTokenLimit)"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Type a message..."
             Running="@_running"
             ComposerDisabled="@(ChatDisabled || _running || _resetting || ContestCandidateCount > 0)"
             SendDisabled="@(ChatDisabled || _resetting || string.IsNullOrWhiteSpace(_input) || ContestCandidateCount > 0 || !ContestCanSend)"
             ModelOptions="@_modelOptions"
             SelectedProviderId="@PickerSelectedProviderId"
             UnavailableModelLabel="@(_chatSelection?.Message ?? "No available chat models")"
             ModelPickerDisabled="@(_loading || _running || _resetting || ChatTurns.GetActiveTurn(ProjectId) is not null || ContestCandidateCount > 0)"
             OnModelChanged="OnModelChangedAsync"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
            <button type="button" class="btn btn-link btn-sm editor-chat-reset" title="Start over"
                    disabled="@(_loading || _running || _resetting || ContestCandidateCount > 0)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        @if (ChatDisabled)
        {
            <div class="alert alert-warning py-2 small mb-2">
                LLM chat is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
            </div>
        }
        <div class="editor-chat-controls">
            <div class="editor-chat-controls-row">
                <label class="editor-chat-contest-toggle" title="Use read-only chat preparation, then compare up to three model candidates in Review mode">
                    <input class="form-check-input" type="checkbox" checked="@_contestEnabled"
                           disabled="@(ChatDisabled || _running || ContestCandidateCount > 0)" @onchange="OnContestEnabledChangedAsync" />
                    <span>Contest Mode</span>
                </label>

                @if (ContestCandidateCount > 0)
                {
                    <button type="button" class="btn btn-link btn-sm editor-chat-pending" title="@ContestReviewTitle" @onclick="OpenContestReviewAsync">
                        @(HasRunningContest ? "Contest running" : "Contest review") @ContestCandidateCount
                    </button>
                }
            </div>
            @if (_contestEnabled)
            {
                <div class="editor-chat-contest-slots" aria-label="Contest models">
                    @RenderContestProviderSelect(1, _contestProviderSlot1Id)
                    @RenderContestProviderSelect(2, _contestProviderSlot2Id)
                    @RenderContestProviderSelect(3, _contestProviderSlot3Id)
                </div>
            }
        </div>
    </ExtraControls>
</ChatSurface>

@code {
    private const string ConversationTokenUnitLabel = "chat tokens";
    private const string ConversationTokenTitleLabel = "model input token count";

    private enum DeferredEditorChatWork
    {
        None,
        PromptTokens,
        ChatState,
        FullLoad,
    }

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Guid? CurrentChapterId { get; set; }
    [Parameter] public Guid? CurrentDesignedPageId { get; set; }
    [Parameter] public EditorContentTarget ContentTarget { get; set; } = EditorContentTarget.Core;
    [Parameter] public int ContextRefreshSignal { get; set; }
    [Parameter] public int ReviewRefreshSignal { get; set; }
    [Parameter] public EventCallback OnAiTurnStarting { get; set; }
    [Parameter] public EventCallback OnAiTurnCompleted { get; set; }
    [Parameter] public EventCallback OnAiTurnIdle { get; set; }
    [Parameter] public EventCallback OnWorkspaceChanged { get; set; }
    [Parameter] public EventCallback<EditorWorkspaceMutated> OnWorkspaceMutated { get; set; }
    [Parameter] public EventCallback OnContestStateChanged { get; set; }
    [Parameter] public EventCallback OnContestResultsReady { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;

    private EditorConversation? _conversation;
    private List<EditorMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;

    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private bool _resetting;
    private string? _error;
    private CancellationTokenSource? _listenCts;
    private Guid? _listeningTurnId;
    private Guid? _loadedProjectId;
    private Guid? _loadedChapterId;
    private EditorContentTarget _loadedContentTarget = EditorContentTarget.Core;
    private int _loadedContextRefreshSignal;
    private int _loadedReviewRefreshSignal;
    private DeferredEditorChatWork _deferredWork;
    private DeferredEditorChatWork _activeDeferredWork;
    private bool _deferredWorkRunning;
    private int _deferredWorkVersion;
    private CancellationTokenSource? _deferredWorkCts;
    private bool _disposed;
    private List<ContestBatch> _contestBatches = [];
    private List<LlmProvider> _providers = [];
    private string? _pendingUserText;
    private string _systemPrompt = string.Empty;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private bool _contestEnabled;
    private int? _contestProviderSlot1Id;
    private int? _contestProviderSlot2Id;
    private int? _contestProviderSlot3Id;
    private ChatProviderAvailability? _chatAvailability;
    private IReadOnlyList<ChatModelPickerOption> _modelOptions = [];
    private ChatModelSelection? _chatSelection;
    private int? _selectedProviderId;
    private ChatTurnModelSnapshot? _activeTurnModel;
    private IReadOnlyDictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>> _messageImages = new Dictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>>();

    private string? ActiveModelId => _activeTurnModel?.ModelId ?? _chatAvailability?.Provider?.ModelId;
    private int? ActiveMaxInputTokens => _activeTurnModel?.MaxInputTokens ?? _chatAvailability?.Provider?.EffectiveMaxInputTokens;
    private int ConversationTokenLimit => TokenLimits.Resolve(ActiveMaxInputTokens, ActiveModelId);
    private int ContestCandidateCount => _contestBatches.Sum(batch => batch.Candidates.Count);
    private bool HasRunningContest => _contestBatches.Any(batch => batch.Status == ContestBatchStatus.Running);
    private string ContestReviewTitle => HasRunningContest
        ? "Open the running Contest Mode review"
        : "Review Contest Mode candidates";
    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";
    private bool ContestCanSend => !_contestEnabled || ContestProviderIds().Any(IsWorkingProvider);

    protected override void OnParametersSet()
    {
        if (ProjectId == Guid.Empty) return;
        if (_loadedProjectId == ProjectId)
        {
            var chapterChanged = _loadedChapterId != CurrentChapterId;
            var refreshChatState = _loadedContentTarget != ContentTarget
                || _loadedContextRefreshSignal != ContextRefreshSignal
                || _loadedReviewRefreshSignal != ReviewRefreshSignal;
            _loadedChapterId = CurrentChapterId;
            _loadedContentTarget = ContentTarget;
            _loadedContextRefreshSignal = ContextRefreshSignal;
            _loadedReviewRefreshSignal = ReviewRefreshSignal;
            if (refreshChatState)
            {
                QueueDeferredWork(DeferredEditorChatWork.ChatState);
            }
            else if (chapterChanged)
            {
                QueueDeferredWork(DeferredEditorChatWork.PromptTokens);
            }
            return;
        }

        PrepareForFullLoad();
        _loadedProjectId = ProjectId;
        _loadedChapterId = CurrentChapterId;
        _loadedContentTarget = ContentTarget;
        _loadedContextRefreshSignal = ContextRefreshSignal;
        _loadedReviewRefreshSignal = ReviewRefreshSignal;
        QueueDeferredWork(DeferredEditorChatWork.FullLoad);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_deferredWork == DeferredEditorChatWork.None || _deferredWorkRunning || _disposed)
            return;

        _deferredWorkRunning = true;
        try
        {
            while (_deferredWork != DeferredEditorChatWork.None && !_disposed)
            {
                var work = _deferredWork;
                var version = _deferredWorkVersion;
                _deferredWork = DeferredEditorChatWork.None;
                _activeDeferredWork = work;

                _deferredWorkCts?.Dispose();
                using var cts = new CancellationTokenSource();
                _deferredWorkCts = cts;
                try
                {
                    if (work == DeferredEditorChatWork.FullLoad)
                    {
                        await LoadAsync(cts.Token);
                    }
                    else
                    {
                        await RefreshSystemPromptAsync(cts.Token);
                        UpdateConversationTokenCount();
                    }
                }
                catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
                catch (JSDisconnectedException) { }
                catch (Exception ex)
                {
                    if (work == DeferredEditorChatWork.PromptTokens)
                    {
                        Logger.LogWarning(
                            ex,
                            "Editor Chat token refresh failed. ProjectId={ProjectId}, ChapterId={ChapterId}",
                            ProjectId,
                            CurrentChapterId);
                    }
                    else if (version == _deferredWorkVersion)
                    {
                        Logger.LogError(
                            ex,
                            "Deferred Editor Chat load failed. ProjectId={ProjectId}, ChapterId={ChapterId}",
                            ProjectId,
                            CurrentChapterId);
                        _error = "Editor Chat could not be loaded. Check server logs for details.";
                        _loading = false;
                    }
                }
                finally
                {
                    if (ReferenceEquals(_deferredWorkCts, cts))
                        _deferredWorkCts = null;
                    _activeDeferredWork = DeferredEditorChatWork.None;
                }
            }
        }
        finally
        {
            _deferredWorkCts = null;
            _deferredWorkRunning = false;
        }

        if (!_disposed)
            StateHasChanged();
    }

    private void PrepareForFullLoad()
    {
        _conversation = null;
        _messages = [];
        _renderable = [];
        _live = null;
        _pendingUserText = null;
        _contestBatches = [];
        _providers = [];
        _chatAvailability = null;
        _modelOptions = [];
        _chatSelection = null;
        _selectedProviderId = null;
        _activeTurnModel = null;
        _systemPrompt = string.Empty;
        _conversationTokens = ChatTranscriptTokenCount.Empty;
        _running = false;
        _loading = true;
        _error = null;
    }

    private void QueueDeferredWork(DeferredEditorChatWork work)
    {
        if (work == DeferredEditorChatWork.None) return;
        if ((int)work > (int)_deferredWork)
            _deferredWork = work;
        if (_deferredWorkRunning && (int)work < (int)_activeDeferredWork)
            return;

        _deferredWorkVersion++;
        _deferredWorkCts?.Cancel();
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        await StopListeningAsync();
        _loading = true;
        try
        {
            _conversation = await Chat.GetOrCreateAsync(ProjectId, cancellationToken);
            _messages = (await Chat.LoadMessagesAsync(_conversation.Id, cancellationToken)).ToList();
            _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Editor, cancellationToken);
            _selectedProviderId = _conversation.SelectedProviderId;
            await LoadChatProviderStateAsync(cancellationToken);
            _providers = await ProviderService.ListWorkingChatProvidersAsync(cancellationToken);
            var contestSettings = await Chat.GetContestSettingsAsync(ProjectId, cancellationToken);
            _contestEnabled = contestSettings.Enabled;
            _contestProviderSlot1Id = contestSettings.ProviderSlot1Id;
            _contestProviderSlot2Id = contestSettings.ProviderSlot2Id;
            _contestProviderSlot3Id = contestSettings.ProviderSlot3Id;
            await RefreshSystemPromptAsync(cancellationToken);
            await LoadContestBatchesAsync(cancellationToken);
            var activeTurn = ChatTurns.GetActiveTurn(ProjectId);
            RebuildRenderable(activeTurn?.StartedAtUtc);
            if (activeTurn is not null)
            {
                _activeTurnModel = activeTurn.Model;
                IncludeActiveModelOption();
                _renderable.Add(new ChatRenderableMessage(
                    Id: Guid.NewGuid(),
                    Role: ChatMessageRole.User,
                    Status: ChatMessageStatus.Completed,
                    Parts: ChatImageParts.BuildUserParts(activeTurn.UserText, activeTurn.Images)));
                _pendingUserText = activeTurn.UserText;
                _live = new ChatLiveTurn();
                _running = true;
                if (OnAiTurnStarting.HasDelegate)
                    await OnAiTurnStarting.InvokeAsync();
                await ListenToActiveTurnAsync(activeTurn);
            }
            else
            {
                _activeTurnModel = null;
                _pendingUserText = null;
                _live = null;
                _running = false;
                if (OnAiTurnIdle.HasDelegate)
                    await OnAiTurnIdle.InvokeAsync();
            }
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync(ChatComposerSubmission submission)
    {
        var text = submission.Text.Trim();
        if (_running || string.IsNullOrEmpty(text)) return;
        if (ChatDisabled)
        {
            _error = ChatDisabledMessage;
            return;
        }
        if (!ContestCanSend)
        {
            _error = "Choose at least one Contest Mode model before sending.";
            return;
        }
        if (_contestBatches.Any(batch => batch.Status == ContestBatchStatus.Running))
        {
            await OpenContestReviewAsync();
            return;
        }
        if (ContestCandidateCount > 0)
        {
            await OpenContestReviewAsync();
            return;
        }
        if (_chatAvailability?.Provider is not { } provider)
        {
            _error = ChatDisabledMessage;
            return;
        }
        if (submission.Images.Count > 0
            && !await ProviderService.IsVisionProviderWorkingAsync(provider.Id))
        {
            _error = "The active chat provider has not passed the vision check. Run Test in Settings > Providers before sending images.";
            return;
        }

        var model = Snapshot(provider);
        _activeTurnModel = model;
        IncludeActiveModelOption();
        _input = string.Empty;
        _running = true;
        _error = null;
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Id: Guid.NewGuid(),
            Role: ChatMessageRole.User,
            Status: ChatMessageStatus.Completed,
            Parts: ChatImageParts.BuildUserParts(text, submission.Images)));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        var phase = "pre-turn editor flush/lock";
        async Task ReleaseTurnAsync()
        {
            ReleaseRunningUi();
            await NotifyAiTurnCompletedAsync();
        }

        try
        {
            if (OnAiTurnStarting.HasDelegate)
                await OnAiTurnStarting.InvokeAsync();

            phase = "starting editor chat turn";
            if (!ChatTurns.TryStart(ProjectId, CurrentChapterId, CurrentDesignedPageId, ContentTarget, text, submission.Images, model))
            {
                _error = "Editor chat already has a running turn.";
                if (ChatTurns.GetActiveTurn(ProjectId) is { } existingTurn)
                {
                    await ListenToActiveTurnAsync(existingTurn);
                }
                else
                {
                    await ReleaseTurnAsync();
                }
                return;
            }

            phase = "subscribing to editor chat turn";
            if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
                await ListenToActiveTurnAsync(activeTurn);
        }
        catch (OperationCanceledException)
        {
            _error = null;
            await ReleaseTurnAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Editor chat send failed during {Phase}. ProjectId={ProjectId}, ChapterId={ChapterId}",
                phase,
                ProjectId,
                CurrentChapterId);
            _error = phase == "pre-turn editor flush/lock"
                ? "Editor chat could not start because the editor draft could not be prepared. Check server logs for details."
                : "Editor chat failed unexpectedly. Check server logs for details.";
        }
        finally
        {
            await TryRunPostToolUiRefreshAsync("final prompt refresh", async () =>
            {
                await RefreshSystemPromptAsync();
                UpdateConversationTokenCount();
            });
            RequestScroll();
            StateHasChanged();
        }
    }

    private void CancelAsync() => ChatTurns.Cancel(ProjectId);

    private void ReleaseRunningUi()
    {
        var wasRunning = _running;
        var hadLive = _live is not null;
        _running = false;
        _live = null;
        _activeTurnModel = null;
        UpdateConversationTokenCount();
        RequestScroll();
        if (wasRunning || hadLive)
            StateHasChanged();
    }

    private async Task NotifyAiTurnCompletedAsync()
    {
        if (!OnAiTurnCompleted.HasDelegate)
            return;

        try
        {
            await OnAiTurnCompleted.InvokeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Editor chat cleanup failed after turn completion. ProjectId={ProjectId}, ChapterId={ChapterId}",
                ProjectId,
                CurrentChapterId);
        }
    }

    private async Task TryRunPostToolUiRefreshAsync(string phase, Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Editor chat UI refresh failed during {Phase}. ProjectId={ProjectId}, ChapterId={ChapterId}",
                phase,
                ProjectId,
                CurrentChapterId);
        }
    }

    private async Task ListenToActiveTurnAsync(ChatTurnSnapshot activeTurn)
    {
        if (_listeningTurnId == activeTurn.TurnId)
            return;

        _activeTurnModel = activeTurn.Model;
        IncludeActiveModelOption();
        UpdateConversationTokenCount();
        await StopListeningAsync();
        var subscription = ChatTurns.Subscribe(ProjectId);
        if (subscription is null)
        {
            await ReleaseTurnUiAsync();
            return;
        }

        _listeningTurnId = subscription.TurnId;
        _listenCts = new CancellationTokenSource();
        _ = ListenToTurnAsync(subscription, _listenCts.Token);
    }

    private Task StopListeningAsync()
    {
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        _listenCts = null;
        _listeningTurnId = null;
        return Task.CompletedTask;
    }

    private async Task ListenToTurnAsync(
        IChatTurnSubscription<EditorChatTurnUpdate> subscription,
        CancellationToken cancellationToken)
    {
        await using (subscription)
        {
            try
            {
                await foreach (var update in subscription.ReadAllAsync(cancellationToken))
                    await InvokeAsync(async () => await ApplyTurnUpdateAsync(update));
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ApplyTurnUpdateAsync(EditorChatTurnUpdate update)
    {
        switch (update)
        {
            case EditorChatTextDelta delta:
                LiveTurn().AppendText(delta.Text);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case EditorChatReasoningDelta reasoning:
                LiveTurn().AppendReasoning(reasoning.Text);
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatToolCallStarted started:
                LiveTurn().StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatToolCallArgumentsDelta delta:
                LiveTurn().AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatToolCallCompleted completed:
                LiveTurn().CompleteToolCall(
                    completed.CallId,
                    completed.Result,
                    completed.Error,
                    completed.DurationMs,
                    completed.Visuals.Select(ToChatImageVisual).ToList());
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatContextTrimmed trimmed:
                LiveTurn().ApplyContextTrim(
                    trimmed.Result.NewlyTombstonedCallIds,
                    trimmed.Result.CompletedRoundCallIds);
                UpdateConversationTokenCount();
                StateHasChanged();
                break;

            case EditorChatMutated:
                await TryRunPostToolUiRefreshAsync("editor mutation refresh", async () =>
                {
                    if (OnWorkspaceChanged.HasDelegate)
                        await OnWorkspaceChanged.InvokeAsync();
                    await RefreshSystemPromptAsync();
                    UpdateConversationTokenCount();
                    StateHasChanged();
                });
                break;

            case EditorWorkspaceMutated mutation:
                await TryRunPostToolUiRefreshAsync("targeted workspace refresh", async () =>
                {
                    if (OnWorkspaceMutated.HasDelegate)
                        await OnWorkspaceMutated.InvokeAsync(mutation);
                    else if (OnWorkspaceChanged.HasDelegate)
                        await OnWorkspaceChanged.InvokeAsync();
                    await RefreshSystemPromptAsync();
                    UpdateConversationTokenCount();
                    StateHasChanged();
                });
                break;

            case EditorChatContestStarted:
                await TryRunPostToolUiRefreshAsync("contest start refresh", async () =>
                {
                    await LoadContestBatchesAsync();
                    await NotifyContestStateChangedAsync();
                    StateHasChanged();
                });
                break;

            case EditorChatContestCandidateUpdated:
                await TryRunPostToolUiRefreshAsync("contest candidate refresh", async () =>
                {
                    await LoadContestBatchesAsync();
                    await NotifyContestStateChangedAsync();
                    StateHasChanged();
                });
                break;

            case EditorChatContestCandidateProseDelta delta:
                ApplyContestCandidateRawResponseDelta(delta.CandidateId, delta.RawResponse);
                StateHasChanged();
                break;

            case EditorChatContestCompleted:
                await TryRunPostToolUiRefreshAsync("contest completion refresh", async () =>
                {
                    await LoadContestBatchesAsync();
                    await NotifyContestStateChangedAsync();
                    StateHasChanged();
                });
                break;

            case EditorChatRevisionJobUpdated revision:
                LiveTurn().UpdateToolProgress(revision.ToolCallId, "start_revision_agents", ToChatToolProgress(revision.Progress));
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatImageGenerationJobUpdated imageGeneration:
                LiveTurn().UpdateToolProgress(imageGeneration.ToolCallId, LiveTurn().ToolNameFor(imageGeneration.ToolCallId) ?? "project image", ToChatToolProgress(imageGeneration));
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatAssistantMessageCompleted:
                await ReleaseTurnUiAsync();
                await TryRunPostToolUiRefreshAsync("assistant completion refresh", async () =>
                {
                    await ReloadFromDbAsync();
                    await LoadContestBatchesAsync();
                });
                RequestScroll();
                StateHasChanged();
                break;

            case EditorChatTurnError error:
                _error = error.Cancelled ? null : error.Message;
                await ReleaseTurnUiAsync();
                await TryRunPostToolUiRefreshAsync("turn error refresh", async () =>
                {
                    await ReloadFromDbAsync();
                    await LoadContestBatchesAsync();
                });
                RequestScroll();
                StateHasChanged();
                break;
        }
    }

    private async Task ReleaseTurnUiAsync()
    {
        ReleaseRunningUi();
        await NotifyAiTurnCompletedAsync();
    }

    private async Task ResetAsync()
    {
        if (_running || _resetting) return;
        _resetting = true;
        try
        {
            await Chat.ResetAsync(ProjectId);
            PrepareForFullLoad();
            QueueDeferredWork(DeferredEditorChatWork.FullLoad);
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _conversation = await Chat.GetOrCreateAsync(ProjectId);
        _selectedProviderId = _conversation.SelectedProviderId;
        await LoadChatProviderStateAsync();
        _messages = (await Chat.LoadMessagesAsync(_conversation.Id)).ToList();
        _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Editor);
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private async Task LoadContestBatchesAsync(CancellationToken cancellationToken = default)
    {
        _contestBatches = (await Chat.ListCurrentContestBatchesAsync(ProjectId, cancellationToken)).ToList();
    }

    private async Task NotifyContestStateChangedAsync()
    {
        if (OnContestStateChanged.HasDelegate)
            await OnContestStateChanged.InvokeAsync();
    }

    private void ApplyContestCandidateRawResponseDelta(Guid candidateId, string rawResponse)
    {
        var candidate = _contestBatches
            .SelectMany(batch => batch.Candidates)
            .FirstOrDefault(candidate => candidate.Id == candidateId);
        if (candidate is null) return;

        candidate.RawResponse = rawResponse;
        candidate.UpdatedAt = DateTime.UtcNow;
    }

    private async Task OnContestEnabledChangedAsync(ChangeEventArgs args)
    {
        if (ContestCandidateCount > 0)
            return;

        var enabled = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        _contestEnabled = enabled;
        await Chat.SetContestModeEnabledAsync(ProjectId, enabled);
        await RefreshSystemPromptAsync();
        UpdateConversationTokenCount();
    }

    private async Task OnContestProviderChangedAsync(int slot, ChangeEventArgs args)
    {
        if (ContestCandidateCount > 0)
            return;

        var providerId = int.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (int?)null;
        SetLocalContestProvider(slot, providerId);
        await Chat.SetContestProviderAsync(ProjectId, slot, providerId);
    }

    private async Task OpenContestReviewAsync()
    {
        if (ContestCandidateCount == 0) return;

        if (OnContestResultsReady.HasDelegate)
            await OnContestResultsReady.InvokeAsync();
    }

    private IEnumerable<int> ContestProviderIds()
    {
        if (_contestProviderSlot1Id is { } slot1) yield return slot1;
        if (_contestProviderSlot2Id is { } slot2) yield return slot2;
        if (_contestProviderSlot3Id is { } slot3) yield return slot3;
    }

    private void SetLocalContestProvider(int slot, int? providerId)
    {
        switch (slot)
        {
            case 1:
                _contestProviderSlot1Id = providerId;
                break;
            case 2:
                _contestProviderSlot2Id = providerId;
                break;
            case 3:
