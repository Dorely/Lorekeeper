@page "/projects/{Slug}/editor"
@page "/projects/{Slug}/editor/{ChapterId:guid}"
@rendermode InteractiveServer

<PageTitle>Editor</PageTitle>

<ProjectLayout Slug="@Slug" Tab="editor">
    <EditorContent ChapterId="@ChapterId" />
</ProjectLayout>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public Guid? ChapterId { get; set; }
}
