@using Lorekeeper.Models
@using Lorekeeper.SpeedReading
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ISpeedReadingService SpeedReadingService
@inject IJSRuntime JS

<div class="speed-read-overlay @DisplayClass()" role="dialog" aria-modal="true" aria-label="Speed reading">
    <header class="speed-read-hud">
        <span class="speed-read-hud-hint">Space pause · Left rewind · Up/Down speed · E edit · S settings · Esc exit</span>
        <div class="speed-read-hud-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleQuickSettingsAsync">Settings</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RequestEditAsync">Edit here</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RequestExitAsync">Exit</button>
        </div>
    </header>
    <div class="speed-read-stage" @ref="_stage"></div>
    @if (_quickSettingsOpen && _settings is not null)
    {
        <div class="speed-read-settings" role="dialog" aria-label="Speed reading quick settings">
            <h3>Speed reading</h3>
            @if (_settingsError is not null)
            {
                <div class="alert alert-danger" role="alert">@_settingsError</div>
            }
            <label class="form-label" for="speed-read-style">Style</label>
            <select id="speed-read-style" class="form-select form-select-sm" value="@_settings.Style"
                    @onchange="ChangeStyleAsync">
                <option value="@SpeedReadingSettings.ChunkStyle">Chunk pacing</option>
                <option value="@SpeedReadingSettings.RsvpStyle">RSVP</option>
            </select>
            <label class="form-label" for="speed-read-wpm">
                Speed: @_settings.ActiveWordsPerMinute words per minute
            </label>
            <input id="speed-read-wpm" type="range" class="form-range"
                   min="@SpeedReadingSettings.MinimumWordsPerMinute"
                   max="@SpeedReadingSettings.MaximumWordsPerMinute"
                   step="25" value="@_settings.ActiveWordsPerMinute"
                   @onchange="ChangeWpmAsync" />
            <div class="form-check">
                <input id="speed-read-auto-advance" type="checkbox" class="form-check-input"
                       checked="@_settings.AutoAdvance" @onchange="ChangeAutoAdvanceAsync" />
                <label class="form-check-label" for="speed-read-auto-advance">Auto-advance to the next chapter</label>
            </div>
            <button type="button" class="btn btn-sm btn-primary" @onclick="ToggleQuickSettingsAsync">Resume reading</button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SpeedReadingPlaylist Playlist { get; set; } = null!;
    [Parameter] public string DisplayMode { get; set; } = "paper";
    [Parameter] public int StartItem { get; set; }
    [Parameter] public EventCallback<int> Paused { get; set; }
    [Parameter] public EventCallback<int> EditRequested { get; set; }
    [Parameter] public EventCallback<int> Exited { get; set; }
    [Parameter] public EventCallback ChapterCompleted { get; set; }

    private ElementReference _stage;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<SpeedReadOverlay>? _dotnetRef;
    private SpeedReadingState? _settings;
    private SpeedReadingPlaylist? _loadedPlaylist;
    private bool _quickSettingsOpen;
    private string? _settingsError;
    private bool _disposed;

    protected override async Task OnInitializedAsync() =>
        _settings = await SpeedReadingService.GetAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _settings is null || ReferenceEquals(_loadedPlaylist, Playlist))
            return;

        try
        {
            if (_instance is null)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Pages/Projects/SpeedReadOverlay.razor.js");
                _dotnetRef ??= DotNetObjectReference.Create(this);
                _instance = await _module.InvokeAsync<IJSObjectReference>("create", _stage, _dotnetRef);
            }

            var startItem = ReferenceEquals(_loadedPlaylist, null) ? StartItem : 0;
            _loadedPlaylist = Playlist;
            await _instance.InvokeVoidAsync("start", Playlist, PlaybackOptions(), startItem);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Retry on the next render when the module is not ready yet.
        }
    }

    private object PlaybackOptions() => new
    {
        style = _settings!.Style,
        wpm = _settings.ActiveWordsPerMinute,
    };

    private string? DisplayClass() => DisplayMode switch
    {
        "dim" => "sr-dim",
        "night" => "sr-night",
        _ => "sr-paper",
    };

    [JSInvokable]
    public Task OnPausedAsync(int itemIndex) => Paused.InvokeAsync(itemIndex);

    [JSInvokable]
    public Task OnEditRequestedAsync(int itemIndex) => EditRequested.InvokeAsync(itemIndex);

    [JSInvokable]
    public Task OnExitedAsync(int itemIndex) => Exited.InvokeAsync(itemIndex);

    [JSInvokable]
    public Task OnChapterCompletedAsync() => ChapterCompleted.InvokeAsync();

    [JSInvokable]
    public async Task OnQuickSettingsToggledAsync(bool open)
    {
        await SetQuickSettingsAsync(open);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnWpmChangedAsync(int wordsPerMinute)
    {
        if (_settings is null)
            return;
        var updated = _settings.Style == SpeedReadingSettings.RsvpStyle
            ? _settings with { RsvpWordsPerMinute = wordsPerMinute }
            : _settings with { ChunkWordsPerMinute = wordsPerMinute };
        await SaveSettingsAsync(updated);
        StateHasChanged();
    }

    private Task ToggleQuickSettingsAsync() => SetQuickSettingsAsync(!_quickSettingsOpen);

    private async Task SetQuickSettingsAsync(bool open)
    {
        _quickSettingsOpen = open;
        if (_instance is null)
            return;
        try
        {
            await _instance.InvokeVoidAsync("openQuickSettings", open);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    private async Task RequestEditAsync() => await InvokeInstanceAsync("requestEdit");

    private async Task RequestExitAsync() => await InvokeInstanceAsync("requestExit");

    private async Task InvokeInstanceAsync(string method)
    {
        if (_instance is null)
            return;
        try
        {
            await _instance.InvokeVoidAsync(method);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    private async Task ChangeStyleAsync(ChangeEventArgs args)
    {
        if (_settings is null)
            return;
        var style = args.Value?.ToString() == SpeedReadingSettings.RsvpStyle
            ? SpeedReadingSettings.RsvpStyle
            : SpeedReadingSettings.ChunkStyle;
        await SaveSettingsAsync(_settings with { Style = style });
        await ApplyPlaybackOptionsAsync();
    }

    private async Task ChangeWpmAsync(ChangeEventArgs args)
    {
        if (_settings is null || !int.TryParse(args.Value?.ToString(), out var wordsPerMinute))
            return;
        var updated = _settings.Style == SpeedReadingSettings.RsvpStyle
            ? _settings with { RsvpWordsPerMinute = wordsPerMinute }
            : _settings with { ChunkWordsPerMinute = wordsPerMinute };
        await SaveSettingsAsync(updated);
        await ApplyPlaybackOptionsAsync();
    }

    private async Task ChangeAutoAdvanceAsync(ChangeEventArgs args)
    {
        if (_settings is null)
            return;
        await SaveSettingsAsync(_settings with { AutoAdvance = args.Value is true });
    }

    private async Task SaveSettingsAsync(SpeedReadingState updated)
    {
        try
        {
            var normalized = updated.Normalized();
            await SpeedReadingService.SaveAsync(normalized);
            _settings = normalized;
            _settingsError = null;
        }
        catch (Exception exception)
        {
            _settingsError = exception.Message;
        }
    }

    private async Task ApplyPlaybackOptionsAsync()
    {
        if (_instance is null || _settings is null)
            return;
        try
        {
            await _instance.InvokeVoidAsync("setOptions", PlaybackOptions());
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_instance is not null)
        {
            try
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }
        _dotnetRef?.Dispose();
    }
}
