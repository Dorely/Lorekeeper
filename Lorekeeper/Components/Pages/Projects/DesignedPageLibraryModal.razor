@using Lorekeeper.Authoring
@using Lorekeeper.Chapters
@using Lorekeeper.Composition
@using Lorekeeper.EditorChat
@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IDesignedPageService Pages
@inject IChapterService Chapters
@inject IManuscriptService Manuscripts
@inject IPublicationSectionService Sections
@inject DesignedPageLibraryPreviewService Previews
@inject IAuthoringMutationFence Fence
@inject IEditorContestMutationGuard ContestGuard
@inject IJSRuntime JS

<div class="page-library-backdrop" @ref="_root">
    <section class="page-library" role="dialog" aria-modal="true" aria-labelledby="page-library-title" tabindex="-1">
        <header class="page-library-header">
            <div><span class="page-library-eyebrow">@TargetLabel · @ChapterTitle</span><h2 id="page-library-title">Insert Page</h2><p>Choose a page for your chapter, or manage your reusable page library.</p></div>
            <button type="button" class="btn-close" aria-label="Close page library" disabled="@_busy" @onclick="CloseAsync"></button>
        </header>
        <div class="page-library-toolbar">
            <input type="search" class="form-control" aria-label="Search pages" placeholder="Search pages…" @bind="_query" @bind:event="oninput" />
            <select class="form-select" aria-label="Filter pages" @bind="_filter"><option value="all">All pages</option><option value="placed">Placed</option><option value="unplaced">Unplaced</option></select>
            <button type="button" class="btn btn-outline-secondary" disabled="@(_busy || _loading)" @onclick="ReloadAsync">Refresh</button>
            <button type="button" class="btn btn-outline-primary" disabled="@CannotMutate" @onclick="() => _creating = !_creating">New Page</button>
        </div>
        @if (_creating)
        {
            <form class="page-library-create" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                <label>Name<input class="form-control" @bind="_name" maxlength="200" required /></label>
                <label>Layout<select class="form-select" @bind="_layout"><option value="@DesignedPageLayoutMode.SinglePage">Single page</option><option value="@DesignedPageLayoutMode.FacingSpread">Facing spread</option></select></label>
                <button class="btn btn-primary" disabled="@(CannotMutate || string.IsNullOrWhiteSpace(_name))">Create page</button>
            </form>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger page-library-notice" role="alert">@_error</div>
        }
        @if (IsReadOnly)
        {
            <div class="page-library-notice" role="status">The Editor is currently read-only. You can browse pages; management and insertion are unavailable.</div>
        }
        <div class="page-library-body">
            <div class="page-library-results">
                @if (_loading)
                {
                    <p class="page-library-empty" role="status">Loading pages…</p>
                }
                else if (!FilteredPages.Any())
                {
                    <div class="page-library-empty"><h3>@(_pages.Count == 0 ? "Your page library is ready" : "No matching pages")</h3><p>@(_pages.Count == 0 ? "Create a single page or facing spread, then insert it into a chapter to begin editing." : "Try another search or filter.")</p></div>
                }
                else
                {
                    <div class="page-library-grid">
                        @foreach (var page in FilteredPages)
                        {
                            <article class="page-library-card @(_selectedId == page.Page.Id ? "selected" : null)" @key="page.Page.Id">
                                <button type="button" class="page-library-select" aria-pressed="@(_selectedId == page.Page.Id)" @onclick="() => _selectedId = page.Page.Id">
                                    <span class="page-library-artwork">
                                        @if (_previews.TryGetValue(page.Page.Id, out var preview))
                                        {
                                            <img src="@preview.Url" alt="@($"Preview of {page.Page.Name}")" />
                                        }
                                        else
                                        {
                                            <span>@(_previewErrors.ContainsKey(page.Page.Id) ? "Preview unavailable" : "Rendering preview…")</span>
                                        }
                                    </span>
                                    <span class="page-library-card-copy"><strong>@(page.Page.Name)</strong><span>@LayoutLabel(page) · @Placements(page.Page.Id).Count placement(s)</span></span>
                                </button>
                                @if (_previewErrors.TryGetValue(page.Page.Id, out var previewError))
                                {
                                    <div class="page-library-preview-error"><small>@previewError</small><button type="button" class="btn btn-sm btn-link" disabled="@_busy" @onclick="ReloadAsync">Retry previews</button></div>
                                }
                            </article>
                        }
                    </div>
                }
            </div>
            <aside class="page-library-details" aria-label="Selected page details">
                @if (Selected is { } selected)
                {
                    <h3>@selected.Page.Name</h3><span class="page-library-badge">@ScopeLabel(selected)</span>
                    @if (_previews.TryGetValue(selected.Page.Id, out var selectedPreview))
                    {
                        <p>@LayoutLabel(selected) · @($"{selectedPreview.Width / 72:0.##} × {selectedPreview.Height / 72:0.##} in")</p>
                    }
                    <p>@(string.IsNullOrWhiteSpace(selected.Content.AccessibilityDescription) ? "No accessibility description yet." : selected.Content.AccessibilityDescription)</p>
                    <p class="page-library-hint">This page is shared. Editing it updates its placements in this content target. Duplicate it to make an independent page.</p>
                    <div class="page-library-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@CannotMutate" @onclick="DuplicateAsync">Duplicate</button>
                        @if (Target.EditionId is not null && selected.Page.ScopeEditionId is null && !selected.IsInherited)
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@CannotMutate" @onclick="RequestReset">Use Core</button>
                        }
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(CannotMutate || selected.Page.PlacementReferences.Count != 0 || Placements(selected.Page.Id).Count != 0)" @onclick="RequestDelete">Delete unused page</button>
                    </div>
                    <h4>Placements</h4>
                    @if (!Placements(selected.Page.Id).Any(item => item.Container.Kind == DesignedPageContainerKind.Chapter))
                    {
                        <p class="page-library-hint">Insert into a chapter to edit.</p>
                    }
                    @foreach (var placement in Placements(selected.Page.Id))
                    {
                        <div class="page-library-placement" @key="placement.Key">
                            <small>@(placement.Container.Kind == DesignedPageContainerKind.Chapter ? "Chapter" : "Publication section")</small>
                            @if (placement.Container.Kind == DesignedPageContainerKind.Chapter)
                            {
                                <button type="button" class="btn btn-link p-0" disabled="@_busy" @onclick="() => OpenPlacement.InvokeAsync(placement)">@placement.Title</button>
                            }
                            else { <strong>@placement.Title</strong> }
                            <label>Move to<select class="form-select form-select-sm" value="@Destination(placement)" disabled="@CannotMutate" @onchange="e => _destinations[placement.Key] = e.Value?.ToString() ?? string.Empty"><option value="">Choose destination…</option>@foreach (var container in _containers.Where(item => item.Container != placement.Container)) { <option value="@container.Key">@container.Label</option> }</select></label>
                            <div class="page-library-actions"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CannotMutate || string.IsNullOrEmpty(Destination(placement)))" @onclick="() => MoveAsync(placement)">Move</button><button type="button" class="btn btn-sm btn-outline-danger" disabled="@CannotMutate" @onclick="() => RequestRemove(placement)">Remove</button></div>
                        </div>
                    }
                    @if (selected.Page.PlacementReferences.Any(item => item.EditionId != Target.EditionId))
                    {
                        <p class="page-library-hint">Also used in other content targets. Live placements in any target prevent deletion.</p>
                    }
                }
                else { <p class="page-library-hint">Select a page to see its details and placements.</p> }
            </aside>
        </div>
        <footer class="page-library-footer"><span>@InsertionLabel</span><div class="page-library-actions"><button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseAsync">Cancel</button><button type="button" class="btn btn-primary" disabled="@(CannotMutate || Selected is null)" @onclick="InsertAsync">Insert Page</button></div></footer>
    </section>
    <ConfirmationDialog IsOpen="@(_confirmation is not null)" Title="@(_confirmation ?? string.Empty)" Message="@_confirmationMessage" ConfirmLabel="Confirm" Destructive="true" Busy="_busy" OnConfirm="ConfirmAsync" OnCancel="CancelConfirmation" />
</div>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter] public string ChapterTitle { get; set; } = string.Empty;
    [Parameter] public EditorContentTarget Target { get; set; } = EditorContentTarget.Core;
    [Parameter] public string TargetLabel { get; set; } = "Core Book";
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public string InsertionLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback<Guid> Insert { get; set; }
    [Parameter] public EventCallback<LibraryPlacement> OpenPlacement { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    public sealed record LibraryPlacement(Guid PageId, string BlockId, DesignedPageContainer Container, string Title, long Revision)
    {
        public string Key => $"{Container.Kind}:{Container.Id}:{BlockId}";
    }
    private sealed record ContainerView(DesignedPageContainer Container, string Title, long Revision, int Count)
    {
        public string Key => $"{Container.Kind}:{Container.Id}";
        public string Label => $"{(Container.Kind == DesignedPageContainerKind.Chapter ? "Chapter" : "Section")}: {Title}";
    }
    private sealed record Preview(string Url, double Width, double Height);
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _focusHandle;
    private DotNetObjectReference<DesignedPageLibraryModal>? _self;
    private CancellationTokenSource _previewCancellation = new();
    private IReadOnlyList<DesignedPageView> _pages = [];
    private readonly List<ContainerView> _containers = [];
    private readonly List<LibraryPlacement> _placements = [];
    private readonly Dictionary<Guid, Preview> _previews = [];
    private readonly Dictionary<Guid, string> _previewErrors = [];
    private readonly Dictionary<string, string> _destinations = [];
    private Guid? _selectedId;
    private string _query = string.Empty;
    private string _filter = "all";
    private string _name = "Designed page";
    private DesignedPageLayoutMode _layout;
    private bool _loading = true;
    private bool _busy;
    private bool _creating;
    private bool _disposed;
    private string? _error;
    private string? _confirmation;
    private string _confirmationMessage = string.Empty;
    private Func<Task>? _confirmedAction;
    private bool CannotMutate => IsReadOnly || _busy || _loading;
    private DesignedPageView? Selected => _pages.FirstOrDefault(item => item.Page.Id == _selectedId);
    private IReadOnlyList<LibraryPlacement> Placements(Guid id) => _placements.Where(item => item.PageId == id).ToList();
    private IEnumerable<DesignedPageView> FilteredPages => _pages.Where(page =>
        (string.IsNullOrWhiteSpace(_query) || page.Page.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) || page.Content.AccessibilityDescription.Contains(_query, StringComparison.OrdinalIgnoreCase))
        && (_filter == "all" || (_filter == "placed") == (Placements(page.Page.Id).Count > 0)));
    private string ScopeLabel(DesignedPageView page) => page.Page.ScopeEditionId is not null ? "Release-only page" : page.IsInherited ? "Inherited from Core Book" : Target.EditionId is null ? "Core Book" : "Customized for this release";
    private static string LayoutLabel(DesignedPageView page)
    {
        try
        {
            var variant = page.Content.Variants.FirstOrDefault(item => item.Id == page.Content.ActiveVariantId);
            var scene = variant is null ? null : System.Text.Json.JsonSerializer.Deserialize<CompositionScene>(variant.SceneJson, ManuscriptCodec.JsonOptions);
            return scene?.Surface.Kind == CompositionSurfaceKind.FacingSpread ? "Facing spread" : scene is null ? "Layout unavailable" : "Single page";
        }
        catch (System.Text.Json.JsonException) { return "Layout unavailable"; }
    }
    protected override Task OnInitializedAsync() => ReloadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Projects/DesignedPageLibraryModal.razor.js");
        if (_disposed) { await module.DisposeAsync(); return; }
        _module = module;
        _self = DotNetObjectReference.Create(this);
        _focusHandle = await _module.InvokeAsync<IJSObjectReference>("attach", _root, _self);
        if (_disposed)
        {
            await _focusHandle.InvokeVoidAsync("dispose");
            await _focusHandle.DisposeAsync();
        }
    }
    private async Task ReloadAsync()
    {
        if (_disposed) return;
        _previewCancellation.Cancel();
        _previewCancellation.Dispose();
        _previewCancellation = new();
        _loading = true;
        _error = null;
        _previews.Clear();
        _previewErrors.Clear();
        try
        {
            await Fence.ExecuteAsync(new(ProjectId, [], "Read page library"), async (_, token) =>
            {
                _pages = await Pages.ListAsync(ProjectId, Target, token);
                _containers.Clear();
                _placements.Clear();
                foreach (var chapter in await Chapters.ListAsync(ProjectId))
                {
                    var snapshot = await Manuscripts.GetManuscriptAsync(Target, chapter.Id, token);
                    if (snapshot is not null) AddContainer(DesignedPageContainer.Chapter(chapter.Id), chapter.Title, snapshot.Revision, snapshot.Document);
                }
                foreach (var section in await Sections.ListAsync(new(ProjectId, Target.EditionId), token))
                    AddContainer(DesignedPageContainer.PublicationSection(section.Id), section.Title, section.Revision, section.Manuscript);
                return true;
            });
            if (_disposed) return;
            if (Selected is null) _selectedId = null;
            _ = RenderPreviewsAsync(_pages, _previewCancellation.Token);
        }
        catch (Exception exception) { _pages = []; _error = exception.Message; }
        finally { _loading = false; }
    }
    private void AddContainer(DesignedPageContainer container, string title, long revision, ManuscriptDocument document)
    {
        _containers.Add(new(container, title, revision, document.Content.Count));
        foreach (var block in document.Content.Where(item => item.Type == ManuscriptBlockType.DesignedPage && item.DesignedPageId is not null))
            _placements.Add(new(block.DesignedPageId!.Value, block.Id, container, title, revision));
    }
    private async Task RenderPreviewsAsync(IReadOnlyList<DesignedPageView> pages, CancellationToken token)
    {
        foreach (var page in pages)
        {
            if (token.IsCancellationRequested || _disposed) return;
            try
            {
                var preview = await Previews.RenderAsync(ProjectId, Target, page, token);
                if (token.IsCancellationRequested || _disposed) return;
                _previews[page.Page.Id] = new($"data:image/png;base64,{Convert.ToBase64String(preview.Data)}", preview.SurfaceWidthPoints, preview.SurfaceHeightPoints);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
            catch (Exception exception)
            {
                if (token.IsCancellationRequested || _disposed) return;
                _previewErrors[page.Page.Id] = exception.Message;
            }
            if (_disposed || token.IsCancellationRequested) return;
            await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
        }
    }
    private async Task MutateAsync(Func<Task> mutation)
    {
        if (CannotMutate) return;
        _busy = true;
        _error = null;
        try
        {
            await Fence.ExecuteAsync(new(ProjectId, [], "Manage page library"), async (_, token) =>
            {
                await ContestGuard.EnsureMutationAllowedAsync(ProjectId, token);
                await mutation();
                return true;
            });
            await Changed.InvokeAsync();
            await ReloadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }
    private Task CreateAsync() => MutateAsync(async () =>
    {
        var created = await Pages.CreateAsync(ProjectId, Target, _name.Trim(), new() { LayoutMode = _layout });
        _selectedId = created.Page.Id;
        _query = string.Empty;
        _filter = "all";
        _creating = false;
    });
    private Task DuplicateAsync() => Selected is { } page ? MutateAsync(async () =>
    {
        var copy = await Pages.DuplicateAsync(ProjectId, page.Page.Id, Target);
        _selectedId = copy.Page.Id;
        _query = string.Empty;
        _filter = "all";
    }) : Task.CompletedTask;
    private void RequestDelete()
    {
        if (Selected is not { } page || CannotMutate) return;
        Confirm("Delete this unused page?", "The page will be deleted and affected current-process Undo/Redo history cleared. Saved Git checkpoints are preserved.", async () => await Pages.DeleteAsync(ProjectId, page.Page.Id, clearAffectedHistory: true));
    }
    private void RequestReset()
    {
        if (Selected is not { } page || Target.EditionId is not { } edition || CannotMutate) return;
        Confirm("Use the Core page?", "This removes the release-specific content and layout. Every placement in this release will inherit Core again.", async () => { await Pages.ResetReleaseOverrideAsync(ProjectId, page.Page.Id, edition); });
    }
    private void RequestRemove(LibraryPlacement placement) => Confirm("Remove this placement?", "Only this occurrence is removed. The shared page remains in your library.", async () => { await Pages.RemovePlacementAsync(Target, ProjectId, placement.BlockId, placement.Container, placement.Revision); });
    private string Destination(LibraryPlacement placement) => _destinations.GetValueOrDefault(placement.Key, string.Empty);
    private Task MoveAsync(LibraryPlacement placement)
    {
        var destination = _containers.FirstOrDefault(item => item.Key == Destination(placement));
        return destination is null ? Task.CompletedTask : MutateAsync(async () => { await Pages.MovePlacementAsync(Target, ProjectId, placement.BlockId, placement.Container, placement.Revision, destination.Container, destination.Count, destination.Revision); });
    }
    private void Confirm(string title, string message, Func<Task> action)
    {
        if (CannotMutate) return;
        _confirmation = title;
        _confirmationMessage = message;
        _confirmedAction = action;
    }
    private Task ConfirmAsync()
    {
        var action = _confirmedAction;
        CancelConfirmation();
        return action is null ? Task.CompletedTask : MutateAsync(action);
    }
    private void CancelConfirmation() { _confirmation = null; _confirmedAction = null; }
    private async Task InsertAsync()
    {
        if (CannotMutate || Selected is not { } page) return;
        _busy = true;
        _error = null;
        try { await Insert.InvokeAsync(page.Page.Id); }
        catch (Exception exception) { _error = $"{exception.Message} Close and reopen Insert Page to capture a fresh insertion position."; }
        finally { _busy = false; }
    }
    [JSInvokable] public Task DismissAsync()
    {
        if (_confirmation is not null) { if (!_busy) CancelConfirmation(); StateHasChanged(); return Task.CompletedTask; }
        return CloseAsync();
    }
    private Task CloseAsync() => _busy ? Task.CompletedTask : Closed.InvokeAsync();
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _previewCancellation.Cancel();
        _previewCancellation.Dispose();
        if (_module is not null)
        {
            try
            {
                if (_focusHandle is not null)
                {
                    await _focusHandle.InvokeVoidAsync("dispose");
                    await _focusHandle.DisposeAsync();
                }
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
