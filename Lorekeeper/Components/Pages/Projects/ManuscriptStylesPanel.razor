@using Lorekeeper.Manuscripts
@using Lorekeeper.Models
@using Lorekeeper.Fonts
@inject IManuscriptStyleService Styles
@inject IProjectFontService Fonts

<div class="manuscript-styles-panel">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    <header class="manuscript-styles-header">
        <div>
            <strong>Reusable text styles</strong>
            <p>Format a paragraph in the editor and use <em>Save as style</em> for the fastest workflow. Create from scratch here when you need exact values.</p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartNew">
            Create from scratch
        </button>
    </header>
    @if (_showForm)
    {
    <div class="manuscript-style-form-card">
        <div class="manuscript-style-form">
        <label>Name <input class="form-control" @bind="_name" /></label>
        <label>
            Kind
            <select class="form-select" @bind="_kind">
                <option value="@ManuscriptStyleKind.Paragraph">Paragraph</option>
                <option value="@ManuscriptStyleKind.Character">Character</option>
            </select>
        </label>
        <label>
            Font family
            <select class="form-select" @bind="_fontFamilyKey">
                <option value="">Inherit</option>
                <option value="serif">Serif</option>
                <option value="sans">Sans serif</option>
                <option value="mono">Monospace</option>
                <optgroup label="Book fonts">
                    @foreach (var family in _fontFamilies)
                    {
                        <option value="@family.Key">@family.Name</option>
                    }
                </optgroup>
            </select>
        </label>
        <label>Font size (pt) <input class="form-control" type="number" min="1" max="288" step="0.5" @bind="_fontSizePoints" /></label>
        <label>Weight <input class="form-control" type="number" min="100" max="900" step="100" @bind="_fontWeight" /></label>
        <label>Line height <input class="form-control" type="number" min="0.1" max="5" step="0.05" @bind="_lineHeight" /></label>
        <label class="manuscript-style-check"><input type="checkbox" @bind="_italic" /> Italic</label>
        <label class="manuscript-style-check"><input type="checkbox" @bind="_smallCaps" /> Small caps</label>
        </div>
        @if (_kind == ManuscriptStyleKind.Paragraph)
        {
            <details class="manuscript-style-advanced">
                <summary>Paragraph spacing, indentation, and pagination</summary>
                <div class="manuscript-style-form">
            <label>Space before (pt) <input class="form-control" type="number" min="0" max="288" step="0.5" @bind="_spaceBeforePoints" /></label>
            <label>Space after (pt) <input class="form-control" type="number" min="0" max="288" step="0.5" @bind="_spaceAfterPoints" /></label>
            <label>Left indent (em) <input class="form-control" type="number" min="0" max="12" step="0.1" @bind="_leftIndentEm" /></label>
            <label>Right indent (em) <input class="form-control" type="number" min="0" max="12" step="0.1" @bind="_rightIndentEm" /></label>
            <label title="Use a negative value for a hanging indent.">First-line indent (em) <input class="form-control" type="number" min="-12" max="12" step="0.1" @bind="_firstLineIndentEm" /></label>
            <label>
                Alignment
                <select class="form-select" @bind="_textAlign">
                    <option value="">Inherit</option>
                    <option value="left">Left</option>
                    <option value="right">Right</option>
                    <option value="center">Center</option>
                    <option value="justify">Justify</option>
                </select>
            </label>
            <label><input type="checkbox" @bind="_keepWithNext" /> Keep with next in paginated output</label>
            <label><input type="checkbox" @bind="_startOnNewPage" /> Start on a new page</label>
                </div>
            </details>
        }
        <div class="manuscript-style-actions">
            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync">
                @(_editingId is null ? "Create style" : "Save changes")
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">Cancel</button>
        </div>
    </div>
    }
    @if (_styles.Count == 0)
    {
        <p class="manuscript-styles-empty">No saved styles yet. Style a paragraph once, then save it from the editor toolbar.</p>
    }
    else
    {
        <div class="manuscript-style-list">
        @foreach (var style in _styles)
        {
            <article class="manuscript-style-card" @key="style.Id">
                <div><strong>@style.Name</strong><span>@StyleSummary(style) · @UsageLabel(style)</span></div>
                <div class="manuscript-style-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(style)">Edit</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(style)">Delete</button>
                </div>
            </article>
        }
        </div>
    }
</div>

<ConfirmationDialog IsOpen="@(_pendingStyleSave is not null)"
                    Title="Update this shared Book Text Style?"
                    Message="@SharedStyleUpdateMessage"
                    ConfirmLabel="Update everywhere"
                    Busy="_confirmationBusy"
                    OnConfirm="ConfirmStyleSaveAsync"
                    OnCancel="CancelStyleSave" />

<ConfirmationDialog IsOpen="@(_pendingStyleDelete is not null)"
                    Title="Delete this Book Text Style?"
                    Message="@SharedStyleDeleteMessage"
                    ConfirmLabel="Delete style"
                    Destructive="true"
                    Busy="_confirmationBusy"
                    OnConfirm="ConfirmStyleDeleteAsync"
                    OnCancel="CancelStyleDelete" />

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public Func<Task<bool>>? BeforeChange { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private List<ManuscriptStyleView> _styles = [];
    private IReadOnlyList<ProjectFontFamilyView> _fontFamilies = [];
    private IReadOnlyDictionary<Guid, int> _usageCounts = new Dictionary<Guid, int>();
    private Guid? _loadedProjectId;
    private Guid? _editingId;
    private long? _expectedRevision;
    private string _name = string.Empty;
    private ManuscriptStyleKind _kind = ManuscriptStyleKind.Paragraph;
    private string _semanticRole = string.Empty;
    private string? _fontFamilyKey;
    private double? _fontSizePoints;
    private int? _fontWeight;
    private double? _lineHeight;
    private bool _italic;
    private bool _smallCaps;
    private double? _spaceBeforePoints;
    private double? _spaceAfterPoints;
    private bool _keepWithNext;
    private string? _textAlign;
    private double? _leftIndentEm;
    private double? _rightIndentEm;
    private double? _firstLineIndentEm;
    private bool _startOnNewPage;
    private string? _error;
    private bool _showForm;
    private ManuscriptStyleInput? _pendingStyleSave;
    private ManuscriptStyleView? _pendingStyleDelete;
    private bool _confirmationBusy;

    private string SharedStyleUpdateMessage => _pendingStyleSave?.Id is Guid styleId
        ? $"This style is used {_usageCounts.GetValueOrDefault(styleId)} time(s) across Core Book and release content. Saving changes updates every use."
        : string.Empty;

    private string SharedStyleDeleteMessage => _pendingStyleDelete is { } style
        ? _usageCounts.GetValueOrDefault(style.Id) > 0
            ? $"'{style.Name}' is used {_usageCounts[style.Id]} time(s) across Core Book and release content. Deleting it removes the reusable style definition."
            : $"Delete the reusable style '{style.Name}'?"
        : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId)
            return;
        _loadedProjectId = ProjectId;
        _fontFamilies = await Fonts.ListAsync(ProjectId);
        await ReloadAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            _error = null;
            if (BeforeChange is not null && !await BeforeChange())
            {
                _error = "Save the current manuscript draft before changing book styles.";
                return;
            }
            var input = BuildStyleInput();
            if (_editingId is Guid editingId
                && _usageCounts.GetValueOrDefault(editingId) > 0)
            {
                _pendingStyleSave = input;
                return;
            }
            await PersistStyleAsync(input);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _pendingStyleSave = null;
        }
    }

    private void Edit(ManuscriptStyleView style)
    {
        _showForm = true;
        _editingId = style.Id;
        _expectedRevision = style.Revision;
        _name = style.Name;
        _kind = style.Kind;
        _semanticRole = style.SemanticRole;
        _fontFamilyKey = style.Definition.FontFamilyKey;
        _fontSizePoints = style.Definition.FontSizePoints;
        _fontWeight = style.Definition.FontWeight;
        _lineHeight = style.Definition.LineHeight;
        _italic = style.Definition.Italic ?? false;
        _smallCaps = style.Definition.SmallCaps ?? false;
        _spaceBeforePoints = style.Definition.SpaceBeforePoints;
        _spaceAfterPoints = style.Definition.SpaceAfterPoints;
        _keepWithNext = style.Definition.KeepWithNext ?? false;
        _textAlign = style.Definition.TextAlign;
        _leftIndentEm = style.Definition.LeftIndentEm;
        _rightIndentEm = style.Definition.RightIndentEm;
        _firstLineIndentEm = style.Definition.FirstLineIndentEm;
        _startOnNewPage = style.Definition.StartOnNewPage ?? false;
    }

    private void RequestDelete(ManuscriptStyleView style)
    {
        _error = null;
        _pendingStyleDelete = style;
    }

    private async Task ConfirmStyleSaveAsync()
    {
        if (_pendingStyleSave is not { } input)
            return;
        _confirmationBusy = true;
        _error = null;
        try
        {
            await PersistStyleAsync(input);
            _pendingStyleSave = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _pendingStyleSave = null;
        }
        finally
        {
            _confirmationBusy = false;
        }
    }

    private void CancelStyleSave() => _pendingStyleSave = null;

    private async Task ConfirmStyleDeleteAsync()
    {
        if (_pendingStyleDelete is not { } style)
            return;
        _confirmationBusy = true;
        try
        {
            _error = null;
            if (BeforeChange is not null && !await BeforeChange())
            {
                _error = "Save the current manuscript draft before deleting a book style.";
                _pendingStyleDelete = null;
                return;
            }
            await Styles.DeleteAsync(ProjectId, style.Id, style.Revision);
            await ReloadAsync();
            await Changed.InvokeAsync();
            _pendingStyleDelete = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _pendingStyleDelete = null;
        }
        finally
        {
            _confirmationBusy = false;
        }
    }

    private void CancelStyleDelete() => _pendingStyleDelete = null;

    private ManuscriptStyleInput BuildStyleInput() => new(
        _editingId,
        _name,
        _kind,
        string.IsNullOrWhiteSpace(_semanticRole) ? ManuscriptStyleService.RoleFromName(_name) : _semanticRole,
        new ManuscriptStyleProperties(
            _fontFamilyKey,
            _fontSizePoints,
            _fontWeight,
            _italic,
            _smallCaps,
            _lineHeight,
            _kind == ManuscriptStyleKind.Paragraph ? _spaceBeforePoints : null,
            _kind == ManuscriptStyleKind.Paragraph ? _spaceAfterPoints : null,
            _kind == ManuscriptStyleKind.Paragraph ? _keepWithNext : null,
            _kind == ManuscriptStyleKind.Paragraph ? _textAlign : null,
            _kind == ManuscriptStyleKind.Paragraph ? _leftIndentEm : null,
            _kind == ManuscriptStyleKind.Paragraph ? _rightIndentEm : null,
            _kind == ManuscriptStyleKind.Paragraph ? _firstLineIndentEm : null,
            _kind == ManuscriptStyleKind.Paragraph ? _startOnNewPage : null),
        _expectedRevision);

    private async Task PersistStyleAsync(ManuscriptStyleInput input)
    {
        await Styles.UpsertAsync(ProjectId, input);
        ResetForm();
        await ReloadAsync();
        await Changed.InvokeAsync();
    }

    private async Task ReloadAsync()
    {
        _styles = (await Styles.ListAsync(ProjectId)).ToList();
        _usageCounts = await Styles.GetUsageCountsAsync(ProjectId);
    }

    private string UsageLabel(ManuscriptStyleView style)
    {
        var count = _usageCounts.GetValueOrDefault(style.Id);
        return count == 1 ? "used once" : $"used {count} times";
    }

    private void ResetForm()
    {
        _showForm = false;
        _editingId = null;
        _expectedRevision = null;
        _name = string.Empty;
        _kind = ManuscriptStyleKind.Paragraph;
        _semanticRole = string.Empty;
        _fontFamilyKey = null;
        _fontSizePoints = null;
        _fontWeight = null;
        _lineHeight = null;
        _italic = false;
        _smallCaps = false;
        _spaceBeforePoints = null;
        _spaceAfterPoints = null;
        _keepWithNext = false;
        _textAlign = null;
        _leftIndentEm = null;
        _rightIndentEm = null;
        _firstLineIndentEm = null;
        _startOnNewPage = false;
    }

    private void StartNew()
    {
        ResetForm();
        _showForm = true;
    }

    private static string StyleSummary(ManuscriptStyleView style)
    {
        var details = new List<string>
        {
            style.Kind == ManuscriptStyleKind.Paragraph ? "Paragraph style" : "Selected-text style",
        };
        if (style.Definition.FontFamilyKey is { } family) details.Add(family);
        if (style.Definition.FontSizePoints is { } size) details.Add($"{size:0.#} pt");
        if (style.Definition.TextAlign is { } alignment) details.Add(alignment);
        return string.Join(" · ", details);
    }
}
