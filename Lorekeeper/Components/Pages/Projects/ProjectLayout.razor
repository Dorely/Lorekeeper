@using Lorekeeper.Models
@using Lorekeeper.Projects
@using Lorekeeper.Search
@inject IProjectService Projects
@inject ISearchProviderService SearchProviders
@inject NavigationManager Nav

@if (_loading)
{
    <p class="text-muted"><em>Loading project…</em></p>
}
else if (Project is null)
{
    <div class="alert alert-warning">
        <strong>Project not found.</strong>
        <a href="/" class="alert-link ms-2">Back to projects</a>
    </div>
}
else
{
    <div class="project-shell">
        <div class="project-workspace-header">
            <div class="project-titlebar">
                <a href="/" class="project-back" aria-label="Back to projects">&larr;</a>
                <div class="project-identity">
                    <h1 class="project-title">@Project.Name</h1>
                </div>
            </div>

            <ul class="project-tabs" aria-label="Project sections">
                @foreach (var t in VisibleTabs)
                {
                    <li class="nav-item">
                        <a class="nav-link @(string.Equals(t.Key, Tab, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           href="/projects/@Project.Slug/@t.Key">@t.Label</a>
                    </li>
                }
            </ul>
        </div>

        <CascadingValue Value="Project">
            <div class="project-body">
                @ChildContent
            </div>
        </CascadingValue>
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("editor", "Editor"),
        ("outline", "Outline"),
        ("writing-sample", "Writing Sample"),
        ("images", "Images"),
        ("publish", "Publish"),
        ("research", "Research"),
        ("ingest", "Ingest"),
        ("graph", "Graph"),
        ("import-export", "Import / Export"),
        ("history", "History"),
    ];

    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string Tab { get; set; } = "editor";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public Project? Project { get; private set; }
    private bool _loading = true;
    private bool _researchEnabled;
    private string? _loadedSlug;

    private IEnumerable<(string Key, string Label)> VisibleTabs =>
        _researchEnabled ? Tabs : Tabs.Where(tab => tab.Key != "research");

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedSlug == Slug) return;
        _loading = true;
        Project = await Projects.GetBySlugAsync(Slug);
        _researchEnabled = await SearchProviders.HasActiveProviderAsync();
        _loadedSlug = Slug;
        _loading = false;
    }
}
