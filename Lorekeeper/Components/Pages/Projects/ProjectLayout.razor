@using Lorekeeper.Models
@using Lorekeeper.Projects
@using Lorekeeper.ExternalAccess
@using Lorekeeper.Authoring
@implements IDisposable
@inject IProjectService Projects
@inject NavigationManager Nav
@inject ExternalWorkspaceUiEvents ExternalEvents
@inject IAuthoringMutationFence AuthoringFence

@if (_loading)
{
    <div class="lk-empty-state" role="status"><span class="spinner-border spinner-border-sm"></span><span>Loading project…</span></div>
}
else if (Project is null)
{
    <div class="alert alert-warning">
        <strong>Project not found.</strong>
        <a href="/" class="alert-link ms-2">Back to projects</a>
    </div>
}
else
{
    <div class="project-shell">
        <div class="project-workspace-header">
            <div class="project-titlebar">
                <a href="/" class="project-back" aria-label="Back to projects">&larr;</a>
                <div class="project-identity">
                    <h1 class="project-title">@Project.Name</h1>
                </div>
            </div>

            <ul class="project-tabs" aria-label="Project sections">
                @foreach (var t in Tabs)
                {
                    <li class="nav-item">
                        <a class="nav-link @(string.Equals(t.Key, Tab, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           href="/projects/@Project.Slug/@t.Key">@t.Label</a>
                    </li>
                }
            </ul>
        </div>

        <CascadingValue Value="Project">
            <div class="project-body">
                @if (_externalChanges)
                {
                    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
                        <span>An external agent saved project changes.</span>
                        <button class="btn btn-sm btn-outline-primary" disabled="@_refreshing" @onclick="RefreshExternalAsync">Refresh workspace</button>
                        @if (_refreshError is not null) { <span>@_refreshError</span> }
                    </div>
                }
                @ChildContent
            </div>
        </CascadingValue>
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("editor", "Editor"),
        ("outline", "Outline"),
        ("voice", "Voice"),
        ("images", "Images"),
        ("publish", "Publish"),
        ("world", "World"),
        ("sources", "Sources"),
        ("graph", "Graph"),
        ("import-export", "Import / Export"),
        ("history", "History"),
    ];

    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string Tab { get; set; } = "editor";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public Project? Project { get; private set; }
    private bool _loading = true;
    private string? _loadedSlug;
    private bool _externalChanges, _refreshing, _disposed;
    private string? _refreshError;

    protected override void OnInitialized() => ExternalEvents.ProjectChanged += OnExternalChanged;

    private async void OnExternalChanged(Guid projectId)
    {
        if (_disposed || Project?.Id != projectId) return;
        try { await InvokeAsync(() => { if (!_disposed) { _externalChanges = true; StateHasChanged(); } }); }
        catch (Exception exception) when (exception is ObjectDisposedException or OperationCanceledException or InvalidOperationException) { }
    }

    private async Task RefreshExternalAsync()
    {
        if (Project is null || _refreshing) return;
        _refreshing = true;
        _refreshError = null;
        try
        {
            await AuthoringFence.ExecuteAsync(new(Project.Id, [], "save visible work before refreshing external changes"),
                (_, _) => Task.FromResult(true));
            Nav.Refresh(forceReload: true);
        }
        catch (AuthoringMutationFenceException) { _refreshError = "Finish saving visible changes, then refresh again. Your work is retained."; }
        finally { _refreshing = false; }
    }

    public void Dispose() { _disposed = true; ExternalEvents.ProjectChanged -= OnExternalChanged; }

    protected override async Task OnParametersSetAsync()
    {
        // Enhanced navigation waits for the server prerender before switching
        // screens. Prerender only the loading shell so opening a project swaps
        // immediately; the project and every workspace tab load once interactive.
        if (!RendererInfo.IsInteractive || _loadedSlug == Slug) return;
        _loading = true;
        Project = await Projects.GetBySlugAsync(Slug);
        _loadedSlug = Slug;
        _loading = false;
    }
}
