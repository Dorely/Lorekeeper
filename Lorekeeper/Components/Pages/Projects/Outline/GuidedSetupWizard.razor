@using Lorekeeper.Outline

<div class="outline-wizard">
    <div class="outline-wizard-header">
        <h5 class="mb-0">Guided Setup</h5>
        <div class="outline-wizard-steps">
            <span class="step @(_step >= 1 ? "active" : "")">1. Premise</span>
            <span class="step-sep">›</span>
            <span class="step @(_step >= 2 ? "active" : "")">2. Elements</span>
            <span class="step-sep">›</span>
            <span class="step @(_step >= 3 ? "active" : "")">3. Generate</span>
        </div>
    </div>

    @if (_step == 1)
    {
        <div class="mb-3">
            <label class="form-label">What is your story about?</label>
            <textarea class="form-control" rows="3" placeholder="One or two sentences…"
                      @bind="_premise" @bind:event="oninput"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Tone (optional)</label>
            <div class="chip-row mb-2">
                @foreach (var sug in ToneSuggestions)
                {
                    <button type="button" class="chip @(IsToneSelected(sug) ? "selected" : "")"
                            @onclick="() => ToggleTone(sug)">@sug</button>
                }
            </div>
            <input class="form-control form-control-sm" placeholder="Or type your own (comma-separated)…"
                   @bind="_toneFreeform" @bind:event="oninput" />
        </div>

        <div class="mb-3">
            <label class="form-label">Scope</label>
            <div class="btn-group" role="group">
                @foreach (var s in Scopes)
                {
                    <input type="radio" class="btn-check" name="scope"
                           id="scope-@s" value="@s"
                           checked="@(_scope == s)"
                           @onchange="() => _scope = s" />
                    <label class="btn btn-outline-secondary btn-sm" for="scope-@s">@s</label>
                }
            </div>
        </div>
    }
    else if (_step == 2)
    {
        <div class="mb-3">
            <label class="form-label">Main characters (optional)</label>
            <div class="chip-row mb-2">
                @foreach (var c in _characters)
                {
                    <span class="chip selected">
                        @c
                        <button type="button" class="chip-remove" @onclick="() => RemoveCharacter(c)" title="Remove">×</button>
                    </span>
                }
            </div>
            <div class="input-group input-group-sm">
                <input class="form-control" placeholder="Add a character and press Enter…"
                       @bind="_characterDraft" @bind:event="oninput"
                       @onkeydown="OnCharacterKeyDown" />
                <button type="button" class="btn btn-outline-secondary" @onclick="AddCharacter">Add</button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Core conflict (optional)</label>
            <textarea class="form-control" rows="2" placeholder="What's the central tension?"
                      @bind="_conflict" @bind:event="oninput"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Setting (optional)</label>
            <input class="form-control" placeholder="Where does it take place?"
                   @bind="_setting" @bind:event="oninput" />
        </div>
    }
    else
    {
        <div class="mb-3">
            <p class="text-muted">Ready to generate. Review your inputs:</p>
            <dl class="row outline-wizard-summary">
                <dt class="col-sm-3">Premise</dt><dd class="col-sm-9">@_premise</dd>
                @if (!string.IsNullOrWhiteSpace(EffectiveTone))
                { <dt class="col-sm-3">Tone</dt><dd class="col-sm-9">@EffectiveTone</dd> }
                <dt class="col-sm-3">Scope</dt><dd class="col-sm-9">@_scope</dd>
                @if (_characters.Count > 0)
                { <dt class="col-sm-3">Characters</dt><dd class="col-sm-9">@string.Join(", ", _characters)</dd> }
                @if (!string.IsNullOrWhiteSpace(_conflict))
                { <dt class="col-sm-3">Conflict</dt><dd class="col-sm-9">@_conflict</dd> }
                @if (!string.IsNullOrWhiteSpace(_setting))
                { <dt class="col-sm-3">Setting</dt><dd class="col-sm-9">@_setting</dd> }
            </dl>
        </div>
    }

    <div class="outline-wizard-actions">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnCancel">Cancel</button>
        <div class="ms-auto d-flex gap-2">
            @if (_step > 1)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Back">Back</button>
            }
            @if (_step < 3)
            {
                <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanAdvance)" @onclick="Next">Continue</button>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanAdvance)" @onclick="GenerateAsync">Generate Outline</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<OutlineBrief> OnGenerate { get; set; }
    [Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

    private static readonly string[] ToneSuggestions = ["Gritty", "Political", "Epic", "Tragic", "Hopeful", "Comedic"];
    private static readonly string[] Scopes = ["Short", "Medium", "Long"];

    private int _step = 1;
    private string _premise = string.Empty;
    private readonly HashSet<string> _toneChips = new(StringComparer.OrdinalIgnoreCase);
    private string _toneFreeform = string.Empty;
    private string _scope = "Medium";
    private List<string> _characters = [];
    private string _characterDraft = string.Empty;
    private string _conflict = string.Empty;
    private string _setting = string.Empty;

    private string EffectiveTone
    {
        get
        {
            var parts = new List<string>(_toneChips);
            if (!string.IsNullOrWhiteSpace(_toneFreeform))
            {
                parts.AddRange(_toneFreeform.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
            }
            return string.Join(", ", parts.Distinct(StringComparer.OrdinalIgnoreCase));
        }
    }

    private bool CanAdvance => _step switch
    {
        1 => !string.IsNullOrWhiteSpace(_premise),
        _ => true,
    };

    private bool IsToneSelected(string tone) => _toneChips.Contains(tone);
    private void ToggleTone(string tone)
    {
        if (!_toneChips.Add(tone)) _toneChips.Remove(tone);
    }

    private void AddCharacter()
    {
        var c = (_characterDraft ?? string.Empty).Trim();
        if (c.Length > 0 && !_characters.Contains(c, StringComparer.OrdinalIgnoreCase))
            _characters.Add(c);
        _characterDraft = string.Empty;
    }

    private void RemoveCharacter(string c) => _characters.Remove(c);

    private void OnCharacterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCharacter();
    }

    private void Next() { if (CanAdvance && _step < 3) _step++; }
    private void Back() { if (_step > 1) _step--; }

    private async Task GenerateAsync()
    {
        var brief = new OutlineBrief(
            Premise: _premise.Trim(),
            Tone: string.IsNullOrWhiteSpace(EffectiveTone) ? null : EffectiveTone,
            Scope: _scope,
            MainCharacters: _characters.Count > 0 ? _characters.ToArray() : null,
            CoreConflict: string.IsNullOrWhiteSpace(_conflict) ? null : _conflict.Trim(),
            Setting: string.IsNullOrWhiteSpace(_setting) ? null : _setting.Trim());
        await OnGenerate.InvokeAsync(brief);
    }
}
