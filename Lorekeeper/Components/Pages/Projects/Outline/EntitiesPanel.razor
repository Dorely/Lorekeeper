@using Lorekeeper.Ingest
@using Lorekeeper.Models
@using Lorekeeper.Outline
@implements IAsyncDisposable
@inject IEntityService Entities
@inject IEntityTypeService EntityTypes
@inject IEntityVisualExampleService EntityVisuals
@inject IJSRuntime JS

<div class="entities-panel" @ref="_rootEl">
    <div class="entities-type-toolbar">
        @if (_creatingTypeDefinition)
        {
            <input type="text" class="form-control form-control-sm"
                   placeholder="New entity type"
                   @bind="_newTypeName" @bind:event="oninput"
                   @onkeydown="OnNewTypeKeyDownAsync" />
            <button type="button" class="btn btn-sm btn-primary"
                    disabled="@(string.IsNullOrWhiteSpace(_newTypeName))"
                    @onclick="ConfirmCreateTypeAsync">Create type</button>
            <button type="button" class="btn btn-sm btn-link" @onclick="CancelCreateType">Cancel</button>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-link" @onclick="StartCreateType">+ Type</button>
        }
    </div>

    @foreach (var sec in _sections)
    {
        <div class="entities-section">
            <div class="entities-section-header">
                <button type="button" class="entities-collapse"
                        @onclick="() => ToggleSection(sec.Type)">
                    <span class="caret">@(IsCollapsed(sec.Type) ? "▸" : "▾")</span>
                </button>
                <span class="entities-section-title">@sec.Plural</span>
                <span class="entities-section-count">@sec.Items.Count</span>
                <button type="button" class="btn btn-sm btn-link"
                        @onclick="() => StartCreateAsync(sec.Type)">+ Add</button>
            </div>

            @if (!IsCollapsed(sec.Type))
            {
                <div class="entities-list">
                    @if (sec.Items.Count == 0 && _creatingType != sec.Type)
                    {
                        <div class="text-muted small entities-empty">
                            <em>No @sec.Singular.ToLowerInvariant() yet.</em>
                        </div>
                    }

                    @if (_creatingType == sec.Type)
                    {
                        <div class="entities-item entities-item-new">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="@($"New {sec.Singular.ToLowerInvariant()} name")"
                                   @bind="_newName" @bind:event="oninput"
                                   @onkeydown="@(e => OnNewKeyDownAsync(e, sec.Type))" />
                            <div class="entities-actions mt-1">
                                <button type="button" class="btn btn-sm btn-primary"
                                        disabled="@(string.IsNullOrWhiteSpace(_newName))"
                                        @onclick="() => ConfirmCreateAsync(sec.Type)">Create</button>
                                <button type="button" class="btn btn-sm btn-link"
                                        @onclick="CancelCreate">Cancel</button>
                            </div>
                        </div>
                    }

                    @foreach (var e in sec.Items)
                    {
                        <div class="entities-item" @key="e.Id">
                            @if (_visuals.GetValueOrDefault(e.Id)?.FirstOrDefault() is { } leadingVisual)
                            {
                                <img class="entities-item-visual" src="@leadingVisual.Image.PreviewUrl" alt="@leadingVisual.Image.AltText" />
                            }
                            <button type="button" class="entities-item-name"
                                    @onclick="() => OpenModalAsync(e)">@e.Name</button>
                            @if (e.SourceEvidenceCount > 0)
                            {
                                <div class="entities-item-meta small">@e.SourceEvidenceCount source evidence@(PluralSuffix(e.SourceEvidenceCount))</div>
                            }
                            @if (_visuals.GetValueOrDefault(e.Id) is { Count: > 0 } entityVisuals)
                            {
                                <div class="entities-item-meta small">@entityVisuals.Count visual@(entityVisuals.Count == 1 ? string.Empty : "s")</div>
                            }
                            @if (EntitySubtitle(e) is { Length: > 0 } subtitle)
                            {
                                <div class="entities-item-sub text-muted small">@subtitle</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="entities-error alert alert-danger alert-dismissible mt-2">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }
</div>

@if (_modalEntity is not null)
{
    <div class="modal-backdrop fade show" @onclick="CloseModal"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" @onclick="CloseModal" @ref="_modalRootEl">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document"
             @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <div class="text-muted small entities-modal-type">@_modalEntity.Type</div>
                        <h5 class="modal-title">@_modalEntity.Name</h5>
                        @if (_modalEntity.Type == "Character")
                        {
                            <a href="@($"/projects/{Project.Slug}/voice?character={_modalEntity.Id}")">Edit voice profile</a>
                        }
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Name</label>
                        <input type="text" class="form-control" @bind="_editName" @bind:event="oninput" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Properties</label>
                        <div class="entities-modal-props">
                            @for (var i = 0; i < _editProps.Count; i++)
                            {
                                var idx = i;
                                <div class="entities-modal-prop-row">
                                    <input type="text" class="form-control form-control-sm entities-modal-prop-key"
                                           placeholder="key"
                                           value="@_editProps[idx].Key"
                                           @onchange="@(ev => UpdatePropKey(idx, (string?)ev.Value))" />
                                    <textarea class="form-control form-control-sm entities-modal-prop-val"
                                              data-autosize
                                              placeholder="value"
                                              rows="@RowsFor(_editProps[idx].Value)"
                                              @onchange="@(ev => UpdatePropVal(idx, (string?)ev.Value))">@_editProps[idx].Value</textarea>
                                    <button type="button" class="btn btn-sm btn-link text-danger entities-modal-prop-remove"
                                            @onclick="() => RemoveProp(idx)" title="Remove">×</button>
                                </div>
                            }
                            <button type="button" class="btn btn-sm btn-link" @onclick="AddPropRow">+ property</button>
                        </div>
                    </div>

                    <EntityKnowledgeView Summary="@_modalEntity.Summary"
                                         Aliases="@_modalEntity.Aliases"
                                         WikiSections="@_modalEntity.WikiSections"
                                         SourceEvidence="@_modalEntity.SourceEvidence" />

                    <div class="mb-3">
                        <EntityVisualExamples ProjectId="@ProjectId" EntityId="@_modalEntity.Id" Editable="true" />
                    </div>

                    <div class="mb-0">
                        <label class="form-label small text-muted">Links</label>
                        @if (_modalLinks.Count == 0)
                        {
                            <div class="text-muted small"><em>No graph links.</em></div>
                        }
                        else
                        {
                            <ul class="entities-modal-links list-unstyled mb-0">
                                @foreach (var link in _modalLinks)
                                {
                                    <li class="entities-modal-link">
                                        <span class="entities-modal-link-dir">
                                            @(link.Direction == EntityLinkDirection.Outgoing ? "→" : "←")
                                        </span>
                                        <span class="entities-modal-link-edge">@link.EdgeType</span>
                                        <span class="entities-modal-link-other">@link.OtherEntityName</span>
                                        <span class="entities-modal-link-type text-muted small">@link.OtherEntityType</span>
                                        @if (link.SourceEvidenceCount > 0)
                                        {
                                            <span class="entities-modal-link-badge">@link.SourceEvidenceCount source evidence@(PluralSuffix(link.SourceEvidenceCount))</span>
                                        }
                                        else if (link.IsIngestCreated)
                                        {
                                            <span class="entities-modal-link-badge">ingest</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(link.Summary) || link.RelationshipCitations.Count > 0)
                                        {
                                            <div class="entities-modal-link-observations">
                                                @if (!string.IsNullOrWhiteSpace(link.Summary))
                                                {
                                                    <div>@link.Summary</div>
                                                }
                                                @foreach (var citation in link.RelationshipCitations.Take(3))
                                                {
                                                    <div><strong>@citation.SourceTitle:</strong> @IngestWikiSheet.CitationPreview(citation)</div>
                                                }
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    @if (_modalConfirmDelete)
                    {
                        <button type="button" class="btn btn-danger me-auto" @onclick="() => ConfirmDeleteAsync(_modalEntity)">Confirm delete</button>
                        <button type="button" class="btn btn-link" @onclick="() => _modalConfirmDelete = false">Cancel delete</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link text-danger me-auto" @onclick="() => _modalConfirmDelete = true">Delete</button>
                    }
                    <button type="button" class="btn btn-link" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="() => SaveEditAsync(_modalEntity)">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public Project Project { get; set; } = null!;
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    /// <summary>Bumped by the parent every time the outline mutates so this panel re-reads.</summary>
    [Parameter] public int RefreshSignal { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private sealed class Section
    {
        public required string Type { get; init; }
        public required string Singular { get; init; }
        public required string Plural { get; init; }
        public List<StoryEntity> Items { get; set; } = [];
    }

    private List<Section> _sections = [];

    private readonly HashSet<string> _collapsed = [];
    private bool _creatingTypeDefinition;
    private string _newTypeName = string.Empty;
    private string? _creatingType;
    private string _newName = string.Empty;
    private string? _error;

    // Modal state
    private StoryEntity? _modalEntity;
    private IReadOnlyDictionary<Guid, IReadOnlyList<EntityVisualExampleView>> _visuals = new Dictionary<Guid, IReadOnlyList<EntityVisualExampleView>>();
    private string _editName = string.Empty;
    private List<KeyValuePair<string, string>> _editProps = [];
    private IReadOnlyDictionary<string, string?> _editOriginalProps = new Dictionary<string, string?>();
    private List<EntityLink> _modalLinks = [];
    private bool _modalConfirmDelete;
    private ElementReference _rootEl;
    private ElementReference _modalRootEl;
    private IJSObjectReference? _autoSizer;

    private Guid _lastProjectId;
    private int _lastSignal = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _autoSizer is null)
            await ImportAutoSizerAsync();

        if (_autoSizer is not null)
        {
            await RefreshAutoSizeAsync(_rootEl);
            if (_modalEntity is not null)
            {
                await RefreshAutoSizeAsync(_modalRootEl);
            }
        }
    }

    private async Task ImportAutoSizerAsync()
    {
        try
        {
            _autoSizer = await JS.InvokeAsync<IJSObjectReference>("import", "./js/autosizeTextareas.js");
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAutoSizeAsync(ElementReference root)
    {
        if (_autoSizer is null) return;

        try { await _autoSizer.InvokeVoidAsync("refresh", root); }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != _lastProjectId || RefreshSignal != _lastSignal)
        {
            _lastProjectId = ProjectId;
            _lastSignal = RefreshSignal;
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var definitions = await EntityTypes.ListAsync(ProjectId, includeStructural: false);
            _sections = definitions
                .Where(t => !t.IsChapterScoped)
                .OrderBy(t => t.SortOrder)
                .ThenBy(t => t.PluralLabel, StringComparer.OrdinalIgnoreCase)
                .Select(t => new Section
                {
                    Type = t.Type,
                    Singular = t.SingularLabel,
                    Plural = t.PluralLabel,
                })
                .ToList();

            foreach (var s in _sections)
            {
                var items = await Entities.ListAsync(ProjectId, s.Type);
                s.Items = items.OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase).ToList();
            }
            _visuals = await EntityVisuals.ListForEntitiesAsync(ProjectId, _sections.SelectMany(section => section.Items).Select(item => item.Id).ToList());
            // Drop the modal if the entity disappeared.
            if (_modalEntity is { } cur && !_sections.SelectMany(s => s.Items).Any(i => i.Id == cur.Id))
            {
                CloseModal();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private bool IsCollapsed(string type) => _collapsed.Contains(type);
    private void ToggleSection(string type)
    {
        if (!_collapsed.Add(type)) _collapsed.Remove(type);
    }

    // ---- type create ----------------------------------------------------

    private void StartCreateType()
    {
        _creatingTypeDefinition = true;
        _newTypeName = string.Empty;
    }

    private void CancelCreateType()
    {
        _creatingTypeDefinition = false;
        _newTypeName = string.Empty;
    }

    private async Task OnNewTypeKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmCreateTypeAsync();
        else if (e.Key == "Escape") CancelCreateType();
    }

    private async Task ConfirmCreateTypeAsync()
    {
        var name = _newTypeName.Trim();
        if (name.Length == 0) return;
        try
        {
            var created = await EntityTypes.CreateAsync(ProjectId, name);
            CancelCreateType();
            _collapsed.Remove(created.Type);
            await ReloadAsync();
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---- create ---------------------------------------------------------

    private void StartCreateAsync(string type)
    {
        _creatingType = type;
        _newName = string.Empty;
        _collapsed.Remove(type);
    }

    private void CancelCreate() { _creatingType = null; _newName = string.Empty; }

    private async Task OnNewKeyDownAsync(KeyboardEventArgs e, string type)
    {
        if (e.Key == "Enter") await ConfirmCreateAsync(type);
        else if (e.Key == "Escape") CancelCreate();
    }

    private async Task ConfirmCreateAsync(string type)
    {
        var name = _newName.Trim();
        if (name.Length == 0) return;
        try
        {
            await Entities.CreateAsync(ProjectId, type, name);
            CancelCreate();
            await ReloadAsync();
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---- modal ----------------------------------------------------------

    private async Task OpenModalAsync(StoryEntity e)
    {
        _modalEntity = e;
        _editName = e.Name;
        _editOriginalProps = e.Properties;
        _editProps = e.Properties
            .Select(kv => new KeyValuePair<string, string>(kv.Key, kv.Value ?? string.Empty))
            .ToList();
        _modalConfirmDelete = false;
        _modalLinks = [];
        try
        {
            var links = await Entities.ListLinksAsync(ProjectId, e.Id);
            _modalLinks = links.ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void CloseModal()
    {
        _modalEntity = null;
        _editName = string.Empty;
        _editProps = [];
        _modalLinks = [];
        _modalConfirmDelete = false;
    }

    private void AddPropRow() => _editProps.Add(new KeyValuePair<string, string>(string.Empty, string.Empty));
    private void RemoveProp(int idx) { if (idx >= 0 && idx < _editProps.Count) _editProps.RemoveAt(idx); }

    private void UpdatePropKey(int idx, string? value) =>
        _editProps[idx] = new KeyValuePair<string, string>(value ?? string.Empty, _editProps[idx].Value);
    private void UpdatePropVal(int idx, string? value) =>
        _editProps[idx] = new KeyValuePair<string, string>(_editProps[idx].Key, value ?? string.Empty);

    private static int RowsFor(string value) =>
        Math.Clamp(1 + value.Count(c => c == '\n'), 2, 10);

    private static string EntitySubtitle(StoryEntity entity)
    {
        if (!string.IsNullOrWhiteSpace(entity.Summary))
            return entity.Summary;
        if (entity.Properties.TryGetValue("description", out var description) && !string.IsNullOrWhiteSpace(description))
            return description;
        if (entity.Properties.TryGetValue("role", out var role) && !string.IsNullOrWhiteSpace(role))
            return role;

        return entity.WikiSections.Select(section => section.Body).FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))
            ?? string.Empty;
    }

    private static string PluralSuffix(int count) => count == 1 ? string.Empty : "s";

    private async Task SaveEditAsync(StoryEntity e)
    {
        try
        {
            // Build the new prop bag (skip blank keys).
            var next = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            foreach (var kv in _editProps)
            {
                var k = kv.Key.Trim();
                if (k.Length == 0) continue;
                next[k] = kv.Value;
            }

            // propertiesToSet = entries that are new or changed.
            var toSet = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            foreach (var (k, v) in next)
            {
                if (!_editOriginalProps.TryGetValue(k, out var old) || (old ?? string.Empty) != (v ?? string.Empty))
                    toSet[k] = v;
            }
            // propertiesToRemove = original keys missing from next.
            var toRemove = _editOriginalProps.Keys.Where(k => !next.ContainsKey(k)).ToList();

            var newName = _editName.Trim();
            await Entities.UpdateAsync(
                ProjectId,
                e.Id,
                name: newName.Length > 0 && newName != e.Name ? newName : null,
                propertiesToSet: toSet.Count > 0 ? toSet : null,
                propertiesToRemove: toRemove.Count > 0 ? toRemove : null);
            CloseModal();
            await ReloadAsync();
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ConfirmDeleteAsync(StoryEntity e)
    {
        try
        {
            await Entities.DeleteAsync(ProjectId, e.Id);
            CloseModal();
            await ReloadAsync();
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        if (_autoSizer is not null)
        {
            try { await _autoSizer.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }
    }
}
