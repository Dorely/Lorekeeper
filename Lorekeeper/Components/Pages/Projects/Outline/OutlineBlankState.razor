@using Lorekeeper.Models

<div class="outline-blank">
    <h5 class="mb-3">Story Outline</h5>
    <p class="text-muted mb-4">No outline yet. Choose how you'd like to start.</p>

    <div class="outline-blank-options">
        <button type="button" class="btn btn-primary outline-blank-option"
                @onclick="() => OnChoose.InvokeAsync(OutlineEntry.Guided)">
            <div class="outline-blank-option-title">Guided Setup</div>
            <div class="outline-blank-option-sub">Walk through a short wizard, then generate.</div>
        </button>

        <button type="button" class="btn btn-outline-primary outline-blank-option"
                @onclick="() => OnChoose.InvokeAsync(OutlineEntry.Quick)">
            <div class="outline-blank-option-title">Quick Generate</div>
            <div class="outline-blank-option-sub">Just give a one-line premise and go.</div>
        </button>

        <button type="button" class="btn btn-outline-secondary outline-blank-option"
                @onclick="() => OnChoose.InvokeAsync(OutlineEntry.Manual)">
            <div class="outline-blank-option-title">Build Manually</div>
            <div class="outline-blank-option-sub">Start with an empty outline tree.</div>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<OutlineEntry> OnChoose { get; set; }
}
