@using Lorekeeper.Models
@using Lorekeeper.Outline
@using Lorekeeper.Tokens
@implements IAsyncDisposable
@inject IOutlineCollaborationService Collab
@inject ITokenCounter TokenCounter

<ChatSurface Title="Outline Chat"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel)"
             Loading="@_loading"
             LoadingText="Loading..."
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Type a message..."
             Running="@_running"
             ComposerDisabled="@(_running || PendingChangeCount > 0)"
             SendDisabled="@(string.IsNullOrWhiteSpace(_input) || PendingChangeCount > 0)"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
            <button type="button" class="btn btn-link btn-sm outline-chat-reset" title="Start over"
                    disabled="@(_running || PendingChangeCount > 0)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        <div class="outline-chat-controls">
            <div class="outline-chat-controls-row">
                <label class="outline-chat-approval" title="Queue AI tool edits for review before applying them">
                    <input class="form-check-input" type="checkbox" checked="@_approvalEnabled"
                           disabled="@_running" @onchange="OnApprovalChangedAsync" />
                    <span>Review edits</span>
                </label>
                @if (PendingChangeCount > 0)
                {
                    <button type="button" class="btn btn-link btn-sm outline-chat-pending" @onclick="OpenPendingChanges">
                        Pending changes @PendingChangeCount
                    </button>
                }
            </div>
        </div>
    </ExtraControls>
</ChatSurface>

<PendingAiChangesModal ProjectId="@ProjectId"
                       Batches="@_pendingBatches"
                       IsOpen="@_showPendingChanges"
                       OnClose="ClosePendingChanges"
                       OnChanged="HandlePendingChangesChangedAsync" />

@code {
    private const string ConversationTokenUnitLabel = "conversation tokens";
    private const string ConversationTokenTitleLabel = "conversation token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback OnOutlineChanged { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;

    private OutlineConversation? _conversation;
    private List<OutlineMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;

    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private bool _approvalEnabled = true;
    private bool _showPendingChanges;
    private string? _error;
    private CancellationTokenSource? _cts;
    private Guid? _loadedProjectId;
    private List<AiChangeBatch> _pendingBatches = [];
    private string? _pendingUserText;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;

    private int PendingChangeCount => _pendingBatches.Sum(batch => batch.Changes.Count(change => change.Status == AiChangeStatus.Pending));

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty) return;
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _conversation = await Collab.GetOrCreateAsync(ProjectId);
            _messages = (await Collab.LoadMessagesAsync(_conversation.Id)).ToList();
            _approvalEnabled = await Collab.GetAiChangeApprovalEnabledAsync(ProjectId);
            await LoadPendingChangesAsync(openIfPending: false);
            RebuildRenderable();
            _pendingUserText = null;
            _live = null;
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync()
    {
        var text = _input?.Trim();
        if (string.IsNullOrEmpty(text) || _running) return;
        if (PendingChangeCount > 0)
        {
            _showPendingChanges = true;
            return;
        }

        _input = string.Empty;
        _running = true;
        _error = null;
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Id: Guid.NewGuid(),
            Role: ChatMessageRole.User,
            Status: ChatMessageStatus.Completed,
            Parts: [new ChatTextPart(text)]));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        try
        {
            await foreach (var update in Collab.SendAsync(ProjectId, text, _cts.Token))
            {
                switch (update)
                {
                    case TextDelta td:
                        _live!.AppendText(td.Text);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case ToolCallStarted ts:
                        _live!.StartToolCall(ts.CallId, ts.ToolName, ts.ArgumentsJson, ts.ArgumentsComplete);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case ToolCallArgumentsDelta delta:
                        _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case ToolCallCompleted tc:
                        _live!.CompleteToolCall(tc.CallId, tc.Result, tc.Error);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case OutlineMutated:
                        if (OnOutlineChanged.HasDelegate)
                            await OnOutlineChanged.InvokeAsync();
                        break;

                    case PendingAiChangeCreated:
                        await LoadPendingChangesAsync(openIfPending: true);
                        StateHasChanged();
                        break;

                    case AssistantMessageCompleted:
                        // Reload from DB so we render the canonical persisted state.
                        await ReloadFromDbAsync();
                        await LoadPendingChangesAsync(openIfPending: true);
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case TurnError err:
                        _error = err.Cancelled ? null : err.Message;
                        await ReloadFromDbAsync();
                        await LoadPendingChangesAsync(openIfPending: false);
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            _live = null;
            UpdateConversationTokenCount();
            _cts?.Dispose();
            _cts = null;
            RequestScroll();
            StateHasChanged();
        }
    }

    private void CancelAsync() => _cts?.Cancel();

    private async Task ResetAsync()
    {
        if (_running) return;
        await Collab.ResetAsync(ProjectId);
        _loadedProjectId = null; // force reload
        await LoadAsync();
        if (OnOutlineChanged.HasDelegate)
            await OnOutlineChanged.InvokeAsync();
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _messages = (await Collab.LoadMessagesAsync(_conversation.Id)).ToList();
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private async Task LoadPendingChangesAsync(bool openIfPending)
    {
        _pendingBatches = (await Collab.ListPendingChangesAsync(ProjectId)).ToList();
        if (openIfPending && PendingChangeCount > 0)
            _showPendingChanges = true;
        if (PendingChangeCount == 0)
            _showPendingChanges = false;
    }

    private async Task OnApprovalChangedAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        _approvalEnabled = enabled;
        await Collab.SetAiChangeApprovalEnabledAsync(ProjectId, enabled);
    }

    private void OpenPendingChanges() => _showPendingChanges = true;

    private void ClosePendingChanges() => _showPendingChanges = false;

    private async Task HandlePendingChangesChangedAsync()
    {
        await LoadPendingChangesAsync(openIfPending: false);
        await ReloadFromDbAsync();
        if (OnOutlineChanged.HasDelegate)
            await OnOutlineChanged.InvokeAsync();
        StateHasChanged();
    }

    private void RebuildRenderable()
    {
        // Group: user messages and assistant messages render as bubbles. Tool messages render
        // as result attachments to the chip in the assistant bubble that emitted the call.
        var byCallId = _messages
            .Where(m => m.Role == OutlineMessageRole.Tool && m.ToolCallId is not null)
            .ToDictionary(m => m.ToolCallId!, m => m);

        _renderable = new List<ChatRenderableMessage>(_messages.Count);
        foreach (var m in _messages)
        {
            if (m.Role == OutlineMessageRole.Tool) continue; // attached, not rendered standalone
            if (m.Role == OutlineMessageRole.System) continue;

            _renderable.Add(new ChatRenderableMessage(
                Id: m.Id,
                Role: ToChatRole(m.Role),
                Status: ToChatStatus(m.Status),
                Parts: BuildMessageParts(m, byCallId)));
        }
    }

    private static ChatMessageRole ToChatRole(OutlineMessageRole role) => role == OutlineMessageRole.User
        ? ChatMessageRole.User
        : ChatMessageRole.Assistant;

    private static ChatMessageStatus ToChatStatus(OutlineMessageStatus status) => status switch
    {
        OutlineMessageStatus.Failed => ChatMessageStatus.Failed,
        OutlineMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        OutlineMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            _messages,
            ToTokenMessage,
            _live,
            _pendingUserText,
            OutlineCollaborationService.CollaborationSystemPrompt);
    }

    private static ChatTranscriptTokenMessage ToTokenMessage(OutlineMessage message) => new(
        message.Role.ToString(),
        message.Content,
        message.ToolCallsJson,
        message.ToolCallId,
        message.ToolName,
        message.ErrorMessage);

    private static List<ChatMessagePart> BuildMessageParts(OutlineMessage message, IReadOnlyDictionary<string, OutlineMessage> byCallId)
    {
        if (message.Role != OutlineMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls
                .Select((call, index) => new { Call = call, Index = index })
                .OrderBy(item => item.Call.TextOffset!.Value)
                .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));

            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls)
            parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, OutlineMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMsg);
        return new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMsg?.Status == OutlineMessageStatus.Completed ? resultMsg.Content : null,
            Error = resultMsg?.Status == OutlineMessageStatus.Failed ? (resultMsg.ErrorMessage ?? resultMsg.Content) : null,
            Completed = resultMsg is not null,
        };
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force)
            _forceScrollKey++;
    }

    private Task ResumeAutoFollowAsync()
    {
        _autoFollowKey++;
        return Task.CompletedTask;
    }

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
