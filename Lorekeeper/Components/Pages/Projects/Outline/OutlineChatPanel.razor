@using Lorekeeper.ChatTurns
@using Lorekeeper.Components.Chat
@using Lorekeeper.Models
@using Lorekeeper.Llm
@using Lorekeeper.Outline
@using Lorekeeper.Tokens
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IOutlineCollaborationService Collab
@inject IOutlineChatTurnRunner ChatTurns
@inject IChatImageAttachmentService ImageAttachments
@inject ILlmProviderService Providers
@inject ITokenCounter TokenCounter
@inject ChatTokenLimitResolver TokenLimits

<ChatSurface Title="Outline Chat"
             ProjectId="@ProjectId"
             Surface="ChatTurnSurface.Outline"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel, ConversationTokenLimit)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel, ConversationTokenLimit, ActiveModelId)"
             ShowTokenResetSuggestion="@_conversationTokens.ShouldSuggestReset(ConversationTokenLimit)"
             Loading="@_loading"
             LoadingText="Loading..."
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Type a message..."
             Running="@_running"
             ComposerDisabled="@(ChatDisabled || _running || _resetting || PendingChangeCount > 0)"
             SendDisabled="@(ChatDisabled || _resetting || string.IsNullOrWhiteSpace(_input) || PendingChangeCount > 0)"
             ModelOptions="@_modelOptions"
             SelectedProviderId="@PickerSelectedProviderId"
             UnavailableModelLabel="@(_chatSelection?.Message ?? "No available chat models")"
             ModelPickerDisabled="@(_loading || _running || _resetting || ChatTurns.GetActiveTurn(ProjectId) is not null)"
             OnModelChanged="OnModelChangedAsync"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
            <button type="button" class="btn btn-link btn-sm outline-chat-reset" title="Start over"
                    disabled="@(_loading || _running || _resetting || PendingChangeCount > 0)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        @if (ChatDisabled)
        {
            <div class="alert alert-warning py-2 small mb-2">
                LLM chat is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
            </div>
        }
        <div class="outline-chat-controls">
            <div class="outline-chat-controls-row">
                <label class="outline-chat-approval" title="Queue AI changes to existing data for review before applying them">
                    <input class="form-check-input" type="checkbox" checked="@_approvalEnabled"
                           disabled="@(ChatDisabled || _running)" @onchange="OnApprovalChangedAsync" />
                    <span>Review edits</span>
                </label>
                @if (PendingChangeCount > 0)
                {
                    <button type="button" class="btn btn-link btn-sm outline-chat-pending" @onclick="OpenPendingChanges">
                        Pending changes @PendingChangeCount
                    </button>
                }
            </div>
        </div>
    </ExtraControls>
</ChatSurface>

<PendingAiChangesModal ProjectId="@ProjectId"
                       Batches="@_pendingBatches"
                       IsOpen="@_showPendingChanges"
                       OnClose="ClosePendingChanges"
                       OnChanged="HandlePendingChangesChangedAsync" />

@code {
    private const string ConversationTokenUnitLabel = "chat tokens";
    private const string ConversationTokenTitleLabel = "model input token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback OnOutlineChanged { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;

    private OutlineConversation? _conversation;
    private List<OutlineMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;

    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private bool _resetting;
    private bool _approvalEnabled;
    private bool _showPendingChanges;
    private string? _error;
    private CancellationTokenSource? _listenCts;
    private Guid? _listeningTurnId;
    private Guid? _loadedProjectId;
    private List<AiChangeBatch> _pendingBatches = [];
    private string? _pendingUserText;
    private string _systemPrompt = string.Empty;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private ChatProviderAvailability? _chatAvailability;
    private IReadOnlyList<ChatModelPickerOption> _modelOptions = [];
    private ChatModelSelection? _chatSelection;
    private int? _selectedProviderId;
    private ChatTurnModelSnapshot? _activeTurnModel;
    private IReadOnlyDictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>> _messageImages = new Dictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>>();

    private string? ActiveModelId => _activeTurnModel?.ModelId ?? _chatAvailability?.Provider?.ModelId;
    private int? PickerSelectedProviderId => _activeTurnModel?.ProviderId ?? _selectedProviderId ?? _chatSelection?.ProviderId;
    private int ConversationTokenLimit => TokenLimits.Resolve(ActiveModelId);
    private int PendingChangeCount => _pendingBatches.Sum(batch => batch.Changes.Count(change => change.Status is AiChangeStatus.Pending or AiChangeStatus.Conflict));
    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty) return;
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        StopListening();
        _loading = true;
        try
        {
            _conversation = await Collab.GetOrCreateAsync(ProjectId);
            _systemPrompt = await Collab.GetSystemPromptAsync(ProjectId);
            _selectedProviderId = _conversation.SelectedProviderId;
            await LoadChatProviderStateAsync();
            _messages = (await Collab.LoadMessagesAsync(_conversation.Id)).ToList();
            _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Outline);
            _approvalEnabled = await Collab.GetAiChangeApprovalEnabledAsync(ProjectId);
            await LoadPendingChangesAsync(openIfPending: false);
            var activeTurn = ChatTurns.GetActiveTurn(ProjectId);
            RebuildRenderable(activeTurn?.StartedAtUtc);
            if (activeTurn is not null)
            {
                _activeTurnModel = activeTurn.Model;
                IncludeActiveModelOption();
                _renderable.Add(new ChatRenderableMessage(
                    Id: Guid.NewGuid(),
                    Role: ChatMessageRole.User,
                    Status: ChatMessageStatus.Completed,
                    Parts: ChatImageParts.BuildUserParts(activeTurn.UserText, activeTurn.Images)));
                _pendingUserText = activeTurn.UserText;
                _live = new ChatLiveTurn();
                _running = true;
                await ListenToActiveTurnAsync(activeTurn);
            }
            else
            {
                _activeTurnModel = null;
                _pendingUserText = null;
                _live = null;
                _running = false;
            }
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync(ChatComposerSubmission submission)
    {
        var text = submission.Text.Trim();
        if (string.IsNullOrEmpty(text) || _running) return;
        if (ChatDisabled)
        {
            _error = ChatDisabledMessage;
            return;
        }
        if (PendingChangeCount > 0)
        {
            _showPendingChanges = true;
            return;
        }
        if (submission.Images.Count > 0
            && (_chatAvailability?.Provider is null
                || !await Providers.IsVisionProviderWorkingAsync(_chatAvailability.Provider.Id)))
        {
            _error = "The active chat provider has not passed the vision check. Run Test in Settings > Providers before sending images.";
            return;
        }

        if (_chatAvailability?.Provider is not { } provider)
        {
            _error = ChatDisabledMessage;
            return;
        }

        var model = Snapshot(provider);
        _activeTurnModel = model;
        IncludeActiveModelOption();
        _input = string.Empty;
        _running = true;
        _error = null;
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Id: Guid.NewGuid(),
            Role: ChatMessageRole.User,
            Status: ChatMessageStatus.Completed,
            Parts: ChatImageParts.BuildUserParts(text, submission.Images)));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        if (!ChatTurns.TryStart(ProjectId, text, submission.Images, model))
        {
            _error = "Outline Chat already has a running turn.";
            ReleaseRunningUi();
            if (ChatTurns.GetActiveTurn(ProjectId) is { } existingTurn)
                await ListenToActiveTurnAsync(existingTurn);
            return;
        }

        if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
            await ListenToActiveTurnAsync(activeTurn);
    }

    private async Task ListenToActiveTurnAsync(ChatTurnSnapshot activeTurn)
    {
        if (_listeningTurnId == activeTurn.TurnId)
            return;

        _activeTurnModel = activeTurn.Model;
        IncludeActiveModelOption();
        UpdateConversationTokenCount();
        StopListening();
        var subscription = ChatTurns.Subscribe(ProjectId);
        if (subscription is null)
        {
            ReleaseRunningUi();
            return;
        }

        _listeningTurnId = subscription.TurnId;
        _listenCts = new CancellationTokenSource();
        _ = ListenToTurnAsync(subscription, _listenCts.Token);
        await Task.CompletedTask;
    }

    private void StopListening()
    {
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        _listenCts = null;
        _listeningTurnId = null;
    }

    private async Task ListenToTurnAsync(
        IChatTurnSubscription<OutlineTurnUpdate> subscription,
        CancellationToken cancellationToken)
    {
        await using (subscription)
        {
            try
            {
                await foreach (var update in subscription.ReadAllAsync(cancellationToken))
                    await InvokeAsync(async () => await ApplyTurnUpdateAsync(update));
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ApplyTurnUpdateAsync(OutlineTurnUpdate update)
    {
        switch (update)
        {
            case TextDelta td:
                _live!.AppendText(td.Text);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ReasoningDelta reasoning:
                _live!.AppendReasoning(reasoning.Text);
                RequestScroll();
                StateHasChanged();
                break;


            case ToolCallStarted ts:
                _live!.StartToolCall(ts.CallId, ts.ToolName, ts.ArgumentsJson, ts.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case ToolCallArgumentsDelta delta:
                _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case ToolCallCompleted tc:
                _live!.CompleteToolCall(tc.CallId, tc.Result, tc.Error, tc.DurationMs);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case ContextTrimmed trimmed:
                _live!.ApplyContextTrim(
                    trimmed.Result.NewlyTombstonedCallIds,
                    trimmed.Result.CompletedRoundCallIds);
                UpdateConversationTokenCount();
                StateHasChanged();
                break;

            case OutlineMutated:
                if (OnOutlineChanged.HasDelegate)
                    await OnOutlineChanged.InvokeAsync();
                break;

            case PendingAiChangeCreated:
                await LoadPendingChangesAsync(openIfPending: true);
                StateHasChanged();
                break;

            case AssistantMessageCompleted:
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                await LoadPendingChangesAsync(openIfPending: true);
                RequestScroll();
                StateHasChanged();
                break;

            case TurnError err:
                _error = err.Cancelled ? null : err.Message;
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                await LoadPendingChangesAsync(openIfPending: false);
                RequestScroll();
                StateHasChanged();
                break;
        }
    }

    private void CancelAsync() => ChatTurns.Cancel(ProjectId);

    private void ReleaseRunningUi()
    {
        var wasRunning = _running;
        var hadLive = _live is not null;
        _running = false;
        _live = null;
        _activeTurnModel = null;
        UpdateConversationTokenCount();
        RequestScroll();
        if (wasRunning || hadLive)
            StateHasChanged();
    }

    private async Task ResetAsync()
    {
        if (_running || _resetting) return;
        _resetting = true;
        try
        {
            await Collab.ResetAsync(ProjectId);
            _loadedProjectId = null; // force reload
            await LoadAsync();
            if (OnOutlineChanged.HasDelegate)
                await OnOutlineChanged.InvokeAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _conversation = await Collab.GetOrCreateAsync(ProjectId);
        _selectedProviderId = _conversation.SelectedProviderId;
        await LoadChatProviderStateAsync();
        _messages = (await Collab.LoadMessagesAsync(_conversation.Id)).ToList();
        _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Outline);
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private async Task LoadPendingChangesAsync(bool openIfPending)
    {
        _pendingBatches = (await Collab.ListPendingChangesAsync(ProjectId)).ToList();
        if (openIfPending && PendingChangeCount > 0)
            _showPendingChanges = true;
        if (PendingChangeCount == 0)
            _showPendingChanges = false;
    }

    private async Task OnApprovalChangedAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        _approvalEnabled = enabled;
        await Collab.SetAiChangeApprovalEnabledAsync(ProjectId, enabled);
    }

    private void OpenPendingChanges() => _showPendingChanges = true;

    private void ClosePendingChanges() => _showPendingChanges = false;

    private async Task HandlePendingChangesChangedAsync()
    {
        await LoadPendingChangesAsync(openIfPending: false);
        await ReloadFromDbAsync();
        if (OnOutlineChanged.HasDelegate)
            await OnOutlineChanged.InvokeAsync();
        StateHasChanged();
    }

    private void RebuildRenderable(DateTime? excludeMessagesCreatedAtOrAfter = null)
    {
        var messages = excludeMessagesCreatedAtOrAfter is { } cutoff
            ? _messages.Where(message => message.CreatedAt < cutoff).ToList()
            : _messages;

        // Group: user messages and assistant messages render as bubbles. Tool messages render
        // as result attachments to the chip in the assistant bubble that emitted the call.
        var byCallId = messages
            .Where(m => m.Role == OutlineMessageRole.Tool && m.ToolCallId is not null)
            .ToDictionary(m => m.ToolCallId!, m => m);

        _renderable = new List<ChatRenderableMessage>(messages.Count);
        foreach (var m in messages)
        {
            if (m.Role == OutlineMessageRole.Tool) continue; // attached, not rendered standalone
            if (m.Role == OutlineMessageRole.System) continue;

            _renderable.Add(new ChatRenderableMessage(
                Id: m.Id,
                Role: ToChatRole(m.Role),
                Status: ToChatStatus(m.Status),
                Parts: BuildPartsWithImages(m, byCallId)));
        }
    }

    private async Task LoadChatProviderStateAsync()
    {
        _chatAvailability = await Collab.GetChatProviderAvailabilityAsync(ProjectId);
        _chatSelection = await Providers.ResolveChatModelSelectionAsync(_selectedProviderId);
        _modelOptions = (await Providers.ListChatModelOptionsAsync())
            .Select(option => new ChatModelPickerOption(option.ProviderId, option.ConnectionLabel, option.ModelLabel, option.IsDefault))
            .ToList();
    }

    private void IncludeActiveModelOption()
    {
        if (_activeTurnModel is not { } active
            || _modelOptions.Any(option => option.ProviderId == active.ProviderId))
            return;
        _modelOptions = _modelOptions
            .Append(new ChatModelPickerOption(active.ProviderId, "Active model", active.ModelId, IsDefault: false))
            .ToList();
    }

    private async Task OnModelChangedAsync(int? providerId)
    {
        if (_loading || _running || _resetting) return;
        if (ChatTurns.GetActiveTurn(ProjectId) is not null)
        {
            _error = "Outline Chat is still working in another window. Stop or wait for that turn before changing its model.";
            return;
        }
        try
        {
            await Collab.SetSelectedProviderAsync(ProjectId, providerId);
            _selectedProviderId = await Providers.NormalizeChatModelSelectionAsync(providerId);
            await LoadChatProviderStateAsync();
            UpdateConversationTokenCount();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private ChatTurnModelSnapshot Snapshot(LlmProvider provider) =>
        new(provider.Id, provider.ModelId, _chatSelection?.Label ?? $"{provider.DisplayName ?? provider.Name} · {provider.ModelId}");

    private List<ChatMessagePart> BuildPartsWithImages(OutlineMessage message, IReadOnlyDictionary<string, OutlineMessage> byCallId)
    {
        var parts = BuildMessageParts(message, byCallId);
        if (message.Role == OutlineMessageRole.Assistant && !string.IsNullOrWhiteSpace(message.Reasoning))
        {
            var reasoningPart = new ChatReasoningPart();
            reasoningPart.Append(message.Reasoning);
            parts.Insert(0, reasoningPart);
        }
        if (message.Role == OutlineMessageRole.User && _messageImages.TryGetValue(message.Id, out var images))
            ChatImageParts.Append(parts, images);
        return parts;
    }

    private static ChatMessageRole ToChatRole(OutlineMessageRole role) => role == OutlineMessageRole.User
        ? ChatMessageRole.User
        : ChatMessageRole.Assistant;

    private static ChatMessageStatus ToChatStatus(OutlineMessageStatus status) => status switch
    {
        OutlineMessageStatus.Failed => ChatMessageStatus.Failed,
        OutlineMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        OutlineMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            ChatTranscriptTokenCounter.ModelReplayMessages(
                _messages,
                message => message.Role.ToString(),
                message => message.Content),
            message => message,
            _live,
            _pendingUserText,
            _systemPrompt);
    }

    private static List<ChatMessagePart> BuildMessageParts(OutlineMessage message, IReadOnlyDictionary<string, OutlineMessage> byCallId)
    {
        if (message.Role != OutlineMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls
                .Select((call, index) => new { Call = call, Index = index })
                .OrderBy(item => item.Call.TextOffset!.Value)
                .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));

            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls)
            parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, OutlineMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMsg);
        return new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMsg?.Status == OutlineMessageStatus.Completed ? resultMsg.Content : null,
            Error = resultMsg?.Status == OutlineMessageStatus.Failed ? (resultMsg.ErrorMessage ?? resultMsg.Content) : null,
            Completed = resultMsg is not null,
        };
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force)
            _forceScrollKey++;
    }

    private Task ResumeAutoFollowAsync()
    {
        _autoFollowKey++;
        return Task.CompletedTask;
    }

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        StopListening();
        return ValueTask.CompletedTask;
    }
}
