@using Lorekeeper.Outline

<div class="outline-quick">
    <h5 class="mb-3">Quick Generate</h5>
    <p class="text-muted small">A short premise is all you need.</p>
    <textarea class="form-control mb-3" rows="3"
              placeholder="e.g. Thrall struggles to hold the Horde together as internal conflict rises."
              @bind="_premise" @bind:event="oninput"></textarea>

    <div class="d-flex justify-content-between">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnCancel">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm"
                disabled="@string.IsNullOrWhiteSpace(_premise)"
                @onclick="GenerateAsync">Generate</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<OutlineBrief> OnGenerate { get; set; }
    [Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

    private string _premise = string.Empty;

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_premise)) return;
        await OnGenerate.InvokeAsync(new OutlineBrief(_premise.Trim()));
    }
}
