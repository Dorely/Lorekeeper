@using Lorekeeper.Outline

<div class="outline-preview">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0">Proposed Outline</h5>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnRegenerate">Regenerate</button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="OnAccept">Accept</button>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="OnDiscard">Discard</button>
        </div>
    </div>

    @if (Outline is null || Outline.Acts.Count == 0)
    {
        <p class="text-muted"><em>(empty)</em></p>
    }
    else
    {
        <div class="outline-preview-acts">
            @for (var i = 0; i < Outline.Acts.Count; i++)
            {
                var act = Outline.Acts[i];
                <div class="outline-preview-act">
                    <div class="outline-preview-act-header">
                        <span class="outline-preview-act-num">Act @(i + 1)</span>
                        <strong>@act.Title</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(act.Synopsis))
                    {
                        <div class="outline-preview-act-synopsis text-muted small">@act.Synopsis</div>
                    }
                    <ol class="outline-preview-chapters">
                        @foreach (var ch in act.Chapters)
                        {
                            <li>
                                <strong>@ch.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(ch.Synopsis))
                                {
                                    <span class="text-muted"> — @ch.Synopsis</span>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public GeneratedOutline? Outline { get; set; }
    [Parameter, EditorRequired] public EventCallback OnAccept { get; set; }
    [Parameter, EditorRequired] public EventCallback OnRegenerate { get; set; }
    [Parameter, EditorRequired] public EventCallback OnDiscard { get; set; }
}
