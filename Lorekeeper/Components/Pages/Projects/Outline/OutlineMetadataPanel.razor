@using Lorekeeper.Models
@using Lorekeeper.Projects
@inject IProjectService Projects

@if (_fields.Count == 0 && !_addingNew)
{
    <div class="outline-meta outline-meta-empty">
        <span class="text-muted"><em>No project metadata yet. As you talk, key facts will appear here.</em></span>
        <button type="button" class="btn btn-sm btn-link" @onclick="StartAdd">+ Add field</button>
    </div>
}
else
{
    <div class="outline-meta">
        <div class="outline-meta-header">
            <button type="button" class="outline-meta-toggle" title="@(_blockCollapsed ? "Expand" : "Collapse")"
                    @onclick="() => _blockCollapsed = !_blockCollapsed">
                <span class="caret">@(_blockCollapsed ? "▸" : "▾")</span>
                <span class="outline-meta-title">Project metadata</span>
                <span class="outline-meta-count">@_fields.Count</span>
            </button>
            <button type="button" class="btn btn-sm btn-link" @onclick="StartAdd" disabled="@_addingNew">+ Add field</button>
        </div>
        @if (!_blockCollapsed)
        {
            <div class="outline-meta-list">
                @foreach (var f in _fields)
                {
                    var collapsed = _rowCollapsed.Contains(f.Key);
                    <div class="outline-meta-row @(collapsed ? "collapsed" : "")">
                        <div class="outline-meta-row-header">
                            <button type="button" class="outline-meta-row-toggle"
                                    @onclick="() => ToggleRow(f.Key)">
                                <span class="caret">@(collapsed ? "▸" : "▾")</span>
                                <span class="outline-meta-key">@PrettyKey(f.Key)</span>
                            </button>
                            @if (collapsed && !string.IsNullOrWhiteSpace(f.Value))
                            {
                                <span class="outline-meta-preview text-muted">@Preview(f.Value)</span>
                            }
                        </div>
                        @if (!collapsed)
                        {
                            <div class="outline-meta-row-body">
                                @if (_editing == f.Key)
                                {
                                    <textarea class="form-control form-control-sm"
                                              rows="@RowsFor(_editValue)"
                                              @bind="_editValue"
                                              @bind:event="oninput"></textarea>
                                    <div class="outline-meta-actions">
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => SaveAsync(f.Key)">Save</button>
                                        <button type="button" class="btn btn-sm btn-link" @onclick="CancelEdit">Cancel</button>
                                        <button type="button" class="btn btn-sm btn-link text-danger ms-auto" @onclick="() => DeleteAsync(f.Key)">Delete</button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="outline-meta-value" @onclick="() => StartEdit(f.Key, f.Value)">
                                        @if (string.IsNullOrWhiteSpace(f.Value))
                                        {
                                            <span class="text-muted"><em>(empty — click to edit)</em></span>
                                        }
                                        else
                                        {
                                            @f.Value
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_addingNew)
                {
                    <div class="outline-meta-row outline-meta-row-new">
                        <div class="outline-meta-row-header">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="key (e.g. outline.tone)"
                                   @bind="_newKey" @bind:event="oninput" />
                        </div>
                        <div class="outline-meta-row-body">
                            <textarea class="form-control form-control-sm" rows="2"
                                      placeholder="value"
                                      @bind="_newValue" @bind:event="oninput"></textarea>
                            <div class="outline-meta-actions">
                                <button type="button" class="btn btn-sm btn-primary"
                                        disabled="@(string.IsNullOrWhiteSpace(_newKey))"
                                        @onclick="AddNewAsync">Add</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="CancelAdd">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        @if (_error is not null)
        {
            <div class="outline-meta-error">@_error</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<KeyValuePair<string, string>> _fields = [];
    private string? _editing;
    private string _editValue = string.Empty;
    private bool _addingNew;
    private string _newKey = string.Empty;
    private string _newValue = string.Empty;
    private string? _error;
    private Guid _lastProjectId;
    private int _lastMetaSig;
    private bool _blockCollapsed;
    private readonly HashSet<string> _rowCollapsed = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        // Re-read whenever the cascading Project changes identity OR its metadata content changes
        // (the parent re-fetches the project after each tool call and passes a new instance).
        var sig = ComputeSig(Project.Metadata);
        if (Project.Id != _lastProjectId || sig != _lastMetaSig)
        {
            _lastProjectId = Project.Id;
            _lastMetaSig = sig;
            Rebuild();
            // Cancel any in-flight inline edit if the underlying value changed elsewhere.
            if (_editing is not null && !Project.Metadata.ContainsKey(_editing))
            {
                _editing = null;
            }
        }
    }

    private void Rebuild()
    {
        _fields = Project.Metadata
            .Select(kv => new KeyValuePair<string, string>(kv.Key, kv.Value?.ToString() ?? string.Empty))
            .OrderBy(kv => kv.Key.StartsWith("outline.") ? 0 : 1)
            .ThenBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static int ComputeSig(IDictionary<string, object?> meta)
    {
        var hc = new HashCode();
        foreach (var kv in meta.OrderBy(k => k.Key, StringComparer.Ordinal))
        {
            hc.Add(kv.Key);
            hc.Add(kv.Value?.ToString() ?? "");
        }
        return hc.ToHashCode();
    }

    private static string PrettyKey(string key)
    {
        var k = key.StartsWith("outline.") ? key[8..] : key;
        if (k.Length == 0) return key;
        return char.ToUpperInvariant(k[0]) + k[1..];
    }

    private static int RowsFor(string value) =>
        Math.Clamp(1 + value.Count(c => c == '\n'), 2, 8);

    private static string Preview(string value)
    {
        var s = value.Replace('\n', ' ').Replace('\r', ' ').Trim();
        return s.Length <= 80 ? s : s[..80] + "…";
    }

    private void ToggleRow(string key)
    {
        if (!_rowCollapsed.Add(key)) _rowCollapsed.Remove(key);
    }

    private void StartEdit(string key, string value)
    {
        _editing = key;
        _editValue = value;
        _error = null;
    }

    private void CancelEdit() { _editing = null; _editValue = string.Empty; }

    private void StartAdd() { _addingNew = true; _newKey = string.Empty; _newValue = string.Empty; _error = null; }
    private void CancelAdd() { _addingNew = false; }

    private async Task SaveAsync(string key)
    {
        try
        {
            await Projects.UpdateMetadataAsync(Project.Id,
                new Dictionary<string, object?> { [key] = _editValue });
            Project.Metadata[key] = _editValue;
            _editing = null;
            Rebuild();
            _lastMetaSig = ComputeSig(Project.Metadata);
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteAsync(string key)
    {
        try
        {
            Project.Metadata.Remove(key);
            // Replace (merge=false) with the new dict to truly remove the key.
            await Projects.UpdateMetadataAsync(Project.Id, Project.Metadata, merge: false);
            _editing = null;
            Rebuild();
            _lastMetaSig = ComputeSig(Project.Metadata);
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task AddNewAsync()
    {
        var key = _newKey.Trim();
        if (string.IsNullOrEmpty(key)) return;
        try
        {
            await Projects.UpdateMetadataAsync(Project.Id,
                new Dictionary<string, object?> { [key] = _newValue });
            Project.Metadata[key] = _newValue;
            _addingNew = false;
            Rebuild();
            _lastMetaSig = ComputeSig(Project.Metadata);
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
