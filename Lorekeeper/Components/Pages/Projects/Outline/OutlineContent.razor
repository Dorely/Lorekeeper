@using Lorekeeper.Chapters
@using Lorekeeper.Models
@using Lorekeeper.Outline
@using Lorekeeper.Persistence.Repositories
@inject IActService Acts
@inject IChapterService Chapters
@inject IProjectRepository ProjectRepo

@if (Project is null)
{
    <p class="text-muted"><em>Loading…</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading outline…</em></p>
}
else
{
    <div class="outline-pane">
        <div class="outline-pane-chat">
            <OutlineChatPanel ProjectId="@_workingProject!.Id" OnOutlineChanged="ReloadAsync" />
        </div>
        <div class="outline-pane-tree">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @_error
                    <button type="button" class="btn-close" @onclick="() => _error = null"></button>
                </div>
            }
            <OutlineTree Project="_workingProject"
                         Acts="_acts"
                         ChaptersByAct="_chaptersByAct"
                         Unassigned="_unassigned"
                         Focus="Focus"
                         RefreshSignal="@_refreshSignal"
                         OnChanged="ReloadAsync"
                         OnError="HandleError" />
        </div>
        <div class="outline-pane-side">
            <ProjectFactsPanel ProjectId="@_workingProject!.Id"
                               RefreshSignal="@_refreshSignal"
                               OnChanged="ReloadAsync" />
            <IngestSourcesPanel ProjectId="@_workingProject!.Id"
                                RefreshSignal="@_refreshSignal" />
            <EntitiesPanel ProjectId="@_workingProject!.Id"
                           RefreshSignal="@_refreshSignal"
                           OnChanged="ReloadAsync" />
        </div>
    </div>
}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [Parameter] public Guid? Focus { get; set; }

    private Project? _workingProject;
    private List<Act> _acts = [];
    private Dictionary<Guid, List<Chapter>> _chaptersByAct = [];
    private List<Chapter> _unassigned = [];
    private bool _loading = true;
    private string? _error;
    private Guid? _loadedProjectId;
    /// <summary>Bumped on every successful reload so child panels (entities, beats) re-read.</summary>
    private int _refreshSignal;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) return;
        if (_loadedProjectId == Project.Id) return;
        _loadedProjectId = Project.Id;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Project is null) return;
        _loading = _workingProject is null;
        try
        {
            // Re-fetch the project so tool-driven mutations that touch project state are reflected here.
            _workingProject = await ProjectRepo.GetByIdAsync(Project.Id) ?? Project;
            _acts = (await Acts.ListAsync(Project.Id)).ToList();
            var allChapters = (await Chapters.ListAsync(Project.Id)).ToList();
            _chaptersByAct = _acts.ToDictionary(
                a => a.Id,
                a => allChapters.Where(c => c.ActId == a.Id).OrderBy(c => c.Order).ToList());
            _unassigned = allChapters.Where(c => c.ActId is null).OrderBy(c => c.Order).ToList();
            _refreshSignal++;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleError(string message)
    {
        _error = message;
        StateHasChanged();
    }
}
