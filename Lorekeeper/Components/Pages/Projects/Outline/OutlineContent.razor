@using Lorekeeper.Chapters
@using Lorekeeper.Models
@using Lorekeeper.Outline
@inject IActService Acts
@inject IChapterService Chapters

@if (Project is null)
{
    <p class="text-muted"><em>Loading…</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading outline…</em></p>
}
else
{
    <div class="outline-pane">
        <div class="outline-pane-chat">
            <OutlineChatPanel ProjectId="Project.Id" OnOutlineChanged="ReloadAsync" />
        </div>
        <div class="outline-pane-tree">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @_error
                    <button type="button" class="btn-close" @onclick="() => _error = null"></button>
                </div>
            }
            <OutlineTree Project="Project"
                         Acts="_acts"
                         ChaptersByAct="_chaptersByAct"
                         Unassigned="_unassigned"
                         Focus="Focus"
                         OnChanged="ReloadAsync"
                         OnError="HandleError" />
        </div>
    </div>
}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [Parameter] public Guid? Focus { get; set; }

    private List<Act> _acts = [];
    private Dictionary<Guid, List<Chapter>> _chaptersByAct = [];
    private List<Chapter> _unassigned = [];
    private bool _loading = true;
    private string? _error;
    private Guid? _loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) return;
        if (_loadedProjectId == Project.Id) return;
        _loadedProjectId = Project.Id;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Project is null) return;
        _loading = true;
        try
        {
            _acts = (await Acts.ListAsync(Project.Id)).ToList();
            var allChapters = (await Chapters.ListAsync(Project.Id)).ToList();
            _chaptersByAct = _acts.ToDictionary(
                a => a.Id,
                a => allChapters.Where(c => c.ActId == a.Id).OrderBy(c => c.Order).ToList());
            _unassigned = allChapters.Where(c => c.ActId is null).OrderBy(c => c.Order).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleError(string message)
    {
        _error = message;
        StateHasChanged();
    }
}
