@using System.Text.Json
@using Lorekeeper.Context
@using Lorekeeper.Models
@using Lorekeeper.Outline
@implements IAsyncDisposable
@inject IAiChangeApprovalService ChangeApproval
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="pending-ai-backdrop" role="presentation" @onclick="CloseAsync"></div>
    <section class="pending-ai-modal" role="dialog" aria-modal="true" aria-label="Pending AI changes" @ref="_modalEl">
        <header class="pending-ai-header">
            <div>
                <div class="pending-ai-title">Pending AI Changes</div>
                <div class="pending-ai-subtitle">Review queued tool changes before they update the project.</div>
            </div>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="pending-ai-error">
                <span>@_error</span>
                <button type="button" class="btn-close btn-close-sm" @onclick="() => _error = null"></button>
            </div>
        }

        @if (Grouped.Count == 0)
        {
            <div class="pending-ai-empty">No pending changes.</div>
        }
        else
        {
            <div class="pending-ai-actions">
                <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="ApplySelectedBatchAsync">Keep batch</button>
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="RejectSelectedBatchAsync">Reject batch</button>
            </div>

            <div class="pending-ai-body">
                <aside class="pending-ai-list">
                    @foreach (var group in Grouped)
                    {
                        var selected = _selectedGroupKey == group.Key;
                        var cascadeCount = CountDependentPendingChanges(group.PendingChangeIds);
                        var dependencies = GroupDependencies(group);
                        <article class="pending-ai-card @(selected ? "selected" : null) @group.StatusClass"
                                 @onclick="() => SelectGroup(group.Key)">
                            <div class="pending-ai-card-main">
                                <span class="pending-ai-tool">@GroupTitle(group)</span>
                                <span class="pending-ai-status">@group.StatusText</span>
                            </div>
                            <div class="pending-ai-summary">@GroupSummary(group)</div>
                            @if (group.Items.Count == 1 && !string.IsNullOrWhiteSpace(group.Changes[0].ArgumentsJson) && group.Changes[0].ArgumentsJson != "{}")
                            {
                                <code class="pending-ai-args">@Truncate(group.Changes[0].ArgumentsJson, 120)</code>
                            }
                            else if (group.Items.Count > 1)
                            {
                                <code class="pending-ai-args">@GroupToolNames(group)</code>
                            }
                            @if (dependencies.Count > 0)
                            {
                                <div class="pending-ai-note">Depends on @dependencies.Count earlier change@(dependencies.Count == 1 ? string.Empty : "s").</div>
                            }
                            @if (cascadeCount > 0 && group.HasPending)
                            {
                                <div class="pending-ai-note warning">Rejecting this also rejects @cascadeCount dependent change@(cascadeCount == 1 ? string.Empty : "s").</div>
                            }
                            <div class="pending-ai-card-actions" @onclick:stopPropagation="true">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        disabled="@(_busy || !group.HasPending)"
                                        @onclick="() => ApplyGroupAsync(group.Key)">Keep</button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        disabled="@(_busy || !group.HasPending)"
                                        @onclick="() => RejectGroupAsync(group.Key)">Reject</button>
                            </div>
                        </article>
                    }
                </aside>

                <main class="pending-ai-detail">
                    @if (SelectedGroup is null)
                    {
                        <div class="pending-ai-empty">Select a change to inspect the diff.</div>
                    }
                    else
                    {
                        var hasEditableChange = SelectedGroup.Changes.Any(IsEditableChange);
                        var hasReviewDraft = SelectedGroup.Changes.Any(AiChangeReviewDrafts.HasDraft);
                        <div class="pending-ai-detail-head">
                            <div>
                                <div class="pending-ai-tool large">@GroupTitle(SelectedGroup)</div>
                                <div class="pending-ai-summary">@GroupSummary(SelectedGroup)</div>
                                @if (SelectedGroup.Changes.Count > 1)
                                {
                                    <div class="pending-ai-note">This preview combines the pending changes into the final proposed state.</div>
                                }
                            </div>
                            <span class="pending-ai-status">@SelectedGroup.StatusText</span>
                        </div>

                        <div class="pending-ai-reject-note">
                            <label for="pending-rejection-note">Rejection message</label>
                            <textarea id="pending-rejection-note" class="form-control" rows="3"
                                      placeholder="Tell the assistant what to correct next turn..."
                                      @bind="_rejectionMessage" @bind:event="oninput"></textarea>
                        </div>

                        @if (AiChangeReviewDiffBuilder.TryBuild(SelectedGroup.Changes, out var reviewDiff))
                        {
                            <section class="pending-ai-unified-diff" aria-label="Change diff">
                                <div class="pending-ai-diff-header">
                                    <div>
                                        <div class="pending-ai-section-label">@reviewDiff.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(reviewDiff.Subtitle))
                                        {
                                            <div class="pending-ai-diff-subtitle">@reviewDiff.Subtitle</div>
                                        }
                                    </div>
                                    <div class="pending-ai-diff-header-actions">
                                        @if (hasEditableChange)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(_busy || !hasReviewDraft)"
                                                    @onclick="() => ResetGroupDraftsAsync(SelectedGroup.Key)">Reset drafts</button>
                                            @if (hasReviewDraft)
                                            {
                                                <span class="pending-ai-draft-badge">Draft edited</span>
                                            }
                                        }
                                        <div class="pending-ai-diff-view-toggle" role="group" aria-label="Diff view">
                                            <button type="button"
                                                    class="@DiffViewButtonClass(DiffViewMode.Inline)"
                                                    aria-pressed="@(_diffViewMode == DiffViewMode.Inline)"
                                                    @onclick="() => SetDiffViewMode(DiffViewMode.Inline)">Inline</button>
                                            <button type="button"
                                                    class="@DiffViewButtonClass(DiffViewMode.SideBySide)"
                                                    aria-pressed="@(_diffViewMode == DiffViewMode.SideBySide)"
                                                    @onclick="() => SetDiffViewMode(DiffViewMode.SideBySide)">Side by side</button>
                                        </div>
                                        <div class="pending-ai-diff-stats" aria-label="Diff stats">
                                            <span class="pending-ai-diff-added">+@reviewDiff.Additions</span>
                                            <span class="pending-ai-diff-removed">-@reviewDiff.Deletions</span>
                                        </div>
                                    </div>
                                </div>

                                @if (reviewDiff.Sections.Count == 0)
                                {
                                    <div class="pending-ai-diff-empty">No text changes detected.</div>
                                }
                                else
                                {
                                    @foreach (var diffSection in reviewDiff.Sections)
                                    {
                                        var sectionOwner = EditableChangeFor(SelectedGroup, diffSection);
                                        <section class="pending-ai-diff-section">
                                            @if (!string.IsNullOrWhiteSpace(diffSection.Label))
                                            {
                                                <div class="pending-ai-diff-field-row">
                                                    <div class="pending-ai-diff-field">@diffSection.Label</div>
                                                    @if (sectionOwner is not null)
                                                    {
                                                        <div class="pending-ai-field-actions">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_busy"
                                                                    @onclick="() => ResetFieldToOriginalProposalAsync(sectionOwner, diffSection.Key)">Reset field</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                                    disabled="@_busy"
                                                                    @onclick="() => RejectFieldAsync(sectionOwner, diffSection)">Reject field</button>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (diffSection.Hunks.Count == 0)
                                            {
                                                <div class="pending-ai-diff-empty">No text changes detected.</div>
                                            }
                                            else
                                            {
                                                @foreach (var hunk in diffSection.Hunks)
                                                {
                                                    <div class="pending-ai-diff-hunk-header">
                                                        @HunkHeader(hunk)
                                                    </div>
                                                    @if (_diffViewMode == DiffViewMode.Inline)
                                                    {
                                                        @foreach (var row in hunk.Rows)
                                                        {
                                                            <div class="pending-ai-diff-row @DiffRowClass(row.Kind)">
                                                                <span class="pending-ai-diff-line-number">@(row.OldLineNumber?.ToString() ?? string.Empty)</span>
                                                                <span class="pending-ai-diff-line-number">@(row.NewLineNumber?.ToString() ?? string.Empty)</span>
                                                                <span class="pending-ai-diff-marker">@row.Marker</span>
                                                                <span class="pending-ai-diff-line-text">
                                                                    @if (sectionOwner is not null && CanEditNewLine(row))
                                                                    {
                                                                        <textarea class="pending-ai-line-editor" data-autosize data-autosize-resize="vertical" rows="1" value="@row.Text"
                                                                                  @onchange="args => UpdateLineTextAsync(sectionOwner, diffSection, row.NewLineNumber!.Value, args.Value?.ToString() ?? string.Empty)"></textarea>
                                                                    }
                                                                    else
                                                                    {
                                                                        @RenderSegments(row.Segments)
                                                                    }
                                                                </span>
                                                                <span class="pending-ai-diff-line-actions">
                                                                    @if (sectionOwner is not null && CanRejectDiffRow(row))
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                                disabled="@_busy"
                                                                                @onclick="() => RejectLineAsync(sectionOwner, diffSection, row, hunk.Rows)">Reject line</button>
                                                                    }
                                                                </span>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="pending-ai-diff-side-by-side">
                                                            @foreach (var splitRow in BuildSplitRows(hunk.Rows))
                                                            {
                                                                <div class="pending-ai-split-row @SplitRowClass(splitRow)">
                                                                    <span class="pending-ai-split-line-number old @SplitCellClass(splitRow.Old)">@(splitRow.Old?.OldLineNumber?.ToString() ?? string.Empty)</span>
                                                                    <span class="pending-ai-split-marker old @SplitCellClass(splitRow.Old)">@(splitRow.Old?.Marker ?? string.Empty)</span>
                                                                    <span class="pending-ai-split-line-text old @SplitCellClass(splitRow.Old)">@RenderSegments(splitRow.Old?.Segments)</span>
                                                                    <span class="pending-ai-split-line-number new @SplitCellClass(splitRow.New)">@(splitRow.New?.NewLineNumber?.ToString() ?? string.Empty)</span>
                                                                    <span class="pending-ai-split-marker new @SplitCellClass(splitRow.New)">@(splitRow.New?.Marker ?? string.Empty)</span>
                                                                    <span class="pending-ai-split-line-text new @SplitCellClass(splitRow.New)">
                                                                        @if (sectionOwner is not null && splitRow.New is { } newRow && CanEditNewLine(newRow))
                                                                        {
                                                                            <textarea class="pending-ai-line-editor" data-autosize data-autosize-resize="vertical" rows="1" value="@newRow.Text"
                                                                                      @onchange="args => UpdateLineTextAsync(sectionOwner, diffSection, newRow.NewLineNumber!.Value, args.Value?.ToString() ?? string.Empty)"></textarea>
                                                                        }
                                                                        else
                                                                        {
                                                                            @RenderSegments(splitRow.New?.Segments)
                                                                        }
                                                                    </span>
                                                                    <span class="pending-ai-split-line-actions">
                                                                        @if (sectionOwner is not null && splitRow.Old is { } oldRow && CanRejectDiffRow(oldRow))
                                                                        {
                                                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                                                    disabled="@_busy"
                                                                                    @onclick="() => RejectLineAsync(sectionOwner, diffSection, oldRow, hunk.Rows)">Reject line</button>
                                                                        }
                                                                        @if (sectionOwner is not null && splitRow.New is { } actionNewRow && CanRejectDiffRow(actionNewRow))
                                                                        {
                                                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                                                    disabled="@_busy"
                                                                                    @onclick="() => RejectLineAsync(sectionOwner, diffSection, actionNewRow, hunk.Rows)">Reject line</button>
                                                                        }
                                                                    </span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            }
                                        </section>
                                    }
                                }
                            </section>
                        }
                        else
                        {
                            @if (SelectedGroup.Changes.Count == 1)
                            {
                                var rawChange = SelectedGroup.Changes[0];
                                <div class="pending-ai-diff-grid">
                                    <section>
                                        <div class="pending-ai-section-label">Old</div>
                                        <pre>@FormatJson(rawChange.BeforeJson)</pre>
                                    </section>
                                    <section>
                                        <div class="pending-ai-section-label">New</div>
                                        <pre>@FormatJson(AiChangeReviewDrafts.EffectiveAfterJson(rawChange))</pre>
                                    </section>
                                </div>
                            }
                            else
                            {
                                <div class="pending-ai-group-payloads">
                                    @foreach (var rawChange in SelectedGroup.Changes)
                                    {
                                        <section class="pending-ai-group-payload">
                                            <div class="pending-ai-section-label">@rawChange.ToolName</div>
                                            <div class="pending-ai-summary">@rawChange.Summary</div>
                                            <div class="pending-ai-diff-grid">
                                                <section>
                                                    <div class="pending-ai-section-label">Old</div>
                                                    <pre>@FormatJson(rawChange.BeforeJson)</pre>
                                                </section>
                                                <section>
                                                    <div class="pending-ai-section-label">New</div>
                                                    <pre>@FormatJson(AiChangeReviewDrafts.EffectiveAfterJson(rawChange))</pre>
                                                </section>
                                            </div>
                                        </section>
                                    }
                                </div>
                            }
                        }

                        <details class="pending-ai-raw">
                            <summary>@(SelectedGroup.Changes.Count == 1 ? "Tool call" : "Tool calls")</summary>
                            @if (SelectedGroup.Changes.Count == 1)
                            {
                                <pre>@FormatJson(SelectedGroup.Changes[0].ArgumentsJson)</pre>
                            }
                            else
                            {
                                <div class="pending-ai-group-payloads compact">
                                    @foreach (var toolChange in SelectedGroup.Changes)
                                    {
                                        <section class="pending-ai-group-payload">
                                            <div class="pending-ai-section-label">@toolChange.ToolName</div>
                                            <pre>@FormatJson(toolChange.ArgumentsJson)</pre>
                                        </section>
                                    }
                                </div>
                            }
                        </details>

                        <div class="pending-ai-detail-actions">
                            <button type="button" class="btn btn-primary"
                                    disabled="@(_busy || !SelectedGroup.HasPending)"
                                    @onclick="() => ApplyGroupAsync(SelectedGroup.Key)">@KeepButtonText(SelectedGroup)</button>
                            <button type="button" class="btn btn-outline-danger"
                                    disabled="@(_busy || !SelectedGroup.HasPending)"
                                    @onclick="() => RejectGroupAsync(SelectedGroup.Key)">Reject</button>
                        </div>
                    }
                </main>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public IReadOnlyList<AiChangeBatch> Batches { get; set; } = [];
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _selectedGroupKey;
    private string _rejectionMessage = string.Empty;
    private string? _error;
    private bool _busy;
    private DiffViewMode _diffViewMode = DiffViewMode.Inline;
    private ElementReference _modalEl;
    private IJSObjectReference? _autoSizer;
    private bool _autosizeRefreshPending;
    private bool _wasOpen;
    private int _changeCacheHash;
    private IReadOnlyList<PendingChangeItem> _flattened = [];
    private IReadOnlyList<PendingChangeGroup> _grouped = [];
    private PendingChangeGroup? _selectedGroup;

    private IReadOnlyList<PendingChangeItem> Flattened => _flattened;
    private IReadOnlyList<PendingChangeGroup> Grouped => _grouped;
    private PendingChangeGroup? SelectedGroup => _selectedGroup;

    private static IReadOnlyList<PendingChangeItem> BuildFlattened(IReadOnlyList<AiChangeBatch> batches) => batches
        .SelectMany(batch => batch.Changes.OrderBy(change => change.Order).Select(change => new PendingChangeItem(
            batch,
            change,
            ReadGuidList(change.DependsOnChangeIdsJson))))
        .GroupBy(item => item.Change.Id)
        .Select(group => group.First())
        .OrderBy(item => item.Batch.CreatedAt)
        .ThenBy(item => item.Change.Order)
        .ToList();

    private static IReadOnlyList<PendingChangeGroup> BuildGrouped(IReadOnlyList<PendingChangeItem> flattened) => flattened
        .GroupBy(item => GroupKey(item.Change), StringComparer.OrdinalIgnoreCase)
        .Select(group => new PendingChangeGroup(group.Key, group
            .OrderBy(item => item.Batch.CreatedAt)
            .ThenBy(item => item.Change.Order)
            .ToList()))
        .OrderBy(group => group.CreatedAt)
        .ThenBy(group => group.Order)
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((firstRender || IsOpen) && _autoSizer is null)
            await ImportAutoSizerAsync();

        if (IsOpen && _autosizeRefreshPending && _autoSizer is not null)
        {
            if (await RefreshAutoSizeAsync(_modalEl))
                _autosizeRefreshPending = false;
        }
    }

    protected override void OnParametersSet()
    {
        var previousSelectedGroupKey = _selectedGroupKey;
        var previousChangeCacheHash = _changeCacheHash;

        _flattened = BuildFlattened(Batches);
        _grouped = BuildGrouped(_flattened);
        _changeCacheHash = ComputeChangeCacheHash(_flattened);
        _selectedGroup = _grouped.FirstOrDefault(group => group.Key == _selectedGroupKey) ?? _grouped.FirstOrDefault();
        _selectedGroupKey = _selectedGroup?.Key;

        if (IsOpen
            && (!_wasOpen
                || previousChangeCacheHash != _changeCacheHash
                || !string.Equals(previousSelectedGroupKey, _selectedGroupKey, StringComparison.Ordinal)))
        {
            QueueAutosizeRefresh();
        }

        _wasOpen = IsOpen;
    }

    private void SelectGroup(string groupKey)
    {
        if (string.Equals(_selectedGroupKey, groupKey, StringComparison.Ordinal)) return;

        _selectedGroupKey = groupKey;
        _selectedGroup = _grouped.FirstOrDefault(group => group.Key == groupKey);
        QueueAutosizeRefresh();
    }

    private void SetDiffViewMode(DiffViewMode mode)
    {
        if (_diffViewMode == mode) return;

        _diffViewMode = mode;
        QueueAutosizeRefresh();
    }

    private void QueueAutosizeRefresh() => _autosizeRefreshPending = true;

    private async Task ImportAutoSizerAsync()
    {
        try
        {
            _autoSizer = await JS.InvokeAsync<IJSObjectReference>("import", "./js/autosizeTextareas.js");
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }

    private async Task<bool> RefreshAutoSizeAsync(ElementReference root)
    {
        if (_autoSizer is null) return false;

        try
        {
            await _autoSizer.InvokeVoidAsync("refresh", root);
            return true;
        }
        catch (JSDisconnectedException) { return false; }
        catch (OperationCanceledException) { return false; }
    }

    private static int ComputeChangeCacheHash(IReadOnlyList<PendingChangeItem> items)
    {
        var hash = new HashCode();
        foreach (var item in items)
        {
            hash.Add(item.Batch.Id);
            hash.Add(item.Batch.Status);
            hash.Add(item.Batch.UpdatedAt);
            hash.Add(item.Change.Id);
            hash.Add(item.Change.Status);
            hash.Add(item.Change.UpdatedAt);
        }

        return hash.ToHashCode();
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task ApplySelectedBatchAsync()
    {
        var batchId = SelectedGroup?.PrimaryBatch.Id;
        if (batchId is null) return;
        await RunAsync(() => ChangeApproval.ApplyBatchAsync(batchId.Value));
    }

    private async Task RejectSelectedBatchAsync()
    {
        var batchId = SelectedGroup?.PrimaryBatch.Id;
        if (batchId is null) return;
        await RunAsync(() => ChangeApproval.RejectBatchAsync(batchId.Value, _rejectionMessage));
    }

    private async Task ApplyGroupAsync(string groupKey) =>
        await RunAsync(async () =>
        {
            var group = Grouped.FirstOrDefault(candidate => candidate.Key == groupKey);
            if (group is null) return;

            foreach (var change in group.Changes.Where(change => change.Status == AiChangeStatus.Pending))
                await ChangeApproval.ApplyChangeAsync(change.Id);
        });

    private async Task RejectGroupAsync(string groupKey) =>
        await RunAsync(async () =>
        {
            var group = Grouped.FirstOrDefault(candidate => candidate.Key == groupKey);
            if (group is null) return;

            foreach (var change in group.Changes.Where(change => change.Status == AiChangeStatus.Pending))
                await ChangeApproval.RejectChangeAsync(change.Id, _rejectionMessage);
        });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            _rejectionMessage = string.Empty;
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            if (IsOpen)
                QueueAutosizeRefresh();
        }
    }

    private static AiChange? EditableChangeFor(PendingChangeGroup group, DiffSection section)
    {
        if (section.OwnerChangeId is not Guid ownerChangeId) return null;

        var change = group.Changes.FirstOrDefault(candidate => candidate.Id == ownerChangeId);
        return change is not null && IsEditableChange(change) ? change : null;
    }

    private static bool IsEditableChange(AiChange change) =>
        change.Status == AiChangeStatus.Pending && AiChangeReviewDrafts.TryGetEditablePayload(change, out _);

    private async Task ResetGroupDraftsAsync(string groupKey)
    {
        await RunDraftAsync(async () =>
        {
            var group = Grouped.FirstOrDefault(candidate => candidate.Key == groupKey);
            if (group is null) return;

            foreach (var change in group.Changes.Where(change => change.Status == AiChangeStatus.Pending && AiChangeReviewDrafts.HasDraft(change)))
            {
                await ChangeApproval.ClearReviewDraftAsync(change.Id);
                change.DraftAfterJson = null;
                change.ReviewStateJson = null;
            }
        });
    }

    private async Task RejectFieldAsync(AiChange change, DiffSection section) =>
        await UpdateFieldDraftAsync(change, section.Key, section.OldText);

    private async Task ResetFieldToOriginalProposalAsync(AiChange change, string fieldKey)
    {
        if (!AiChangeReviewDrafts.TryResetFieldToOriginalProposal(change, fieldKey, out var draftAfterJson, out var error))
        {
            _error = error;
            return;
        }

        await SaveDraftAsync(change, draftAfterJson);
    }

    private async Task UpdateLineTextAsync(AiChange change, DiffSection section, int newLineNumber, string text)
    {
        var lines = ChapterFormatting.SplitLines(section.NewText);
        var index = newLineNumber - 1;
        if (index < 0 || index >= lines.Count) return;

        lines[index] = NormalizeLineEditText(text);
        await UpdateFieldDraftAsync(change, section.Key, ChapterFormatting.JoinLines(lines));
    }

    private async Task RejectLineAsync(AiChange change, DiffSection section, DiffRow row, IReadOnlyList<DiffRow> hunkRows)
    {
        var newText = RejectLine(section, row, hunkRows);
        await UpdateFieldDraftAsync(change, section.Key, newText);
    }

    private async Task UpdateFieldDraftAsync(AiChange change, string fieldKey, string newText)
    {
        if (!AiChangeReviewDrafts.TryUpdateField(change, fieldKey, newText, out var draftAfterJson, out var error))
        {
            _error = error;
            return;
        }

        await SaveDraftAsync(change, draftAfterJson);
    }

    private async Task SaveDraftAsync(AiChange change, string draftAfterJson)
    {
        await RunDraftAsync(async () =>
        {
            if (string.Equals(draftAfterJson, change.AfterJson, StringComparison.Ordinal))
            {
                await ChangeApproval.ClearReviewDraftAsync(change.Id);
                change.DraftAfterJson = null;
                change.ReviewStateJson = null;
                return;
            }

            var reviewStateJson = BuildReviewStateJson();
            await ChangeApproval.SaveReviewDraftAsync(change.Id, draftAfterJson, reviewStateJson);
            change.DraftAfterJson = draftAfterJson;
            change.ReviewStateJson = reviewStateJson;
        });
    }

    private async Task RunDraftAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            if (IsOpen)
                QueueAutosizeRefresh();
        }
    }

    private static string RejectLine(DiffSection section, DiffRow row, IReadOnlyList<DiffRow> hunkRows)
    {
        var lines = ChapterFormatting.SplitLines(section.NewText);
        if (row.Kind == DiffRowKind.Added && row.NewLineNumber is int newLineNumber)
        {
            var index = newLineNumber - 1;
            if (index < 0 || index >= lines.Count) return section.NewText;

            var pairedOld = row.PairId is int pairId
                ? hunkRows.FirstOrDefault(candidate => candidate.PairId == pairId && candidate.Kind == DiffRowKind.Removed)
                : null;
            if (pairedOld is not null)
                lines[index] = pairedOld.Text;
            else
                lines.RemoveAt(index);

            return ChapterFormatting.JoinLines(lines);
        }

        if (row.Kind == DiffRowKind.Removed && row.OldLineNumber is int oldLineNumber)
        {
            var pairedNew = row.PairId is int pairId
                ? hunkRows.FirstOrDefault(candidate => candidate.PairId == pairId && candidate.Kind == DiffRowKind.Added)
                : null;
            if (pairedNew?.NewLineNumber is int pairedNewLineNumber)
            {
                var pairedIndex = pairedNewLineNumber - 1;
                if (pairedIndex >= 0 && pairedIndex < lines.Count)
                {
                    lines[pairedIndex] = row.Text;
                    return ChapterFormatting.JoinLines(lines);
                }
            }

            lines.Insert(Math.Clamp(oldLineNumber - 1, 0, lines.Count), row.Text);
            return ChapterFormatting.JoinLines(lines);
        }

        return section.NewText;
    }

    private static bool CanEditNewLine(DiffRow row) =>
        row.Kind == DiffRowKind.Added && row.NewLineNumber.HasValue;

    private static bool CanRejectDiffRow(DiffRow row) => row.Kind != DiffRowKind.Context;

    private static string NormalizeLineEditText(string text) =>
        text.Replace("\r\n", "\n").Replace('\r', '\n');

    private static string BuildReviewStateJson() =>
        JsonSerializer.Serialize(new ReviewDraftState(DateTime.UtcNow), JsonSerializerOptions.Default);

    private static string KeepButtonText(PendingChangeGroup group) =>
        group.Changes.Any(AiChangeReviewDrafts.HasDraft) ? "Keep reviewed" : "Keep";

    private int CountDependentPendingChanges(IReadOnlyCollection<Guid> changeIds)
    {
        if (changeIds.Count == 0) return 0;

        var rejectedIds = new HashSet<Guid>(changeIds);
        var rootCount = rejectedIds.Count;
        var changed = true;
        while (changed)
        {
            changed = false;
            foreach (var item in Flattened.Where(item => item.Change.Status == AiChangeStatus.Pending))
            {
                if (rejectedIds.Contains(item.Change.Id)) continue;
                if (item.Dependencies.Any(rejectedIds.Contains))
                {
                    rejectedIds.Add(item.Change.Id);
                    changed = true;
                }
            }
        }
        return rejectedIds.Count - rootCount;
    }

    private static string GroupKey(AiChange change) =>
        string.IsNullOrWhiteSpace(change.ResourceId)
            ? change.Id.ToString("N")
            : change.ResourceId.Trim();

    private static string GroupTitle(PendingChangeGroup group)
    {
        var label = ResourceLabel(group.Changes[0]);
        return group.Changes.Count == 1
            ? group.Changes[0].ToolName
            : $"{label} ({group.Changes.Count} changes)";
    }

    private static string GroupSummary(PendingChangeGroup group)
    {
        if (group.Changes.Count == 1)
            return group.Changes[0].Summary;

        var summaries = string.Join("; ", group.Changes.Select(change => change.Summary).Where(summary => !string.IsNullOrWhiteSpace(summary)));
        return string.IsNullOrWhiteSpace(summaries)
            ? $"{group.Changes.Count} tool changes."
            : $"{group.Changes.Count} tool changes: {Truncate(summaries, 180)}";
    }

    private static string GroupToolNames(PendingChangeGroup group) =>
        Truncate(string.Join(" -> ", group.Changes.Select(change => change.ToolName)), 120);

    private static string ResourceLabel(AiChange change)
    {
        if (change.ResourceId.StartsWith("Chapter:", StringComparison.OrdinalIgnoreCase)) return "Chapter";
        if (change.ResourceId.StartsWith("Act:", StringComparison.OrdinalIgnoreCase)) return "Act";
        if (change.ResourceId.StartsWith("Entity:", StringComparison.OrdinalIgnoreCase)) return string.IsNullOrWhiteSpace(change.ResourceKind) ? "Entity" : change.ResourceKind;
        if (change.ResourceId.StartsWith("EntityLink:", StringComparison.OrdinalIgnoreCase)) return "Entity link";
        if (string.Equals(change.ResourceKind, "ChapterBody", StringComparison.OrdinalIgnoreCase)) return "Chapter";
        return string.IsNullOrWhiteSpace(change.ResourceKind) ? change.ToolName : change.ResourceKind;
    }

    private static IReadOnlyList<Guid> GroupDependencies(PendingChangeGroup group)
    {
        var ownIds = group.ChangeIds.ToHashSet();
        return group.Items
            .SelectMany(item => item.Dependencies)
            .Where(dependencyId => !ownIds.Contains(dependencyId))
            .Distinct()
            .ToList();
    }

    private static IReadOnlyList<Guid> ReadGuidList(string json) =>
        string.IsNullOrWhiteSpace(json) || json == "[]"
            ? []
            : JsonSerializer.Deserialize<List<Guid>>(json, JsonSerializerOptions.Default) ?? [];

    private static string Truncate(string value, int max)
    {
        value = value.Replace('\n', ' ').Replace('\r', ' ');
        return value.Length <= max ? value : value[..max] + "...";
    }

    private static string FormatJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return string.Empty;
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string DiffRowClass(DiffRowKind kind) => kind switch
    {
        DiffRowKind.Added => "added",
        DiffRowKind.Removed => "removed",
        _ => "context",
    };

    private static RenderFragment RenderSegments(IReadOnlyList<DiffSegment>? segments) => builder =>
    {
        if (segments is null) return;

        var sequence = 0;
        foreach (var segment in segments)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", DiffSegmentClass(segment.Kind));
            builder.AddContent(sequence++, segment.Text);
            builder.CloseElement();
        }
    };

    private static string DiffSegmentClass(DiffSegmentKind kind) => kind switch
    {
        DiffSegmentKind.Added => "pending-ai-diff-segment added",
        DiffSegmentKind.Removed => "pending-ai-diff-segment removed",
        _ => "pending-ai-diff-segment",
    };

    private string DiffViewButtonClass(DiffViewMode mode) =>
        _diffViewMode == mode
            ? "pending-ai-diff-view-button active"
            : "pending-ai-diff-view-button";

    private static IReadOnlyList<SplitDiffRow> BuildSplitRows(IReadOnlyList<DiffRow> rows)
    {
        var splitRows = new List<SplitDiffRow>();
        for (var index = 0; index < rows.Count; index++)
        {
            var row = rows[index];
            if (row.Kind == DiffRowKind.Context)
            {
                splitRows.Add(new SplitDiffRow(row, row));
                continue;
            }

            if (row.Kind == DiffRowKind.Removed
                && index + 1 < rows.Count
                && rows[index + 1].Kind == DiffRowKind.Added
                && row.PairId.HasValue
                && row.PairId == rows[index + 1].PairId)
            {
                index++;
                splitRows.Add(new SplitDiffRow(row, rows[index]));
                continue;
            }

            splitRows.Add(row.Kind == DiffRowKind.Removed
                ? new SplitDiffRow(row, null)
                : new SplitDiffRow(null, row));
        }

        return splitRows;
    }

    private static string SplitRowClass(SplitDiffRow row)
    {
        if (row.Old?.Kind == DiffRowKind.Removed && row.New?.Kind == DiffRowKind.Added) return "changed";
        if (row.Old?.Kind == DiffRowKind.Removed) return "removed";
        if (row.New?.Kind == DiffRowKind.Added) return "added";
        return "context";
    }

    private static string SplitCellClass(DiffRow? row) => row?.Kind switch
    {
        DiffRowKind.Added => "added",
        DiffRowKind.Removed => "removed",
        DiffRowKind.Context => "context",
        _ => "empty",
    };

    private static string HunkHeader(DiffHunk hunk) => $"@@ -{hunk.OldStart},{hunk.OldLength} +{hunk.NewStart},{hunk.NewLength} @@";

    private sealed record PendingChangeItem(AiChangeBatch Batch, AiChange Change, IReadOnlyList<Guid> Dependencies);

    private sealed class PendingChangeGroup(string key, IReadOnlyList<PendingChangeItem> items)
    {
        public string Key { get; } = key;
        public IReadOnlyList<PendingChangeItem> Items { get; } = items;
        public IReadOnlyList<AiChange> Changes { get; } = items.Select(item => item.Change).ToList();
        public IReadOnlyList<Guid> ChangeIds { get; } = items.Select(item => item.Change.Id).ToList();
        public IReadOnlyList<Guid> PendingChangeIds { get; } = items
            .Where(item => item.Change.Status == AiChangeStatus.Pending)
            .Select(item => item.Change.Id)
            .ToList();
        public AiChangeBatch PrimaryBatch => Items[0].Batch;
        public DateTime CreatedAt => Items[0].Batch.CreatedAt;
        public int Order => Items[0].Change.Order;
        public bool HasPending => Items.Any(item => item.Change.Status == AiChangeStatus.Pending);
        public string StatusText
        {
            get
            {
                var statuses = Items
                    .Select(item => item.Change.Status)
                    .Distinct()
                    .ToList();
                return statuses.Count == 1 ? statuses[0].ToString() : "Mixed";
            }
        }

        public string StatusClass
        {
            get
            {
                if (Items.Any(item => item.Change.Status == AiChangeStatus.Conflict)) return "conflict";
                if (Items.All(item => item.Change.Status == AiChangeStatus.Applied)) return "applied";
                if (Items.All(item => item.Change.Status == AiChangeStatus.Rejected)) return "rejected";
                return "pending";
            }
        }
    }

    private sealed record SplitDiffRow(DiffRow? Old, DiffRow? New);

    private sealed record ReviewDraftState(DateTime UpdatedAt);

    private enum DiffViewMode
    {
        Inline,
        SideBySide,
    }

    public async ValueTask DisposeAsync()
    {
        if (_autoSizer is not null)
        {
            try { await _autoSizer.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }
    }
}
