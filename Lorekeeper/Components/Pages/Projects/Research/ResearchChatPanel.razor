@using Lorekeeper.Components.Chat
@using Lorekeeper.Models
@using Lorekeeper.Research
@using Lorekeeper.Tokens
@implements IAsyncDisposable
@inject IResearchService Research
@inject ITokenCounter TokenCounter

<ChatSurface Title="Research"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel)"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Ask me to research a topic..."
             Running="@_running"
             ComposerDisabled="@_running"
             SendDisabled="@string.IsNullOrWhiteSpace(_input)"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
        <button type="button" class="btn btn-link btn-sm research-reset" title="Start over" disabled="@_running" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
</ChatSurface>

@code {
    private const string ConversationTokenUnitLabel = "conversation tokens";
    private const string ConversationTokenTitleLabel = "conversation token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback OnCandidatesChanged { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;
    private ResearchConversation? _conversation;
    private List<ResearchMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;
    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _cts;
    private Guid? _loadedProjectId;
    private string? _pendingUserText;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty || _loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _conversation = await Research.GetOrCreateAsync(ProjectId);
            _messages = (await Research.LoadMessagesAsync(_conversation.Id)).ToList();
            RebuildRenderable();
            _pendingUserText = null;
            _live = null;
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (_running || string.IsNullOrWhiteSpace(text)) return;

        _input = string.Empty;
        _running = true;
        _error = null;
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Guid.NewGuid(),
            ChatMessageRole.User,
            ChatMessageStatus.Completed,
            [new ChatTextPart(text)]));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        try
        {
            await foreach (var update in Research.SendAsync(ProjectId, text, _cts.Token))
            {
                switch (update)
                {
                    case ResearchTextDelta delta:
                        _live!.AppendText(delta.Text);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;
                    case ResearchToolCallStarted started:
                        _live!.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;
                    case ResearchToolCallArgumentsDelta delta:
                        _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;
                    case ResearchToolCallCompleted completed:
                        _live!.CompleteToolCall(completed.CallId, completed.Result, completed.Error);
                        UpdateConversationTokenCount();
                        await OnCandidatesChanged.InvokeAsync();
                        RequestScroll();
                        StateHasChanged();
                        break;
                    case ResearchAssistantMessageCompleted:
                        await ReloadFromDbAsync();
                        await OnCandidatesChanged.InvokeAsync();
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;
                    case ResearchTurnError error:
                        _error = error.Cancelled ? null : error.Message;
                        await ReloadFromDbAsync();
                        await OnCandidatesChanged.InvokeAsync();
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            _live = null;
            UpdateConversationTokenCount();
            _cts?.Dispose();
            _cts = null;
            RequestScroll();
            StateHasChanged();
        }
    }

    private async Task ResetAsync()
    {
        if (_running) return;
        await Research.ResetAsync(ProjectId);
        _loadedProjectId = null;
        await LoadAsync();
    }

    private void CancelAsync() => _cts?.Cancel();

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _messages = (await Research.LoadMessagesAsync(_conversation.Id)).ToList();
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private void RebuildRenderable()
    {
        var byCallId = _messages
            .Where(message => message.Role == ResearchMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<ChatRenderableMessage>(_messages.Count);
        foreach (var message in _messages)
        {
            if (message.Role is ResearchMessageRole.Tool or ResearchMessageRole.System) continue;
            _renderable.Add(new ChatRenderableMessage(
                message.Id,
                message.Role == ResearchMessageRole.User ? ChatMessageRole.User : ChatMessageRole.Assistant,
                ToChatStatus(message.Status),
                BuildMessageParts(message, byCallId)));
        }
    }

    private static ChatMessageStatus ToChatStatus(ResearchMessageStatus status) => status switch
    {
        ResearchMessageStatus.Failed => ChatMessageStatus.Failed,
        ResearchMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        ResearchMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            _messages,
            ToTokenMessage,
            _live,
            _pendingUserText,
            ResearchService.ResearchSystemPrompt);
    }

    private static ChatTranscriptTokenMessage ToTokenMessage(ResearchMessage message) => new(
        message.Role.ToString(),
        message.Content,
        message.ToolCallsJson,
        message.ToolCallId,
        message.ToolName,
        message.ErrorMessage);

    private static List<ChatMessagePart> BuildMessageParts(ResearchMessage message, IReadOnlyDictionary<string, ResearchMessage> byCallId)
    {
        if (message.Role != ResearchMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls.Select((call, index) => new { Call = call, Index = index })
                                      .OrderBy(item => item.Call.TextOffset!.Value)
                                      .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));
            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content)) parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls) parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, ResearchMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        return new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMessage?.Status == ResearchMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == ResearchMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = resultMessage is not null,
        };
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force) _forceScrollKey++;
    }

    private Task ResumeAutoFollowAsync()
    {
        _autoFollowKey++;
        return Task.CompletedTask;
    }

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }
}