@using Lorekeeper.Components.Chat
@using Lorekeeper.Components.Pages.Projects.Outline
@using Lorekeeper.ChatTurns
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Lorekeeper.Research
@using Lorekeeper.Tokens
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IResearchService Research
@inject IResearchChatTurnRunner ChatTurns
@inject IChatImageAttachmentService ImageAttachments
@inject ILlmProviderService Providers
@inject ITokenCounter TokenCounter
@inject ChatTokenLimitResolver TokenLimits

<ChatSurface Title="Research"
             ProjectId="@ProjectId"
             Surface="ChatTurnSurface.Research"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel, ConversationTokenLimit)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel, ConversationTokenLimit, ActiveModelId)"
             ShowTokenResetSuggestion="@_conversationTokens.ShouldSuggestReset(ConversationTokenLimit)"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Ask me to research a topic..."
             Running="@_running"
              ComposerDisabled="@(ChatDisabled || _running || _resetting)"
              SendDisabled="@(ChatDisabled || _resetting || string.IsNullOrWhiteSpace(_input))"
             ModelOptions="@_modelOptions"
             SelectedProviderId="@PickerSelectedProviderId"
             UnavailableModelLabel="@(_chatSelection?.Message ?? "No available chat models")"
             ModelPickerDisabled="@(_loading || _running || _resetting || ChatTurns.GetActiveTurn(ProjectId) is not null)"
             OnModelChanged="OnModelChangedAsync"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
        <button type="button" class="btn btn-link btn-sm research-reset" title="Start over" disabled="@(_loading || _running || _resetting)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        @if (ChatDisabled)
        {
            <div class="alert alert-warning py-2 small mb-2">
                LLM chat is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
            </div>
        }
    </ExtraControls>
</ChatSurface>

@code {
    private const string ConversationTokenUnitLabel = "chat tokens";
    private const string ConversationTokenTitleLabel = "model input token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback OnActivityChanged { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;
    private ResearchConversation? _conversation;
    private List<ResearchMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;
    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private bool _resetting;
    private string? _error;
    private CancellationTokenSource? _listenCts;
    private Guid? _listeningTurnId;
    private Guid? _loadedProjectId;
    private string? _pendingUserText;
    private string _systemPrompt = string.Empty;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private ChatProviderAvailability? _chatAvailability;
    private IReadOnlyList<ChatModelPickerOption> _modelOptions = [];
    private ChatModelSelection? _chatSelection;
    private int? _selectedProviderId;
    private ChatTurnModelSnapshot? _activeTurnModel;
    private IReadOnlyDictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>> _messageImages = new Dictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>>();

    private string? ActiveModelId => _activeTurnModel?.ModelId ?? _chatAvailability?.Provider?.ModelId;
    private int? PickerSelectedProviderId => _activeTurnModel?.ProviderId ?? _selectedProviderId ?? _chatSelection?.ProviderId;
    private int? ActiveMaxInputTokens => _activeTurnModel?.MaxInputTokens ?? _chatAvailability?.Provider?.EffectiveMaxInputTokens;
    private int ConversationTokenLimit => TokenLimits.Resolve(ActiveMaxInputTokens, ActiveModelId);
    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty || _loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        StopListening();
        _loading = true;
        try
        {
            _conversation = await Research.GetOrCreateAsync(ProjectId);
            _selectedProviderId = _conversation.SelectedProviderId;
            await LoadChatProviderStateAsync();
            _messages = (await Research.LoadMessagesAsync(_conversation.Id)).ToList();
            _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Research);
            _systemPrompt = await Research.GetSystemPromptAsync(ProjectId);
            var activeTurn = ChatTurns.GetActiveTurn(ProjectId);
            RebuildRenderable(activeTurn?.StartedAtUtc);
            if (activeTurn is not null)
            {
                _activeTurnModel = activeTurn.Model;
                IncludeActiveModelOption();
                _renderable.Add(new ChatRenderableMessage(
                    Guid.NewGuid(),
                    ChatMessageRole.User,
                    ChatMessageStatus.Completed,
                    ChatImageParts.BuildUserParts(activeTurn.UserText, activeTurn.Images)));
                _pendingUserText = activeTurn.UserText;
                _live = new ChatLiveTurn();
                _running = true;
                await ListenToActiveTurnAsync(activeTurn);
            }
            else
            {
                _activeTurnModel = null;
                _pendingUserText = null;
                _live = null;
                _running = false;
            }
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync(ChatComposerSubmission submission)
    {
        var text = submission.Text.Trim();
        if (_running || string.IsNullOrWhiteSpace(text)) return;
        if (ChatDisabled)
        {
            _error = ChatDisabledMessage;
            return;
        }
        if (submission.Images.Count > 0
            && (_chatAvailability?.Provider is null
                || !await Providers.IsVisionProviderWorkingAsync(_chatAvailability.Provider.Id)))
        {
            _error = "The active chat provider has not passed the vision check. Run Test in Settings > Providers before sending images.";
            return;
        }

        if (_chatAvailability?.Provider is not { } provider)
        {
            _error = ChatDisabledMessage;
            return;
        }

        var model = Snapshot(provider);
        _activeTurnModel = model;
        IncludeActiveModelOption();
        _input = string.Empty;
        _running = true;
        _error = null;
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Guid.NewGuid(),
            ChatMessageRole.User,
            ChatMessageStatus.Completed,
            ChatImageParts.BuildUserParts(text, submission.Images)));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        if (!ChatTurns.TryStart(ProjectId, text, submission.Images, model))
        {
            _error = "Research Chat already has a running turn.";
            ReleaseRunningUi();
            if (ChatTurns.GetActiveTurn(ProjectId) is { } existingTurn)
                await ListenToActiveTurnAsync(existingTurn);
            return;
        }

        if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
            await ListenToActiveTurnAsync(activeTurn);
    }

    private async Task ResetAsync()
    {
        if (_running || _resetting) return;
        _resetting = true;
        try
        {
            await Research.ResetAsync(ProjectId);
            _loadedProjectId = null;
            await LoadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _resetting = false;
        }
    }

    private async Task ListenToActiveTurnAsync(ChatTurnSnapshot activeTurn)
    {
        if (_listeningTurnId == activeTurn.TurnId)
            return;

        _activeTurnModel = activeTurn.Model;
        IncludeActiveModelOption();
        UpdateConversationTokenCount();
        StopListening();
        var subscription = ChatTurns.Subscribe(ProjectId);
        if (subscription is null)
        {
            ReleaseRunningUi();
            return;
        }

        _listeningTurnId = subscription.TurnId;
        _listenCts = new CancellationTokenSource();
        _ = ListenToTurnAsync(subscription, _listenCts.Token);
        await Task.CompletedTask;
    }

    private void StopListening()
    {
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        _listenCts = null;
        _listeningTurnId = null;
    }

    private async Task ListenToTurnAsync(
        IChatTurnSubscription<ResearchTurnUpdate> subscription,
        CancellationToken cancellationToken)
    {
        await using (subscription)
        {
            try
            {
                await foreach (var update in subscription.ReadAllAsync(cancellationToken))
                    await InvokeAsync(async () => await ApplyTurnUpdateAsync(update));
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ApplyTurnUpdateAsync(ResearchTurnUpdate update)
    {
        switch (update)
        {
            case ResearchTextDelta delta:
                _live!.AppendText(delta.Text);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ResearchReasoningDelta reasoning:
                _live!.AppendReasoning(reasoning.Text);
                RequestScroll();
                StateHasChanged();
                break;

            case ResearchToolCallStarted started:
                _live!.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ResearchToolCallArgumentsDelta delta:
                _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ResearchToolCallCompleted completed:
                _live!.CompleteToolCall(completed.CallId, completed.Result, completed.Error, completed.DurationMs);
                UpdateConversationTokenCount();
                await OnActivityChanged.InvokeAsync();
                RequestScroll();
                StateHasChanged();
                break;
            case ResearchContextTrimmed trimmed:
                _live!.ApplyContextTrim(
                    trimmed.Result.NewlyTombstonedCallIds,
                    trimmed.Result.CompletedRoundCallIds);
                UpdateConversationTokenCount();
                StateHasChanged();
                break;
            case ResearchGraphMutated:
                await OnActivityChanged.InvokeAsync();
                break;
            case ResearchAssistantMessageCompleted:
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                await OnActivityChanged.InvokeAsync();
                RequestScroll();
                StateHasChanged();
                break;
            case ResearchTurnError error:
                _error = error.Cancelled ? null : error.Message;
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                await OnActivityChanged.InvokeAsync();
                RequestScroll();
                StateHasChanged();
                break;
        }
    }

    private void CancelAsync() => ChatTurns.Cancel(ProjectId);

    private void ReleaseRunningUi()
    {
        var wasRunning = _running;
        var hadLive = _live is not null;
        _running = false;
        _live = null;
        _activeTurnModel = null;
        UpdateConversationTokenCount();
        RequestScroll();
        if (wasRunning || hadLive)
            StateHasChanged();
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _conversation = await Research.GetOrCreateAsync(ProjectId);
        _selectedProviderId = _conversation.SelectedProviderId;
        await LoadChatProviderStateAsync();
        _messages = (await Research.LoadMessagesAsync(_conversation.Id)).ToList();
        _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.Research);
        _systemPrompt = await Research.GetSystemPromptAsync(ProjectId);
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private async Task LoadChatProviderStateAsync()
    {
        _chatAvailability = await Research.GetChatProviderAvailabilityAsync(ProjectId);
        _chatSelection = await Providers.ResolveChatModelSelectionAsync(_selectedProviderId);
        _modelOptions = (await Providers.ListChatModelOptionsAsync())
            .Select(option => new ChatModelPickerOption(option.ProviderId, option.ConnectionLabel, option.ModelLabel, option.IsDefault))
            .ToList();
    }

    private void IncludeActiveModelOption()
    {
        if (_activeTurnModel is not { } active
            || _modelOptions.Any(option => option.ProviderId == active.ProviderId))
            return;
        _modelOptions = _modelOptions
            .Append(new ChatModelPickerOption(active.ProviderId, "Active model", active.ModelId, IsDefault: false))
            .ToList();
    }

    private async Task OnModelChangedAsync(int? providerId)
    {
        if (_loading || _running || _resetting) return;
        if (ChatTurns.GetActiveTurn(ProjectId) is not null)
        {
            _error = "Research Chat is still working in another window. Stop or wait for that turn before changing its model.";
            return;
        }
        try
        {
            await Research.SetSelectedProviderAsync(ProjectId, providerId);
            _selectedProviderId = await Providers.NormalizeChatModelSelectionAsync(providerId);
            await LoadChatProviderStateAsync();
            UpdateConversationTokenCount();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private ChatTurnModelSnapshot Snapshot(LlmProvider provider) =>
        new(provider.Id, provider.ModelId, _chatSelection?.Label ?? $"{provider.DisplayName ?? provider.Name} · {provider.ModelId}", provider.EffectiveMaxInputTokens, provider.ResolvedMetadata);

    private void RebuildRenderable(DateTime? excludeMessagesCreatedAtOrAfter = null)
    {
        var messages = excludeMessagesCreatedAtOrAfter is { } cutoff
            ? _messages.Where(message => message.CreatedAt < cutoff).ToList()
            : _messages;

        var byCallId = messages
            .Where(message => message.Role == ResearchMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<ChatRenderableMessage>(messages.Count);
        foreach (var message in messages)
        {
            if (message.Role is ResearchMessageRole.Tool or ResearchMessageRole.System) continue;
            _renderable.Add(new ChatRenderableMessage(
                message.Id,
                message.Role == ResearchMessageRole.User ? ChatMessageRole.User : ChatMessageRole.Assistant,
                ToChatStatus(message.Status),
                BuildPartsWithImages(message, byCallId)));
        }
    }

    private List<ChatMessagePart> BuildPartsWithImages(ResearchMessage message, IReadOnlyDictionary<string, ResearchMessage> byCallId)
    {
        var parts = BuildMessageParts(message, byCallId);
        if (message.Role == ResearchMessageRole.Assistant && !string.IsNullOrWhiteSpace(message.Reasoning))
        {
            var reasoningPart = new ChatReasoningPart();
            reasoningPart.Append(message.Reasoning);
            parts.Insert(0, reasoningPart);
        }
        if (message.Role == ResearchMessageRole.User && _messageImages.TryGetValue(message.Id, out var images))
            ChatImageParts.Append(parts, images);
        return parts;
    }

    private static ChatMessageStatus ToChatStatus(ResearchMessageStatus status) => status switch
    {
        ResearchMessageStatus.Failed => ChatMessageStatus.Failed,
        ResearchMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        ResearchMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            ChatTranscriptTokenCounter.ModelReplayMessages(
                _messages,
                message => message.Role.ToString(),
                message => message.Content),
            message => message,
            _live,
            _pendingUserText,
            _systemPrompt);
    }

    private static List<ChatMessagePart> BuildMessageParts(ResearchMessage message, IReadOnlyDictionary<string, ResearchMessage> byCallId)
    {
        if (message.Role != ResearchMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls.Select((call, index) => new { Call = call, Index = index })
                                      .OrderBy(item => item.Call.TextOffset!.Value)
                                      .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));
            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content)) parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls) parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, ResearchMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        return new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMessage?.Status == ResearchMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == ResearchMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = resultMessage is not null,
        };
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force) _forceScrollKey++;
    }

    private Task ResumeAutoFollowAsync()
    {
        _autoFollowKey++;
        return Task.CompletedTask;
    }

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        StopListening();
        return ValueTask.CompletedTask;
    }
}
