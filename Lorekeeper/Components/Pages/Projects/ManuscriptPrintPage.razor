@page "/projects/{Slug}/manuscript/print"
@layout PrintLayout
@rendermode InteractiveServer
@using Lorekeeper.ImportExport
@using Lorekeeper.Projects
@implements IAsyncDisposable
@inject IProjectService Projects
@inject IProjectImportExportService Transfers
@inject IJSRuntime JS

<PageTitle>@PageTitleText</PageTitle>

@if (_loading)
{
    <div class="print-status text-muted"><em>Loading manuscript...</em></div>
}
else if (_notFound)
{
    <div class="print-status alert alert-warning">
        <strong>Project not found.</strong>
        <a href="/" class="alert-link ms-2">Back to projects</a>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="print-status alert alert-danger">@_error</div>
}
else if (_manuscript is not null)
{
    <div class="print-toolbar">
        <a class="btn btn-sm btn-outline-secondary" href="/projects/@_manuscript.ProjectSlug/import-export">Back</a>
        <button type="button" class="btn btn-sm btn-primary" @onclick="PrintAsync">Print / Save PDF</button>
        <span class="print-toolbar-meta">@(_manuscript.Options.IncludeSynopses ? "Synopses included" : "Clean manuscript")</span>
    </div>

    <article class="manuscript-print">
        <header class="manuscript-title-page">
            <h1>@_manuscript.ProjectName</h1>
        </header>

        @if (_manuscript.Sections.Count == 0)
        {
            <section class="manuscript-empty">
                <p>No chapters to print.</p>
            </section>
        }
        else
        {
            @foreach (var section in _manuscript.Sections)
            {
                <section class="manuscript-act">
                    <h2>@(section.Title)</h2>
                    @if (_manuscript.Options.IncludeSynopses && !string.IsNullOrWhiteSpace(section.Synopsis))
                    {
                        <div class="manuscript-synopsis">
                            @foreach (var paragraph in SplitParagraphs(section.Synopsis))
                            {
                                <p>@RenderParagraph(paragraph)</p>
                            }
                        </div>
                    }
                </section>

                @foreach (var chapter in section.Chapters)
                {
                    <section class="manuscript-chapter">
                        <h2>@chapter.Title</h2>
                        @if (_manuscript.Options.IncludeSynopses && !string.IsNullOrWhiteSpace(chapter.Synopsis))
                        {
                            <div class="manuscript-synopsis">
                                @foreach (var paragraph in SplitParagraphs(chapter.Synopsis))
                                {
                                    <p>@RenderParagraph(paragraph)</p>
                                }
                            </div>
                        }
                        <div class="manuscript-prose">
                            @foreach (var paragraph in SplitParagraphs(chapter.Body))
                            {
                                <p>@RenderParagraph(paragraph)</p>
                            }
                        </div>
                    </section>
                }
            }
        }
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "includeSynopses")] public bool IncludeSynopses { get; set; }
    [SupplyParameterFromQuery(Name = "autoprint")] public bool Autoprint { get; set; }

    private ManuscriptExportDocument? _manuscript;
    private string? _loadedKey;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;
    private bool _printRequested;
    private IJSObjectReference? _module;

    private string PageTitleText => _manuscript is null
        ? "Manuscript"
        : $"{_manuscript.ProjectName} - Manuscript";

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Slug}|{IncludeSynopses}";
        if (_loadedKey == key) return;

        _loadedKey = key;
        _loading = true;
        _notFound = false;
        _error = null;
        _manuscript = null;
        _printRequested = false;

        try
        {
            var project = await Projects.GetBySlugAsync(Slug);
            if (project is null)
            {
                _notFound = true;
                return;
            }

            _manuscript = await Transfers.GetManuscriptAsync(project.Id, new ManuscriptExportOptions(IncludeSynopses));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_manuscript is null || !Autoprint || _printRequested) return;

        _printRequested = true;
        await EnsureModuleAsync();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("printWhenReady"); }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task PrintAsync()
    {
        await EnsureModuleAsync();
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("printNow"); }
        catch (JSDisconnectedException) { }
    }

    private async Task EnsureModuleAsync()
    {
        if (_module is not null) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/Projects/ManuscriptPrintPage.razor.js");
        }
        catch (JSDisconnectedException) { }
    }

    private static IReadOnlyList<IReadOnlyList<string>> SplitParagraphs(string text)
    {
        var paragraphs = new List<IReadOnlyList<string>>();
        var current = new List<string>();
        foreach (var line in text.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n').Split('\n'))
        {
            if (string.IsNullOrWhiteSpace(line))
            {
                Flush();
                continue;
            }

            current.Add(line.TrimEnd());
        }

        Flush();
        return paragraphs;

        void Flush()
        {
            if (current.Count == 0) return;
            paragraphs.Add(current.ToList());
            current.Clear();
        }
    }

    private static RenderFragment RenderParagraph(IReadOnlyList<string> lines) => builder =>
    {
        var sequence = 0;
        for (var i = 0; i < lines.Count; i++)
        {
            if (i > 0)
            {
                builder.OpenElement(sequence++, "br");
                builder.CloseElement();
            }

            builder.AddContent(sequence++, lines[i]);
        }
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
