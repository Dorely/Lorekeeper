@page "/projects/{Slug}/publish/{EditionId:guid}/preview"
@layout PrintLayout
@rendermode InteractiveServer
@using Lorekeeper.Models
@using Lorekeeper.Manuscripts
@using Lorekeeper.Publish
@using Lorekeeper.Projects
@using Microsoft.AspNetCore.Components.Rendering
@implements IAsyncDisposable
@inject IProjectService Projects
@inject IPublishService Publishing
@inject IPageGeometryService PageGeometry
@inject IJSRuntime JS

<PageTitle>@PageTitleText</PageTitle>

@if (_loading)
{
    <div class="print-status text-muted"><em>Loading publish preview...</em></div>
}
else if (_notFound)
{
    <div class="print-status alert alert-warning">
        <strong>Project not found.</strong>
        <a href="/" class="alert-link ms-2">Back to projects</a>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="print-status alert alert-danger">@_error</div>
}
else if (_document is not null)
{
    <style>@((MarkupString)(
        PrintGeometryCss(_document.Profile)
        + EpubPublishFormatter.RenderSemanticInlineRules()
        + EpubPublishFormatter.RenderNamedStyleRules(_document.NamedStyles)))</style>
    <div class="print-toolbar @(Embedded ? "is-embedded" : null)">
        @if (!Embedded)
        {
            <a class="btn btn-sm btn-outline-secondary" href="/projects/@_document.ProjectSlug/publish">Back</a>
        }
        <button type="button" class="btn btn-sm btn-primary" @onclick="PrintAsync">Print / Save PDF</button>
        <span class="print-toolbar-meta">@_document.DisplayTitle</span>
    </div>

    <article class="manuscript-print">
        @if (_document.CoverAsset is { } cover)
        {
            <section class="manuscript-cover-page @CoverPageClass(_document.CoverPageLayoutKind)">
                <img src="@ImageDataUrl(cover)" alt="@cover.AltText" />
            </section>
        }

        @if (_document.Profile.IncludeTitlePage)
        {
            <header class="manuscript-title-page manuscript-sheet manuscript-sheet--normal">
                <h1>@_document.DisplayTitle</h1>
                @if (!string.IsNullOrWhiteSpace(_document.Profile.Subtitle))
                {
                    <p class="manuscript-subtitle">@_document.Profile.Subtitle</p>
                }
                @if (!string.IsNullOrWhiteSpace(_document.Profile.Author))
                {
                    <p class="manuscript-byline">by @_document.Profile.Author</p>
                }
                @if (!string.IsNullOrWhiteSpace(_document.Profile.Publisher))
                {
                    <p class="manuscript-publisher">@_document.Profile.Publisher</p>
                }
            </header>
        }

        @if (!string.IsNullOrWhiteSpace(_document.Profile.Description))
        {
            <section class="manuscript-matter manuscript-sheet manuscript-sheet--normal">
                <h2>Description</h2>
                @foreach (var paragraph in SplitParagraphs(_document.Profile.Description))
                {
                    <p>@RenderParagraph(paragraph)</p>
                }
            </section>
        }

        @foreach (var item in Matter(PublicationMatterLocation.Front))
        {
            @RenderMatter(item)
        }

        @if (_document.Profile.IncludeTableOfContents && _document.Profile.IncludeVisibleTableOfContents)
        {
            <section class="manuscript-toc manuscript-sheet manuscript-sheet--normal">
                <h2>Table of Contents</h2>
                <ol>
                    @foreach (var entry in TocEntries(_document))
                    {
                        <li class="@entry.CssClass">@entry.Title</li>
                    }
                </ol>
            </section>
        }

        @if (_document.Sections.Count == 0)
        {
            <section class="manuscript-empty manuscript-sheet manuscript-sheet--normal">
                <p>No chapters to print.</p>
            </section>
        }
        else
        {
            @foreach (var publishSection in _document.Sections)
            {
                @foreach (var placement in Placements(PublishOutlineTargetKind.Act, publishSection.ActId, PublicationImagePlacementKind.BeforeAct))
                {
                    @RenderFigure(placement)
                }

                @if (publishSection.IncludePage)
                {
                    <section class="manuscript-act manuscript-sheet manuscript-sheet--normal">
                        @if (publishSection.IncludeHeading)
                        {
                            <h2>@publishSection.Title</h2>
                        }
                        @if (_document.Profile.IncludeActSynopses && !string.IsNullOrWhiteSpace(publishSection.Synopsis))
                        {
                            <div class="manuscript-synopsis">
                                @foreach (var paragraph in SplitParagraphs(publishSection.Synopsis))
                                {
                                    <p>@RenderParagraph(paragraph)</p>
                                }
                            </div>
                        }
                    </section>
                }

                @foreach (var placement in Placements(PublishOutlineTargetKind.Act, publishSection.ActId, PublicationImagePlacementKind.AfterAct))
                {
                    @RenderFigure(placement)
                }

                @foreach (var chapter in publishSection.Chapters)
                {
                    @foreach (var placement in Placements(PublishOutlineTargetKind.Chapter, chapter.Id, PublicationImagePlacementKind.BeforeChapter))
                    {
                        @RenderFigure(placement)
                    }

                    @if (chapter.VisualMode == ChapterVisualMode.PicturePage)
                    {
                        @foreach (var placement in Placements(PublishOutlineTargetKind.Chapter, chapter.Id, PublicationImagePlacementKind.ChapterOpening))
                        {
                            @RenderFigure(placement)
                        }
                        @foreach (var frame in PicturePageFrames(chapter))
                        {
                            <section class="@frame.CssClass">
                                <img src="@PicturePageSurfaceUrl(chapter.Id, frame.RotateClockwise)" alt="@frame.AltText" />
                            </section>
                        }
                        @foreach (var placement in Placements(PublishOutlineTargetKind.Chapter, chapter.Id, PublicationImagePlacementKind.ChapterEnding))
                        {
                            @RenderFigure(placement)
                        }
                    }
                    else
                    {
                        <section class="manuscript-chapter manuscript-sheet manuscript-sheet--normal">
                            @if (chapter.IncludeHeading)
                            {
                                <h2>@chapter.Title</h2>
                            }
                            @if (_document.Profile.IncludeChapterSynopses && !string.IsNullOrWhiteSpace(chapter.Synopsis))
                            {
                                <div class="manuscript-synopsis">
                                    @foreach (var paragraph in SplitParagraphs(chapter.Synopsis))
                                    {
                                        <p>@RenderParagraph(paragraph)</p>
                                    }
                                </div>
                            }
                            @foreach (var placement in Placements(PublishOutlineTargetKind.Chapter, chapter.Id, PublicationImagePlacementKind.ChapterOpening))
                            {
                                @RenderFigure(placement, standalone: false)
                            }
                            @RenderChapterBody(chapter)
                            @foreach (var placement in Placements(PublishOutlineTargetKind.Chapter, chapter.Id, PublicationImagePlacementKind.ChapterEnding))
                            {
                                @RenderFigure(placement, standalone: false)
                            }
                        </section>
                    }

                    @foreach (var placement in Placements(PublishOutlineTargetKind.Chapter, chapter.Id, PublicationImagePlacementKind.AfterChapter))
                    {
                        @RenderFigure(placement)
                    }
                }
            }
        }

        @foreach (var item in Matter(PublicationMatterLocation.Back))
        {
            @RenderMatter(item)
        }
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public Guid EditionId { get; set; }
    [SupplyParameterFromQuery(Name = "autoprint")] public bool Autoprint { get; set; }
    [SupplyParameterFromQuery(Name = "embedded")] public bool Embedded { get; set; }

    private PublishDocument? _document;
    private string? _loadedKey;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;
    private bool _printRequested;
    private bool _printViewInitialized;
    private IJSObjectReference? _module;

    private string PageTitleText => _document is null
        ? "Publish Preview"
        : $"{_document.DisplayTitle} - Publish Preview";

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Slug}:{EditionId:N}";
        if (_loadedKey == key) return;

        _loadedKey = key;
        _loading = true;
        _notFound = false;
        _error = null;
        _document = null;
        _printRequested = false;
        _printViewInitialized = false;

        try
        {
            var project = await Projects.GetBySlugAsync(Slug);
            if (project is null)
            {
                _notFound = true;
                return;
            }

            _document = await Publishing.GetDocumentAsync(project.Id, EditionId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_document is null) return;

        await EnsureModuleAsync();
        if (_module is null) return;

        if (!_printViewInitialized)
        {
            _printViewInitialized = true;
            try { await _module.InvokeVoidAsync("initializePrintView"); }
            catch (JSDisconnectedException) { }
        }

        if (!Autoprint || _printRequested) return;

        _printRequested = true;
        try { await _module.InvokeVoidAsync("printWhenReady"); }
        catch (JSDisconnectedException) { }
    }

    private async Task PrintAsync()
    {
        await EnsureModuleAsync();
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("printNow"); }
        catch (JSDisconnectedException) { }
    }

    private async Task EnsureModuleAsync()
    {
        if (_module is not null) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/Projects/ManuscriptPrintPage.razor.js");
        }
        catch (JSDisconnectedException) { }
    }

    private IEnumerable<PublicationImagePlacementDocument> Placements(
        PublishOutlineTargetKind targetKind,
        Guid? targetId,
        PublicationImagePlacementKind placementKind)
    {
        if (_document is null || targetId is null)
            return [];

        return _document.Placements
            .Where(placement => placement.TargetKind == targetKind
                && placement.TargetId == targetId
                && placement.PlacementKind == placementKind)
            .OrderBy(placement => placement.SortOrder);
    }

    private IEnumerable<PublishMatterDocument> Matter(PublicationMatterLocation location)
    {
        if (_document is null)
            return [];
        return _document.Matter
            .Where(item => item.Location == location)
            .OrderBy(item => item.SortOrder)
            .ThenBy(item => item.Id);
    }

    private RenderFragment RenderMatter(PublishMatterDocument item) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "section");
        builder.AddAttribute(sequence++, "class", "manuscript-matter manuscript-sheet manuscript-sheet--normal");
        builder.OpenElement(sequence++, "h2");
        builder.AddContent(sequence++, PublicationMatterFormatting.Title(item));
        builder.CloseElement();
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "manuscript-prose");
        foreach (var block in item.Manuscript.Content)
        {
            builder.AddMarkupContent(
                sequence++,
                SemanticPublishFormatting.HtmlBlock(
                    block,
                    imageId => FindAsset(imageId) is { } asset
                        ? ImageDataUrl(asset)
                        : null));
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    private static IReadOnlyList<IReadOnlyList<string>> SplitParagraphs(string text)
    {
        var paragraphs = new List<IReadOnlyList<string>>();
        var current = new List<string>();
        foreach (var line in text.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n').Split('\n'))
        {
            if (string.IsNullOrWhiteSpace(line))
            {
                Flush();
                continue;
            }

            current.Add(line.TrimEnd());
        }

        Flush();
        return paragraphs;

        void Flush()
        {
            if (current.Count == 0) return;
            paragraphs.Add(current.ToList());
            current.Clear();
        }
    }

    private static RenderFragment RenderParagraph(IReadOnlyList<string> lines) => builder =>
    {
        var sequence = 0;
        for (var i = 0; i < lines.Count; i++)
        {
            if (i > 0)
            {
                builder.OpenElement(sequence++, "br");
                builder.CloseElement();
            }

            builder.AddContent(sequence++, lines[i]);
        }
    };

    private RenderFragment RenderChapterBody(PublishChapterDocument chapter) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "manuscript-prose");
        var illustrationsByBlock = chapter.IllustrationLayout.Images
            .GroupBy(block => (block.BlockId, block.AnchorPosition))
            .ToDictionary(group => group.Key, group => group.OrderBy(block => block.SortOrder).ToList());

        foreach (var block in chapter.Manuscript.Content)
        {
            RenderIllustrationBlocks(
                builder,
                ref sequence,
                illustrationsByBlock,
                block.Id,
                ChapterImageAnchorPosition.BeforeParagraph);
            builder.AddMarkupContent(
                sequence++,
                SemanticPublishFormatting.HtmlBlock(
                    block,
                    imageId => FindAsset(imageId) is { } asset
                        ? ImageDataUrl(asset)
                        : null));
            RenderIllustrationBlocks(
                builder,
                ref sequence,
                illustrationsByBlock,
                block.Id,
                ChapterImageAnchorPosition.AfterParagraph);
        }

        builder.CloseElement();
    };

    private IReadOnlyList<PicturePageFrame> PicturePageFrames(PublishChapterDocument chapter)
    {
        if (chapter.PageLayoutKind == ChapterPageLayoutKind.SingleLandscape)
        {
            return
            [
                new(
                    "manuscript-picture-frame manuscript-picture-frame--landscape is-single",
                    chapter.Title,
                    RotateClockwise: false),
            ];
        }

        if (chapter.PageLayoutKind is not (ChapterPageLayoutKind.DoublePortrait or ChapterPageLayoutKind.DoubleLandscape))
        {
            return
            [
                new(
                    "manuscript-picture-frame manuscript-picture-frame--portrait is-single",
                    chapter.Title,
                    RotateClockwise: false),
            ];
        }

        var orientation = chapter.PageLayoutKind == ChapterPageLayoutKind.DoubleLandscape
            ? "landscape"
            : "portrait";
        return _document!.Profile.PrintPicturePageSpreadMode switch
        {
            PrintPicturePageSpreadMode.SidewaysWholeSpread =>
            [
                new(
                    "manuscript-picture-frame manuscript-picture-frame--sideways-portrait is-single is-contained",
                    $"{chapter.Title}, full spread rotated clockwise",
                    RotateClockwise: true),
            ],
            PrintPicturePageSpreadMode.SplitLeaves =>
            [
                new(
                    $"manuscript-picture-frame manuscript-picture-frame--{orientation} is-double is-left",
                    $"{chapter.Title}, left page",
                    RotateClockwise: false),
                new(
                    $"manuscript-picture-frame manuscript-picture-frame--{orientation} is-double is-right",
                    $"{chapter.Title}, right page",
                    RotateClockwise: false),
            ],
            _ =>
            [
                new(
                    "manuscript-picture-frame manuscript-picture-frame--spread-portrait is-single is-contained",
                    $"{chapter.Title}, full spread",
                    RotateClockwise: false),
            ],
        };
    }

    private void RenderIllustrationBlocks(
        RenderTreeBuilder builder,
        ref int sequence,
        IReadOnlyDictionary<(string BlockId, ChapterImageAnchorPosition Position), List<IllustratedProseImageBlock>> blocksByBlock,
        string blockId,
        ChapterImageAnchorPosition position)
    {
        if (!blocksByBlock.TryGetValue((blockId, position), out var blocks)) return;
        foreach (var block in blocks)
        {
            if (FindAsset(block.ImageId) is { } asset)
                RenderVisualFigure(builder, ref sequence, asset, block.Caption);
        }
    }

    private PublishAssetDocument? FindAsset(Guid assetId) =>
        _document?.Assets.FirstOrDefault(asset => asset.Id == assetId);

    private static void RenderVisualFigure(RenderTreeBuilder builder, ref int sequence, PublishAssetDocument asset, string caption)
    {
        builder.OpenElement(sequence++, "figure");
        builder.AddAttribute(sequence++, "class", "manuscript-figure manuscript-figure--inline");
        builder.OpenElement(sequence++, "img");
        builder.AddAttribute(sequence++, "src", ImageDataUrl(asset));
        builder.AddAttribute(sequence++, "alt", asset.AltText);
        builder.CloseElement();
        if (!string.IsNullOrWhiteSpace(caption))
        {
            builder.OpenElement(sequence++, "figcaption");
            builder.AddContent(sequence++, caption);
            builder.CloseElement();
        }

        builder.CloseElement();
    }

    private static RenderFragment RenderFigure(PublicationImagePlacementDocument placement, bool standalone = true) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "figure");
        builder.AddAttribute(
            sequence++,
            "class",
            standalone
                ? "manuscript-figure manuscript-sheet manuscript-sheet--normal"
                : "manuscript-figure manuscript-figure--placement-inline");
        builder.OpenElement(sequence++, "img");
        builder.AddAttribute(sequence++, "src", ImageDataUrl(placement.Asset));
        builder.AddAttribute(sequence++, "alt", placement.Asset.AltText);
        builder.CloseElement();
        if (!string.IsNullOrWhiteSpace(placement.Caption))
        {
            builder.OpenElement(sequence++, "figcaption");
            builder.AddContent(sequence++, placement.Caption);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private static IEnumerable<TocEntry> TocEntries(PublishDocument document)
    {
        foreach (var section in document.Sections)
        {
            if (section.IncludePage)
                yield return new TocEntry(section.Title, "act");
            foreach (var chapter in section.Chapters)
                yield return new TocEntry(chapter.Title, "chapter");
        }
    }

    private static string ImageDataUrl(PublishAssetDocument asset) =>
        $"data:{asset.ContentType};base64,{Convert.ToBase64String(asset.Data)}";

    private string PicturePageSurfaceUrl(Guid chapterId, bool rotateClockwise)
    {
        var rotation = rotateClockwise ? "&rotation=Clockwise90" : string.Empty;
        return $"/projects/{_document!.ProjectId:N}/publish/picture-pages/{chapterId:N}/surface?physicalPageLongEdge=2400{rotation}";
    }

    private static string CoverPageClass(ChapterPageLayoutKind? kind) => kind switch
    {
        ChapterPageLayoutKind.SingleLandscape => "manuscript-cover-page--landscape",
        ChapterPageLayoutKind.DoublePortrait => "manuscript-cover-page--double-portrait",
        ChapterPageLayoutKind.DoubleLandscape => "manuscript-cover-page--double-landscape",
        _ => "manuscript-cover-page--portrait",
    };

    private string PrintGeometryCss(PublishDocumentProfile profile)
    {
        var portrait = Geometry(profile, ChapterPageLayoutKind.SinglePortrait);
        var landscape = Geometry(profile, ChapterPageLayoutKind.SingleLandscape);
        var doublePortrait = Geometry(profile, ChapterPageLayoutKind.DoublePortrait);
        var doubleLandscape = Geometry(profile, ChapterPageLayoutKind.DoubleLandscape);
        static string Number(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

        return $$"""
            .manuscript-print {
              --normal-page-width: {{Number(portrait.PageWidthInches)}}in;
              --normal-page-height: {{Number(portrait.PageHeightInches)}}in;
              --page-margin: {{Number(portrait.PageMarginInches)}}in;
              --body-font-size: {{Number(portrait.BodyFontSizePoints)}}pt;
              --body-line-height: {{Number(portrait.BodyLineHeight)}};
              --portrait-page-width: {{Number(portrait.PageWidthInches)}}in;
              --portrait-page-height: {{Number(portrait.PageHeightInches)}}in;
              --portrait-width-number: {{Number(portrait.PageWidthInches)}};
              --portrait-height-number: {{Number(portrait.PageHeightInches)}};
              --landscape-page-width: {{Number(landscape.PageWidthInches)}}in;
              --landscape-page-height: {{Number(landscape.PageHeightInches)}}in;
              --landscape-width-number: {{Number(landscape.PageWidthInches)}};
              --landscape-height-number: {{Number(landscape.PageHeightInches)}};
              --double-portrait-width: {{Number(doublePortrait.SurfaceWidthInches)}}in;
              --double-portrait-height: {{Number(doublePortrait.SurfaceHeightInches)}}in;
              --double-portrait-width-number: {{Number(doublePortrait.SurfaceWidthInches)}};
              --double-portrait-height-number: {{Number(doublePortrait.SurfaceHeightInches)}};
              --double-landscape-width: {{Number(doubleLandscape.SurfaceWidthInches)}}in;
              --double-landscape-height: {{Number(doubleLandscape.SurfaceHeightInches)}}in;
              --double-landscape-width-number: {{Number(doubleLandscape.SurfaceWidthInches)}};
              --double-landscape-height-number: {{Number(doubleLandscape.SurfaceHeightInches)}};
            }

            @page manuscript-page { size: {{Number(portrait.PageWidthInches)}}in {{Number(portrait.PageHeightInches)}}in; margin: {{Number(portrait.PageMarginInches)}}in; }
            @page picture-portrait { size: {{Number(portrait.PageWidthInches)}}in {{Number(portrait.PageHeightInches)}}in; margin: 0; }
            @page picture-landscape { size: {{Number(landscape.PageWidthInches)}}in {{Number(landscape.PageHeightInches)}}in; margin: 0; }
            @page picture-spread-portrait { size: {{Number(portrait.PageWidthInches)}}in {{Number(portrait.PageHeightInches)}}in; margin: 0; }
            @page picture-sideways-portrait { size: {{Number(portrait.PageWidthInches)}}in {{Number(portrait.PageHeightInches)}}in; margin: 0; }
            @page cover-portrait { size: {{Number(portrait.PageWidthInches)}}in {{Number(portrait.PageHeightInches)}}in; margin: 0; }
            @page cover-landscape { size: {{Number(landscape.PageWidthInches)}}in {{Number(landscape.PageHeightInches)}}in; margin: 0; }
            @page cover-double-portrait { size: {{Number(doublePortrait.SurfaceWidthInches)}}in {{Number(doublePortrait.SurfaceHeightInches)}}in; margin: 0; }
            @page cover-double-landscape { size: {{Number(doubleLandscape.SurfaceWidthInches)}}in {{Number(doubleLandscape.SurfaceHeightInches)}}in; margin: 0; }
            """;
    }

    private BookPageGeometry Geometry(PublishDocumentProfile profile, ChapterPageLayoutKind layoutKind) =>
        PageGeometry.Calculate(
            profile.PageWidthInches,
            profile.PageHeightInches,
            profile.PageMarginInches,
            profile.BodyFontSizePoints,
            profile.BodyLineHeight,
            layoutKind);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposePrintView"); } catch (JSDisconnectedException) { }
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }

    private sealed record TocEntry(string Title, string CssClass);

    private sealed record PicturePageFrame(string CssClass, string AltText, bool RotateClockwise);

}
