@using Lorekeeper.Graph
@using Lorekeeper.Ingest
@using Lorekeeper.Models
@using Lorekeeper.Outline
@implements IAsyncDisposable
@inject IProjectGraphService ProjectGraph
@inject IJSRuntime JS

@if (Project is null)
{
    <div class="alert alert-warning">Project context is unavailable.</div>
}
else
{
    <div class="graph-workspace">
        <section class="graph-main" aria-label="Project graph workspace">
            <div class="graph-toolbar">
                <div class="graph-toolbar-group graph-search">
                    <label class="visually-hidden" for="@_searchId">Search graph</label>
                    <input id="@_searchId"
                           type="search"
                           class="form-control form-control-sm"
                           placeholder="Search nodes"
                           value="@_search"
                           @oninput="OnSearchInputAsync" />
                </div>

                <div class="graph-toolbar-group graph-type-group">
                    <label class="visually-hidden" for="@_typeFilterId">Filter by type</label>
                    <select id="@_typeFilterId" class="form-select form-select-sm graph-type-filter"
                            value="@_typeFilter" @onchange="OnTypeFilterChangedAsync">
                        <option value="">All types</option>
                        @foreach (var type in _snapshot?.NodeTypes ?? [])
                        {
                            <option value="@type.Type">@type.PluralLabel</option>
                        }
                    </select>
                </div>

                <label class="graph-toggle">
                    <input type="checkbox" checked="@_showStructural" @onchange="OnShowStructuralChangedAsync" />
                    <span>Structural</span>
                </label>

                <label class="graph-toggle">
                    <input type="checkbox" checked="@_showIngestSources" @onchange="OnShowIngestSourcesChangedAsync" />
                    <span>Ingest sources</span>
                </label>

                <label class="graph-toggle">
                    <input type="checkbox" checked="@_showManagedEdges" @onchange="OnShowManagedEdgesChangedAsync" />
                    <span>Managed links</span>
                </label>

                <label class="graph-toggle">
                    <input type="checkbox" checked="@_showAutoLinks" @onchange="OnShowAutoLinksChangedAsync" />
                    <span>Auto links</span>
                </label>

                <label class="graph-toggle">
                    <input type="checkbox" checked="@_showOnlyIngest" @onchange="OnShowOnlyIngestChangedAsync" />
                    <span>Only ingested</span>
                </label>

                <div class="graph-toolbar-spacer"></div>

                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FitAsync" disabled="@(_graphHandle is null || _snapshot is null)">
                    Fit
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TogglePhysicsAsync" disabled="@(_graphHandle is null)">
                    @(_physicsEnabled ? "Pause" : "Physics")
                </button>
                <button type="button" class="btn btn-sm btn-primary" @onclick="StartAddNode">
                    Add node
                </button>
            </div>

            <div class="graph-stage-shell">
                <div class="graph-stage" @ref="_graphHost" role="application" aria-label="Interactive project graph"></div>

                @if (_loading)
                {
                    <div class="graph-overlay">
                        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                        <span>Loading graph...</span>
                    </div>
                }
                else if (_error is not null)
                {
                    <div class="graph-overlay graph-overlay-error">
                        <strong>Graph failed to load.</strong>
                        <span>@_error</span>
                    </div>
                }
                else if ((_snapshot?.Nodes.Count ?? 0) == 0)
                {
                    <div class="graph-overlay">
                        <strong>No graph nodes yet.</strong>
                        <span>Create outline items or add a graph node to get started.</span>
                    </div>
                }

                @if (_snapshot is not null)
                {
                    <div class="graph-stats" aria-hidden="true">
                        <span>@FilteredNodeCount node@(PluralSuffix(FilteredNodeCount))</span>
                        <span>@FilteredEdgeCount link@(PluralSuffix(FilteredEdgeCount))</span>
                    </div>
                }
            </div>
        </section>

        <GraphDetailsPanel ProjectId="@Project.Id"
                           Snapshot="@_snapshot"
                           SelectedNodeId="@_selectedNodeId"
                           ShowAutoLinks="@_showAutoLinks"
                           OnSelectNode="SelectNodeFromPanelAsync"
                           OnEditNode="OpenEditNode"
                           OnAddNode="StartAddNode" />

        <GraphEditModal ProjectId="@Project.Id"
                        Snapshot="@_snapshot"
                        IsOpen="@_editModalOpen"
                        AddingNode="@_editModalAddingNode"
                        NodeId="@_editModalNodeId"
                        ShowAutoLinks="@_showAutoLinks"
                        OnClose="CloseEditModal"
                        OnChanged="OnGraphChangedAsync"
                        OnSelectNode="SelectNodeFromModalAsync" />
    </div>
}

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private readonly string _searchId = $"graph-search-{Guid.NewGuid():N}";
    private readonly string _typeFilterId = $"graph-type-{Guid.NewGuid():N}";
    private ElementReference _graphHost;
    private DotNetObjectReference<GraphContent>? _selfRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _graphHandle;

    private ProjectGraphSnapshot? _snapshot;
    private Guid _loadedProjectId;
    private long? _selectedNodeId;
    private string _search = string.Empty;
    private string _typeFilter = string.Empty;
    private bool _showStructural = true;
    private bool _showIngestSources;
    private bool _showManagedEdges = true;
    private bool _showAutoLinks;
    private bool _showOnlyIngest;
    private bool _physicsEnabled = true;
    private bool _editModalOpen;
    private bool _editModalAddingNode;
    private long? _editModalNodeId;
    private bool _loading = true;
    private bool _pendingRender;
    private string? _error;

    private int FilteredNodeCount => GetVisibleNodes().Count;
    private int FilteredEdgeCount => GetVisibleEdges(GetVisibleNodes().Select(n => n.NodeId).ToHashSet()).Count;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null || Project.Id == _loadedProjectId) return;
        _loadedProjectId = Project.Id;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _selfRef = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Projects/GraphContent.razor.js");
                _graphHandle = await _module.InvokeAsync<IJSObjectReference>("attach", _graphHost, _selfRef);
                _pendingRender = true;
            }
            catch (JSDisconnectedException)
            {
                return;
            }
        }

        if (_pendingRender && !_loading && _graphHandle is not null)
            await RenderGraphAsync();

        if (firstRender)
            await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        if (Project is null) return;
        _loading = true;
        _error = null;
        try
        {
            _snapshot = await ProjectGraph.GetSnapshotAsync(Project.Id);
            if (_selectedNodeId is long selected && !_snapshot.Nodes.Any(n => n.NodeId == selected))
                _selectedNodeId = null;
            _pendingRender = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _snapshot = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RenderGraphAsync()
    {
        if (_graphHandle is null || _snapshot is null)
        {
            _pendingRender = true;
            return;
        }

        var visibleNodes = GetVisibleNodes();
        var visibleNodeIds = visibleNodes.Select(n => n.NodeId).ToHashSet();
        var visibleEdges = GetVisibleEdges(visibleNodeIds);

        var jsNodes = visibleNodes.Select(n => new
        {
            id = n.NodeId.ToString(),
            label = n.Label,
            title = NodeTitle(n),
            type = n.Type,
            value = Math.Max(6, Math.Min(26, 8 + n.Degree * 2)),
            color = new
            {
                background = n.Color,
                border = IsIngestNode(n) ? "#fdd663" : n.IsStructural ? "#d9dde7" : "#f5f7fb",
                highlight = new { background = "#ffffff", border = n.Color }
            },
            font = new { color = "#f4f7fb", size = n.IsStructural ? 15 : 13 },
            shape = n.IsStructural ? "dot" : "ellipse",
        }).ToList();

        var jsEdges = visibleEdges.Select(e => new
        {
            id = e.EdgeId.ToString(),
            from = e.FromNodeId.ToString(),
            to = e.ToNodeId.ToString(),
            label = e.EdgeType,
            title = EdgeTitle(e),
            dashes = e.IsManaged || e.IsAutoLink,
            width = e.IsAutoLink ? 0.65 : 1,
            color = new { color = e.IsAutoLink ? "rgba(190, 198, 214, 0.24)" : IsIngestEdge(e) ? "rgba(253, 214, 99, 0.82)" : e.IsManaged ? "rgba(190, 198, 214, 0.38)" : "rgba(137, 218, 240, 0.68)", highlight = "#ffffff" },
            arrows = new { to = new { enabled = true, scaleFactor = e.IsAutoLink ? 0.35 : e.IsManaged ? 0.45 : 0.65 } },
            font = new { color = e.IsAutoLink ? "rgba(238, 242, 247, 0.42)" : "rgba(238, 242, 247, 0.72)", size = 10, strokeWidth = 0 },
        }).ToList();

        try
        {
            await _graphHandle.InvokeVoidAsync("render", jsNodes, jsEdges, new
            {
                selectedNodeId = _selectedNodeId?.ToString(),
                physics = _physicsEnabled,
            });
            _pendingRender = false;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private List<ProjectGraphNode> GetVisibleNodes()
    {
        if (_snapshot is null) return [];
        var search = _search.Trim();
        return _snapshot.Nodes
            .Where(n => _showStructural || !n.IsStructural || IsIngestSourceNode(n))
            .Where(n => _showIngestSources || !IsIngestSourceNode(n))
            .Where(n => string.IsNullOrWhiteSpace(_typeFilter) || string.Equals(n.Type, _typeFilter, StringComparison.Ordinal))
            .Where(n => !_showOnlyIngest || IsIngestNode(n))
            .Where(n => SearchMatches(n, search))
            .ToList();
    }

    private List<ProjectGraphEdge> GetVisibleEdges(IReadOnlySet<long> visibleNodeIds)
    {
        if (_snapshot is null) return [];
        return _snapshot.Edges
            .Where(e => visibleNodeIds.Contains(e.FromNodeId) && visibleNodeIds.Contains(e.ToNodeId))
            .Where(e => _showManagedEdges || !e.IsManaged)
            .Where(e => _showAutoLinks || !e.IsAutoLink)
            .Where(e => !_showOnlyIngest || IsIngestEdge(e))
            .ToList();
    }

    private static bool SearchMatches(ProjectGraphNode node, string search)
    {
        if (search.Length == 0) return true;
        if (node.Label.Contains(search, StringComparison.OrdinalIgnoreCase)) return true;
        if (node.Type.Contains(search, StringComparison.OrdinalIgnoreCase)) return true;
        if (node.Properties.Any(kv =>
            kv.Key.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (kv.Value?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)))
        {
            return true;
        }

        return node.Summary.Contains(search, StringComparison.OrdinalIgnoreCase)
            || node.Aliases.Any(alias => alias.Contains(search, StringComparison.OrdinalIgnoreCase))
            || node.WikiSections.Any(section =>
                section.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
                || section.Body.Contains(search, StringComparison.OrdinalIgnoreCase)
                || section.Citations.Any(citation => citation.SourceTitle.Contains(search, StringComparison.OrdinalIgnoreCase)))
            || node.SourceEvidence.Any(source =>
                source.SourceTitle.Contains(search, StringComparison.OrdinalIgnoreCase)
                || source.SourceKind.Contains(search, StringComparison.OrdinalIgnoreCase)
                || source.Markdown.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private static bool IsIngestNode(ProjectGraphNode node) =>
        node.IsIngestCreated
        || node.SourceEvidenceCount > 0
        || IsIngestSourceNode(node);

    private static bool IsIngestSourceNode(ProjectGraphNode node) =>
        string.Equals(node.Type, EntityTypeService.SourceNodeType, StringComparison.OrdinalIgnoreCase)
        || string.Equals(node.Type, EntityTypeService.SourceChunkNodeType, StringComparison.OrdinalIgnoreCase)
        || string.Equals(node.Type, EntityTypeService.SourceBlockNodeType, StringComparison.OrdinalIgnoreCase);

    private static bool IsIngestEdge(ProjectGraphEdge edge) =>
        edge.IsIngestCreated
        || edge.SourceEvidenceCount > 0
        || string.Equals(edge.EdgeType, IngestGraphSync.ExtractedFromEdgeType, StringComparison.OrdinalIgnoreCase);

    private static string NodeTitle(ProjectGraphNode node)
    {
        var title = $"{node.Type}: {node.Label}";
        if (!string.IsNullOrWhiteSpace(node.Summary))
            title += $"\n{node.Summary}";
        if (node.SourceEvidenceCount > 0)
            title += $"\nSource evidence: {node.SourceEvidenceCount}";
        else if (node.IsIngestCreated)
            title += "\nCreated by ingest";
        return title;
    }

    private static string EdgeTitle(ProjectGraphEdge edge)
    {
        var title = edge.EdgeType;
        if (!string.IsNullOrWhiteSpace(edge.Summary))
            title += $"\n{edge.Summary}";
        if (edge.SourceEvidenceCount > 0)
            title += $"\nSource evidence: {edge.SourceEvidenceCount}";
        else if (edge.IsAutoLink)
            title += "\nAuto mention link";
        else if (edge.IsIngestCreated || string.Equals(edge.EdgeType, IngestGraphSync.ExtractedFromEdgeType, StringComparison.OrdinalIgnoreCase))
            title += "\nIngest provenance link";
        return title;
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        await RenderGraphAsync();
    }

    private async Task OnTypeFilterChangedAsync(ChangeEventArgs e)
    {
        _typeFilter = e.Value?.ToString() ?? string.Empty;
        await RenderGraphAsync();
    }

    private async Task OnShowStructuralChangedAsync(ChangeEventArgs e)
    {
        _showStructural = e.Value is bool value && value;
        await RenderGraphAsync();
    }

    private async Task OnShowIngestSourcesChangedAsync(ChangeEventArgs e)
    {
        _showIngestSources = e.Value is bool value && value;
        await RenderGraphAsync();
    }

    private async Task OnShowManagedEdgesChangedAsync(ChangeEventArgs e)
    {
        _showManagedEdges = e.Value is bool value && value;
        await RenderGraphAsync();
    }

    private async Task OnShowAutoLinksChangedAsync(ChangeEventArgs e)
    {
        _showAutoLinks = e.Value is bool value && value;
        await RenderGraphAsync();
    }

    private async Task OnShowOnlyIngestChangedAsync(ChangeEventArgs e)
    {
        _showOnlyIngest = e.Value is bool value && value;
        await RenderGraphAsync();
    }

    private async Task FitAsync()
    {
        if (_graphHandle is null) return;
        try { await _graphHandle.InvokeVoidAsync("fit"); }
        catch (JSDisconnectedException) { }
    }

    private async Task TogglePhysicsAsync()
    {
        _physicsEnabled = !_physicsEnabled;
        if (_graphHandle is null) return;
        try { await _graphHandle.InvokeVoidAsync("setPhysics", _physicsEnabled); }
        catch (JSDisconnectedException) { }
    }

    private void StartAddNode()
    {
        _editModalAddingNode = true;
        _editModalNodeId = null;
        _editModalOpen = true;
    }

    private async Task OnGraphChangedAsync()
    {
        await LoadAsync();
        await RenderGraphAsync();
    }

    private async Task SelectNodeFromPanelAsync(long? nodeId)
    {
        _selectedNodeId = nodeId;
        if (_graphHandle is not null)
        {
            try { await _graphHandle.InvokeVoidAsync("selectNode", nodeId?.ToString()); }
            catch (JSDisconnectedException) { }
        }
    }

    private void OpenEditNode(long nodeId)
    {
        _editModalAddingNode = false;
        _editModalNodeId = nodeId;
        _editModalOpen = true;
    }

    private void CloseEditModal()
    {
        _editModalOpen = false;
        _editModalAddingNode = false;
        _editModalNodeId = null;
    }

    private async Task SelectNodeFromModalAsync(long? nodeId)
    {
        await SelectNodeFromPanelAsync(nodeId);
        _editModalAddingNode = false;
        _editModalNodeId = nodeId;
        _editModalOpen = nodeId is not null;
    }

    [JSInvokable]
    public async Task OnGraphNodeSelected(string? nodeId)
    {
        _selectedNodeId = long.TryParse(nodeId, out var parsed) ? parsed : null;
        await InvokeAsync(StateHasChanged);
    }

    private static string PluralSuffix(int value) => value == 1 ? string.Empty : "s";

    public async ValueTask DisposeAsync()
    {
        if (_graphHandle is not null)
        {
            try { await _graphHandle.InvokeVoidAsync("dispose"); } catch { }
            try { await _graphHandle.DisposeAsync(); } catch { }
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
    }
}
