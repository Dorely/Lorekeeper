@using System.Text.Json
@using Lorekeeper.EditorChat
@using Lorekeeper.Models
@using Lorekeeper.Outline
@inject IEditorChatService Chat

@if (IsOpen)
{
    <div class="contest-review-backdrop" role="presentation" @onclick="CloseAsync"></div>
    <section class="contest-review-modal" role="dialog" aria-modal="true" aria-label="Contest review">
        <header class="contest-review-header">
            <div>
                <div class="contest-review-title">Contest Review</div>
                <div class="contest-review-subtitle">Compare candidate chapter edits, then stage one for normal change review.</div>
            </div>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="contest-review-error">
                <span>@_error</span>
                <button type="button" class="btn-close btn-close-sm" @onclick="() => _error = null"></button>
            </div>
        }

        @if (Items.Count == 0)
        {
            <div class="contest-review-empty">No contest candidates yet.</div>
        }
        else
        {
            <div class="contest-review-body">
                <aside class="contest-review-list">
                    @foreach (var item in Items)
                    {
                        var selected = SelectedItem?.Candidate.Id == item.Candidate.Id;
                        <article class="contest-review-card @(selected ? "selected" : null) @StatusClass(item.Candidate.Status)"
                                 @onclick="() => Select(item.Candidate.Id)">
                            <div class="contest-review-card-main">
                                <span class="contest-review-model">@item.Candidate.ProviderName</span>
                                <span class="contest-review-status">@StatusText(item.Candidate.Status)</span>
                            </div>
                            <div class="contest-review-model-subtitle">@item.Candidate.ModelName</div>
                            @if (!string.IsNullOrWhiteSpace(item.Candidate.Summary))
                            {
                                <div class="contest-review-summary">@item.Candidate.Summary</div>
                            }
                            @if (item.Candidate.DurationMs is { } ms)
                            {
                                <div class="contest-review-meta">@(TimeSpan.FromMilliseconds(ms).TotalSeconds.ToString("F1"))s</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Candidate.ErrorMessage))
                            {
                                <div class="contest-review-error-text">@item.Candidate.ErrorMessage</div>
                            }
                        </article>
                    }
                </aside>

                <main class="contest-review-detail">
                    @if (SelectedItem is null)
                    {
                        <div class="contest-review-empty">Select a candidate to inspect.</div>
                    }
                    else
                    {
                        <div class="contest-review-detail-head">
                            <div>
                                <div class="contest-review-model large">@SelectedItem.Candidate.ProviderName</div>
                                <div class="contest-review-model-subtitle">@SelectedItem.Candidate.ModelName</div>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm"
                                    disabled="@(_busy || SelectedItem.Candidate.Status != ContestCandidateStatus.Completed)"
                                    @onclick="() => StageAsync(SelectedItem.Candidate.Id)">Stage this candidate</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedItem.Candidate.Notes))
                        {
                            <div class="contest-review-note">@SelectedItem.Candidate.Notes</div>
                        }

                        @if (SelectedItem.Candidate.Status == ContestCandidateStatus.Running || SelectedItem.Candidate.Status == ContestCandidateStatus.Pending)
                        {
                            <div class="contest-review-empty">Waiting for this candidate...</div>
                        }
                        else if (SelectedItem.Candidate.Status is ContestCandidateStatus.Failed or ContestCandidateStatus.Invalid)
                        {
                            <div class="contest-review-empty">This candidate did not produce a valid proposal.</div>
                        }
                        else if (TryBuildDiff(SelectedItem, out var reviewDiff))
                        {
                            <section class="contest-review-diff" aria-label="Candidate diff">
                                <div class="contest-review-diff-header">
                                    <div>
                                        <div class="contest-review-section-label">@reviewDiff.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(reviewDiff.Subtitle))
                                        {
                                            <div class="contest-review-diff-subtitle">@reviewDiff.Subtitle</div>
                                        }
                                    </div>
                                    <div class="contest-review-diff-stats">
                                        <span class="contest-review-diff-added">+@reviewDiff.Additions</span>
                                        <span class="contest-review-diff-removed">-@reviewDiff.Deletions</span>
                                    </div>
                                </div>

                                @if (reviewDiff.Sections.Count == 0)
                                {
                                    <div class="contest-review-empty compact">No text changes detected.</div>
                                }
                                else
                                {
                                    @foreach (var diffSection in reviewDiff.Sections)
                                    {
                                        <section class="contest-review-diff-section">
                                            @if (!string.IsNullOrWhiteSpace(diffSection.Label))
                                            {
                                                <div class="contest-review-diff-field">@diffSection.Label</div>
                                            }
                                            @foreach (var hunk in diffSection.Hunks)
                                            {
                                                <div class="contest-review-diff-hunk-header">@HunkHeader(hunk)</div>
                                                @foreach (var row in hunk.Rows)
                                                {
                                                    <div class="contest-review-diff-row @DiffRowClass(row.Kind)">
                                                        <span class="contest-review-line-number">@(row.OldLineNumber?.ToString() ?? string.Empty)</span>
                                                        <span class="contest-review-line-number">@(row.NewLineNumber?.ToString() ?? string.Empty)</span>
                                                        <span class="contest-review-marker">@row.Marker</span>
                                                        <span class="contest-review-line-text">@RenderSegments(row.Segments)</span>
                                                    </div>
                                                }
                                            }
                                        </section>
                                    }
                                }
                            </section>
                        }
                        else
                        {
                            <div class="contest-review-empty">This candidate has no renderable diff.</div>
                        }

                        <details class="contest-review-raw">
                            <summary>Candidate JSON</summary>
                            <pre>@FormatJson(SelectedItem.Candidate.RawResponse)</pre>
                        </details>
                    }
                </main>
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public IReadOnlyList<ContestBatch> Batches { get; set; } = [];
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private Guid? _selectedCandidateId;
    private bool _busy;
    private string? _error;

    private List<ContestCandidateItem> Items => Batches
        .SelectMany(batch => batch.Candidates.OrderBy(candidate => candidate.Order).Select(candidate => new ContestCandidateItem(batch, candidate)))
        .OrderByDescending(item => item.Batch.CreatedAt)
        .ThenBy(item => item.Candidate.Order)
        .ToList();

    private ContestCandidateItem? SelectedItem =>
        Items.FirstOrDefault(item => item.Candidate.Id == _selectedCandidateId)
        ?? Items.FirstOrDefault(item => item.Candidate.Status == ContestCandidateStatus.Completed)
        ?? Items.FirstOrDefault();

    protected override void OnParametersSet()
    {
        _selectedCandidateId = SelectedItem?.Candidate.Id;
    }

    private void Select(Guid candidateId) => _selectedCandidateId = candidateId;

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task StageAsync(Guid candidateId)
    {
        _busy = true;
        _error = null;
        try
        {
            await Chat.StageContestCandidateAsync(candidateId);
            if (OnChanged.HasDelegate)
                await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool TryBuildDiff(ContestCandidateItem item, out ReviewDiff diff)
    {
        var change = new AiChange
        {
            ToolName = "edit_chapter",
            ResourceKind = "ChapterBody",
            BeforeJson = JsonSerializer.Serialize(new ChapterBodyChange(item.Batch.ChapterId, item.Batch.ChapterTitle, item.Batch.OriginalChapterBody)),
            AfterJson = JsonSerializer.Serialize(new ChapterBodyChange(item.Batch.ChapterId, item.Batch.ChapterTitle, item.Candidate.ProposedBody)),
        };
        return AiChangeReviewDiffBuilder.TryBuild(change, out diff);
    }

    private static string HunkHeader(DiffHunk hunk) =>
        $"@@ -{hunk.OldStart},{hunk.OldLength} +{hunk.NewStart},{hunk.NewLength} @@";

    private static string DiffRowClass(DiffRowKind kind) => kind switch
    {
        DiffRowKind.Added => "added",
        DiffRowKind.Removed => "removed",
        _ => "context",
    };

    private static string StatusText(ContestCandidateStatus status) => status switch
    {
        ContestCandidateStatus.Invalid => "Invalid",
        ContestCandidateStatus.Selected => "Selected",
        ContestCandidateStatus.Rejected => "Not chosen",
        _ => status.ToString(),
    };

    private static string StatusClass(ContestCandidateStatus status) => status switch
    {
        ContestCandidateStatus.Completed => "completed",
        ContestCandidateStatus.Selected => "selected-status",
        ContestCandidateStatus.Failed or ContestCandidateStatus.Invalid => "failed",
        ContestCandidateStatus.Rejected => "rejected",
        ContestCandidateStatus.Running => "running",
        _ => string.Empty,
    };

    private RenderFragment RenderSegments(IReadOnlyList<DiffSegment>? segments) => __builder =>
    {
        if (segments is null) return;
        foreach (var segment in segments)
        {
            var css = segment.Kind switch
            {
                DiffSegmentKind.Added => "contest-review-segment added",
                DiffSegmentKind.Removed => "contest-review-segment removed",
                _ => "contest-review-segment",
            };
            <span class="@css">@segment.Text</span>
        }
    };

    private static string FormatJson(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        try
        {
            using var doc = JsonDocument.Parse(value);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return value;
        }
    }

    private sealed record ContestCandidateItem(ContestBatch Batch, ContestCandidate Candidate);
}
