    private int? DefaultProviderId =>
        _providers.FirstOrDefault(provider => provider.IsDefault)?.Id ?? _providers.FirstOrDefault()?.Id;

    private static int? ParseProviderId(object? value) =>
        int.TryParse(value?.ToString(), out var providerId) ? providerId : null;

    private static bool IsTextArtifact(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() is ".txt" or ".md" or ".markdown";

    private static string SourceKindFromFileName(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".pdf" => "PDF book",
            ".epub" => "EPUB book",
            ".md" or ".markdown" => "Markdown source",
            _ => "Text source",
        };

    private static bool TryNormalizeWebUrl(string value, out string normalizedUrl, out string hostKey)
    {
        normalizedUrl = string.Empty;
        hostKey = string.Empty;
        if (!Uri.TryCreate(value.Trim(), UriKind.Absolute, out var uri)) return false;
        if (uri.Scheme is not ("http" or "https")) return false;

        var builder = new UriBuilder(uri) { Fragment = string.Empty };
        if ((builder.Scheme == "http" && builder.Port == 80) ||
            (builder.Scheme == "https" && builder.Port == 443))
        {
            builder.Port = -1;
        }

        normalizedUrl = builder.Uri.AbsoluteUri;
        hostKey = uri.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase)
            ? uri.Host[4..].ToLowerInvariant()
            : uri.Host.ToLowerInvariant();
        return true;
    }

    private void SetFollowTarget(IngestJobDetailView job)
    {
        if (ShouldFollowFinalization(job))
        {
            _selectedFinalization = true;
            _selectedChunkId = null;
            return;
        }

        _selectedFinalization = false;
        _selectedChunkId = FollowChunkId(job);
    }

    private static bool ShouldFollowFinalization(IngestJobDetailView job) =>
        job.TotalSourceChunks > 0
        && job.CompletedSourceChunks >= job.TotalSourceChunks
        && (job.Finalization.EntityTotal > 0
            || job.Finalization.RelationshipTotal > 0
            || job.Finalization.SourceChunkNoteTotal > 0);

    private static Guid? FollowChunkId(IngestJobDetailView job) =>
        job.Chunks.FirstOrDefault(chunk => chunk.Status == IngestJobChunkStatus.Running)?.SourceChunkId
        ?? job.Chunks.FirstOrDefault(chunk => chunk.Status is IngestJobChunkStatus.Pending or IngestJobChunkStatus.Stopped or IngestJobChunkStatus.Failed)?.SourceChunkId
        ?? job.Chunks.OrderByDescending(chunk => chunk.SourceChunkIndex).FirstOrDefault(chunk => chunk.Status == IngestJobChunkStatus.Completed)?.SourceChunkId
        ?? job.Chunks.OrderBy(chunk => chunk.SourceChunkIndex).FirstOrDefault()?.SourceChunkId;

    private string ReportEmptyText() =>
        _selectedFinalization
            ? "No queued finalization records for this job yet."
            : "No report items for this source chunk yet.";

    private static string ReportChunkContext(IngestReportItemView item)
    {
        if (item.SourceChunkIndex is not int sourceChunkIndex)
            return string.Empty;

        var chunkLabel = $"chunk {sourceChunkIndex + 1}";
        return string.IsNullOrWhiteSpace(item.SourceChunkTitle)
            ? chunkLabel
            : $"{chunkLabel}: {item.SourceChunkTitle}";
    }

    private static string FinalizationMeta(IngestFinalizationProgressView progress)
    {
        var parts = new List<string>
        {
            $"{progress.EntityFinalized:N0}/{progress.EntityTotal:N0} entities reviewed",
            $"{progress.RelationshipFinalized:N0}/{progress.RelationshipTotal:N0} links built",
        };

        if (progress.EntityActive > 0)
            parts.Add($"{progress.EntityActive:N0} entities remaining");
        if (progress.RelationshipActive > 0)
            parts.Add($"{progress.RelationshipActive:N0} links queued");
        if (progress.SourceChunkNoteTotal > 0)
            parts.Add($"{progress.SourceChunkNoteFinalized:N0}/{progress.SourceChunkNoteTotal:N0} source notes finalized");

        var failed = progress.EntityFailed + progress.RelationshipFailed + progress.SourceChunkNoteFailed;
        if (failed > 0)
            parts.Add($"{failed:N0} failed");

        return string.Join(" - ", parts);
    }

    private static string FinalizationPhaseLabel(IngestFinalizationPhase phase) => phase switch
    {
        IngestFinalizationPhase.ReviewingEntities => "Reviewing entities",
        IngestFinalizationPhase.BuildingRelationships => "Building links",
        _ => phase.ToString(),
    };

    private static string FinalizationStatusColor(IngestFinalizationPhase phase) => phase switch
    {
        IngestFinalizationPhase.Completed => "success",
        IngestFinalizationPhase.ReviewingEntities => "primary",
        IngestFinalizationPhase.BuildingRelationships => "info text-dark",
        IngestFinalizationPhase.Failed => "danger",
        _ => "light text-dark",
    };

    private string SourceExcerpt()
    {
        if (_sourceExcerpt is null) return string.Empty;
        return _sourceExcerpt.IsTruncated
            ? _sourceExcerpt.Text + "\n..."
            : _sourceExcerpt.Text;
    }

    private static string ChunkMeta(IngestJobChunkProgress chunk)
    {
        var parts = new List<string>
        {
            $"{TokenPrefix(chunk.TokenCountIsExact)}{chunk.EstimatedTokenCount:N0} source tokens",
        };
        if (chunk.LlmTokenCount is int llmTokenCount)
            parts.Add($"{TokenPrefix(chunk.LlmTokenCountIsExact == true)}{llmTokenCount:N0} LLM tokens");
        parts.Add($"{chunk.CreatedEntityCount:N0} entities");
        parts.Add($"{chunk.CreatedRelationshipCount:N0} links");
        return string.Join(" - ", parts);
    }

    private static string TokenPrefix(bool isExact) => isExact ? string.Empty : "~";

    private static string ProviderLabel(LlmProvider provider)
    {
        var label = string.IsNullOrWhiteSpace(provider.DisplayName)
            ? provider.Name
            : provider.DisplayName;
        label = string.IsNullOrWhiteSpace(provider.ModelId) ? label : $"{label} - {provider.ModelId}";
        return provider.IsDefault ? $"{label} (default)" : label;
    }

    private static bool IsBusy(IngestJobDetailView job) => job.Status is IngestJobStatus.Queued or IngestJobStatus.Running or IngestJobStatus.StopRequested;

    private sealed record WebCrawlPageResult(string Url, int Depth, string ParentUrl, bool Success, string Message);

    private static string? ReportGraphActionLabel(IngestReportItemView item)
    {
        var action = item.Kind switch
        {
            IngestStagingRecordKind.Entity => IngestSourceAssertions.ReadEntityGraphAction(item.PayloadJson),
            IngestStagingRecordKind.Relationship => IngestSourceAssertions.ReadRelationshipGraphAction(item.PayloadJson),
            _ => null,
        };

        return action switch
        {
            IngestSourceAssertions.CreatedEntityAction => "created",
            IngestSourceAssertions.LinkedExistingEntityAction => "linked existing",
            IngestSourceAssertions.ObservedEntityAction => "observed",
            IngestSourceAssertions.CreatedEdgeAction => "created",
            IngestSourceAssertions.LinkedExistingEdgeAction => "linked existing",
            IngestSourceAssertions.ObservedRelationshipAction => "observed",
            _ => null,
        };
    }

    private static bool CanStop(IngestJobDetailView job) => job.Status is IngestJobStatus.Queued or IngestJobStatus.Running;
    private static bool CanResume(IngestJobDetailView job) => job.Status is IngestJobStatus.Stopped or IngestJobStatus.Failed;
    private static int ProgressPercent(IngestJobDetailView job) => job.TotalSourceChunks <= 0 ? 0 : (int)Math.Round(job.CompletedSourceChunks * 100.0 / job.TotalSourceChunks);

    private static string StatusColor(IngestJobChunkStatus status) => status switch
    {
        IngestJobChunkStatus.Completed => "success",
        IngestJobChunkStatus.Running => "primary",
        IngestJobChunkStatus.Failed => "danger",
        IngestJobChunkStatus.Stopped => "secondary",
        _ => "light text-dark",
    };

    private async Task StopSubscriptionAsync()
    {
        if (_subscriptionCts is not null)
            await _subscriptionCts.CancelAsync();
        if (_subscription is not null)
            await _subscription.DisposeAsync();
        if (_subscriptionTask is not null)
        {
            try { await _subscriptionTask; }
            catch (OperationCanceledException) { }
        }
        _subscriptionCts?.Dispose();
        _subscriptionCts = null;
        _subscription = null;
        _subscriptionTask = null;
    }

    public async ValueTask DisposeAsync()
    {
        await StopSubscriptionAsync();
        if (_selectionCts is not null)
        {
            await _selectionCts.CancelAsync();
            _selectionCts.Dispose();
        }
        _refreshLock.Dispose();
    }
}
