    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _readingFile = true;
        _formError = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _artifactBytes = ms.ToArray();
            _artifactFileName = file.Name;
            _artifactContentType = file.ContentType;

            if (IsTextArtifact(file.Name))
            {
                using var reader = new StreamReader(new MemoryStream(_artifactBytes));
                _sourceText = await reader.ReadToEndAsync();
            }
            else
            {
                _sourceText = string.Empty;
            }

            if (string.IsNullOrWhiteSpace(_title)) _title = Path.GetFileNameWithoutExtension(file.Name);
            if (string.IsNullOrWhiteSpace(_sourceKind))
                _sourceKind = SourceKindFromFileName(file.Name);
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _readingFile = false;
        }
    }

