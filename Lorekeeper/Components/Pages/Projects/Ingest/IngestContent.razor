    private void StartSubscription(Guid projectId)
    {
        _subscriptionCts = new CancellationTokenSource();
        _subscription = Notifier.Subscribe(projectId);
        _subscriptionTask = ListenForUpdatesAsync(_subscription, _subscriptionCts.Token);
    }

    private async Task ListenForUpdatesAsync(IIngestJobUpdateSubscription subscription, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (var update in subscription.ReadAllAsync(cancellationToken))
            {
                await InvokeAsync(async () => await RefreshForUpdateAsync(update));
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshForUpdateAsync(IngestJobUpdate update)
    {
        if (Project is null || update.ProjectId != Project.Id) return;
        if (update.Kind == IngestJobUpdateKind.Live)
        {
            ApplyLiveUpdate(update);
            StateHasChanged();
            return;
        }

        if (!await _refreshLock.WaitAsync(0))
        {
            _refreshAgain = true;
            return;
        }

        try
        {
            do
            {
                _refreshAgain = false;
                await RefreshJobListAsync();

                if (_selectedJob?.Id == update.JobId)
                {
                    if (update.Kind == IngestJobUpdateKind.Deleted)
                    {
                        _selectedJob = null;
                        _selectedChunkId = null;
                        _selectedFinalization = false;
                        _reportItems = [];
                        _sourceExcerpt = null;
                        ClearLiveIngest();
                        if (_jobs.Count > 0)
                            await SelectJobAsync(_jobs[0].Id);
                    }
                    else
                    {
                        await RefreshSelectedJobAsync();
                    }
                }
            } while (_refreshAgain);

            StateHasChanged();
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    private void ApplyLiveUpdate(IngestJobUpdate update)
    {
        if (_selectedJob?.Id != update.JobId || update.Live is null) return;

        var live = update.Live;
        switch (live)
        {
            case IngestLiveTurnStarted started:
                EnsureLiveTurn(update.JobId, started.SourceChunkId, started.SourceChunkTitle, reset: _liveSourceChunkId != started.SourceChunkId);
                _liveStatus = started.Attempt == 1
                    ? $"Attempt {started.Attempt}/{started.MaxAttempts}"
                    : $"Retry {started.Attempt}/{started.MaxAttempts}";
                if (started.Attempt > 1)
                    _liveIngest?.AppendText($"\nAttempt {started.Attempt} of {started.MaxAttempts}.\n");
                break;

            case IngestLiveTextDelta delta:
                EnsureLiveTurn(update.JobId, delta.SourceChunkId, delta.SourceChunkTitle);
                _liveIngest?.AppendText(delta.Text);
                break;

            case IngestLiveToolCallStarted started:
                EnsureLiveTurn(update.JobId, started.SourceChunkId, started.SourceChunkTitle);
                _liveIngest?.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                break;

            case IngestLiveToolCallArgumentsDelta delta:
                EnsureLiveTurn(update.JobId, delta.SourceChunkId, delta.SourceChunkTitle);
                _liveIngest?.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                break;

            case IngestLiveToolCallCompleted completed:
                EnsureLiveTurn(update.JobId, completed.SourceChunkId, completed.SourceChunkTitle);
                _liveIngest?.CompleteToolCall(completed.CallId, completed.Result, completed.Error, completed.DurationMs);
                break;

            case IngestLiveTokenCountUpdated tokenCount:
                EnsureLiveTurn(update.JobId, tokenCount.SourceChunkId, tokenCount.SourceChunkTitle);
                _liveLlmTokenCount = tokenCount.TokenCount;
                _liveLlmTokenCountIsExact = tokenCount.IsExact;
                _liveLlmTokenCountMethod = tokenCount.Method;
                _liveLlmTokenEncodingName = tokenCount.EncodingName;
                break;

            case IngestLiveRetryScheduled retry:
                EnsureLiveTurn(update.JobId, retry.SourceChunkId, retry.SourceChunkTitle);
                _liveStatus = $"Retrying in {retry.DelayMs / 1000.0:0.#}s";
                _liveIngest?.AppendText($"\nTransient error: {retry.Error}\nRetrying...\n");
                break;

            case IngestLiveTurnCompleted completed:
                EnsureLiveTurn(update.JobId, completed.SourceChunkId, completed.SourceChunkTitle);
                _liveStatus = "Completed";
                break;

            case IngestLiveTurnFailed failed:
                EnsureLiveTurn(update.JobId, failed.SourceChunkId, failed.SourceChunkTitle);
                _liveStatus = "Failed";
                _liveIngest?.AppendText($"\nFailed: {failed.Error}");
                break;
        }
    }

    private void EnsureLiveTurn(Guid jobId, Guid sourceChunkId, string sourceChunkTitle, bool reset = false)
    {
        if (reset || _liveIngest is null || _liveJobId != jobId || _liveSourceChunkId != sourceChunkId)
        {
            _liveIngest = new ChatLiveTurn();
            _liveJobId = jobId;
            _liveSourceChunkId = sourceChunkId;
            _liveSourceChunkTitle = sourceChunkTitle;
            _liveStatus = null;
            _liveLlmTokenCount = null;
            _liveLlmTokenCountIsExact = true;
            _liveLlmTokenCountMethod = null;
            _liveLlmTokenEncodingName = null;
        }
    }

    private void ClearLiveIngest()
    {
        _liveJobId = null;
        _liveSourceChunkId = null;
        _liveSourceChunkTitle = string.Empty;
        _liveStatus = null;
        _liveLlmTokenCount = null;
        _liveLlmTokenCountIsExact = true;
        _liveLlmTokenCountMethod = null;
        _liveLlmTokenEncodingName = null;
        _liveIngest = null;
    }

