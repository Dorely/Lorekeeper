@using Lorekeeper.Ingest
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Lorekeeper.Components.Chat
@using Lorekeeper.Research
@implements IAsyncDisposable
@inject IIngestService Ingest
@inject ILlmProviderService Providers
@inject IIngestJobNotifier Notifier
@inject IWebIngestCandidateService WebCandidates

@if (Project is null)
{
    <p class="text-muted"><em>Loading...</em></p>
}
else
{
    <div class="ingest-pane">
        <section class="ingest-column ingest-create">
            <div class="ingest-section-title">New Source</div>
            @if (ChatDisabled)
            {
                <div class="alert alert-warning py-2 small">
                    LLM ingest is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
                </div>
            }
            <div class="mb-2">
                <label class="form-label small text-muted">Title</label>
                <input class="form-control form-control-sm" @bind="_title" @bind:event="oninput" />
            </div>
            <div class="ingest-two">
                <div>
                    <label class="form-label small text-muted">Kind</label>
                    <input class="form-control form-control-sm" placeholder="Book, wiki, paper..." @bind="_sourceKind" @bind:event="oninput" />
                </div>
                <div>
                    <label class="form-label small text-muted">Model</label>
                    <select class="form-select form-select-sm" value="@(_providerId?.ToString() ?? string.Empty)" @onchange="OnProviderChanged">
                        <option value="">Select model</option>
                        @foreach (var provider in _providers)
                        {
                            <option value="@provider.Id">@ProviderLabel(provider)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">Description</label>
                <textarea class="form-control form-control-sm" rows="2" @bind="_description" @bind:event="oninput"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">Extraction instructions (optional)</label>
                <textarea class="form-control form-control-sm" rows="4" @bind="_instructions" @bind:event="oninput"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">Extraction profile</label>
                <select class="form-select form-select-sm" @bind="_extractionProfile">
                    <option value="@IngestExtractionProfile.Auto">Auto</option>
                    <option value="@IngestExtractionProfile.StoryWorldbuilding">Story / Worldbuilding</option>
                    <option value="@IngestExtractionProfile.ResearchNonfiction">Research / Nonfiction</option>
                </select>
            </div>
            <div class="ingest-section-title mt-3">Webpage</div>
            <div class="mb-2">
                <label class="form-label small text-muted">URL</label>
                <input type="url" class="form-control form-control-sm" placeholder="https://example.com/page" @bind="_webUrl" @bind:event="oninput" />
            </div>
            <div class="ingest-web-controls">
                <label class="form-check small">
                    <input class="form-check-input" type="checkbox" @bind="_webFollowLinks" />
                    <span class="form-check-label">Follow same-domain links</span>
                </label>
                <div>
                    <label class="form-label small text-muted">Depth</label>
                    <input type="number" class="form-control form-control-sm" min="0" max="3" @bind="_webFollowDepth" />
                </div>
                <div>
                    <label class="form-label small text-muted">Max pages</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="25" @bind="_webMaxPages" />
                </div>
            </div>
            <div class="ingest-web-actions">
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!CanCreateWebpage || _webReading)" @onclick="IngestWebpageAsync">
                    @StartWebIngestButtonText
                </button>
                @if (!_webReading && WebCreateBlockedReason is { Length: > 0 } webBlockedReason)
                {
                    <span class="form-text small text-muted">@webBlockedReason</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_webStatus))
            {
                <div class="alert alert-success py-2 small mt-2">@_webStatus</div>
            }
            @if (!string.IsNullOrWhiteSpace(_webError))
            {
                <div class="alert alert-danger py-2 small mt-2">@_webError</div>
            }
            @if (_webCrawlResults.Count > 0)
            {
                <div class="ingest-web-results">
                    <div class="ingest-web-results-head">
                        <span>Web crawl results</span>
                        <button type="button" class="btn btn-link btn-sm" @onclick="ClearWebResults">Clear</button>
                    </div>
                    @foreach (var result in _webCrawlResults)
                    {
                        <div class="ingest-web-result @(result.Success ? "success" : "failed")">
                            <div class="ingest-web-result-main">
                                <span class="badge bg-@(result.Success ? "success" : "danger")">@(result.Success ? "Read" : "Failed")</span>
                                <span>@result.Url</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(result.Message))
                            {
                                <div class="small text-muted">@result.Message</div>
                            }
                        </div>
                    }
                </div>
            }
            <div class="mb-2">
                <label class="form-label small text-muted">Source text</label>
                <InputFile OnChange="OnFileSelectedAsync" class="form-control form-control-sm mb-2" />
                @if (!string.IsNullOrWhiteSpace(_artifactFileName))
                {
                    <div class="ingest-artifact-status">
                        <span>@_artifactFileName</span>
                        <span class="text-muted">@ArtifactModeLabel</span>
                        <button type="button" class="btn btn-link btn-sm" @onclick="ClearSelectedArtifact">Clear</button>
                    </div>
                }
                @if (IsSelectedPdfArtifact)
                {
                    <div class="ingest-pdf-options">
                        <label class="form-check small">
                            <input class="form-check-input" type="checkbox" @bind="_pdfForceVision" />
                            <span class="form-check-label">Read every PDF page with vision</span>
                        </label>
                        <div>
                            <label class="form-label small text-muted">Max pages</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="500" @bind="_pdfMaxPages" />
                        </div>
                        <div>
                            <label class="form-label small text-muted">DPI</label>
                            <input type="number" class="form-control form-control-sm" min="72" max="300" @bind="_pdfVisionDpi" />
                        </div>
                    </div>
                    @if (_pdfForceVision && _providerId is int providerId && !_visionProviderIds.Contains(providerId))
                    {
                        <div class="form-text small text-warning">The selected provider must pass Test Vision before force-vision PDF ingest can start.</div>
                    }
                }
                <textarea class="form-control form-control-sm ingest-source-input" rows="12" @bind="_sourceText" @bind:event="oninput"></textarea>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="alert alert-danger py-2 small">@_formError</div>
            }
            @if (_providers.Count == 0)
            {
                <div class="alert alert-warning py-2 small">No working chat models.</div>
            }
            <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanCreate || _creating)" @onclick="CreateAsync">
                @StartIngestButtonText
            </button>
            @if (!_creating && CreateBlockedReason is { Length: > 0 } createBlockedReason)
            {
                <div class="form-text small text-muted">@createBlockedReason</div>
            }

            <div class="ingest-section-title mt-4">Jobs</div>
            @if (_loadingJobs)
            {
                <p class="text-muted small"><em>Loading jobs...</em></p>
            }
            else if (_jobs.Count == 0)
            {
                <p class="text-muted small">No ingest jobs yet.</p>
            }
            else
            {
                <div class="ingest-job-list">
                    @foreach (var job in _jobs)
                    {
                        var selected = _selectedJob?.Id == job.Id;
                        <button type="button" class="ingest-job-row @(selected ? "selected" : null)" @onclick="() => SelectJobAsync(job.Id)">
                            <span class="ingest-job-title">@job.SourceTitle</span>
                            <span class="ingest-job-meta">@job.Status - @job.CompletedSourceChunks/@job.TotalSourceChunks chunks</span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="ingest-column ingest-progress">
            @if (_selectedJob is null)
            {
                <div class="text-muted small"><em>Select an ingest job to inspect progress.</em></div>
            }
            else
            {
                <div class="ingest-selected-head">
                    <div>
                        <div class="ingest-section-title mb-1">@_selectedJob.SourceTitle</div>
                        <div class="small text-muted">@_selectedJob.Status - @_selectedJob.CurrentMessage</div>
                        @if (!string.IsNullOrWhiteSpace(_selectedJob.ModelName))
                        {
                            <div class="small text-muted">@_selectedJob.ModelName</div>
                        }
                    </div>
                    <div class="ingest-actions">
                        @if (CanResume(_selectedJob))
                        {
                            <select class="form-select form-select-sm ingest-model-select" value="@(_resumeProviderId?.ToString() ?? string.Empty)" @onchange="OnResumeProviderChanged">
                                <option value="">Select model</option>
                                @foreach (var provider in _providers)
                                {
                                    <option value="@provider.Id">@ProviderLabel(provider)</option>
                                }
                            </select>
                        }
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_jobActionBusy || !CanStop(_selectedJob))" @onclick="StopAsync">Stop</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_jobActionBusy || ChatDisabled || !CanResume(_selectedJob) || _resumeProviderId is null)" @onclick="ResumeAsync">Resume</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_jobActionBusy || ChatDisabled || IsBusy(_selectedJob))" @onclick="RestartAsync">Restart</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_jobActionBusy || IsBusy(_selectedJob))" @onclick="DeleteAsync">Delete</button>
                    </div>
                </div>

                <div class="ingest-progress-bar" aria-label="Ingest progress">
                    <div style="width:@ProgressPercent(_selectedJob)%"></div>
                </div>
                <div class="ingest-counters">
                    <span>@_selectedJob.CompletedSourceChunks / @_selectedJob.TotalSourceChunks source chunks</span>
                    <span>@_selectedJob.CreatedEntityCount entities</span>
                    <span>@_selectedJob.CreatedRelationshipCount links</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedJob.ErrorMessage))
                {
                    <div class="alert alert-danger py-2 small">@_selectedJob.ErrorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_jobActionError))
                {
                    <div class="alert alert-danger py-2 small">@_jobActionError</div>
                }
                @if (_liveIngest is not null && _liveJobId == _selectedJob.Id)
                {
                    <div class="ingest-live-panel">
                        <div class="ingest-live-head">
                            <div>
                                <div class="ingest-section-title mb-1">Current LLM Call</div>
                                <div class="small text-muted">@_liveSourceChunkTitle</div>
                            </div>
                            <div class="ingest-live-badges">
                                @if (_liveLlmTokenCount is not null)
                                {
                                    <span class="ingest-live-token-count" title="@LiveLlmTokenTitle">@LiveLlmTokenLabel</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_liveStatus))
                                {
                                    <span class="badge bg-secondary">@_liveStatus</span>
                                }
                            </div>
                        </div>
                        <div class="ingest-live-body">
                            @foreach (var message in _liveIngest.Messages)
                            {
                                <div class="ingest-live-message">
                                    @foreach (var part in message.Parts)
                                    {
                                        @if (part is ChatTextPart textPart)
                                        {
                                            <div class="ingest-live-text">@(textPart.Text.ToString())</div>
                                        }
                                        else if (part is ChatToolPart toolPart)
                                        {
                                            <ChatToolChipView Chip="@toolPart.Chip" />
                                        }
                                    }
                                </div>
                            }
                            @if (_liveIngest.IsThinking)
                            {
                                <div class="small text-muted"><em>Waiting for the model...</em></div>
                            }
                        </div>
                    </div>
                }

                <div class="ingest-section-title mt-3">Source Chunks</div>
                <div class="ingest-chunk-list">
                    @foreach (var chunk in _selectedJob.Chunks.OrderBy(chunk => chunk.SourceChunkIndex))
                    {
                        <button type="button" class="ingest-chunk-row @(!_selectedFinalization && _selectedChunkId == chunk.SourceChunkId ? "selected" : null)" @onclick="() => SelectChunkAsync(chunk.SourceChunkId)">
                            <span class="ingest-chunk-main">
                                <span>@(chunk.SourceChunkIndex + 1). @chunk.SourceChunkTitle</span>
                                <span class="badge bg-@StatusColor(chunk.Status)">@chunk.Status</span>
                            </span>
                            <span class="ingest-job-meta">@ChunkMeta(chunk)</span>
                            @if (!string.IsNullOrWhiteSpace(chunk.ErrorMessage))
                            {
                                <span class="text-danger small">@chunk.ErrorMessage</span>
                            }
                        </button>
                    }
                    <button type="button" class="ingest-chunk-row ingest-finalization-row @(_selectedFinalization ? "selected" : null)" @onclick="SelectFinalizationAsync">
                        <span class="ingest-chunk-main">
                            <span>Final review &amp; relationship build</span>
                            <span class="badge bg-@FinalizationStatusColor(_selectedJob.Finalization.Phase)">@FinalizationPhaseLabel(_selectedJob.Finalization.Phase)</span>
                        </span>
                        <span class="ingest-job-meta">@FinalizationMeta(_selectedJob.Finalization)</span>
                        <span class="ingest-finalization-hint">Graph relationship links are built after entity final review.</span>
                    </button>
                </div>

                @if (!_followCurrentChunk && IsBusy(_selectedJob))
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="FollowCurrentChunkAsync">Follow current</button>
                }

                @if (_selectedJob.Events.Count > 0)
                {
                    <div class="ingest-section-title mt-3">Events</div>
                    <div class="ingest-event-list">
                        @foreach (var jobEvent in _selectedJob.Events)
                        {
                            <details class="ingest-event-row @jobEvent.Level.ToString().ToLowerInvariant()">
                                <summary>
                                    <span>@jobEvent.Level</span>
                                    <span>@jobEvent.EventType</span>
                                    <span>@jobEvent.Message</span>
                                </summary>
                                <pre>@jobEvent.PayloadJson</pre>
                            </details>
                        }
                    </div>
                }
            }
        </section>

        <section class="ingest-column ingest-report">
            @if (_selectedJob is null)
            {
                <div class="text-muted small"><em>No report selected.</em></div>
            }
            else
            {
                var selectedChunk = SelectedSourceChunk;
                <div class="ingest-section-title">Report</div>
                @if (!string.IsNullOrWhiteSpace(_reportActionError))
                {
                    <div class="alert alert-danger py-2 small">@_reportActionError</div>
                }
                @if (selectedChunk is not null)
                {
                    <details class="ingest-source-preview" open>
                        <summary>@selectedChunk.SourceChunkTitle</summary>
                        <div class="small text-muted mb-2">
                            chars @selectedChunk.StartChar-@selectedChunk.EndChar - @selectedChunk.EstimatedTokenCount tokens - @selectedChunk.TokenCountMethod
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedChunk.SourceChunkSummary))
                        {
                            <p class="ingest-summary">@selectedChunk.SourceChunkSummary</p>
                        }
                        <pre>@SourceExcerpt()</pre>
                    </details>
                }
                else if (_selectedFinalization)
                {
                    <div class="ingest-source-preview ingest-finalization-preview">
                        <div class="ingest-chunk-main">
                            <span>Final review &amp; relationship build</span>
                            <span class="badge bg-@FinalizationStatusColor(_selectedJob.Finalization.Phase)">@FinalizationPhaseLabel(_selectedJob.Finalization.Phase)</span>
                        </div>
                        <div class="small text-muted">@FinalizationMeta(_selectedJob.Finalization)</div>
                        @if (!string.IsNullOrWhiteSpace(_selectedJob.Finalization.CurrentMessage))
                        {
                            <div class="small mt-1">@_selectedJob.Finalization.CurrentMessage</div>
                        }
                    </div>
                }

                @if (_loadingReport)
                {
                    <p class="text-muted small"><em>Loading report...</em></p>
                }
                else if (_reportItems.Count == 0)
                {
                    <p class="text-muted small">@ReportEmptyText()</p>
                }
                else
                {
                    <div class="ingest-report-list">
                        @foreach (var item in _reportItems)
                        {
                            <article class="ingest-report-item @item.Status.ToString().ToLowerInvariant()">
                                @if (_editingReportItemId == item.Id)
                                {
                                    <div class="ingest-report-edit">
                                        <div>
                                            <label class="form-label small text-muted">Title</label>
                                            <input class="form-control form-control-sm" @bind="_editTitle" @bind:event="oninput" />
                                        </div>
                                        @if (item.Kind == IngestStagingRecordKind.Relationship)
                                        {
                                            <div>
                                                <label class="form-label small text-muted">Relationship type</label>
                                                <input class="form-control form-control-sm" @bind="_editResourceType" @bind:event="oninput" />
                                            </div>
                                        }
                                        <div>
                                            <label class="form-label small text-muted">Summary</label>
                                            <textarea class="form-control form-control-sm" rows="3" @bind="_editSummary" @bind:event="oninput"></textarea>
                                        </div>
                                        <div>
                                            <label class="form-label small text-muted">Notes</label>
                                            <textarea class="form-control form-control-sm" rows="3" @bind="_editNotes" @bind:event="oninput"></textarea>
                                        </div>
                                        <div class="ingest-report-actions">
                                            <button type="button" class="btn btn-sm btn-primary" disabled="@(_savingReportItemId == item.Id)" @onclick="SaveReportItemAsync">Save</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_savingReportItemId == item.Id)" @onclick="CancelEditReportItem">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="ingest-report-head">
                                        <span>@item.Title</span>
                                        <span class="badge bg-secondary">@item.Kind</span>
                                        @if (ReportGraphActionLabel(item) is { Length: > 0 } actionLabel)
                                        {
                                            <span class="badge bg-info text-dark">@actionLabel</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Summary))
                                    {
                                        <p>@item.Summary</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="small"><strong>Notes:</strong> @item.Notes</div>
                                    }
                                    <div class="ingest-report-foot">
                                        <div class="small text-muted">
                                            @if (_selectedFinalization && ReportChunkContext(item) is { Length: > 0 } chunkContext)
                                            {
                                                <span class="ingest-report-chunk-context">@chunkContext</span>
                                            }
                                            <span>@item.Status - @item.ResourceType</span>
                                        </div>
                                        <div class="ingest-report-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(item.Status != IngestStagingRecordStatus.Active)" @onclick="() => StartEditReportItem(item)">Edit</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_deletingReportItemId == item.Id || item.Status != IngestStagingRecordStatus.Active)" @onclick="() => DeleteReportItemAsync(item.Id)">Delete</button>
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            }
        </section>
    </div>
}

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private List<IngestJobListItem> _jobs = [];
    private IngestJobDetailView? _selectedJob;
    private List<IngestReportItemView> _reportItems = [];
    private IngestSourceChunkExcerpt? _sourceExcerpt;
    private List<LlmProvider> _providers = [];
    private HashSet<int> _visionProviderIds = [];
    private ChatProviderAvailability? _chatAvailability;
    private Guid? _selectedChunkId;
    private Guid? _loadedProjectId;
    private bool _selectedFinalization;
    private bool _loadingJobs;
    private bool _loadingReport;
    private bool _creating;
    private bool _readingFile;
    private bool _webReading;
    private bool _jobActionBusy;
    private bool _followCurrentChunk = true;
    private string? _formError;
    private string? _jobActionError;
    private string? _reportActionError;
    private int? _providerId;
    private int? _resumeProviderId;
    private IIngestJobUpdateSubscription? _subscription;
    private CancellationTokenSource? _subscriptionCts;
    private Task? _subscriptionTask;
    private CancellationTokenSource? _selectionCts;
    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private bool _refreshAgain;
    private Guid? _editingReportItemId;
    private Guid? _savingReportItemId;
    private Guid? _deletingReportItemId;
    private Guid? _liveJobId;
    private Guid? _liveSourceChunkId;
    private string _liveSourceChunkTitle = string.Empty;
    private string? _liveStatus;
    private int? _liveLlmTokenCount;
    private bool _liveLlmTokenCountIsExact = true;
    private string? _liveLlmTokenCountMethod;
    private string? _liveLlmTokenEncodingName;
    private ChatLiveTurn? _liveIngest;

    private string _title = string.Empty;
    private string _sourceKind = string.Empty;
    private string _description = string.Empty;
    private string _instructions = string.Empty;
    private string _sourceText = string.Empty;
    private byte[]? _artifactBytes;
    private string? _artifactFileName;
    private string? _artifactContentType;
    private IngestExtractionProfile _extractionProfile = IngestExtractionProfile.Auto;
    private bool _pdfForceVision;
    private int _pdfMaxPages = 500;
    private int _pdfVisionDpi = 144;
    private string _webUrl = string.Empty;
    private bool _webFollowLinks;
    private int _webFollowDepth = 1;
    private int _webMaxPages = 5;
    private string? _webStatus;
    private string? _webError;
    private List<WebCrawlPageResult> _webCrawlResults = [];
    private string _editTitle = string.Empty;
    private string _editResourceType = string.Empty;
    private string _editSummary = string.Empty;
    private string _editNotes = string.Empty;

    private bool CanCreate => CreateBlockedReason is null;
    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";

    private string StartIngestButtonText =>
        _readingFile ? "Reading file..." : _creating && _artifactBytes is not null ? "Preprocessing..." : _creating ? "Starting..." : "Start ingest";

    private string StartWebIngestButtonText =>
        _webReading ? "Reading webpage..." : "Ingest webpage";

    private string? CreateBlockedReason
    {
        get
        {
            if (_readingFile) return "Reading the selected source file.";
            if (ChatDisabled) return ChatDisabledMessage;
            if (_providerId is null) return _providers.Count == 0 ? "Configure and test a model before starting ingest." : "Select a model.";
            if (_pdfForceVision && IsSelectedPdfArtifact && !_visionProviderIds.Contains(_providerId.Value)) return "Run Test Vision for the selected model before force-vision PDF ingest.";
            if (string.IsNullOrWhiteSpace(_title)) return "Add a source title.";
            if (_artifactBytes is null && string.IsNullOrWhiteSpace(_sourceText)) return "Add source text or choose a source file.";
            return null;
        }
    }

    private bool CanCreateWebpage => WebCreateBlockedReason is null;

    private string? WebCreateBlockedReason
    {
        get
        {
            if (_webReading) return "Reading webpage.";
            if (ChatDisabled) return ChatDisabledMessage;
            if (_providerId is null) return _providers.Count == 0 ? "Configure and test a model before starting ingest." : "Select a model.";
            if (string.IsNullOrWhiteSpace(_webUrl)) return "Add a webpage URL.";
            if (!TryNormalizeWebUrl(_webUrl, out _, out _)) return "Enter a valid http or https URL.";
            return null;
        }
    }

    private IngestJobChunkProgress? SelectedSourceChunk => _selectedFinalization
        ? null
        : (_selectedJob?.Chunks.FirstOrDefault(chunk => chunk.SourceChunkId == _selectedChunkId)
            ?? _selectedJob?.Chunks.OrderBy(chunk => chunk.SourceChunkIndex).FirstOrDefault());

    private string LiveLlmTokenLabel => _liveLlmTokenCount is int tokenCount
        ? $"{TokenPrefix(_liveLlmTokenCountIsExact)}{tokenCount:N0} LLM tokens"
        : string.Empty;

    private string LiveLlmTokenTitle
    {
        get
        {
            if (_liveLlmTokenCount is null)
                return string.Empty;

            var title = _liveLlmTokenCountIsExact
                ? "Current LLM call token count"
                : "Current LLM call token count is estimated";
            if (!string.IsNullOrWhiteSpace(_liveLlmTokenCountMethod))
                title += $" via {_liveLlmTokenCountMethod}";
            if (!string.IsNullOrWhiteSpace(_liveLlmTokenEncodingName))
                title += $" ({_liveLlmTokenEncodingName})";
            return title;
        }
    }

    private bool IsSelectedPdfArtifact =>
        string.Equals(Path.GetExtension(_artifactFileName), ".pdf", StringComparison.OrdinalIgnoreCase);

    private string ArtifactModeLabel =>
