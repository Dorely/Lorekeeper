        _webStatus = null;
        _webError = null;
    }

    private async Task SelectJobAsync(Guid jobId)
    {
        _selectionCts?.Cancel();
        _selectionCts?.Dispose();
        _selectionCts = new CancellationTokenSource();
        var cancellationToken = _selectionCts.Token;
        _followCurrentChunk = true;
        _jobActionError = null;
        _reportActionError = null;
        ClearLiveIngest();
        try
        {
            _selectedJob = await Ingest.GetJobViewAsync(jobId, cancellationToken);
            if (_selectedJob is null) return;
            _resumeProviderId = _selectedJob.ProviderId ?? DefaultProviderId;
            SetFollowTarget(_selectedJob);
            await LoadSelectedChunkDataAsync(cancellationToken);
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshSelectedJobAsync()
    {
        if (_selectedJob is null) return;
        var selectedJobId = _selectedJob.Id;
        var previousChunkId = _selectedChunkId;
        var previousFollow = _followCurrentChunk;
        var previousFinalization = _selectedFinalization;
        var refreshed = await Ingest.GetJobViewAsync(selectedJobId);
        if (refreshed is null)
        {
            _selectedJob = null;
            _selectedChunkId = null;
            _selectedFinalization = false;
            _reportItems = [];
            _sourceExcerpt = null;
            if (_jobs.Count > 0)
                await SelectJobAsync(_jobs[0].Id);
            return;
        }

        _selectedJob = refreshed;
        if (previousFollow)
        {
            SetFollowTarget(refreshed);
        }
        else if (previousFinalization)
        {
            _selectedFinalization = true;
            _selectedChunkId = null;
        }
        else if (refreshed.Chunks.Any(chunk => chunk.SourceChunkId == previousChunkId))
        {
            _selectedFinalization = false;
            _selectedChunkId = previousChunkId;
        }
        else
        {
            SetFollowTarget(refreshed);
        }
        await LoadSelectedChunkDataAsync(CancellationToken.None);
    }

    private async Task SelectChunkAsync(Guid sourceChunkId)
    {
        _followCurrentChunk = false;
        _selectedFinalization = false;
        _selectedChunkId = sourceChunkId;
        await LoadSelectedChunkDataAsync(CancellationToken.None);
    }

