    private async Task LoadSelectedChunkDataAsync(CancellationToken cancellationToken)
    {
        if (_selectedJob is null)
        {
            _reportItems = [];
            _sourceExcerpt = null;
            return;
        }

        _loadingReport = true;
        try
        {
            if (_selectedFinalization)
            {
                _reportItems = (await Ingest.ListReportItemViewsAsync(_selectedJob.Id, null, cancellationToken)).ToList();
                _sourceExcerpt = null;
            }
            else if (_selectedChunkId is Guid selectedChunkId)
            {
                _reportItems = (await Ingest.ListReportItemViewsAsync(_selectedJob.Id, selectedChunkId, cancellationToken)).ToList();
                _sourceExcerpt = await Ingest.GetSourceChunkExcerptAsync(selectedChunkId, cancellationToken: cancellationToken);
            }
            else
            {
                _reportItems = [];
                _sourceExcerpt = null;
            }
        }
        finally
        {
            _loadingReport = false;
        }
    }

