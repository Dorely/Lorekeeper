    private async Task IngestWebpageAsync()
    {
        if (Project is null) return;
        var blockedReason = WebCreateBlockedReason;
        if (blockedReason is not null)
        {
            _webError = blockedReason;
            return;
        }

        _webReading = true;
        _webStatus = null;
        _webError = null;
        _webCrawlResults = [];
        try
        {
            _ = TryNormalizeWebUrl(_webUrl, out var startUrl, out var startHost);
            var followDepth = _webFollowLinks ? Math.Clamp(_webFollowDepth, 0, 3) : 0;
            var maxPages = Math.Clamp(_webMaxPages, 1, 25);
            var pending = new Queue<(string Url, int Depth, string ParentUrl)>();
            var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var successfulCandidateIds = new List<Guid>();

            pending.Enqueue((startUrl, 0, string.Empty));
            while (pending.Count > 0 && visited.Count < maxPages)
            {
                var item = pending.Dequeue();
                if (!visited.Add(item.Url)) continue;

                var read = await WebCandidates.ReadUrlAsync(
                    Project.Id,
                    null,
                    item.Url,
                    item.Depth == 0 ? WebIngestCandidateDiscoveryKind.DirectUrl : WebIngestCandidateDiscoveryKind.PageLink,
                    parentUrl: item.ParentUrl,
                    crawlDepth: item.Depth);
                if (read.Candidate.Status == WebIngestCandidateStatus.Failed || string.IsNullOrWhiteSpace(read.Candidate.ExtractedText))
                {
                    _webCrawlResults.Add(new WebCrawlPageResult(
                        item.Url,
                        item.Depth,
                        item.ParentUrl,
                        Success: false,
                        string.IsNullOrWhiteSpace(read.Candidate.Diagnostics) ? "No readable text was extracted." : read.Candidate.Diagnostics));
                    continue;
                }

                await WebCandidates.StageAsync(read.Candidate.Id, item.Depth == 0
                    ? "Manual webpage ingestion."
                    : $"Manual webpage ingestion from {item.ParentUrl}.");
                successfulCandidateIds.Add(read.Candidate.Id);
                _webCrawlResults.Add(new WebCrawlPageResult(
                    item.Url,
                    item.Depth,
                    item.ParentUrl,
                    Success: true,
                    $"Read {read.Candidate.ExtractedText.Length:N0} characters."));

                if (item.Depth >= followDepth) continue;
                foreach (var link in read.Links)
                {
                    if (pending.Count + visited.Count >= maxPages) break;
                    if (!TryNormalizeWebUrl(link.Url, out var normalizedLink, out var linkHost)) continue;
                    if (!string.Equals(startHost, linkHost, StringComparison.OrdinalIgnoreCase)) continue;
                    if (visited.Contains(normalizedLink)) continue;
                    pending.Enqueue((normalizedLink, item.Depth + 1, item.Url));
                }
            }

            var failedCount = _webCrawlResults.Count(result => !result.Success);
            if (successfulCandidateIds.Count == 0)
            {
                _webError = failedCount > 0
                    ? $"No webpages were queued. {failedCount} page{(failedCount == 1 ? string.Empty : "s")} failed to read."
                    : "No webpages were queued.";
                return;
            }

            var job = await WebCandidates.QueueBatchAsync(
                Project.Id,
                successfulCandidateIds,
                _providerId,
                _instructions,
                $"{startHost} webpage crawl");

            _webStatus = $"Queued {successfulCandidateIds.Count} webpage{(successfulCandidateIds.Count == 1 ? string.Empty : "s")} into one ingest job" +
                (failedCount > 0 ? $"; {failedCount} failed to read." : ".");
            _webUrl = string.Empty;
            await ReloadJobsAsync();
            await SelectJobAsync(job.Id);
        }
        catch (Exception ex)
        {
            _webError = ex.Message;
        }
        finally
        {
            _webReading = false;
        }
    }

