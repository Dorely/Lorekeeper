@using Lorekeeper.Composition
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Chapters
@using Lorekeeper.Manuscripts
@inject IDesignedPageService DesignedPages
@inject IEditionContentService EditionContent
@inject IChapterService Chapters
@inject IManuscriptService Manuscripts
@inject IPublicationSectionService PublicationSections
@inject NavigationManager Nav

@if (Project is null)
{
    <p class="text-muted"><em>Loading pages…</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading page library…</em></p>
}
else
{
    <section class="designed-pages-library" aria-label="Project Pages">
        <header class="designed-pages-library__header">
            <div>
                <h2>Pages</h2>
                <p>Reusable Designed Pages can occur in more than one chapter or publication section. Each placement has its own stable manuscript block.</p>
            </div>
            <label class="designed-pages-library__target">
                <span>Content</span>
                <select class="form-select form-select-sm" value="@_targetKey" @onchange="ChangeTargetAsync">
                    <option value="core">Core Book</option>
                    @foreach (var release in _releases)
                    {
                        <option value="@release.EditionId">@release.Name</option>
                    }
                </select>
            </label>
            <div class="designed-pages-library__create">
                <input class="form-control form-control-sm" aria-label="New Designed Page name" @bind="_newPageName" />
                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="CreateAsync">New page</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        @if (_pages.Count == 0)
        {
            <p class="text-muted">No Designed Pages are in this library yet. Insert one from a chapter or publication section, then reuse it from its placement picker.</p>
        }
        else
        {
            <div class="designed-pages-library__grid">
                @foreach (var pageView in _pages)
                {
                    var designedPage = pageView.Page;
                    var placements = designedPage.PlacementReferences
                        .Where(item => item.EditionId == _target.EditionId)
                        .OrderBy(item => item.ContainerKind)
                        .ThenBy(item => item.CreatedAt)
                        .ToList();
                    var placementLabel = $"Placements for {designedPage.Name}";
                    <article class="designed-pages-library__card" @key="designedPage.Id">
                        <header>
                            <div>
                                <h3>@designedPage.Name</h3>
                                <small>@(pageView.IsInherited ? "Inherited from Core Book" : "Customized for this content")</small>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => DuplicateAsync(designedPage.Id)">Duplicate</button>
                            @if (_target.EditionId is not null && !pageView.IsInherited)
                            {
                                <button class="btn btn-sm btn-outline-warning" disabled="@_busy" @onclick="() => RequestResetReleaseOverride(designedPage.Id)">Use Core</button>
                            }
                        </header>
                        <p>@(string.IsNullOrWhiteSpace(pageView.Content.AccessibilityDescription) ? "Accessibility description not set." : pageView.Content.AccessibilityDescription)</p>
                        @if (placements.Count == 0)
                        {
                            <div class="designed-pages-library__unplaced">Unplaced — retained in the project library and searchable.</div>
                            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => RequestDelete(designedPage.Id)">Delete</button>
                        }
                        else
                        {
                            <ul aria-label="@placementLabel">
                                @foreach (var placement in placements)
                                {
                                    <li>
                                        <button class="btn btn-link p-0" @onclick="() => OpenPlacement(placement)">@PlacementLabel(placement)</button>
                                        <select class="form-select form-select-sm d-inline-block w-auto ms-2" value="@DestinationFor(placement)" @onchange="args => SelectDestination(PlacementKey(placement), args)">
                                            <option value="">Move to…</option>
                                            @foreach (var destination in DestinationsFor(placement))
                                            {
                                                <option value="@destination.Key">@destination.Label</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@(_busy || string.IsNullOrWhiteSpace(DestinationFor(placement)))" @onclick="() => MovePlacementAsync(placement)">Move</button>
                                        <button class="btn btn-sm btn-outline-danger ms-1" disabled="@_busy" @onclick="() => RequestRemovePlacement(placement)">Remove</button>
                                    </li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

<ConfirmationDialog IsOpen="@(_pendingDeletePageId is not null)"
                    Title="Delete this unplaced Designed Page?"
                    Message="This page has no live placements and will be removed from the project library. Its current-process Undo dependencies may be cleared; immutable Git checkpoints are never changed."
                    ConfirmLabel="Delete page"
                    CancelLabel="Keep page"
                    Destructive="true"
                    Busy="_busy"
                    OnConfirm="ConfirmDeleteAsync"
                    OnCancel="CancelDelete" />

<ConfirmationDialog IsOpen="@(_pendingResetReleaseOverridePageId is not null)"
                    Title="Reset this release Designed Page to Core?"
                    Message="This removes the release-specific content and authored layout for this shared page. Every placement in this release will inherit the current Core page again."
                    ConfirmLabel="Use Core page"
                    CancelLabel="Keep release page"
                    Destructive="true"
                    Busy="_busy"
                    OnConfirm="ConfirmResetReleaseOverrideAsync"
                    OnCancel="CancelResetReleaseOverride" />

<ConfirmationDialog IsOpen="@(_pendingPlacementRemoval is not null)"
                    Title="Remove this Designed Page placement?"
                    Message="This removes only this manuscript occurrence. The shared Designed Page stays in the project library and every other placement is unchanged."
                    ConfirmLabel="Remove placement"
                    CancelLabel="Keep placement"
                    Destructive="true"
                    Busy="_busy"
                    OnConfirm="ConfirmRemovePlacementAsync"
                    OnCancel="CancelRemovePlacement" />

@code {
    [CascadingParameter] public Project? Project { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _targetKey = "core";
    private string _newPageName = "Designed page";
    private EditorContentTarget _target = EditorContentTarget.Core;
    private IReadOnlyList<EditionContentReleaseView> _releases = [];
    private IReadOnlyList<DesignedPageView> _pages = [];
    private Guid? _loadedProjectId;
    private Guid? _pendingDeletePageId;
    private Guid? _pendingResetReleaseOverridePageId;
    private DesignedPagePlacementReference? _pendingPlacementRemoval;
    private IReadOnlyList<PlacementContainer> _placementContainers = [];
    private readonly Dictionary<string, string> _placementDestinations = new(StringComparer.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null || _loadedProjectId == Project.Id)
            return;

        _loadedProjectId = Project.Id;
        _releases = (await EditionContent.ListReleasesAsync(Project.Id))
            .Where(item => item.Enabled && !item.Archived)
            .ToList();
        await ReloadAsync();
    }

    private async Task ChangeTargetAsync(ChangeEventArgs args)
    {
        _targetKey = args.Value?.ToString() ?? "core";
        _target = Guid.TryParse(_targetKey, out var editionId)
            && _releases.Any(item => item.EditionId == editionId)
                ? EditorContentTarget.ForEdition(editionId)
                : EditorContentTarget.Core;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Project is null)
            return;
        _loading = true;
        _error = null;
        try
        {
            _pages = await DesignedPages.ListAsync(Project.Id, _target);
            await LoadPlacementContainersAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _pages = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DuplicateAsync(Guid pageId)
    {
        if (Project is null)
            return;
        _busy = true;
        try
        {
            await DesignedPages.DuplicateAsync(Project.Id, pageId, _target);
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateAsync()
    {
        if (Project is null)
            return;
        _busy = true;
        try
        {
            await DesignedPages.CreateAsync(Project.Id, _target, _newPageName.Trim());
            _newPageName = "Designed page";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void RequestDelete(Guid pageId)
    {
        if (!_busy)
            _pendingDeletePageId = pageId;
    }

    private void CancelDelete() => _pendingDeletePageId = null;

    private void RequestResetReleaseOverride(Guid pageId)
    {
        if (!_busy && _target.EditionId is not null)
            _pendingResetReleaseOverridePageId = pageId;
    }

    private void CancelResetReleaseOverride() => _pendingResetReleaseOverridePageId = null;

    private void RequestRemovePlacement(DesignedPagePlacementReference placement)
    {
        if (!_busy)
            _pendingPlacementRemoval = placement;
    }

    private void CancelRemovePlacement() => _pendingPlacementRemoval = null;

    private string DestinationFor(DesignedPagePlacementReference placement) =>
        _placementDestinations.TryGetValue(PlacementKey(placement), out var destination) ? destination : string.Empty;

    private void SelectDestination(string placementId, ChangeEventArgs args) =>
        _placementDestinations[placementId] = args.Value?.ToString() ?? string.Empty;

    private static string PlacementKey(DesignedPagePlacementReference placement) =>
        $"{placement.ContainerKind}:{placement.ContainerId:N}:{placement.EditionId:N}:{placement.Id}";

    private IEnumerable<PlacementContainer> DestinationsFor(DesignedPagePlacementReference placement) =>
        _placementContainers.Where(item => item.Kind != placement.ContainerKind || item.Id != placement.ContainerId);

    private async Task ConfirmDeleteAsync()
    {
        if (Project is null || _pendingDeletePageId is not { } pageId)
            return;
        _busy = true;
        try
        {
            await DesignedPages.DeleteAsync(Project.Id, pageId, clearAffectedHistory: true);
            _pendingDeletePageId = null;
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmResetReleaseOverrideAsync()
    {
        if (Project is null
            || _target.EditionId is not { } editionId
            || _pendingResetReleaseOverridePageId is not { } pageId)
        {
            return;
        }

        _busy = true;
        try
        {
            await DesignedPages.ResetReleaseOverrideAsync(Project.Id, pageId, editionId);
            _pendingResetReleaseOverridePageId = null;
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmRemovePlacementAsync()
    {
        if (Project is null || _pendingPlacementRemoval is not { } placement)
            return;

        if (!TryGetPlacementContainer(placement, out var source))
        {
            _error = "The placement container is no longer available. Refresh the page library and try again.";
            return;
        }

        _busy = true;
        try
        {
            await DesignedPages.RemovePlacementAsync(
                _target,
                Project.Id,
                placement.Id,
                new DesignedPageContainer(source.Kind, source.Id),
                source.Revision);
            _pendingPlacementRemoval = null;
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MovePlacementAsync(DesignedPagePlacementReference placement)
    {
        if (Project is null
            || !TryGetPlacementContainer(placement, out var source)
            || !TryGetPlacementDestination(placement, out var destination))
        {
            return;
        }

        _busy = true;
        try
        {
            await DesignedPages.MovePlacementAsync(
                _target,
                Project.Id,
                placement.Id,
                new DesignedPageContainer(source.Kind, source.Id),
                source.Revision,
                new DesignedPageContainer(destination.Kind, destination.Id),
                destination.BlockCount,
                destination.Revision);
            _placementDestinations.Remove(PlacementKey(placement));
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private bool TryGetPlacementContainer(DesignedPagePlacementReference placement, out PlacementContainer container)
    {
        container = _placementContainers.FirstOrDefault(item => item.Kind == placement.ContainerKind && item.Id == placement.ContainerId)!;
        return container is not null;
    }

    private bool TryGetPlacementDestination(DesignedPagePlacementReference placement, out PlacementContainer container)
    {
        container = null!;
        var key = DestinationFor(placement);
        return !string.IsNullOrWhiteSpace(key)
            && (container = _placementContainers.FirstOrDefault(item => item.Key == key)!) is not null;
    }

    private async Task LoadPlacementContainersAsync()
    {
        if (Project is null)
            return;

        var chapters = await Chapters.ListAsync(Project.Id);
        var chapterContainers = new List<PlacementContainer>(chapters.Count);
        foreach (var chapter in chapters)
        {
            var document = await Manuscripts.GetManuscriptAsync(_target, chapter.Id);
            if (document is not null)
            {
                chapterContainers.Add(new PlacementContainer(
                    DesignedPageContainerKind.Chapter,
                    chapter.Id,
                    chapter.Title,
                    document.Revision,
                    document.Document.Content.Count));
            }
        }

        var sections = await PublicationSections.ListAsync(new PublicationSectionTarget(Project.Id, _target.EditionId));
        _placementContainers = chapterContainers
            .Concat(sections.Select(section => new PlacementContainer(
                DesignedPageContainerKind.PublicationSection,
                section.Id,
                section.Title,
                section.Revision,
                section.Manuscript.Content.Count)))
            .OrderBy(item => item.Kind)
            .ThenBy(item => item.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void OpenPlacement(DesignedPagePlacementReference placement)
    {
        if (Project is null)
            return;
        var target = placement.EditionId is Guid editionId ? $"&edition={editionId:D}" : string.Empty;
        if (placement.ContainerKind == DesignedPageContainerKind.Chapter)
        {
            Nav.NavigateTo($"/projects/{Project.Slug}/editor/{placement.ContainerId:D}?mode=Pages&page={placement.DesignedPageId:D}&placement={Uri.EscapeDataString(placement.Id)}{target}");
            return;
        }

        Nav.NavigateTo($"/projects/{Project.Slug}/publish?section={placement.ContainerId:D}&composition={placement.DesignedPageId:D}{target}");
    }

    private static string PlacementLabel(DesignedPagePlacementReference placement) => placement.ContainerKind switch
    {
        DesignedPageContainerKind.Chapter => "Chapter placement",
        DesignedPageContainerKind.PublicationSection => "Publication section placement",
        _ => "Placement",
    };

    private sealed record PlacementContainer(
        DesignedPageContainerKind Kind,
        Guid Id,
        string Label,
        long Revision,
        int BlockCount)
    {
        public string Key => $"{Kind}:{Id:N}";
    }
}
