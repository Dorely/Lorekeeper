    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_viewerModule is not null)
        {
            try { await _viewerModule.InvokeVoidAsync("detach", _viewerRoot); } catch { }
            try { await _viewerModule.DisposeAsync(); } catch { }
            _viewerModule = null;
        }

        _selfRef?.Dispose();
        _selfRef = null;
        _textStyleSaveDebounce?.Cancel();
        _textStyleSaveDebounce?.Dispose();
        _textStyleSaveDebounce = null;
    }

