    [JSInvokable]
    public async Task MovePictureElementAsync(string kind, string elementId, double xPercent, double yPercent)
    {
        if (!CanEditLayout || State.VisualMode != ChapterVisualMode.PicturePage || !Guid.TryParseExact(elementId, "N", out var id))
            return;

        if (string.Equals(kind, "image", StringComparison.OrdinalIgnoreCase))
        {
            var image = State.PageLayout.Images.FirstOrDefault(candidate => candidate.Id == id);
            if (image is null) return;
            SelectPictureImage(id);
            await UpdatePictureImageAsync(
                id,
                Clamp(xPercent, 0, Math.Max(0, 100 - image.WidthPercent)),
                Clamp(yPercent, 0, Math.Max(0, 100 - image.HeightPercent)));
            return;
        }

        var text = State.PageLayout.TextElements.FirstOrDefault(candidate => candidate.Id == id);
        if (text is null) return;
        SelectPictureText(id);
        await UpdatePictureTextAsync(
            id,
            x: Clamp(xPercent, 0, Math.Max(0, 100 - text.WidthPercent)),
            y: Clamp(yPercent, 0, Math.Max(0, 100 - text.HeightPercent)));
    }

    [JSInvokable]
    public async Task ResizePictureElementAsync(string kind, string elementId, double widthPercent, double heightPercent)
    {
        if (!CanEditLayout || State.VisualMode != ChapterVisualMode.PicturePage || !Guid.TryParseExact(elementId, "N", out var id))
