@using Lorekeeper.ChapterVisuals
@using Lorekeeper.Images
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text
@implements IAsyncDisposable
@inject IChapterVisualService Visuals
@inject IProjectImageService ProjectImages
@inject IJSRuntime JS

<div class="paged-viewer" tabindex="0" @ref="_viewerRoot">
    @if (State.VisualMode == ChapterVisualMode.PicturePage)
    {
        var pageMetrics = PageMetrics(State.PageLayoutKind);
        var selectedText = SelectedPictureText;
        <div class="@(IsEditable ? "picture-layout picture-layout--editable" : "picture-layout")">
            @if (IsEditable)
            {
                <div class="picture-toolbar">
                    <div class="picture-toolbar__actions">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddTextBoxAsync">Add text box</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenImagesAsync">Images</button>
                        @if (selectedText is not null)
                        {
                            <div class="picture-text-toolbar" aria-label="Selected text box controls">
                                <label class="picture-text-toolbar__field">
                                    <span>Font</span>
                                    <select class="form-select form-select-sm"
                                            @bind:get="selectedText.FontFamily"
                                            @bind:set="SetSelectedTextFontFamilyAsync">
                                        <option value="@PublishCoverFontFamily.Serif">Serif</option>
                                        <option value="@PublishCoverFontFamily.Sans">Sans</option>
                                        <option value="@PublishCoverFontFamily.Display">Display</option>
                                        <option value="@PublishCoverFontFamily.Monospace">Mono</option>
                                    </select>
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--size">
                                    <span>Size</span>
                                    <input class="form-control form-control-sm"
                                           type="number"
                                           min="1"
                                           max="18"
                                           step="0.1"
                                           value="@selectedText.FontSizePercent.ToString("0.###", CultureInfo.InvariantCulture)"
                                           @onchange="SetSelectedTextFontSizeAsync" />
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--color">
                                    <span>Color</span>
                                    <input class="form-control form-control-color form-control-sm"
                                           type="color"
                                           value="@ColorInputValue(TextColorValue(selectedText))"
                                           @oninput="PreviewSelectedTextColorAsync"
                                           @onchange="SaveSelectedTextColorAsync" />
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="picture-stage">
                <section class="@PicturePageClass(pageMetrics)" style="@PicturePageStyle(pageMetrics)" @onclick="ClearSelectedPictureText">
                    @foreach (var image in State.PageLayout.Images.OrderBy(image => image.ZIndex))
                    {
                        var projectImage = ImageById(image.ImageId);
                        <div class="@(IsEditable ? "picture-element picture-element--image picture-element--editable" : "picture-element picture-element--image")"
                             style="@ElementStyle(image.XPercent, image.YPercent, image.WidthPercent, image.HeightPercent, image.ZIndex)"
                             data-picture-element-kind="@(IsEditable ? "image" : null)"
                             data-picture-element-id="@(IsEditable ? image.Id.ToString("N") : null)">
                            @if (projectImage is not null)
                            {
                                <img src="@projectImage.PreviewUrl"
                                     alt="@(string.IsNullOrWhiteSpace(image.AltTextOverride) ? projectImage.AltText : image.AltTextOverride)"
                                     style="@($"object-fit:{FitCss(image.Fit)};opacity:{image.Opacity.ToString(CultureInfo.InvariantCulture)};")" />
                            }
                            @if (IsEditable)
                            {
                                @RenderPictureCornerControls("image", image.Id)
                            }
                        </div>
                    }
                    @foreach (var text in State.PageLayout.TextElements.OrderBy(text => text.ZIndex))
                    {
                        <div class="@PictureTextElementClass(text)"
                             style="@TextElementStyle(text)"
                             @onclick="@(() => SelectPictureText(text.Id))"
                             @onclick:stopPropagation="true"
                             @onfocusin="@(() => SelectPictureText(text.Id))"
                             data-picture-element-kind="@(IsEditable ? "text" : null)"
                             data-picture-element-id="@(IsEditable ? text.Id.ToString("N") : null)">
                            @if (IsEditable)
                            {
                                <div class="picture-text-editor" contenteditable="true" role="textbox" aria-multiline="true" spellcheck="false" data-picture-text-editor="true">@text.Text</div>
                                @RenderPictureCornerControls("text", text.Id)
                            }
                            else
                            {
                                @text.Text
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    }
    else
    {
        var paragraphs = SplitParagraphs(State.Body);
        var pageMetrics = PageMetrics(State.PageLayoutKind);
        var pages = BuildProsePages(paragraphs, pageMetrics);
        var spreads = BuildProseSpreads(pages, pageMetrics.IsDouble);
        <div class="@(IsEditable ? "prose-layout prose-layout--editable" : "prose-layout")">
            @if (IsEditable)
            {
                <div class="picture-toolbar prose-toolbar">
                    <div class="picture-toolbar__actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenImagesAsync">Images</button>
                    </div>
                </div>
            }
            <div class="@ProsePagesClass(pageMetrics)" style="@ProsePageStyle(pageMetrics)">
                @foreach (var spread in spreads)
                {
                    <div class="@ProseSpreadClass(pageMetrics)" @key="spread.SpreadNumber">
                        @RenderProsePage(spread.Left)
                        @if (spread.Right is not null)
                        {
                            @RenderProsePage(spread.Right)
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private RenderFragment RenderProsePage(ProsePageModel page) =>
        @<section class="@ProsePageClass(page)" aria-label="@($"Page {page.PageNumber}")">
            @if (!page.IsBlank && page.Items.Count == 0)
            {
                <p class="empty-prose">(empty chapter)</p>
            }
            @if (!page.IsBlank)
            {
                @foreach (var item in page.Items)
                {
                    if (item.Kind == ProsePageItemKind.DropZone)
                    {
                        @RenderDropZone(item.ParagraphIndex, item.AnchorPosition)
                    }
                    else if (item.Kind == ProsePageItemKind.Illustration && item.Illustration is not null)
                    {
                        @RenderIllustrationBlock(item.Illustration)
                    }
                    else if (!string.IsNullOrWhiteSpace(item.Text))
                    {
                        <p>@item.Text</p>
                    }
                }
            }
        </section>;
    [Parameter, EditorRequired] public ChapterVisualState State { get; set; } = null!;
    [Parameter] public IReadOnlyList<ProjectImageView> Images { get; set; } = [];
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback<ChapterVisualState> OnChanged { get; set; }
    [Parameter] public EventCallback OnImagesChanged { get; set; }
    [Parameter] public EventCallback OnOpenImages { get; set; }

    private ElementReference _viewerRoot;
    private IJSObjectReference? _viewerModule;
    private DotNetObjectReference<PagedChapterViewer>? _selfRef;
    private Guid? _selectedPictureTextId;
    private readonly Dictionary<Guid, string> _textColorDrafts = [];
    private CancellationTokenSource? _textColorSaveDebounce;
    private bool _disposed;
    private const double PageMarginInches = 0.75;
    private const double BodyLineHeightInches = 12.0 / 72.0 * 1.55;
    private const double ParagraphSpacingInches = 0.14;
    private const double FigureSpacingInches = 0.16;
    private const double DropZoneHeightInches = 0.42;

    private enum ProsePageItemKind
    {
        Paragraph,
        Illustration,
        DropZone,
    }

    private sealed record ProsePageItem(
        ProsePageItemKind Kind,
        int ParagraphIndex,
        ChapterImageAnchorPosition AnchorPosition,
        string Text,
        IllustratedProseImageBlock? Illustration);

    private sealed record ProsePageModel(
        int PageNumber,
        bool IsBlank,
        IReadOnlyList<ProsePageItem> Items);

    private sealed record ProseSpreadModel(
        int SpreadNumber,
        ProsePageModel Left,
        ProsePageModel? Right);

    private sealed class ProsePageBuilder
    {
        public List<ProsePageItem> Items { get; } = [];
        public double UsedHeightInches { get; set; }
    }

    private readonly record struct PageLayoutMetrics(
        double PageWidthInches,
        double PageHeightInches,
        bool IsDouble,
        double SurfaceWidthInches,
        double SurfaceHeightInches);

    private PicturePageTextElement? SelectedPictureText =>
        _selectedPictureTextId is { } selectedId
            ? State.PageLayout.TextElements.FirstOrDefault(text => text.Id == selectedId)
            : null;

    protected override void OnParametersSet()
    {
        if (_selectedPictureTextId is not { } selectedId)
            return;

        if (!IsEditable
            || State.VisualMode != ChapterVisualMode.PicturePage
            || State.PageLayout.TextElements.All(text => text.Id != selectedId))
        {
            _selectedPictureTextId = null;
        }
    }

    private RenderFragment RenderDropZone(int paragraphIndex, ChapterImageAnchorPosition position) =>
        @<button type="button" class="illustration-drop-zone"
                 data-illustration-drop-target="true"
                 data-illustration-paragraph-index="@paragraphIndex"
                 data-illustration-anchor-position="@position.ToString()">
            @(position == ChapterImageAnchorPosition.BeforeParagraph ? "Drop image before paragraph" : "Drop image after paragraph")
        </button>;

    private RenderFragment RenderIllustrationBlock(IllustratedProseImageBlock block) =>
        @<figure class="@IllustrationBlockClass(block)"
                 style="@($"width:{block.WidthPercent.ToString(CultureInfo.InvariantCulture)}%;")"
                 data-illustration-id="@(IsEditable ? block.Id.ToString("N") : null)">
            @{
                var image = ImageById(block.ImageId);
            }
            <div class="illustration-image-box">
                @if (image is not null)
                {
                    <img src="@image.PreviewUrl" alt="@(string.IsNullOrWhiteSpace(block.AltTextOverride) ? image.AltText : block.AltTextOverride)" />
                }
                @if (IsEditable)
                {
                    <div class="illustration-element-chrome">
                        <button type="button" class="picture-corner-control picture-corner-control--move"
                                data-illustration-move="true" title="Move" aria-label="Move illustration"></button>
                        <button type="button" class="picture-corner-control picture-corner-control--remove"
                                title="Remove" aria-label="Remove illustration"
                                @onclick="@(() => RemoveIllustrationAsync(block.Id))"></button>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(block.Caption))
            {
                <figcaption>@block.Caption</figcaption>
            }
            @if (IsEditable)
            {
                <div class="illustration-controls">
                    <input class="illustration-width-control" type="range" min="20" max="100"
                           value="@block.WidthPercent.ToString(CultureInfo.InvariantCulture)"
                           aria-label="Image width"
                           @onchange="@(e => UpdateIllustrationWidthAsync(block.Id, e.Value?.ToString()))" />
                    <div class="illustration-alignment-group" role="group" aria-label="Image alignment">
                        <button type="button" class="@IllustrationAlignmentButtonClass(block.Alignment, ChapterImageAlignment.Left)" @onclick="@(() => UpdateIllustrationAlignmentAsync(block.Id, ChapterImageAlignment.Left))">Left</button>
                        <button type="button" class="@IllustrationAlignmentButtonClass(block.Alignment, ChapterImageAlignment.Center)" @onclick="@(() => UpdateIllustrationAlignmentAsync(block.Id, ChapterImageAlignment.Center))">Center</button>
                        <button type="button" class="@IllustrationAlignmentButtonClass(block.Alignment, ChapterImageAlignment.Right)" @onclick="@(() => UpdateIllustrationAlignmentAsync(block.Id, ChapterImageAlignment.Right))">Right</button>
                    </div>
                </div>
            }
        </figure>;

    private RenderFragment RenderPictureCornerControls(string kind, Guid elementId) =>
        @<div class="picture-element-chrome">
            @{
                Func<Task> onRemove = kind == "image"
                    ? () => RemovePictureImageAsync(elementId)
                    : () => RemovePictureTextAsync(elementId);
            }
            <span class="picture-corner-control picture-corner-control--move" data-picture-move="true" title="Move" aria-label="@($"Move {kind}")"></span>
            <button type="button" class="picture-corner-control picture-corner-control--remove" data-picture-remove="true" title="Remove" aria-label="@($"Remove {kind}")" @onclick="onRemove"></button>
            <span class="picture-corner-control picture-corner-control--resize" data-picture-resize="true" title="Resize" aria-label="@($"Resize {kind}")"></span>
        </div>;

    private IEnumerable<IllustratedProseImageBlock> BlocksAt(int paragraphIndex, ChapterImageAnchorPosition position) =>
        State.IllustrationLayout.Images
            .Where(block => block.ParagraphIndex == paragraphIndex && block.AnchorPosition == position)
            .OrderBy(block => block.SortOrder);

    private string IllustrationBlockClass(IllustratedProseImageBlock block)
    {
        var alignment = block.Alignment.ToString().ToLowerInvariant();
        return IsEditable
            ? $"illustration-block illustration-block--editable illustration-block--{alignment}"
            : $"illustration-block illustration-block--{alignment}";
    }

    private static string IllustrationAlignmentButtonClass(
        ChapterImageAlignment current,
        ChapterImageAlignment target) =>
        current == target
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";

    private void SelectPictureText(Guid textId)
    {
        if (!IsEditable
            || State.VisualMode != ChapterVisualMode.PicturePage
            || State.PageLayout.TextElements.All(text => text.Id != textId))
        {
            return;
        }

        _selectedPictureTextId = textId;
    }

    private void ClearSelectedPictureText() => _selectedPictureTextId = null;

    private async Task SetSelectedTextFontFamilyAsync(PublishCoverFontFamily fontFamily)
    {
        if (_selectedPictureTextId is not { } selectedId)
            return;

        await UpdatePictureTextAsync(selectedId, fontFamily: fontFamily);
    }

    private async Task SetSelectedTextFontSizeAsync(ChangeEventArgs args)
    {
        if (_selectedPictureTextId is not { } selectedId
            || !double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var fontSize))
        {
            return;
        }

        await UpdatePictureTextAsync(selectedId, fontSizePercent: Clamp(fontSize, 1, 18));
    }

    private async Task PreviewSelectedTextColorAsync(ChangeEventArgs args)
    {
        if (_selectedPictureTextId is not { } selectedId)
            return;

        var color = CleanColor(args.Value?.ToString());
        if (color is null)
            return;

        if (State.PageLayout.TextElements.All(text => text.Id != selectedId))
            return;

        _textColorDrafts[selectedId] = color;
        DebounceSelectedTextColorSave(selectedId, color);
        await Task.CompletedTask;
    }

    private async Task SaveSelectedTextColorAsync(ChangeEventArgs args)
    {
        if (_selectedPictureTextId is not { } selectedId)
            return;

        var color = CleanColor(args.Value?.ToString());
        if (color is null)
            return;

        _textColorSaveDebounce?.Cancel();
        await PersistSelectedTextColorAsync(selectedId, color);
    }

    private void DebounceSelectedTextColorSave(Guid textId, string color)
    {
        _textColorSaveDebounce?.Cancel();
        _textColorSaveDebounce?.Dispose();
        _textColorSaveDebounce = new CancellationTokenSource();
        var token = _textColorSaveDebounce.Token;

        _ = SaveSelectedTextColorAfterDelayAsync(textId, color, token);
    }

    private async Task SaveSelectedTextColorAfterDelayAsync(Guid textId, string color, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(300, cancellationToken);
            await InvokeAsync(() => PersistSelectedTextColorAsync(textId, color, cancellationToken));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PersistSelectedTextColorAsync(Guid textId, string color, CancellationToken cancellationToken = default)
    {
        if (_disposed || cancellationToken.IsCancellationRequested)
            return;

        var selectedText = State.PageLayout.TextElements.FirstOrDefault(text => text.Id == textId);
        if (selectedText is null)
        {
            _textColorDrafts.Remove(textId);
            return;
        }

        if (string.Equals(CleanColor(selectedText.Color), color, StringComparison.Ordinal))
        {
            _textColorDrafts.Remove(textId);
            return;
        }

        await UpdatePictureTextAsync(textId, color: color);
        _textColorDrafts.Remove(textId);
    }

    private async Task UpdateIllustrationWidthAsync(Guid blockId, string? value)
    {
        if (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var width)) return;
        await SaveIllustrationsAsync(State.IllustrationLayout with
        {
            Images = State.IllustrationLayout.Images.Select(block => block.Id == blockId ? block with { WidthPercent = width } : block).ToList(),
        });
    }

    private async Task UpdateIllustrationAlignmentAsync(Guid blockId, ChapterImageAlignment alignment) =>
        await SaveIllustrationsAsync(State.IllustrationLayout with
        {
            Images = State.IllustrationLayout.Images.Select(block => block.Id == blockId ? block with { Alignment = alignment } : block).ToList(),
        });

    private async Task RemoveIllustrationAsync(Guid blockId) =>
        await SaveIllustrationsAsync(State.IllustrationLayout with
        {
            Images = State.IllustrationLayout.Images.Where(block => block.Id != blockId).ToList(),
        });

    [JSInvokable]
    public async Task MoveIllustrationBlockAsync(string blockId, int paragraphIndex, string anchorPosition)
    {
        if (!IsEditable
            || State.VisualMode == ChapterVisualMode.PicturePage
            || !Guid.TryParseExact(blockId, "N", out var id)
            || !Enum.TryParse<ChapterImageAnchorPosition>(anchorPosition, ignoreCase: true, out var position))
        {
            return;
        }

        var block = State.IllustrationLayout.Images.FirstOrDefault(candidate => candidate.Id == id);
        if (block is null)
            return;

        var paragraphs = SplitParagraphs(State.Body);
        var clampedIndex = Math.Clamp(paragraphIndex, 0, Math.Max(0, paragraphs.Count - 1));
        if (block.ParagraphIndex == clampedIndex && block.AnchorPosition == position)
            return;

        await SaveIllustrationsAsync(State.IllustrationLayout with
        {
            Images = State.IllustrationLayout.Images.Select(candidate => candidate.Id == id
                ? candidate with
                {
                    ParagraphIndex = clampedIndex,
                    AnchorPosition = position,
                    ParagraphHash = string.Empty,
                }
                : candidate).ToList(),
        });
    }

    private async Task AddTextBoxAsync()
    {
        var textId = Guid.NewGuid();
        var maxOrder = State.PageLayout.TextElements.Select(text => text.ReadingOrder).DefaultIfEmpty(-1).Max();
        var maxZ = State.PageLayout.Images.Select(image => image.ZIndex)
            .Concat(State.PageLayout.TextElements.Select(text => text.ZIndex))
            .DefaultIfEmpty(0)
            .Max();
        var layout = State.PageLayout with
        {
            TextElements = State.PageLayout.TextElements
                .Append(new PicturePageTextElement(
                    textId,
                    "New text",
                    12,
                    70,
                    76,
                    16,
                    maxZ + 1,
                    maxOrder + 1,
                    PublishCoverFontFamily.Serif,
                    4.5,
                    1.25,
                    "#111827",
                    "#FFFFFF",
                    0,
                    PublishCoverTextAlign.Center,
                    ChapterTextVerticalAlign.Middle,
                    PublishCoverShadow.None))
                .ToList(),
        };
        _selectedPictureTextId = textId;
        await SavePageAsync(layout);
    }

    private async Task OpenImagesAsync()
    {
        if (OnOpenImages.HasDelegate)
            await OnOpenImages.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;

        _selfRef = DotNetObjectReference.Create(this);
        IJSObjectReference? module = null;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/Projects/PagedChapterViewer.razor.js");

            if (_disposed)
            {
                try { await module.DisposeAsync(); } catch { }
                return;
            }

            _viewerModule = module;
            await _viewerModule.InvokeVoidAsync("attach", _viewerRoot, _selfRef);
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task UpdatePictureImageAsync(Guid elementId, double? x = null, double? y = null, double? width = null, double? height = null) =>
        await SavePageAsync(State.PageLayout with
        {
            Images = State.PageLayout.Images.Select(image => image.Id == elementId
                ? image with
                {
                    XPercent = x ?? image.XPercent,
                    YPercent = y ?? image.YPercent,
                    WidthPercent = width ?? image.WidthPercent,
                    HeightPercent = height ?? image.HeightPercent,
                }
                : image).ToList(),
        });

    [JSInvokable]
    public async Task MovePictureElementAsync(string kind, string elementId, double xPercent, double yPercent)
    {
        if (!IsEditable || State.VisualMode != ChapterVisualMode.PicturePage || !Guid.TryParseExact(elementId, "N", out var id))
            return;

        if (string.Equals(kind, "image", StringComparison.OrdinalIgnoreCase))
        {
            var image = State.PageLayout.Images.FirstOrDefault(candidate => candidate.Id == id);
            if (image is null) return;
            await UpdatePictureImageAsync(
                id,
                Clamp(xPercent, 0, Math.Max(0, 100 - image.WidthPercent)),
                Clamp(yPercent, 0, Math.Max(0, 100 - image.HeightPercent)));
            return;
        }

        var text = State.PageLayout.TextElements.FirstOrDefault(candidate => candidate.Id == id);
        if (text is null) return;
        await UpdatePictureTextAsync(
            id,
            x: Clamp(xPercent, 0, Math.Max(0, 100 - text.WidthPercent)),
            y: Clamp(yPercent, 0, Math.Max(0, 100 - text.HeightPercent)));
    }

    [JSInvokable]
    public async Task ResizePictureElementAsync(string kind, string elementId, double widthPercent, double heightPercent)
    {
        if (!IsEditable || State.VisualMode != ChapterVisualMode.PicturePage || !Guid.TryParseExact(elementId, "N", out var id))
            return;

        if (string.Equals(kind, "image", StringComparison.OrdinalIgnoreCase))
        {
            var image = State.PageLayout.Images.FirstOrDefault(candidate => candidate.Id == id);
            if (image is null) return;
            await UpdatePictureImageAsync(
                id,
                width: Clamp(widthPercent, 5, Math.Max(5, 100 - image.XPercent)),
                height: Clamp(heightPercent, 5, Math.Max(5, 100 - image.YPercent)));
            return;
        }

        var text = State.PageLayout.TextElements.FirstOrDefault(candidate => candidate.Id == id);
        if (text is null) return;
        await UpdatePictureTextAsync(
            id,
            width: Clamp(widthPercent, 5, Math.Max(5, 100 - text.XPercent)),
            height: Clamp(heightPercent, 5, Math.Max(5, 100 - text.YPercent)));
    }

    [JSInvokable]
    public async Task UpdatePictureTextBodyAsync(string elementId, string body)
    {
        if (!IsEditable || State.VisualMode != ChapterVisualMode.PicturePage || !Guid.TryParseExact(elementId, "N", out var id))
            return;

        var text = State.PageLayout.TextElements.FirstOrDefault(candidate => candidate.Id == id);
        if (text is null || string.Equals(text.Text, body, StringComparison.Ordinal))
            return;

        await UpdatePictureTextAsync(id, body: body);
    }

    [JSInvokable]
    public async Task AddDroppedImageAsync(
        string fileName,
        string contentType,
        string base64Data,
        double? xPercent,
        double? yPercent)
    {
        if (!IsEditable || ProjectId == Guid.Empty || string.IsNullOrWhiteSpace(base64Data))
            return;

        byte[] bytes;
        try
        {
            bytes = Convert.FromBase64String(base64Data);
        }
        catch (FormatException)
        {
            return;
        }

        var uploaded = await ProjectImages.UploadAsync(ProjectId, new ProjectImageUpload(
            fileName,
            contentType,
            bytes,
            string.Empty));

        var placement = await Visuals.AddImageToChapterAsync(ProjectId, State.ChapterId, uploaded.Id);
        var state = placement.State;
        if (state.VisualMode == ChapterVisualMode.PicturePage
            && xPercent is double centerX
            && yPercent is double centerY)
        {
            var image = state.PageLayout.Images.FirstOrDefault(candidate => candidate.Id == placement.ElementId);
            if (image is not null)
            {
                var x = Clamp(centerX - image.WidthPercent / 2, 0, Math.Max(0, 100 - image.WidthPercent));
                var y = Clamp(centerY - image.HeightPercent / 2, 0, Math.Max(0, 100 - image.HeightPercent));
                var adjustedLayout = state.PageLayout with
                {
                    Images = state.PageLayout.Images.Select(candidate => candidate.Id == placement.ElementId
                        ? candidate with { XPercent = x, YPercent = y }
                        : candidate).ToList(),
                };
                state = await Visuals.SavePageLayoutAsync(State.ChapterId, adjustedLayout);
            }
        }

        if (OnImagesChanged.HasDelegate)
            await OnImagesChanged.InvokeAsync();
        await OnChanged.InvokeAsync(state);
    }

    private async Task UpdatePictureTextAsync(
        Guid elementId,
        string? body = null,
        double? x = null,
        double? y = null,
        double? width = null,
        double? height = null,
        PublishCoverFontFamily? fontFamily = null,
        double? fontSizePercent = null,
        string? color = null) =>
        await SavePageAsync(State.PageLayout with
        {
            TextElements = State.PageLayout.TextElements.Select(text => text.Id == elementId
                ? text with
                {
                    Text = body ?? text.Text,
                    XPercent = x ?? text.XPercent,
                    YPercent = y ?? text.YPercent,
                    WidthPercent = width ?? text.WidthPercent,
                    HeightPercent = height ?? text.HeightPercent,
                    FontFamily = fontFamily ?? text.FontFamily,
                    FontSizePercent = fontSizePercent ?? text.FontSizePercent,
                    Color = color ?? text.Color,
                }
                : text).ToList(),
        });

    private async Task RemovePictureImageAsync(Guid elementId) =>
        await SavePageAsync(State.PageLayout with { Images = State.PageLayout.Images.Where(image => image.Id != elementId).ToList() });

    private async Task RemovePictureTextAsync(Guid elementId)
    {
        if (_selectedPictureTextId == elementId)
            _selectedPictureTextId = null;
        _textColorDrafts.Remove(elementId);

        await SavePageAsync(State.PageLayout with { TextElements = State.PageLayout.TextElements.Where(text => text.Id != elementId).ToList() });
    }

    private async Task SaveIllustrationsAsync(IllustratedProseLayout layout)
    {
        var updated = await Visuals.SaveIllustrationLayoutAsync(State.ChapterId, layout);
        await OnChanged.InvokeAsync(updated);
    }

    private async Task SavePageAsync(PicturePageLayout layout)
    {
        var updated = await Visuals.SavePageLayoutAsync(State.ChapterId, layout);
        await OnChanged.InvokeAsync(updated);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_viewerModule is not null)
        {
            try { await _viewerModule.InvokeVoidAsync("detach", _viewerRoot); } catch { }
            try { await _viewerModule.DisposeAsync(); } catch { }
            _viewerModule = null;
        }

        _selfRef?.Dispose();
        _selfRef = null;
        _textColorSaveDebounce?.Cancel();
        _textColorSaveDebounce?.Dispose();
        _textColorSaveDebounce = null;
    }

    private ProjectImageView? ImageById(Guid id) => Images.FirstOrDefault(image => image.Id == id);

    private static IReadOnlyList<string> SplitParagraphs(string body)
    {
        var paragraphs = new List<string>();
        var current = new StringBuilder();
        foreach (var line in body.Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n').Split('\n'))
        {
            if (string.IsNullOrWhiteSpace(line))
            {
                Flush();
                continue;
            }

            if (current.Length > 0) current.AppendLine();
            current.Append(line.TrimEnd());
        }

        Flush();
        return paragraphs;

        void Flush()
        {
            if (current.Length == 0) return;
            paragraphs.Add(current.ToString());
            current.Clear();
        }
    }

    private static string ElementStyle(double x, double y, double width, double height, int zIndex) =>
        $"left:{x.ToString(CultureInfo.InvariantCulture)}%;top:{y.ToString(CultureInfo.InvariantCulture)}%;width:{width.ToString(CultureInfo.InvariantCulture)}%;height:{height.ToString(CultureInfo.InvariantCulture)}%;z-index:{zIndex};";

    private string PictureTextElementClass(PicturePageTextElement text)
    {
        var classes = IsEditable
            ? "picture-element picture-element--text picture-element--editable"
            : "picture-element picture-element--text";
        if (IsEditable && _selectedPictureTextId == text.Id)
            classes += " picture-element--selected";
        return classes;
    }

    private IReadOnlyList<ProsePageModel> BuildProsePages(IReadOnlyList<string> paragraphs, PageLayoutMetrics metrics)
    {
        var builders = new List<ProsePageBuilder>();
        var current = NewPage();
        var pageCapacity = Math.Max(1, metrics.PageHeightInches - (PageMarginInches * 2) - 0.25);
        var contentWidth = Math.Max(1, metrics.PageWidthInches - (PageMarginInches * 2));
        var charsPerLine = Math.Max(28, (int)Math.Floor(contentWidth * 9.2));

        if (paragraphs.Count == 0)
            return [new ProsePageModel(1, IsBlank: false, [])];

        for (var index = 0; index < paragraphs.Count; index++)
        {
            if (IsEditable)
            {
                AddItem(new ProsePageItem(ProsePageItemKind.DropZone, index, ChapterImageAnchorPosition.BeforeParagraph, string.Empty, null), DropZoneHeightInches);
            }

            foreach (var block in BlocksAt(index, ChapterImageAnchorPosition.BeforeParagraph))
                AddIllustration(block);

            if (!string.IsNullOrWhiteSpace(paragraphs[index]))
                AddParagraph(index, paragraphs[index]);

            foreach (var block in BlocksAt(index, ChapterImageAnchorPosition.AfterParagraph))
                AddIllustration(block);

            if (IsEditable)
            {
                AddItem(new ProsePageItem(ProsePageItemKind.DropZone, index, ChapterImageAnchorPosition.AfterParagraph, string.Empty, null), DropZoneHeightInches);
            }
        }

        return builders
            .Select((builder, index) => new ProsePageModel(index + 1, IsBlank: false, builder.Items))
            .ToList();

        ProsePageBuilder NewPage()
        {
            var page = new ProsePageBuilder();
            builders.Add(page);
            return page;
        }

        void ForceNewPage()
        {
            if (current.Items.Count > 0)
                current = NewPage();
        }

        void AddItem(ProsePageItem item, double heightInches, bool startOnNewPage = false)
        {
            if (startOnNewPage)
                ForceNewPage();

            var height = Math.Min(heightInches, pageCapacity);
            if (current.Items.Count > 0 && current.UsedHeightInches + height > pageCapacity)
                current = NewPage();

            current.Items.Add(item);
            current.UsedHeightInches += height;
        }

        void AddIllustration(IllustratedProseImageBlock block)
        {
            var height = EstimateIllustrationHeight(block, contentWidth, metrics.PageHeightInches, charsPerLine);
            AddItem(
                new ProsePageItem(ProsePageItemKind.Illustration, block.ParagraphIndex, block.AnchorPosition, string.Empty, block),
                height,
                block.StartOnNewPage);
        }

        void AddParagraph(int paragraphIndex, string paragraph)
        {
            var remaining = paragraph.Trim();
            while (!string.IsNullOrWhiteSpace(remaining))
            {
                var available = pageCapacity - current.UsedHeightInches;
                var minimumTextHeight = BodyLineHeightInches + ParagraphSpacingInches;
                if (current.Items.Count > 0 && available < minimumTextHeight)
                {
                    current = NewPage();
                    available = pageCapacity;
                }

                var wholeHeight = EstimateParagraphHeight(remaining, charsPerLine);
                if (wholeHeight <= available || current.Items.Count == 0 && wholeHeight <= pageCapacity)
                {
                    AddItem(new ProsePageItem(ProsePageItemKind.Paragraph, paragraphIndex, ChapterImageAnchorPosition.AfterParagraph, remaining, null), wholeHeight);
                    break;
                }

                var maxLines = Math.Max(1, (int)Math.Floor((available - ParagraphSpacingInches) / BodyLineHeightInches));
                var maxChars = Math.Max(1, maxLines * charsPerLine);
                var segment = TakeTextSegment(remaining, maxChars);
                AddItem(
                    new ProsePageItem(ProsePageItemKind.Paragraph, paragraphIndex, ChapterImageAnchorPosition.AfterParagraph, segment, null),
                    EstimateParagraphHeight(segment, charsPerLine));
                remaining = remaining[segment.Length..].TrimStart();
            }
        }
    }

    private static IReadOnlyList<ProseSpreadModel> BuildProseSpreads(IReadOnlyList<ProsePageModel> pages, bool isDouble)
    {
        if (!isDouble)
        {
            return pages
                .Select((page, index) => new ProseSpreadModel(index + 1, page, null))
                .ToList();
        }

        var spreads = new List<ProseSpreadModel>();
        for (var index = 0; index < pages.Count; index += 2)
        {
            var left = pages[index];
            var right = index + 1 < pages.Count
                ? pages[index + 1]
                : new ProsePageModel(left.PageNumber + 1, IsBlank: true, []);
            spreads.Add(new ProseSpreadModel(spreads.Count + 1, left, right));
        }

        return spreads;
    }

    private static double EstimateParagraphHeight(string text, int charsPerLine)
    {
        var normalized = NormalizeTextForMeasurement(text);
        if (normalized.Length == 0)
            return 0;

        var lines = Math.Max(1, (int)Math.Ceiling(normalized.Length / (double)Math.Max(1, charsPerLine)));
        return (lines * BodyLineHeightInches) + ParagraphSpacingInches;
    }

    private double EstimateIllustrationHeight(
        IllustratedProseImageBlock block,
        double contentWidthInches,
        double pageHeightInches,
        int charsPerLine)
    {
        var figureWidth = contentWidthInches * (Clamp(block.WidthPercent, 10, 100) / 100);
        var imageHeight = Math.Min(Math.Min(6, pageHeightInches * 0.55), Math.Max(1.2, figureWidth * 0.72));
        var captionHeight = string.IsNullOrWhiteSpace(block.Caption)
            ? 0
            : EstimateParagraphHeight(block.Caption, Math.Max(16, (int)Math.Round(charsPerLine * block.WidthPercent / 100))) * 0.75;
        var controlsHeight = IsEditable ? 0.48 : 0;
        return imageHeight + captionHeight + FigureSpacingInches + controlsHeight;
    }

    private static string TakeTextSegment(string text, int maxChars)
    {
        if (text.Length <= maxChars)
            return text;

        var limit = Math.Clamp(maxChars, 1, text.Length);
        var splitAt = text.LastIndexOfAny([' ', '\n', '\t'], limit - 1, limit);
        if (splitAt < Math.Min(24, limit / 2))
            splitAt = limit;

        return text[..splitAt].TrimEnd();
    }

    private static string NormalizeTextForMeasurement(string text)
    {
        var builder = new StringBuilder(text.Length);
        var previousWasWhiteSpace = false;
        foreach (var ch in text)
        {
            if (char.IsWhiteSpace(ch))
            {
                if (!previousWasWhiteSpace)
                    builder.Append(' ');
                previousWasWhiteSpace = true;
                continue;
            }

            builder.Append(ch);
            previousWasWhiteSpace = false;
        }

        return builder.ToString().Trim();
    }

    private static PageLayoutMetrics PageMetrics(ChapterPageLayoutKind kind)
    {
        var normalized = Enum.IsDefined(kind) ? kind : ChapterPageLayoutKind.SinglePortrait;
        var isLandscape = normalized is ChapterPageLayoutKind.SingleLandscape or ChapterPageLayoutKind.DoubleLandscape;
        var isDouble = normalized is ChapterPageLayoutKind.DoublePortrait or ChapterPageLayoutKind.DoubleLandscape;
        var pageWidth = isLandscape ? 11 : 8.5;
        var pageHeight = isLandscape ? 8.5 : 11;
        return new PageLayoutMetrics(pageWidth, pageHeight, isDouble, isDouble ? pageWidth * 2 : pageWidth, pageHeight);
    }

    private string PicturePageClass(PageLayoutMetrics metrics)
    {
        var classes = IsEditable ? "picture-page picture-page--editable" : "picture-page";
        if (metrics.IsDouble)
            classes += " picture-page--double";
        return classes;
    }

    private static string PicturePageStyle(PageLayoutMetrics metrics)
    {
        var width = metrics.SurfaceWidthInches.ToString(CultureInfo.InvariantCulture);
        var height = metrics.SurfaceHeightInches.ToString(CultureInfo.InvariantCulture);
        var maxWidth = metrics.IsDouble ? $"{metrics.SurfaceWidthInches.ToString(CultureInfo.InvariantCulture)}in" : $"{metrics.PageWidthInches.ToString(CultureInfo.InvariantCulture)}in";
        var viewportMax = $"calc((100dvh - 12rem) * {width} / {height})";
        return $"aspect-ratio:{width}/{height};max-width:min(100%, {maxWidth}, {viewportMax});";
    }

    private static string ProsePagesClass(PageLayoutMetrics metrics) =>
        metrics.IsDouble ? "prose-pages prose-pages--double" : "prose-pages prose-pages--single";

    private static string ProseSpreadClass(PageLayoutMetrics metrics) =>
        metrics.IsDouble ? "prose-spread prose-spread--double" : "prose-spread prose-spread--single";

    private static string ProsePageClass(ProsePageModel page) =>
        page.IsBlank ? "sim-page prose-page prose-page--blank" : "sim-page prose-page";

    private static string ProsePageStyle(PageLayoutMetrics metrics) =>
        $"--page-width:{metrics.PageWidthInches.ToString(CultureInfo.InvariantCulture)}in;--page-height:{metrics.PageHeightInches.ToString(CultureInfo.InvariantCulture)}in;";

    private string TextElementStyle(PicturePageTextElement text)
    {
        var justify = text.VerticalAlign switch
        {
            ChapterTextVerticalAlign.Top => "flex-start",
            ChapterTextVerticalAlign.Bottom => "flex-end",
            _ => "center",
        };
        return ElementStyle(text.XPercent, text.YPercent, text.WidthPercent, text.HeightPercent, text.ZIndex)
            + $"font-family:{FontFamilyCss(text.FontFamily)};font-size:{text.FontSizePercent.ToString(CultureInfo.InvariantCulture)}cqw;line-height:{text.LineHeight.ToString(CultureInfo.InvariantCulture)};color:{TextColorValue(text)};background:rgba(255,255,255,{text.BackgroundOpacity.ToString(CultureInfo.InvariantCulture)});text-align:{text.TextAlign.ToString().ToLowerInvariant()};align-items:{justify};";
    }

    private static string FontFamilyCss(PublishCoverFontFamily fontFamily) =>
        fontFamily switch
        {
            PublishCoverFontFamily.Sans => "Arial, Helvetica, sans-serif",
            PublishCoverFontFamily.Display => "\"Trebuchet MS\", \"Gill Sans\", Arial, sans-serif",
            PublishCoverFontFamily.Monospace => "\"Courier New\", monospace",
            _ => "Georgia, \"Times New Roman\", serif",
        };

    private static string ColorInputValue(string? value) =>
        CleanColor(value) ?? "#111827";

    private string TextColorValue(PicturePageTextElement text) =>
        _textColorDrafts.TryGetValue(text.Id, out var draft)
            ? draft
            : text.Color;

    private static string? CleanColor(string? value)
    {
        var trimmed = value?.Trim() ?? string.Empty;
        return trimmed.Length == 7
            && trimmed[0] == '#'
            && trimmed.Skip(1).All(Uri.IsHexDigit)
            ? trimmed.ToUpperInvariant()
            : null;
    }

    private static string FitCss(ChapterImageFit fit) => fit switch
    {
        ChapterImageFit.Cover => "cover",
        ChapterImageFit.Fill => "fill",
        _ => "contain",
    };

    private static double Clamp(double value, double min, double max) =>
        Math.Min(max, Math.Max(min, value));

}
