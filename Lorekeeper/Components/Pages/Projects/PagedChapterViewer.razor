    private IReadOnlyList<ProsePageModel> BuildProsePages(IReadOnlyList<string> paragraphs, BookPageGeometry metrics)
    {
        var builders = new List<ProsePageBuilder>();
        var current = NewPage();
        var pageCapacity = Math.Max(1, metrics.PageHeightInches - (metrics.PageMarginInches * 2) - 0.25);
        var contentWidth = Math.Max(1, metrics.PageWidthInches - (metrics.PageMarginInches * 2));
        var averageCharacterWidthInches = metrics.BodyFontSizePoints * 0.52 / 72;
        var charsPerLine = Math.Max(20, (int)Math.Floor(contentWidth / Math.Max(0.01, averageCharacterWidthInches)));
        var bodyLineHeightInches = metrics.BodyFontSizePoints / 72 * metrics.BodyLineHeight;

        if (paragraphs.Count == 0)
            return [new ProsePageModel(1, IsBlank: false, [])];

        for (var index = 0; index < paragraphs.Count; index++)
        {
            if (CanEditLayout)
            {
                AddItem(new ProsePageItem(ProsePageItemKind.DropZone, index, ChapterImageAnchorPosition.BeforeParagraph, string.Empty, null), DropZoneHeightInches);
            }

            foreach (var block in BlocksAt(index, ChapterImageAnchorPosition.BeforeParagraph))
                AddIllustration(block);

            if (!string.IsNullOrWhiteSpace(paragraphs[index]))
                AddParagraph(index, paragraphs[index]);

            foreach (var block in BlocksAt(index, ChapterImageAnchorPosition.AfterParagraph))
                AddIllustration(block);

            if (CanEditLayout)
            {
                AddItem(new ProsePageItem(ProsePageItemKind.DropZone, index, ChapterImageAnchorPosition.AfterParagraph, string.Empty, null), DropZoneHeightInches);
            }
        }

        return builders
            .Select((builder, index) => new ProsePageModel(index + 1, IsBlank: false, builder.Items))
            .ToList();

        ProsePageBuilder NewPage()
        {
            var page = new ProsePageBuilder();
            builders.Add(page);
            return page;
        }

        void ForceNewPage()
        {
            if (current.Items.Count > 0)
                current = NewPage();
        }

        void AddItem(ProsePageItem item, double heightInches, bool startOnNewPage = false)
        {
            if (startOnNewPage)
                ForceNewPage();

            var height = Math.Min(heightInches, pageCapacity);
            if (current.Items.Count > 0 && current.UsedHeightInches + height > pageCapacity)
                current = NewPage();

            current.Items.Add(item);
            current.UsedHeightInches += height;
        }

        void AddIllustration(IllustratedProseImageBlock block)
        {
            var height = EstimateIllustrationHeight(block, contentWidth, metrics.PageHeightInches, charsPerLine);
            AddItem(
                new ProsePageItem(ProsePageItemKind.Illustration, block.ParagraphIndex, block.AnchorPosition, string.Empty, block),
                height,
                block.StartOnNewPage);
        }

        void AddParagraph(int paragraphIndex, string paragraph)
        {
            var remaining = paragraph.Trim();
            while (!string.IsNullOrWhiteSpace(remaining))
            {
                var available = pageCapacity - current.UsedHeightInches;
                var minimumTextHeight = bodyLineHeightInches + ParagraphSpacingInches;
                if (current.Items.Count > 0 && available < minimumTextHeight)
                {
                    current = NewPage();
                    available = pageCapacity;
                }

                var wholeHeight = EstimateParagraphHeight(remaining, charsPerLine, bodyLineHeightInches);
                if (wholeHeight <= available || current.Items.Count == 0 && wholeHeight <= pageCapacity)
                {
                    AddItem(new ProsePageItem(ProsePageItemKind.Paragraph, paragraphIndex, ChapterImageAnchorPosition.AfterParagraph, remaining, null), wholeHeight);
                    break;
                }

                var maxLines = Math.Max(1, (int)Math.Floor((available - ParagraphSpacingInches) / bodyLineHeightInches));
                var maxChars = Math.Max(1, maxLines * charsPerLine);
                var segment = TakeTextSegment(remaining, maxChars);
                AddItem(
                    new ProsePageItem(ProsePageItemKind.Paragraph, paragraphIndex, ChapterImageAnchorPosition.AfterParagraph, segment, null),
                    EstimateParagraphHeight(segment, charsPerLine, bodyLineHeightInches));
                remaining = remaining[segment.Length..].TrimStart();
            }
        }
    }

    private static IReadOnlyList<ProseSpreadModel> BuildProseSpreads(IReadOnlyList<ProsePageModel> pages, bool isDouble)
    {
        if (!isDouble)
        {
            return pages
                .Select((page, index) => new ProseSpreadModel(index + 1, page, null))
                .ToList();
        }

        var spreads = new List<ProseSpreadModel>();
        for (var index = 0; index < pages.Count; index += 2)
        {
            var left = pages[index];
            var right = index + 1 < pages.Count
                ? pages[index + 1]
                : new ProsePageModel(left.PageNumber + 1, IsBlank: true, []);
            spreads.Add(new ProseSpreadModel(spreads.Count + 1, left, right));
        }

        return spreads;
    }

    private static double EstimateParagraphHeight(string text, int charsPerLine, double lineHeightInches)
    {
        var normalized = NormalizeTextForMeasurement(text);
        if (normalized.Length == 0)
            return 0;

        var lines = Math.Max(1, (int)Math.Ceiling(normalized.Length / (double)Math.Max(1, charsPerLine)));
        return (lines * lineHeightInches) + ParagraphSpacingInches;
    }

    private double EstimateIllustrationHeight(
        IllustratedProseImageBlock block,
        double contentWidthInches,
        double pageHeightInches,
        int charsPerLine)
    {
        var figureWidth = contentWidthInches * (Clamp(block.WidthPercent, 10, 100) / 100);
        var imageHeight = Math.Min(Math.Min(6, pageHeightInches * 0.55), Math.Max(1.2, figureWidth * 0.72));
        var captionLineHeight = _pageGeometry.BodyFontSizePoints / 72 * _pageGeometry.BodyLineHeight;
        var captionHeight = string.IsNullOrWhiteSpace(block.Caption)
            ? 0
            : EstimateParagraphHeight(block.Caption, Math.Max(16, (int)Math.Round(charsPerLine * block.WidthPercent / 100)), captionLineHeight) * 0.75;
        var controlsHeight = CanEditLayout ? 0.48 : 0;
        return imageHeight + captionHeight + FigureSpacingInches + controlsHeight;
    }

    private static string TakeTextSegment(string text, int maxChars)
    {
        if (text.Length <= maxChars)
            return text;

        var limit = Math.Clamp(maxChars, 1, text.Length);
        var splitAt = text.LastIndexOfAny([' ', '\n', '\t'], limit - 1, limit);
        if (splitAt < Math.Min(24, limit / 2))
            splitAt = limit;

        return text[..splitAt].TrimEnd();
    }

    private static string NormalizeTextForMeasurement(string text)
    {
        var builder = new StringBuilder(text.Length);
        var previousWasWhiteSpace = false;
        foreach (var ch in text)
        {
            if (char.IsWhiteSpace(ch))
            {
                if (!previousWasWhiteSpace)
                    builder.Append(' ');
                previousWasWhiteSpace = true;
                continue;
            }

            builder.Append(ch);
            previousWasWhiteSpace = false;
        }

        return builder.ToString().Trim();
    }

    private string PicturePageClass(BookPageGeometry metrics)
    {
        var classes = CanEditLayout ? "picture-page picture-page--editable" : "picture-page";
        if (metrics.IsDouble)
            classes += " picture-page--double";
        return classes;
    }

    private static string PicturePageStyle(BookPageGeometry metrics)
    {
        var width = metrics.SurfaceWidthInches.ToString(CultureInfo.InvariantCulture);
        var height = metrics.SurfaceHeightInches.ToString(CultureInfo.InvariantCulture);
        var naturalWidth = $"{metrics.SurfaceWidthInches.ToString(CultureInfo.InvariantCulture)}in";
        var heightFitWidth = (metrics.SurfaceWidthInches / metrics.SurfaceHeightInches * 100)
            .ToString("0.###", CultureInfo.InvariantCulture);
        return $"--picture-page-natural-width:{naturalWidth};--picture-page-height-fit-width:{heightFitWidth}cqh;aspect-ratio:{width}/{height};";
    }

    private static string SafeGuideStyle(BookPageGeometry metrics, double insetInches)
    {
        var x = insetInches / metrics.SurfaceWidthInches * 100;
        var y = insetInches / metrics.SurfaceHeightInches * 100;
        return $"left:{x.ToString("0.###", CultureInfo.InvariantCulture)}%;right:{x.ToString("0.###", CultureInfo.InvariantCulture)}%;top:{y.ToString("0.###", CultureInfo.InvariantCulture)}%;bottom:{y.ToString("0.###", CultureInfo.InvariantCulture)}%;";
    }

    private static string GutterGuideStyle(BookPageGeometry metrics, double insetInches)
    {
        var width = insetInches * 2 / metrics.SurfaceWidthInches * 100;
        return $"left:{(50 - width / 2).ToString("0.###", CultureInfo.InvariantCulture)}%;width:{width.ToString("0.###", CultureInfo.InvariantCulture)}%;";
    }

