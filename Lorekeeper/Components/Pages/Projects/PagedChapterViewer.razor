    [JSInvokable]
    public async Task MoveIllustrationBlockAsync(string blockId, int paragraphIndex, string anchorPosition)
    {
        if (!CanEditLayout
            || State.VisualMode == ChapterVisualMode.PicturePage
            || !Guid.TryParseExact(blockId, "N", out var id)
            || !Enum.TryParse<ChapterImageAnchorPosition>(anchorPosition, ignoreCase: true, out var position))
        {
            return;
        }

        var block = State.IllustrationLayout.Images.FirstOrDefault(candidate => candidate.Id == id);
        if (block is null)
            return;

        var paragraphs = SplitParagraphs(State.Body);
        var clampedIndex = Math.Clamp(paragraphIndex, 0, Math.Max(0, paragraphs.Count - 1));
        if (block.ParagraphIndex == clampedIndex && block.AnchorPosition == position)
            return;

        await SaveIllustrationsAsync(State.IllustrationLayout with
        {
            Images = State.IllustrationLayout.Images.Select(candidate => candidate.Id == id
                ? candidate with
                {
                    ParagraphIndex = clampedIndex,
                    AnchorPosition = position,
                    ParagraphHash = string.Empty,
                }
                : candidate).ToList(),
        });
    }

    private async Task ReorderSelectedPictureLayerAsync(PictureLayerMove move)
    {
        if (!CanEditLayout
            || State.VisualMode != ChapterVisualMode.PicturePage
            || _selectedPictureElement is not { } selected)
        {
            return;
        }

        var layers = OrderedPictureLayers().ToList();
        var currentIndex = layers.FindIndex(layer => layer.Kind == selected.Kind && layer.Id == selected.Id);
        if (currentIndex < 0)
            return;

        var targetIndex = move switch
        {
            PictureLayerMove.Backward => Math.Max(0, currentIndex - 1),
            PictureLayerMove.Forward => Math.Min(layers.Count - 1, currentIndex + 1),
            PictureLayerMove.ToBack => 0,
            PictureLayerMove.ToFront => layers.Count - 1,
            _ => currentIndex,
        };

        if (targetIndex == currentIndex)
            return;

        var selectedLayer = layers[currentIndex];
        layers.RemoveAt(currentIndex);
        layers.Insert(targetIndex, selectedLayer);

        await SavePageAsync(ApplyPictureLayerOrder(State.PageLayout, layers));
    }

    private bool SelectedPictureLayerIsBackmost()
    {
        var (index, _) = SelectedPictureLayerPosition();
        return index <= 0;
    }

    private bool SelectedPictureLayerIsFrontmost()
    {
        var (index, count) = SelectedPictureLayerPosition();
        return count == 0 || index < 0 || index >= count - 1;
    }

    private string SelectedPictureLayerPositionLabel()
    {
        var (index, count) = SelectedPictureLayerPosition();
        return index < 0 || count == 0
            ? "-"
            : $"{index + 1}/{count}";
    }

    private (int Index, int Count) SelectedPictureLayerPosition()
    {
        if (_selectedPictureElement is not { } selected)
            return (-1, 0);

        var layers = OrderedPictureLayers();
        var index = layers.ToList().FindIndex(layer => layer.Kind == selected.Kind && layer.Id == selected.Id);
        return (index, layers.Count);
    }

    private IReadOnlyList<PictureLayerItem> OrderedPictureLayers()
    {
        var imageLayers = State.PageLayout.Images.Select((image, index) =>
            new PictureLayerItem(PictureElementKind.Image, image.Id, image.ZIndex, index));
        var textOffset = State.PageLayout.Images.Count;
        var textLayers = State.PageLayout.TextElements.Select((text, index) =>
            new PictureLayerItem(PictureElementKind.Text, text.Id, text.ZIndex, textOffset + index));

        return imageLayers
            .Concat(textLayers)
            .OrderBy(layer => layer.ZIndex)
            .ThenBy(layer => layer.OriginalIndex)
            .ToList();
    }

    private static PicturePageLayout ApplyPictureLayerOrder(
        PicturePageLayout layout,
        IReadOnlyList<PictureLayerItem> orderedLayers)
    {
        var zByLayer = orderedLayers
            .Select((layer, index) => (Key: (layer.Kind, layer.Id), ZIndex: index + 1))
            .ToDictionary(layer => layer.Key, layer => layer.ZIndex);

        return layout with
        {
            Images = layout.Images.Select(image => zByLayer.TryGetValue((PictureElementKind.Image, image.Id), out var zIndex)
                ? image with { ZIndex = zIndex }
                : image).ToList(),
            TextElements = layout.TextElements.Select(text => zByLayer.TryGetValue((PictureElementKind.Text, text.Id), out var zIndex)
                ? text with { ZIndex = zIndex }
                : text).ToList(),
        };
    }

    private async Task AddTextBoxAsync()
    {
        if (!CanEditLayout) return;
        var textId = Guid.NewGuid();
        var maxOrder = State.PageLayout.TextElements.Select(text => text.ReadingOrder).DefaultIfEmpty(-1).Max();
        var maxZ = State.PageLayout.Images.Select(image => image.ZIndex)
            .Concat(State.PageLayout.TextElements.Select(text => text.ZIndex))
            .DefaultIfEmpty(0)
            .Max();
        var layout = State.PageLayout with
        {
            TextElements = State.PageLayout.TextElements
                .Append(new PicturePageTextElement(
                    textId,
                    "New text",
                    12,
                    70,
                    76,
                    16,
                    maxZ + 1,
                    maxOrder + 1,
                    PicturePageFontKeys.Default,
                    400,
                    false,
                    24,
                    0,
                    1.35,
                    "#111827",
                    "#FFFFFF",
                    0,
                    PicturePageTextAlign.Left,
                    ChapterTextVerticalAlign.Top,
                    PicturePageTextShadow.None))
                .ToList(),
        };
        _selectedPictureElement = new PictureElementSelection(PictureElementKind.Text, textId);
        await SavePageAsync(layout);
    }

