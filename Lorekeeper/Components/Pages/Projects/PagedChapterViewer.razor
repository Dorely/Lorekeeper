        page.IsBlank ? "sim-page prose-page prose-page--blank" : "sim-page prose-page";

    private static string ProsePageStyle(BookPageGeometry metrics) =>
        $"--page-width:{metrics.PageWidthInches.ToString(CultureInfo.InvariantCulture)}in;--page-height:{metrics.PageHeightInches.ToString(CultureInfo.InvariantCulture)}in;--page-margin:{metrics.PageMarginInches.ToString(CultureInfo.InvariantCulture)}in;--body-font-size:{metrics.BodyFontSizePoints.ToString(CultureInfo.InvariantCulture)}pt;--body-line-height:{metrics.BodyLineHeight.ToString(CultureInfo.InvariantCulture)};";

    private string TextElementStyle(PicturePageTextElement text)
    {
        var metrics = _pageGeometry;
        var fontSizeCqw = text.FontSizePoints / 72 / metrics.SurfaceWidthInches * 100;
        var justify = text.VerticalAlign switch
        {
            ChapterTextVerticalAlign.Top => "flex-start",
            ChapterTextVerticalAlign.Bottom => "flex-end",
            _ => "center",
        };
        return PictureElementStyle(text.XPercent, text.YPercent, text.WidthPercent, text.HeightPercent, text.ZIndex)
            + $"font-family:{FontFamilyCss(text.FontFamilyKey)};font-size:{fontSizeCqw.ToString(CultureInfo.InvariantCulture)}cqw;font-weight:{text.FontWeight};font-style:{(text.Italic ? "italic" : "normal")};letter-spacing:{text.LetterSpacingEm.ToString(CultureInfo.InvariantCulture)}em;line-height:{text.LineHeight.ToString(CultureInfo.InvariantCulture)};color:{TextColorValue(text)};background:{CssRgba(TextBackgroundColorValue(text), TextBackgroundOpacityValue(text))};text-align:{text.TextAlign.ToString().ToLowerInvariant()};text-shadow:{TextShadowCss(text.Shadow, fontSizeCqw)};--picture-text-vertical-position:{justify};";
    }

    private string FontFamilyCss(string fontFamilyKey) =>
        $"\"{FontCssName(fontFamilyKey)}\", \"{FontCssName(PicturePageFontKeys.Fallback)}\", sans-serif";

    private ProjectFontFamilyView? FontFamily(string key) =>
        _fontFamilies.FirstOrDefault(font => string.Equals(font.Key, key, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<int> AvailableWeights(string key) =>
        FontFamily(key)?.Faces.Select(face => face.Weight).Distinct().Order().ToList() ?? [400];

    private bool ItalicAvailable(string key, int weight) =>
        FontFamily(key)?.Faces.Any(face => face.Weight == weight && face.Italic) == true;

    private string FontFaceCss()
    {
        var css = new StringBuilder();
        foreach (var family in _fontFamilies)
        {
            foreach (var face in family.Faces)
            {
                css.Append("@font-face{font-family:\"")
                    .Append(FontCssName(family.Key))
                    .Append("\";src:url('")
                    .Append(face.ContentUrl)
                    .Append("');font-weight:")
                    .Append(face.Weight)
                    .Append(";font-style:")
                    .Append(face.Italic ? "italic" : "normal")
                    .Append(";font-display:swap;}");
            }
        }

        return css.ToString();
    }

    private static string FontCssName(string key) =>
        $"lk-{key.Replace(':', '-').Replace('_', '-')}";

    private static string TextShadowCss(PicturePageTextShadow shadow, double fontSizeCqw)
    {
        string Length(double ratio) =>
            $"{(fontSizeCqw * ratio).ToString("0.####", CultureInfo.InvariantCulture)}cqw";

        return shadow switch
        {
            PicturePageTextShadow.Soft => $"0 {Length(0.03)} {Length(0.055)} rgba(0,0,0,.608)",
            PicturePageTextShadow.Strong => $"0 {Length(0.045)} {Length(0.08)} rgba(0,0,0,.725), 0 {Length(0.018)} 0 rgba(0,0,0,.863)",
            PicturePageTextShadow.Glow => $"0 0 {Length(0.08)} rgba(255,255,255,.706), 0 {Length(0.025)} {Length(0.045)} rgba(0,0,0,.569)",
            _ => "none",
        };
    }

    private static string ColorInputValue(string? value, string fallback = "#111827") =>
        CleanColor(value) ?? fallback;

    private string TextColorValue(PicturePageTextElement text) =>
        _textColorDrafts.TryGetValue(text.Id, out var draft)
            ? draft
            : text.Color;

    private string TextBackgroundColorValue(PicturePageTextElement text) =>
        _textBackgroundColorDrafts.TryGetValue(text.Id, out var draft)
            ? draft
            : text.BackgroundColor;

    private double TextBackgroundOpacityValue(PicturePageTextElement text) =>
        _textBackgroundOpacityDrafts.TryGetValue(text.Id, out var draft)
            ? ClampOpacity(draft)
            : ClampOpacity(text.BackgroundOpacity);

    private string BackgroundSwatchStyle(PicturePageTextElement text) =>
        $"background:{CssRgba(TextBackgroundColorValue(text), TextBackgroundOpacityValue(text))};";

    private string BackgroundOpacityPercent(PicturePageTextElement text) =>
        $"{Math.Round(TextBackgroundOpacityValue(text) * 100, MidpointRounding.AwayFromZero):0}%";

    private static string CssRgba(string? color, double opacity)
    {
        var clean = CleanColor(color) ?? "#FFFFFF";
        var red = Convert.ToInt32(clean[1..3], 16);
        var green = Convert.ToInt32(clean[3..5], 16);
        var blue = Convert.ToInt32(clean[5..7], 16);
        return $"rgba({red},{green},{blue},{ClampOpacity(opacity).ToString(CultureInfo.InvariantCulture)})";
    }

    private static bool TryParseOpacity(string? value, out double opacity)
    {
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
        {
            opacity = ClampOpacity(parsed);
            return true;
        }

        opacity = 0;
        return false;
    }

    private static double ClampOpacity(double value) =>
        double.IsNaN(value) || double.IsInfinity(value)
            ? 0
            : Clamp(value, 0, 1);

    private static string? CleanColor(string? value)
    {
        var trimmed = value?.Trim() ?? string.Empty;
        return trimmed.Length == 7
            && trimmed[0] == '#'
            && trimmed.Skip(1).All(Uri.IsHexDigit)
            ? trimmed.ToUpperInvariant()
            : null;
    }

    private static string FitCss(ChapterImageFit fit) => fit switch
    {
        ChapterImageFit.Cover => "cover",
        ChapterImageFit.Fill => "fill",
        _ => "contain",
    };

    private static double Clamp(double value, double min, double max) =>
        Math.Min(max, Math.Max(min, value));

}
