@using Lorekeeper.ChapterVisuals
@using Lorekeeper.Fonts
@using Lorekeeper.Images
@using Lorekeeper.Models
@using Lorekeeper.Publish
@using Lorekeeper.Projects
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text
@implements IAsyncDisposable
@inject IChapterVisualService Visuals
@inject IProjectImageService ProjectImages
@inject IProjectFontService ProjectFonts
@inject IPageGeometryService PageGeometry
@inject IBookBriefService BookBriefs
@inject IJSRuntime JS

<style>@((MarkupString)FontFaceCss())</style>
<div class="@PagedViewerClass()" tabindex="0" @ref="_viewerRoot">
    @if (State.VisualMode == ChapterVisualMode.PicturePage)
    {
        var pageMetrics = _pageGeometry;
        var selectedText = SelectedPictureText;
        var textToolbarValue = selectedText ?? _disabledTextToolbarValue;
        var textControlsDisabled = selectedText is null;
        var selectedLayer = SelectedPictureLayer;
        <div class="@(CanEditLayout ? "picture-layout picture-layout--editable" : "picture-layout")">
            @if (CanEditLayout)
            {
                <div class="picture-toolbar">
                    <div class="picture-toolbar__primary">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddTextBoxAsync">Add text box</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenImagesAsync">Images</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _fontManagerOpen = true">Fonts</button>
                        @if (CurrentLayoutDiagnostics.Count == 0)
                        {
                            <span class="badge text-bg-success">Layout checks clear</span>
                        }
                        else
                        {
                            <details class="picture-diagnostics">
                                <summary>@LayoutDiagnosticSummary()</summary>
                                <ul>
                                     @foreach (var diagnostic in CurrentLayoutDiagnostics)
                                     {
                                         <li class="@(diagnostic.Severity == "error" ? "text-danger" : "text-warning-emphasis")">
                                             <strong>@diagnostic.Code:</strong> @diagnostic.Message
                                             @if (!string.IsNullOrWhiteSpace(diagnostic.MeasuredValue) || !string.IsNullOrWhiteSpace(diagnostic.Threshold))
                                             {
                                                 <span> Measured: @(diagnostic.MeasuredValue ?? "n/a"); threshold: @(diagnostic.Threshold ?? "n/a").</span>
                                             }
                                             @if (!string.IsNullOrWhiteSpace(diagnostic.SuggestedCorrection))
                                             {
                                                 <span> Suggested correction: @diagnostic.SuggestedCorrection</span>
                                             }
                                         </li>
                                     }
                                </ul>
                            </details>
                        }
                        @if (selectedLayer is not null)
                        {
                            <div class="picture-layer-toolbar" aria-label="Selected element layer order">
                                <span class="picture-layer-toolbar__label">Layer @SelectedPictureLayerPositionLabel()</span>
                                <div class="picture-layer-toolbar__group" role="group" aria-label="Layer order controls">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            title="Send to back" aria-label="Send selected element to back"
                                            disabled="@SelectedPictureLayerIsBackmost()"
                                            @onclick="@(() => ReorderSelectedPictureLayerAsync(PictureLayerMove.ToBack))">To back</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            title="Send backward" aria-label="Send selected element backward"
                                            disabled="@SelectedPictureLayerIsBackmost()"
                                            @onclick="@(() => ReorderSelectedPictureLayerAsync(PictureLayerMove.Backward))">Back</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            title="Bring forward" aria-label="Bring selected element forward"
                                            disabled="@SelectedPictureLayerIsFrontmost()"
                                            @onclick="@(() => ReorderSelectedPictureLayerAsync(PictureLayerMove.Forward))">Forward</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            title="Bring to front" aria-label="Bring selected element to front"
                                            disabled="@SelectedPictureLayerIsFrontmost()"
                                            @onclick="@(() => ReorderSelectedPictureLayerAsync(PictureLayerMove.ToFront))">To front</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="@PictureTextToolbarClass(textControlsDisabled)"
                         aria-label="Selected text box controls"
                                 aria-disabled="@textControlsDisabled">
                                <label class="picture-text-toolbar__field">
                                    <span>Font</span>
                                    <select class="form-select form-select-sm"
                                            disabled="@textControlsDisabled"
                                            @bind:get="textToolbarValue.FontFamilyKey"
                                            @bind:set="SetSelectedTextFontFamilyAsync">
                                        @foreach (var group in _fontFamilies.GroupBy(font => font.Category))
                                        {
                                            <optgroup label="@group.Key">
                                                @foreach (var font in group)
                                                {
                                                    <option value="@font.Key">@font.Name</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </label>
                                <div class="picture-text-toolbar__field picture-text-toolbar__field--font-size">
                                    <span>Size</span>
                                    <div class="picture-text-toolbar__size-group">
                                        <input class="form-control form-control-sm"
                                               type="number"
                                               min="8"
                                               max="144"
                                               step="1"
                                               disabled="@(textControlsDisabled || _isFittingText)"
                                               value="@textToolbarValue.FontSizePoints.ToString("0.###", CultureInfo.InvariantCulture)"
                                               @onchange="SetSelectedTextFontSizeAsync" />
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                title="Fit text to the current box"
                                                aria-label="Fit selected text to its box"
                                                disabled="@(textControlsDisabled || _isFittingText)"
                                                @onclick="FitSelectedTextAsync">Fit</button>
                                    </div>
                                </div>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--size">
                                    <span>Weight</span>
                                    <select class="form-select form-select-sm"
                                            disabled="@textControlsDisabled"
                                            @bind:get="textToolbarValue.FontWeight"
                                            @bind:set="SetSelectedTextFontWeightAsync">
                                        @foreach (var weight in AvailableWeights(textToolbarValue.FontFamilyKey))
                                        {
                                            <option value="@weight">@weight</option>
                                        }
                                    </select>
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--check">
                                    <span>Italic</span>
                                    <input class="form-check-input" type="checkbox"
                                           disabled="@(textControlsDisabled || !ItalicAvailable(textToolbarValue.FontFamilyKey, textToolbarValue.FontWeight))"
                                           checked="@textToolbarValue.Italic"
                                           @onchange="SetSelectedTextItalicAsync" />
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--size">
                                    <span>Tracking</span>
                                    <input class="form-control form-control-sm" type="number"
                                           min="-0.1" max="0.3" step="0.01"
                                           disabled="@textControlsDisabled"
                                           value="@textToolbarValue.LetterSpacingEm.ToString("0.##", CultureInfo.InvariantCulture)"
                                           @onchange="SetSelectedTextLetterSpacingAsync" />
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--alignment">
                                    <span>Horizontal</span>
                                    <select class="form-select form-select-sm"
                                            disabled="@textControlsDisabled"
                                            @bind:get="textToolbarValue.TextAlign"
                                            @bind:set="SetSelectedTextAlignAsync">
                                        <option value="@PicturePageTextAlign.Left">Left</option>
                                        <option value="@PicturePageTextAlign.Center">Center</option>
                                        <option value="@PicturePageTextAlign.Right">Right</option>
                                    </select>
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--alignment">
                                    <span>Vertical</span>
                                    <select class="form-select form-select-sm"
                                            disabled="@textControlsDisabled"
                                            @bind:get="textToolbarValue.VerticalAlign"
                                            @bind:set="SetSelectedTextVerticalAlignAsync">
                                        <option value="@ChapterTextVerticalAlign.Top">Top</option>
                                        <option value="@ChapterTextVerticalAlign.Middle">Middle</option>
                                        <option value="@ChapterTextVerticalAlign.Bottom">Bottom</option>
                                    </select>
                                </label>
                                <label class="picture-text-toolbar__field">
                                    <span>Shadow</span>
                                    <select class="form-select form-select-sm"
                                            disabled="@textControlsDisabled"
                                            @bind:get="textToolbarValue.Shadow"
                                            @bind:set="SetSelectedTextShadowAsync">
                                        <option value="@PicturePageTextShadow.None">None</option>
                                        <option value="@PicturePageTextShadow.Soft">Soft</option>
                                        <option value="@PicturePageTextShadow.Strong">Strong</option>
                                        <option value="@PicturePageTextShadow.Glow">Glow</option>
                                    </select>
                                </label>
                                <label class="picture-text-toolbar__field picture-text-toolbar__field--color">
                                    <span>Color</span>
                                    <input class="form-control form-control-color form-control-sm"
                                           type="color"
                                           disabled="@textControlsDisabled"
                                           value="@ColorInputValue(TextColorValue(textToolbarValue))"
                                           @oninput="PreviewSelectedTextColorAsync"
                                           @onchange="SaveSelectedTextColorAsync" />
                                </label>
                                <div class="picture-text-toolbar__field picture-text-toolbar__field--background-color">
                                    <span>Background</span>
                                    <details class="picture-background-picker"
                                             aria-disabled="@textControlsDisabled"
                                             inert="@(textControlsDisabled ? "inert" : null)">
                                        <summary class="picture-background-picker__summary"
                                                 aria-label="Choose text background color and opacity">
                                            <span class="picture-background-picker__swatch" aria-hidden="true">
                                                <span style="@BackgroundSwatchStyle(textToolbarValue)"></span>
                                            </span>
                                            <span class="picture-background-picker__value">@BackgroundOpacityPercent(textToolbarValue)</span>
                                        </summary>
                                        <div class="picture-background-picker__panel">
                                            <label class="picture-background-picker__field">
                                                <span>Color</span>
                                                <input class="form-control form-control-color form-control-sm"
                                                       type="color"
                                                       disabled="@textControlsDisabled"
                                                       value="@(ColorInputValue(TextBackgroundColorValue(textToolbarValue), "#FFFFFF"))"
                                                       @oninput="PreviewSelectedTextBackgroundColorAsync"
                                                       @onchange="SaveSelectedTextBackgroundColorAsync" />
                                            </label>
                                            <label class="picture-background-picker__field">
                                                <span class="picture-background-picker__field-heading">
                                                    <span>Opacity</span>
                                                    <output>@BackgroundOpacityPercent(textToolbarValue)</output>
                                                </span>
                                                <input class="form-range picture-text-toolbar__range"
                                                       type="range"
                                                       min="0"
                                                       max="1"
                                                       step="0.05"
                                                       disabled="@textControlsDisabled"
                                                       value="@(TextBackgroundOpacityValue(textToolbarValue).ToString("0.##", CultureInfo.InvariantCulture))"
                                                       @oninput="PreviewSelectedTextBackgroundOpacityAsync"
                                                       @onchange="SaveSelectedTextBackgroundOpacityAsync" />
                                            </label>
                                        </div>
                                    </details>
                                </div>
                    </div>
                </div>
            }
            <div class="picture-stage">
                <section class="@PicturePageClass(pageMetrics)" style="@PicturePageStyle(pageMetrics)" @onclick="ClearSelectedPictureElement">
                    @if (CanEditLayout)
                    {
                        <div class="picture-safe-guide picture-safe-guide--minimum" style="@SafeGuideStyle(pageMetrics, 0.375)" aria-hidden="true"></div>
                        <div class="picture-safe-guide picture-safe-guide--preferred" style="@SafeGuideStyle(pageMetrics, 0.5)" aria-hidden="true"></div>
                        @if (pageMetrics.IsDouble)
                        {
                            <div class="picture-gutter-guide" style="@GutterGuideStyle(pageMetrics, 0.375)" aria-hidden="true"></div>
                        }
                    }
                    @foreach (var image in State.PageLayout.Images.OrderBy(image => image.ZIndex))
                    {
                        var projectImage = ImageById(image.ImageId);
                        <div class="@PictureImageElementClass(image)"
                             style="@PictureElementStyle(image.XPercent, image.YPercent, image.WidthPercent, image.HeightPercent, image.ZIndex)"
                             @onclick="@(() => SelectPictureImage(image.Id))"
                             @onclick:stopPropagation="true"
                             data-picture-element-kind="@(CanEditLayout ? "image" : null)"
                             data-picture-element-id="@(CanEditLayout ? image.Id.ToString("N") : null)">
                            @if (projectImage is not null)
                            {
                                <img src="@PictureImageContentUrl(projectImage.Id)"
                                     alt="@(string.IsNullOrWhiteSpace(image.AltTextOverride) ? projectImage.AltText : image.AltTextOverride)"
                                     style="@($"object-fit:{FitCss(image.Fit)};opacity:{image.Opacity.ToString(CultureInfo.InvariantCulture)};")" />
                            }
                            @if (CanEditLayout)
                            {
                                @RenderPictureCornerControls("image", image.Id)
                            }
                        </div>
                    }
                    @foreach (var text in State.PageLayout.TextElements.OrderBy(text => text.ZIndex))
                    {
                        <div class="@PictureTextElementClass(text)"
                             style="@TextElementStyle(text)"
                             @onclick="@(() => SelectPictureText(text.Id))"
                             @onclick:stopPropagation="true"
                             @onfocusin="@(() => SelectPictureText(text.Id))"
                             data-picture-element-kind="@(CanEditLayout ? "text" : null)"
                             data-picture-element-id="@(CanEditLayout ? text.Id.ToString("N") : null)">
                            <div class="picture-text-frame">
                                <div class="picture-text-content"
                                     contenteditable="@(CanEditLayout ? "true" : null)"
                                     role="@(CanEditLayout ? "textbox" : null)"
                                     aria-multiline="@(CanEditLayout ? "true" : null)"
                                     aria-label="@(CanEditLayout ? "Edit picture page text" : null)"
                                     spellcheck="@(CanEditLayout ? "false" : null)"
                                     data-picture-text-editor="@(CanEditLayout ? "true" : null)">@text.Text</div>
                            </div>
                            @if (CanEditLayout)
                            {
                                @RenderPictureCornerControls("text", text.Id)
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    }
    else
    {
        var paragraphs = SplitParagraphs(State.Body);
        var pageMetrics = _pageGeometry;
        var pages = BuildProsePages(paragraphs, pageMetrics);
        var spreads = BuildProseSpreads(pages, pageMetrics.IsDouble);
        <div class="@(CanEditLayout ? "prose-layout prose-layout--editable" : "prose-layout")">
            @if (CanEditLayout)
            {
                <div class="picture-toolbar prose-toolbar">
                    <div class="picture-toolbar__actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenImagesAsync">Images</button>
                    </div>
                </div>
            }
            <div class="@ProsePagesClass(pageMetrics)" style="@ProsePageStyle(pageMetrics)">
                @foreach (var spread in spreads)
                {
                    <div class="@ProseSpreadClass(pageMetrics)" @key="spread.SpreadNumber">
                        @RenderProsePage(spread.Left)
                        @if (spread.Right is not null)
                        {
                            @RenderProsePage(spread.Right)
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<ProjectFontManagerModal ProjectId="@ProjectId"
                         IsOpen="@_fontManagerOpen"
                         OnClose="CloseFontManager"
                         OnChanged="ReloadFontsAsync" />

@code {
    private RenderFragment RenderProsePage(ProsePageModel page) =>
        @<section class="@ProsePageClass(page)" aria-label="@($"Page {page.PageNumber}")">
            @if (!page.IsBlank && page.Items.Count == 0)
            {
                <p class="empty-prose">(empty chapter)</p>
            }
            @if (!page.IsBlank)
            {
                @foreach (var item in page.Items)
                {
                    if (item.Kind == ProsePageItemKind.DropZone)
                    {
                        @RenderDropZone(item.ParagraphIndex, item.AnchorPosition)
                    }
                    else if (item.Kind == ProsePageItemKind.Illustration && item.Illustration is not null)
                    {
                        @RenderIllustrationBlock(item.Illustration)
                    }
                    else if (!string.IsNullOrWhiteSpace(item.Text))
                    {
                        <p>@item.Text</p>
                    }
                }
            }
        </section>;
    [Parameter, EditorRequired] public ChapterVisualState State { get; set; } = null!;
    [Parameter] public IReadOnlyList<ProjectImageView> Images { get; set; } = [];
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsLocked { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback<ChapterVisualState> OnChanged { get; set; }
    [Parameter] public EventCallback OnImagesChanged { get; set; }
    [Parameter] public EventCallback OnOpenImages { get; set; }

    private ElementReference _viewerRoot;
    private IJSObjectReference? _viewerModule;
    private DotNetObjectReference<PagedChapterViewer>? _selfRef;
    private PictureElementSelection? _selectedPictureElement;
    private readonly Dictionary<Guid, string> _textColorDrafts = [];
    private readonly Dictionary<Guid, string> _textBackgroundColorDrafts = [];
    private readonly Dictionary<Guid, double> _textBackgroundOpacityDrafts = [];
    private CancellationTokenSource? _textStyleSaveDebounce;
    private bool _disposed;
    private bool _fontManagerOpen;
    private bool _isFittingText;
    private Guid _fontProjectId;
    private Guid _geometryProjectId;
    private ChapterPageLayoutKind _geometryLayoutKind;
    private bool _hasPageGeometry;
    private BookBrief? _bookBrief;
    private BookPageGeometry _pageGeometry = PageGeometryService.CalculateValues(
        null,
        null,
        null,
        null,
        null,
        ChapterPageLayoutKind.SinglePortrait);
    private IReadOnlyList<ProjectFontFamilyView> _fontFamilies = PicturePageBuiltInFonts.Families;
    private PicturePageLayout? _diagnosticLayout;
    private IReadOnlyList<ChapterVisualLayoutDiagnostic> _renderDiagnostics = [];
    private static readonly PicturePageTextElement _disabledTextToolbarValue = new(
        Guid.Empty,
        string.Empty,
        0,
        0,
        0,
        0,
        0,
        0,
        PicturePageFontKeys.Default,
        400,
        false,
        24,
        0,
        1.35,
        "#111827",
        "#FFFFFF",
        0,
        PicturePageTextAlign.Left,
        ChapterTextVerticalAlign.Top,
        PicturePageTextShadow.None);
    private const double ParagraphSpacingInches = 0.14;
    private const double FigureSpacingInches = 0.16;
    private const double DropZoneHeightInches = 0.42;
    private bool CanEditLayout => IsEditable && !IsLocked && State.VisualMode != ChapterVisualMode.Prose;
    private IReadOnlyList<ChapterVisualLayoutDiagnostic> CurrentLayoutDiagnostics =>
        State.VisualMode == ChapterVisualMode.PicturePage
            ? (ReferenceEquals(_diagnosticLayout, State.PageLayout)
                    ? _renderDiagnostics
                    : PicturePageLayoutDiagnostics.Evaluate(_pageGeometry, State.PageLayout, _bookBrief))
                .Concat(State.PageLayout.TextElements
                    .Where(text => FontFamily(text.FontFamilyKey)?.Faces.Any(face => face.Weight == text.FontWeight && face.Italic == text.Italic) != true)
                     .Select(text => new ChapterVisualLayoutDiagnostic(
                         "unsupported_font_face",
                         "error",
                         "The selected font weight/style is unavailable; choose a listed face.",
                         text.Id,
                         null,
                         "requested face unresolved",
                         "an installed exact family/weight/style face",
                         "Choose an available face or add the required font file to the project.")))
                .DistinctBy(diagnostic => (diagnostic.Code, diagnostic.ElementId, diagnostic.RelatedElementId))
                .ToList()
            : [];

    private string PagedViewerClass() =>
        State.VisualMode == ChapterVisualMode.PicturePage
            ? "paged-viewer paged-viewer--picture"
            : "paged-viewer";

    private static string PictureTextToolbarClass(bool disabled) =>
        disabled
            ? "picture-text-toolbar picture-text-toolbar--disabled"
            : "picture-text-toolbar";

    private string LayoutDiagnosticSummary()
    {
        var diagnostics = CurrentLayoutDiagnostics;
        var errors = diagnostics.Count(item => item.Severity == "error");
        var warnings = diagnostics.Count - errors;
        return $"{errors} error{(errors == 1 ? string.Empty : "s")}, {warnings} warning{(warnings == 1 ? string.Empty : "s")}";
    }

    private void CloseFontManager() => _fontManagerOpen = false;

    private async Task ReloadFontsAsync()
    {
        _fontFamilies = await ProjectFonts.ListAsync(ProjectId);
        StateHasChanged();
    }

    private enum ProsePageItemKind
    {
        Paragraph,
        Illustration,
        DropZone,
    }

    private enum PictureElementKind
    {
        Image,
        Text,
    }

    private enum PictureLayerMove
    {
        Backward,
        Forward,
        ToBack,
        ToFront,
    }

    private readonly record struct PictureElementSelection(PictureElementKind Kind, Guid Id);

    private sealed record PictureLayerItem(
        PictureElementKind Kind,
        Guid Id,
        int ZIndex,
        int OriginalIndex);

    private sealed record ProsePageItem(
        ProsePageItemKind Kind,
        int ParagraphIndex,
        ChapterImageAnchorPosition AnchorPosition,
        string Text,
        IllustratedProseImageBlock? Illustration);

    private sealed record ProsePageModel(
        int PageNumber,
        bool IsBlank,
        IReadOnlyList<ProsePageItem> Items);

    private sealed record ProseSpreadModel(
        int SpreadNumber,
        ProsePageModel Left,
        ProsePageModel? Right);

    private sealed class ProsePageBuilder
    {
        public List<ProsePageItem> Items { get; } = [];
        public double UsedHeightInches { get; set; }
    }

    private PicturePageTextElement? SelectedPictureText =>
        _selectedPictureElement is { Kind: PictureElementKind.Text, Id: var selectedId }
            ? State.PageLayout.TextElements.FirstOrDefault(text => text.Id == selectedId)
            : null;

    private PictureLayerItem? SelectedPictureLayer =>
        _selectedPictureElement is { } selected
            ? OrderedPictureLayers().FirstOrDefault(layer => layer.Kind == selected.Kind && layer.Id == selected.Id)
            : null;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId != Guid.Empty && ProjectId != _fontProjectId)
        {
            _fontFamilies = await ProjectFonts.ListAsync(ProjectId);
            _bookBrief = await BookBriefs.GetOrCreateAsync(ProjectId);
            _fontProjectId = ProjectId;
        }

        if (ProjectId != Guid.Empty
            && (!_hasPageGeometry
                || ProjectId != _geometryProjectId
                || State.PageLayoutKind != _geometryLayoutKind))
        {
            _pageGeometry = await PageGeometry.GetAsync(ProjectId, State.PageLayoutKind);
            _geometryProjectId = ProjectId;
            _geometryLayoutKind = State.PageLayoutKind;
            _hasPageGeometry = true;
        }

        if (CanEditLayout
            && State.VisualMode == ChapterVisualMode.PicturePage
            && !ReferenceEquals(_diagnosticLayout, State.PageLayout))
        {
            var snapshots = await Visuals.RenderSnapshotsAsync(State.ChapterId);
            _renderDiagnostics = snapshots.SelectMany(snapshot => snapshot.LayoutDiagnostics).ToList();
            _diagnosticLayout = State.PageLayout;
        }

        if (_selectedPictureElement is { } selected && (!CanEditLayout
            || State.VisualMode != ChapterVisualMode.PicturePage
            || !PictureElementExists(selected.Kind, selected.Id)))
        {
            _selectedPictureElement = null;
        }
    }

    private RenderFragment RenderDropZone(int paragraphIndex, ChapterImageAnchorPosition position) =>
        @<button type="button" class="illustration-drop-zone"
                 data-illustration-drop-target="true"
                 data-illustration-paragraph-index="@paragraphIndex"
                 data-illustration-anchor-position="@position.ToString()">
            @(position == ChapterImageAnchorPosition.BeforeParagraph ? "Drop image before paragraph" : "Drop image after paragraph")
        </button>;

    private RenderFragment RenderIllustrationBlock(IllustratedProseImageBlock block) =>
        @<figure class="@IllustrationBlockClass(block)"
                 style="@($"width:{block.WidthPercent.ToString(CultureInfo.InvariantCulture)}%;")"
                 data-illustration-id="@(CanEditLayout ? block.Id.ToString("N") : null)">
            @{
                var image = ImageById(block.ImageId);
            }
            <div class="illustration-image-box">
                @if (image is not null)
                {
                    <img src="@image.PreviewUrl" alt="@(string.IsNullOrWhiteSpace(block.AltTextOverride) ? image.AltText : block.AltTextOverride)" />
                }
                @if (CanEditLayout)
                {
                    <div class="illustration-element-chrome">
                        <button type="button" class="picture-corner-control picture-corner-control--move"
                                data-illustration-move="true" title="Move" aria-label="Move illustration"></button>
                        <button type="button" class="picture-corner-control picture-corner-control--remove"
                                title="Remove" aria-label="Remove illustration"
                                @onclick="@(() => RemoveIllustrationAsync(block.Id))"></button>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(block.Caption))
            {
                <figcaption>@block.Caption</figcaption>
            }
            @if (CanEditLayout)
            {
                <div class="illustration-controls">
                    <input class="illustration-width-control" type="range" min="20" max="100"
                           value="@block.WidthPercent.ToString(CultureInfo.InvariantCulture)"
                           aria-label="Image width"
                           @onchange="@(e => UpdateIllustrationWidthAsync(block.Id, e.Value?.ToString()))" />
                    <div class="illustration-alignment-group" role="group" aria-label="Image alignment">
                        <button type="button" class="@IllustrationAlignmentButtonClass(block.Alignment, ChapterImageAlignment.Left)" @onclick="@(() => UpdateIllustrationAlignmentAsync(block.Id, ChapterImageAlignment.Left))">Left</button>
                        <button type="button" class="@IllustrationAlignmentButtonClass(block.Alignment, ChapterImageAlignment.Center)" @onclick="@(() => UpdateIllustrationAlignmentAsync(block.Id, ChapterImageAlignment.Center))">Center</button>
                        <button type="button" class="@IllustrationAlignmentButtonClass(block.Alignment, ChapterImageAlignment.Right)" @onclick="@(() => UpdateIllustrationAlignmentAsync(block.Id, ChapterImageAlignment.Right))">Right</button>
                    </div>
                </div>
            }
        </figure>;

    private RenderFragment RenderPictureCornerControls(string kind, Guid elementId) =>
        @<div class="picture-element-chrome">
            @{
                Func<Task> onRemove = kind == "image"
                    ? () => RemovePictureImageAsync(elementId)
                    : () => RemovePictureTextAsync(elementId);
            }
            <span class="picture-corner-control picture-corner-control--move" data-picture-move="true" title="Move" aria-label="@($"Move {kind}")"></span>
