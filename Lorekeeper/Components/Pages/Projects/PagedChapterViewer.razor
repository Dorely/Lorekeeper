    private void DebounceSelectedTextStyleSave(Guid textId)
    {
        _textStyleSaveDebounce?.Cancel();
        _textStyleSaveDebounce?.Dispose();
        _textStyleSaveDebounce = new CancellationTokenSource();
        var token = _textStyleSaveDebounce.Token;

        _ = SaveSelectedTextStyleAfterDelayAsync(textId, token);
    }

    private async Task SaveSelectedTextStyleAfterDelayAsync(Guid textId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(300, cancellationToken);
            await InvokeAsync(() => PersistSelectedTextStyleAsync(textId, cancellationToken));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PersistSelectedTextStyleAsync(Guid textId, CancellationToken cancellationToken = default)
    {
        if (_disposed || !CanEditLayout || cancellationToken.IsCancellationRequested)
            return;

        var selectedText = State.PageLayout.TextElements.FirstOrDefault(text => text.Id == textId);
        if (selectedText is null)
        {
            ClearTextStyleDrafts(textId);
            return;
        }

        var color = _textColorDrafts.TryGetValue(textId, out var colorDraft)
            ? CleanColor(colorDraft) ?? selectedText.Color
            : null;
        var backgroundColor = _textBackgroundColorDrafts.TryGetValue(textId, out var backgroundColorDraft)
            ? CleanColor(backgroundColorDraft) ?? selectedText.BackgroundColor
            : null;
        var backgroundOpacity = _textBackgroundOpacityDrafts.TryGetValue(textId, out var backgroundOpacityDraft)
            ? ClampOpacity(backgroundOpacityDraft)
            : (double?)null;

        var changed = (color is not null && !string.Equals(CleanColor(selectedText.Color), color, StringComparison.Ordinal))
            || (backgroundColor is not null && !string.Equals(CleanColor(selectedText.BackgroundColor), backgroundColor, StringComparison.Ordinal))
            || (backgroundOpacity is not null && Math.Abs(selectedText.BackgroundOpacity - backgroundOpacity.Value) > 0.0001);
        if (!changed)
        {
            ClearTextStyleDrafts(textId);
            return;
        }

        await UpdatePictureTextAsync(
            textId,
            color: color,
            backgroundColor: backgroundColor,
            backgroundOpacity: backgroundOpacity);
        ClearTextStyleDrafts(textId);
    }

    private void ClearTextStyleDrafts(Guid textId)
    {
        _textColorDrafts.Remove(textId);
        _textBackgroundColorDrafts.Remove(textId);
        _textBackgroundOpacityDrafts.Remove(textId);
    }

