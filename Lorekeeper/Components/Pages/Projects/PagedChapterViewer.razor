        metrics.IsDouble ? "prose-pages prose-pages--double" : "prose-pages prose-pages--single";

    private static string ProseSpreadClass(BookPageGeometry metrics) =>
        metrics.IsDouble ? "prose-spread prose-spread--double" : "prose-spread prose-spread--single";

