@using Lorekeeper.Models
@using Lorekeeper.Writing
@using Lorekeeper.Outline
@inject IWritingSampleService Samples
@inject IEntityService Entities
@inject VoiceProfileService Profiles

@if (Project is not null)
{
    <div class="writing-sample-pane">
        <div class="writing-sample-pane-chat">
            <VoicePanel ProjectId="Project.Id" CurrentSampleTitle="@CurrentTitle" CurrentSampleBody="@CurrentBody" OnMutated="ReloadAsync" />
        </div>
        <section class="writing-sample-editor-panel p-3">
            <div class="btn-group mb-3" role="group" aria-label="Voice workspace">
                <button class="btn @(!_charactersView ? "btn-primary" : "btn-outline-primary")" @onclick="() => SwitchViewAsync(false)">Writing Samples</button>
                <button class="btn @(_charactersView ? "btn-primary" : "btn-outline-primary")" @onclick="() => SwitchViewAsync(true)">Character Voices</button>
            </div>
            @if (_error is not null) { <div class="alert alert-danger">@_error</div> }
            @if (_charactersView)
            {
                <select class="form-select mb-2" aria-label="Character" value="@_characterId" @onchange="SelectCharacter">
                    <option value="">Select a character</option>
                    @foreach (var option in _characters) { <option value="@option.Id">@option.Name</option> }
                </select>
                @if (CurrentCharacter is { } character)
                {
                    <NarrativeTextEditor @ref="_editor" @key="character.Id" ProjectId="Project.Id" TargetId="@($"voice:{character.Id:N}")"
                        Label="@($"{character.Name} voice profile")" Body="@VoiceProfileService.Read(character)"
                        Placeholder="Describe dialogue, POV narration, rhythm, vocabulary, emotional variations, and illustrative lines..."
                        Save="draft => SaveProfileAsync(character.Id, draft)" OnResumed="ReloadAsync" />
                }
                else { <p>Select a character, or ask Voice to create one.</p> }
            }
            else if (_current is { } sample)
            {
                <NarrativeTextEditor @ref="_editor" @key="sample.Id" ProjectId="Project.Id" TargetId="@($"sample:{sample.Id:N}")"
                    Label="Writing sample" EditTitle="true" Title="@sample.Title" Body="@sample.Body" Revision="sample.Revision"
                    Placeholder="Write a passage that sounds like you..." Save="draft => SaveSampleAsync(sample.Id, draft)" OnResumed="ReloadAsync" />
            }
            else { <button class="btn btn-primary" @onclick="CreateSampleAsync">Create first sample</button> }
        </section>
        <div class="writing-sample-pane-list">
            <WritingSampleListPanel Samples="_samples" ActiveSampleId="@_current?.Id"
                OnSelect="SelectSampleAsync" OnCreate="CreateSampleAsync" OnDelete="DeleteSampleAsync" />
        </div>
    </div>
}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [SupplyParameterFromQuery(Name = "character")] public Guid? CharacterId { get; set; }
    private NarrativeTextEditor? _editor;
    private List<WritingSample> _samples = [];
    private IReadOnlyList<StoryEntity> _characters = [];
    private WritingSample? _current;
    private Guid? _characterId;
    private Guid? _loadedProject;
    private bool _charactersView;
    private string? _error;
    private StoryEntity? CurrentCharacter => _characters.FirstOrDefault(value => value.Id == _characterId);
    private string? CurrentTitle => _charactersView ? $"Character {CurrentCharacter?.Name} ({_characterId})" : $"Writing sample {_current?.Title} ({_current?.Id})";
    private string? CurrentBody => _charactersView && CurrentCharacter is { } character ? VoiceProfileService.Read(character) : _current?.Body;
    protected override async Task OnParametersSetAsync()
    {
        if (Project is null || _loadedProject == Project.Id) return;
        _loadedProject = Project.Id;
        _characterId = CharacterId;
        _charactersView = CharacterId.HasValue;
        await ReloadAsync();
    }
    private async Task ReloadAsync()
    {
        if (Project is null) return;
        _samples = (await Samples.ListAsync(Project.Id)).ToList();
        _current = _samples.FirstOrDefault(value => value.Id == _current?.Id) ?? _samples.FirstOrDefault();
        _characters = await Entities.ListAsync(Project.Id, "Character");
    }
    private async Task<NarrativeTextSnapshot> SaveSampleAsync(Guid id, NarrativeTextSnapshot draft)
    {
        var updated = await Samples.UpdateAsync(Project!.Id, id, draft.Revision, draft.Title, draft.Body);
        var index = _samples.FindIndex(sample => sample.Id == id);
        if (index >= 0) _samples[index] = updated;
        if (_current?.Id == id) _current = updated;
        StateHasChanged();
        return new(updated.Title, updated.Body, updated.Revision, updated.Body);
    }
    private async Task<NarrativeTextSnapshot> SaveProfileAsync(Guid id, NarrativeTextSnapshot draft)
    {
        var updated = await Profiles.SaveAsync(Project!.Id, id, draft.ExpectedContent, draft.Body);
        _characters = _characters.Select(value => value.Id == updated.Id ? updated : value).ToList();
        StateHasChanged();
        return draft with { ExpectedContent = draft.Body };
    }
    private async Task<bool> CanLeaveAsync()
    {
        try { if (_editor is not null) await _editor.EnsureSavedAsync(); return true; }
        catch (InvalidOperationException exception) { _error = exception.Message; return false; }
    }
    private async Task SwitchViewAsync(bool characters) { if (await CanLeaveAsync()) _charactersView = characters; }
    private async Task SelectCharacter(ChangeEventArgs args)
    {
        if (await CanLeaveAsync()) _characterId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
    }
    private async Task SelectSampleAsync(Guid id)
    {
        if (!await CanLeaveAsync()) return;
        _current = _samples.FirstOrDefault(value => value.Id == id);
        _charactersView = false;
    }
    private async Task CreateSampleAsync()
    {
        if (Project is null) return;
        if (!await CanLeaveAsync()) return;
        try { _current = await Samples.CreateAsync(Project.Id); _charactersView = false; await ReloadAsync(); }
        catch (Exception exception) { _error = exception.Message; }
    }
    private async Task DeleteSampleAsync(Guid id)
    {
        if (Project is null) return;
        try
        {
            if (!await CanLeaveAsync()) return;
            var sample = _samples.Single(value => value.Id == id);
            await Samples.DeleteAsync(Project.Id, id, sample.Revision);
            await ReloadAsync();
        }
        catch (Exception exception) { _error = exception.Message; }
    }
}
