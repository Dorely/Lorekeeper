@using System.Text
@using System.Text.Json
@using Lorekeeper.Models
@using Lorekeeper.Tokens
@using Lorekeeper.Writing
@implements IAsyncDisposable
@inject IWritingCoachService Coach
@inject ITokenCounter TokenCounter
@inject IJSRuntime JS

<div class="writing-coach">
    <div class="writing-coach-header">
        <div class="writing-coach-heading">
            <span class="writing-coach-title">Writing Coach</span>
            <span class="writing-coach-token-count" title="@ConversationTokenTitle()">
                @ConversationTokenText()
            </span>
        </div>
        <button type="button" class="btn btn-link btn-sm writing-coach-reset" title="Start over"
                disabled="@_running" @onclick="ResetAsync">Reset</button>
    </div>

    <div class="writing-coach-scroll" @ref="_scrollEl">
        @if (_loading)
        {
            <div class="writing-coach-empty"><em>Loading...</em></div>
        }
        else
        {
            @foreach (var message in _renderable)
            {
                @RenderMessage(message)
            }
            @if (_live is not null)
            {
                @RenderLive(_live)
            }
        }
        <div class="writing-coach-bottom-sentinel" aria-hidden="true"></div>
    </div>

    @if (_error is not null)
    {
        <div class="writing-coach-error">
            <span>@_error</span>
            <button type="button" class="btn-close btn-close-sm" @onclick="() => _error = null"></button>
        </div>
    }

    <div class="writing-coach-composer">
        <textarea class="form-control writing-coach-input" rows="1" placeholder="Ask for a prompt or feedback..."
                  @ref="_composerEl"
                  disabled="@_running"
                  @bind="_input" @bind:event="oninput"
                  @onkeydown="OnKeyDown"></textarea>
        @if (_running)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="CancelAsync">Stop</button>
        }
        else
        {
            <button type="button" class="btn btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(_input)"
                    @onclick="SendAsync">Send</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public string? CurrentSampleTitle { get; set; }
    [Parameter] public string? CurrentSampleBody { get; set; }
    [Parameter] public Func<Task<(string? Title, string? Body)>>? GetCurrentDraft { get; set; }

    private ElementReference _scrollEl;
    private ElementReference _composerEl;
    private IJSObjectReference? _scroller;
    private bool _scrollerAttached;
    private bool _autoSizeAttached;
    private bool _resetComposerAfterRender;
    private bool _scrollAfterRender;
    private bool _forceScrollAfterRender;

    private WritingCoachConversation? _conversation;
    private List<WritingCoachMessage> _messages = [];
    private List<RenderableMessage> _renderable = [];
    private LiveTurn? _live;

    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _cts;
    private Guid? _loadedProjectId;
    private string? _pendingUserText;
    private int _conversationTokenCount;
    private bool _conversationTokenIsExact = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scroller = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/Projects/WritingSample/WritingCoachPanel.razor.js");
        }
        if (_scroller is not null && !_scrollerAttached)
        {
            try { await _scroller.InvokeVoidAsync("attachScroller", _scrollEl); _scrollerAttached = true; }
            catch { }
        }
        if (_scroller is not null && !_autoSizeAttached)
        {
            try { await _scroller.InvokeVoidAsync("attachAutoSize", _composerEl); _autoSizeAttached = true; }
            catch { }
        }
        if (_scroller is not null && _resetComposerAfterRender)
        {
            _resetComposerAfterRender = false;
            await ResetComposerSizeAsync();
        }
        if (_scroller is not null && _scrollAfterRender)
        {
            var force = _forceScrollAfterRender;
            _scrollAfterRender = false;
            _forceScrollAfterRender = false;
            await ScrollToBottomAsync(force);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty) return;
        if (_loadedProjectId == ProjectId) return;

        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _conversation = await Coach.GetOrCreateAsync(ProjectId);
            _messages = (await Coach.LoadMessagesAsync(_conversation.Id)).ToList();
            RebuildRenderable();
            _pendingUserText = null;
            _live = null;
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync()
    {
        var text = _input?.Trim();
        if (_running || string.IsNullOrEmpty(text)) return;

        (string? Title, string? Body) draft = GetCurrentDraft is null
            ? (CurrentSampleTitle, CurrentSampleBody)
            : await GetCurrentDraft.Invoke();

        _input = string.Empty;
        _running = true;
        _error = null;
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _resetComposerAfterRender = true;

        _renderable.Add(new RenderableMessage(
            Id: Guid.NewGuid(),
            Role: WritingCoachMessageRole.User,
            Status: WritingCoachMessageStatus.Completed,
            Parts: [new TextPart(text)]));
        _live = new LiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        try
        {
            await foreach (var update in Coach.SendAsync(ProjectId, text, draft.Title, draft.Body, _cts.Token))
            {
                switch (update)
                {
                    case WritingCoachTextDelta delta:
                        _live!.AppendText(delta.Text);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case WritingCoachToolCallStarted started:
                        _live!.AddToolCall(started.CallId, started.ToolName, started.ArgumentsJson);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case WritingCoachToolCallCompleted completed:
                        _live!.CompleteToolCall(completed.CallId, completed.Result, completed.Error);
                        UpdateConversationTokenCount();
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case WritingCoachAssistantMessageCompleted:
                        await ReloadFromDbAsync();
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;

                    case WritingCoachTurnError error:
                        _error = error.Cancelled ? null : error.Message;
                        await ReloadFromDbAsync();
                        _live = null;
                        RequestScroll();
                        StateHasChanged();
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            _live = null;
            UpdateConversationTokenCount();
            _cts?.Dispose();
            _cts = null;
            RequestScroll();
            StateHasChanged();
        }
    }

    private async Task ResetAsync()
    {
        if (_running) return;
        await Coach.ResetAsync(ProjectId);
        _loadedProjectId = null;
        await LoadAsync();
    }

    private void CancelAsync() => _cts?.Cancel();

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _messages = (await Coach.LoadMessagesAsync(_conversation.Id)).ToList();
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private void RebuildRenderable()
    {
        var byCallId = _messages
            .Where(message => message.Role == WritingCoachMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<RenderableMessage>(_messages.Count);
        foreach (var message in _messages)
        {
            if (message.Role == WritingCoachMessageRole.Tool) continue;
            if (message.Role == WritingCoachMessageRole.System) continue;

            _renderable.Add(new RenderableMessage(
                Id: message.Id,
                Role: message.Role,
                Status: message.Status,
                Parts: BuildMessageParts(message, byCallId)));
        }
    }

    private void UpdateConversationTokenCount()
    {
        var result = TokenCounter.Count(BuildConversationTokenText());
        _conversationTokenCount = result.TokenCount;
        _conversationTokenIsExact = result.IsExact;
    }

    private string BuildConversationTokenText()
    {
        var sb = new StringBuilder();
        sb.AppendLine("System:");
        sb.AppendLine(WritingCoachService.CoachSystemPrompt);

        foreach (var message in _messages)
            AppendMessageForTokenCount(sb, message);

        if (!string.IsNullOrWhiteSpace(_pendingUserText))
        {
            sb.AppendLine("User:");
            sb.AppendLine(_pendingUserText);
        }

        AppendLiveTurnForTokenCount(sb, _live);
        return sb.ToString();
    }

    private static void AppendMessageForTokenCount(StringBuilder sb, WritingCoachMessage message)
    {
        sb.Append(message.Role).AppendLine(":");
        if (!string.IsNullOrEmpty(message.Content))
            sb.AppendLine(message.Content);
        if (!string.IsNullOrWhiteSpace(message.ToolCallsJson) && message.ToolCallsJson != "[]")
        {
            sb.AppendLine("Tool calls:");
            sb.AppendLine(message.ToolCallsJson);
        }
        if (!string.IsNullOrWhiteSpace(message.ToolName) || !string.IsNullOrWhiteSpace(message.ToolCallId))
            sb.Append("Tool: ").Append(message.ToolName).Append(' ').AppendLine(message.ToolCallId);
        if (!string.IsNullOrWhiteSpace(message.ErrorMessage))
            sb.Append("Error: ").AppendLine(message.ErrorMessage);
    }

    private static void AppendLiveTurnForTokenCount(StringBuilder sb, LiveTurn? live)
    {
        if (live is null) return;

        foreach (var message in live.Messages)
        {
            foreach (var part in message.Parts)
            {
                if (part is TextPart textPart)
                {
                    var text = textPart.Text.ToString();
                    if (!string.IsNullOrEmpty(text))
                        sb.AppendLine(text);
                }
                else if (part is ToolPart toolPart)
                {
                    AppendToolChipForTokenCount(sb, toolPart.Chip);
                }
            }
        }
    }

    private static void AppendToolChipForTokenCount(StringBuilder sb, ToolChip chip)
    {
        sb.Append("Tool: ").Append(chip.Name).Append(' ').AppendLine(chip.CallId);
        if (!string.IsNullOrWhiteSpace(chip.ArgumentsJson) && chip.ArgumentsJson != "{}")
            sb.Append("Args: ").AppendLine(chip.ArgumentsJson);
        if (!string.IsNullOrWhiteSpace(chip.Result))
            sb.Append("Result: ").AppendLine(chip.Result);
        if (!string.IsNullOrWhiteSpace(chip.Error))
            sb.Append("Error: ").AppendLine(chip.Error);
    }

    private string ConversationTokenText() =>
        $"{TokenPrefix(_conversationTokenIsExact)}{_conversationTokenCount:N0} conversation tokens";

    private string ConversationTokenTitle() => _conversationTokenIsExact
        ? "Current conversation token count"
        : "Current conversation token count is estimated";

    private static string TokenPrefix(bool isExact) => isExact ? string.Empty : "~";

    private static List<MessagePart> BuildMessageParts(WritingCoachMessage message, IReadOnlyDictionary<string, WritingCoachMessage> byCallId)
    {
        if (message.Role != WritingCoachMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new TextPart(message.Content)];

        var calls = ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new TextPart(message.Content)];

        var parts = new List<MessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls
                .Select((call, index) => new { Call = call, Index = index })
                .OrderBy(item => item.Call.TextOffset!.Value)
                .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new TextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new TextPart(message.Content[cursor..]));

            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new TextPart(message.Content));
        foreach (var call in calls)
            parts.Add(new ToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ToolChip BuildToolChip(PersistedCall call, IReadOnlyDictionary<string, WritingCoachMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        return new ToolChip
        {
            CallId = call.CallId,
            Name = call.Name,
            ArgumentsJson = call.ArgumentsJson,
            Result = resultMessage?.Status == WritingCoachMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == WritingCoachMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = resultMessage is not null,
        };
    }

    private static List<PersistedCall> ReadPersistedCalls(string toolCallsJson)
    {
        if (string.IsNullOrWhiteSpace(toolCallsJson) || toolCallsJson == "[]") return [];
        try { return JsonSerializer.Deserialize<List<PersistedCall>>(toolCallsJson) ?? []; }
        catch { return []; }
    }

    private RenderFragment RenderChip(ToolChip chip) => __builder =>
    {
        var stateClass = chip.Error is not null
            ? "writing-coach-chip-error"
            : (chip.Completed ? "writing-coach-chip-ok" : "writing-coach-chip-pending");
        <details class="writing-coach-chip @stateClass">
            <summary>
                <span class="writing-coach-chip-icon">@(chip.Error is not null ? "x" : (chip.Completed ? "ok" : "..."))</span>
                <span class="writing-coach-chip-name">@chip.Name</span>
                @if (!string.IsNullOrWhiteSpace(chip.ArgumentsJson) && chip.ArgumentsJson != "{}")
                {
                    <span class="writing-coach-chip-args">@TruncateInline(chip.ArgumentsJson, 80)</span>
                }
            </summary>
            <div class="writing-coach-chip-body">
                @if (!string.IsNullOrWhiteSpace(chip.ArgumentsJson) && chip.ArgumentsJson != "{}")
                {
                    <div class="writing-coach-chip-section">args</div>
                    <pre class="writing-coach-chip-pre">@chip.ArgumentsJson</pre>
                }
                @if (chip.Error is not null)
                {
                    <div class="writing-coach-chip-section">error</div>
                    <pre class="writing-coach-chip-pre writing-coach-chip-pre-error">@chip.Error</pre>
                }
                else if (chip.Result is not null)
                {
                    <div class="writing-coach-chip-section">result</div>
                    <pre class="writing-coach-chip-pre">@chip.Result</pre>
                }
                else
                {
                    <div class="writing-coach-chip-section text-muted"><em>running...</em></div>
                }
            </div>
        </details>
    };

    private static string TruncateInline(string value, int max)
    {
        value = value.Replace('\n', ' ').Replace('\r', ' ');
        return value.Length <= max ? value : value[..max] + "...";
    }

    private RenderFragment RenderMessage(RenderableMessage message) => __builder =>
    {
        var bubbleClass = message.Role == WritingCoachMessageRole.User
            ? "writing-coach-msg writing-coach-msg-user"
            : "writing-coach-msg writing-coach-msg-asst";
        <div class="@bubbleClass">
            @foreach (var part in message.Parts)
            {
                @RenderPart(part)
            }
            @if (message.Status == WritingCoachMessageStatus.Failed)
            {
                <div class="writing-coach-msg-status writing-coach-msg-failed">Failed</div>
            }
            else if (message.Status == WritingCoachMessageStatus.Cancelled)
            {
                <div class="writing-coach-msg-status writing-coach-msg-cancelled">Cancelled</div>
            }
        </div>
    };

    private RenderFragment RenderLive(LiveTurn live) => __builder =>
    {
        if (!live.HasContent)
        {
            <div class="writing-coach-msg writing-coach-msg-asst writing-coach-msg-streaming">
                <span class="writing-coach-typing"><span></span><span></span><span></span></span>
            </div>
            return;
        }

        var visibleMessages = live.Messages.Where(message => message.Parts.Count > 0).ToList();
        var lastVisibleMessage = visibleMessages.LastOrDefault();
        @foreach (var liveMessage in visibleMessages)
        {
            var trailingText = ReferenceEquals(liveMessage, lastVisibleMessage)
                ? liveMessage.Parts.LastOrDefault() as TextPart
                : null;
            <div class="writing-coach-msg writing-coach-msg-asst writing-coach-msg-streaming">
                @foreach (var part in liveMessage.Parts)
                {
                    @RenderPart(part, ReferenceEquals(part, trailingText))
                }
            </div>
        }
    };

    private RenderFragment RenderPart(MessagePart part, bool showCursor = false) => __builder =>
    {
        if (part is TextPart textPart)
        {
            var text = textPart.Text.ToString();
            if (!string.IsNullOrEmpty(text))
            {
                <div class="writing-coach-msg-text">@text@if (showCursor) { <span class="writing-coach-cursor">|</span> }</div>
            }
        }
        else if (part is ToolPart toolPart)
        {
            @RenderChip(toolPart.Chip)
        }
    };

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendAsync();
    }

    private void RequestScroll(bool force = false)
    {
        _scrollAfterRender = true;
        _forceScrollAfterRender = _forceScrollAfterRender || force;
    }

    private async Task ResumeAutoFollowAsync()
    {
        if (_scroller is null) return;
        try { await _scroller.InvokeVoidAsync("resumeAutoFollow", _scrollEl); }
        catch { }
    }

    private async Task ScrollToBottomAsync(bool force = false)
    {
        if (_scroller is null) return;
        try { await _scroller.InvokeVoidAsync("scrollToBottom", _scrollEl, force); }
        catch { }
    }

    private async Task ResetComposerSizeAsync()
    {
        if (_scroller is null) return;
        try { await _scroller.InvokeVoidAsync("resetAutoSize", _composerEl); }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        if (_scroller is not null)
        {
            try { await _scroller.DisposeAsync(); } catch { }
        }
    }

    private sealed record RenderableMessage(
        Guid Id,
        WritingCoachMessageRole Role,
        WritingCoachMessageStatus Status,
        List<MessagePart> Parts);

    private abstract class MessagePart;

    private sealed class TextPart : MessagePart
    {
        public TextPart(string text) => Text.Append(text);

        public StringBuilder Text { get; } = new();

        public void Append(string text) => Text.Append(text);
    }

    private sealed class ToolPart(ToolChip chip) : MessagePart
    {
        public ToolChip Chip { get; } = chip;
    }

    private sealed class ToolChip
    {
        public required string CallId { get; init; }
        public required string Name { get; init; }
        public required string ArgumentsJson { get; init; }
        public string? Result { get; set; }
        public string? Error { get; set; }
        public bool Completed { get; set; }
    }

    private sealed class LiveTurn
    {
        private bool _startNewMessageOnNextPart;

        public List<LiveMessage> Messages { get; } = [];

        public bool HasContent => Messages.Any(message => message.Parts.Count > 0);

        public void AppendText(string text)
        {
            if (string.IsNullOrEmpty(text)) return;
            CurrentMessage().AppendText(text);
        }

        public void AddToolCall(string callId, string name, string argumentsJson)
        {
            CurrentMessage().Parts.Add(new ToolPart(new ToolChip
            {
                CallId = callId,
                Name = name,
                ArgumentsJson = argumentsJson,
            }));
        }

        public void CompleteToolCall(string callId, string? result, string? error)
        {
            var chip = Messages
                .SelectMany(message => message.Parts)
                .OfType<ToolPart>()
                .Select(part => part.Chip)
                .FirstOrDefault(candidate => candidate.CallId == callId);
            if (chip is not null)
            {
                chip.Result = result;
                chip.Error = error;
                chip.Completed = true;
            }
            _startNewMessageOnNextPart = true;
        }

        private LiveMessage CurrentMessage()
        {
            if (_startNewMessageOnNextPart || Messages.Count == 0)
            {
                var message = new LiveMessage();
                Messages.Add(message);
                _startNewMessageOnNextPart = false;
                return message;
            }

            return Messages[^1];
        }
    }

    private sealed class LiveMessage
    {
        public List<MessagePart> Parts { get; } = [];

        public void AppendText(string text)
        {
            if (Parts.LastOrDefault() is TextPart textPart)
                textPart.Append(text);
            else
                Parts.Add(new TextPart(text));
        }
    }

    private sealed record PersistedCall(string CallId, string Name, string ArgumentsJson, int? TextOffset = null);
}