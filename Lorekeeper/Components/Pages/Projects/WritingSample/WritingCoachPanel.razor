@using Lorekeeper.ChatTurns
@using Lorekeeper.Models
@using Lorekeeper.Llm
@using Lorekeeper.Tokens
@using Lorekeeper.Writing
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IWritingCoachService Coach
@inject IWritingCoachTurnRunner ChatTurns
@inject IChatImageAttachmentService ImageAttachments
@inject ILlmProviderService Providers
@inject ITokenCounter TokenCounter
@inject ChatTokenLimitResolver TokenLimits

<ChatSurface Title="Writing Coach"
             ProjectId="@ProjectId"
             Surface="ChatTurnSurface.WritingCoach"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel, ConversationTokenLimit)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel, ConversationTokenLimit, ActiveModelId)"
             ShowTokenResetSuggestion="@_conversationTokens.ShouldSuggestReset(ConversationTokenLimit)"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Ask for a prompt or feedback..."
             Running="@_running"
             ComposerDisabled="@(ChatDisabled || _running)"
             SendDisabled="@(ChatDisabled || string.IsNullOrWhiteSpace(_input))"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
        <button type="button" class="btn btn-link btn-sm writing-coach-reset" title="Start over"
                disabled="@(ChatDisabled || _running)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        @if (ChatDisabled)
        {
            <div class="alert alert-warning py-2 small mb-2">
                LLM chat is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
            </div>
        }
    </ExtraControls>
</ChatSurface>

@code {
    private const string ConversationTokenUnitLabel = "chat tokens";
    private const string ConversationTokenTitleLabel = "model input token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public string? CurrentSampleTitle { get; set; }
    [Parameter] public string? CurrentSampleBody { get; set; }
    [Parameter] public Func<Task<(string? Title, string? Body)>>? GetCurrentDraft { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;

    private WritingCoachConversation? _conversation;
    private List<WritingCoachMessage> _messages = [];
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;

    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _listenCts;
    private Guid? _listeningTurnId;
    private Guid? _loadedProjectId;
    private string? _pendingUserText;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private ChatProviderAvailability? _chatAvailability;
    private IReadOnlyDictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>> _messageImages = new Dictionary<Guid, IReadOnlyList<ChatTurnImageAttachment>>();
    private string? ActiveModelId => _chatAvailability?.Provider?.ModelId;
    private int ConversationTokenLimit => TokenLimits.Resolve(ActiveModelId);
    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty) return;
        if (_loadedProjectId == ProjectId) return;

        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        StopListening();
        _loading = true;
        try
        {
            _conversation = await Coach.GetOrCreateAsync(ProjectId);
            _chatAvailability = await Providers.GetDefaultChatProviderAvailabilityAsync();
            _messages = (await Coach.LoadMessagesAsync(_conversation.Id)).ToList();
            _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.WritingCoach);
            var activeTurn = ChatTurns.GetActiveTurn(ProjectId);
            RebuildRenderable(activeTurn?.StartedAtUtc);
            if (activeTurn is not null)
            {
                _renderable.Add(new ChatRenderableMessage(
                    Id: Guid.NewGuid(),
                    Role: ChatMessageRole.User,
                    Status: ChatMessageStatus.Completed,
                    Parts: ChatImageParts.BuildUserParts(activeTurn.UserText, activeTurn.Images)));
                _pendingUserText = activeTurn.UserText;
                _live = new ChatLiveTurn();
                _running = true;
                await ListenToActiveTurnAsync(activeTurn);
            }
            else
            {
                _pendingUserText = null;
                _live = null;
                _running = false;
            }
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync(ChatComposerSubmission submission)
    {
        var text = submission.Text.Trim();
        if (_running || string.IsNullOrEmpty(text)) return;
        if (ChatDisabled)
        {
            _error = ChatDisabledMessage;
            return;
        }
        if (submission.Images.Count > 0
            && (_chatAvailability?.Provider is null
                || !await Providers.IsVisionProviderWorkingAsync(_chatAvailability.Provider.Id)))
        {
            _error = "The active chat provider has not passed Test Vision. Run Test Vision in Settings > Providers before sending images.";
            return;
        }

        (string? Title, string? Body) draft = GetCurrentDraft is null
            ? (CurrentSampleTitle, CurrentSampleBody)
            : await GetCurrentDraft.Invoke();

        _input = string.Empty;
        _running = true;
        _error = null;
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Id: Guid.NewGuid(),
            Role: ChatMessageRole.User,
            Status: ChatMessageStatus.Completed,
            Parts: ChatImageParts.BuildUserParts(text, submission.Images)));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        await ResumeAutoFollowAsync();
        RequestScroll(force: true);
        StateHasChanged();

        if (!ChatTurns.TryStart(ProjectId, text, draft.Title, draft.Body, submission.Images))
        {
            _error = "Writing Coach already has a running turn.";
            ReleaseRunningUi();
            if (ChatTurns.GetActiveTurn(ProjectId) is { } existingTurn)
                await ListenToActiveTurnAsync(existingTurn);
            return;
        }

        if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
            await ListenToActiveTurnAsync(activeTurn);
    }

    private async Task ResetAsync()
    {
        if (_running) return;
        await Coach.ResetAsync(ProjectId);
        _loadedProjectId = null;
        await LoadAsync();
    }

    private async Task ListenToActiveTurnAsync(ChatTurnSnapshot activeTurn)
    {
        if (_listeningTurnId == activeTurn.TurnId)
            return;

        StopListening();
        var subscription = ChatTurns.Subscribe(ProjectId);
        if (subscription is null)
        {
            ReleaseRunningUi();
            return;
        }

        _listeningTurnId = subscription.TurnId;
        _listenCts = new CancellationTokenSource();
        _ = ListenToTurnAsync(subscription, _listenCts.Token);
        await Task.CompletedTask;
    }

    private void StopListening()
    {
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        _listenCts = null;
        _listeningTurnId = null;
    }

    private async Task ListenToTurnAsync(
        IChatTurnSubscription<WritingCoachTurnUpdate> subscription,
        CancellationToken cancellationToken)
    {
        await using (subscription)
        {
            try
            {
                await foreach (var update in subscription.ReadAllAsync(cancellationToken))
                    await InvokeAsync(() => ApplyTurnUpdateAsync(update));
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ApplyTurnUpdateAsync(WritingCoachTurnUpdate update)
    {
        switch (update)
        {
            case WritingCoachTextDelta delta:
                _live!.AppendText(delta.Text);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case WritingCoachToolCallStarted started:
                _live!.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case WritingCoachToolCallArgumentsDelta delta:
                _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case WritingCoachToolCallCompleted completed:
                _live!.CompleteToolCall(completed.CallId, completed.Result, completed.Error, completed.DurationMs);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;

            case WritingCoachAssistantMessageCompleted:
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                RequestScroll();
                StateHasChanged();
                break;

            case WritingCoachTurnError error:
                _error = error.Cancelled ? null : error.Message;
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                RequestScroll();
                StateHasChanged();
                break;
        }
    }

    private void CancelAsync() => ChatTurns.Cancel(ProjectId);

    private void ReleaseRunningUi()
    {
        var wasRunning = _running;
        var hadLive = _live is not null;
        _running = false;
        _live = null;
        UpdateConversationTokenCount();
        RequestScroll();
        if (wasRunning || hadLive)
            StateHasChanged();
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _messages = (await Coach.LoadMessagesAsync(_conversation.Id)).ToList();
        _messageImages = await ImageAttachments.LoadForSurfaceAsync(ProjectId, ChatTurnSurface.WritingCoach);
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private void RebuildRenderable(DateTime? excludeMessagesCreatedAtOrAfter = null)
    {
        var messages = excludeMessagesCreatedAtOrAfter is { } cutoff
            ? _messages.Where(message => message.CreatedAt < cutoff).ToList()
            : _messages;

        var byCallId = messages
            .Where(message => message.Role == WritingCoachMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<ChatRenderableMessage>(messages.Count);
        foreach (var message in messages)
        {
            if (message.Role == WritingCoachMessageRole.Tool) continue;
            if (message.Role == WritingCoachMessageRole.System) continue;

            _renderable.Add(new ChatRenderableMessage(
                Id: message.Id,
                Role: ToChatRole(message.Role),
                Status: ToChatStatus(message.Status),
                Parts: BuildPartsWithImages(message, byCallId)));
        }
    }

    private List<ChatMessagePart> BuildPartsWithImages(WritingCoachMessage message, IReadOnlyDictionary<string, WritingCoachMessage> byCallId)
    {
        var parts = BuildMessageParts(message, byCallId);
        if (message.Role == WritingCoachMessageRole.User && _messageImages.TryGetValue(message.Id, out var images))
            ChatImageParts.Append(parts, images);
        return parts;
    }

    private static ChatMessageRole ToChatRole(WritingCoachMessageRole role) => role == WritingCoachMessageRole.User
        ? ChatMessageRole.User
        : ChatMessageRole.Assistant;

    private static ChatMessageStatus ToChatStatus(WritingCoachMessageStatus status) => status switch
    {
        WritingCoachMessageStatus.Failed => ChatMessageStatus.Failed,
        WritingCoachMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        WritingCoachMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            ChatTranscriptTokenCounter.ModelReplayMessages(
                _messages,
                message => message.Role.ToString(),
                message => message.Content),
            message => message,
            _live,
            _pendingUserText,
            WritingCoachService.CoachSystemPrompt);
    }

    private static List<ChatMessagePart> BuildMessageParts(WritingCoachMessage message, IReadOnlyDictionary<string, WritingCoachMessage> byCallId)
    {
        if (message.Role != WritingCoachMessageRole.Assistant)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls
                .Select((call, index) => new { Call = call, Index = index })
                .OrderBy(item => item.Call.TextOffset!.Value)
                .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));

            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content))
            parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls)
            parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private static ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, WritingCoachMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        return new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMessage?.Status == WritingCoachMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == WritingCoachMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = resultMessage is not null,
        };
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force)
            _forceScrollKey++;
    }

    private Task ResumeAutoFollowAsync()
    {
        _autoFollowKey++;
        return Task.CompletedTask;
    }

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        StopListening();
        return ValueTask.CompletedTask;
    }
}
