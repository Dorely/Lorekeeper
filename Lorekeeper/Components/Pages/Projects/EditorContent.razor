    private static IReadOnlyList<ReviewBlockCategory> ReviewLineCategories(ReviewLine line)
    {
        var categories = new List<ReviewBlockCategory>(3);
        if (line.TextBlockIds.Count > 0)
            categories.Add(ReviewBlockCategory.Text);
        if (line.StructureBlockIds.Count > 0)
            categories.Add(ReviewBlockCategory.Structure);
        if (line.VisualBlockIds.Count > 0)
            categories.Add(ReviewBlockCategory.Visual);
        return categories;
    }

