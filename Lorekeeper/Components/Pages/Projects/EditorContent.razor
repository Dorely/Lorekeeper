    }

    private void PruneInlineReviewState()
    {
        var validBlocks = CurrentReviewBlocks();
        if (validBlocks.Count == 0)
        {
            ResetInlineReviewState();
            return;
        }

        var validBlockIds = validBlocks.Select(block => block.Id).ToHashSet(StringComparer.Ordinal);
        _expandedReviewBlockIds.RemoveWhere(blockId => !validBlockIds.Contains(blockId));
        if (_activeReviewBlockId is not null && !validBlockIds.Contains(_activeReviewBlockId))
            _activeReviewBlockId = _expandedReviewBlockIds.FirstOrDefault();
        if (_pendingReviewScrollBlockId is not null && !validBlockIds.Contains(_pendingReviewScrollBlockId))
            _pendingReviewScrollBlockId = null;
        if (_reviewBlockEdit is not null && !validBlockIds.Contains(_reviewBlockEdit.BlockId))
            _reviewBlockEdit = null;
        if (_rejectingReviewBlockId is not null && !validBlockIds.Contains(_rejectingReviewBlockId))
        {
            _rejectingReviewBlockId = null;
            _reviewRejectionMessage = string.Empty;
        }
    }

    private static ReviewProjection BuildReviewProjection(
        Chapter chapter,
        ReviewDiff? comparisonDiff = null,
        bool isReadOnly = false,
        ManuscriptDocument? comparisonCurrentDocument = null)
    {
        var proposedBody = comparisonCurrentDocument is { } comparison
            ? ManuscriptCodec.ProjectPlainText(comparison)
            : chapter.PlainText;
        var lines = ChapterFormatting.SplitLines(proposedBody);
        var displayLines = lines.Count == 0 && comparisonDiff is not null
            ? [string.Empty]
            : lines;
        var width = Math.Max(4, displayLines.Count.ToString().Length);
        var drafts = displayLines
            .Select((text, index) => new ReviewLineDraft(index + 1, text))
            .ToList();
        var locationDocument = comparisonCurrentDocument ?? chapter.Manuscript;
        var lineLocations = BuildReviewLineLocations(locationDocument, proposedBody, displayLines);
        var blocks = new List<ReviewBlock>();
        IReadOnlyList<DiffSection> sections = comparisonDiff?.Sections ?? [];

        if (comparisonDiff is { } diff)
        {
            var fallbackChangeId = isReadOnly ? chapter.Id : Guid.Empty;
            foreach (var section in diff.Sections.Where(section => string.Equals(section.Key, "Body", StringComparison.OrdinalIgnoreCase)))
            {
                for (var hunkIndex = 0; hunkIndex < section.Hunks.Count; hunkIndex++)
                {
                    var hunk = section.Hunks[hunkIndex];
                    var changeId = section.OwnerChangeId ?? fallbackChangeId;
                    foreach (var block in ReviewBlocksForHunk(changeId, section, hunk, hunkIndex, drafts.Count))
                    {
                        blocks.Add(block);
                        AddReviewBlockToDraft(drafts[block.AnchorLine - 1], block);

                        if (block.NewRow is { NewLineNumber: int newLineNumber } newRow)
                        {
                            if (newLineNumber < 1 || newLineNumber > drafts.Count) continue;
                            var draft = drafts[newLineNumber - 1];
                            draft.IsAddedOrChanged = true;
                            draft.Segments = ReviewSegmentsForAddedRow(newRow, hunk.Rows, RowIndex(hunk.Rows, newRow));
                        }

                        if (block.OldRow is not null)
                        {
                            if (block.AnchorLine < 1 || block.AnchorLine > drafts.Count) continue;
                            var draft = drafts[block.AnchorLine - 1];
                            draft.HasDeletionMarker = true;
                        }
                    }
                }
            }

            if (isReadOnly)
            {
                foreach (var section in diff.Sections.Where(section => !string.Equals(section.Key, "Body", StringComparison.OrdinalIgnoreCase)))
                {
                    var category = ReviewBlockCategoryFor(section);
                    for (var hunkIndex = 0; hunkIndex < section.Hunks.Count; hunkIndex++)
                    {
                        var hunk = section.Hunks[hunkIndex];
                        foreach (var block in ReviewBlocksForHunk(fallbackChangeId, section, hunk, hunkIndex, drafts.Count, category))
                        {
                            var anchorLine = FindStructuredAnchorLine(
                                block,
                                comparisonCurrentDocument,
                                drafts.Count);
                            var anchoredBlock = block with
                            {
                                AnchorLine = anchorLine,
                                MarkerTopPercent = MarkerTopPercent(anchorLine, drafts.Count),
                            };
                            blocks.Add(anchoredBlock);
                            var anchorDraft = drafts[anchorLine - 1];
                            AddReviewBlockToDraft(anchorDraft, anchoredBlock);
                            if (anchoredBlock.HasAdditions)
                                anchorDraft.IsAddedOrChanged = true;
                            if (anchoredBlock.HasDeletions)
                                anchorDraft.HasDeletionMarker = true;
                        }
                    }
                }
            }
        }

        var orderedBlocks = blocks
            .OrderBy(block => block.AnchorLine)
            .ThenBy(block => block.NewRow?.NewLineNumber ?? int.MaxValue)
            .ThenBy(block => block.OldRow?.OldLineNumber ?? int.MaxValue)
            .ThenBy(block => block.Id, StringComparer.Ordinal)
            .ToList();

        return new ReviewProjection(
            HasChanges: sections.Count > 0,
            PendingChangeCount: orderedBlocks.Count,
            PendingChangeIds: [],
            LineNumberFormat: new string('0', width),
            Blocks: orderedBlocks,
            Lines: drafts
                .Select(draft => new ReviewLine(
                    draft.LineNumber,
                    draft.Text,
                    draft.Segments,
                    draft.IsAddedOrChanged,
                    draft.HasDeletionMarker,
                    draft.BlockIds.Distinct(StringComparer.Ordinal).ToList(),
                    draft.BlockIds.FirstOrDefault(),
                    MarkerTitle(draft),
                    draft.TextBlockIds.Distinct(StringComparer.Ordinal).ToList(),
                    draft.StructureBlockIds.Distinct(StringComparer.Ordinal).ToList(),
                    draft.VisualBlockIds.Distinct(StringComparer.Ordinal).ToList(),
                    lineLocations.ElementAtOrDefault(draft.LineNumber - 1)?.BlockId,
                    lineLocations.ElementAtOrDefault(draft.LineNumber - 1)?.StartOffset,
                    lineLocations.ElementAtOrDefault(draft.LineNumber - 1)?.EndOffset,
                    lineLocations.ElementAtOrDefault(draft.LineNumber - 1)?.LogicalProgress ?? MarkerTopPercent(draft.LineNumber, Math.Max(1, drafts.Count)) / 100d))
                .ToList(),
            IsReadOnly: isReadOnly,
            IsNoDifference: isReadOnly && sections.Count == 0);
    }

    private static ReviewProjection? BuildVersionHistoryReviewProjection(
        Chapter chapter,
        ProjectVersionReviewChapter reviewChapter,
        bool isReadOnly)
    {
        if (reviewChapter.Before is null && reviewChapter.After is null)
            return null;

        var beforePayload = reviewChapter.Before ?? new ProjectExportChapter
        {
            Id = reviewChapter.ChapterId,
            Title = reviewChapter.After?.Title ?? chapter.Title,
            ManuscriptJson = ManuscriptCodec.Serialize(ManuscriptCodec.CreateEmpty(reviewChapter.ChapterId)),
            ManuscriptRevision = 0,
        };
        var afterPayload = reviewChapter.After ?? new ProjectExportChapter
        {
            Id = reviewChapter.ChapterId,
            Title = reviewChapter.Before?.Title ?? chapter.Title,
            ManuscriptJson = ManuscriptCodec.Serialize(ManuscriptCodec.CreateEmpty(reviewChapter.ChapterId)),
            ManuscriptRevision = 0,
        };
        var before = ManuscriptCodec.Deserialize(
            beforePayload.ManuscriptJson,
            reviewChapter.ChapterId,
            beforePayload.ManuscriptRevision);
        var after = ManuscriptCodec.Deserialize(
            afterPayload.ManuscriptJson,
            reviewChapter.ChapterId,
            afterPayload.ManuscriptRevision);
        var hasManuscriptDiff = ManuscriptReviewDiffBuilder.TryBuild(
                before,
                after,
                afterPayload.Title,
                out var diff);
        var sections = hasManuscriptDiff
            ? diff.Sections.ToList()
            : new List<DiffSection>();
        foreach (var composition in reviewChapter.CompositionChanges)
        {
            sections.Add(ManuscriptReviewDiffBuilder.CreateSection(
                "Visuals",
                $"Designed Page: {CompositionLabel(composition)}",
                FormatCompositionReview(composition.Before),
                FormatCompositionReview(composition.After)));
        }
        diff = new ReviewDiff(
            string.IsNullOrWhiteSpace(afterPayload.Title) ? "Chapter body" : afterPayload.Title,
            null,
            sections);

        var comparisonChapter = new Chapter
        {
            Id = reviewChapter.ChapterId,
            ProjectId = chapter.ProjectId,
            Title = afterPayload.Title,
            ManuscriptJson = afterPayload.ManuscriptJson,
            ManuscriptRevision = after.Revision,
        };
        return BuildReviewProjection(
            comparisonChapter,
            comparisonDiff: diff,
            isReadOnly: isReadOnly,
            comparisonCurrentDocument: after);
    }

    private static string CompositionLabel(ProjectVersionReviewComposition composition) =>
        composition.After?.Name
        ?? composition.Before?.Name
        ?? composition.CompositionId.ToString("N");

    private static string FormatCompositionReview(ProjectExportPageComposition? composition)
    {
        if (composition is null)
            return "(not present)";

        var variants = composition.Variants
            .OrderBy(variant => variant.Id)
            .Select(variant => $"{variant.Id:N} · {variant.GeometryKey} · revision {variant.Revision}");
        return string.Join(
            "\n",
            $"Name: {composition.Name}",
            $"Composition revision: {composition.Revision}",
            $"Active variant: {composition.ActiveAuthoringVariantId?.ToString("N") ?? "none"}",
            "Variants:",
            string.Join("\n", variants));
    }

    private bool CanApproveReviewComposition(ProjectVersionReviewComposition composition)
    {
        if (_reviewBusy
            || _historicalReview is not null
            || Project is null
            || _current is null
            || composition.After is null
            || _reviewView is not { Comparison.IsIdentical: false, Token: not null })
        {
            return false;
        }

        var target = new ProjectVersionReviewTarget(_current.Id, _contentTarget);
        return composition.ChapterId == target.ChapterId
            && (target.ContentTarget.IsCore
                ? composition.EditionId is null
                : composition.EditionId == target.ContentTarget.EditionId)
            && _reviewView.Chapters.Any(chapter =>
                chapter.ChapterId == target.ChapterId
                && chapter.ContentTarget == target.ContentTarget
                && chapter.CompositionChanges.Any(item => item.CompositionId == composition.CompositionId));
    }

    private async Task ApproveReviewCompositionAsync(ProjectVersionReviewComposition composition)
    {
        if (!CanApproveReviewComposition(composition)
            || Project is not { } project
            || _current is not { } chapter
            || _reviewView is not { Token: { } token })
        {
            return;
        }

        var target = new ProjectVersionReviewTarget(chapter.Id, _contentTarget);
        await RunReviewActionAsync(
            () => VersionHistory.ApproveReviewCompositionAsync(
                project.Id,
                target,
                composition.CompositionId,
                token,
                semanticMessage: $"Approved Designed Page: {CompositionLabel(composition)}",
                requestKey: $"review-composition-approval:{token.CurrentContentHash}:{target.ContentTarget.StorageKey}:{composition.CompositionId:N}"),
            clearExpandedBlocks: true,
            reconcileCurrentChapter: false,
            publishReviewStateChanged: false);
    }

    private bool CanUndoReviewComposition(ProjectVersionReviewComposition composition)
    {
        if (_historicalReview is not null)
            return CanUndoHistoricalReviewComposition(composition);

        if (_reviewBusy
            || Project is null
            || _current is null
            || !composition.HasChanges
            || _reviewView is not { Comparison.IsIdentical: false, Token: not null })
        {
            return false;
        }

        var target = new ProjectVersionReviewTarget(_current.Id, _contentTarget);
        return (composition.After is null || CompositionMatchesReviewTarget(composition.After, target))
            && (composition.Before is null || CompositionMatchesReviewTarget(composition.Before, target))
            && _reviewView.Chapters.Any(chapter =>
                chapter.ChapterId == target.ChapterId
                && chapter.ContentTarget == target.ContentTarget
                && chapter.CompositionChanges.Any(item => item.CompositionId == composition.CompositionId));
    }

    private bool CanUndoHistoricalReviewComposition(ProjectVersionReviewComposition composition)
    {
        if (_reviewBusy
            || _historicalReview is not { } historicalReview
            || HistoricalUndoParentSha is null
            || Project is null
            || _current is null
            || !composition.HasChanges
            || _reviewView?.Token is null)
        {
            return false;
        }

        var target = new ProjectVersionReviewTarget(_current.Id, _contentTarget);
        return (composition.After is null || CompositionMatchesReviewTarget(composition.After, target))
            && (composition.Before is null || CompositionMatchesReviewTarget(composition.Before, target))
            && historicalReview.Compositions is not null
            && historicalReview.Compositions.Any(item => item.CompositionId == composition.CompositionId);
    }

    private async Task UndoReviewCompositionAsync(ProjectVersionReviewComposition composition)
    {
        if (!CanUndoReviewComposition(composition)
            || Project is not { } project
            || _current is not { } chapter
            || _reviewView is not { Token: { } token })
        {
            return;
        }

        var target = new ProjectVersionReviewTarget(chapter.Id, _contentTarget);
        if (_historicalReview is { } historicalReview)
        {
            if (HistoricalUndoParentSha is not { } parentCommitSha)
                return;

            await RunReviewActionAsync(
                () => VersionRestore.RestoreHistoricalCompositionAsync(
                    project.Id,
                    target,
                    composition.CompositionId,
                    parentCommitSha,
                    token),
                clearExpandedBlocks: true,
                publishReviewStateChanged: false);
            return;
        }

        await RunReviewActionAsync(
            () => VersionRestore.RestoreReviewCompositionAsync(
                project.Id,
                target,
                composition.CompositionId,
                token),
            clearExpandedBlocks: true,
            publishReviewStateChanged: false);
    }

    private static bool CompositionMatchesReviewTarget(
        ProjectExportPageComposition composition,
        ProjectVersionReviewTarget target) =>
        composition.ChapterId == target.ChapterId
        && (target.ContentTarget.IsCore
            ? composition.EditionId is null
            : composition.EditionId == target.ContentTarget.EditionId);

    private async Task<IReadOnlyList<ReviewCompositionPreview>> LoadReviewCompositionPreviewsAsync(
        ProjectVersionReviewChapter reviewChapter,
        Guid projectId,
        ICompositionCanvasPreviewService compositionPreviews,
        CancellationToken cancellationToken = default)
    {
        if (reviewChapter.CompositionChanges.Count == 0)
            return [];

        var previews = new List<ReviewCompositionPreview>(reviewChapter.CompositionChanges.Count);
        foreach (var composition in reviewChapter.CompositionChanges)
        {
            cancellationToken.ThrowIfCancellationRequested();
            try
            {
                var before = await RenderReviewCompositionPreviewAsync(
                    composition.Before,
                    projectId,
                    compositionPreviews,
                    cancellationToken);
                var after = await RenderReviewCompositionPreviewAsync(
                    composition.After,
                    projectId,
                    compositionPreviews,
                    cancellationToken);
                previews.Add(new ReviewCompositionPreview(composition, before, after, null));
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                previews.Add(new ReviewCompositionPreview(composition, null, null, exception.Message));
            }
        }

        return previews;
    }

    private async Task<IReadOnlyList<ReviewCompositionPreview>> LoadReviewCompositionPreviewsAsync(
        ProjectVersionHistoricalChapterReview historicalReview,
        Guid projectId,
        ICompositionCanvasPreviewService compositionPreviews,
        CancellationToken cancellationToken = default)
    {
        var reviewChapter = new ProjectVersionReviewChapter(
            historicalReview.ChapterId,
            historicalReview.ContentTarget,
            historicalReview.Before,
            historicalReview.After,
            new ProjectVersionReviewConcurrencyToken(
                Guid.Empty,
                historicalReview.Commit.Sha,
                null,
                string.Empty),
            historicalReview.Compositions);
        return await LoadReviewCompositionPreviewsAsync(
            reviewChapter,
            projectId,
            compositionPreviews,
            cancellationToken);
    }

    private async Task<CompositionCanvasPreviewResult?> RenderReviewCompositionPreviewAsync(
        ProjectExportPageComposition? composition,
        Guid projectId,
        ICompositionCanvasPreviewService compositionPreviews,
        CancellationToken cancellationToken = default)
    {
        if (composition is null)
            return null;

        var variant = composition.Variants
            .FirstOrDefault(item => item.Id == composition.ActiveAuthoringVariantId)
            ?? composition.Variants.OrderBy(item => item.Id).FirstOrDefault();
        if (variant is null)
            return null;

        var scene = JsonSerializer.Deserialize<CompositionScene>(variant.SceneJson, ManuscriptCodec.JsonOptions)
            ?? throw new InvalidDataException("The Designed Page review scene is empty.");
        var semantic = ManuscriptCodec.Deserialize(
            composition.SemanticManuscriptJson,
            composition.Id,
            composition.Revision);
        return await compositionPreviews.RenderSceneAsync(
            projectId,
            composition.Id,
            variant.Revision,
            scene,
            semantic,
            CompositionCanvasPreviewMode.Clean,
            cancellationToken);
    }

