    protected override async Task OnParametersSetAsync()
    {
        if (Project is null)
        {
            CancelReviewRefresh();
            return;
        }

        if (_loadedProjectId != Project.Id)
        {
            CancelReviewRefresh();
            _loadedProjectId = Project.Id;
            _loading = true;
            _current = null;
            _activeChapterId = null;
            _editorDocument = null;
            _restoreChapterAfterRender = false;
            _pendingRememberChapterId = null;
            _workspacePreferencesProjectId = null;
            _rememberedChapterModes.Clear();
            _readFacing = false;
            _chatPaneCollapsed = false;
            _rightPaneCollapsed = false;
            _contestReviewBatches = [];
            _contestReviewProjection = null;
            _projectContestLock = EditorContestLockState.Unlocked;
            _contestAutoOpenedProjectId = null;
            _reviewProjection = null;
            _reviewView = null;
            _historicalReview = null;
            ResetInlineReviewState();
            _chapters = (await Chapters.ListAsync(Project.Id)).ToList();
            _acts = (await Acts.ListAsync(Project.Id)).ToList();
            _enabledEditions = (await EditionContent.ListReleasesAsync(Project.Id))
                .Where(item => item.Enabled && !item.Archived)
                .ToList();
            _projectContestLock = await Chat.GetEditorContestLockStateAsync(Project.Id);
            _contestReviewBatches = (await Chat.ListCurrentContestBatchesAsync(Project.Id)).ToList();
            _loading = false;
        }

        if (_projectContestLock is { IsLocked: true, ChapterId: Guid contestedChapterId }
            && _contestAutoOpenedProjectId != Project.Id)
        {
            _contestAutoOpenedProjectId = Project.Id;
            var contest = _contestReviewBatches.FirstOrDefault(batch => batch.Id == _projectContestLock.BatchId);
            var contestEditionId = contest?.ContentTargetEditionId;
            if (ChapterId != contestedChapterId
                || !string.Equals(RequestedMode, nameof(EditorMode.Review), StringComparison.OrdinalIgnoreCase)
                || EditionId != contestEditionId)
            {
                Nav.NavigateTo(ContestReviewHref(contestedChapterId, contestEditionId), replace: true);
                return;
            }
        }

        var requestedTarget = EditionId is Guid requestedEditionId
            && _enabledEditions.Any(item => item.EditionId == requestedEditionId)
                ? EditorContentTarget.ForEdition(requestedEditionId)
                : EditorContentTarget.Core;
        _contentTargetNotice = EditionId.HasValue && requestedTarget.IsCore
            ? "That edition is unavailable for content editing, so Lorekeeper opened Core Book instead."
            : null;

        if (_chapters.Count == 0)
        {
            _current = null;
            _activeChapterId = null;
            _editorDocument = null;
            _restoreChapterAfterRender = false;
            _pendingRememberChapterId = null;
            _contestReviewBatches = [];
            _contestReviewProjection = null;
            UpdateChapterMetrics(string.Empty);
            return;
        }

        Guid targetId;
        if (ChapterId is { } cid && _chapters.Any(c => c.Id == cid))
        {
            targetId = cid;
        }
        else if (ChapterId is null)
        {
            if (_activeChapterId is { } activeId && _chapters.Any(c => c.Id == activeId))
            {
                Nav.NavigateTo(EditorHref(activeId, requestedTarget.EditionId), replace: true);
                return;
            }

            _current = null;
            _editorDocument = null;
            _restoreChapterAfterRender = true;
            return;
        }
        else
        {
            var first = _chapters[0];
            Nav.NavigateTo(EditorHref(first.Id, requestedTarget.EditionId), replace: true);
            return;
        }

        await LoadChapterAsync(targetId, requestedTarget, applyRequestedRouteState: true);
    }

    private async Task SelectChapterAsync(Guid chapterId)
    {
        CloseMenu();
        if (_activeChapterId == chapterId) return;
        var carriedMode = _mode;
        if (!await LoadChapterAsync(
                chapterId,
                _contentTarget,
                applyRequestedRouteState: false,
                carriedMode: carriedMode))
            return;

        SynchronizeChapter?.Invoke(chapterId);
        await UpdateEditorLocationAsync(EditorHref(chapterId));
    }

    private async Task<bool> LoadChapterAsync(
        Guid targetId,
        EditorContentTarget requestedTarget,
        bool applyRequestedRouteState,
        EditorMode? carriedMode = null)
    {
        var project = Project;
        if (project is null) return false;

        _restoreChapterAfterRender = false;
        var isRealTransition = _activeChapterId != targetId
            || _contentTarget != requestedTarget
            || _loadedContentTarget != requestedTarget;
        if (isRealTransition)
        {
            _manuscriptLocation = null;
            _manuscriptLocationIdentity = null;
            _pendingLocation = null;
            _pendingLocationIdentity = null;
        }
        if (_activeChapterId == targetId && _loadedContentTarget == requestedTarget)
        {
            _pendingRememberChapterId = targetId;
            return true;
        }

        if (_activeChapterId is not null && !await FlushAsync())
            return false;

        if (isRealTransition)
            ResetChapterReviewState();
        else
            ResetInlineReviewState();
        _contentTarget = requestedTarget;
        _loadedContentTarget = requestedTarget;

        var fresh = await Chapters.ReloadFromStoreAsync(targetId);
        if (fresh is null)
        {
            HandleMissingChapter(targetId);
            return false;
        }

        _activeChapterId = targetId;
        _current = fresh;
        _contextResetError = null;
        ReplaceCachedChapter(fresh);
        var effective = await Manuscripts.GetManuscriptAsync(_contentTarget, fresh.Id)
            ?? throw new InvalidOperationException("The selected chapter manuscript was not found.");
        InstallEditorDocument(effective);
        _annotationRefreshSignal++;
        UpdateChapterMetrics(effective.PlainText);
        _contentStatus = _contentTarget.EditionId is Guid statusEditionId
            ? await EditionContent.GetChapterStatusAsync(project.Id, statusEditionId, fresh.Id)
            : null;
        _saveState = SaveState.Idle;
        _saveError = null;
        _pendingRememberChapterId = targetId;
        await RefreshContextSurfacesAsync();

        if (await ActivateCurrentContestReviewAsync())
        {
            if (carriedMode is not null)
                await RememberEditorModeAsync(EditorMode.Review);
            return true;
        }

        _contestReviewProjection = null;
        SelectInitialModeForCurrentChapter();
        if (carriedMode is { } previousMode)
        {
            _mode = ResolveCarriedMode(previousMode);
            SelectOpenCompositionForCurrentChapter();
            await RememberEditorModeAsync(_mode);
        }
        if (applyRequestedRouteState
            && Enum.TryParse<EditorMode>(RequestedMode, ignoreCase: true, out var requestedMode))
        {
            _mode = requestedMode;
        }
        if (applyRequestedRouteState
            && _mode == EditorMode.Pages
            && RequestedCompositionId is Guid requestedCompositionId
            && effective.Document.Content.Any(block => block.PageCompositionId == requestedCompositionId))
        {
            _openCompositionId = requestedCompositionId;
            _pageWorkspaceSelectionId = RequestedObjectId;
        }
        if (_mode == EditorMode.Review)
            QueueReviewRefresh();
        return true;
    }

