    private async Task ResetEditionChapterAsync()
    {
        if (Project is null || _activeChapterId is not Guid chapterId || _contentTarget.EditionId is not Guid editionId)
            return;
        _resetEditionChapterBusy = true;
        _saveError = null;
        try
        {
            if (!await FlushAsync())
            {
                _resetEditionChapterConfirmationOpen = false;
                return;
            }
            await EditionContent.ResetChapterAsync(Project.Id, editionId, chapterId, confirmed: true);
            var effective = await Manuscripts.GetManuscriptAsync(_contentTarget, chapterId)
                ?? throw new InvalidOperationException("The Core chapter manuscript was not found after reset.");
            SynchronizeExternalEditorDocument(effective);
            UpdateChapterMetrics(effective.PlainText);
            var designedPages = DesignedPageIds;
            if (_openCompositionId is Guid openCompositionId && !designedPages.Contains(openCompositionId))
                _openCompositionId = designedPages.Count > 0 ? designedPages[0] : null;
            _contentStatus = await EditionContent.GetChapterStatusAsync(Project.Id, editionId, chapterId);
            _previewRefreshSignal++;
            _pageWorkspaceRefreshSignal++;
            _resetEditionChapterConfirmationOpen = false;
        }
        catch (Exception exception)
        {
            _saveError = exception.Message;
            _resetEditionChapterConfirmationOpen = false;
        }
        finally
        {
            _resetEditionChapterBusy = false;
            StateHasChanged();
        }
    }

