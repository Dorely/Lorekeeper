    private static ContestReviewProjection BuildContestReviewProjection(ContestBatch batch)
    {
        var selectedCandidateId = batch.SelectedCandidateId;
        var candidates = new List<ContestCandidateProjection>();
        foreach (var candidate in batch.Candidates.OrderBy(candidate => candidate.Order))
        {
            var isSelected = selectedCandidateId == candidate.Id;
            var review = isSelected && candidate.Status == ContestCandidateStatus.Completed
                ? BuildContestCandidateReviewProjection(batch, candidate)
                : null;
            if (review is not null)
            {
                var decisionsByBlockId = ReadContestReviewState(candidate).Lines
                    .ToDictionary(line => line.BlockId, StringComparer.Ordinal);
                var blocks = review.Blocks.Select(block =>
                {
                    return block with
                    {
                        ContestCandidateId = candidate.Id,
                        ContestDecision = ContestDecisionForBlock(selectedCandidateId, candidate.Id, decisionsByBlockId, block),
                        HasContestConflict = false,
                        ContestConflictMessage = null,
                    };
                }).ToList();
                review = review with { Blocks = blocks };
            }

            candidates.Add(new ContestCandidateProjection(
                candidate.Id,
                candidate.Order,
                candidate.ProviderName,
                candidate.ModelName,
                candidate.Status,
                candidate.Summary,
                candidate.ErrorMessage,
                review,
                isSelected,
                candidate.Status == ContestCandidateStatus.Completed
                    && batch.Status == ContestBatchStatus.Completed));
        }

        var allBlocks = candidates
            .Where(candidate => candidate.IsSelected)
            .SelectMany(candidate => candidate.Review?.Blocks ?? [])
            .OrderBy(block => block.AnchorLine)
            .ThenBy(block => block.Id, StringComparer.Ordinal)
            .ToList();

        return new ContestReviewProjection(batch, candidates, allBlocks);
    }

    private static ReviewProjection? BuildContestCandidateReviewProjection(ContestBatch batch, ContestCandidate candidate)
    {
        var before = ManuscriptCodec.Deserialize(batch.OriginalManuscriptJson);
        var after = ManuscriptCodec.Deserialize(candidate.EffectiveDraftManuscriptJson);
        ManuscriptCodec.Validate(before, batch.ChapterId, before.Revision);
        ManuscriptCodec.Validate(after, batch.ChapterId, after.Revision);
        if (!ManuscriptReviewDiffBuilder.TryBuild(before, after, batch.ChapterTitle, out var diff))
            return null;

        var chapter = new Chapter
        {
            Id = batch.ChapterId,
            ProjectId = batch.ProjectId,
            Title = batch.ChapterTitle,
            ManuscriptRevision = after.Revision,
            ManuscriptJson = ManuscriptCodec.Serialize(after),
        };
        return BuildReviewProjection(
            chapter,
            comparisonDiff: diff,
            isReadOnly: true,
            comparisonCurrentDocument: after);
    }

    private static ContestCandidateLineDecisionKind? ContestDecisionForBlock(
        Guid? selectedCandidateId,
        Guid candidateId,
        IReadOnlyDictionary<string, ContestCandidateLineDecision> decisionsByBlockId,
        ReviewBlock block)
    {
        if (decisionsByBlockId.TryGetValue(block.Id, out var decision))
            return decision.Decision;
        return selectedCandidateId == candidateId
            ? ContestCandidateLineDecisionKind.Kept
            : null;
    }

    private static ContestCandidateReviewState ReadContestReviewState(ContestCandidate candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate.ReviewStateJson) || candidate.ReviewStateJson == "{}")
            return new ContestCandidateReviewState([]);

        try
        {
            return JsonSerializer.Deserialize<ContestCandidateReviewState>(candidate.ReviewStateJson, ContestReviewStateJsonOptions)
                ?? new ContestCandidateReviewState([]);
        }
        catch (JsonException)
        {
            return new ContestCandidateReviewState([]);
        }
    }

    private static IReadOnlyList<ReviewLineLocation> BuildReviewLineLocations(
        ManuscriptDocument? document,
        string proposedBody,
        IReadOnlyList<string> displayLines)
    {
        var fallbackProgress = displayLines.Count <= 1
            ? 0d
            : 1d / (displayLines.Count - 1);
        var locations = displayLines
            .Select((_, index) => new ReviewLineLocation(
                null,
                null,
                null,
                index * fallbackProgress))
            .ToList();
        if (document is null || displayLines.Count == 0 || proposedBody.Length == 0)
            return locations;

        var blocks = new List<(string Id, string Text, int Start, int End, int Ordinal)>();
        var searchOffset = 0;
        var ordinal = 0;
        foreach (var block in document.Content.Where(item => item.Type != ManuscriptBlockType.DesignedPage))
        {
            var blockText = block.Type == ManuscriptBlockType.SceneBreak
                ? "***"
                : string.Concat(block.Content.Select(inline => inline.Text));
            if (blockText.Length == 0)
                continue;

            var start = proposedBody.IndexOf(blockText, searchOffset, StringComparison.Ordinal);
            if (start < 0)
                continue;
            blocks.Add((block.Id, blockText, start, start + blockText.Length, ordinal++));
            searchOffset = start + blockText.Length;
        }

        var lineCursor = 0;
        for (var lineIndex = 0; lineIndex < displayLines.Count; lineIndex++)
        {
            var lineText = displayLines[lineIndex];
            var lineStart = lineText.Length == 0
                ? lineCursor
                : proposedBody.IndexOf(lineText, Math.Min(lineCursor, proposedBody.Length), StringComparison.Ordinal);
            if (lineStart < 0)
                lineStart = Math.Min(lineCursor, proposedBody.Length);
            var lineEnd = Math.Min(proposedBody.Length, lineStart + lineText.Length);
            lineCursor = Math.Min(proposedBody.Length, lineEnd + 1);

            var block = blocks.FirstOrDefault(candidate => lineStart < candidate.End && lineEnd > candidate.Start);
            if (block.Id is null)
                continue;

            var startOffset = Math.Max(0, lineStart - block.Start);
            var endOffset = Math.Min(block.Text.Length, Math.Max(startOffset, lineEnd - block.Start));
            var progress = blocks.Count <= 1
                ? 0d
                : (double)block.Ordinal / (blocks.Count - 1);
            locations[lineIndex] = new ReviewLineLocation(
                block.Id,
                startOffset,
                endOffset,
                Math.Clamp(progress, 0, 1));
        }

        return locations;
    }

    private static string ReviewLineClass(ReviewLine line)
    {
        var classes = "review-line";
        if (line.IsAddedOrChanged)
        {
            classes += " review-line--changed";
        }

        if (line.HasDeletionMarker)
        {
            classes += " review-line--removed-nearby";
        }

        return classes;
    }

    private static string ReviewStripClass(ReviewLine line)
    {
        var classes = "review-change-strip";
        if (line.IsAddedOrChanged)
        {
            classes += " review-change-strip--added";
        }

        if (line.HasDeletionMarker)
        {
            classes += " review-change-strip--removed";
        }

        return classes;
    }

    private static RenderFragment RenderReviewLine(ReviewLine line) => builder =>
    {
        var sequence = 0;
        if (line.Segments.Count == 0)
        {
            builder.AddContent(sequence++, line.Text);
            return;
        }

        foreach (var segment in line.Segments)
        {
            if (segment.IsAddedToken)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "review-token-added");
                builder.AddContent(sequence++, segment.Text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, segment.Text);
            }
        }
    };

    private static int FindDeletionAnchorLine(IReadOnlyList<DiffRow> rows, int rowIndex, int lineCount)
    {
        if (rows[rowIndex].PairId is int pairId)
        {
            var pairedNew = rows.FirstOrDefault(candidate => candidate.PairId == pairId && candidate.Kind == DiffRowKind.Added);
            if (pairedNew?.NewLineNumber is int pairedLine)
                return Math.Clamp(pairedLine, 1, Math.Max(1, lineCount));
        }

        for (var index = rowIndex + 1; index < rows.Count; index++)
        {
            if (rows[index].NewLineNumber is int nextLine)
                return Math.Clamp(nextLine, 1, Math.Max(1, lineCount));
        }

        for (var index = rowIndex - 1; index >= 0; index--)
        {
            if (rows[index].NewLineNumber is int previousLine)
                return Math.Clamp(previousLine, 1, Math.Max(1, lineCount));
        }

        return 1;
    }

    private static int FindBlockAnchorLine(IReadOnlyList<DiffRow> rows, int lineCount)
    {
        var firstAdded = rows.FirstOrDefault(row => row.Kind == DiffRowKind.Added && row.NewLineNumber.HasValue);
        if (firstAdded?.NewLineNumber is int addedLine)
            return Math.Clamp(addedLine, 1, Math.Max(1, lineCount));

        var firstRemovedIndex = rows.ToList().FindIndex(row => row.Kind == DiffRowKind.Removed);
        return firstRemovedIndex >= 0
            ? FindDeletionAnchorLine(rows, firstRemovedIndex, lineCount)
            : 1;
    }

    private static void AddReviewBlockToDraft(ReviewLineDraft draft, ReviewBlock block)
    {
        draft.BlockIds.Add(block.Id);
        switch (block.Category)
        {
            case ReviewBlockCategory.Text:
                draft.TextBlockIds.Add(block.Id);
                break;
            case ReviewBlockCategory.Structure:
                draft.StructureBlockIds.Add(block.Id);
                break;
            case ReviewBlockCategory.Visual:
                draft.VisualBlockIds.Add(block.Id);
                break;
        }
    }

    private static ReviewBlockCategory ReviewBlockCategoryFor(DiffSection section) =>
        string.Equals(section.Key, "Visuals", StringComparison.OrdinalIgnoreCase)
            ? ReviewBlockCategory.Visual
            : ReviewBlockCategory.Structure;

    private static int FindStructuredAnchorLine(
        ReviewBlock block,
        ManuscriptDocument? current,
        int lineCount)
    {
        var blockIndex = FindStructuredBlockIndex(block);
        if (blockIndex is null)
            return Math.Clamp(FindBlockAnchorLine(block.Hunk.Rows, lineCount), 1, Math.Max(1, lineCount));

        if (current is null)
            return 1;

        var currentBlocks = current.Content
            .Where(item => item.Type != ManuscriptBlockType.DesignedPage)
            .ToList();
        if (currentBlocks.Count == 0)
            return 1;

        // A deleted block has no current counterpart. Clamping the old position
        // to the surviving flowing blocks anchors the marker beside its nearest
        // remaining line; a wholly visual document falls back to line one.
        var rawIndex = Math.Clamp(blockIndex.Value - 1, 0, current.Content.Count);
        var currentIndex = Math.Clamp(
            current.Content.Take(rawIndex).Count(item => item.Type != ManuscriptBlockType.DesignedPage),
            0,
            currentBlocks.Count - 1);
        var precedingText = string.Join(
            "\n\n",
            currentBlocks
                .Take(currentIndex)
                .Select(ManuscriptCodec.Text));
        var line = string.IsNullOrEmpty(precedingText)
            ? 1
            : ChapterFormatting.SplitLines(precedingText).Count + 1;
        return Math.Clamp(line, 1, Math.Max(1, lineCount));
    }

    private static int? FindStructuredBlockIndex(ReviewBlock block)
    {
        var sectionText = block.NewRow is not null
            ? block.Section.NewText
            : block.Section.OldText;
        var sectionLineNumber = block.NewRow?.NewLineNumber ?? block.OldRow?.OldLineNumber;
        if (sectionLineNumber is { } lineNumber)
        {
            var sectionRows = ChapterFormatting.SplitLines(sectionText);
            var sectionIndex = Math.Min(lineNumber - 1, sectionRows.Count - 1);
            if (FindStructuredBlockIndex(sectionRows, sectionIndex) is { } sectionBlockIndex)
                return sectionBlockIndex;
        }

        return FindStructuredBlockIndex(block.Hunk.Rows.Select(row => row.Text).ToList(), block.HunkRowIndex);
    }

    private static int? FindStructuredBlockIndex(IReadOnlyList<string> rows, int rowIndex)
    {
        for (var index = Math.Min(rowIndex, rows.Count - 1); index >= 0; index--)
        {
            const string prefix = "Block ";
            var start = rows[index].IndexOf(prefix, StringComparison.OrdinalIgnoreCase);
            if (start < 0)
                continue;

            start += prefix.Length;
            var end = rows[index].IndexOf(':', start);
            if (end <= start)
                continue;

            if (int.TryParse(rows[index][start..end], NumberStyles.Integer, CultureInfo.InvariantCulture, out var blockIndex)
                && blockIndex > 0)
            {
                return blockIndex;
            }
        }

        return null;
    }

    private static double MarkerTopPercent(int anchorLine, int lineCount)
    {
        if (lineCount <= 1) return 0;
        return Math.Clamp(((double)(anchorLine - 1) / (lineCount - 1)) * 100, 0, 100);
    }

    private static IEnumerable<ReviewBlock> ReviewBlocksForHunk(
        Guid changeId,
        DiffSection section,
        DiffHunk hunk,
        int hunkIndex,
        int lineCount,
        ReviewBlockCategory category = ReviewBlockCategory.Text)
    {
        var consumedPairIds = new HashSet<int>();
        for (var rowIndex = 0; rowIndex < hunk.Rows.Count; rowIndex++)
        {
            var row = hunk.Rows[rowIndex];
            if (row.Kind == DiffRowKind.Context)
                continue;

            if (row.PairId is int pairId)
            {
                if (!consumedPairIds.Add(pairId))
                    continue;

                DiffRow? oldRow = null;
                DiffRow? newRow = null;
                var targetRowIndex = rowIndex;
                for (var pairIndex = 0; pairIndex < hunk.Rows.Count; pairIndex++)
                {
                    var candidate = hunk.Rows[pairIndex];
                    if (candidate.PairId != pairId) continue;
                    if (candidate.Kind == DiffRowKind.Removed)
                        oldRow = candidate;
                    else if (candidate.Kind == DiffRowKind.Added)
                    {
                        newRow = candidate;
                        targetRowIndex = pairIndex;
                    }
                }

                yield return CreateReviewBlock(changeId, section, hunk, hunkIndex, targetRowIndex, lineCount, oldRow, newRow, pairId, category);
                continue;
            }

            yield return row.Kind == DiffRowKind.Added
                ? CreateReviewBlock(changeId, section, hunk, hunkIndex, rowIndex, lineCount, oldRow: null, row, pairId: null, category)
                : CreateReviewBlock(changeId, section, hunk, hunkIndex, rowIndex, lineCount, row, newRow: null, pairId: null, category);
        }
    }

    private static ReviewBlock CreateReviewBlock(
        Guid changeId,
        DiffSection section,
        DiffHunk hunk,
        int hunkIndex,
        int rowIndex,
        int lineCount,
        DiffRow? oldRow,
        DiffRow? newRow,
        int? pairId,
        ReviewBlockCategory category = ReviewBlockCategory.Text)
    {
        var anchorLine = newRow?.NewLineNumber
            ?? (oldRow is null ? FindBlockAnchorLine(hunk.Rows, lineCount) : FindDeletionAnchorLine(hunk.Rows, rowIndex, lineCount));
        anchorLine = Math.Clamp(anchorLine, 1, Math.Max(1, lineCount));
        var blockId = $"review-{category}-{changeId:N}-{section.Key}-{hunk.NewStart}-{hunk.OldStart}-{hunkIndex}-{oldRow?.OldLineNumber ?? 0}-{newRow?.NewLineNumber ?? 0}-{pairId ?? 0}-{rowIndex}";

        return new ReviewBlock(
            blockId,
            changeId,
            ReviewBlockTitle(category, section, oldRow, newRow),
            ReviewBlockSummary(category, oldRow, newRow),
            anchorLine,
            MarkerTopPercent(anchorLine, lineCount),
            section,
            hunk,
            oldRow,
            newRow,
            pairId,
            category,
            rowIndex);
    }

    private static string ReviewBlockTitle(
        ReviewBlockCategory category,
        DiffSection section,
        DiffRow? oldRow,
        DiffRow? newRow)
    {
        if (category == ReviewBlockCategory.Structure)
            return string.IsNullOrWhiteSpace(section.Label) ? "Structure and formatting" : section.Label;
        if (category == ReviewBlockCategory.Visual)
            return string.IsNullOrWhiteSpace(section.Label) ? "Figures and Designed Pages" : section.Label;
        if (oldRow is not null && newRow is not null) return "Changed line";
        if (newRow is not null) return "Added line";
        if (oldRow is not null) return "Removed line";
        return "Chapter change";
    }

    private static string ReviewBlockSummary(ReviewBlockCategory category, DiffRow? oldRow, DiffRow? newRow)
    {
        if (category != ReviewBlockCategory.Text)
            return "Current vs Before";
        if (oldRow is not null && newRow is not null)
            return $"Line {oldRow.OldLineNumber} -> {newRow.NewLineNumber}";
        if (newRow is not null)
            return $"Line {newRow.NewLineNumber}";
        if (oldRow is not null)
            return $"Line {oldRow.OldLineNumber}";
        return "Line change";
    }

    private static string? MarkerTitle(ReviewLineDraft draft)
    {
        if (draft.IsAddedOrChanged && draft.HasDeletionMarker)
            return "Added or changed line; nearby line removed";
        if (draft.IsAddedOrChanged)
            return "Added or changed line";
        if (draft.HasDeletionMarker)
            return "Nearby removed line";
        return null;
    }

    private static string ReviewDiffRowClass(DiffRow row) => row.Kind switch
    {
        DiffRowKind.Added => "review-diff-row review-diff-row--added",
        DiffRowKind.Removed => "review-diff-row review-diff-row--removed",
        _ => "review-diff-row review-diff-row--context",
    };

    private static IReadOnlyList<ReviewSegment> ReviewSegmentsForAddedRow(DiffRow row, IReadOnlyList<DiffRow> hunkRows, int rowIndex) =>
        SegmentsForReviewRow(row, hunkRows, rowIndex)
            .Select(segment => new ReviewSegment(segment.Text, segment.Kind == DiffSegmentKind.Added))
            .ToList();

    private static RenderFragment RenderDiffSegments(DiffRow row, IReadOnlyList<DiffRow> hunkRows) => builder =>
    {
        var segments = SegmentsForReviewRow(row, hunkRows, RowIndex(hunkRows, row));
        var sequence = 0;
        foreach (var segment in segments)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", DiffSegmentClass(segment.Kind));
            builder.AddContent(sequence++, segment.Text);
            builder.CloseElement();
        }
    };

    private static IReadOnlyList<DiffSegment> SegmentsForReviewRow(DiffRow row, IReadOnlyList<DiffRow> hunkRows, int rowIndex)
    {
        if (row.Kind == DiffRowKind.Context)
            return row.Segments;

        if (row.Segments.Any(segment => segment.Kind != DiffSegmentKind.Unchanged))
            return row.Segments;

        var counterpart = FindReviewCounterpart(row, hunkRows, rowIndex);
        if (counterpart is not null && ReviewLineSimilarity(counterpart.Text, row.Text) >= 0.2)
        {
            return row.Kind == DiffRowKind.Added
                ? BuildTokenDiffSegments(counterpart.Text, row.Text, renderNew: true)
                : BuildTokenDiffSegments(row.Text, counterpart.Text, renderNew: false);
        }

        return row.Kind switch
        {
            DiffRowKind.Added => SegmentWholeText(row.Text, DiffSegmentKind.Added),
            DiffRowKind.Removed => SegmentWholeText(row.Text, DiffSegmentKind.Removed),
            _ => row.Segments,
        };
    }

    private static DiffRow? FindReviewCounterpart(DiffRow row, IReadOnlyList<DiffRow> hunkRows, int rowIndex)
    {
        var counterpartKind = row.Kind == DiffRowKind.Added ? DiffRowKind.Removed : DiffRowKind.Added;
        if (row.PairId is int pairId)
        {
            var paired = hunkRows.FirstOrDefault(candidate => candidate.Kind == counterpartKind && candidate.PairId == pairId);
            if (paired is not null)
                return paired;
        }

        DiffRow? best = null;
        var bestScore = 0.0;
        for (var index = 0; index < hunkRows.Count; index++)
        {
            var candidate = hunkRows[index];
            if (candidate.Kind != counterpartKind || candidate.PairId is not null)
                continue;

            var distancePenalty = Math.Abs(index - rowIndex) * 0.025;
            var score = ReviewLineSimilarity(candidate.Text, row.Text) - distancePenalty;
            if (score > bestScore)
            {
                best = candidate;
                bestScore = score;
            }
        }

        return best;
    }

    private static IReadOnlyList<DiffSegment> SegmentWholeText(string text, DiffSegmentKind kind) =>
        string.IsNullOrEmpty(text) ? [] : [new DiffSegment(text, kind)];

    private static IReadOnlyList<DiffSegment> BuildTokenDiffSegments(string oldText, string newText, bool renderNew)
    {
        const long maxTokenDiffCells = 250_000;
        var oldTokens = TokenizeReviewDisplayText(oldText);
        var newTokens = TokenizeReviewDisplayText(newText);
        if (oldTokens.Count == 0
            || newTokens.Count == 0
            || (long)oldTokens.Count * newTokens.Count > maxTokenDiffCells)
        {
            return SegmentWholeText(
                renderNew ? newText : oldText,
                renderNew ? DiffSegmentKind.Added : DiffSegmentKind.Removed);
        }

        var table = new int[oldTokens.Count + 1, newTokens.Count + 1];
        for (var oldIndex = oldTokens.Count - 1; oldIndex >= 0; oldIndex--)
        {
            for (var newIndex = newTokens.Count - 1; newIndex >= 0; newIndex--)
            {
                table[oldIndex, newIndex] = ReviewTokensEquivalent(oldTokens[oldIndex], newTokens[newIndex])
                    ? table[oldIndex + 1, newIndex + 1] + 1
                    : Math.Max(table[oldIndex + 1, newIndex], table[oldIndex, newIndex + 1]);
            }
        }

        var segments = new List<DiffSegment>();
        var oldCursor = 0;
        var newCursor = 0;
        while (oldCursor < oldTokens.Count && newCursor < newTokens.Count)
        {
            if (ReviewTokensEquivalent(oldTokens[oldCursor], newTokens[newCursor]))
            {
                AddReviewSegment(segments, renderNew ? newTokens[newCursor].Text : oldTokens[oldCursor].Text, DiffSegmentKind.Unchanged);
                oldCursor++;
                newCursor++;
            }
            else if (table[oldCursor + 1, newCursor] >= table[oldCursor, newCursor + 1])
            {
                if (!renderNew)
                    AddReviewSegment(segments, oldTokens[oldCursor].Text, DiffSegmentKind.Removed);
                oldCursor++;
            }
            else
            {
                if (renderNew)
                    AddReviewSegment(segments, newTokens[newCursor].Text, DiffSegmentKind.Added);
                newCursor++;
            }
        }

        while (oldCursor < oldTokens.Count)
        {
            if (!renderNew)
                AddReviewSegment(segments, oldTokens[oldCursor].Text, DiffSegmentKind.Removed);
            oldCursor++;
        }

        while (newCursor < newTokens.Count)
        {
            if (renderNew)
                AddReviewSegment(segments, newTokens[newCursor].Text, DiffSegmentKind.Added);
            newCursor++;
        }

        return segments;
    }

    private static void AddReviewSegment(List<DiffSegment> segments, string text, DiffSegmentKind kind)
    {
        if (string.IsNullOrEmpty(text)) return;
        if (segments.Count > 0 && segments[^1].Kind == kind)
        {
            segments[^1] = segments[^1] with { Text = segments[^1].Text + text };
            return;
        }

        segments.Add(new DiffSegment(text, kind));
    }

    private static IReadOnlyList<ReviewDisplayToken> TokenizeReviewDisplayText(string text)
    {
        var tokens = new List<ReviewDisplayToken>();
        var index = 0;
        while (index < text.Length)
        {
            var start = index;
            var kind = ReviewTokenKind(text[index]);
            index++;
            while (index < text.Length && ReviewTokenKind(text[index]) == kind)
                index++;

            var tokenText = text[start..index];
            var key = kind == ReviewDisplayTokenKind.Word
                ? tokenText.ToUpperInvariant()
                : tokenText;
            tokens.Add(new ReviewDisplayToken(tokenText, key, kind));
        }

        return tokens;
    }

    private static ReviewDisplayTokenKind ReviewTokenKind(char character)
    {
        if (char.IsWhiteSpace(character)) return ReviewDisplayTokenKind.Whitespace;
        return IsReviewWordCharacter(character) ? ReviewDisplayTokenKind.Word : ReviewDisplayTokenKind.Punctuation;
    }

    private static bool ReviewTokensEquivalent(ReviewDisplayToken oldToken, ReviewDisplayToken newToken)
    {
        if (oldToken.Kind != newToken.Kind) return false;
        return oldToken.Kind == ReviewDisplayTokenKind.Word
            ? string.Equals(oldToken.Key, newToken.Key, StringComparison.Ordinal)
            : string.Equals(oldToken.Text, newToken.Text, StringComparison.Ordinal);
    }

    private static bool IsReviewWordCharacter(char character) =>
        char.IsLetterOrDigit(character) || character == '_' || character == '\'';

    private static double ReviewLineSimilarity(string oldLine, string newLine)
    {
        if (string.Equals(oldLine, newLine, StringComparison.Ordinal)) return 1;

        var oldWords = TokenizeReviewWords(oldLine);
        var newWords = TokenizeReviewWords(newLine);
        if (oldWords.Count == 0 || newWords.Count == 0) return 0;

        var oldCounts = oldWords.GroupBy(word => word, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        var newCounts = newWords.GroupBy(word => word, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        var overlap = 0;
        foreach (var (word, oldCount) in oldCounts)
        {
            if (newCounts.TryGetValue(word, out var newCount))
                overlap += Math.Min(oldCount, newCount);
        }

        return (2.0 * overlap) / (oldWords.Count + newWords.Count);
    }

    private static IReadOnlyList<string> TokenizeReviewWords(string line)
    {
        var words = new List<string>();
        var index = 0;
        while (index < line.Length)
        {
            if (!IsReviewWordCharacter(line[index]))
            {
                index++;
                continue;
            }

            var start = index;
            while (index < line.Length && IsReviewWordCharacter(line[index]))
                index++;
            words.Add(line[start..index]);
        }

        return words;
    }

    private static int RowIndex(IReadOnlyList<DiffRow> rows, DiffRow row)
    {
        for (var index = 0; index < rows.Count; index++)
        {
            if (ReferenceEquals(rows[index], row) || rows[index].Equals(row))
                return index;
        }

        return -1;
    }

    private static IReadOnlyList<DiffRow> ReviewBlockDisplayRows(ReviewBlock block) =>
        new[] { block.OldRow, block.NewRow }
            .Where(row => row is not null)
            .Select(row => row!)
            .ToList();

    private static string ReviewDiffLineNumber(DiffRow row) =>
        (row.Kind == DiffRowKind.Removed
            ? row.OldLineNumber
            : row.NewLineNumber ?? row.OldLineNumber)?.ToString() ?? string.Empty;

    private static string DiffSegmentClass(DiffSegmentKind kind) => kind switch
    {
        DiffSegmentKind.Added => "review-diff-segment review-diff-segment--added",
        DiffSegmentKind.Removed => "review-diff-segment review-diff-segment--removed",
        _ => "review-diff-segment",
    };

    private void StartEditTitle()
    {
        if (_current is null) return;
        _menuOpen = false;
        _titleDraft = _current.Title;
        _editingTitle = true;
        _focusTitleNext = true;
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitTitleAsync();
        else if (e.Key == "Escape") CancelTitleEdit();
    }

    private void CancelTitleEdit()
    {
        _editingTitle = false;
        _titleDraft = string.Empty;
    }

    private async Task CommitTitleAsync()
    {
        if (!_editingTitle || _current is null) return;
        var newTitle = _titleDraft.Trim();
        _editingTitle = false;
        if (newTitle.Length == 0 || newTitle == _current.Title) return;
        try
        {
            await Chapters.UpdateAsync(_current.Id, title: newTitle);
            _current.Title = newTitle;
            await RefreshContextSurfacesAsync();
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
            _saveState = SaveState.SaveFailed;
        }
    }

    private async Task CreateAndGoToOutlineAsync()
    {
        if (Project is null) return;
        if (!await FlushAsync()) return;
        var ch = await Chapters.CreateAsync(Project.Id);
        Nav.NavigateTo($"/projects/{Project.Slug}/outline?focus={ch.Id}");
    }

    private async Task CreateFirstAsync()
    {
        if (Project is null) return;
        var ch = await Chapters.CreateAsync(Project.Id);
        _chapters = (await Chapters.ListAsync(Project.Id)).ToList();
        Nav.NavigateTo($"/projects/{Project.Slug}/editor/{ch.Id}");
    }

    private IEnumerable<(string label, IEnumerable<Chapter> chapters)> GroupedChapters()
    {
        foreach (var act in _acts)
        {
            var inAct = _chapters.Where(c => c.ActId == act.Id).OrderBy(c => c.Order);
            yield return (act.Title, inAct);
        }
        var unassigned = _chapters.Where(c => c.ActId is null).OrderBy(c => c.Order).ToList();
        if (unassigned.Count > 0)
        {
            yield return ("Unassigned", unassigned);
        }
    }

    private string SaveStatusText() => _saveState switch
    {
        SaveState.Saving => "Saving…",
        SaveState.Saved when _lastSavedAt is { } ts && !string.IsNullOrWhiteSpace(_saveError) =>
            $"Saved {ts:HH:mm:ss} with warning: {_saveError}",
        SaveState.Saved when _lastSavedAt is { } ts => $"Saved {ts:HH:mm:ss}",
        SaveState.IndexFailed => "Saved — vector index out of date, will retry",
        SaveState.SaveFailed => $"Save failed: {_saveError}",
        _ => string.Empty,
    };

    private string ChapterMetricsText() =>
        $"Words {_chapterWordCount:N0} | Tokens {TokenPrefix(_chapterTokenIsExact)}{_chapterTokenCount:N0}";

    private string ChapterMetricsTitle() => _chapterTokenIsExact
        ? "Chapter text token count"
        : "Chapter text token count is estimated";

    private void UpdateChapterMetrics(string? body)
    {
        var text = body ?? string.Empty;
        _chapterWordCount = CountWords(text);
        var result = TokenCounter.Count(text);
        _chapterTokenCount = result.TokenCount;
        _chapterTokenIsExact = result.IsExact;
    }

    private static int CountWords(string text)
    {
        var count = 0;
        var inWord = false;
        foreach (var ch in text)
        {
            if (char.IsWhiteSpace(ch))
            {
                inWord = false;
                continue;
            }

            if (inWord) continue;
            count++;
            inWord = true;
        }

        return count;
    }

    private static string TokenPrefix(bool isExact) => isExact ? string.Empty : "~";

    /// <summary>
    /// Called by EditorChatPanel before the LLM call begins. Flush any pending
    /// debounced edits and lock the editor so the user cannot type during the turn.
    /// </summary>
    private async Task OnAiTurnStartingAsync()
    {
        if (!await FlushAsync())
            throw new InvalidOperationException("The current chapter draft could not be saved. Resolve the save error before starting an agent turn.");
        // Wait for any in-flight save to complete.
        await _saveGate.WaitAsync();
        _saveGate.Release();

        _chapterLocked = true;
        await ApplyEditorReadOnlyAsync(true);
        StateHasChanged();
    }

    /// <summary>
    /// Called when the AI turn ends. Reload the chapter body (the AI may have edited
    /// it through semantic manuscript operations) and unlock the editor.
    /// </summary>
    private async Task OnAiTurnCompletedAsync()
    {
        var locationIdentity = CurrentManuscriptLocationIdentity();
        var location = await CaptureCurrentLocationAsync();
        if (locationIdentity is not null)
            RememberManuscriptLocation(locationIdentity, location);
        try
        {
            await ReconcileCurrentChapterAsync(refreshContextSurfaces: true);
            if (!await ActivateCurrentContestReviewAsync() && _mode == EditorMode.Review)
            {
                await RefreshReviewChangesAsync();
            }
            if (location is not null)
                QueueManuscriptLocationRestore();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            LogEditorRefreshFailure(ex, "AI turn completion reload");
        }
        finally
        {
            _styleCatalogVersion++;
            _stylePanelVersion++;
            _chapterLocked = false;
            try
            {
                await ApplyEditorReadOnlyAsync(EditorReadOnly);
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                LogEditorRefreshFailure(ex, "AI turn editor unlock");
            }
            StateHasChanged();
        }
    }

    private async Task OnAiTurnIdleAsync()
    {
        var locationIdentity = CurrentManuscriptLocationIdentity();
        var location = await CaptureCurrentLocationAsync();
        if (locationIdentity is not null)
            RememberManuscriptLocation(locationIdentity, location);
        try
        {
            // Chat can be recreated after a completed turn (pane collapse, reconnect,
            // or parameter refresh). Reconcile from persistence even when no active
            // runtime turn remains, but do not signal the chat to reload itself again.
            await ReconcileCurrentChapterAsync(refreshContextSurfaces: false, flushDraft: true);
            if (!await ActivateCurrentContestReviewAsync() && _mode == EditorMode.Review)
                await RefreshReviewChangesAsync();
            if (location is not null)
                QueueManuscriptLocationRestore();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            LogEditorRefreshFailure(ex, "idle chat reconciliation");
        }
        finally
        {
            _chapterLocked = false;
            await ApplyEditorReadOnlyAsync(EditorReadOnly);
            StateHasChanged();
        }
    }

    private async Task OnWorkspaceChangedAsync()
    {
        var locationIdentity = CurrentManuscriptLocationIdentity();
        var location = await CaptureCurrentLocationAsync();
        if (locationIdentity is not null)
            RememberManuscriptLocation(locationIdentity, location);
        try
        {
            await ReconcileCurrentChapterAsync(refreshContextSurfaces: true);
            if (_mode == EditorMode.Review)
            {
                await RefreshReviewChangesAsync();
            }
            if (location is not null)
                QueueManuscriptLocationRestore();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            LogEditorRefreshFailure(ex, "AI changes applied reload");
        }
        finally
        {
            _styleCatalogVersion++;
            _stylePanelVersion++;
            StateHasChanged();
        }
    }

    private async Task<bool> ReconcileCurrentChapterAsync(
        bool refreshContextSurfaces,
        bool flushDraft = false)
    {
        if (flushDraft && !await FlushAsync())
            return false;
        if (_activeChapterId is not { } chapterId)
            return false;

        var projectId = Project?.Id;
        var contentTarget = _contentTarget;
        bool IsCurrentIdentity() =>
            _activeChapterId == chapterId
            && _contentTarget == contentTarget
            && Project?.Id == projectId;

        await _chapterRefreshGate.WaitAsync();
        try
        {
            var fresh = await Chapters.ReloadFromStoreAsync(chapterId);
            if (!IsCurrentIdentity())
                return false;
            if (fresh is null)
            {
                HandleMissingChapter(chapterId);
                return false;
            }

            var effective = await Manuscripts.GetManuscriptAsync(contentTarget, chapterId)
                ?? throw new InvalidOperationException("The selected chapter manuscript was not found.");
            if (!IsCurrentIdentity())
                return false;

            IReadOnlyList<ManuscriptAnnotationView> annotations = [];
            if (projectId is Guid currentProjectId)
            {
                // Advance the rail before the read so a failed annotation
                // refresh invalidates stale cards and exposes its retry path.
                _annotationRefreshSignal++;
                try
                {
                    annotations = await Annotations.ListChapterAsync(currentProjectId, contentTarget, chapterId);
                }
                catch
                {
                    if (IsCurrentIdentity())
                    {
                        if (_bodyEditor is not null)
                            await _bodyEditor.SetAnnotationsAsync([]);
                        if (IsCurrentIdentity())
                            _readPreview?.SetAnnotations([]);
                    }
                    throw;
                }
                if (!IsCurrentIdentity())
                    return false;
            }

            EditionChapterContentStatus? status = null;
            if (contentTarget.EditionId is Guid statusEditionId && projectId is Guid statusProjectId)
            {
                status = await EditionContent.GetChapterStatusAsync(statusProjectId, statusEditionId, chapterId);
                if (!IsCurrentIdentity())
                    return false;
            }

            if (!IsCurrentIdentity())
                return false;
            _current = fresh;
            ReplaceCachedChapter(fresh);
            SynchronizeExternalEditorDocument(effective);
            UpdateChapterMetrics(effective.PlainText);
            _contentStatus = status;
            if (_bodyEditor is not null)
                await _bodyEditor.SetAnnotationsAsync(annotations);
            if (!IsCurrentIdentity())
                return false;
            _readPreview?.SetAnnotations(annotations);

        }
        finally
        {
            _chapterRefreshGate.Release();
        }

        if (!IsCurrentIdentity())
            return false;
        StateHasChanged();
        if (refreshContextSurfaces && IsCurrentIdentity())
            await RefreshContextSurfacesAsync();
        return true;
    }

    private void InstallEditorDocument(ManuscriptSnapshot snapshot)
    {
        var renderVersion = _editorDocument?.RenderVersion ?? 0;
        _editorDocument = new EditorDocumentState(
            snapshot.ChapterId,
            ManuscriptCodec.Serialize(snapshot.Document),
            snapshot.Revision,
            renderVersion);
    }

    private async Task OnAiWorkspaceMutatedAsync(EditorWorkspaceMutated mutation)
    {
        await OnWorkspaceChangedAsync();
        if (mutation.Kind != EditorWorkspaceMutationKind.PageComposition || Project is null)
            return;

        var compositionId = mutation.CompositionId;
        if (compositionId is null && mutation.VariantId is Guid variantId)
        {
            try
            {
                compositionId = (await Compositions.ReadVariantAsync(Project.Id, variantId)).CompositionId;
            }
            catch (KeyNotFoundException)
            {
                compositionId = null;
            }
        }
        if (compositionId is null || !DesignedPageIds.Contains(compositionId.Value))
        {
            await ReconcileCurrentChapterAsync(refreshContextSurfaces: true);
            if (compositionId is null || !DesignedPageIds.Contains(compositionId.Value))
                return;
        }

        _openCompositionId = compositionId;
        _mode = EditorMode.Pages;
        await RememberEditorModeAsync(_mode);
        _pageWorkspaceSelectionId = mutation.SelectedObjectId;
        _pageWorkspaceRefreshSignal++;
        StateHasChanged();
    }

    private void SynchronizeExternalEditorDocument(ManuscriptSnapshot snapshot)
    {
        if (_editorDocument is not { } document || document.ChapterId != snapshot.ChapterId)
        {
            var renderVersion = (_editorDocument?.RenderVersion ?? 0) + 1;
            _editorDocument = new EditorDocumentState(
                snapshot.ChapterId,
                ManuscriptCodec.Serialize(snapshot.Document),
                snapshot.Revision,
                renderVersion);
            return;
        }

        var manuscriptJson = ManuscriptCodec.Serialize(snapshot.Document);
        if (document.ManuscriptRevision == snapshot.Revision
            && string.Equals(document.ManuscriptJson, manuscriptJson, StringComparison.Ordinal))
            return;

        _editorDocument = document with
        {
            ManuscriptJson = manuscriptJson,
            ManuscriptRevision = snapshot.Revision,
            RenderVersion = document.RenderVersion + 1,
        };
    }

    private void RecordEditorSave(ManuscriptSnapshot snapshot)
    {
        if (_editorDocument is { } document && document.ChapterId == snapshot.ChapterId)
        {
            _editorDocument = document with
            {
                ManuscriptJson = ManuscriptCodec.Serialize(snapshot.Document),
                ManuscriptRevision = snapshot.Revision,
            };
        }
    }

    private void ReplaceCachedChapter(Chapter chapter)
    {
        var cachedIndex = _chapters.FindIndex(candidate => candidate.Id == chapter.Id);
        if (cachedIndex >= 0)
            _chapters[cachedIndex] = chapter;
    }

    private void HandleMissingChapter(Guid chapterId)
    {
        _chapters.RemoveAll(chapter => chapter.Id == chapterId);
        if (_activeChapterId == chapterId)
        {
            _activeChapterId = null;
            _current = null;
            _editorDocument = null;
            UpdateChapterMetrics(string.Empty);
        }

        if (Project is not null && _chapters.FirstOrDefault() is { } fallback)
            Nav.NavigateTo($"/projects/{Project.Slug}/editor/{fallback.Id}", replace: true);
    }

    private async Task OnContextChangedAsync() => await RefreshContextSurfacesAsync();

    private async Task ResetAssistantMemoryAsync()
    {
        if (_contextResetBusy || Project is null || _activeChapterId is not { } chapterId)
            return;

        _contextResetBusy = true;
        _contextResetError = null;
        try
        {
            await EditorContext.ResetToDefaultsAsync(Project.Id, chapterId);
            if (_activeChapterId == chapterId)
                await RefreshContextSurfacesAsync();
        }
        catch (Exception ex)
        {
            _contextResetError = $"Assistant Memory could not be reset: {ex.Message}";
            LogEditorRefreshFailure(ex, "Assistant Memory reset");
        }
        finally
        {
            _contextResetBusy = false;
            StateHasChanged();
        }
    }

    private async void HandleReviewStateChanged(Guid projectId)
    {
        if (_disposed || Project?.Id != projectId)
            return;
        if (_reviewBusy)
        {
            _reviewRefreshPending = true;
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                if (_mode == EditorMode.Review || ContestReviewActive)
                    await RefreshReviewChangesAsync();
                if (!_disposed)
                    StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RefreshContextSurfacesAsync()
    {
        _contextRefreshSignal++;
        if (_contextPanel is not null)
        {
            try
            {
                await _contextPanel.RefreshAsync();
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                LogEditorRefreshFailure(ex, "Assistant Memory refresh");
            }
        }
        StateHasChanged();
    }

    private void LogEditorRefreshFailure(Exception ex, string phase)
    {
        Logger.LogError(
            ex,
            "Editor content refresh failed during {Phase}. ProjectId={ProjectId}, ChapterId={ChapterId}",
            phase,
            Project?.Id,
            _activeChapterId);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        HistoryEvents.ReviewStateChanged -= HandleReviewStateChanged;
        _reviewRefreshLifetimeCancellation.Cancel();
        _reviewRefreshCancellation?.Cancel();

        _navHandlerRegistration?.Dispose();
        _navHandlerRegistration = null;
        try { await FlushAsync(); } catch { }
        await DisposeColumnLayoutAsync();
        var editorModule = _editorModule;
        _editorModule = null;
        if (editorModule is not null)
        {
            try { await editorModule.DisposeAsync(); } catch { }
        }
        _saveGate.Dispose();
        _chapterRefreshGate.Dispose();
        _reviewRefreshLifetimeCancellation.Dispose();
    }

