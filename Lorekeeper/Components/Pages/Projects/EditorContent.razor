@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Globalization
@using Lorekeeper.Chapters
@using Lorekeeper.Authoring
@using Lorekeeper.Composition
@using Lorekeeper.Context
@using Lorekeeper.EditorChat
@using Lorekeeper.Images
@using Lorekeeper.ImportExport
@using Lorekeeper.Models
@using Lorekeeper.Outline
@using Lorekeeper.Publish
@using Lorekeeper.Tokens
@using Lorekeeper.VersionHistory.Restore
@using Lorekeeper.VersionHistory.Services
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IChapterService Chapters
@inject IManuscriptService Manuscripts
@inject IManuscriptAnnotationService Annotations
@inject IProjectImageService Images
@inject ICompositionService Compositions
@inject IEditionContentService EditionContent
@inject IEditorContextService EditorContext
@inject IActService Acts
@inject IEditorChatService Chat
@inject IProjectVersionHistoryService VersionHistory
@inject IProjectVersionRestoreService VersionRestore
@inject IServiceScopeFactory ScopeFactory
@inject ProjectVersionHistoryUiEvents HistoryEvents
@inject ITokenCounter TokenCounter
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<EditorContent> Logger

@if (Project is null)
{
    <p class="text-muted"><em>Loading project…</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading chapters…</em></p>
}
else if (_chapters.Count == 0)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between">
        <span>No chapters yet.</span>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateFirstAsync">Create first chapter</button>
    </div>
}
else if (_current is null)
{
    <p class="text-muted"><em>Loading chapter…</em></p>
}
else
{
    <div class="@EditorGridClass()" @ref="_editorGridRef">
        <aside class="editor-chat-pane"
               hidden="@EffectiveChatPaneCollapsed"
               aria-hidden="@AriaHidden(EffectiveChatPaneCollapsed)">
            <button type="button"
                    class="editor-pane-collapse editor-pane-collapse--left"
                    title="Collapse Editor Chat"
                    aria-label="Collapse Editor Chat"
                    @onclick="ToggleChatPane">
                &lsaquo;
            </button>
            <EditorChatPanel @key="Project.Id"
                             ProjectId="Project.Id"
                             CurrentChapterId="_activeChapterId"
                             CurrentCompositionId="@(_mode == EditorMode.Pages ? _openCompositionId : null)"
                             ContentTarget="_contentTarget"
                             ContextRefreshSignal="_contextRefreshSignal"
                             ReviewRefreshSignal="_reviewRefreshSignal"
                             OnAiTurnStarting="OnAiTurnStartingAsync"
                             OnAiTurnCompleted="OnAiTurnCompletedAsync"
                             OnAiTurnIdle="OnAiTurnIdleAsync"
                             OnWorkspaceChanged="OnWorkspaceChangedAsync"
                             OnWorkspaceMutated="OnAiWorkspaceMutatedAsync"
                             OnContestResultsReady="OpenReviewForContestResultsAsync" />
        </aside>

        @if (EffectiveChatPaneCollapsed)
        {
            @if (ContestReviewActive)
            {
                <button type="button"
                        class="editor-pane-tab editor-pane-tab--left"
                        title="Refresh Contest Review"
                        aria-label="Refresh Contest Review"
                        @onclick="OpenReviewModeAsync">
                    <span>Contest</span>
                </button>
            }
            else
            {
                <button type="button"
                        class="editor-pane-tab editor-pane-tab--left"
                        title="Open Editor Chat"
                        aria-label="Open Editor Chat"
                        @onclick="ToggleChatPane">
                    <span>Chat</span>
                </button>
            }
        }

        <div class='@EditorSplitterClass("chat", EffectiveChatPaneCollapsed)'
             @ref="_chatSplitterRef"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize Editor Chat and chapter columns"
             aria-disabled="@AriaHidden(EffectiveChatPaneCollapsed)"
             tabindex="@(EffectiveChatPaneCollapsed ? -1 : 0)"
             title="Drag to resize Editor Chat. Use arrow keys for precise resizing, or double-click to reset."></div>

        <section class="@EditorPanelClass()">
            @if (!string.IsNullOrWhiteSpace(_contentTargetNotice))
            {
                <div class="alert alert-warning editor-target-notice" role="status">@_contentTargetNotice</div>
            }
            @if (_projectContestLock is { IsLocked: true } contestLock)
            {
                <div class="alert alert-warning editor-target-notice d-flex align-items-center justify-content-between gap-2" role="status">
                    <span>@(contestLock.Message ?? "The Editor is locked until Contest Review is resolved or discarded.")</span>
                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="OpenLockedContestReviewAsync">
                        Review @(contestLock.ChapterTitle ?? "contested chapter")
                    </button>
                </div>
            }
            <div class="chapter-header">
                @if (_editingTitle)
                {
                    <input class="form-control chapter-title-input"
                           value="@_titleDraft"
                           @ref="_titleInput"
                           @oninput="@(e => _titleDraft = e.Value?.ToString() ?? string.Empty)"
                           @onkeydown="OnTitleKeyDown"
                           @onblur="CommitTitleAsync" />
                }
                else
                {
                    <button type="button" class="chapter-title-btn"
                            @onclick="ToggleMenu">
                        <span>@_current.Title</span>
                        <span class="caret">▾</span>
                    </button>

                    @if (_menuOpen)
                    {
                        <div class="chapter-menu" @onclick:stopPropagation="true">
                            @foreach (var grp in GroupedChapters())
                            {
                                <div class="chapter-menu-group-label">@grp.label</div>
                                @foreach (var c in grp.chapters)
                                {
                                    <button type="button"
                                            class="chapter-menu-item @(c.Id == _current.Id ? "active" : "")"
                                            @onclick="() => SelectChapterAsync(c.Id)">@c.Title</button>
                                }
                            }
                        </div>
                    }
                }

                @if (_enabledEditions.Count > 0)
                {
                    <div class="editor-content-target">
                        <label for="editor-content-target-select">Content</label>
                        <select id="editor-content-target-select"
                                class="form-select form-select-sm"
                                value="@_contentTarget.StorageKey"
                                disabled="@(_saveState == SaveState.Saving || _chapterLocked)"
                                @onchange="ChangeContentTargetAsync">
                            <option value="core">Core Book</option>
                            @foreach (var release in _enabledEditions)
                            {
                                <option value="@($"edition:{release.EditionId:N}")">@release.Name</option>
                            }
                        </select>
                    </div>
                    @if (!_contentTarget.IsCore && _contentStatus is { } contentStatus)
                    {
                        <span class="edition-content-state @(contentStatus.IsDivergent ? "divergent" : "inherited")">
                            @(contentStatus.IsDivergent
                                ? $"Edition copy · based on Core r{contentStatus.BaseCoreRevision}"
                                : "From Core")
                        </span>
                        @if (contentStatus.CoreChangedSinceDivergence)
                        {
                            <span class="edition-content-state warning" title="Core Book changed after this edition chapter was created. The edition copy remains frozen until reset.">Core changed</span>
                        }
                        @if (contentStatus.IsDivergent)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@EditorMutationLocked" @onclick="RequestResetEditionChapter">Reset chapter to Core</button>
                        }
                    }
                }

                <button type="button" class="btn btn-sm btn-outline-secondary chapter-icon-btn" disabled="@EditorMutationLocked"
                        title="Edit title" @onclick="StartEditTitle">✎</button>
                <button type="button" class="btn btn-sm btn-outline-secondary chapter-icon-btn" disabled="@EditorMutationLocked"
                        title="New chapter" @onclick="CreateAndGoToOutlineAsync">+</button>

                <div class="small chapter-metrics" title="@ChapterMetricsTitle()">
                    @ChapterMetricsText()
                </div>

                <div class="ms-auto small index-status">
                    @SaveStatusText()
                </div>
            </div>

            <div class="chapter-mode-bar" role="group" aria-label="Chapter mode">
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Edit)"
                        disabled="@ContestReviewActive"
                        aria-pressed="@(_mode == EditorMode.Edit)"
                        @onclick="() => SetModeAsync(EditorMode.Edit)">Edit</button>
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Read)"
                        disabled="@ContestReviewActive"
                        aria-pressed="@(_mode == EditorMode.Read)"
                        @onclick="() => SetModeAsync(EditorMode.Read)">Read</button>
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Pages)"
                        disabled="@(ContestReviewActive || DesignedPageIds.Count == 0)"
                        aria-pressed="@(_mode == EditorMode.Pages)"
                        title="@(DesignedPageIds.Count == 0 ? "Insert a Designed Page in Edit mode first." : "Edit Designed Pages in this chapter")"
                        @onclick="() => SetModeAsync(EditorMode.Pages)">Pages</button>
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Review)"
                        aria-pressed="@(_mode == EditorMode.Review)"
                        title="@ReviewModeTitle"
                        @onclick="OpenReviewModeAsync">@ReviewModeLabel</button>
            </div>

            <div class="@ChapterEditorClass()">
                <div class="@AnnotationWorkspaceClass()">
                @if (_editorDocument is { } editorDocument)
                {
                    <ChapterBodyEditor @key="EditorKey(editorDocument)"
                                       @ref="_bodyEditor"
                                       ProjectId="Project.Id"
                                       ChapterId="@editorDocument.ChapterId"
                                       ContentTarget="_contentTarget"
                                       InitialManuscriptJson="@editorDocument.ManuscriptJson"
                                       IsVisible="@(_mode == EditorMode.Edit)"
                                       IsReadOnly="EditorReadOnly"
                                       OpenDesignedPage="OpenDesignedPage"
                                       OpenProjectImagePicker="OpenManuscriptImageModal"
                                       OpenBookTextStyles="OpenBookTextStylesModal"
                                       StyleCatalogChanged="OnEditorStyleCatalogChanged"
                                       AnnotationsChanged="OnEditorAnnotationsChangedAsync"
                                       AnnotationSelected="SelectAnnotationCardAsync"
                                       SaveAsync="SaveDocumentAsync" />
                }

                @if (_mode == EditorMode.Read && _current is not null)
                {
                    <ChapterReadPreview @ref="_readPreview"
                                        ProjectId="Project.Id"
                                        ChapterId="_current.Id"
                                        ContentTarget="_contentTarget"
                                        FacingPages="_readFacing"
                                        FacingPagesChanged="SetReadFacingAsync"
                                        AnnotationsChanged="OnEditorAnnotationsChangedAsync"
                                        AnnotationSelected="SelectAnnotationCardAsync"
                                        RefreshSignal="_previewRefreshSignal" />
                }

                @if ((_mode == EditorMode.Edit || _mode == EditorMode.Read) && _current is not null)
                {
                    <ManuscriptAnnotationRail @ref="_annotationRail"
                                              ProjectId="Project.Id"
                                              ChapterId="_current.Id"
                                              ContentTarget="_contentTarget"
                                              RefreshSignal="_annotationRefreshSignal"
                                              GetSelectionAsync="GetAnnotationSelectionAsync"
                                              SelectAnnotation="SelectAnnotationRangeAsync"
                                              Changed="SynchronizeAnnotationsAsync" />
                }
                </div>

                @if (_mode == EditorMode.Pages)
                {
                    <div class="chapter-pages-mode">
                        @if (DesignedPageIds.Count > 1)
                        {
                            <nav class="chapter-pages-selector" aria-label="Designed Page selection">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => MoveDesignedPage(-1)">Previous</button>
                                <select class="form-select form-select-sm" value="@_openCompositionId" @onchange="SelectDesignedPageAsync">
                                    @for (var index = 0; index < DesignedPageIds.Count; index++)
                                    {
                                        <option value="@DesignedPageIds[index]">Page @(index + 1)</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => MoveDesignedPage(1)">Next</button>
                            </nav>
                        }
                        @if (_openCompositionId is { } selectedCompositionId)
                        {
                            <DesignedPageWorkspace @key="selectedCompositionId"
                                                   @ref="_designedPageWorkspace"
                                                   ProjectId="Project.Id"
                                                   ContentTarget="_contentTarget"
                                                   CompositionId="selectedCompositionId"
                                                   RefreshSignal="_pageWorkspaceRefreshSignal"
                                                   RequestedSelectionId="_pageWorkspaceSelectionId"
                                                   InteractionLocked="@EditorMutationLocked"
                                                   CompositionForked="HandleCompositionForkedAsync" />
                        }
                    </div>
                }

                @if (_mode == EditorMode.Review)
                {
                    <div class="chapter-review-surface" @ref="_reviewSurfaceRef" role="region" aria-label="Review manuscript changes">
                        @if (_reviewLoading)
                        {
                            <div class="chapter-review-empty"><em>Loading manuscript review…</em></div>
                        }
                        else if (_contestReviewProjection is not null)
                        {
                            <div class="contest-review-inline" role="region" aria-label="Contest candidate review">
                                <div class="contest-review-inline-toolbar">
                                    <div class="contest-review-inline-summary">
                                        <strong>Contest Review</strong>
                                        <span>@_contestReviewProjection.Candidates.Count candidate@(_contestReviewProjection.Candidates.Count == 1 ? string.Empty : "s")</span>
                                    </div>
                                    <div class="contest-review-inline-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_reviewBusy || _contestReviewProjection.Blocks.Count == 0)"
                                                @onclick="GoToNextReviewBlockAsync">
                                            Next change
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                disabled="@(_reviewBusy || !CanResolveContestReview)"
                                                title="@(CanResolveContestReview ? "Apply the selected candidate draft to the live manuscript." : "Wait for every candidate to complete, fail, or become invalid, then select a completed result.")"
                                                @onclick="FinishContestReviewAsync">
                                            Resolve with selected result
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@_reviewBusy"
                                                @onclick="RequestDiscardContestAsync">
                                            Discard contest
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@_reviewBusy"
                                                @onclick="RequestCancelContestAsync">
                                            Cancel contest
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <div class="chapter-review-error">
                                        <span>@_reviewError</span>
                                        <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" @onclick="() => _reviewError = null"></button>
                                    </div>
                                }

                                <div class="contest-review-candidate-selector" role="tablist" aria-label="Contest candidates">
                                    @foreach (var candidate in _contestReviewProjection.Candidates)
                                    {
                                        <button type="button"
                                                role="tab"
                                                aria-selected="@(candidate.CandidateId == _selectedContestCandidateId)"
                                                tabindex="@(candidate.CandidateId == _selectedContestCandidateId ? 0 : -1)"
                                                disabled="@(candidate.Status != ContestCandidateStatus.Completed)"
                                                title="@(candidate.Status == ContestCandidateStatus.Failed ? candidate.ErrorMessage : ContestCandidateStatusText(candidate.Status))"
                                                class="@(candidate.CandidateId == _selectedContestCandidateId ? "active" : string.Empty)"
                                                @onclick="() => SelectContestCandidateAsync(candidate.CandidateId)">
                                            <span>Contest @(candidate.Order + 1)</span>
                                            <small>@candidate.ProviderName · @candidate.ModelName</small>
                                            <small>@ContestCandidateStatusText(candidate.Status)</small>
                                        </button>
                                    }
                                </div>
                                @if (_selectedContestCandidateId is Guid selectedContestCandidateId)
                                {
                                    <div class="contest-review-candidate-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@_reviewBusy"
                                                @onclick="() => ResetContestCandidateAsync(selectedContestCandidateId)">
                                            Reset selected draft
                                        </button>
                                    </div>
                                }

                                <div class="contest-review-columns">
                                    @foreach (var candidate in _contestReviewProjection.Candidates.Where(candidate => candidate.CandidateId == _selectedContestCandidateId))
                                    {
                                        <section class="@ContestCandidateColumnClass(candidate)" @key="candidate.CandidateId">
                                            <header class="contest-candidate-header">
                                                <div class="contest-candidate-title-row">
                                                    <div class="contest-candidate-title">@candidate.ProviderName</div>
                                                    <span class="@ContestCandidateStatusClass(candidate)">@ContestCandidateStatusText(candidate.Status)</span>
                                                </div>
                                                <div class="contest-candidate-model">@candidate.ModelName</div>
                                                @if (!string.IsNullOrWhiteSpace(candidate.Summary))
                                                {
                                                    <div class="contest-candidate-summary">@candidate.Summary</div>
                                                }
                                            </header>

                                            <div class="contest-candidate-sticky-action">
                                                <button type="button"
                                                        class="btn btn-sm btn-success contest-keep-all"
                                                        disabled="@(_reviewBusy || !candidate.CanKeepEverything)"
                                                        @onclick="() => KeepContestCandidateAsync(candidate.CandidateId)">
                                                    Keep everything from this contestant
                                                </button>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(candidate.ErrorMessage))
                                            {
                                                <div class="contest-candidate-message contest-candidate-message--error">@candidate.ErrorMessage</div>
                                            }
                                            else if (candidate.Review is null)
                                            {
                                                <div class="contest-candidate-message">@ContestCandidatePlaceholder(candidate)</div>
                                            }
                                            else
                                            {
                                                <div class="contest-candidate-lines">
                                                    @foreach (var line in candidate.Review.Lines)
                                                    {
                                                        @foreach (var block in ReviewBlocksBeforeLine(candidate.Review, line.LineNumber))
                                                        {
                                                            <article class="review-block contest-review-block" data-review-block="@block.Id" @key="block.Id">
                                                                <header class="review-block-header">
                                                                    <div class="review-block-title-wrap">
                                                                        <div class="review-block-title">
                                                                            @block.Title
                                                                            <span class="@ContestDecisionBadgeClass(block)">@ContestDecisionText(block)</span>
                                                                        </div>
                                                                        <div class="review-block-summary">@block.Summary</div>
                                                                    </div>
                                                                    <div class="review-block-actions">
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-outline-primary"
                                                                                disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running || block.HasContestConflict)"
                                                                                title="@ContestBlockActionTitle(block, "Keep")"
                                                                                @onclick="() => KeepReviewBlockAsync(block)">
                                                                            Keep
                                                                        </button>
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-outline-danger"
                                                                                disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running)"
                                                                                @onclick="() => RejectReviewBlockAsync(block)">
                                                                            Reject
                                                                        </button>
                                                                        @if (block.CanEdit)
                                                                        {
                                                                            @if (IsEditingReviewBlock(block))
                                                                            {
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-primary"
                                                                                        disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running || block.HasContestConflict)"
                                                                                        title="@ContestBlockActionTitle(block, "Save edit")"
                                                                                        @onclick="() => SaveReviewBlockEditAsync(block)">
                                                                                    Save edit
                                                                                </button>
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-secondary"
                                                                                        disabled="@_reviewBusy"
                                                                                        @onclick="CancelReviewBlockEdit">
                                                                                    Cancel
                                                                                </button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-secondary"
                                                                                        disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running || block.HasContestConflict)"
                                                                                        title="@ContestBlockActionTitle(block, "Edit")"
                                                                                        @onclick="() => BeginReviewBlockEdit(block)">
                                                                                    Edit
                                                                                </button>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </header>

                                                                @if (!string.IsNullOrWhiteSpace(block.ContestConflictMessage))
                                                                {
                                                                    <div class="contest-conflict-message">@block.ContestConflictMessage</div>
                                                                }

                                                                @if (IsRejectingReviewBlock(block))
                                                                {
                                                                    <div class="review-reject-box">
                                                                        <label for="@($"review-reject-{block.Id}")">Optional rejection note</label>
                                                                        <textarea id="@($"review-reject-{block.Id}")"
                                                                                  class="form-control"
                                                                                  rows="2"
                                                                                  placeholder="Tell the assistant what to correct next time..."
                                                                                  value="@_reviewRejectionMessage"
                                                                                  @oninput="args => _reviewRejectionMessage = args.Value?.ToString() ?? string.Empty"></textarea>
                                                                        <div class="review-reject-actions">
                                                                            <button type="button"
                                                                                    class="btn btn-sm btn-danger"
                                                                                    disabled="@_reviewBusy"
                                                                                    @onclick="() => ConfirmRejectReviewBlockAsync(block)">
                                                                                Reject line
                                                                            </button>
                                                                            <button type="button"
                                                                                    class="btn btn-sm btn-outline-secondary"
                                                                                    disabled="@_reviewBusy"
                                                                                    @onclick="CancelRejectReviewBlock">
                                                                                Cancel
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @if (IsEditingReviewBlock(block))
                                                                {
                                                                    <textarea class="form-control review-block-editor"
                                                                              rows="2"
                                                                              value="@(_reviewBlockEdit?.Text ?? string.Empty)"
                                                                              @oninput="args => UpdateReviewBlockEditText(args.Value?.ToString() ?? string.Empty)"></textarea>
                                                                }
                                                                else
                                                                {
                                                                    <div class="review-block-diff">
                                                                        @foreach (var row in ReviewBlockDisplayRows(block))
                                                                        {
                                                                            <div class="@ReviewDiffRowClass(row)">
                                                                                <span class="review-diff-line-number">@ReviewDiffLineNumber(row)</span>
                                                                                <span class="review-diff-marker">@row.Marker</span>
                                                                                <span class="review-diff-line-text">@RenderDiffSegments(row, block.Hunk.Rows)</span>
                                                                                <span class="review-diff-spacer"></span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </article>
                                                        }

                                                        @if (ShouldRenderReviewLine(candidate.Review, line))
                                                        {
                                                            <div class="@ReviewLineClass(line)" @key="line.LineNumber" data-review-line="@line.LineNumber" data-manuscript-block-id="@line.ManuscriptBlockId" data-source-start-utf16="@line.SourceStartUtf16" data-source-end-utf16="@line.SourceEndUtf16" data-location-progress="@line.LogicalProgress.ToString(CultureInfo.InvariantCulture)">
                                                                <span class="review-line-number">@line.LineNumber.ToString(candidate.Review.LineNumberFormat)</span>
                                                                <span class="@ReviewStripClass(line)" title="@line.MarkerTitle" aria-hidden="true">
                                                                    @if (line.HasDeletionMarker)
                                                                    {
                                                                        <span class="review-strip-dot review-strip-dot--removed"></span>
                                                                    }
                                                                    @if (line.IsAddedOrChanged)
                                                                    {
                                                                        <span class="review-strip-dot review-strip-dot--added"></span>
                                                                    }
                                                                </span>
                                                                <span class="review-line-text">@RenderReviewLine(line)</span>
                                                                <span class="review-line-actions">
                                                                    @if (line.PrimaryBlockId is { } blockId)
                                                                    {
                                                                        <button type="button"
                                                                                class="@ReviewLineActionClass(blockId)"
                                                                                disabled="@_reviewBusy"
                                                                                @onclick="() => ToggleReviewBlockAsync(blockId)">
                                                                            Review
                                                                        </button>
                                                                    }
                                                                </span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                            </div>
                        }
                        else if (_reviewProjection is null)
                        {
                            <div class="chapter-review-empty">
                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <em>Review could not be loaded: @_reviewError</em>
                                }
                                else if (_current is null)
                                {
                                    <em>No chapter selected.</em>
                                }
                                else
                                {
                                    <em>Review is unavailable for this chapter.</em>
                                }
                            </div>
                        }
                        else
                        {
                            @if (_reviewProjection.IsReadOnly)
                            {
                                <div class="chapter-review-toolbar chapter-review-toolbar--applied">
                                    <div class="chapter-review-summary">
                                        <span>@ReviewComparisonSubtitle</span>
                                    </div>
                                    <div class="chapter-review-toolbar-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_reviewBusy || _reviewProjection.Blocks.Count == 0)"
                                                @onclick="GoToNextReviewBlockAsync">
                                            Next change
                                        </button>
                                        @if (_historicalReview is null && _reviewView?.Comparison?.IsIdentical == false)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success"
                                                    disabled="@(_reviewBusy || _reviewView?.Comparison?.IsIdentical != false)"
                                                    title="Keep all pending changes for this chapter and content target"
                                                    @onclick="ApproveCurrentReviewAsync">
                                                Keep All
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    disabled="@(!CanUndoCurrentReview)"
                                                    title="@HistoricalUndoTitle"
                                                    @onclick="UndoCurrentReviewAsync">
                                                Reject All
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <div class="chapter-review-error">
                                        <span>@_reviewError</span>
                                        <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" @onclick="() => _reviewError = null"></button>
                                    </div>
                                }
                                @if (_historicalReview is not null && HistoricalUndoParentSha is null)
                                {
                                    <div class="chapter-review-historical-note small text-muted">This is the first approved version; there is no earlier version to restore.</div>
                                }
                                @if (_reviewProjection.IsNoDifference)
                                {
                                    <div class="chapter-review-notice">There are no pending manuscript changes.</div>
                                }
                                @if (_reviewCompositionPreviews.Count > 0)
                                {
                                    <section class="chapter-review-composition-previews" aria-label="Designed Page before and after previews">
                                        <h3>Designed Page previews</h3>
                                        @foreach (var preview in _reviewCompositionPreviews)
                                        {
                                            <article class="chapter-review-composition-preview">
                                                <header>
                                                    <strong>@CompositionLabel(preview.Composition)</strong>
                                                    <span>@(preview.Composition.EditionId is Guid editionId ? $"Edition {editionId:N}" : "Core Book")</span>
                                                </header>
                                                @if (preview.Error is not null)
                                                {
                                                    <p class="chapter-review-composition-preview-error">@preview.Error</p>
                                                }
                                                else
                                                {
                                                    <div class="chapter-review-composition-preview-panes">
                                                        <div>
                                                            <small>Before</small>
                                                            @if (preview.Before is { } before)
                                                            {
                                                                <img src="@PreviewDataUrl(before)" alt="Before preview of @CompositionLabel(preview.Composition)" />
                                                            }
                                                            else
                                                            {
                                                                <p class="text-muted">(not present)</p>
                                                            }
                                                        </div>
                                                        <div>
                                                            <small>After</small>
                                                            @if (preview.After is { } after)
                                                            {
                                                                <img src="@PreviewDataUrl(after)" alt="After preview of @CompositionLabel(preview.Composition)" />
                                                            }
                                                            else
                                                            {
                                                                <p class="text-muted">(not present)</p>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                <div class="chapter-review-composition-preview-actions">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            disabled="@(!CanApproveReviewComposition(preview.Composition))"
                                                            @onclick="() => ApproveReviewCompositionAsync(preview.Composition)">
                                                        Approve Designed Page
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            disabled="@(!CanUndoReviewComposition(preview.Composition))"
                                                            @onclick="() => UndoReviewCompositionAsync(preview.Composition)">
                                                        Undo Designed Page
                                                    </button>
                                                </div>
                                            </article>
                                        }
                                    </section>
                                }
                            }
                            else if (!_reviewProjection.HasChanges)
                            {
                                <div class="chapter-review-notice">No manuscript changes are pending for this chapter.</div>
                            }
                            else
                            {
                                <div class="chapter-review-toolbar">
                                    <div class="chapter-review-summary">
                                        <strong>@_reviewProjection.PendingChangeCount</strong>
                                        @if (_reviewProjection.Blocks.Count == 0)
                                        {
                                            <span> pending structured manuscript change@(_reviewProjection.PendingChangeCount == 1 ? string.Empty : "s") (formatting or style)</span>
                                        }
                                        else
                                        {
                                            <span> pending line change@(_reviewProjection.PendingChangeCount == 1 ? string.Empty : "s")</span>
                                        }
                                    </div>
                                    <div class="chapter-review-toolbar-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_reviewBusy || _reviewProjection.Blocks.Count == 0)"
                                                @onclick="GoToNextReviewBlockAsync">
                                            Next change
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                disabled="@(!CanResolveAllActiveChapterChanges)"
                                                title="Keep only this chapter's text and structure changes"
                                                @onclick="KeepAllActiveChapterChangesAsync">
                                            Keep All
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@(!CanResolveAllActiveChapterChanges)"
                                                title="Reject only this chapter's text and structure changes"
                                                @onclick="RejectAllActiveChapterChangesAsync">
                                            Reject All
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <div class="chapter-review-error">
                                        <span>@_reviewError</span>
                                        <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" @onclick="() => _reviewError = null"></button>
                                    </div>
                                }

                                <div class="chapter-review-scroll-rail" aria-label="Chapter body change locations">
                                    @foreach (var block in _reviewProjection.Blocks)
                                    {
                                        <button type="button"
                                                class="@ReviewRailMarkerClass(block)"
                                                style="@RailMarkerStyle(block)"
                                                title="@block.Title"
                                                aria-label="@block.Title"
                                                @onclick="() => ExpandAndScrollReviewBlockAsync(block.Id)">
                                        </button>
                                    }
                                </div>
                            }

                            @if (_reviewProjection.IsReadOnly && !_reviewProjection.IsNoDifference)
                            {
                                <div class="chapter-review-scroll-rail" aria-label="Chapter change locations">
                                    @foreach (var block in _reviewProjection.Blocks)
                                    {
                                        <button type="button"
                                                class="@ReviewRailMarkerClass(block)"
                                                style="@RailMarkerStyle(block)"
                                                title="@ReviewBlockMarkerTitle(block)"
                                                aria-label="@ReviewBlockMarkerTitle(block)"
                                                @onclick="() => ExpandAndScrollReviewBlockAsync(block.Id)">
                                        </button>
                                    }
                                </div>
                            }

                            <div class="chapter-review-lines">
                                @foreach (var line in _reviewProjection.Lines)
                                {
                                    @foreach (var block in ReviewBlocksBeforeLine(line.LineNumber))
                                    {
                                        <article class="review-block" data-review-block="@block.Id" @key="block.Id">
                                            <header class="review-block-header">
                                                <div class="review-block-title-wrap">
                                                    <div class="review-block-title">@block.Title</div>
                                                    <div class="review-block-summary">@block.Summary</div>
                                                </div>
                                                <div class="review-block-actions">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => ToggleReviewBlockAsync(block.Id)">
                                                        Hide
                                                    </button>
                                                    @if (CanResolveCurrentReviewBlock(block))
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary"
                                                                disabled="@_reviewBusy"
                                                                @onclick="() => KeepReviewBlockAsync(block)">
                                                            Keep
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                disabled="@_reviewBusy"
                                                                @onclick="() => RejectReviewBlockAsync(block)">
                                                            Reject
                                                        </button>
                                                    }
                                                    @if (CanInlineEditPendingReviewBlock(block))
                                                    {
                                                        @if (IsEditingReviewBlock(block))
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="() => SaveReviewBlockEditAsync(block)">
                                                                Save edit
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="CancelReviewBlockEdit">
                                                                Cancel
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="() => BeginReviewBlockEdit(block)">
                                                                Edit
                                                            </button>
                                                        }
                                                    }
                                                    </div>
                                            </header>

                                            @if (IsRejectingReviewBlock(block))
                                            {
                                                <div class="review-reject-box">
                                                    <label for="@($"review-reject-{block.Id}")">Optional rejection note</label>
                                                    <textarea id="@($"review-reject-{block.Id}")"
                                                              class="form-control"
                                                              rows="2"
                                                              placeholder="Tell the assistant what to correct next time..."
                                                              value="@_reviewRejectionMessage"
                                                              @oninput="args => _reviewRejectionMessage = args.Value?.ToString() ?? string.Empty"></textarea>
                                                    <div class="review-reject-actions">
                                                        <button type="button"
                                                                class="btn btn-sm btn-danger"
                                                                disabled="@_reviewBusy"
                                                                @onclick="() => ConfirmRejectReviewBlockAsync(block)">
                                                            Reject line
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary"
                                                                disabled="@_reviewBusy"
                                                                @onclick="CancelRejectReviewBlock">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            @if (IsEditingReviewBlock(block))
                                            {
                                                <textarea class="form-control review-block-editor"
                                                          rows="2"
                                                          value="@(_reviewBlockEdit?.Text ?? string.Empty)"
                                                          @oninput="args => UpdateReviewBlockEditText(args.Value?.ToString() ?? string.Empty)"></textarea>
                                            }
                                            else
                                            {
                                                <div class="review-block-diff">
                                                    @foreach (var row in ReviewBlockDisplayRows(block))
                                                    {
                                                        <div class="@ReviewDiffRowClass(row)">
                                                            <span class="review-diff-line-number">@ReviewDiffLineNumber(row)</span>
                                                            <span class="review-diff-marker">@row.Marker</span>
                                                            <span class="review-diff-line-text">@RenderDiffSegments(row, block.Hunk.Rows)</span>
                                                            <span class="review-diff-spacer"></span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </article>
                                    }

                                    @if (ShouldRenderReviewLine(line))
                                    {
                                        <div class="@ReviewLineClass(line)" @key="line.LineNumber" data-review-line="@line.LineNumber" data-manuscript-block-id="@line.ManuscriptBlockId" data-source-start-utf16="@line.SourceStartUtf16" data-source-end-utf16="@line.SourceEndUtf16" data-location-progress="@line.LogicalProgress.ToString(CultureInfo.InvariantCulture)">
                                            <span class="@(_reviewProjection.IsReadOnly ? "review-line-number review-line-number--with-categories" : "review-line-number")">
                                                <span>@line.LineNumber.ToString(_reviewProjection.LineNumberFormat)</span>
                                                @if (_reviewProjection.IsReadOnly)
                                                {
                                                    <span class="review-line-category-controls" aria-label="Change categories on this line">
                                                        @foreach (var category in ReviewLineCategories(line))
                                                        {
                                                            <button type="button"
                                                                    class="@ReviewCategoryButtonClass(_reviewProjection, line, category)"
                                                                    title="@ReviewCategoryTitle(category)"
                                                                    aria-label="@ReviewCategoryTitle(category)"
                                                                    @onclick="() => ToggleReviewCategoryAsync(line, category)">
                                                                @ReviewCategoryGlyph(category)
                                                            </button>
                                                        }
                                                    </span>
                                                }
                                            </span>
                                            <span class="@ReviewStripClass(line)" title="@line.MarkerTitle" aria-hidden="true">
                                                @if (line.HasDeletionMarker)
                                                {
                                                    <span class="review-strip-dot review-strip-dot--removed"></span>
                                                }
                                                @if (line.IsAddedOrChanged)
                                                {
                                                    <span class="review-strip-dot review-strip-dot--added"></span>
                                                }
                                            </span>
                                            <span class="review-line-text">@RenderReviewLine(line)</span>
                                            <span class="review-line-actions">
                                                @if (!_reviewProjection.IsReadOnly && line.PrimaryBlockId is { } blockId)
                                                {
                                                    <button type="button"
                                                            class="@ReviewLineActionClass(blockId)"
                                                            title="Review this manuscript change inline"
                                                            @onclick="() => ToggleReviewBlockAsync(blockId)">
                                                        Review
                                                    </button>
                                                }
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <div class='@EditorSplitterClass("memory", EffectiveRightPaneCollapsed)'
             @ref="_memorySplitterRef"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize chapter and Assistant Memory columns"
             aria-disabled="@AriaHidden(EffectiveRightPaneCollapsed)"
             tabindex="@(EffectiveRightPaneCollapsed ? -1 : 0)"
             title="Drag to resize Assistant Memory. Use arrow keys for precise resizing, or double-click to reset."></div>

        @if (EffectiveRightPaneCollapsed)
        {
            <button type="button"
                    class="editor-pane-tab editor-pane-tab--right"
                    title="Open Assistant Memory and Search"
                    aria-label="Open Assistant Memory and Search"
                    @onclick="ToggleRightPane">
                <span>Memory</span>
            </button>
        }
        else
        {
            <aside class="@EditorSidePaneClass()">
                <button type="button"
                        class="editor-pane-collapse editor-pane-collapse--right"
                        title="Collapse Assistant Memory and Search"
                        aria-label="Collapse Assistant Memory and Search"
                        @onclick="ToggleRightPane">
                    &rsaquo;
                </button>

                <section class='@(PanelClass("panel-context", _contextFeedOpen))'>
                    <h6 class="panel-title panel-title--with-action">
                        <button type="button"
                                class="panel-title-toggle"
                                title='@(PanelToggleTitle("Assistant Memory", _contextFeedOpen))'
                                aria-expanded="@_contextFeedOpen"
                                aria-controls="context-feed-panel-content"
                                @onclick="ToggleContextFeed">
                            <span class="caret">@PanelCaret(_contextFeedOpen)</span>
                            <span class="panel-title-text">Assistant Memory</span>
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary panel-title-action"
                                title="Reset this chapter's Assistant Memory to its default context"
                                aria-label="Reset this chapter's Assistant Memory to its default context"
                                disabled="@(_activeChapterId is null || LayoutControlsLocked || _contextResetBusy)"
                                @onclick="ResetAssistantMemoryAsync">
                            @(_contextResetBusy ? "Resetting…" : "Reset")
                        </button>
                    </h6>
                    @if (!string.IsNullOrWhiteSpace(_contextResetError))
                    {
                        <div class="alert alert-danger py-2 small mb-2">@_contextResetError</div>
                    }
                    <div id="context-feed-panel-content"
                         class="@PanelContentClass(_contextFeedOpen)"
                         aria-hidden="@AriaHidden(!_contextFeedOpen)">
                        <ContextFeedPanel @ref="_contextPanel"
                                          Project="Project"
                                          CurrentChapter="_current"
                                          ContentTarget="_contentTarget"
                                          OnContextChanged="OnContextChangedAsync" />
                    </div>
                </section>

                <section class='@(PanelClass("panel-recommendations", _recommendedContextOpen))'>
                    <h6 class="panel-title panel-title--with-action">
                        <button type="button"
                                class="panel-title-toggle"
                                title='@(PanelToggleTitle("Search", _recommendedContextOpen))'
                                aria-expanded="@_recommendedContextOpen"
                                aria-controls="recommended-context-panel-content"
                                @onclick="ToggleRecommendedContext">
                            <span class="caret">@PanelCaret(_recommendedContextOpen)</span>
                            <span class="panel-title-text">Search</span>
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary panel-title-action"
                                disabled="@(_activeChapterId is null || LayoutControlsLocked)"
                                @onclick="OpenImagesModal">
                            Images
                        </button>
                    </h6>
                    <div id="recommended-context-panel-content"
                         class="@PanelContentClass(_recommendedContextOpen)"
                         aria-hidden="@AriaHidden(!_recommendedContextOpen)">
                        <RecommendedContextPanel ProjectId="Project.Id"
                                                 ChapterId="_activeChapterId"
                                                 RefreshSignal="_contextRefreshSignal"
                                                 OnChanged="OnContextChangedAsync" />
                    </div>
                </section>
            </aside>
        }
    </div>

    <ProjectImageLibraryPickerModal ProjectId="Project.Id"
                                    IsOpen="_imagesModalOpen"
                                    Title="Choose an image for assistant context"
                                    PrimaryActionLabel="Add to context"
                                    PrimaryActionEnabled="@(!LayoutControlsLocked && _activeChapterId is not null)"
                                    OnClose="CloseImagesModal"
                                    OnPrimaryAction="AddImageToContextAsync" />

    <ProjectImageLibraryPickerModal ProjectId="Project.Id"
                                    IsOpen="_manuscriptImageModalOpen"
                                    Title="Choose a manuscript image"
                                    PrimaryActionLabel="Use image"
                                    PrimaryActionEnabled="@(!LayoutControlsLocked && _bodyEditor is not null)"
                                    OnClose="CloseManuscriptImageModal"
                                    OnPrimaryAction="SelectManuscriptImageAsync" />

    <BookTextStylesModal ProjectId="Project.Id"
                         IsOpen="_bookTextStylesModalOpen"
                         RefreshSignal="_stylePanelVersion"
                         BeforeChange="FlushAsync"
                         Changed="OnManuscriptStylesChangedAsync"
                         OnClose="CloseBookTextStylesModal" />

    <ConfirmationDialog IsOpen="_resetEditionChapterConfirmationOpen"
                        Title="Reset chapter to Core Book?"
                        Message="This permanently discards the edition manuscript and its edition-only page layouts. Saved Book Text Styles and project images are kept."
                        ConfirmLabel="Reset chapter"
                        Destructive="true"
                        Busy="_resetEditionChapterBusy"
                        OnConfirm="ResetEditionChapterAsync"
                        OnCancel="CancelResetEditionChapter" />

    <ConfirmationDialog IsOpen="@(_contestConfirmation is not null)"
                        Title="@ContestConfirmationTitle"
                        Message="@ContestConfirmationMessage"
                        ConfirmLabel="@ContestConfirmationLabel"
                        Destructive="@(_contestConfirmation == ContestConfirmationAction.Discard)"
                        Busy="@_reviewBusy"
                        OnConfirm="ConfirmContestActionAsync"
                        OnCancel="CancelContestAction" />

}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [Parameter] public Guid? ChapterId { get; set; }
    [Parameter] public Guid? EditionId { get; set; }
    [Parameter] public string? RequestedMode { get; set; }
    [Parameter] public Guid? RequestedCompositionId { get; set; }
    [Parameter] public Guid? RequestedObjectId { get; set; }
    [Parameter] public Action<Guid>? SynchronizeChapter { get; set; }

    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private readonly SemaphoreSlim _chapterRefreshGate = new(1, 1);
    private readonly CancellationTokenSource _reviewRefreshLifetimeCancellation = new();

    private List<Chapter> _chapters = [];
    private List<Act> _acts = [];
    private Chapter? _current;
    private bool _loading = true;
    private Guid? _loadedProjectId;
    private Guid? _activeChapterId;
    private EditorContentTarget _contentTarget = EditorContentTarget.Core;
    private string? _contentTargetNotice;
    private EditorContentTarget _loadedContentTarget = EditorContentTarget.Core;
    private IReadOnlyList<EditionContentReleaseView> _enabledEditions = [];
    private EditionChapterContentStatus? _contentStatus;
    private bool _restoreChapterAfterRender;
    private Guid? _pendingRememberChapterId;

    private bool _editingTitle;
    private string _titleDraft = string.Empty;
    private ElementReference _titleInput;
    private bool _focusTitleNext;

    private bool _menuOpen;
    private bool _recommendedContextOpen = true;
    private bool _contextFeedOpen = true;
    private EditorMode _mode = EditorMode.Edit;
    private bool _chatPaneCollapsed;
    private bool _rightPaneCollapsed;
    private bool _readFacing;
    private Guid? _workspacePreferencesProjectId;
    private readonly Dictionary<Guid, EditorMode> _rememberedChapterModes = [];

    private ElementReference _reviewSurfaceRef;
    private ElementReference _editorGridRef;
    private ElementReference _chatSplitterRef;
    private ElementReference _memorySplitterRef;
    private IJSObjectReference? _editorModule;
    private IJSObjectReference? _columnLayoutHandle;
    private Guid? _columnLayoutProjectId;
    private bool _disposed;
    private ChapterBodyEditor? _bodyEditor;
    private ChapterReadPreview? _readPreview;
    private EditorDocumentState? _editorDocument;
    private long _styleCatalogVersion;
    private long _stylePanelVersion;
    private Guid? _openCompositionId;
    private long _previewRefreshSignal;
    private int _annotationRefreshSignal;

    private SaveState _saveState = SaveState.Idle;
    private DateTime? _lastSavedAt;
    private string? _saveError;

    private IDisposable? _navHandlerRegistration;

    private bool _chapterLocked;
    private EditorContestLockState _projectContestLock = EditorContestLockState.Unlocked;
    private Guid? _contestAutoOpenedProjectId;
    private ContextFeedPanel? _contextPanel;
    private int _contextRefreshSignal;
    private bool _contextResetBusy;
    private string? _contextResetError;
    private int _reviewRefreshSignal;
    private bool _imagesModalOpen;
    private bool _manuscriptImageModalOpen;
    private bool _bookTextStylesModalOpen;
    private bool _resetEditionChapterConfirmationOpen;
    private bool _resetEditionChapterBusy;
    private int _chapterWordCount;
    private int _chapterTokenCount;
    private bool _chapterTokenIsExact = true;
    private bool _reviewLoading;
    private ReviewProjection? _reviewProjection;
    private IReadOnlyList<ReviewCompositionPreview> _reviewCompositionPreviews = [];
    private ProjectVersionReviewView? _reviewView;
    private ProjectVersionHistoricalChapterReview? _historicalReview;
    private ContestReviewProjection? _contestReviewProjection;
    private IReadOnlyList<ContestBatch> _contestReviewBatches = [];
    private readonly HashSet<string> _expandedReviewBlockIds = new(StringComparer.Ordinal);
    private string? _activeReviewBlockId;
    private string? _pendingReviewScrollBlockId;
    private ManuscriptViewLocation? _manuscriptLocation;
    private ManuscriptLocationIdentity? _manuscriptLocationIdentity;
    private ManuscriptViewLocation? _pendingLocation;
    private ManuscriptLocationIdentity? _pendingLocationIdentity;
    private string? _reviewError;
    private bool _reviewBusy;
    private bool _reviewRefreshPending;
    private bool _reviewRefreshRequested;
    private bool _reviewRefreshInFlight;
    private long _reviewRefreshSequence;
    private CancellationTokenSource? _reviewRefreshCancellation;
    private ReviewBlockEdit? _reviewBlockEdit;
    private string? _rejectingReviewBlockId;
    private string _reviewRejectionMessage = string.Empty;
    private Guid? _selectedContestCandidateId;
    private ContestConfirmationAction? _contestConfirmation;

    private string ContestConfirmationTitle => _contestConfirmation switch
    {
        ContestConfirmationAction.Discard => "Discard this contest?",
        ContestConfirmationAction.Cancel => "Cancel this contest?",
        _ => string.Empty,
    };

    private string ContestConfirmationMessage => _contestConfirmation switch
    {
        ContestConfirmationAction.Discard => "All candidate drafts will be discarded and no candidate will change the manuscript.",
        ContestConfirmationAction.Cancel => "The running contest will be cancelled. Completed candidate drafts will not be applied.",
        _ => string.Empty,
    };

    private string ContestConfirmationLabel => _contestConfirmation switch
    {
        ContestConfirmationAction.Discard => "Discard contest",
        ContestConfirmationAction.Cancel => "Cancel contest",
        _ => "Continue",
    };

    private ManuscriptLocationIdentity? CurrentManuscriptLocationIdentity() =>
        Project?.Id is Guid projectId && _activeChapterId is Guid chapterId
            ? new ManuscriptLocationIdentity(projectId, chapterId, _contentTarget.StorageKey)
            : null;

    private bool IsCurrentManuscriptLocation(ManuscriptLocationIdentity identity) =>
        CurrentManuscriptLocationIdentity() is { } current && current == identity;

    private bool EditorMutationLocked => _chapterLocked || _projectContestLock.IsLocked;
    private bool EditorReadOnly => EditorMutationLocked || _mode != EditorMode.Edit;
    private bool LayoutControlsLocked => EditorMutationLocked;
    private bool ContestReviewActive => _contestReviewProjection is not null;
    private bool CanResolveContestReview => _contestReviewProjection is { } projection
        && projection.Candidates.All(candidate => candidate.Status is not ContestCandidateStatus.Pending and not ContestCandidateStatus.Running)
        && projection.Candidates.Any(candidate =>
            candidate.CandidateId == _selectedContestCandidateId
            && candidate.Status == ContestCandidateStatus.Completed);
    private string ReviewComparisonSubtitle => _historicalReview is not null
        ? "Reviewing latest approved changes"
        : _reviewView?.Comparison?.IsIdentical == false
            ? "Reviewing pending changes"
            : "No pending changes";
    private ContestBatch? CurrentChapterContest => _current is null
        ? null
        : _contestReviewBatches.FirstOrDefault(batch => batch.ChapterId == _current.Id && batch.Candidates.Count > 0);
    private string ReviewModeLabel => CurrentChapterContest?.Status switch
    {
        ContestBatchStatus.Running => "Contest running",
        ContestBatchStatus.Completed => "Contest review",
        _ => "Review",
    };
    private string ReviewModeTitle => CurrentChapterContest?.Status switch
    {
        ContestBatchStatus.Running => "Open the running Contest Mode review",
        ContestBatchStatus.Completed => "Review Contest Mode candidates",
        _ => "Review manuscript changes",
    };
    private IReadOnlyList<Guid> DesignedPageIds
    {
        get
        {
            if (_editorDocument is not { } document) return [];
            try
            {
                return ManuscriptCodec.Deserialize(document.ManuscriptJson, document.ChapterId, document.ManuscriptRevision)
                    .Content.Where(block => block.Type == ManuscriptBlockType.DesignedPage && block.PageCompositionId is not null)
                    .Select(block => block.PageCompositionId!.Value).ToArray();
            }
            catch (InvalidDataException) { return []; }
        }
    }
    private DesignedPageWorkspace? _designedPageWorkspace;
    private int _pageWorkspaceRefreshSignal;
    private Guid? _pageWorkspaceSelectionId;
    private async Task OpenDesignedPage(Guid compositionId)
    {
        if (!DesignedPageIds.Contains(compositionId)
            && !await ReconcileCurrentChapterAsync(refreshContextSurfaces: false))
            return;
        _openCompositionId = compositionId;
        await SetModeAsync(EditorMode.Pages);
    }
    private async Task HandleCompositionForkedAsync(Guid compositionId)
    {
        _openCompositionId = compositionId;
