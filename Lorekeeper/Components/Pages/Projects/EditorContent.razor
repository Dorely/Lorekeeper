    private async Task SetModeAsync(EditorMode mode)
    {
        if (_mode == mode) return;
        if (ContestReviewActive && mode != EditorMode.Review) return;
        if (mode == EditorMode.Pages && DesignedPageIds.Count == 0) return;

        var locationIdentity = CurrentManuscriptLocationIdentity();
        ManuscriptViewLocation? capturedLocation = null;
        if (_mode != EditorMode.Pages && locationIdentity is not null)
            capturedLocation = await CaptureCurrentLocationAsync();

        if (mode is EditorMode.Read or EditorMode.Pages or EditorMode.Review)
        {
            if (!await FlushAsync()) return;
            await _saveGate.WaitAsync();
            _saveGate.Release();
        }

        if (locationIdentity is not null && IsCurrentManuscriptLocation(locationIdentity))
            RememberManuscriptLocation(locationIdentity, capturedLocation);

        _mode = mode;
        if (mode != EditorMode.Review)
            CancelReviewRefresh();
        if (mode == EditorMode.Pages)
        {
            var pages = DesignedPageIds;
            if (_openCompositionId is null || !pages.Contains(_openCompositionId.Value))
                _openCompositionId = pages[0];
        }
        await ApplyEditorReadOnlyAsync(EditorReadOnly);

        if (_mode == EditorMode.Review)
        {
            await RefreshReviewChangesAsync();
            if (_reviewProjection?.IsReadOnly == true)
            {
                _expandedReviewBlockIds.Clear();
                _activeReviewBlockId = null;
                _pendingReviewScrollBlockId = null;
                ClearInlineReviewEditors();
            }
        }

        await RememberEditorModeAsync(_mode);

        if (_mode is EditorMode.Edit or EditorMode.Read or EditorMode.Review)
            QueueManuscriptLocationRestore();

        StateHasChanged();
    }

