    }

    private void ClearInlineReviewEditors()
    {
        _reviewBlockEdit = null;
        _rejectingReviewBlockId = null;
        _reviewRejectionMessage = string.Empty;
    }

    private void PruneInlineReviewState()
    {
        var validBlocks = CurrentReviewBlocks();
        if (validBlocks.Count == 0)
        {
            ResetInlineReviewState();
            return;
        }

        var validBlockIds = validBlocks.Select(block => block.Id).ToHashSet(StringComparer.Ordinal);
        _expandedReviewBlockIds.RemoveWhere(blockId => !validBlockIds.Contains(blockId));
        if (_activeReviewBlockId is not null && !validBlockIds.Contains(_activeReviewBlockId))
            _activeReviewBlockId = _expandedReviewBlockIds.FirstOrDefault();
        if (_pendingReviewScrollBlockId is not null && !validBlockIds.Contains(_pendingReviewScrollBlockId))
            _pendingReviewScrollBlockId = null;
        if (_reviewBlockEdit is not null && !validBlockIds.Contains(_reviewBlockEdit.BlockId))
            _reviewBlockEdit = null;
        if (_rejectingReviewBlockId is not null && !validBlockIds.Contains(_rejectingReviewBlockId))
        {
            _rejectingReviewBlockId = null;
            _reviewRejectionMessage = string.Empty;
        }
    }

    private static ReviewProjection BuildReviewProjection(Chapter chapter, IReadOnlyList<AiChangeBatch> batches)
    {
        var changes = CurrentChapterBodyChanges(batches, chapter.Id);
        var proposedBody = changes.Count == 0
            ? chapter.Body
            : ReadChapterBodyChange(AiChangeReviewDrafts.EffectiveAfterJson(changes[^1]))?.Body ?? chapter.Body;
        var lines = ChapterFormatting.SplitLines(proposedBody);
        var displayLines = lines.Count == 0 && changes.Count > 0 ? [string.Empty] : lines;
        var width = Math.Max(4, displayLines.Count.ToString().Length);
        var drafts = displayLines
            .Select((text, index) => new ReviewLineDraft(index + 1, text))
            .ToList();
        var blocks = new List<ReviewBlock>();

        if (changes.Count > 0 && AiChangeReviewDiffBuilder.TryBuild(changes, out var diff))
        {
            var fallbackChangeId = changes[^1].Id;
            foreach (var section in diff.Sections.Where(section => string.Equals(section.Key, "Body", StringComparison.OrdinalIgnoreCase)))
            {
                for (var hunkIndex = 0; hunkIndex < section.Hunks.Count; hunkIndex++)
                {
                    var hunk = section.Hunks[hunkIndex];
                    var changeId = section.OwnerChangeId ?? fallbackChangeId;
                    foreach (var block in ReviewBlocksForHunk(changeId, section, hunk, hunkIndex, drafts.Count))
                    {
                        blocks.Add(block);

                        if (block.NewRow is { NewLineNumber: int newLineNumber } newRow)
                        {
                            if (newLineNumber < 1 || newLineNumber > drafts.Count) continue;
                            var draft = drafts[newLineNumber - 1];
                            draft.IsAddedOrChanged = true;
                            draft.BlockIds.Add(block.Id);
                            draft.Segments = ReviewSegmentsForAddedRow(newRow, hunk.Rows, RowIndex(hunk.Rows, newRow));
                        }

                        if (block.OldRow is not null)
                        {
                            if (block.AnchorLine < 1 || block.AnchorLine > drafts.Count) continue;
                            var draft = drafts[block.AnchorLine - 1];
                            draft.HasDeletionMarker = true;
                            draft.BlockIds.Add(block.Id);
                        }
                    }
                }
            }
        }

        var orderedBlocks = blocks
            .OrderBy(block => block.AnchorLine)
            .ThenBy(block => block.NewRow?.NewLineNumber ?? int.MaxValue)
            .ThenBy(block => block.OldRow?.OldLineNumber ?? int.MaxValue)
            .ThenBy(block => block.Id, StringComparer.Ordinal)
            .ToList();

        return new ReviewProjection(
            HasChanges: orderedBlocks.Count > 0,
            PendingChangeCount: orderedBlocks.Count,
            PendingChangeIds: changes.Select(change => change.Id).ToList(),
            LineNumberFormat: new string('0', width),
            Blocks: orderedBlocks,
            Lines: drafts
                .Select(draft => new ReviewLine(
                    draft.LineNumber,
                    draft.Text,
                    draft.Segments,
                    draft.IsAddedOrChanged,
                    draft.HasDeletionMarker,
                    draft.BlockIds.Distinct(StringComparer.Ordinal).ToList(),
                    draft.BlockIds.FirstOrDefault(),
                    MarkerTitle(draft)))
                .ToList());
    }

    private static ContestReviewProjection BuildContestReviewProjection(ContestBatch batch)
    {
        var reviews = new Dictionary<Guid, ReviewProjection?>();
        var states = new Dictionary<Guid, ContestCandidateReviewState>();
        foreach (var candidate in batch.Candidates.OrderBy(candidate => candidate.Order))
        {
            states[candidate.Id] = ReadContestReviewState(candidate);
            reviews[candidate.Id] = candidate.Status == ContestCandidateStatus.Completed
                ? BuildContestCandidateReviewProjection(batch, candidate)
                : null;
        }

        var acceptedOperations = BuildContestAcceptedOperations(batch, reviews, states);
        var candidates = new List<ContestCandidateProjection>();
        foreach (var candidate in batch.Candidates.OrderBy(candidate => candidate.Order))
        {
            var review = reviews[candidate.Id];
            if (review is not null)
            {
                var decisionsByBlockId = states[candidate.Id].Lines.ToDictionary(line => line.BlockId, StringComparer.Ordinal);
                var blocks = review.Blocks.Select(block =>
                {
                    var decision = ContestDecisionForBlock(batch, candidate, decisionsByBlockId, block);
                    var conflict = false;
                    string? conflictMessage = null;
                    if (batch.WinningCandidateId is { } winnerId && winnerId != candidate.Id)
                    {
                        conflict = true;
                        conflictMessage = "A whole contestant is selected. Use Keep everything on this contestant to replace it.";
                    }
                    else if (decision is not (ContestCandidateLineDecisionKind.Kept or ContestCandidateLineDecisionKind.Edited)
                             && FindConflictingAcceptedOperation(block, candidate.Id, acceptedOperations) is { } conflictOperation)
                    {
                        conflict = true;
                        conflictMessage = $"Conflicts with a kept line from contestant {conflictOperation.CandidateOrder + 1}.";
                    }

                    return block with
                    {
                        ContestCandidateId = candidate.Id,
                        ContestDecision = decision,
                        HasContestConflict = conflict,
                        ContestConflictMessage = conflictMessage,
                    };
                }).ToList();
                review = review with { Blocks = blocks };
            }

            candidates.Add(new ContestCandidateProjection(
                candidate.Id,
                candidate.Order,
                candidate.ProviderName,
                candidate.ModelName,
                candidate.Status,
                candidate.Summary,
                candidate.ErrorMessage,
                review,
                batch.WinningCandidateId == candidate.Id,
                candidate.Status == ContestCandidateStatus.Completed
                    && batch.Status == ContestBatchStatus.Completed));
        }

        var allBlocks = candidates
            .SelectMany(candidate => candidate.Review?.Blocks ?? [])
            .OrderBy(block => block.AnchorLine)
            .ThenBy(block => block.ContestCandidateId)
            .ThenBy(block => block.Id, StringComparer.Ordinal)
            .ToList();

        return new ContestReviewProjection(batch, candidates, allBlocks);
    }

    private static ReviewProjection? BuildContestCandidateReviewProjection(ContestBatch batch, ContestCandidate candidate)
    {
        var fakeBatch = new AiChangeBatch
        {
            Id = batch.Id,
            ProjectId = batch.ProjectId,
            ConversationId = batch.ConversationId,
            ConversationKind = AiChangeConversationKind.Editor,
            CreatedAt = batch.CreatedAt,
        };
        var fakeChange = new AiChange
        {
            Id = candidate.Id,
            BatchId = fakeBatch.Id,
            Batch = fakeBatch,
            ToolName = "edit_chapter",
            Summary = candidate.Summary,
            BeforeJson = JsonSerializer.Serialize(new ChapterBodyChange(batch.ChapterId, batch.ChapterTitle, batch.OriginalChapterBody), ChangePayloadJsonOptions),
            AfterJson = JsonSerializer.Serialize(new ChapterBodyChange(batch.ChapterId, batch.ChapterTitle, candidate.ProposedBody), ChangePayloadJsonOptions),
            ResourceKind = "ChapterBody",
            ResourceId = batch.ChapterId.ToString("N"),
            Status = AiChangeStatus.Pending,
        };
        fakeBatch.Changes.Add(fakeChange);

        var chapter = new Chapter
        {
            Id = batch.ChapterId,
            ProjectId = batch.ProjectId,
            Title = batch.ChapterTitle,
            Body = batch.OriginalChapterBody,
        };
        return BuildReviewProjection(chapter, [fakeBatch]);
    }

    private static IReadOnlyList<ContestReviewOperation> BuildContestAcceptedOperations(
        ContestBatch batch,
        IReadOnlyDictionary<Guid, ReviewProjection?> reviews,
        IReadOnlyDictionary<Guid, ContestCandidateReviewState> states)
    {
        var operations = new List<ContestReviewOperation>();
        if (batch.WinningCandidateId is { } winnerId)
        {
            if (!reviews.TryGetValue(winnerId, out var winnerReview) || winnerReview is null)
                return operations;
            var winner = batch.Candidates.FirstOrDefault(candidate => candidate.Id == winnerId);
            if (winner is null)
                return operations;

            var decisions = states.TryGetValue(winnerId, out var state)
                ? state.Lines.ToDictionary(line => line.BlockId, StringComparer.Ordinal)
                : new Dictionary<string, ContestCandidateLineDecision>(StringComparer.Ordinal);
            foreach (var block in winnerReview.Blocks)
            {
                if (decisions.TryGetValue(block.Id, out var decision)
                    && decision.Decision == ContestCandidateLineDecisionKind.Rejected)
                {
                    continue;
                }

                if (BuildContestOperation(block, winner.Id, winner.Order) is { } operation)
                    operations.Add(operation);
            }

            return operations;
        }

        foreach (var candidate in batch.Candidates.OrderBy(candidate => candidate.Order))
        {
            if (!reviews.TryGetValue(candidate.Id, out var review) || review is null)
                continue;
            if (!states.TryGetValue(candidate.Id, out var state))
                continue;

            var blocksById = review.Blocks.ToDictionary(block => block.Id, StringComparer.Ordinal);
            foreach (var decision in state.Lines)
            {
                if (decision.Decision is not (ContestCandidateLineDecisionKind.Kept or ContestCandidateLineDecisionKind.Edited))
                    continue;
                if (!blocksById.TryGetValue(decision.BlockId, out var block))
                    continue;
                if (BuildContestOperation(block, candidate.Id, candidate.Order) is { } operation)
                    operations.Add(operation);
            }
        }

        return operations;
    }

    private static ContestCandidateLineDecisionKind? ContestDecisionForBlock(
        ContestBatch batch,
        ContestCandidate candidate,
        IReadOnlyDictionary<string, ContestCandidateLineDecision> decisionsByBlockId,
        ReviewBlock block)
    {
        if (decisionsByBlockId.TryGetValue(block.Id, out var decision))
            return decision.Decision;
        return batch.WinningCandidateId == candidate.Id
            ? ContestCandidateLineDecisionKind.Kept
            : null;
    }

    private static ContestReviewOperation? FindConflictingAcceptedOperation(
        ReviewBlock block,
        Guid candidateId,
        IReadOnlyList<ContestReviewOperation> acceptedOperations)
    {
        var operation = BuildContestOperation(block, candidateId, candidateOrder: -1);
        return operation is null
            ? null
            : acceptedOperations.FirstOrDefault(existing => ContestOperationsConflict(existing, operation));
    }

    private static ContestReviewOperation? BuildContestOperation(ReviewBlock block, Guid candidateId, int candidateOrder)
    {
        if (block.OldRow?.OldLineNumber is int oldLineNumber)
            return new ContestReviewOperation(candidateId, block.Id, candidateOrder, oldLineNumber - 1, DeleteCount: 1);

        if (block.NewRow is not null)
        {
            var rowIndex = RowIndex(block.Hunk.Rows, block.NewRow);
            return new ContestReviewOperation(
                candidateId,
                block.Id,
                candidateOrder,
                FindContestInsertionIndex(block.Hunk.Rows, rowIndex),
                DeleteCount: 0);
        }

        return null;
    }

    private static int FindContestInsertionIndex(IReadOnlyList<DiffRow> rows, int rowIndex)
    {
        for (var index = rowIndex - 1; index >= 0; index--)
        {
            if (rows[index].OldLineNumber is int previousLine)
                return previousLine;
        }

        for (var index = rowIndex + 1; index < rows.Count; index++)
        {
            if (rows[index].OldLineNumber is int nextLine)
                return Math.Max(0, nextLine - 1);
        }

        return 0;
    }

    private static bool ContestOperationsConflict(ContestReviewOperation left, ContestReviewOperation right)
    {
        if (left.CandidateId == right.CandidateId)
            return false;

        var leftInsertion = left.DeleteCount == 0;
        var rightInsertion = right.DeleteCount == 0;
        if (leftInsertion || rightInsertion)
            return leftInsertion && rightInsertion && left.StartIndex == right.StartIndex;

        var leftEnd = left.StartIndex + left.DeleteCount - 1;
        var rightEnd = right.StartIndex + right.DeleteCount - 1;
        return left.StartIndex <= rightEnd && right.StartIndex <= leftEnd;
    }

    private static ContestCandidateReviewState ReadContestReviewState(ContestCandidate candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate.ReviewStateJson) || candidate.ReviewStateJson == "{}")
            return new ContestCandidateReviewState([]);

        try
        {
            return JsonSerializer.Deserialize<ContestCandidateReviewState>(candidate.ReviewStateJson, ContestReviewStateJsonOptions)
                ?? new ContestCandidateReviewState([]);
        }
        catch (JsonException)
        {
            return new ContestCandidateReviewState([]);
        }
    }

