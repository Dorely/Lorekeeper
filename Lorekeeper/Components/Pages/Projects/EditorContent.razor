    private async Task RefreshReviewChangesAsync()
    {
        if (Project is null || _current is null)
        {
            _reviewPendingBatches = [];
            _reviewProjection = null;
            _reviewLoading = false;
            ResetInlineReviewState();
            return;
        }

        _reviewLoading = true;
        try
        {
            await ChangeApproval.PrepareChapterBodyLineReviewAsync(Project.Id, _current.Id);
            _reviewPendingBatches = await Chat.ListPendingChangesAsync(Project.Id);
            _reviewProjection = BuildReviewProjection(_current, _reviewPendingBatches);
            _reviewError = null;
            PruneInlineReviewState();
        }
        catch (Exception ex)
        {
            _reviewPendingBatches = await Chat.ListPendingChangesAsync(Project.Id);
            _reviewProjection = BuildReviewProjection(_current, _reviewPendingBatches);
            _reviewError = ex.Message;
            PruneInlineReviewState();
        }
        finally
        {
            _reviewLoading = false;
        }
    }

