    private async Task ChangeContentTargetAsync(ChangeEventArgs args)
    {
        if (Project is null || _activeChapterId is not Guid chapterId || !await FlushAsync())
            return;
        var value = args.Value?.ToString() ?? "core";
        Guid? editionId = null;
        if (value.StartsWith("edition:", StringComparison.Ordinal)
            && Guid.TryParse(value["edition:".Length..], out var parsed)
            && _enabledEditions.Any(item => item.EditionId == parsed))
            editionId = parsed;
        if (_editorModule is not null)
        {
            try
            {
                await _editorModule.InvokeVoidAsync(
                    "setEditorContentTarget",
                    Project.Id.ToString("N"),
                    editionId is Guid selected ? $"Edition:{selected:D}" : "Core");
