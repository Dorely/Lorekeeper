@using System.Text.Json
@using System.Globalization
@using Lorekeeper.Chapters
@using Lorekeeper.Components.Pages.Projects.Outline
@using Lorekeeper.Context
@using Lorekeeper.EditorChat
@using Lorekeeper.Models
@using Lorekeeper.Outline
@using Lorekeeper.Tokens
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IChapterService Chapters
@inject IActService Acts
@inject IEditorChatService Chat
@inject IAiChangeApprovalService ChangeApproval
@inject ITokenCounter TokenCounter
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<EditorContent> Logger

@if (Project is null)
{
    <p class="text-muted"><em>Loading project…</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading chapters…</em></p>
}
else if (_chapters.Count == 0)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between">
        <span>No chapters yet.</span>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateFirstAsync">Create first chapter</button>
    </div>
}
else if (_current is null)
{
    <p class="text-muted"><em>Loading chapter…</em></p>
}
else
{
    <div class="@EditorGridClass()">
        @if (_chatPaneCollapsed)
        {
            <button type="button"
                    class="editor-pane-tab editor-pane-tab--left"
                    title="Open Editor Chat"
                    aria-label="Open Editor Chat"
                    @onclick="ToggleChatPane">
                <span>Chat</span>
            </button>
        }
        else
        {
            <aside class="editor-chat-pane">
                <button type="button"
                        class="editor-pane-collapse editor-pane-collapse--left"
                        title="Collapse Editor Chat"
                        aria-label="Collapse Editor Chat"
                        @onclick="ToggleChatPane">
                    &lsaquo;
                </button>
                <EditorChatPanel ProjectId="Project.Id"
                                 CurrentChapterId="_activeChapterId"
                                 ContextRefreshSignal="_contextRefreshSignal"
                                 ReviewRefreshSignal="_reviewRefreshSignal"
                                 OnAiTurnStarting="OnAiTurnStartingAsync"
                                 OnAiTurnCompleted="OnAiTurnCompletedAsync"
                                 OnAiChangesApplied="OnAiChangesAppliedAsync"
                                 OnActiveChapterBodyChangesReady="OpenReviewForActiveChapterChangesAsync" />
            </aside>
        }

        <section class="@EditorPanelClass()">
            <div class="chapter-header">
                @if (_editingTitle)
                {
                    <input class="form-control chapter-title-input"
                           value="@_titleDraft"
                           @ref="_titleInput"
                           @oninput="@(e => _titleDraft = e.Value?.ToString() ?? string.Empty)"
                           @onkeydown="OnTitleKeyDown"
                           @onblur="CommitTitleAsync" />
                }
                else
                {
                    <button type="button" class="chapter-title-btn"
                            @onclick="ToggleMenu">
                        <span>@_current.Title</span>
                        <span class="caret">▾</span>
                    </button>

                    @if (_menuOpen)
                    {
                        <div class="chapter-menu" @onclick:stopPropagation="true">
                            @foreach (var grp in GroupedChapters())
                            {
                                <div class="chapter-menu-group-label">@grp.label</div>
                                @foreach (var c in grp.chapters)
                                {
                                    <a class="chapter-menu-item @(c.Id == _current.Id ? "active" : "")"
                                       href="/projects/@Project.Slug/editor/@c.Id"
                                       @onclick="CloseMenu">@c.Title</a>
                                }
                            }
                        </div>
                    }
                }

                <button type="button" class="btn btn-sm btn-outline-secondary chapter-icon-btn"
                        title="Edit title" @onclick="StartEditTitle">✎</button>
                <button type="button" class="btn btn-sm btn-outline-secondary chapter-icon-btn"
                        title="New chapter" @onclick="CreateAndGoToOutlineAsync">+</button>

                <div class="small chapter-metrics" title="@ChapterMetricsTitle()">
                    @ChapterMetricsText()
                </div>

                <div class="ms-auto small index-status">
                    @SaveStatusText()
                </div>
            </div>

            <div class="chapter-mode-bar" role="group" aria-label="Chapter mode">
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Edit)"
                        aria-pressed="@(_mode == EditorMode.Edit)"
                        @onclick="() => SetModeAsync(EditorMode.Edit)">Edit</button>
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Read)"
                        aria-pressed="@(_mode == EditorMode.Read)"
                        @onclick="() => SetModeAsync(EditorMode.Read)">Read</button>
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Review)"
                        aria-pressed="@(_mode == EditorMode.Review)"
                        @onclick="() => SetModeAsync(EditorMode.Review)">Review</button>
            </div>

            <div class="@ChapterEditorClass()">
                <div class="@EditSurfaceClass()">
                    <div @ref="_gutterRef" class="line-gutter" aria-hidden="true"></div>
                    <textarea @ref="_bodyTextarea"
                              class="@ChapterBodyClass()"
                              readonly="@EditorReadOnly"
                              placeholder="Start writing your chapter..."></textarea>
                </div>

                @if (_mode == EditorMode.Review)
                {
                    <div class="chapter-review-surface" @ref="_reviewSurfaceRef" role="region" aria-label="Review staged chapter changes">
                        @if (_reviewLoading)
                        {
                            <div class="chapter-review-empty"><em>Loading staged changes...</em></div>
                        }
                        else if (_reviewProjection is null)
                        {
                            <div class="chapter-review-empty"><em>No chapter selected.</em></div>
                        }
                        else
                        {
                            @if (!_reviewProjection.HasChanges)
                            {
                                <div class="chapter-review-notice">No pending staged chapter-body changes for this chapter.</div>
                            }
                            else
                            {
                                <div class="chapter-review-toolbar">
                                    <div class="chapter-review-summary">
                                        <strong>@_reviewProjection.PendingChangeCount</strong>
                                        pending line change@(_reviewProjection.PendingChangeCount == 1 ? string.Empty : "s")
                                    </div>
                                    <div class="chapter-review-toolbar-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_reviewBusy || _reviewProjection.Blocks.Count == 0)"
                                                @onclick="GoToNextReviewBlockAsync">
                                            Next change
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                disabled="@_reviewBusy"
                                                @onclick="KeepAllActiveChapterChangesAsync">
                                            Keep all chapter changes
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <div class="chapter-review-error">
                                        <span>@_reviewError</span>
                                        <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" @onclick="() => _reviewError = null"></button>
                                    </div>
                                }

                                <div class="chapter-review-scroll-rail" aria-label="Chapter body change locations">
                                    @foreach (var block in _reviewProjection.Blocks)
                                    {
                                        <button type="button"
                                                class="@ReviewRailMarkerClass(block)"
                                                style="@RailMarkerStyle(block)"
                                                title="@block.Title"
                                                aria-label="@block.Title"
                                                @onclick="() => ExpandAndScrollReviewBlockAsync(block.Id)">
                                        </button>
                                    }
                                </div>
                            }

                            <div class="chapter-review-lines">
                                @foreach (var line in _reviewProjection.Lines)
                                {
                                    @foreach (var block in ReviewBlocksBeforeLine(line.LineNumber))
                                    {
                                        <article class="review-block" data-review-block="@block.Id" @key="block.Id">
                                            <header class="review-block-header">
                                                <div class="review-block-title-wrap">
                                                    <div class="review-block-title">@block.Title</div>
                                                    <div class="review-block-summary">@block.Summary</div>
                                                </div>
                                                <div class="review-block-actions">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => ToggleReviewBlockAsync(block.Id)">
                                                        Hide
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => KeepReviewBlockAsync(block)">
                                                        Keep
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => RejectReviewBlockAsync(block)">
                                                        Reject
                                                    </button>
                                                    @if (block.CanEdit)
                                                    {
                                                        @if (IsEditingReviewBlock(block))
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="() => SaveReviewBlockEditAsync(block)">
                                                                Save edit
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="CancelReviewBlockEdit">
                                                                Cancel
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="() => BeginReviewBlockEdit(block)">
                                                                Edit
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </header>

                                            @if (IsRejectingReviewBlock(block))
                                            {
                                                <div class="review-reject-box">
                                                    <label for="@($"review-reject-{block.Id}")">Optional rejection note</label>
                                                    <textarea id="@($"review-reject-{block.Id}")"
                                                              class="form-control"
                                                              rows="2"
                                                              placeholder="Tell the assistant what to correct next time..."
                                                              value="@_reviewRejectionMessage"
                                                              @oninput="args => _reviewRejectionMessage = args.Value?.ToString() ?? string.Empty"></textarea>
                                                    <div class="review-reject-actions">
                                                        <button type="button"
                                                                class="btn btn-sm btn-danger"
                                                                disabled="@_reviewBusy"
                                                                @onclick="() => ConfirmRejectReviewBlockAsync(block)">
                                                            Reject line
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary"
                                                                disabled="@_reviewBusy"
                                                                @onclick="CancelRejectReviewBlock">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            @if (IsEditingReviewBlock(block))
                                            {
                                                <textarea class="form-control review-block-editor"
                                                          rows="2"
                                                          value="@(_reviewBlockEdit?.Text ?? string.Empty)"
                                                          @oninput="args => UpdateReviewBlockEditText(args.Value?.ToString() ?? string.Empty)"></textarea>
                                            }
                                            else
                                            {
                                                <div class="review-block-diff">
                                                    @foreach (var row in ReviewBlockDisplayRows(block))
                                                    {
                                                        <div class="@ReviewDiffRowClass(row)">
                                                            <span class="review-diff-line-number">@ReviewDiffLineNumber(row)</span>
                                                            <span class="review-diff-marker">@row.Marker</span>
                                                            <span class="review-diff-line-text">@RenderDiffSegments(row, block.Hunk.Rows)</span>
                                                            <span class="review-diff-spacer"></span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </article>
                                    }

                                    @if (ShouldRenderReviewLine(line))
                                    {
                                        <div class="@ReviewLineClass(line)" @key="line.LineNumber" data-review-line="@line.LineNumber">
                                            <span class="review-line-number">@line.LineNumber.ToString(_reviewProjection.LineNumberFormat)</span>
                                            <span class="@ReviewStripClass(line)" title="@line.MarkerTitle" aria-hidden="true">
                                                @if (line.HasDeletionMarker)
                                                {
                                                    <span class="review-strip-dot review-strip-dot--removed"></span>
                                                }
                                                @if (line.IsAddedOrChanged)
                                                {
                                                    <span class="review-strip-dot review-strip-dot--added"></span>
                                                }
                                            </span>
                                            <span class="review-line-text">@RenderReviewLine(line)</span>
                                            <span class="review-line-actions">
                                                @if (line.PrimaryBlockId is { } blockId)
                                                {
                                                    <button type="button"
                                                            class="@ReviewLineActionClass(blockId)"
                                                            title="Review this staged change inline"
                                                            @onclick="() => ToggleReviewBlockAsync(blockId)">
                                                        Review
                                                    </button>
                                                }
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        @if (_rightPaneCollapsed)
        {
            <button type="button"
                    class="editor-pane-tab editor-pane-tab--right"
                    title="Open Assistant Memory and Search"
                    aria-label="Open Assistant Memory and Search"
                    @onclick="ToggleRightPane">
                <span>Memory</span>
            </button>
        }
        else
        {
            <aside class="@EditorSidePaneClass()">
                <button type="button"
                        class="editor-pane-collapse editor-pane-collapse--right"
                        title="Collapse Assistant Memory and Search"
                        aria-label="Collapse Assistant Memory and Search"
                        @onclick="ToggleRightPane">
                    &rsaquo;
                </button>

                <section class='@(PanelClass("panel-context", _contextFeedOpen))'>
                    <h6 class="panel-title">
                        <button type="button"
                                class="panel-title-toggle"
                                title='@(PanelToggleTitle("Assistant Memory", _contextFeedOpen))'
                                aria-expanded="@_contextFeedOpen"
                                aria-controls="context-feed-panel-content"
                                @onclick="ToggleContextFeed">
                            <span class="caret">@PanelCaret(_contextFeedOpen)</span>
                            <span class="panel-title-text">Assistant Memory</span>
                        </button>
                    </h6>
                    <div id="context-feed-panel-content"
                         class="@PanelContentClass(_contextFeedOpen)"
                         aria-hidden="@AriaHidden(!_contextFeedOpen)">
                        <ContextFeedPanel @ref="_contextPanel"
                                          Project="Project"
                                          CurrentChapter="_current"
                                          OnContextChanged="OnContextChangedAsync" />
                    </div>
                </section>

                <section class='@(PanelClass("panel-recommendations", _recommendedContextOpen))'>
                    <h6 class="panel-title">
                        <button type="button"
                                class="panel-title-toggle"
                                title='@(PanelToggleTitle("Search", _recommendedContextOpen))'
                                aria-expanded="@_recommendedContextOpen"
                                aria-controls="recommended-context-panel-content"
                                @onclick="ToggleRecommendedContext">
                            <span class="caret">@PanelCaret(_recommendedContextOpen)</span>
                            <span class="panel-title-text">Search</span>
                        </button>
                    </h6>
                    <div id="recommended-context-panel-content"
                         class="@PanelContentClass(_recommendedContextOpen)"
                         aria-hidden="@AriaHidden(!_recommendedContextOpen)">
                        <RecommendedContextPanel ProjectId="Project.Id"
                                                 ChapterId="_activeChapterId"
                                                 RefreshSignal="_contextRefreshSignal"
                                                 OnChanged="OnContextChangedAsync" />
                    </div>
                </section>
            </aside>
        }
    </div>

}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [Parameter] public Guid? ChapterId { get; set; }

    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private readonly DotNetObjectReference<EditorContent> _selfRef;

    private List<Chapter> _chapters = [];
    private List<Act> _acts = [];
    private Chapter? _current;
    private bool _loading = true;
    private Guid? _loadedProjectId;
    private Guid? _activeChapterId;
    private bool _restoreChapterAfterRender;
    private Guid? _pendingRememberChapterId;

    private bool _editingTitle;
    private string _titleDraft = string.Empty;
    private ElementReference _titleInput;
    private bool _focusTitleNext;

    private bool _menuOpen;
    private bool _recommendedContextOpen = true;
    private bool _contextFeedOpen = true;
    private EditorMode _mode = EditorMode.Edit;
    private bool _chatPaneCollapsed;
    private bool _rightPaneCollapsed;

    private ElementReference _bodyTextarea;
    private ElementReference _gutterRef;
    private ElementReference _reviewSurfaceRef;
    private IJSObjectReference? _editorModule;
    private IJSObjectReference? _editorHandle;

    private SaveState _saveState = SaveState.Idle;
    private DateTime? _lastSavedAt;
    private string? _saveError;

    private IDisposable? _navHandlerRegistration;

    private bool _chapterLocked;
    private ContextFeedPanel? _contextPanel;
    private int _contextRefreshSignal;
    private int _reviewRefreshSignal;
    private int _chapterWordCount;
    private int _chapterTokenCount;
    private bool _chapterTokenIsExact = true;
    private bool _reviewLoading;
    private ReviewProjection? _reviewProjection;
    private IReadOnlyList<AiChangeBatch> _reviewPendingBatches = [];
    private readonly HashSet<string> _expandedReviewBlockIds = new(StringComparer.Ordinal);
    private string? _activeReviewBlockId;
    private string? _pendingReviewScrollBlockId;
    private string? _reviewError;
    private bool _reviewBusy;
    private ReviewBlockEdit? _reviewBlockEdit;
    private string? _rejectingReviewBlockId;
    private string _reviewRejectionMessage = string.Empty;

    private bool EditorReadOnly => _chapterLocked || _mode == EditorMode.Review;
    private static readonly JsonSerializerOptions ChangePayloadJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    public EditorContent()
    {
        _selfRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) return;

        if (_loadedProjectId != Project.Id)
        {
            _loadedProjectId = Project.Id;
            _loading = true;
            _current = null;
            _activeChapterId = null;
            _restoreChapterAfterRender = false;
            _pendingRememberChapterId = null;
            _chapters = (await Chapters.ListAsync(Project.Id)).ToList();
            _acts = (await Acts.ListAsync(Project.Id)).ToList();
            _loading = false;
        }

        if (_chapters.Count == 0)
        {
            _current = null;
            _activeChapterId = null;
            _restoreChapterAfterRender = false;
            _pendingRememberChapterId = null;
            UpdateChapterMetrics(string.Empty);
            return;
        }

        Guid targetId;
        if (ChapterId is { } cid && _chapters.Any(c => c.Id == cid))
        {
            targetId = cid;
        }
        else if (ChapterId is null)
        {
            if (_activeChapterId is { } activeId && _chapters.Any(c => c.Id == activeId))
            {
                Nav.NavigateTo($"/projects/{Project.Slug}/editor/{activeId}", replace: true);
                return;
            }

            _current = null;
            _restoreChapterAfterRender = true;
            return;
        }
        else
        {
            var first = _chapters[0];
            Nav.NavigateTo($"/projects/{Project.Slug}/editor/{first.Id}", replace: true);
            return;
        }

        _restoreChapterAfterRender = false;
        if (_activeChapterId == targetId)
        {
            _pendingRememberChapterId = targetId;
            return;
        }

        // Switching chapter: flush pending save for the previous chapter first.
        if (_activeChapterId is not null)
        {
            await FlushAsync();
        }

        _activeChapterId = targetId;
        _current = _chapters.First(c => c.Id == targetId);
        UpdateChapterMetrics(_current.Body);
        _saveState = SaveState.Idle;
        _saveError = null;
        _pendingRememberChapterId = targetId;

        await InvokeEditorVoidAsync("setValue", _current.Body);
        if (_mode == EditorMode.Review)
        {
            await RefreshReviewChangesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _navHandlerRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
        }

        if (Project is not null && (_restoreChapterAfterRender || _current is not null || _pendingRememberChapterId is not null))
        {
            await EnsureEditorModuleAsync();
        }

        if (_restoreChapterAfterRender)
        {
            await RestoreRememberedChapterAsync();
            return;
        }

        if (_focusTitleNext)
        {
            _focusTitleNext = false;
            try { await _titleInput.FocusAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }

        if (_current is not null && _editorModule is not null && _editorHandle is null)
        {
            try
            {
                _editorHandle = await _editorModule.InvokeAsync<IJSObjectReference>(
                    "attach",
                    new { textarea = _bodyTextarea, gutter = _gutterRef },
                    _selfRef, 1000, _current.Body);
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }

        if (_pendingRememberChapterId is { } chapterId)
        {
            await RememberSelectedChapterAsync(chapterId);
        }

        if (_pendingReviewScrollBlockId is { } blockId && _editorModule is not null)
        {
            try
            {
                var anchorLine = _reviewProjection?.Blocks.FirstOrDefault(block => block.Id == blockId)?.AnchorLine ?? 1;
                await _editorModule.InvokeVoidAsync("scrollReviewBlock", _reviewSurfaceRef, blockId, anchorLine);
                _pendingReviewScrollBlockId = null;
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (JSException)
            {
                _pendingReviewScrollBlockId = null;
            }
        }
    }

    private async Task EnsureEditorModuleAsync()
    {
        if (_editorModule is not null) return;

        try
        {
            _editorModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Projects/EditorContent.razor.js");
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }

    private async Task RestoreRememberedChapterAsync()
    {
        if (Project is null || _editorModule is null || _chapters.Count == 0) return;

        _restoreChapterAfterRender = false;
        var targetId = _chapters[0].Id;

        try
        {
            var remembered = await _editorModule.InvokeAsync<string?>(
                "getLastEditorChapterId",
                Project.Id.ToString("N"));

            if (!string.IsNullOrWhiteSpace(remembered)
                && Guid.TryParse(remembered, out var rememberedId)
                && _chapters.Any(c => c.Id == rememberedId))
            {
                targetId = rememberedId;
            }
        }
        catch (JSDisconnectedException)
        {
            _restoreChapterAfterRender = true;
            return;
        }
        catch (OperationCanceledException)
        {
            _restoreChapterAfterRender = true;
            return;
        }
        catch (JSException) { }

        Nav.NavigateTo($"/projects/{Project.Slug}/editor/{targetId}", replace: true);
    }

    private async Task RememberSelectedChapterAsync(Guid chapterId)
    {
        if (Project is null || _editorModule is null)
        {
            _pendingRememberChapterId = chapterId;
            return;
        }

        try
        {
            await _editorModule.InvokeVoidAsync(
                "setLastEditorChapterId",
                Project.Id.ToString("N"),
                chapterId.ToString());
            _pendingRememberChapterId = null;
        }
        catch (JSDisconnectedException)
        {
            _pendingRememberChapterId = chapterId;
        }
        catch (OperationCanceledException)
        {
            _pendingRememberChapterId = chapterId;
        }
        catch (JSException)
        {
            _pendingRememberChapterId = null;
        }
    }

    [JSInvokable]
    public async Task OnBodyDebounced(string body)
    {
        if (_current is null || _activeChapterId is null) return;
        await SaveBodyAsync(_activeChapterId.Value, body);
    }

    private async Task SaveBodyAsync(Guid chapterId, string body)
    {
        await _saveGate.WaitAsync();
        try
        {
            _saveState = SaveState.Saving;
            _saveError = null;
            await InvokeAsync(StateHasChanged);

            var updated = await Chapters.UpdateAsync(chapterId, body: body);
            if (_current is not null && _current.Id == chapterId)
            {
                _current.Body = body;
                _current.VectorIndexState = updated.VectorIndexState;
                _current.VectorIndexError = updated.VectorIndexError;
                _current.VectorIndexedAt = updated.VectorIndexedAt;
                UpdateChapterMetrics(body);
            }

            if (updated.VectorIndexState == VectorIndexState.Failed)
            {
                _saveState = SaveState.IndexFailed;
                _saveError = updated.VectorIndexError;
            }
            else
            {
                _saveState = SaveState.Saved;
            }

            _lastSavedAt = DateTime.Now;

            await RefreshContextSurfacesAsync();
        }
        catch (Exception ex)
        {
            _saveState = SaveState.SaveFailed;
            _saveError = ex.Message;
        }
        finally
        {
            _saveGate.Release();
            try { await InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task FlushAsync()
    {
        await InvokeEditorVoidAsync("flush");
    }

    private async Task InvokeEditorVoidAsync(string identifier, params object?[] args)
    {
        if (_editorHandle is null) return;

        try
        {
            await _editorHandle.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext ctx)
    {
        await FlushAsync();
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private string EditorGridClass()
    {
        var classes = "editor-grid";
        if (_mode is EditorMode.Read or EditorMode.Review)
        {
            classes += " editor-grid--focus";
        }

        if (_chatPaneCollapsed)
        {
