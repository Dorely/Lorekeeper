    private async Task ResolveReviewBlockAsync(
        ReviewBlock block,
        ChapterBodyReviewLineAction action,
        string? editedText = null,
        string? rejectionMessage = null)
    {
        if (_historicalReview is not null)
        {
            _reviewError = "Historical review is read-only. Use Undo to restore its approved parent value.";
            return;
        }

        if (block.ContestCandidateId is { } candidateId)
        {
            var contestRequest = new ContestCandidateReviewLineResolution(
                candidateId,
                block.Id,
                block.PairId,
                block.OldRow?.OldLineNumber,
                block.NewRow?.NewLineNumber,
                block.OldRow?.Text,
                block.NewRow?.Text,
                action,
                editedText);

            await RunReviewActionAsync(
                () => Chat.ResolveContestCandidateLineAsync(Project!.Id, _current!.Id, contestRequest),
                clearExpandedBlocks: false,
                reconcileCurrentChapter: false);
            return;
        }

        if (Project is null
            || _reviewView is not { Comparison.IsIdentical: false, Token: { } token })
        {
            _reviewError = "This historical comparison cannot be changed. Open the current pending review first.";
            return;
        }

        var blockIds = ReviewBlockStableIds(block);
        if (blockIds.Count == 0)
        {
            _reviewError = "This change does not map to a stable manuscript block and cannot be resolved selectively.";
            return;
        }

        var target = new ProjectVersionReviewTarget(_current!.Id, _contentTarget);
        if (action == ChapterBodyReviewLineAction.Edit)
        {
            if (blockIds.Count != 1 || editedText is null)
            {
                _reviewError = "This text change does not map to one editable manuscript block.";
                return;
            }

            await RunReviewActionAsync(
                () => VersionHistory.EditReviewBlockAsync(
                    Project.Id,
                    target,
                    blockIds.Single(),
                    editedText,
                    token),
                clearExpandedBlocks: true,
                publishReviewStateChanged: false);
            return;
        }

        var message = action == ChapterBodyReviewLineAction.Keep
            ? "Approved selected manuscript block"
            : string.IsNullOrWhiteSpace(rejectionMessage)
                ? "Undid selected manuscript block"
                : $"Undid selected manuscript block: {rejectionMessage.Trim()}";
        await RunReviewActionAsync(
            action == ChapterBodyReviewLineAction.Keep
                ? () => VersionHistory.CreateReviewApprovalForBlocksAsync(
                    Project.Id,
                    target,
                    blockIds,
                    token,
                    message,
                    requestKey: $"review-block-approval:{token.CurrentContentHash}:{string.Join(',', blockIds.Order(StringComparer.Ordinal))}")
                : () => VersionHistory.RestoreReviewBlocksAsync(
                    Project.Id,
                    target,
                    blockIds,
                    token,
                    message),
            clearExpandedBlocks: action != ChapterBodyReviewLineAction.Keep,
            reconcileCurrentChapter: action != ChapterBodyReviewLineAction.Keep,
            publishReviewStateChanged: false);
    }

