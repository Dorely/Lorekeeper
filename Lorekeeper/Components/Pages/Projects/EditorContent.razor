    private async Task SynchronizeAnnotationsAsync(ManuscriptAnnotationRail.AnnotationChange change)
    {
        if (!IsCurrentAnnotationIdentity(change.ProjectId, change.ChapterId, change.ContentTarget))
            return;

        var bodyEditor = _bodyEditor;
        if (bodyEditor is not null)
            await bodyEditor.SetAnnotationsAsync(change.Annotations);
        if (!IsCurrentAnnotationIdentity(change.ProjectId, change.ChapterId, change.ContentTarget))
            return;

        _readPreview?.SetAnnotations(change.Annotations);
        if (!IsCurrentAnnotationIdentity(change.ProjectId, change.ChapterId, change.ContentTarget))
            return;

        _annotationRefreshSignal++;
        await RefreshContextSurfacesAsync();
    }

    private bool IsCurrentAnnotationIdentity(
        Guid projectId,
        Guid chapterId,
        EditorContentTarget contentTarget) =>
        Project?.Id == projectId
        && _activeChapterId == chapterId
        && _contentTarget == contentTarget;

