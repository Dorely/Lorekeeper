    private EditorMode ResolveCarriedMode(EditorMode previousMode) => previousMode switch
    {
        EditorMode.Review => EditorMode.Review,
        EditorMode.Read => EditorMode.Read,
        EditorMode.Edit => CurrentChapterContainsOnlyDesignedPages ? EditorMode.Pages : EditorMode.Edit,
        EditorMode.Pages => DesignedPageIds.Count > 0 ? EditorMode.Pages : EditorMode.Edit,
        _ => EditorMode.Edit,
    };

    private bool CurrentChapterContainsOnlyDesignedPages
    {
        get
        {
            if (_editorDocument is not { } document) return false;
            try
            {
                var content = ManuscriptCodec.Deserialize(
                    document.ManuscriptJson,
                    document.ChapterId,
                    document.ManuscriptRevision).Content;
                return content.Count > 0
                    && content.All(block => block.Type == ManuscriptBlockType.DesignedPage
                        && block.PageCompositionId is not null);
            }
            catch (InvalidDataException)
            {
                return false;
            }
        }
    }

