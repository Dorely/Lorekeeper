    private IReadOnlyList<string> ReviewBlockStableIds(ReviewBlock block)
    {
        var ids = new HashSet<string>(StringComparer.Ordinal);
        if (_reviewProjection is { } projection)
        {
            var line = projection.Lines.ElementAtOrDefault(Math.Max(0, block.AnchorLine - 1));
            if (line?.ManuscriptBlockId is { Length: > 0 } currentId)
                ids.Add(currentId);
        }

        var chapter = _reviewView?.Chapters.SingleOrDefault(item =>
            item.ChapterId == _current?.Id && item.ContentTarget == _contentTarget);
        AddBlockIdFromLine(chapter?.Before, block.OldRow?.OldLineNumber, ids);
        AddBlockIdFromLine(chapter?.After, block.NewRow?.NewLineNumber, ids);
        if (FindStructuredBlockIndex(block) is not { } structuredIndex)
            return ids.ToList();

        AddBlockIdFromIndex(chapter?.Before, structuredIndex, ids);
        AddBlockIdFromIndex(chapter?.After, structuredIndex, ids);
        return ids.ToList();
    }

    private static void AddBlockIdFromLine(
        ProjectExportChapter? chapter,
        int? lineNumber,
        ISet<string> ids)
    {
        if (chapter is null || lineNumber is not int line || line < 1)
            return;

        try
        {
            var document = ManuscriptCodec.Deserialize(
                chapter.ManuscriptJson,
                chapter.Id,
                chapter.ManuscriptRevision);
            var body = ManuscriptCodec.ProjectPlainText(document);
            var location = BuildReviewLineLocations(
                    document,
                    body,
                    ChapterFormatting.SplitLines(body))
                .ElementAtOrDefault(line - 1);
            if (location?.BlockId is { Length: > 0 } blockId)
                ids.Add(blockId);
        }
        catch (InvalidDataException)
        {
        }
    }

    private static void AddBlockIdFromIndex(
        ProjectExportChapter? chapter,
        int blockIndex,
        ISet<string> ids)
    {
        if (chapter is null || blockIndex < 1)
            return;

        try
        {
            var document = ManuscriptCodec.Deserialize(
                chapter.ManuscriptJson,
                chapter.Id,
                chapter.ManuscriptRevision);
            if (document.Content.ElementAtOrDefault(blockIndex - 1) is { } block)
                ids.Add(block.Id);
        }
        catch (InvalidDataException)
        {
        }
    }

    private async Task RunReviewActionAsync(
        Func<Task> action,
        bool clearExpandedBlocks,
        bool reconcileCurrentChapter = true,
        bool publishReviewStateChanged = true)
    {
        var actionProjectId = Project?.Id;
        var actionChapterId = _activeChapterId;
        var actionTarget = _contentTarget;
        bool IsCurrentActionContext() =>
            !_disposed
            && Project?.Id == actionProjectId
            && _activeChapterId == actionChapterId
            && _contentTarget == actionTarget;

        var locationIdentity = CurrentManuscriptLocationIdentity();
        var location = await CaptureCurrentLocationAsync();
        if (locationIdentity is not null)
            RememberManuscriptLocation(locationIdentity, location);

        _reviewBusy = true;
        _reviewError = null;
        try
        {
            await action();
            if (IsCurrentActionContext())
            {
                if (publishReviewStateChanged && actionProjectId is { } projectId)
                    HistoryEvents.PublishReviewStateChanged(projectId);
                ClearInlineReviewEditors();
                if (clearExpandedBlocks)
                    _expandedReviewBlockIds.Clear();
            }
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        try
        {
            if (IsCurrentActionContext() && reconcileCurrentChapter)
                await ReconcileCurrentChapterAsync(refreshContextSurfaces: true);
            // Events raised before this point are represented by the refresh
            // that follows. An event arriving during the refresh is retained
            // for one coalesced follow-up after the local action completes.
            if (IsCurrentActionContext())
            {
                _reviewRefreshPending = false;
                await RefreshReviewChangesAsync(showLoadingState: false);
                _reviewRefreshSignal++;
                if (location is not null)
                    QueueManuscriptLocationRestore();
            }
        }
        catch (Exception ex)
        {
            _reviewError = string.IsNullOrWhiteSpace(_reviewError)
                ? ex.Message
                : $"{_reviewError} Review refresh also failed: {ex.Message}";
        }
        finally
        {
            _reviewBusy = false;
            if (!_disposed)
                StateHasChanged();
        }

        if (_reviewRefreshPending && IsCurrentActionContext())
        {
            _reviewRefreshPending = false;
            await RefreshReviewChangesAsync(showLoadingState: false);
            if (!_disposed)
                StateHasChanged();
        }
    }

