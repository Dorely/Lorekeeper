    private async Task RestoreEditorWorkspacePreferencesAsync(Guid projectId)
    {
        var editorModule = _editorModule;
        if (_disposed || editorModule is null) return;

        EditorWorkspacePreferences preferences;
        try
        {
            preferences = await editorModule.InvokeAsync<EditorWorkspacePreferences>(
                "getEditorWorkspacePreferences",
                projectId.ToString("N"));
        }
        catch (JSDisconnectedException) { return; }
        catch (OperationCanceledException) { return; }
        catch (ObjectDisposedException)
        {
            if (!_disposed && ReferenceEquals(_editorModule, editorModule))
                _editorModule = null;
            return;
        }
        catch (JSException)
        {
            preferences = new EditorWorkspacePreferences();
        }

        _rememberedChapterModes.Clear();
        foreach (var (chapterId, mode) in preferences.ChapterModes)
        {
            if (Guid.TryParse(chapterId, out var parsedChapterId)
                && Enum.TryParse<EditorMode>(mode, ignoreCase: true, out var parsedMode))
            {
                _rememberedChapterModes[parsedChapterId] = parsedMode;
            }
        }

        _readFacing = preferences.ReadFacing;
        _chatPaneCollapsed = preferences.ChatCollapsed;
        _rightPaneCollapsed = preferences.MemoryCollapsed;
        _workspacePreferencesProjectId = projectId;
        if (EditionId is null
            && preferences.ContentTarget.StartsWith("Edition:", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(preferences.ContentTarget["Edition:".Length..], out var rememberedEditionId)
            && _enabledEditions.Any(item => item.EditionId == rememberedEditionId)
            && _activeChapterId is Guid activeChapterId)
        {
            Nav.NavigateTo(EditorHref(activeChapterId, rememberedEditionId), replace: true);
            return;
        }
        SelectInitialModeForCurrentChapter();
        await ApplyEditorReadOnlyAsync(EditorReadOnly);
        if (_mode == EditorMode.Review && !ContestReviewActive)
            await RefreshReviewChangesAsync();
    }

