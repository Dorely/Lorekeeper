    private async Task<ManuscriptViewLocation?> CaptureCurrentLocationAsync()
    {
        var identity = CurrentManuscriptLocationIdentity();
        if (identity is null)
            return null;

        ManuscriptViewLocation? location = _mode switch
        {
            EditorMode.Edit when _bodyEditor is not null => await _bodyEditor.CaptureLocationAsync(),
            EditorMode.Read when _readPreview is not null => await _readPreview.CaptureLocationAsync(),
            EditorMode.Review when _editorModule is not null => await CaptureReviewLocationAsync(),
            _ => null,
        };
        return IsCurrentManuscriptLocation(identity) ? location : null;
    }

    private async Task<ManuscriptViewLocation?> CaptureReviewLocationAsync()
