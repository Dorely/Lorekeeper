    private async Task RefreshReviewChangesAsync()
    {
        if (Project is null || _current is null)
        {
            _contestReviewBatches = [];
            _contestReviewProjection = null;
            _reviewPendingBatches = [];
            _reviewProjection = null;
            _reviewLoading = false;
            ResetInlineReviewState();
            return;
        }

        _reviewLoading = true;
        try
        {
            _contestReviewBatches = await Chat.ListCurrentContestBatchesAsync(Project.Id);
            var activeContest = _contestReviewBatches
                .FirstOrDefault(batch => batch.ChapterId == _current.Id && batch.Candidates.Count > 0);
            if (activeContest is not null)
            {
                _mode = EditorMode.Review;
                _reviewPendingBatches = [];
                _reviewProjection = null;
                _contestReviewProjection = BuildContestReviewProjection(activeContest);
                _reviewError = null;
                PruneInlineReviewState();
                return;
            }

            _contestReviewProjection = null;
            await ChangeApproval.PrepareChapterBodyLineReviewAsync(Project.Id, _current.Id);
            _reviewPendingBatches = await Chat.ListPendingChangesAsync(Project.Id);
            _reviewProjection = BuildReviewProjection(_current, _reviewPendingBatches);
            _reviewError = null;
            PruneInlineReviewState();
        }
        catch (Exception ex)
        {
            _contestReviewBatches = await Chat.ListCurrentContestBatchesAsync(Project.Id);
            _contestReviewProjection = null;
            _reviewPendingBatches = await Chat.ListPendingChangesAsync(Project.Id);
            _reviewProjection = BuildReviewProjection(_current, _reviewPendingBatches);
            _reviewError = ex.Message;
            PruneInlineReviewState();
        }
        finally
        {
            _reviewLoading = false;
        }
    }

