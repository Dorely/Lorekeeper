@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Globalization
@using Lorekeeper.ChapterVisuals
@using Lorekeeper.Chapters
@using Lorekeeper.Components.Pages.Projects.Outline
@using Lorekeeper.Context
@using Lorekeeper.EditorChat
@using Lorekeeper.Images
@using Lorekeeper.Models
@using Lorekeeper.Outline
@using Lorekeeper.Tokens
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IChapterService Chapters
@inject IChapterVisualService Visuals
@inject IProjectImageService Images
@inject IActService Acts
@inject IEditorChatService Chat
@inject IAiChangeApprovalService ChangeApproval
@inject ITokenCounter TokenCounter
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<EditorContent> Logger

@if (Project is null)
{
    <p class="text-muted"><em>Loading project…</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading chapters…</em></p>
}
else if (_chapters.Count == 0)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between">
        <span>No chapters yet.</span>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateFirstAsync">Create first chapter</button>
    </div>
}
else if (_current is null)
{
    <p class="text-muted"><em>Loading chapter…</em></p>
}
else
{
    <div class="@EditorGridClass()" @ref="_editorGridRef">
        @if (EffectiveChatPaneCollapsed)
        {
            <button type="button"
                    class="editor-pane-tab editor-pane-tab--left"
                    title="Open Editor Chat"
                    aria-label="Open Editor Chat"
                    @onclick="ToggleChatPane">
                <span>Chat</span>
            </button>
        }
        else
        {
            <aside class="editor-chat-pane">
                <button type="button"
                        class="editor-pane-collapse editor-pane-collapse--left"
                        title="Collapse Editor Chat"
                        aria-label="Collapse Editor Chat"
                        @onclick="ToggleChatPane">
                    &lsaquo;
                </button>
                <EditorChatPanel ProjectId="Project.Id"
                                 CurrentChapterId="_activeChapterId"
                                 ContextRefreshSignal="_contextRefreshSignal"
                                 ReviewRefreshSignal="_reviewRefreshSignal"
                                 OnAiTurnStarting="OnAiTurnStartingAsync"
                                 OnAiTurnCompleted="OnAiTurnCompletedAsync"
                                 OnAiTurnIdle="OnAiTurnIdleAsync"
                                 OnAiChangesApplied="OnAiChangesAppliedAsync"
                                  OnActiveChapterBodyChangesReady="OpenReviewForActiveChapterChangesAsync"
                                  OnContestResultsReady="OpenReviewForContestResultsAsync" />
            </aside>
        }

        <div class='@EditorSplitterClass("chat", EffectiveChatPaneCollapsed)'
             @ref="_chatSplitterRef"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize Editor Chat and chapter columns"
             aria-disabled="@AriaHidden(EffectiveChatPaneCollapsed)"
             tabindex="@(EffectiveChatPaneCollapsed ? -1 : 0)"
             title="Drag to resize Editor Chat. Use arrow keys for precise resizing, or double-click to reset."></div>

        <section class="@EditorPanelClass()">
            <div class="chapter-header">
                @if (_editingTitle)
                {
                    <input class="form-control chapter-title-input"
                           value="@_titleDraft"
                           @ref="_titleInput"
                           @oninput="@(e => _titleDraft = e.Value?.ToString() ?? string.Empty)"
                           @onkeydown="OnTitleKeyDown"
                           @onblur="CommitTitleAsync" />
                }
                else
                {
                    <button type="button" class="chapter-title-btn"
                            @onclick="ToggleMenu">
                        <span>@_current.Title</span>
                        <span class="caret">▾</span>
                    </button>

                    @if (_menuOpen)
                    {
                        <div class="chapter-menu" @onclick:stopPropagation="true">
                            @foreach (var grp in GroupedChapters())
                            {
                                <div class="chapter-menu-group-label">@grp.label</div>
                                @foreach (var c in grp.chapters)
                                {
                                    <a class="chapter-menu-item @(c.Id == _current.Id ? "active" : "")"
                                       href="/projects/@Project.Slug/editor/@c.Id"
                                       @onclick="CloseMenu">@c.Title</a>
                                }
                            }
                        </div>
                    }
                }

                <button type="button" class="btn btn-sm btn-outline-secondary chapter-icon-btn"
                        title="Edit title" @onclick="StartEditTitle">✎</button>
                <button type="button" class="btn btn-sm btn-outline-secondary chapter-icon-btn"
                        title="New chapter" @onclick="CreateAndGoToOutlineAsync">+</button>

                <select class="form-select form-select-sm chapter-visual-mode"
                        title="Chapter visual mode"
                        disabled="@LayoutControlsLocked"
                        value="@CurrentVisualMode().ToString()"
                        @onchange="ChangeVisualModeAsync">
                    <option value="@ChapterVisualMode.Prose">Prose</option>
                    <option value="@ChapterVisualMode.IllustratedProse">Illustrated prose</option>
                    <option value="@ChapterVisualMode.PicturePage">Picture page</option>
                </select>

                @if (ShowPageLayoutSelector)
                {
                    <select class="form-select form-select-sm chapter-page-layout"
                            title="Page layout"
                            disabled="@LayoutControlsLocked"
                            value="@CurrentPageLayoutKind().ToString()"
                            @onchange="ChangePageLayoutKindAsync">
                        <option value="@ChapterPageLayoutKind.SinglePortrait">Single portrait</option>
                        <option value="@ChapterPageLayoutKind.SingleLandscape">Single landscape</option>
                        <option value="@ChapterPageLayoutKind.DoublePortrait">Double portrait</option>
                        <option value="@ChapterPageLayoutKind.DoubleLandscape">Double landscape</option>
                    </select>
                }

                <div class="small chapter-metrics" title="@ChapterMetricsTitle()">
                    @ChapterMetricsText()
                </div>

                <div class="ms-auto small index-status">
                    @SaveStatusText()
                </div>
            </div>

            <div class="chapter-mode-bar" role="group" aria-label="Chapter mode">
                @if (!IsPicturePageChapter)
                {
                    <button type="button"
                            class="@ModeButtonClass(EditorMode.Edit)"
                            disabled="@ContestReviewActive"
                            aria-pressed="@(_mode == EditorMode.Edit)"
                            @onclick="() => SetModeAsync(EditorMode.Edit)">Edit</button>
                }
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Read)"
                        disabled="@ContestReviewActive"
                        aria-pressed="@(_mode == EditorMode.Read)"
                        @onclick="() => SetModeAsync(EditorMode.Read)">Read</button>
                @if (CanUseLayoutMode)
                {
                    <button type="button"
                            class="@ModeButtonClass(EditorMode.Layout)"
                            disabled="@ContestReviewActive"
                            aria-pressed="@(_mode == EditorMode.Layout)"
                            @onclick="() => SetModeAsync(EditorMode.Layout)">Layout</button>
                }
                <button type="button"
                        class="@ModeButtonClass(EditorMode.Review)"
                        aria-pressed="@(_mode == EditorMode.Review)"
                        @onclick="() => SetModeAsync(EditorMode.Review)">Review</button>
            </div>

            <div class="@ChapterEditorClass()">
                @if (!IsPicturePageChapter && _editorDocument is { } editorDocument)
                {
                    <ChapterBodyEditor @key="EditorKey(editorDocument)"
                                       @ref="_bodyEditor"
                                       ChapterId="@editorDocument.ChapterId"
                                       InitialBody="@editorDocument.Body"
                                       IsVisible="@(_mode == EditorMode.Edit)"
                                       IsReadOnly="EditorReadOnly"
                                       SaveAsync="SaveBodyAsync" />
                }

                @if (_mode is EditorMode.Read or EditorMode.Layout && _visualState is not null)
                {
                    <PagedChapterViewer State="_visualState"
                                        Images="_projectImages"
                                        ProjectId="Project.Id"
                                        IsEditable="@(_mode == EditorMode.Layout)"
                                        IsLocked="@LayoutControlsLocked"
                                        OnImagesChanged="OnViewerImagesChangedAsync"
                                        OnOpenImages="OpenImagesModal"
                                        OnChanged="OnVisualStateChangedAsync" />
                }

                @if (_mode == EditorMode.Review)
                {
                    <div class="chapter-review-surface" @ref="_reviewSurfaceRef" role="region" aria-label="Review staged chapter changes">
                        @if (_reviewLoading)
                        {
                            <div class="chapter-review-empty"><em>Loading staged changes...</em></div>
                        }
                        else if (_contestReviewProjection is not null)
                        {
                            <div class="contest-review-inline" role="region" aria-label="Contest candidate review">
                                <div class="contest-review-inline-toolbar">
                                    <div class="contest-review-inline-summary">
                                        <strong>Contest Review</strong>
                                        <span>@_contestReviewProjection.Candidates.Count candidate@(_contestReviewProjection.Candidates.Count == 1 ? string.Empty : "s")</span>
                                    </div>
                                    <div class="contest-review-inline-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_reviewBusy || _contestReviewProjection.Blocks.Count == 0)"
                                                @onclick="GoToNextReviewBlockAsync">
                                            Next change
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running)"
                                                title="@(_contestReviewProjection.Batch.Status == ContestBatchStatus.Running ? "Wait for all contest candidates to finish before ending Contest Review." : "End Contest Review and keep the current accepted chapter text.")"
                                                @onclick="FinishContestReviewAsync">
                                            Finish contest
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <div class="chapter-review-error">
                                        <span>@_reviewError</span>
                                        <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" @onclick="() => _reviewError = null"></button>
                                    </div>
                                }

                                <div class="contest-review-columns">
                                    @foreach (var candidate in _contestReviewProjection.Candidates)
                                    {
                                        <section class="@ContestCandidateColumnClass(candidate)" @key="candidate.CandidateId">
                                            <header class="contest-candidate-header">
                                                <div class="contest-candidate-title-row">
                                                    <div class="contest-candidate-title">@candidate.ProviderName</div>
                                                    <span class="@ContestCandidateStatusClass(candidate)">@ContestCandidateStatusText(candidate.Status)</span>
                                                </div>
                                                <div class="contest-candidate-model">@candidate.ModelName</div>
                                                @if (!string.IsNullOrWhiteSpace(candidate.Summary))
                                                {
                                                    <div class="contest-candidate-summary">@candidate.Summary</div>
                                                }
                                            </header>

                                            <div class="contest-candidate-sticky-action">
                                                <button type="button"
                                                        class="btn btn-sm btn-success contest-keep-all"
                                                        disabled="@(_reviewBusy || !candidate.CanKeepEverything)"
                                                        @onclick="() => KeepContestCandidateAsync(candidate.CandidateId)">
                                                    Keep everything from this contestant
                                                </button>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(candidate.ErrorMessage))
                                            {
                                                <div class="contest-candidate-message contest-candidate-message--error">@candidate.ErrorMessage</div>
                                            }
                                            else if (candidate.Review is null)
                                            {
                                                <div class="contest-candidate-message">@ContestCandidatePlaceholder(candidate)</div>
                                            }
                                            else
                                            {
                                                <div class="contest-candidate-lines">
                                                    @foreach (var line in candidate.Review.Lines)
                                                    {
                                                        @foreach (var block in ReviewBlocksBeforeLine(candidate.Review, line.LineNumber))
                                                        {
                                                            <article class="review-block contest-review-block" data-review-block="@block.Id" @key="block.Id">
                                                                <header class="review-block-header">
                                                                    <div class="review-block-title-wrap">
                                                                        <div class="review-block-title">
                                                                            @block.Title
                                                                            <span class="@ContestDecisionBadgeClass(block)">@ContestDecisionText(block)</span>
                                                                        </div>
                                                                        <div class="review-block-summary">@block.Summary</div>
                                                                    </div>
                                                                    <div class="review-block-actions">
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-outline-primary"
                                                                                disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running || block.HasContestConflict)"
                                                                                title="@ContestBlockActionTitle(block, "Keep")"
                                                                                @onclick="() => KeepReviewBlockAsync(block)">
                                                                            Keep
                                                                        </button>
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-outline-danger"
                                                                                disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running)"
                                                                                @onclick="() => RejectReviewBlockAsync(block)">
                                                                            Reject
                                                                        </button>
                                                                        @if (block.CanEdit)
                                                                        {
                                                                            @if (IsEditingReviewBlock(block))
                                                                            {
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-primary"
                                                                                        disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running || block.HasContestConflict)"
                                                                                        title="@ContestBlockActionTitle(block, "Save edit")"
                                                                                        @onclick="() => SaveReviewBlockEditAsync(block)">
                                                                                    Save edit
                                                                                </button>
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-secondary"
                                                                                        disabled="@_reviewBusy"
                                                                                        @onclick="CancelReviewBlockEdit">
                                                                                    Cancel
                                                                                </button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-secondary"
                                                                                        disabled="@(_reviewBusy || _contestReviewProjection.Batch.Status == ContestBatchStatus.Running || block.HasContestConflict)"
                                                                                        title="@ContestBlockActionTitle(block, "Edit")"
                                                                                        @onclick="() => BeginReviewBlockEdit(block)">
                                                                                    Edit
                                                                                </button>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </header>

                                                                @if (!string.IsNullOrWhiteSpace(block.ContestConflictMessage))
                                                                {
                                                                    <div class="contest-conflict-message">@block.ContestConflictMessage</div>
                                                                }

                                                                @if (IsRejectingReviewBlock(block))
                                                                {
                                                                    <div class="review-reject-box">
                                                                        <label for="@($"review-reject-{block.Id}")">Optional rejection note</label>
                                                                        <textarea id="@($"review-reject-{block.Id}")"
                                                                                  class="form-control"
                                                                                  rows="2"
                                                                                  placeholder="Tell the assistant what to correct next time..."
                                                                                  value="@_reviewRejectionMessage"
                                                                                  @oninput="args => _reviewRejectionMessage = args.Value?.ToString() ?? string.Empty"></textarea>
                                                                        <div class="review-reject-actions">
                                                                            <button type="button"
                                                                                    class="btn btn-sm btn-danger"
                                                                                    disabled="@_reviewBusy"
                                                                                    @onclick="() => ConfirmRejectReviewBlockAsync(block)">
                                                                                Reject line
                                                                            </button>
                                                                            <button type="button"
                                                                                    class="btn btn-sm btn-outline-secondary"
                                                                                    disabled="@_reviewBusy"
                                                                                    @onclick="CancelRejectReviewBlock">
                                                                                Cancel
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @if (IsEditingReviewBlock(block))
                                                                {
                                                                    <textarea class="form-control review-block-editor"
                                                                              rows="2"
                                                                              value="@(_reviewBlockEdit?.Text ?? string.Empty)"
                                                                              @oninput="args => UpdateReviewBlockEditText(args.Value?.ToString() ?? string.Empty)"></textarea>
                                                                }
                                                                else
                                                                {
                                                                    <div class="review-block-diff">
                                                                        @foreach (var row in ReviewBlockDisplayRows(block))
                                                                        {
                                                                            <div class="@ReviewDiffRowClass(row)">
                                                                                <span class="review-diff-line-number">@ReviewDiffLineNumber(row)</span>
                                                                                <span class="review-diff-marker">@row.Marker</span>
                                                                                <span class="review-diff-line-text">@RenderDiffSegments(row, block.Hunk.Rows)</span>
                                                                                <span class="review-diff-spacer"></span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </article>
                                                        }

                                                        @if (ShouldRenderReviewLine(candidate.Review, line))
                                                        {
                                                            <div class="@ReviewLineClass(line)" @key="line.LineNumber" data-review-line="@line.LineNumber">
                                                                <span class="review-line-number">@line.LineNumber.ToString(candidate.Review.LineNumberFormat)</span>
                                                                <span class="@ReviewStripClass(line)" title="@line.MarkerTitle" aria-hidden="true">
                                                                    @if (line.HasDeletionMarker)
                                                                    {
                                                                        <span class="review-strip-dot review-strip-dot--removed"></span>
                                                                    }
                                                                    @if (line.IsAddedOrChanged)
                                                                    {
                                                                        <span class="review-strip-dot review-strip-dot--added"></span>
                                                                    }
                                                                </span>
                                                                <span class="review-line-text">@RenderReviewLine(line)</span>
                                                                <span class="review-line-actions">
                                                                    @if (line.PrimaryBlockId is { } blockId)
                                                                    {
                                                                        <button type="button"
                                                                                class="@ReviewLineActionClass(blockId)"
                                                                                disabled="@_reviewBusy"
                                                                                @onclick="() => ToggleReviewBlockAsync(blockId)">
                                                                            Review
                                                                        </button>
                                                                    }
                                                                </span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                            </div>
                        }
                        else if (_reviewProjection is null)
                        {
                            <div class="chapter-review-empty"><em>No chapter selected.</em></div>
                        }
                        else
                        {
                            @if (!_reviewProjection.HasChanges)
                            {
                                <div class="chapter-review-notice">No pending staged chapter-body changes for this chapter.</div>
                            }
                            else
                            {
                                <div class="chapter-review-toolbar">
                                    <div class="chapter-review-summary">
                                        <strong>@_reviewProjection.PendingChangeCount</strong>
                                        pending line change@(_reviewProjection.PendingChangeCount == 1 ? string.Empty : "s")
                                    </div>
                                    <div class="chapter-review-toolbar-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_reviewBusy || _reviewProjection.Blocks.Count == 0)"
                                                @onclick="GoToNextReviewBlockAsync">
                                            Next change
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                disabled="@_reviewBusy"
                                                @onclick="KeepAllActiveChapterChangesAsync">
                                            Keep all chapter changes
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@_reviewBusy"
                                                @onclick="RejectAllActiveChapterChangesAsync">
                                            Reject all chapter changes
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_reviewError))
                                {
                                    <div class="chapter-review-error">
                                        <span>@_reviewError</span>
                                        <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" @onclick="() => _reviewError = null"></button>
                                    </div>
                                }

                                <div class="chapter-review-scroll-rail" aria-label="Chapter body change locations">
                                    @foreach (var block in _reviewProjection.Blocks)
                                    {
                                        <button type="button"
                                                class="@ReviewRailMarkerClass(block)"
                                                style="@RailMarkerStyle(block)"
                                                title="@block.Title"
                                                aria-label="@block.Title"
                                                @onclick="() => ExpandAndScrollReviewBlockAsync(block.Id)">
                                        </button>
                                    }
                                </div>
                            }

                            <div class="chapter-review-lines">
                                @foreach (var line in _reviewProjection.Lines)
                                {
                                    @foreach (var block in ReviewBlocksBeforeLine(line.LineNumber))
                                    {
                                        <article class="review-block" data-review-block="@block.Id" @key="block.Id">
                                            <header class="review-block-header">
                                                <div class="review-block-title-wrap">
                                                    <div class="review-block-title">@block.Title</div>
                                                    <div class="review-block-summary">@block.Summary</div>
                                                </div>
                                                <div class="review-block-actions">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => ToggleReviewBlockAsync(block.Id)">
                                                        Hide
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => KeepReviewBlockAsync(block)">
                                                        Keep
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            disabled="@_reviewBusy"
                                                            @onclick="() => RejectReviewBlockAsync(block)">
                                                        Reject
                                                    </button>
                                                    @if (block.CanEdit)
                                                    {
                                                        @if (IsEditingReviewBlock(block))
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="() => SaveReviewBlockEditAsync(block)">
                                                                Save edit
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="CancelReviewBlockEdit">
                                                                Cancel
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    disabled="@_reviewBusy"
                                                                    @onclick="() => BeginReviewBlockEdit(block)">
                                                                Edit
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </header>

                                            @if (IsRejectingReviewBlock(block))
                                            {
                                                <div class="review-reject-box">
                                                    <label for="@($"review-reject-{block.Id}")">Optional rejection note</label>
                                                    <textarea id="@($"review-reject-{block.Id}")"
                                                              class="form-control"
                                                              rows="2"
                                                              placeholder="Tell the assistant what to correct next time..."
                                                              value="@_reviewRejectionMessage"
                                                              @oninput="args => _reviewRejectionMessage = args.Value?.ToString() ?? string.Empty"></textarea>
                                                    <div class="review-reject-actions">
                                                        <button type="button"
                                                                class="btn btn-sm btn-danger"
                                                                disabled="@_reviewBusy"
                                                                @onclick="() => ConfirmRejectReviewBlockAsync(block)">
                                                            Reject line
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary"
                                                                disabled="@_reviewBusy"
                                                                @onclick="CancelRejectReviewBlock">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            @if (IsEditingReviewBlock(block))
                                            {
                                                <textarea class="form-control review-block-editor"
                                                          rows="2"
                                                          value="@(_reviewBlockEdit?.Text ?? string.Empty)"
                                                          @oninput="args => UpdateReviewBlockEditText(args.Value?.ToString() ?? string.Empty)"></textarea>
                                            }
                                            else
                                            {
                                                <div class="review-block-diff">
                                                    @foreach (var row in ReviewBlockDisplayRows(block))
                                                    {
                                                        <div class="@ReviewDiffRowClass(row)">
                                                            <span class="review-diff-line-number">@ReviewDiffLineNumber(row)</span>
                                                            <span class="review-diff-marker">@row.Marker</span>
                                                            <span class="review-diff-line-text">@RenderDiffSegments(row, block.Hunk.Rows)</span>
                                                            <span class="review-diff-spacer"></span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </article>
                                    }

                                    @if (ShouldRenderReviewLine(line))
                                    {
                                        <div class="@ReviewLineClass(line)" @key="line.LineNumber" data-review-line="@line.LineNumber">
                                            <span class="review-line-number">@line.LineNumber.ToString(_reviewProjection.LineNumberFormat)</span>
                                            <span class="@ReviewStripClass(line)" title="@line.MarkerTitle" aria-hidden="true">
                                                @if (line.HasDeletionMarker)
                                                {
                                                    <span class="review-strip-dot review-strip-dot--removed"></span>
                                                }
                                                @if (line.IsAddedOrChanged)
                                                {
                                                    <span class="review-strip-dot review-strip-dot--added"></span>
                                                }
                                            </span>
                                            <span class="review-line-text">@RenderReviewLine(line)</span>
                                            <span class="review-line-actions">
                                                @if (line.PrimaryBlockId is { } blockId)
                                                {
                                                    <button type="button"
                                                            class="@ReviewLineActionClass(blockId)"
                                                            title="Review this staged change inline"
                                                            @onclick="() => ToggleReviewBlockAsync(blockId)">
                                                        Review
                                                    </button>
                                                }
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <div class='@EditorSplitterClass("memory", EffectiveRightPaneCollapsed)'
             @ref="_memorySplitterRef"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize chapter and Assistant Memory columns"
             aria-disabled="@AriaHidden(EffectiveRightPaneCollapsed)"
             tabindex="@(EffectiveRightPaneCollapsed ? -1 : 0)"
             title="Drag to resize Assistant Memory. Use arrow keys for precise resizing, or double-click to reset."></div>

        @if (EffectiveRightPaneCollapsed)
        {
            <button type="button"
                    class="editor-pane-tab editor-pane-tab--right"
                    title="Open Assistant Memory and Search"
                    aria-label="Open Assistant Memory and Search"
                    @onclick="ToggleRightPane">
                <span>Memory</span>
            </button>
        }
        else
        {
            <aside class="@EditorSidePaneClass()">
                <button type="button"
                        class="editor-pane-collapse editor-pane-collapse--right"
                        title="Collapse Assistant Memory and Search"
                        aria-label="Collapse Assistant Memory and Search"
                        @onclick="ToggleRightPane">
                    &rsaquo;
                </button>

                <section class='@(PanelClass("panel-context", _contextFeedOpen))'>
                    <h6 class="panel-title">
                        <button type="button"
                                class="panel-title-toggle"
                                title='@(PanelToggleTitle("Assistant Memory", _contextFeedOpen))'
                                aria-expanded="@_contextFeedOpen"
                                aria-controls="context-feed-panel-content"
                                @onclick="ToggleContextFeed">
                            <span class="caret">@PanelCaret(_contextFeedOpen)</span>
                            <span class="panel-title-text">Assistant Memory</span>
                        </button>
                    </h6>
                    <div id="context-feed-panel-content"
                         class="@PanelContentClass(_contextFeedOpen)"
                         aria-hidden="@AriaHidden(!_contextFeedOpen)">
                        <ContextFeedPanel @ref="_contextPanel"
                                          Project="Project"
                                          CurrentChapter="_current"
                                          OnContextChanged="OnContextChangedAsync" />
                    </div>
                </section>

                <section class='@(PanelClass("panel-recommendations", _recommendedContextOpen))'>
                    <h6 class="panel-title panel-title--with-action">
                        <button type="button"
                                class="panel-title-toggle"
                                title='@(PanelToggleTitle("Search", _recommendedContextOpen))'
                                aria-expanded="@_recommendedContextOpen"
                                aria-controls="recommended-context-panel-content"
                                @onclick="ToggleRecommendedContext">
                            <span class="caret">@PanelCaret(_recommendedContextOpen)</span>
                            <span class="panel-title-text">Search</span>
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary panel-title-action"
                                disabled="@(_activeChapterId is null || LayoutControlsLocked)"
                                @onclick="OpenImagesModal">
                            Images
                        </button>
                    </h6>
                    <div id="recommended-context-panel-content"
                         class="@PanelContentClass(_recommendedContextOpen)"
                         aria-hidden="@AriaHidden(!_recommendedContextOpen)">
                        <RecommendedContextPanel ProjectId="Project.Id"
                                                 ChapterId="_activeChapterId"
                                                 RefreshSignal="_contextRefreshSignal"
                                                 OnChanged="OnContextChangedAsync" />
                    </div>
                </section>
            </aside>
        }
    </div>

    <ProjectImagePickerModal ProjectId="Project.Id"
                             ChapterId="_activeChapterId"
                             IsOpen="_imagesModalOpen"
                             CanAddToChapter="@(!LayoutControlsLocked)"
                             OnClose="CloseImagesModal"
                             OnAddToChapter="AddImageToChapterAsync"
                             OnContextChanged="OnContextChangedAsync" />
}

@code {
    [CascadingParameter] public Project? Project { get; set; }
    [Parameter] public Guid? ChapterId { get; set; }

    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private readonly SemaphoreSlim _chapterRefreshGate = new(1, 1);

    private List<Chapter> _chapters = [];
    private List<Act> _acts = [];
    private Chapter? _current;
    private bool _loading = true;
    private Guid? _loadedProjectId;
    private Guid? _activeChapterId;
    private bool _restoreChapterAfterRender;
    private Guid? _pendingRememberChapterId;

    private bool _editingTitle;
    private string _titleDraft = string.Empty;
    private ElementReference _titleInput;
    private bool _focusTitleNext;

    private bool _menuOpen;
    private bool _recommendedContextOpen = true;
    private bool _contextFeedOpen = true;
    private EditorMode _mode = EditorMode.Edit;
    private bool _chatPaneCollapsed;
    private bool _rightPaneCollapsed;

    private ElementReference _reviewSurfaceRef;
    private ElementReference _editorGridRef;
    private ElementReference _chatSplitterRef;
    private ElementReference _memorySplitterRef;
    private IJSObjectReference? _editorModule;
    private IJSObjectReference? _columnLayoutHandle;
    private Guid? _columnLayoutProjectId;
    private bool _disposed;
    private ChapterBodyEditor? _bodyEditor;
    private EditorDocumentState? _editorDocument;

    private SaveState _saveState = SaveState.Idle;
    private DateTime? _lastSavedAt;
    private string? _saveError;

    private IDisposable? _navHandlerRegistration;

    private bool _chapterLocked;
    private ContextFeedPanel? _contextPanel;
    private int _contextRefreshSignal;
    private int _reviewRefreshSignal;
    private ChapterVisualState? _visualState;
    private IReadOnlyList<ProjectImageView> _projectImages = [];
    private bool _imagesModalOpen;
    private string? _layoutError;
    private int _chapterWordCount;
    private int _chapterTokenCount;
    private bool _chapterTokenIsExact = true;
    private bool _reviewLoading;
    private ReviewProjection? _reviewProjection;
    private ContestReviewProjection? _contestReviewProjection;
    private IReadOnlyList<ContestBatch> _contestReviewBatches = [];
    private IReadOnlyList<AiChangeBatch> _reviewPendingBatches = [];
    private readonly HashSet<string> _expandedReviewBlockIds = new(StringComparer.Ordinal);
    private string? _activeReviewBlockId;
    private string? _pendingReviewScrollBlockId;
    private string? _reviewError;
    private bool _reviewBusy;
    private ReviewBlockEdit? _reviewBlockEdit;
    private string? _rejectingReviewBlockId;
    private string _reviewRejectionMessage = string.Empty;

    private bool EditorReadOnly => _chapterLocked || _mode is EditorMode.Read or EditorMode.Layout or EditorMode.Review;
    private bool LayoutControlsLocked => _chapterLocked;
    private bool IsPicturePageChapter => _visualState?.VisualMode == ChapterVisualMode.PicturePage
        || _current?.VisualMode == ChapterVisualMode.PicturePage;
    private bool CanUseLayoutMode => CurrentVisualMode() != ChapterVisualMode.Prose;

    private bool ShowPageLayoutSelector => CurrentVisualMode()
        is ChapterVisualMode.IllustratedProse or ChapterVisualMode.PicturePage;
    private bool ContestReviewActive => _contestReviewProjection is not null;
    private bool EffectiveChatPaneCollapsed => ContestReviewActive || _chatPaneCollapsed;
    private bool EffectiveRightPaneCollapsed => ContestReviewActive || _rightPaneCollapsed;
    private static readonly JsonSerializerOptions ChangePayloadJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
    };
    private static readonly JsonSerializerOptions ContestReviewStateJsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() },
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) return;

        if (_loadedProjectId != Project.Id)
        {
            _loadedProjectId = Project.Id;
            _loading = true;
            _current = null;
            _activeChapterId = null;
            _editorDocument = null;
            _restoreChapterAfterRender = false;
            _pendingRememberChapterId = null;
            _contestReviewBatches = [];
            _contestReviewProjection = null;
            _reviewPendingBatches = [];
            _reviewProjection = null;
            ResetInlineReviewState();
            _projectImages = [];
            _chapters = (await Chapters.ListAsync(Project.Id)).ToList();
            _acts = (await Acts.ListAsync(Project.Id)).ToList();
            _loading = false;
        }

        if (_chapters.Count == 0)
        {
            _current = null;
            _activeChapterId = null;
            _editorDocument = null;
            _restoreChapterAfterRender = false;
            _pendingRememberChapterId = null;
            _contestReviewBatches = [];
            _contestReviewProjection = null;
            _visualState = null;
            _projectImages = [];
            UpdateChapterMetrics(string.Empty);
            return;
        }

        Guid targetId;
        if (ChapterId is { } cid && _chapters.Any(c => c.Id == cid))
        {
            targetId = cid;
        }
        else if (ChapterId is null)
        {
            if (_activeChapterId is { } activeId && _chapters.Any(c => c.Id == activeId))
            {
                Nav.NavigateTo($"/projects/{Project.Slug}/editor/{activeId}", replace: true);
                return;
            }

            _current = null;
            _visualState = null;
            _editorDocument = null;
            _restoreChapterAfterRender = true;
            return;
        }
        else
        {
            var first = _chapters[0];
            Nav.NavigateTo($"/projects/{Project.Slug}/editor/{first.Id}", replace: true);
            return;
        }

        _restoreChapterAfterRender = false;
        if (_activeChapterId == targetId)
        {
            _pendingRememberChapterId = targetId;
            return;
        }

        // Switching chapter: flush pending save for the previous chapter first.
        if (_activeChapterId is not null)
        {
            if (!await FlushAsync())
                return;
        }

        var fresh = await Chapters.ReloadFromStoreAsync(targetId);
        if (fresh is null)
        {
            HandleMissingChapter(targetId);
            return;
        }

        _activeChapterId = targetId;
        _current = fresh;
        ReplaceCachedChapter(fresh);
        InstallEditorDocument(fresh);
        UpdateChapterMetrics(_current.Body);
        _saveState = SaveState.Idle;
        _saveError = null;
        await LoadVisualStateAsync();
        await LoadChapterImagesAsync();
        _pendingRememberChapterId = targetId;

        if (_mode == EditorMode.Review)
        {
            await RefreshReviewChangesAsync();
        }
    }

    private async Task LoadChapterImagesAsync(bool force = false)
    {
        var project = Project;
        var state = _visualState;
        if (project is null || state is null || _mode is not (EditorMode.Read or EditorMode.Layout))
        {
            _projectImages = [];
            return;
        }

        var imageIds = ReferencedImageIds(state);
        if (imageIds.Count == 0)
        {
            _projectImages = [];
            return;
        }

        if (!force && imageIds.ToHashSet().SetEquals(_projectImages.Select(image => image.Id)))
            return;

        _projectImages = [];
        try
        {
            var images = await Images.ListByIdsAsync(project.Id, imageIds);
            if (Project?.Id == project.Id
                && _visualState?.ChapterId == state.ChapterId
                && _mode is EditorMode.Read or EditorMode.Layout)
            {
                _projectImages = images;
            }
        }
        catch (Exception ex)
        {
            _layoutError = ex.Message;
            _projectImages = [];
        }
    }

    private static IReadOnlyList<Guid> ReferencedImageIds(ChapterVisualState state) =>
        (state.VisualMode == ChapterVisualMode.PicturePage
            ? state.PageLayout.Images.Select(image => image.ImageId)
            : state.VisualMode == ChapterVisualMode.IllustratedProse
                ? state.IllustrationLayout.Images.Select(image => image.ImageId)
                : [])
        .Where(imageId => imageId != Guid.Empty)
        .Distinct()
        .ToList();

    private async Task OnViewerImagesChangedAsync()
    {
        await LoadChapterImagesAsync(force: true);
        StateHasChanged();
    }

    private async Task LoadVisualStateAsync()
    {
        if (_current is null)
        {
            _visualState = null;
            return;
        }

        var chapterId = _current.Id;
        try
        {
            var state = await Visuals.GetAsync(chapterId);
            if (_activeChapterId != chapterId || _current?.Id != chapterId)
                return;

            _visualState = state;
            if (_visualState?.VisualMode == ChapterVisualMode.PicturePage && _mode == EditorMode.Edit)
                _mode = EditorMode.Layout;
            else if (_visualState?.VisualMode == ChapterVisualMode.Prose && _mode == EditorMode.Layout)
                _mode = EditorMode.Edit;
        }
        catch (Exception ex)
        {
            if (_activeChapterId != chapterId || _current?.Id != chapterId)
                return;

            _layoutError = ex.Message;
            _visualState = null;
        }
    }

    private async Task ChangeVisualModeAsync(ChangeEventArgs e)
    {
        if (LayoutControlsLocked) return;
        if (_current is null) return;
        if (!Enum.TryParse<ChapterVisualMode>(e.Value?.ToString(), out var mode))
            return;

        if (!await FlushAsync()) return;
        var updated = await Visuals.SetModeAsync(_current.Id, new ChapterVisualModeUpdate(mode));
        await OnVisualStateChangedAsync(updated);
    }

    private async Task ChangePageLayoutKindAsync(ChangeEventArgs e)
    {
        if (LayoutControlsLocked) return;
        if (_current is null) return;
        if (!Enum.TryParse<ChapterPageLayoutKind>(e.Value?.ToString(), out var layoutKind))
            return;

        if (!await FlushAsync()) return;
        var mode = CurrentVisualMode();
        var updated = await Visuals.SetModeAsync(_current.Id, new ChapterVisualModeUpdate(mode, layoutKind));
        await OnVisualStateChangedAsync(updated);
    }

    private async Task OnVisualStateChangedAsync(ChapterVisualState state)
    {
        if (_activeChapterId != state.ChapterId || _current?.Id != state.ChapterId)
            return;

        _visualState = state;
        if (state.VisualMode == ChapterVisualMode.PicturePage && _mode == EditorMode.Edit)
        {
            _mode = EditorMode.Layout;
            await ApplyEditorReadOnlyAsync(EditorReadOnly);
        }
        else if (state.VisualMode == ChapterVisualMode.Prose && _mode == EditorMode.Layout)
        {
            _mode = EditorMode.Edit;
            await ApplyEditorReadOnlyAsync(EditorReadOnly);
        }
        if (_current is not null && _current.Id == state.ChapterId)
        {
            _current.VisualMode = state.VisualMode;
            if (state.VisualMode != ChapterVisualMode.Prose)
                _current.PageLayoutKind = state.PageLayoutKind;
            _current.Body = state.Body;
            var cached = _chapters.FirstOrDefault(chapter => chapter.Id == state.ChapterId);
            if (cached is not null)
                cached.Body = state.Body;
            UpdateChapterMetrics(state.Body);
            SynchronizeExternalEditorDocument(state.ChapterId, state.Body);
        }

        await LoadChapterImagesAsync();
        await RefreshContextSurfacesAsync();
    }

    private void OpenImagesModal()
    {
        if (LayoutControlsLocked) return;
        _imagesModalOpen = true;
    }

    private void CloseImagesModal() => _imagesModalOpen = false;

    private async Task AddImageToChapterAsync(Guid imageId)
    {
        if (LayoutControlsLocked) return;
        if (Project is null || _activeChapterId is not Guid chapterId) return;
        if (!await FlushAsync()) return;
        var result = await Visuals.AddImageToChapterAsync(Project.Id, chapterId, imageId);
        if (_mode != EditorMode.Layout)
            _mode = EditorMode.Layout;
        await OnVisualStateChangedAsync(result.State);
        await ApplyEditorReadOnlyAsync(EditorReadOnly);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (firstRender)
        {
            _navHandlerRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
        }

        if (Project is not null && (_restoreChapterAfterRender || _current is not null || _pendingRememberChapterId is not null))
        {
            await EnsureEditorModuleAsync();
        }

        if (_disposed) return;

        if (_restoreChapterAfterRender)
        {
            await RestoreRememberedChapterAsync();
            return;
        }

        if (_current is not null && Project is not null && _editorModule is not null
            && (_columnLayoutHandle is null || _columnLayoutProjectId != Project.Id))
        {
            await AttachColumnLayoutAsync(Project.Id);
        }

        if (_focusTitleNext)
        {
            _focusTitleNext = false;
            try { await _titleInput.FocusAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }

        if (_pendingRememberChapterId is { } chapterId)
        {
            await RememberSelectedChapterAsync(chapterId);
        }

        var editorModule = _editorModule;
        if (_pendingReviewScrollBlockId is { } blockId && editorModule is not null)
        {
            try
            {
                var anchorLine = CurrentReviewBlocks().FirstOrDefault(block => block.Id == blockId)?.AnchorLine ?? 1;
                await editorModule.InvokeVoidAsync("scrollReviewBlock", _reviewSurfaceRef, blockId, anchorLine);
                _pendingReviewScrollBlockId = null;
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException)
            {
                if (!_disposed && ReferenceEquals(_editorModule, editorModule))
                    _editorModule = null;
            }
            catch (JSException)
            {
                _pendingReviewScrollBlockId = null;
            }
        }
    }

    private async Task EnsureEditorModuleAsync()
    {
        if (_disposed || _editorModule is not null) return;

        try
        {
            var editorModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Projects/EditorContent.razor.js");

            if (_disposed || _editorModule is not null)
            {
                try { await editorModule.DisposeAsync(); } catch { }
                return;
            }

            _editorModule = editorModule;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task AttachColumnLayoutAsync(Guid projectId)
    {
        if (_disposed) return;

        await DisposeColumnLayoutAsync();
        var editorModule = _editorModule;
        if (_disposed || editorModule is null) return;

        try
        {
            var columnLayoutHandle = await editorModule.InvokeAsync<IJSObjectReference>(
                "attachColumnLayout",
                new
                {
                    grid = _editorGridRef,
                    chatSplitter = _chatSplitterRef,
                    memorySplitter = _memorySplitterRef,
                },
                projectId.ToString("N"));

            if (_disposed)
            {
                try { await columnLayoutHandle.DisposeAsync(); } catch { }
                return;
            }

            _columnLayoutHandle = columnLayoutHandle;
            _columnLayoutProjectId = projectId;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException)
        {
            if (!_disposed && ReferenceEquals(_editorModule, editorModule))
                _editorModule = null;
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not initialize Editor column resizing for project {ProjectId}.", projectId);
        }
    }

    private async ValueTask DisposeColumnLayoutAsync()
    {
        var columnLayoutHandle = _columnLayoutHandle;
        _columnLayoutHandle = null;
        _columnLayoutProjectId = null;
        if (columnLayoutHandle is null) return;

        try { await columnLayoutHandle.InvokeVoidAsync("dispose"); } catch { }
        try { await columnLayoutHandle.DisposeAsync(); } catch { }
    }

    private async Task RestoreRememberedChapterAsync()
    {
        var project = Project;
        var editorModule = _editorModule;
        if (_disposed || project is null || editorModule is null || _chapters.Count == 0) return;

        _restoreChapterAfterRender = false;
        var targetId = _chapters[0].Id;

        try
        {
            var remembered = await editorModule.InvokeAsync<string?>(
                "getLastEditorChapterId",
                project.Id.ToString("N"));

            if (!string.IsNullOrWhiteSpace(remembered)
                && Guid.TryParse(remembered, out var rememberedId)
                && _chapters.Any(c => c.Id == rememberedId))
            {
                targetId = rememberedId;
            }
        }
        catch (JSDisconnectedException)
        {
            if (!_disposed)
                _restoreChapterAfterRender = true;
            return;
        }
        catch (OperationCanceledException)
        {
            if (!_disposed)
                _restoreChapterAfterRender = true;
            return;
        }
        catch (ObjectDisposedException)
        {
            if (!_disposed)
            {
                if (ReferenceEquals(_editorModule, editorModule))
                    _editorModule = null;
                _restoreChapterAfterRender = true;
            }
            return;
        }
        catch (JSException) { }

        if (!_disposed)
            Nav.NavigateTo($"/projects/{project.Slug}/editor/{targetId}", replace: true);
    }

    private async Task RememberSelectedChapterAsync(Guid chapterId)
    {
        if (_disposed) return;

        var project = Project;
        var editorModule = _editorModule;
        if (project is null || editorModule is null)
        {
            _pendingRememberChapterId = chapterId;
            return;
        }

        try
        {
            await editorModule.InvokeVoidAsync(
                "setLastEditorChapterId",
                project.Id.ToString("N"),
                chapterId.ToString());
            if (!_disposed)
                _pendingRememberChapterId = null;
        }
        catch (JSDisconnectedException)
        {
            if (!_disposed)
                _pendingRememberChapterId = chapterId;
        }
        catch (OperationCanceledException)
        {
            if (!_disposed)
                _pendingRememberChapterId = chapterId;
        }
        catch (ObjectDisposedException)
        {
            if (!_disposed)
            {
                if (ReferenceEquals(_editorModule, editorModule))
                    _editorModule = null;
                _pendingRememberChapterId = chapterId;
            }
        }
        catch (JSException)
        {
            if (!_disposed)
                _pendingRememberChapterId = null;
        }
    }

    private async Task<bool> SaveBodyAsync(Guid chapterId, string body)
    {
        await _saveGate.WaitAsync();
        try
        {
            _saveState = SaveState.Saving;
            _saveError = null;
            await InvokeAsync(StateHasChanged);

            var updated = await Chapters.UpdateAsync(chapterId, body: body);
            if (_current is not null && _current.Id == chapterId)
            {
                _current = updated;
                ReplaceCachedChapter(updated);
                RecordEditorSave(chapterId, body);
                UpdateChapterMetrics(body);
            }

            if (updated.VectorIndexState == VectorIndexState.Failed)
            {
                _saveState = SaveState.IndexFailed;
                _saveError = updated.VectorIndexError;
            }
            else
            {
                _saveState = SaveState.Saved;
            }

            _lastSavedAt = DateTime.Now;

            await RefreshContextSurfacesAsync();
            return true;
        }
        catch (Exception ex)
        {
            _saveState = SaveState.SaveFailed;
            _saveError = ex.Message;
            return false;
        }
        finally
        {
            _saveGate.Release();
            try { await InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task<bool> FlushAsync()
    {
        if (_bodyEditor is null) return true;
        var flushed = await _bodyEditor.FlushAsync();
        if (!flushed)
        {
            _saveState = SaveState.SaveFailed;
            _saveError ??= "The chapter draft could not be saved.";
        }
        return flushed;
    }

    private async Task ApplyEditorReadOnlyAsync(bool readOnly) =>
        await (_bodyEditor?.ApplyReadOnlyAsync(readOnly) ?? Task.CompletedTask);

    private async ValueTask OnLocationChangingAsync(LocationChangingContext ctx)
    {
        if (!await FlushAsync())
            ctx.PreventNavigation();
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private string EditorGridClass()
    {
        var classes = "editor-grid";
        if (ContestReviewActive)
        {
            classes += " editor-grid--contest-review";
        }

        if (EffectiveChatPaneCollapsed)
        {
            classes += " editor-grid--chat-collapsed";
        }

        if (EffectiveRightPaneCollapsed)
        {
            classes += " editor-grid--right-collapsed";
        }

        return classes;
    }

    private static string EditorSplitterClass(string pane, bool isDisabled) =>
        $"editor-column-splitter editor-column-splitter--{pane}{(isDisabled ? " editor-column-splitter--disabled" : string.Empty)}";

    private string EditorPanelClass() =>
        $"panel panel-editor panel-editor--{_mode.ToString().ToLowerInvariant()}";

    private string ChapterEditorClass()
    {
        var classes = $"chapter-editor chapter-editor--{_mode.ToString().ToLowerInvariant()}";
        if (_chapterLocked)
        {
            classes += " chapter-editor--locked";
        }

        return classes;
    }

    private static EditorDocumentKey EditorKey(EditorDocumentState document) =>
        new(document.ChapterId, document.Revision);

    private ChapterPageLayoutKind CurrentPageLayoutKind() =>
        _visualState?.PageLayoutKind ?? _current?.PageLayoutKind ?? ChapterPageLayoutKind.SinglePortrait;

    private ChapterVisualMode CurrentVisualMode() =>
        _visualState?.VisualMode ?? _current?.VisualMode ?? ChapterVisualMode.Prose;

    private string ModeButtonClass(EditorMode mode) =>
        _mode == mode
            ? "chapter-mode-button active"
            : "chapter-mode-button";

    private async Task SetModeAsync(EditorMode mode)
    {
        if (mode == EditorMode.Edit && IsPicturePageChapter)
            mode = EditorMode.Layout;
        if (mode == EditorMode.Layout && !CanUseLayoutMode)
            return;
        if (_mode == mode) return;
        if (ContestReviewActive && mode != EditorMode.Review) return;

        if (mode is EditorMode.Read or EditorMode.Layout or EditorMode.Review)
        {
            if (!await FlushAsync()) return;
            await _saveGate.WaitAsync();
            _saveGate.Release();
        }

        _mode = mode;
        if (_mode is EditorMode.Read or EditorMode.Layout)
        {
            await LoadVisualStateAsync();
            await LoadChapterImagesAsync();
        }
        else
        {
            _projectImages = [];
        }
        await ApplyEditorReadOnlyAsync(EditorReadOnly);

        if (_mode == EditorMode.Review)
        {
            await RefreshReviewChangesAsync();
        }

        StateHasChanged();
    }

    private void ToggleChatPane()
    {
        if (ContestReviewActive) return;
        _chatPaneCollapsed = !_chatPaneCollapsed;
    }

    private void ToggleRightPane()
    {
        if (ContestReviewActive) return;
        _rightPaneCollapsed = !_rightPaneCollapsed;
    }

    private string EditorSidePaneClass()
    {
        var classes = "editor-side-pane";
        if (!_recommendedContextOpen)
        {
            classes += " editor-side-pane--recommendations-collapsed";
        }

        if (!_contextFeedOpen)
        {
            classes += " editor-side-pane--context-collapsed";
        }

        return classes;
    }

    private static string PanelClass(string panelName, bool isOpen) =>
        $"panel {panelName}{(isOpen ? string.Empty : " panel--collapsed")}";

