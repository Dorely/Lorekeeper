    private void QueueManuscriptLocationRestore()
    {
        var identity = CurrentManuscriptLocationIdentity();
        if (_mode == EditorMode.Pages
            || identity is null
            || _manuscriptLocation is null
            || _manuscriptLocationIdentity != identity)
        {
            _pendingLocation = null;
            _pendingLocationIdentity = null;
            return;
        }

        _pendingLocation = _manuscriptLocation;
        _pendingLocationIdentity = identity;
    }

    private async Task RestorePendingManuscriptLocationAsync()
    {
        if (_pendingLocation is not { } location || _pendingLocationIdentity is not { } identity)
            return;
        if (!IsCurrentManuscriptLocation(identity) || _mode == EditorMode.Pages)
        {
            _pendingLocation = null;
            _pendingLocationIdentity = null;
            return;
        }

        bool restored;
        switch (_mode)
        {
            case EditorMode.Edit:
                restored = _bodyEditor is not null && await _bodyEditor.RestoreLocationAsync(location);
                break;
            case EditorMode.Read:
                restored = _readPreview is not null && await _readPreview.RestoreLocationAsync(location);
                break;
            case EditorMode.Review:
                restored = await RestoreReviewLocationAsync(location);
                break;
            default:
                restored = false;
                break;
        }

        if (restored && IsCurrentManuscriptLocation(identity))
        {
            _pendingLocation = null;
            _pendingLocationIdentity = null;
        }
    }

