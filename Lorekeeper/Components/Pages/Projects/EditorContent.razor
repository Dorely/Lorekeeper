    private async Task RestoreRememberedChapterAsync()
    {
        var project = Project;
        var editorModule = _editorModule;
        if (_disposed || project is null || editorModule is null || _chapters.Count == 0) return;

        _restoreChapterAfterRender = false;
        var targetId = _chapters[0].Id;

        try
        {
            var remembered = await editorModule.InvokeAsync<string?>(
                "getLastEditorChapterId",
                project.Id.ToString("N"));

            if (!string.IsNullOrWhiteSpace(remembered)
                && Guid.TryParse(remembered, out var rememberedId)
                && _chapters.Any(c => c.Id == rememberedId))
            {
                targetId = rememberedId;
            }
        }
        catch (JSDisconnectedException)
        {
            if (!_disposed)
                _restoreChapterAfterRender = true;
            return;
        }
        catch (OperationCanceledException)
        {
            if (!_disposed)
                _restoreChapterAfterRender = true;
            return;
        }
        catch (ObjectDisposedException)
        {
            if (!_disposed)
            {
                if (ReferenceEquals(_editorModule, editorModule))
                    _editorModule = null;
                _restoreChapterAfterRender = true;
            }
            return;
        }
        catch (JSException) { }

        if (!_disposed)
        {
            var reviewQuery = _mode == EditorMode.Review
                || string.Equals(RequestedMode, nameof(EditorMode.Review), StringComparison.OrdinalIgnoreCase)
                ? "?mode=Review"
                : string.Empty;
            Nav.NavigateTo($"/projects/{project.Slug}/editor/{targetId}{reviewQuery}", replace: true);
        }
    }

    private async Task RememberSelectedChapterAsync(Guid chapterId)
    {
        if (_disposed) return;

        var project = Project;
        var editorModule = _editorModule;
        if (project is null || editorModule is null)
        {
            _pendingRememberChapterId = chapterId;
            return;
        }

        try
        {
            await editorModule.InvokeVoidAsync(
                "setLastEditorChapterId",
                project.Id.ToString("N"),
                chapterId.ToString());
            if (!_disposed)
                _pendingRememberChapterId = null;
        }
        catch (JSDisconnectedException)
        {
            if (!_disposed)
                _pendingRememberChapterId = chapterId;
        }
        catch (OperationCanceledException)
        {
            if (!_disposed)
                _pendingRememberChapterId = chapterId;
        }
        catch (ObjectDisposedException)
        {
            if (!_disposed)
            {
                if (ReferenceEquals(_editorModule, editorModule))
                    _editorModule = null;
                _pendingRememberChapterId = chapterId;
            }
        }
        catch (JSException)
        {
            if (!_disposed)
                _pendingRememberChapterId = null;
        }
    }

    private async Task<ChapterBodyEditor.SemanticEditorSaveResult> SaveDocumentAsync(
        Guid chapterId,
        long expectedRevision,
        string manuscriptJson)
    {
        await _saveGate.WaitAsync();
        try
        {
            _saveState = SaveState.Saving;
            _saveError = null;
            await InvokeAsync(StateHasChanged);

            var document = ManuscriptCodec.Deserialize(
                manuscriptJson,
                chapterId,
                expectedRevision);
            var result = await Manuscripts.ReplaceDocumentAsync(
                _contentTarget,
                chapterId,
                expectedRevision,
                document);
            Chapter? updated = null;
            try
            {
                updated = await Chapters.ReloadFromStoreAsync(chapterId);
                if (updated is not null && _current is not null && _current.Id == chapterId)
                {
                    _current = updated;
                    ReplaceCachedChapter(updated);
                    RecordEditorSave(result.Snapshot);
                    UpdateChapterMetrics(result.Snapshot.PlainText);
                    if (_contentTarget.EditionId is Guid statusEditionId && Project is not null)
                        _contentStatus = await EditionContent.GetChapterStatusAsync(Project.Id, statusEditionId, chapterId);
                    _previewRefreshSignal++;
                    _annotationRefreshSignal++;
                }
            }
            catch (Exception exception)
            {
                _saveError =
                    $"Revision {result.Snapshot.Revision} was saved, but the editor could not refresh: "
                    + exception.Message;
            }
            if (updated?.VectorIndexState == VectorIndexState.Failed)
            {
                _saveState = SaveState.IndexFailed;
                _saveError = updated.VectorIndexError;
            }
            else
            {
                _saveState = SaveState.Saved;
            }
            try
            {
                await RefreshContextSurfacesAsync();
            }
            catch (Exception exception)
            {
                _saveError ??=
                    $"Revision {result.Snapshot.Revision} was saved, but context refresh failed: "
                    + exception.Message;
            }
            _lastSavedAt = DateTime.Now;
            return new ChapterBodyEditor.SemanticEditorSaveResult(true, result.Snapshot.Revision);
        }
        catch (ManuscriptRevisionConflictException)
        {
            var current = await Manuscripts.GetManuscriptAsync(_contentTarget, chapterId)
                ?? throw new InvalidOperationException(
                    "The chapter was deleted while resolving an editing conflict.");
            _current = await Chapters.ReloadFromStoreAsync(chapterId);
            if (_current is not null)
                ReplaceCachedChapter(_current);
            RecordEditorSave(current);
            UpdateChapterMetrics(current.PlainText);
            _saveState = SaveState.Saved;
            _saveError = null;
            return new ChapterBodyEditor.SemanticEditorSaveResult(
                true,
                current.Revision,
                Applied: false,
                CurrentManuscriptJson: ManuscriptCodec.Serialize(current.Document));
        }
        catch (Exception ex)
        {
            _saveState = SaveState.SaveFailed;
            _saveError = ex.Message;
            return new ChapterBodyEditor.SemanticEditorSaveResult(false, expectedRevision);
        }
        finally
        {
            _saveGate.Release();
            try { await InvokeAsync(StateHasChanged); }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task<bool> FlushAsync()
    {
        if (_mode == EditorMode.Pages && _designedPageWorkspace is not null
            && !await _designedPageWorkspace.FlushAsync())
        {
            _saveState = SaveState.SaveFailed;
            _saveError ??= "The Designed Page draft could not be saved.";
            return false;
        }
        if (_bodyEditor is null) return true;
        var flushed = await _bodyEditor.FlushAsync();
        if (!flushed)
        {
            _saveState = SaveState.SaveFailed;
            _saveError ??= "The chapter draft could not be saved.";
        }
        return flushed;
    }

