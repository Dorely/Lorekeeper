    {
        if (!_expandedReviewBlockIds.Add(blockId))
        {
            _expandedReviewBlockIds.Remove(blockId);
            if (_activeReviewBlockId == blockId)
                _activeReviewBlockId = null;
            ClearInlineReviewEditors();
        }
        else
        {
            _activeReviewBlockId = blockId;
            _pendingReviewScrollBlockId = blockId;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

