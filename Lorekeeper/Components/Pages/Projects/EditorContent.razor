        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task AttachColumnLayoutAsync(Guid projectId)
    {
        if (_disposed) return;

        await DisposeColumnLayoutAsync();
        var editorModule = _editorModule;
        if (_disposed || editorModule is null) return;

        try
        {
            var columnLayoutHandle = await editorModule.InvokeAsync<IJSObjectReference>(
                "attachColumnLayout",
                new
                {
                    grid = _editorGridRef,
                    chatSplitter = _chatSplitterRef,
                    memorySplitter = _memorySplitterRef,
                },
                projectId.ToString("N"));

            if (_disposed)
            {
                try { await columnLayoutHandle.DisposeAsync(); } catch { }
                return;
            }

            _columnLayoutHandle = columnLayoutHandle;
            _columnLayoutProjectId = projectId;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException)
        {
            if (!_disposed && ReferenceEquals(_editorModule, editorModule))
                _editorModule = null;
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not initialize Editor column resizing for project {ProjectId}.", projectId);
        }
    }

