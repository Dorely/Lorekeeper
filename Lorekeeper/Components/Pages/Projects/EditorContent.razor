    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (firstRender)
        {
            _navHandlerRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
        }

        if (_reviewRefreshRequested && !_reviewRefreshInFlight
            && Project is not null && _current is not null)
        {
            _reviewRefreshRequested = false;
            _ = RefreshReviewAfterRenderAsync();
        }

        if (Project is not null && (_restoreChapterAfterRender || _current is not null || _pendingRememberChapterId is not null))
        {
            await EnsureEditorModuleAsync();
        }

        if (_disposed) return;

        if (Project is not null && _editorModule is not null && _workspacePreferencesProjectId != Project.Id)
        {
            await RestoreEditorWorkspacePreferencesAsync(Project.Id);
            if (_disposed) return;
            StateHasChanged();
            return;
        }

        if (_restoreChapterAfterRender)
        {
            await RestoreRememberedChapterAsync();
            return;
        }

        if (_current is not null && Project is not null && _editorModule is not null
            && (_columnLayoutHandle is null || _columnLayoutProjectId != Project.Id))
        {
            await AttachColumnLayoutAsync(Project.Id);
        }

        if (_focusTitleNext)
        {
            _focusTitleNext = false;
            try { await _titleInput.FocusAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        }

        if (_pendingRememberChapterId is { } chapterId)
        {
            await RememberSelectedChapterAsync(chapterId);
        }

        var editorModule = _editorModule;
        if (_pendingReviewScrollBlockId is { } blockId && editorModule is not null)
        {
            try
            {
                var anchorLine = CurrentReviewBlocks().FirstOrDefault(block => block.Id == blockId)?.AnchorLine ?? 1;
                await editorModule.InvokeVoidAsync("scrollReviewBlock", _reviewSurfaceRef, blockId, anchorLine);
                _pendingReviewScrollBlockId = null;
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException)
            {
                if (!_disposed && ReferenceEquals(_editorModule, editorModule))
                    _editorModule = null;
            }
            catch (JSException)
            {
                _pendingReviewScrollBlockId = null;
            }
        }

        await RestorePendingManuscriptLocationAsync();
    }

