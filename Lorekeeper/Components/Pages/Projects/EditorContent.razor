    private async Task ResolveReviewBlockAsync(
        ReviewBlock block,
        ChapterBodyReviewLineAction action,
        string? editedText = null,
        string? rejectionMessage = null)
    {
        if (block.ContestCandidateId is { } candidateId)
        {
            var contestRequest = new ContestCandidateReviewLineResolution(
                candidateId,
                block.Id,
                block.PairId,
                block.OldRow?.OldLineNumber,
                block.NewRow?.NewLineNumber,
                block.OldRow?.Text,
                block.NewRow?.Text,
                action,
                editedText);

            await RunReviewActionAsync(
                () => Chat.ResolveContestCandidateLineAsync(Project!.Id, _current!.Id, contestRequest),
                clearExpandedBlocks: false);
            return;
        }

        var request = new ChapterBodyReviewLineResolution(
            block.ChangeId,
            block.PairId,
            block.OldRow?.OldLineNumber,
            block.NewRow?.NewLineNumber,
            block.OldRow?.Text,
            block.NewRow?.Text,
            action,
            editedText,
            rejectionMessage);

        await RunReviewActionAsync(
            () => ChangeApproval.ResolveChapterBodyReviewLineAsync(Project!.Id, _current!.Id, request),
            clearExpandedBlocks: false);
    }

    private async Task RunReviewActionAsync(Func<Task> action, bool clearExpandedBlocks)
    {
        _reviewBusy = true;
        _reviewError = null;
        try
        {
            await action();
            ClearInlineReviewEditors();
            if (clearExpandedBlocks)
                _expandedReviewBlockIds.Clear();

            await ReconcileCurrentChapterAsync(refreshContextSurfaces: true);
            await RefreshReviewChangesAsync();
            _reviewRefreshSignal++;
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _reviewBusy = false;
            StateHasChanged();
        }
    }

