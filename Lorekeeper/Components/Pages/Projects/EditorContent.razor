    private async Task GoToNextReviewBlockAsync()
    {
        var blocks = CurrentReviewBlocks();
        if (blocks.Count > 0)
        {
            var currentIndex = _activeReviewBlockId is null
                ? -1
                : blocks.ToList().FindIndex(block => block.Id == _activeReviewBlockId);
            var next = blocks[(currentIndex + 1 + blocks.Count) % blocks.Count];
            await ExpandAndScrollReviewBlockAsync(next.Id);
        }
    }

    private Task ToggleReviewBlockAsync(string blockId)
    {
        _pendingLocation = null;
        _pendingLocationIdentity = null;
        if (!_expandedReviewBlockIds.Add(blockId))
        {
            _expandedReviewBlockIds.Remove(blockId);
            if (_activeReviewBlockId == blockId)
                _activeReviewBlockId = null;
            ClearInlineReviewEditors();
        }
        else
        {
            _activeReviewBlockId = blockId;
            _pendingReviewScrollBlockId = blockId;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ExpandAndScrollReviewBlockAsync(string blockId)
    {
        _pendingLocation = null;
        _pendingLocationIdentity = null;
        _expandedReviewBlockIds.Add(blockId);
        _activeReviewBlockId = blockId;
        _pendingReviewScrollBlockId = blockId;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ToggleReviewCategoryAsync(ReviewLine line, ReviewBlockCategory category)
    {
        _pendingLocation = null;
        _pendingLocationIdentity = null;
        var blockIds = ReviewLineBlockIds(line, category);
        if (blockIds.Count == 0)
            return Task.CompletedTask;

        var shouldExpand = blockIds.Any(blockId => !_expandedReviewBlockIds.Contains(blockId));
        foreach (var blockId in blockIds)
        {
            if (shouldExpand)
                _expandedReviewBlockIds.Add(blockId);
            else
                _expandedReviewBlockIds.Remove(blockId);
        }

        _activeReviewBlockId = shouldExpand ? blockIds[0] : null;
        _pendingReviewScrollBlockId = shouldExpand ? blockIds[0] : null;
        if (!shouldExpand)
            ClearInlineReviewEditors();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool IsReviewBlockExpanded(string blockId) => _expandedReviewBlockIds.Contains(blockId);

    private IReadOnlyList<ReviewBlock> CurrentReviewBlocks() =>
        _contestReviewProjection?.Blocks ?? _reviewProjection?.Blocks ?? [];

    private IReadOnlyList<ReviewBlock> ReviewBlocksBeforeLine(ReviewProjection? projection, int lineNumber) =>
        projection?.Blocks
            .Where(block => IsReviewBlockExpanded(block.Id) && ReviewBlockRenderLine(block) == lineNumber)
            .ToList()
        ?? [];

    private IReadOnlyList<ReviewBlock> ReviewBlocksBeforeLine(int lineNumber) =>
        ReviewBlocksBeforeLine(_reviewProjection, lineNumber);

    private bool ShouldRenderReviewLine(ReviewProjection? projection, ReviewLine line) =>
        projection?.Blocks.Any(block =>
            IsReviewBlockExpanded(block.Id)
            && ReviewBlockCoversLine(block, line.LineNumber)) != true;

    private bool ShouldRenderReviewLine(ReviewLine line) =>
        ShouldRenderReviewLine(_reviewProjection, line);

    private static int ReviewBlockRenderLine(ReviewBlock block) =>
        block.Category == ReviewBlockCategory.Text
            ? block.NewRow?.NewLineNumber ?? block.AnchorLine
            : block.AnchorLine;

    private static bool ReviewBlockCoversLine(ReviewBlock block, int lineNumber) =>
        block.Category == ReviewBlockCategory.Text
        && block.NewRow?.NewLineNumber == lineNumber;

