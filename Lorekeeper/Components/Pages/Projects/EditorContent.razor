    private async Task RefreshReviewAfterRenderAsync()
    {
        try
        {
            await RefreshReviewChangesAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            try
            {
                if (!_disposed)
                    await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }

    private async Task RefreshReviewChangesAsync(bool showLoadingState = true)
    {
        if (Project is null || _current is null)
        {
            _contestReviewBatches = [];
            _contestReviewProjection = null;
            _reviewProjection = null;
            _reviewView = null;
            _historicalReview = null;
            _reviewCompositionPreviews = [];
            _reviewLoading = false;
            ResetInlineReviewState();
            return;
        }

        var project = Project;
        var chapter = _current;
        var target = _contentTarget;
        var sequence = ++_reviewRefreshSequence;
        var previousCancellation = _reviewRefreshCancellation;
        previousCancellation?.Cancel();
        using var refreshCancellation = CancellationTokenSource.CreateLinkedTokenSource(
            _reviewRefreshLifetimeCancellation.Token);
        _reviewRefreshCancellation = refreshCancellation;
        _reviewRefreshInFlight = true;
        _reviewRefreshRequested = false;
        if (showLoadingState)
            _reviewLoading = true;

        var cancellationToken = refreshCancellation.Token;
        try
        {
            var result = await Task.Run(
                () => LoadReviewRefreshResultAsync(
                    project.Id,
                    chapter,
                    target,
                    cancellationToken),
                cancellationToken);
            if (!IsCurrentReviewRefresh(sequence, project.Id, chapter.Id, target))
                return;

            _projectContestLock = result.ContestLock;
            _contestReviewBatches = result.ContestBatches;
            if (result.ActiveContest is not null)
            {
                _contestReviewProjection = null;
                _reviewView = null;
                _historicalReview = null;
                _reviewProjection = null;
                _reviewCompositionPreviews = [];
                ActivateContestReview(result.ActiveContest);
                return;
            }

            _contestReviewProjection = null;
            _reviewView = result.Review;
            _historicalReview = result.HistoricalReview;
            _reviewProjection = result.Projection;
            _reviewCompositionPreviews = result.CompositionPreviews;
            _reviewError = null;
            PruneInlineReviewState();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (IsCurrentReviewRefresh(sequence, project.Id, chapter.Id, target))
            {
                // Keep the last successfully rendered review while a refresh
                // fails. A transient Git/history error must not turn a live
                // chapter into the misleading "No chapter selected" state.
                _reviewError = ex.Message;
                LogEditorRefreshFailure(ex, "review refresh");
            }
        }
        finally
        {
            if (ReferenceEquals(_reviewRefreshCancellation, refreshCancellation))
            {
                _reviewRefreshCancellation = null;
                _reviewRefreshInFlight = false;
                if (IsCurrentReviewRefresh(sequence, project.Id, chapter.Id, target)
                    && showLoadingState)
                {
                    _reviewLoading = false;
                }
            }
        }
    }

    private async Task<ReviewRefreshResult> LoadReviewRefreshResultAsync(
        Guid projectId,
        Chapter chapter,
        EditorContentTarget target,
        CancellationToken cancellationToken)
    {
        using var scope = ScopeFactory.CreateScope();
        var chat = scope.ServiceProvider.GetRequiredService<IEditorChatService>();
        var versionHistory = scope.ServiceProvider.GetRequiredService<IProjectVersionHistoryService>();
        var compositionPreviews = scope.ServiceProvider.GetRequiredService<ICompositionCanvasPreviewService>();

        var contestLock = await chat.GetEditorContestLockStateAsync(projectId, cancellationToken);
        var contestBatches = await chat.ListCurrentContestBatchesAsync(projectId, cancellationToken);
        var activeContest = contestBatches
            .FirstOrDefault(batch => batch.ChapterId == chapter.Id && batch.Candidates.Count > 0);
        if (activeContest is not null)
        {
            return new ReviewRefreshResult(
                contestLock,
                contestBatches,
                activeContest,
                null,
                null,
                null,
                []);
        }

        var review = await versionHistory.GetReviewAsync(
            projectId,
            [new ProjectVersionReviewTarget(chapter.Id, target)],
            cancellationToken);
        ReviewProjection? reviewProjection = null;
        ProjectVersionHistoricalChapterReview? historicalReview = null;
        IReadOnlyList<ReviewCompositionPreview> reviewCompositionPreviews;
        var reviewChapter = review?.Chapters.SingleOrDefault();
        if (reviewChapter is { HasChanges: true })
        {
            reviewProjection = BuildVersionHistoryReviewProjection(
                chapter,
                reviewChapter,
                isReadOnly: true);
            reviewCompositionPreviews = await LoadReviewCompositionPreviewsAsync(
                reviewChapter,
                projectId,
                compositionPreviews,
                cancellationToken);
        }
        else
        {
            historicalReview = await versionHistory.GetLatestAffectingChapterAsync(
                projectId,
                chapter.Id,
                target,
                cancellationToken: cancellationToken);
            reviewProjection = historicalReview is not null
                ? BuildHistoricalReviewProjection(chapter, historicalReview)
                    ?? BuildReviewProjection(chapter, isReadOnly: true)
                : reviewChapter is not null
                    ? BuildVersionHistoryReviewProjection(chapter, reviewChapter, isReadOnly: true)
                        ?? BuildReviewProjection(chapter, isReadOnly: true)
                    : BuildReviewProjection(chapter, isReadOnly: true);
            reviewCompositionPreviews = historicalReview is { } historical
                ? await LoadReviewCompositionPreviewsAsync(
                    historical,
                    projectId,
                    compositionPreviews,
                    cancellationToken)
                : [];
        }

        return new ReviewRefreshResult(
            contestLock,
            contestBatches,
            null,
            review,
            historicalReview,
            reviewProjection,
            reviewCompositionPreviews);
    }

    private bool IsCurrentReviewRefresh(
        long sequence,
        Guid projectId,
        Guid chapterId,
        EditorContentTarget target) =>
        !_disposed
        && sequence == _reviewRefreshSequence
        && Project?.Id == projectId
        && _current?.Id == chapterId
        && _contentTarget == target;

