@using Lorekeeper.Images
@using Lorekeeper.ImagesChat
@using Lorekeeper.Llm
@using Lorekeeper.Models
@implements IAsyncDisposable
@inject IProjectImageService Images
@inject IProjectImageJobService ImageJobs
@inject IProjectImageGenerationRuntime ImageRuntime
@inject IImagePromptComposer ImagePrompts
@inject Lorekeeper.Composition.ICompositionService Compositions
@inject IImagesChatService ImagesChat
@inject IEntityVisualExampleService EntityVisuals
@inject ILlmProviderService Providers
@inject IJSRuntime JS

@if (Project is null)
{
    <p class="text-muted"><em>Loading...</em></p>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading images...</em></p>
}
else
{
    <div class="images-workspace">
        <section class="images-chat-pane">
            <ImagesChatPanel ProjectId="Project.Id" OnImagesChanged="ReloadAsync" AttachmentRefreshKey="_attachmentRefreshKey" />
        </section>

        <section class="images-main">
            <div class="images-toolbar">
                <input type="search"
                       class="form-control form-control-sm"
                       placeholder="Search images..."
                       @bind="_query"
                       @bind:event="oninput" />
                <span class="images-count">@FilteredImages.Count image@((FilteredImages.Count == 1) ? string.Empty : "s")</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <div class="alert alert-success py-2">@_status</div>
            }

            <div class="images-grid">
                @foreach (var job in VisibleJobs)
                {
                    @RenderJobCard(job)
                }

                @foreach (var image in FilteredImages)
                {
                    var chapterUsage = ChapterUsage(image.Id);
                    <article class="image-card @(chapterUsage is null ? string.Empty : "image-card-used")" @key="image.Id">
                        <button type="button" class="image-preview-button" @onclick="() => OpenImageModal(image)">
                            <img src="@image.PreviewUrl" alt="@ImageAlt(image)" />
                        </button>
                        <div class="image-card-body">
                            @if (chapterUsage is not null)
                            {
                                <div class="image-usage-badge" title="@ChapterUsageTitle(chapterUsage)">
                                    Used in @chapterUsage.ChapterTitles.Count chapter@((chapterUsage.ChapterTitles.Count == 1) ? string.Empty : "s")
                                </div>
                            }
                            <input class="form-control form-control-sm"
                                   value="@image.FileName"
                                   @onchange="e => UpdateImageAsync(image, fileName: e.Value?.ToString() ?? string.Empty, altText: image.AltText)" />
                            <input class="form-control form-control-sm"
                                   placeholder="Alt text"
                                   value="@image.AltText"
                                   @onchange="e => UpdateImageAsync(image, fileName: image.FileName, altText: e.Value?.ToString() ?? string.Empty)" />
                            <div class="image-meta">
                                <span>@image.Source</span>
                                <span>@FormatBytes(image.SizeBytes)</span>
                            </div>
                            <ImageEntityAssociations ProjectId="@Project.Id" ImageId="@image.Id" />
                            <div class="image-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AttachToChatAsync(image)">Attach to Chat</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenCropModal(image)">Crop</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenMaskModal(image)">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadAsync(image)">Download</button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled="@(chapterUsage is not null)"
                                        title="@(chapterUsage is null ? "Delete image" : ChapterUsageTitle(chapterUsage))"
                                        @onclick="() => DeleteAsync(image.Id)">Delete</button>
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (VisibleJobs.Count == 0 && FilteredImages.Count == 0)
            {
                <div class="images-empty">No images match the current filter.</div>
            }
        </section>

        <aside class="images-side">
            <section class="image-tool-panel">
                <h6>Upload</h6>
                <label>
                    <span>Alt text</span>
                    <input class="form-control form-control-sm" @bind="_uploadAltText" />
                </label>
                <InputFile OnChange="UploadAsync" class="form-control form-control-sm" />
            </section>

            <section class="image-tool-panel">
                <h6>Generate</h6>
                @if (_layoutTarget is not null)
                {
                    <div class="alert alert-info py-2 small">
                        <strong>@_layoutTarget.TargetKind target</strong><br />
                        @_layoutTarget.WidthInches.ToString("0.###") × @_layoutTarget.HeightInches.ToString("0.###") in · @_layoutTarget.AspectRatio · @_layoutTarget.RequestedRaster
                        <div>The target guides composition and reserved regions. The generated raster stays intact; its frame fit and crop position control placement.</div>
                    </div>
                }
                @if (!_codexConnected)
                {
                    <p class="text-muted small mb-0">Connect Codex in Providers to generate images.</p>
                }
                else
                {
                    <label>
                        <span>Prompt</span>
                        <textarea class="form-control form-control-sm" rows="6" @bind="_imagePrompt"></textarea>
                    </label>
                    <div class="image-form-grid">
                        @if (_layoutTarget is null)
                        {
                            <label>
                                <span>Size</span>
                                <select class="form-select form-select-sm" @bind="_imageSize">
                                    <option value="auto">Auto</option>
                                    <option value="1024x1024">Square</option>
                                    <option value="1024x1536">Portrait</option>
                                    <option value="1536x1024">Landscape</option>
                                </select>
                            </label>
                        }
                        <label>
                            <span>Quality</span>
                            <select class="form-select form-select-sm" @bind="_imageQuality">
                                <option value="auto">Auto</option>
                                <option value="low">Low</option>
                                <option value="medium">Medium</option>
                                <option value="high">High</option>
                            </select>
                        </label>
                        <label>
                            <span>Format</span>
                            <select class="form-select form-select-sm" @bind="_imageFormat" disabled="@(_layoutTarget is not null)">
                                <option value="png">PNG</option>
                                <option value="jpeg">JPEG</option>
                                <option value="webp">WebP</option>
                            </select>
                            @if (_layoutTarget is not null)
                            {
                                <small>Layout-guided images are stored as lossless PNG without cropping the provider output.</small>
                            }
                        </label>
                        <label>
                            <span>JPEG compression</span>
                            <input class="form-control form-control-sm" type="number" min="0" max="100" @bind="_imageCompression" disabled="@(_imageFormat != "jpeg")" />
                        </label>
                    </div>
                    <label>
                        <span>Generated alt text</span>
                        <input class="form-control form-control-sm" @bind="_generatedAltText" />
                    </label>
                    <label><span>Represented entities</span></label>
                    <EntityVisualTargetPicker ProjectId="@Project.Id" @bind-Targets="_generationEntityTargets" />
                    <button type="button" class="btn btn-sm btn-primary" disabled="@_queueingGenerate" @onclick="GenerateAsync">
                        @(_queueingGenerate ? "Queueing..." : "Queue image")
                    </button>
                }
            </section>

        </aside>
    </div>
}

@if (_croppingImage is not null && Project is not null)
{
    <ImageCropModal ProjectId="@Project.Id"
                    SourceImage="@_croppingImage"
                    AllowTargetEditing="true"
                    Saved="OnCropSavedAsync"
                    Closed="CloseCropModal" />
}

@if (_viewImage is not null)
{
    <ImageViewerModal ImageUrl="@($"/projects/{Project!.Id:N}/images/{_viewImage.Id:N}/content")"
                      Title="@_viewImage.FileName"
                      AltText="@ImageAlt(_viewImage)"
                      Details="@ViewerDetails(_viewImage)"
                      Closed="CloseImageModal" />
}

@if (_maskModalOpen && _editingImage is not null)
{
    <div class="mask-modal-backdrop" @onclick="CloseMaskModal">
        <section class="mask-modal" role="dialog" aria-modal="true" aria-label="Edit with mask" @onclick:stopPropagation="true">
            <header class="mask-modal-header">
                <div>
                    <h5>Edit with mask</h5>
                    <span>@_editingImage.FileName</span>
                </div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseMaskModal"></button>
            </header>
            <div class="mask-modal-body">
                <div class="mask-canvas-wrap">
                    <canvas class="mask-canvas" @ref="_maskCanvas"></canvas>
                </div>
                <aside class="mask-tools">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Mask tool">
                        <button type="button" class="@BrushToolClass" @onclick='() => SetMaskToolAsync("brush")'>Brush</button>
                        <button type="button" class="@EraserToolClass" @onclick='() => SetMaskToolAsync("erase")'>Eraser</button>
                        <button type="button" class="@PanToolClass" @onclick='() => SetMaskToolAsync("pan")'>Pan</button>
                    </div>
                    <label>
                        <span>Brush size</span>
                        <input type="range" min="4" max="160" step="1" class="form-range" value="@_maskBrushSize" @oninput="OnMaskBrushInputAsync" />
                    </label>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearMaskAsync">Clear</button>
                    <label>
                        <span>Edit prompt</span>
                        <textarea class="form-control form-control-sm" rows="7" @bind="_maskPrompt"></textarea>
                    </label>
                    <label><span>Additional represented entities</span></label>
                    <EntityVisualTargetPicker ProjectId="@Project!.Id" @bind-Targets="_editEntityTargets" />
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_inheritEditEntityTargets" />
                        <span class="form-check-label">Inherit source image entity associations</span>
                    </label>
                    <button type="button" class="btn btn-sm btn-primary" disabled="@_sendingMaskEdit" @onclick="SendMaskEditAsync">
                        @(_sendingMaskEdit ? "Sending..." : "Send edit")
                    </button>
                </aside>
            </div>
        </section>
    </div>
}

<ConfirmationDialog IsOpen="@(_historyDeleteImageId is not null)"
                    Title="Delete image and clear Undo/Redo history?"
                    Message="@(_historyDeleteMessage ?? string.Empty)"
                    ConfirmLabel="Delete and clear history"
                    Destructive="true"
                    OnConfirm="ConfirmHistoryImageDeleteAsync"
                    OnCancel="CancelHistoryDelete" />

@code {
    private const long MaxImageBytes = 20L * 1024 * 1024;

    [CascadingParameter] public Project? Project { get; set; }

    private IReadOnlyList<ProjectImageView> _images = [];
    private IReadOnlyDictionary<Guid, ProjectImageChapterUsageView> _chapterUsage =
        new Dictionary<Guid, ProjectImageChapterUsageView>();
    private IReadOnlyList<ProjectImageJobView> _jobs = [];
    private ProjectImageGenerationRuntimeSnapshot _runtimeSnapshot = new([]);
    private ProjectImageView? _editingImage;
    private ProjectImageView? _croppingImage;
    private List<EntityVisualTarget> _generationEntityTargets = [];
    private List<EntityVisualTarget> _editEntityTargets = [];
    private bool _inheritEditEntityTargets = true;
    private ProjectImageView? _viewImage;
    private IJSObjectReference? _downloadModule;
    private IJSObjectReference? _maskModule;
    private ElementReference _maskCanvas;
    private string _query = string.Empty;
    private string _uploadAltText = string.Empty;
    private string _imagePrompt = string.Empty;
    private string _imageSize = "auto";
    private string _imageQuality = "auto";
    private string _imageFormat = "png";
    private int? _imageCompression;
    private string _generatedAltText = string.Empty;
    private string _maskPrompt = string.Empty;
    private string _maskTool = "brush";
    private int _maskBrushSize = 32;
    private string? _error;
    private string? _status;
    private bool _loading = true;
    private bool _codexConnected;
    private bool _queueingGenerate;
    private bool _maskModalOpen;
    private bool _maskCanvasNeedsInit;
    private bool _sendingMaskEdit;
    private Guid? _loadedProjectId;
    private int _attachmentRefreshKey;
    [Parameter] public Guid? LayoutEditionId { get; set; }
    [Parameter] public string? LayoutTargetKind { get; set; }
    [Parameter] public Guid? LayoutTargetId { get; set; }
    [Parameter] public Guid? LayoutVariantId { get; set; }
    private LayoutGenerationTargetDescriptor? _layoutTarget;

    private IReadOnlyList<ProjectImageView> FilteredImages =>
        string.IsNullOrWhiteSpace(_query)
            ? _images
            : _images.Where(image => image.FileName.Contains(_query, StringComparison.OrdinalIgnoreCase)
                || image.AltText.Contains(_query, StringComparison.OrdinalIgnoreCase)
                || image.Prompt.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<ProjectImageJobView> VisibleJobs =>
        _jobs.Where(job => IsActiveJob(job.Status))
            .OrderByDescending(job => job.CreatedAt)
            .ToList();

    protected override void OnInitialized() =>
        ImageRuntime.StateChanged += OnRuntimeStateChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) return;
        if (LayoutTargetId is Guid targetId && !string.IsNullOrWhiteSpace(LayoutTargetKind))
        {
            try
            {
                _layoutTarget = LayoutTargetKind.StartsWith("cover", StringComparison.OrdinalIgnoreCase)
                    ? await Compositions.DescribeGenerationTargetAsync(
                        Project.Id,
                        LayoutEditionId ?? throw new ArgumentException("Publication cover artwork requires a release."),
                        LayoutTargetKind,
                        targetId,
                        LayoutVariantId)
                    : await Compositions.DescribeAuthoringGenerationTargetAsync(
                        Project.Id,
                        LayoutTargetKind,
                        targetId,
                        LayoutVariantId);
            }
            catch (Exception ex) { _layoutTarget = null; _error = ex.Message; }
        }
        else _layoutTarget = null;
        if (_loadedProjectId == Project.Id) return;
        _loadedProjectId = Project.Id;
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _downloadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownloads.js");
            _maskModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Projects/Images/ImagesContent.razor.js");
        }

        if (_maskCanvasNeedsInit && _maskModule is not null && _editingImage is not null && Project is not null)
        {
            _maskCanvasNeedsInit = false;
            await _maskModule.InvokeVoidAsync(
                "loadMaskCanvas",
                _maskCanvas,
                $"/projects/{Project.Id:N}/images/{_editingImage.Id:N}/content",
                _maskTool,
                _maskBrushSize);
        }
    }

    public async Task ReloadAsync()
    {
        if (Project is null) return;
        _loading = true;
        _error = null;
        try
        {
            _codexConnected = await Providers.IsCodexConnectedAsync();
            await ReloadImageLibraryAsync();
            _jobs = await ImageJobs.ListJobsAsync(Project.Id);
            _runtimeSnapshot = ImageRuntime.GetSnapshot();
            RefreshOpenImages();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnRuntimeStateChanged(object? sender, EventArgs args)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                _runtimeSnapshot = ImageRuntime.GetSnapshot();
                if (Project is not null)
                {
                    _jobs = await ImageJobs.ListJobsAsync(Project.Id);
                    await ReloadImageLibraryAsync();
                    RefreshOpenImages();
                }
                StateHasChanged();
            });
        }
        catch
        {
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (Project is null) return;
        _error = null;
        _status = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            await Images.UploadAsync(Project.Id, new ProjectImageUpload(file.Name, file.ContentType, memory.ToArray(), _uploadAltText));
            _uploadAltText = string.Empty;
            _status = "Image uploaded.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task GenerateAsync()
    {
        if (Project is null) return;
        _queueingGenerate = true;
        _error = null;
        _status = null;
        try
        {
            var compiled = await ImagePrompts.CompileGenerationAsync(
                Project.Id,
                new ImageGenerationBrief
                {
                    IntendedUse = "Standalone project-library image requested through the manual Images panel.",
                    Scene = _imagePrompt,
                    AllowRenderedText = false,
                },
                references: null,
                target: _layoutTarget is null
                    ? new ImageGenerationTarget { Size = _imageSize }
                    : new ImageGenerationTarget { EditionId = _layoutTarget.EditionId, TargetKind = _layoutTarget.TargetKind, TargetId = _layoutTarget.TargetId, VariantId = _layoutTarget.VariantId });
            await ImageJobs.CreateGenerateJobAsync(Project.Id, new ProjectImageGenerateJobRequest(
                compiled.Prompt,
                compiled.Size,
                _imageQuality,
                _imageFormat,
                _imageFormat == "jpeg" ? _imageCompression : null,
                _generatedAltText,
                1,
                [],
                Label: "Manual generation",
                EntityTargets: _generationEntityTargets,
                BriefJson: compiled.BriefJson,
                ReferenceManifestJson: compiled.ReferenceManifestJson,
                TargetGeometryJson: compiled.TargetGeometryJson));
            await ImageRuntime.EnqueueProjectAsync(Project.Id);
            _status = "Image job queued.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _queueingGenerate = false;
        }
    }

    private async Task UpdateImageAsync(ProjectImageView image, string fileName, string altText)
    {
        if (Project is null) return;
        _error = null;
        try
        {
            await Images.UpdateAsync(Project.Id, image.Id, new ProjectImageUpdate(fileName, altText));
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Guid? _historyDeleteImageId;
    private string? _historyDeleteMessage;

    private async Task DeleteAsync(Guid imageId, bool clearAffectedHistory = false)
    {
        if (Project is null) return;
        _error = null;
        try
        {
            await Images.DeleteAsync(Project.Id, imageId, clearAffectedHistory);
            _historyDeleteImageId = null;
            _historyDeleteMessage = null;
            _status = "Image deleted.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            if (ex.Message.StartsWith("AUTHORING_HISTORY_DEPENDENCY:", StringComparison.Ordinal))
            {
                _historyDeleteImageId = imageId;
                _historyDeleteMessage = ex.Message["AUTHORING_HISTORY_DEPENDENCY:".Length..].Trim();
            }
            else
                _error = ex.Message;
        }
    }

    private void CancelHistoryDelete()
    {
        _historyDeleteImageId = null;
        _historyDeleteMessage = null;
    }

    private Task ConfirmHistoryImageDeleteAsync() => _historyDeleteImageId is Guid imageId
        ? DeleteAsync(imageId, true)
        : Task.CompletedTask;

    private async Task AttachToChatAsync(ProjectImageView image)
    {
        if (Project is null) return;
        _error = null;
        try
        {
            await ImagesChat.AttachImageAsync(Project.Id, image.Id);
            _attachmentRefreshKey++;
            _status = "Image attached to Images Chat.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DownloadAsync(ProjectImageView image)
    {
        if (_downloadModule is null || Project is null) return;
        var data = await Images.GetDataAsync(Project.Id, image.Id);
        if (data is null) return;
        await _downloadModule.InvokeVoidAsync("downloadBytes", data.FileName, data.ContentType, Convert.ToBase64String(data.Data));
    }

    private void OpenImageModal(ProjectImageView image) => _viewImage = image;

    private void CloseImageModal() => _viewImage = null;

    private async Task ReloadImageLibraryAsync()
    {
        if (Project is null) return;
        _images = await Images.ListAsync(Project.Id);
        _chapterUsage = (await Images.ListChapterUsageAsync(Project.Id))
            .ToDictionary(usage => usage.ImageId);
    }

    private ProjectImageChapterUsageView? ChapterUsage(Guid imageId) =>
        _chapterUsage.GetValueOrDefault(imageId);

    private static string ChapterUsageTitle(ProjectImageChapterUsageView usage) =>
        "Used by " + string.Join(", ", usage.ChapterTitles) + ". Remove or replace it in every chapter before deleting.";

    private static IReadOnlyList<string> ViewerDetails(ProjectImageView image) =>
        new[]
        {
            image.AltText,
            $"{image.Source} - {FormatBytes(image.SizeBytes)}",
        }.Where(value => !string.IsNullOrWhiteSpace(value)).ToList();

    private void OpenCropModal(ProjectImageView image) => _croppingImage = image;

    private void CloseCropModal() => _croppingImage = null;

    private async Task OnCropSavedAsync(ProjectImageCropSaved result)
    {
        if (Project is null) return;
        try
        {
            foreach (var target in result.EntityTargets.Where(target => target.EntityId != Guid.Empty).DistinctBy(target => target.EntityId))
            {
                await EntityVisuals.AttachAsync(
                    Project.Id,
                    target.EntityId,
                    result.Image.Id,
                    target.Label,
                    EntityVisualExampleOrigin.Manual);
            }
            _croppingImage = null;
            _status = result.EntityTargets.Count == 0
                ? "Crop saved to the image library."
                : "Crop saved and attached to the selected entities.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenMaskModal(ProjectImageView image)
    {
        _editingImage = image;
        _maskPrompt = string.Empty;
        _editEntityTargets = [];
        _inheritEditEntityTargets = true;
        _maskTool = "brush";
        _maskBrushSize = 32;
        _maskModalOpen = true;
        _maskCanvasNeedsInit = true;
    }

    private void CloseMaskModal() => _maskModalOpen = false;

    private async Task SetMaskToolAsync(string tool)
    {
        _maskTool = tool;
        if (_maskModule is not null)
            await _maskModule.InvokeVoidAsync("setMaskTool", _maskCanvas, tool);
    }

    private async Task OnMaskBrushInputAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
            _maskBrushSize = Math.Clamp(value, 4, 160);
        if (_maskModule is not null)
            await _maskModule.InvokeVoidAsync("setMaskBrushSize", _maskCanvas, _maskBrushSize);
    }

    private async Task ClearMaskAsync()
    {
        if (_maskModule is not null)
            await _maskModule.InvokeVoidAsync("clearMask", _maskCanvas);
    }

    private async Task SendMaskEditAsync()
    {
        if (Project is null || _editingImage is null || _maskModule is null) return;
        _error = null;
        _status = null;
        if (string.IsNullOrWhiteSpace(_maskPrompt))
        {
            _error = "Edit prompt is required.";
            return;
        }

        _sendingMaskEdit = true;
        try
        {
            var hasPaint = await _maskModule.InvokeAsync<bool>("hasMaskPaint", _maskCanvas);
            if (!hasPaint)
            {
                _error = "Paint the editable mask area first.";
                return;
            }

            var maskDataUrl = await _maskModule.InvokeAsync<string>("exportMaskPng", _maskCanvas);
            var compiled = await ImagePrompts.CompileEditAsync(
                Project.Id,
                _editingImage.Id,
                new ImageEditBrief
                {
                    IntendedUse = "Localized project-library edit requested through the manual mask editor.",
                    Change = _maskPrompt,
                    Preserve = "Preserve every unmasked pixel and all unmentioned identity, composition, crop, style, palette, lighting, and background details.",
                    AllowRenderedText = false,
                },
                references: null,
                target: new ImageGenerationTarget { Size = _imageSize });
            await ImageJobs.CreateEditJobAsync(Project.Id, new ProjectImageEditJobRequest(
                _editingImage.Id,
                compiled.Prompt,
                compiled.Size,
                _imageQuality,
                _imageFormat,
                _imageFormat == "jpeg" ? _imageCompression : null,
                _generatedAltText,
                1,
                maskDataUrl,
                [],
                Label: $"Edit {_editingImage.FileName}",
                EntityTargets: _editEntityTargets,
                InheritSourceEntityTargets: _inheritEditEntityTargets,
                BriefJson: compiled.BriefJson,
                ReferenceManifestJson: compiled.ReferenceManifestJson,
                TargetGeometryJson: compiled.TargetGeometryJson));
            await ImageRuntime.EnqueueProjectAsync(Project.Id);
            _maskModalOpen = false;
            _status = "Edit job queued.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sendingMaskEdit = false;
        }
    }

    private RenderFragment RenderJobCard(ProjectImageJobView job) => __builder =>
    {
        var runtimeJob = RuntimeJob(job.Id);
        <article class="image-card image-job-card" @key="job.Id">
            <div class="image-job-preview">
                @if (runtimeJob?.Outputs.FirstOrDefault(output => !string.IsNullOrWhiteSpace(output.PartialImageDataUrl)) is { PartialImageDataUrl: { } partialUrl })
                {
                    <img src="@partialUrl" alt="Partial image preview" />
                }
                else if (job.OutputImageIds.FirstOrDefault() is Guid outputId && outputId != Guid.Empty)
                {
                    <img src="@ImagePreviewUrl(outputId)" alt="@job.Label" />
                }
                else
                {
                    <div class="image-job-spinner" aria-hidden="true"></div>
                }
            </div>
            <div class="image-card-body">
                <strong>@job.Label</strong>
                <div class="image-meta">
                    <span>@job.Kind</span>
                    <span>@JobStatusText(job, runtimeJob)</span>
                </div>
                <p class="small mb-0">@Truncate(job.Prompt, 160)</p>
                <details class="small mt-2">
                    <summary>Generation brief and provider details</summary>
                    <div class="mt-2"><strong>Compiled prompt</strong></div>
                    <pre class="context-detail-text"><code>@job.Prompt</code></pre>
                    <div><strong>Structured brief</strong></div>
                    <pre class="context-detail-text"><code>@job.BriefJson</code></pre>
                    <div><strong>Reference manifest</strong></div>
                    <pre class="context-detail-text"><code>@job.ReferenceManifestJson</code></pre>
                    <div><strong>Target geometry</strong></div>
                    <pre class="context-detail-text"><code>@job.TargetGeometryJson</code></pre>
                    @if (job.ProviderRevisedPrompts.Count > 0)
                    {
                        <div><strong>Provider revised prompt@(job.ProviderRevisedPrompts.Count == 1 ? string.Empty : "s")</strong></div>
                        @foreach (var revisedPrompt in job.ProviderRevisedPrompts)
                        {
                            <pre class="context-detail-text"><code>@revisedPrompt</code></pre>
                        }
                    }
                </details>
                @if (!string.IsNullOrWhiteSpace(job.Error))
                {
                    <p class="small text-danger mb-0">@job.Error</p>
                }
                @foreach (var output in (runtimeJob?.Outputs ?? job.OutputStates.Select(ToRuntimeOutput)).OrderBy(output => output.OutputIndex))
                {
                    <div class="image-output-row">
                        <span>@(output.OutputIndex + 1)</span>
                        <span>@output.Status</span>
                        <span>@output.Message</span>
                    </div>
                }
            </div>
        </article>
    };

    private ProjectImageGenerationJobRuntimeView? RuntimeJob(Guid jobId) =>
        _runtimeSnapshot.Jobs.FirstOrDefault(job => job.JobId == jobId);

    private static ProjectImageOutputRuntimeView ToRuntimeOutput(ProjectImageOutputStateView state) =>
        new(
            state.OutputIndex,
            state.Status,
            state.Attempt,
            state.Message,
            state.Error,
            state.ErrorKind,
            state.RequestId,
            state.ResponseId,
            state.CallId,
            state.LastEventType,
            state.EventCount,
            PartialImageDataUrl: null);

    private static bool IsActiveJob(ProjectImageGenerationJobStatus status) =>
        status is ProjectImageGenerationJobStatus.Queued or ProjectImageGenerationJobStatus.Running;

    private static string JobStatusText(ProjectImageJobView job, ProjectImageGenerationJobRuntimeView? runtimeJob)
    {
        if (runtimeJob is { IsRunning: true })
            return "Running";
        return job.Status.ToString();
    }

    private string ImagePreviewUrl(Guid imageId) =>
        Project is null ? string.Empty : $"/projects/{Project.Id:N}/images/{imageId:N}/content?maxEdge=640";

    private void RefreshOpenImages()
    {
        var ids = _images.Select(image => image.Id).ToHashSet();
        if (_viewImage is not null)
            _viewImage = ids.Contains(_viewImage.Id) ? _images.First(image => image.Id == _viewImage.Id) : null;
        if (_editingImage is not null && !ids.Contains(_editingImage.Id))
        {
            _editingImage = null;
            _maskModalOpen = false;
            _maskCanvasNeedsInit = false;
        }
        else if (_editingImage is not null)
        {
            _editingImage = _images.First(image => image.Id == _editingImage.Id);
        }
    }

    private static string ImageAlt(ProjectImageView image) =>
        string.IsNullOrWhiteSpace(image.AltText) ? image.FileName : image.AltText;

    private static string FormatBytes(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024.0 / 1024.0:0.0} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private string MaskToolClass(string tool) =>
        string.Equals(_maskTool, tool, StringComparison.Ordinal) ? "btn-primary" : "btn-outline-secondary";

    private string BrushToolClass => $"btn {MaskToolClass("brush")}";

    private string EraserToolClass => $"btn {MaskToolClass("erase")}";

    private string PanToolClass => $"btn {MaskToolClass("pan")}";

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..max] + "...";

    public async ValueTask DisposeAsync()
    {
        ImageRuntime.StateChanged -= OnRuntimeStateChanged;
        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        if (_maskModule is not null)
        {
            try { await _maskModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
