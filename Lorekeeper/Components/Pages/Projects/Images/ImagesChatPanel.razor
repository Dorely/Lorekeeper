@using Lorekeeper.Components.Chat
@using Lorekeeper.ChatTurns
@using Lorekeeper.ImagesChat
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Lorekeeper.Tokens
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IImagesChatService ImagesChat
@inject IImagesChatTurnRunner ChatTurns
@inject ILlmProviderService Providers
@inject ITokenCounter TokenCounter

<ChatSurface Title="Images Chat"
             TokenText="@_conversationTokens.Text(ConversationTokenUnitLabel)"
             TokenTitle="@_conversationTokens.Title(ConversationTokenTitleLabel)"
             Loading="@_loading"
             Messages="@_renderable"
             Live="@_live"
             Error="@_error"
             OnClearError="ClearError"
             Input="@_input"
             InputChanged="SetInput"
             Placeholder="Ask for an image, edit, mask, or layout inspection..."
             Running="@_running"
             ComposerDisabled="@(ChatDisabled || _running)"
             SendDisabled="@(ChatDisabled || string.IsNullOrWhiteSpace(_input))"
             OnSend="SendAsync"
             OnStop="CancelAsync"
             ForceScrollKey="@_forceScrollKey"
             ScrollKey="@_scrollKey"
             AutoFollowKey="@_autoFollowKey"
             ResetComposerKey="@_resetComposerKey">
    <HeaderActions>
        <button type="button" class="btn btn-link btn-sm images-chat-reset" title="Start over" disabled="@(ChatDisabled || _running)" @onclick="ResetAsync">Reset</button>
    </HeaderActions>
    <ExtraControls>
        @if (_attachments.Count > 0)
        {
            <div class="images-chat-attachment-bar">
                <div class="images-chat-attachment-head">
                    <span>Attached to chat</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_running" @onclick="ClearAttachmentsAsync">Clear</button>
                </div>
                <div class="images-chat-attachment-list">
                    @foreach (var attachment in _attachments)
                    {
                        <span class="images-chat-attachment-chip" @key="attachment.Id">
                            <button type="button"
                                    class="images-chat-attachment-thumb"
                                    title="@($"View {attachment.Label}")"
                                    aria-label="@($"View {attachment.Label}")"
                                    @onclick="() => OpenAttachmentViewer(attachment)">
                                <img src="@attachment.PreviewImageUrl" alt="@attachment.Label" />
                            </button>
                            <span class="images-chat-attachment-text">
                                <small>Image</small>
                                <strong>@attachment.Label</strong>
                            </span>
                            <button type="button"
                                    class="images-chat-attachment-remove"
                                    title="Remove"
                                    disabled="@_running"
                                    @onclick="() => RemoveAttachmentAsync(attachment.Id)">x</button>
                        </span>
                    }
                </div>
            </div>
        }
        @if (ChatDisabled)
        {
            <div class="alert alert-warning py-2 small mb-2">
                LLM chat is disabled. <a class="alert-link" href="/settings/providers">Configure and test a chat provider</a>.
            </div>
        }
    </ExtraControls>
</ChatSurface>

@if (_viewingAttachment is not null)
{
    <ImageViewerModal ImageUrl="@_viewingAttachment.FullImageUrl"
                      Title="@_viewingAttachment.FileName"
                      AltText="@_viewingAttachment.AltText"
                      Details="@AttachmentViewerDetails(_viewingAttachment)"
                      Closed="CloseAttachmentViewer" />
}

@code {
    private const string ConversationTokenUnitLabel = "conversation tokens";
    private const string ConversationTokenTitleLabel = "conversation token count";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter] public EventCallback OnImagesChanged { get; set; }
    [Parameter] public int AttachmentRefreshKey { get; set; }

    private int _forceScrollKey;
    private int _scrollKey;
    private int _autoFollowKey;
    private int _resetComposerKey;
    private ProjectImageConversation? _conversation;
    private List<ProjectImageMessage> _messages = [];
    private List<ProjectImageChatAttachmentView> _attachments = [];
    private ProjectImageChatAttachmentView? _viewingAttachment;
    private List<ChatRenderableMessage> _renderable = [];
    private ChatLiveTurn? _live;
    private string _input = string.Empty;
    private bool _running;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _listenCts;
    private Guid? _listeningTurnId;
    private Guid? _loadedProjectId;
    private string? _pendingUserText;
    private string _systemPrompt = string.Empty;
    private ChatTranscriptTokenCount _conversationTokens = ChatTranscriptTokenCount.Empty;
    private ChatProviderAvailability? _chatAvailability;
    private int _seenAttachmentRefreshKey;

    private bool ChatDisabled => _chatAvailability?.IsAvailable != true;
    private string ChatDisabledMessage => _chatAvailability?.Message
        ?? "Configure and test a chat provider in Settings > Providers to enable LLM features.";

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == Guid.Empty) return;

        if (_loadedProjectId != ProjectId)
        {
            _loadedProjectId = ProjectId;
            _seenAttachmentRefreshKey = AttachmentRefreshKey;
            await LoadAsync();
            return;
        }

        if (_seenAttachmentRefreshKey != AttachmentRefreshKey)
        {
            _seenAttachmentRefreshKey = AttachmentRefreshKey;
            await LoadAttachmentsAsync();
        }
    }

    private async Task LoadAsync()
    {
        StopListening();
        _loading = true;
        try
        {
            _conversation = await ImagesChat.GetOrCreateAsync(ProjectId);
            _chatAvailability = await Providers.GetDefaultChatProviderAvailabilityAsync();
            _messages = (await ImagesChat.LoadMessagesAsync(_conversation.Id)).ToList();
            await LoadAttachmentsAsync();
            _systemPrompt = await ImagesChat.GetSystemPromptAsync(ProjectId);
            var activeTurn = ChatTurns.GetActiveTurn(ProjectId);
            RebuildRenderable(activeTurn?.StartedAtUtc);
            if (activeTurn is not null)
            {
                _renderable.Add(new ChatRenderableMessage(
                    Guid.NewGuid(),
                    ChatMessageRole.User,
                    ChatMessageStatus.Completed,
                    [new ChatTextPart(activeTurn.UserText)]));
                _pendingUserText = activeTurn.UserText;
                _live = new ChatLiveTurn();
                _running = true;
                await ListenToActiveTurnAsync(activeTurn);
            }
            else
            {
                _pendingUserText = null;
                _live = null;
                _running = false;
            }
            UpdateConversationTokenCount();
        }
        finally
        {
            _loading = false;
        }
        RequestScroll(force: true);
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (_running || string.IsNullOrWhiteSpace(text)) return;
        if (ChatDisabled)
        {
            _error = ChatDisabledMessage;
            return;
        }

        _input = string.Empty;
        _running = true;
        _error = null;
        _resetComposerKey++;

        _renderable.Add(new ChatRenderableMessage(
            Guid.NewGuid(),
            ChatMessageRole.User,
            ChatMessageStatus.Completed,
            BuildUserPendingParts(text)));
        _live = new ChatLiveTurn();
        _pendingUserText = text;
        UpdateConversationTokenCount();
        ResumeAutoFollow();
        RequestScroll(force: true);
        StateHasChanged();

        if (!ChatTurns.TryStart(ProjectId, text))
        {
            _error = "Images Chat already has a running turn.";
            ReleaseRunningUi();
            if (ChatTurns.GetActiveTurn(ProjectId) is { } existingTurn)
                await ListenToActiveTurnAsync(existingTurn);
            return;
        }

        if (ChatTurns.GetActiveTurn(ProjectId) is { } activeTurn)
            await ListenToActiveTurnAsync(activeTurn);
    }

    private async Task ResetAsync()
    {
        if (_running) return;
        await ImagesChat.ResetAsync(ProjectId);
        _loadedProjectId = null;
        await LoadAsync();
    }

    private async Task ListenToActiveTurnAsync(ChatTurnSnapshot activeTurn)
    {
        if (_listeningTurnId == activeTurn.TurnId)
            return;

        StopListening();
        var subscription = ChatTurns.Subscribe(ProjectId);
        if (subscription is null)
        {
            ReleaseRunningUi();
            return;
        }

        _listeningTurnId = subscription.TurnId;
        _listenCts = new CancellationTokenSource();
        _ = ListenToTurnAsync(subscription, _listenCts.Token);
        await Task.CompletedTask;
    }

    private void StopListening()
    {
        _listenCts?.Cancel();
        _listenCts?.Dispose();
        _listenCts = null;
        _listeningTurnId = null;
    }

    private async Task ListenToTurnAsync(
        IChatTurnSubscription<ImagesChatTurnUpdate> subscription,
        CancellationToken cancellationToken)
    {
        await using (subscription)
        {
            try
            {
                await foreach (var update in subscription.ReadAllAsync(cancellationToken))
                    await InvokeAsync(async () => await ApplyTurnUpdateAsync(update));
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ApplyTurnUpdateAsync(ImagesChatTurnUpdate update)
    {
        switch (update)
        {
            case ImagesChatTextDelta delta:
                _live!.AppendText(delta.Text);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ImagesChatToolCallStarted started:
                _live!.StartToolCall(started.CallId, started.ToolName, started.ArgumentsJson, started.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ImagesChatToolCallArgumentsDelta delta:
                _live!.AppendToolArguments(delta.CallId, delta.ArgumentsDelta, delta.ArgumentsComplete);
                UpdateConversationTokenCount();
                RequestScroll();
                StateHasChanged();
                break;
            case ImagesChatToolCallCompleted completed:
                _live!.CompleteToolCall(
                    completed.CallId,
                    completed.Result,
                    completed.Error,
                    completed.DurationMs,
                    completed.Visuals.Select(ToChatImageVisual).ToList());
                UpdateConversationTokenCount();
                await OnImagesChanged.InvokeAsync();
                RequestScroll();
                StateHasChanged();
                break;
            case ImagesChatMutated:
                await OnImagesChanged.InvokeAsync();
                break;
            case ImagesChatAssistantMessageCompleted:
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                await OnImagesChanged.InvokeAsync();
                RequestScroll();
                StateHasChanged();
                break;
            case ImagesChatTurnError error:
                _error = error.Cancelled ? null : error.Message;
                ReleaseRunningUi();
                await ReloadFromDbAsync();
                await OnImagesChanged.InvokeAsync();
                RequestScroll();
                StateHasChanged();
                break;
        }
    }

    private async Task LoadAttachmentsAsync()
    {
        _attachments = (await ImagesChat.ListAttachmentsAsync(ProjectId)).ToList();
        if (_viewingAttachment is not null)
            _viewingAttachment = _attachments.FirstOrDefault(attachment => attachment.Id == _viewingAttachment.Id);
    }

    private void OpenAttachmentViewer(ProjectImageChatAttachmentView attachment) => _viewingAttachment = attachment;

    private void CloseAttachmentViewer() => _viewingAttachment = null;

    private static IReadOnlyList<string> AttachmentViewerDetails(ProjectImageChatAttachmentView attachment) =>
        new[] { attachment.Label, attachment.AltText }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task RemoveAttachmentAsync(Guid attachmentId)
    {
        await ImagesChat.RemoveAttachmentAsync(ProjectId, attachmentId);
        await LoadAttachmentsAsync();
    }

    private async Task ClearAttachmentsAsync()
    {
        await ImagesChat.ClearAttachmentsAsync(ProjectId);
        await LoadAttachmentsAsync();
    }

    private void CancelAsync() => ChatTurns.Cancel(ProjectId);

    private void ReleaseRunningUi()
    {
        var wasRunning = _running;
        var hadLive = _live is not null;
        _running = false;
        _live = null;
        UpdateConversationTokenCount();
        RequestScroll();
        if (wasRunning || hadLive)
            StateHasChanged();
    }

    private async Task ReloadFromDbAsync()
    {
        if (_conversation is null) return;
        _messages = (await ImagesChat.LoadMessagesAsync(_conversation.Id)).ToList();
        _systemPrompt = await ImagesChat.GetSystemPromptAsync(ProjectId);
        RebuildRenderable();
        _pendingUserText = null;
        _live = null;
        UpdateConversationTokenCount();
    }

    private void RebuildRenderable(DateTime? excludeMessagesCreatedAtOrAfter = null)
    {
        var messages = excludeMessagesCreatedAtOrAfter is { } cutoff
            ? _messages.Where(message => message.CreatedAt < cutoff).ToList()
            : _messages;

        var byCallId = messages
            .Where(message => message.Role == ProjectImageMessageRole.Tool && message.ToolCallId is not null)
            .ToDictionary(message => message.ToolCallId!, message => message);

        _renderable = new List<ChatRenderableMessage>(messages.Count);
        foreach (var message in messages)
        {
            if (message.Role is ProjectImageMessageRole.Tool or ProjectImageMessageRole.System) continue;
            _renderable.Add(new ChatRenderableMessage(
                message.Id,
                message.Role == ProjectImageMessageRole.User ? ChatMessageRole.User : ChatMessageRole.Assistant,
                ToChatStatus(message.Status),
                BuildMessageParts(message, byCallId)));
        }
    }

    private static ChatMessageStatus ToChatStatus(ProjectImageMessageStatus status) => status switch
    {
        ProjectImageMessageStatus.Failed => ChatMessageStatus.Failed,
        ProjectImageMessageStatus.Cancelled => ChatMessageStatus.Cancelled,
        ProjectImageMessageStatus.Pending => ChatMessageStatus.Pending,
        _ => ChatMessageStatus.Completed,
    };

    private void UpdateConversationTokenCount()
    {
        _conversationTokens = ChatTranscriptTokenCounter.Count(
            TokenCounter,
            ModelReplayTokenMessages(),
            message => message,
            _live,
            _pendingUserText,
            _systemPrompt);
    }

    private IEnumerable<ChatTranscriptTokenMessage> ModelReplayTokenMessages()
    {
        foreach (var message in _messages)
        {
            var tokenMessage = ToModelReplayTokenMessage(message);
            if (tokenMessage is not null)
                yield return tokenMessage;
        }
    }

    private static ChatTranscriptTokenMessage? ToModelReplayTokenMessage(ProjectImageMessage message) => message.Role switch
    {
        ProjectImageMessageRole.System when !string.IsNullOrWhiteSpace(message.Content) => new(message.Role.ToString(), message.Content),
        ProjectImageMessageRole.User => new(message.Role.ToString(), message.Content),
        ProjectImageMessageRole.Assistant when !string.IsNullOrWhiteSpace(message.Content) => new(message.Role.ToString(), message.Content),
        _ => null,
    };

    private List<ChatMessagePart> BuildMessageParts(ProjectImageMessage message, IReadOnlyDictionary<string, ProjectImageMessage> byCallId)
    {
        if (message.Role != ProjectImageMessageRole.Assistant)
        {
            var messageParts = new List<ChatMessagePart>();
            if (!string.IsNullOrEmpty(message.Content))
                messageParts.Add(new ChatTextPart(message.Content));
            messageParts.AddRange(message.Visuals.OrderBy(visual => visual.SortOrder).Select(visual => new ChatImagePart(ToChatImageVisual(visual))));
            return messageParts;
        }

        var calls = ChatTranscriptHelpers.ReadPersistedCalls(message.ToolCallsJson);
        if (calls.Count == 0)
            return string.IsNullOrEmpty(message.Content) ? [] : [new ChatTextPart(message.Content)];

        var parts = new List<ChatMessagePart>();
        if (calls.All(call => call.TextOffset is not null))
        {
            var cursor = 0;
            foreach (var item in calls.Select((call, index) => new { Call = call, Index = index })
                                      .OrderBy(item => item.Call.TextOffset!.Value)
                                      .ThenBy(item => item.Index))
            {
                var offset = Math.Clamp(item.Call.TextOffset!.Value, 0, message.Content.Length);
                if (offset > cursor)
                {
                    parts.Add(new ChatTextPart(message.Content[cursor..offset]));
                    cursor = offset;
                }
                parts.Add(new ChatToolPart(BuildToolChip(item.Call, byCallId)));
            }
            if (cursor < message.Content.Length)
                parts.Add(new ChatTextPart(message.Content[cursor..]));
            return parts;
        }

        if (!string.IsNullOrEmpty(message.Content)) parts.Add(new ChatTextPart(message.Content));
        foreach (var call in calls) parts.Add(new ChatToolPart(BuildToolChip(call, byCallId)));
        return parts;
    }

    private ChatToolChip BuildToolChip(ChatPersistedToolCall call, IReadOnlyDictionary<string, ProjectImageMessage> byCallId)
    {
        byCallId.TryGetValue(call.CallId, out var resultMessage);
        var chip = new ChatToolChip(call.CallId, call.Name, call.ArgumentsJson)
        {
            Result = resultMessage?.Status == ProjectImageMessageStatus.Completed ? resultMessage.Content : null,
            Error = resultMessage?.Status == ProjectImageMessageStatus.Failed ? (resultMessage.ErrorMessage ?? resultMessage.Content) : null,
            Completed = resultMessage is not null,
        };

        if (resultMessage is not null)
            chip.Visuals.AddRange(resultMessage.Visuals.OrderBy(visual => visual.SortOrder).Select(ToChatImageVisual));
        return chip;
    }

    private ChatImageVisual ToChatImageVisual(ProjectImageMessageVisual visual)
    {
        var (previewUrl, fullUrl) = VisualUrls(visual);
        return new ChatImageVisual(
            visual.Id,
            visual.Title,
            visual.Caption,
            previewUrl,
            fullUrl,
            visual.Width,
            visual.Height,
            visual.ToolCallId);
    }

    private static ChatImageVisual ToChatImageVisual(ImagesChatVisualAttachment visual) =>
        new(
            visual.Id,
            visual.Title,
            visual.Caption,
            visual.PreviewImageUrl,
            visual.FullImageUrl,
            visual.Width,
            visual.Height,
            visual.ToolCallId);

    private List<ChatMessagePart> BuildUserPendingParts(string text)
    {
        var parts = new List<ChatMessagePart> { new ChatTextPart(text) };
        parts.AddRange(_attachments.Select(attachment => new ChatImagePart(ToChatImageVisual(attachment))));
        return parts;
    }

    private static ChatImageVisual ToChatImageVisual(ProjectImageChatAttachmentView attachment) =>
        new(
            attachment.Id,
            attachment.Label,
            "Attached to Images Chat context.",
            attachment.PreviewImageUrl,
            attachment.FullImageUrl,
            Width: null,
            Height: null);

    private (string PreviewUrl, string FullUrl) VisualUrls(ProjectImageMessageVisual visual)
    {
        if (string.Equals(visual.SourceKind, "projectImage", StringComparison.Ordinal)
            && visual.SourceRefId is { } imageId)
        {
            return ($"/projects/{ProjectId:N}/images/{imageId:N}/content?maxEdge=640", $"/projects/{ProjectId:N}/images/{imageId:N}/content");
        }

        return ($"/projects/{ProjectId:N}/image-chat-visuals/{visual.Id:N}/content?maxEdge=640", $"/projects/{ProjectId:N}/image-chat-visuals/{visual.Id:N}/content");
    }

    private void RequestScroll(bool force = false)
    {
        _scrollKey++;
        if (force) _forceScrollKey++;
    }

    private void ResumeAutoFollow() => _autoFollowKey++;

    private void SetInput(string value) => _input = value;

    private void ClearError() => _error = null;

    public ValueTask DisposeAsync()
    {
        StopListening();
        return ValueTask.CompletedTask;
    }
}
