@using Microsoft.JSInterop
@using Lorekeeper.Images
@using Lorekeeper.Models
@using Lorekeeper.Composition
@using Lorekeeper.Fonts
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IManuscriptStyleService Styles
@inject IManuscriptService Manuscripts
@inject IProjectImageService Images
@inject IProjectFontService Fonts
@inject Lorekeeper.Composition.ICompositionService Compositions

<div class="@RootClass()">
    <div @ref="_root"></div>
    @if (!string.IsNullOrWhiteSpace(_pasteWarning))
    {
        <div class="semantic-editor-warning" role="status">
            @_pasteWarning
            <button type="button" class="btn-close" aria-label="Dismiss paste warning" @onclick="() => _pasteWarning = null"></button>
        </div>
    }
    @if (_conflictDraftJson is not null && _conflictCurrentJson is not null)
    {
        <div class="semantic-editor-warning semantic-editor-conflict" role="alert">
            <strong>This chapter changed elsewhere.</strong>
            Your local draft is preserved and editing is paused. Download it before choosing the current saved version.
            <div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="DownloadConflictDraftAsync">
                    Download local draft
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadCurrentAfterConflictAsync">
                    Load current saved version
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public string InitialManuscriptJson { get; set; } = string.Empty;
    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public EventCallback<Guid> OpenDesignedPage { get; set; }
    [Parameter] public EventCallback OpenProjectImagePicker { get; set; }
    [Parameter] public EventCallback OpenBookTextStyles { get; set; }
    [Parameter] public EventCallback StyleCatalogChanged { get; set; }
    [Parameter, EditorRequired]
    public Func<Guid, long, string, Task<SemanticEditorSaveResult>> SaveAsync { get; set; } = null!;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ChapterBodyEditor>? _selfRef;
    private bool? _appliedReadOnly;
    private bool _initializing;
    private bool _disposed;
    private bool _disposing;
    private string? _pasteWarning;
    private string? _conflictDraftJson;
    private string? _conflictCurrentJson;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _disposing)
            return;

        if (_handle is null && !_initializing)
        {
            _initializing = true;
            try
            {
                var stylesJson = JsonSerializer.Serialize(
                    await Styles.ListAsync(ProjectId),
                    ManuscriptCodec.JsonOptions);
                var imagesJson = JsonSerializer.Serialize(
                    (await Images.ListAsync(ProjectId)).Where(image => image.ContentType is "image/png" or "image/jpeg"),
                    ManuscriptCodec.JsonOptions);
                var compositionsJson = JsonSerializer.Serialize(
                    await LoadDesignedPageSummariesAsync(),
                    ManuscriptCodec.JsonOptions);
                var fontFamiliesJson = JsonSerializer.Serialize(
                    await Fonts.ListAsync(ProjectId),
                    ManuscriptCodec.JsonOptions);
                if (_disposed || _disposing)
                    return;

                if (_module is null)
                {
                    var importedModule = await JS.InvokeAsync<IJSObjectReference>(
                        "import", "./js/semantic-editor.bundle.js");
                    if (_disposed || _disposing)
                    {
                        try { await importedModule.DisposeAsync(); } catch { }
                        return;
                    }
                    _module = importedModule;
                }
                if (_disposed || _disposing)
                    return;

                var handle = await _module.InvokeAsync<IJSObjectReference?>(
                    "attach",
                    _root,
                    (_selfRef ??= DotNetObjectReference.Create(this)),
                    750,
                    InitialManuscriptJson,
                    stylesJson,
                    imagesJson,
                    "[]",
                    compositionsJson,
                    fontFamiliesJson);
                if (_disposed || _disposing)
                {
                    if (handle is not null)
                    {
                        try { await handle.InvokeVoidAsync("dispose"); } catch { }
                        try { await handle.DisposeAsync(); } catch { }
                    }
                    return;
                }
                _handle = handle;
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) when (_disposing || _disposed) { }
            finally
            {
                _initializing = false;
            }
        }

        if (_handle is not null && _appliedReadOnly != IsReadOnly)
        {
            await ApplyReadOnlyAsync(IsReadOnly);
            _appliedReadOnly = IsReadOnly;
        }
    }

    [JSInvokable]
    public async Task<object> OnCreateDesignedPage(
        string name,
        string layoutMode,
        int blockIndex,
        long expectedRevision)
    {
        if (!Enum.TryParse<DesignedPageLayoutMode>(layoutMode, ignoreCase: true, out var parsedLayoutMode))
            throw new ArgumentException("Choose a supported Designed Page layout.", nameof(layoutMode));
        var result = await Compositions.CreateDesignedPageAsync(
            ProjectId,
            ChapterId,
            blockIndex,
            name,
            expectedRevision,
            new DesignedPageInitialContent { LayoutMode = parsedLayoutMode });
        return new
        {
            id = result.Composition.Id,
            result.Composition.Name,
            manuscriptJson = ManuscriptCodec.Serialize(result.Manuscript.Document),
            summary = BuildDesignedPageSummary(result.Composition),
        };
    }

    [JSInvokable]
    public Task OnOpenDesignedPage(Guid compositionId) => OpenDesignedPage.InvokeAsync(compositionId);

    [JSInvokable]
    public Task OnOpenProjectImagePicker() => OpenProjectImagePicker.InvokeAsync();

    [JSInvokable]
    public Task OnOpenBookTextStyles() => OpenBookTextStyles.InvokeAsync();

    public async Task SelectProjectImageAsync(ProjectImageView image)
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            await _handle.InvokeVoidAsync("selectProjectImage", image);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    [JSInvokable]
    public async Task<object> OnCreateParagraphStyleFromBlock(
        string name,
        string blockId,
        long expectedRevision)
    {
        var snapshot = await Manuscripts.GetManuscriptAsync(ChapterId)
            ?? throw new InvalidOperationException("The chapter manuscript was not found.");
        if (snapshot.Revision != expectedRevision)
            throw new ManuscriptRevisionConflictException(expectedRevision, snapshot.Revision);
        var block = snapshot.Document.Content.FirstOrDefault(candidate =>
                string.Equals(candidate.Id, blockId, StringComparison.Ordinal))
            ?? throw new InvalidOperationException("The selected paragraph was not found.");
        var definition = ManuscriptStyleTemplateExtractor.Extract(
            block,
            await Styles.ListAsync(ProjectId));
        var style = await Styles.UpsertAsync(
            ProjectId,
            new ManuscriptStyleInput(
                null,
                name,
                ManuscriptStyleKind.Paragraph,
                ManuscriptStyleService.RoleFromName(name),
                definition));
        await StyleCatalogChanged.InvokeAsync();
        return new
        {
            style.Id,
            style.Name,
            kind = style.Kind.ToString().ToLowerInvariant(),
            style.SemanticRole,
            style.Definition,
            style.Revision,
        };
    }

    private async Task<IReadOnlyList<DesignedPageEditorSummary>> LoadDesignedPageSummariesAsync()
    {
        var document = ManuscriptCodec.Deserialize(InitialManuscriptJson);
        var summaries = new List<DesignedPageEditorSummary>();
        foreach (var compositionId in document.Content
            .Where(block => block.Type == ManuscriptBlockType.DesignedPage && block.PageCompositionId is not null)
            .Select(block => block.PageCompositionId!.Value)
            .Distinct())
        {
            if (await Compositions.GetAsync(ProjectId, compositionId) is { } composition)
                summaries.Add(BuildDesignedPageSummary(composition));
        }
        return summaries;
    }

    private DesignedPageEditorSummary BuildDesignedPageSummary(PageComposition composition)
    {
        CompositionScene? selectedScene = null;
        foreach (var variant in composition.Variants.OrderByDescending(item => item.UpdatedAt))
        {
            CompositionScene? scene;
            try
            {
                scene = JsonSerializer.Deserialize<CompositionScene>(variant.SceneJson, ManuscriptCodec.JsonOptions);
            }
            catch (JsonException)
            {
                continue;
            }
            if (scene is null)
                continue;
            selectedScene ??= scene;
            if (scene.Objects.Count > 0)
            {
                selectedScene = scene;
                break;
            }
        }

        var firstImageId = selectedScene?.Objects
            .Where(item => item.Visible && item.Kind == CompositionObjectKind.Image && item.ImageId is not null)
            .OrderBy(item => item.ZIndex)
            .Select(item => item.ImageId)
            .FirstOrDefault();
        var previewUrl = firstImageId is Guid imageId
            ? $"/projects/{ProjectId:N}/images/{imageId:N}/content?maxEdge=720"
            : null;
        var surfaceLabel = selectedScene?.Surface.Kind switch
        {
            CompositionSurfaceKind.FacingSpread => "Facing spread",
            CompositionSurfaceKind.IndependentPage => "Independent page",
            CompositionSurfaceKind.SinglePage => "Single page",
            _ => "Geometry not configured",
        };
        var imageCount = selectedScene?.Objects.Count(item => item.Visible && item.Kind == CompositionObjectKind.Image) ?? 0;
        var objectCount = selectedScene?.Objects.Count(item => item.Visible) ?? 0;
        var status = selectedScene is null
            ? "No layout variant"
            : objectCount == 0
                ? "Empty layout"
                : imageCount == 1 && objectCount == 1
                    ? "1 image"
                    : $"{objectCount} objects · {imageCount} images";
        return new DesignedPageEditorSummary(
            composition.Id,
            composition.Name,
            surfaceLabel,
            status,
            previewUrl);
    }

    [JSInvokable]
    public async Task<SemanticEditorSaveResult> OnDocumentDebounced(
        long expectedRevision,
        string manuscriptJson)
    {
        if (_disposed || SaveAsync is null)
            return new SemanticEditorSaveResult(false, expectedRevision);

        return await SaveAsync(ChapterId, expectedRevision, manuscriptJson);
    }

    [JSInvokable]
    public Task OnPasteNormalized(string[] warnings)
    {
        if (warnings.Length > 0)
        {
            _pasteWarning = "Paste normalization: " + string.Join("; ", warnings);
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnConflictPreserved(string localDraftJson, string currentManuscriptJson)
    {
        _conflictDraftJson = localDraftJson;
        _conflictCurrentJson = currentManuscriptJson;
        return InvokeAsync(StateHasChanged);
    }

    private async Task DownloadConflictDraftAsync()
    {
        if (_handle is null)
            return;
        await _handle.InvokeAsync<bool>(
            "downloadConflictDraft",
            $"lorekeeper-manuscript-conflict-{ChapterId:N}.json");
    }

    private async Task ReloadCurrentAfterConflictAsync()
    {
        if (_handle is null || _conflictCurrentJson is null)
            return;
        await _handle.InvokeVoidAsync(
            "resolveConflictWithCurrent",
            _conflictCurrentJson,
            IsReadOnly);
        _conflictDraftJson = null;
        _conflictCurrentJson = null;
    }

    public async Task<bool> FlushAsync()
    {
        if (_disposed || _handle is null)
            return true;

        try
        {
            return await _handle.InvokeAsync<bool>("flush");
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (JSException)
        {
            return false;
        }
    }

    public async Task ApplyReadOnlyAsync(bool readOnly)
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            await _handle.InvokeVoidAsync("setReadOnly", readOnly);
            _appliedReadOnly = readOnly;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    private string RootClass()
    {
        var classes = "chapter-edit-surface semantic-editor";
        if (!IsVisible)
            classes += " chapter-edit-surface--hidden";
        if (IsReadOnly)
            classes += " chapter-edit-surface--locked";
        return classes;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed || _disposing)
            return;

        _disposing = true;
        if (_handle is not null)
        {
            try { await _handle.InvokeAsync<bool>("flush"); } catch { }
            try { await _handle.InvokeAsync<bool>("waitForSaves"); } catch { }
            try { await _handle.InvokeVoidAsync("dispose"); } catch { }
            try { await _handle.DisposeAsync(); } catch { }
            _handle = null;
        }
        _disposed = true;

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
        _selfRef?.Dispose();
        _disposing = false;
    }

    public sealed record SemanticEditorSaveResult(
        bool Saved,
        long Revision,
        bool Conflict = false,
        string? CurrentManuscriptJson = null);

    private sealed record DesignedPageEditorSummary(
        Guid Id,
        string Name,
        string SurfaceLabel,
        string Status,
        string? PreviewUrl);
}
