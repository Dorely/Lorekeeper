@using Microsoft.JSInterop
@using Lorekeeper.Images
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IManuscriptStyleService Styles
@inject IProjectImageService Images

<div class="@RootClass()">
    <div @ref="_root"></div>
    @if (!string.IsNullOrWhiteSpace(_pasteWarning))
    {
        <div class="semantic-editor-warning" role="status">
            @_pasteWarning
            <button type="button" class="btn-close" aria-label="Dismiss paste warning" @onclick="() => _pasteWarning = null"></button>
        </div>
    }
    @if (_conflictDraftJson is not null && _conflictCurrentJson is not null)
    {
        <div class="semantic-editor-warning semantic-editor-conflict" role="alert">
            <strong>This chapter changed elsewhere.</strong>
            Your local draft is preserved and editing is paused. Download it before choosing the current saved version.
            <div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="DownloadConflictDraftAsync">
                    Download local draft
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadCurrentAfterConflictAsync">
                    Load current saved version
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public string InitialManuscriptJson { get; set; } = string.Empty;
    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter, EditorRequired]
    public Func<Guid, long, string, Task<SemanticEditorSaveResult>> SaveAsync { get; set; } = null!;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ChapterBodyEditor>? _selfRef;
    private bool? _appliedReadOnly;
    private bool _disposed;
    private bool _disposing;
    private string? _pasteWarning;
    private string? _conflictDraftJson;
    private string? _conflictCurrentJson;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (_handle is null)
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/semantic-editor.bundle.js");
                _handle = await _module.InvokeAsync<IJSObjectReference>(
                    "attach",
                    _root,
                    (_selfRef ??= DotNetObjectReference.Create(this)),
                    750,
                    InitialManuscriptJson,
                    JsonSerializer.Serialize(
                        await Styles.ListAsync(ProjectId),
                        ManuscriptCodec.JsonOptions),
                    JsonSerializer.Serialize(
                        await Images.ListAsync(ProjectId),
                        ManuscriptCodec.JsonOptions));
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }

        if (_handle is not null && _appliedReadOnly != IsReadOnly)
        {
            await ApplyReadOnlyAsync(IsReadOnly);
            _appliedReadOnly = IsReadOnly;
        }
    }

    [JSInvokable]
    public async Task<SemanticEditorSaveResult> OnDocumentDebounced(
        long expectedRevision,
        string manuscriptJson)
    {
        if (_disposed || SaveAsync is null)
            return new SemanticEditorSaveResult(false, expectedRevision);

        return await SaveAsync(ChapterId, expectedRevision, manuscriptJson);
    }

    [JSInvokable]
    public Task OnPasteNormalized(string[] warnings)
    {
        if (warnings.Length > 0)
        {
            _pasteWarning = "Paste normalization: " + string.Join("; ", warnings);
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnConflictPreserved(string localDraftJson, string currentManuscriptJson)
    {
        _conflictDraftJson = localDraftJson;
        _conflictCurrentJson = currentManuscriptJson;
        return InvokeAsync(StateHasChanged);
    }

    private async Task DownloadConflictDraftAsync()
    {
        if (_handle is null)
            return;
        await _handle.InvokeAsync<bool>(
            "downloadConflictDraft",
            $"lorekeeper-manuscript-conflict-{ChapterId:N}.json");
    }

    private async Task ReloadCurrentAfterConflictAsync()
    {
        if (_handle is null || _conflictCurrentJson is null)
            return;
        await _handle.InvokeVoidAsync(
            "resolveConflictWithCurrent",
            _conflictCurrentJson,
            IsReadOnly);
        _conflictDraftJson = null;
        _conflictCurrentJson = null;
    }

    public async Task<bool> FlushAsync()
    {
        if (_disposed || _handle is null)
            return true;

        try
        {
            return await _handle.InvokeAsync<bool>("flush");
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (JSException)
        {
            return false;
        }
    }

    public async Task ApplyReadOnlyAsync(bool readOnly)
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            await _handle.InvokeVoidAsync("setReadOnly", readOnly);
            _appliedReadOnly = readOnly;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    private string RootClass()
    {
        var classes = "chapter-edit-surface semantic-editor";
        if (!IsVisible)
            classes += " chapter-edit-surface--hidden";
        if (IsReadOnly)
            classes += " chapter-edit-surface--locked";
        return classes;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed || _disposing)
            return;

        _disposing = true;
        if (_handle is not null)
        {
            try { await _handle.InvokeAsync<bool>("flush"); } catch { }
            try { await _handle.InvokeAsync<bool>("waitForSaves"); } catch { }
            try { await _handle.InvokeVoidAsync("dispose"); } catch { }
            try { await _handle.DisposeAsync(); } catch { }
            _handle = null;
        }
        _disposed = true;

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
        _selfRef?.Dispose();
        _disposing = false;
    }

    public sealed record SemanticEditorSaveResult(
        bool Saved,
        long Revision,
        bool Conflict = false,
        string? CurrentManuscriptJson = null);
}
