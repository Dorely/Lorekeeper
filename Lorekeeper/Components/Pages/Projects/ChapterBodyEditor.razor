@using Microsoft.JSInterop
@using Lorekeeper.Images
@using Lorekeeper.Models
@using Lorekeeper.Composition
@using Lorekeeper.Fonts
@using Lorekeeper.Authoring
@using Lorekeeper.Diagnostics
@using Lorekeeper.Sources
@using Lorekeeper.Manuscripts.Import
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IManuscriptStyleService Styles
@inject IManuscriptService Manuscripts
@inject IManuscriptAnnotationService Annotations
@inject IProjectImageService Images
@inject IProjectFontService Fonts
@inject IProjectPageSetupService PageSetups
@inject ITypographyDefaultsService TypographyDefaults
@inject IDesignedPageService DesignedPages
@inject IAuthoringBatchService AuthoringBatches
@inject IAuthoringMutationFence AuthoringFence
@inject IPerformanceTraceWriter PerformanceTrace
@inject IProjectSourcesService Sources
@inject ISemanticImportService SemanticImports
@inject ILogger<ChapterBodyEditor> Logger

<div class="@RootClass()">
    <div @ref="_root"></div>
    @if (!string.IsNullOrWhiteSpace(_initializationError))
    {
        <div class="semantic-editor-warning" role="alert">
            <span>@_initializationError</span>
            <button type="button" class="btn btn-sm btn-outline-warning" @onclick="RetryInitialization" disabled="@(_disposed || _disposing)">Retry</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_pasteWarning))
    {
        <div class="semantic-editor-warning" role="status">
            @_pasteWarning
            <button type="button" class="btn-close" aria-label="Dismiss paste warning" @onclick="() => _pasteWarning = null"></button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ChapterId { get; set; }
    [Parameter] public EditorContentTarget ContentTarget { get; set; } = EditorContentTarget.Core;
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public string InitialManuscriptJson { get; set; } = string.Empty;
    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool AllowAnnotations { get; set; } = true;
    [Parameter] public bool AllowDesignedPages { get; set; } = true;
    [Parameter] public EventCallback<Guid> OpenDesignedPage { get; set; }
    [Parameter] public EventCallback OpenProjectImagePicker { get; set; }
    [Parameter] public EventCallback OpenBookTextStyles { get; set; }
    [Parameter] public EventCallback StyleCatalogChanged { get; set; }
    [Parameter] public EventCallback AnnotationsChanged { get; set; }
    [Parameter] public EventCallback<Guid> AnnotationSelected { get; set; }
    [Parameter] public EventCallback<AuthoringBatchResultV1> AuthoringSaved { get; set; }
    [Parameter] public EventCallback OpenPageLibrary { get; set; }
    [Parameter] public Func<long, Task<ManuscriptDocument>>? ReadDocumentOverrideAsync { get; set; }
    [Parameter] public string? AuthoringTargetIdOverride { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ChapterBodyEditor>? _selfRef;
    private bool? _appliedReadOnly;
    private bool? _appliedVisible;
    private long? _appliedTypographyRevision;
    private bool _initializing;
    private bool _disposed;
    private bool _disposing;
    private string? _initializationError;
    private string? _pasteWarning;
    private CancellationTokenSource? _importCancellation;

    [JSInvokable]
    public Task<string> ReadWordDocx(byte[] bytes) =>
        ReadWordAsync(token => SemanticImports.ReadDocxAsync(bytes, token));

    [JSInvokable]
    public Task<string> ReadWordClipboard(string html, IReadOnlyList<SemanticImportImage> images) =>
        ReadWordAsync(token => SemanticImports.ReadWordHtmlAsync(html, images, token));

    [JSInvokable]
    public void CancelWordImport() => _importCancellation?.Cancel();

    private async Task<string> ReadWordAsync(Func<CancellationToken, Task<SemanticImportFragment>> read)
    {
        ObjectDisposedException.ThrowIf(_disposed || _disposing, this);
        if (IsReadOnly || _importCancellation is not null)
            throw new InvalidOperationException("This editor cannot start another import now.");
        using var cancellation = new CancellationTokenSource();
        _importCancellation = cancellation;
        try { return JsonSerializer.Serialize(await read(cancellation.Token), ManuscriptCodec.JsonOptions); }
        finally { _importCancellation = null; }
    }
    private ManuscriptViewLocation? _pendingLocation;
    private IAsyncDisposable? _authoringWriterLease;
    private Guid? _authoringSessionId;
    private readonly Guid _authoringWriterId = Guid.NewGuid();
    private long _authoringGeneration;
    private long _highestAuthoringSequence;
    private long _lastDispatchedAuthoringSequence;
    private long _lastAcknowledgedAuthoringSequence;
    private bool _authoringDirty;
    private bool _authoringRecoverable = true;

    [JSInvokable]
    public async Task<IReadOnlyList<ProjectBibliographicRecordItem>> ListCitationBibliography()
    {
        ObjectDisposedException.ThrowIf(_disposed || _disposing, this);
        return await Sources.ListBibliographyAsync(ProjectId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _disposing)
            return;

        if (_handle is null && !_initializing && _initializationError is null)
        {
            _initializing = true;
            try
            {
                var stylesJson = JsonSerializer.Serialize(
                    await Styles.ListAsync(ProjectId),
                    ManuscriptCodec.JsonOptions);
                var imagesJson = JsonSerializer.Serialize(
                    (await Images.ListAsync(ProjectId)).Where(image => image.ContentType is "image/png" or "image/jpeg"),
                    ManuscriptCodec.JsonOptions);
                var compositionsJson = JsonSerializer.Serialize(
                    await LoadDesignedPageSummariesAsync(),
                    ManuscriptCodec.JsonOptions);
                var fontFamiliesJson = JsonSerializer.Serialize(
                    await Fonts.ListAsync(ProjectId),
                    ManuscriptCodec.JsonOptions);
                var pageSetup = await PageSetups.GetOrCreateAsync(ProjectId);
                var typographyJson = JsonSerializer.Serialize(
                    TypographyDefaults.CreateEditorConfiguration(pageSetup),
                    ManuscriptCodec.JsonOptions);
                var annotationsJson = AllowAnnotations
                    ? JsonSerializer.Serialize(
                        await Annotations.ListChapterAsync(ProjectId, ContentTarget, ChapterId),
                        ManuscriptCodec.JsonOptions)
                    : "[]";
                if (_disposed || _disposing)
                    return;

                if (_module is null)
                {
                    var importedModule = await JS.InvokeAsync<IJSObjectReference>(
                        "import", "./js/semantic-editor.bundle.js");
                    if (_disposed || _disposing)
                    {
                        try { await importedModule.DisposeAsync(); } catch { }
                        return;
                    }
                    _module = importedModule;
                }
                if (_disposed || _disposing)
                    return;

                var handle = await _module.InvokeAsync<IJSObjectReference?>(
                    "attach",
                    _root,
                    (_selfRef ??= DotNetObjectReference.Create(this)),
                    500,
                    InitialManuscriptJson,
                    stylesJson,
                    imagesJson,
                    "[]",
                    compositionsJson,
                    fontFamiliesJson,
                    AllowDesignedPages,
                    annotationsJson,
                    typographyJson,
                    AllowAnnotations,
                    PerformanceTrace.IsEnabled,
                    JsonSerializer.Serialize(new
                    {
                        projectId = ProjectId,
                        targetId = AuthoringTargetId(),
                    }, ManuscriptCodec.JsonOptions));
                if (_disposed || _disposing)
                {
                    if (handle is not null)
                    {
                        try { await handle.InvokeVoidAsync("dispose"); } catch { }
                        try { await handle.DisposeAsync(); } catch { }
                    }
                    return;
                }
                _handle = handle;
                _appliedTypographyRevision = pageSetup.Revision;
                if (_handle is not null)
                {
                    await RegisterAuthoringWriterAsync();
                    await _handle.InvokeVoidAsync("reportWriterState");
                }
                await ApplyPendingLocationAsync();
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) when (_disposing || _disposed) { }
            catch (KeyNotFoundException exception)
            {
                await DisposeFailedInitializationAsync();
                await SetInitializationErrorAsync(
                    "The selected chapter or content target is no longer available. Retry or reload the editor.",
                    exception,
                    LogLevel.Warning);
            }
            catch (Exception exception)
            {
                await DisposeFailedInitializationAsync();
                await SetInitializationErrorAsync(
                    "The manuscript editor could not be initialized. Retry or reload the page.",
                    exception,
                    LogLevel.Error);
            }
            finally
            {
                _initializing = false;
            }
        }

        if (_handle is not null && _appliedReadOnly != IsReadOnly)
        {
            await ApplyReadOnlyAsync(IsReadOnly);
            _appliedReadOnly = IsReadOnly;
        }

        if (_handle is not null && _appliedVisible != IsVisible)
        {
            if (IsVisible)
            {
                await RefreshTypographyAsync();
                if (!IsReadOnly)
                    await FocusAsync();
            }
            _appliedVisible = IsVisible;
        }
    }

    [JSInvokable]
    public Task OnOpenPageLibrary() => OpenPageLibrary.InvokeAsync();

    public sealed record PageInsertionPosition(int Index, long Revision);

    public async Task<PageInsertionPosition> CapturePageInsertionAsync()
    {
        if (_handle is null)
            throw new InvalidOperationException("The manuscript editor is not ready.");
        return await _handle.InvokeAsync<PageInsertionPosition>("capturePageInsertion");
    }

    [JSInvokable]
    public Task OnOpenDesignedPage(Guid compositionId) => OpenDesignedPage.InvokeAsync(compositionId);

    [JSInvokable]
    public Task OnOpenProjectImagePicker() => OpenProjectImagePicker.InvokeAsync();

    [JSInvokable]
    public Task OnOpenBookTextStyles() => OpenBookTextStyles.InvokeAsync();

    [JSInvokable]
    public async Task<ManuscriptAnnotationView> OnCreateAnnotation(
        string kind,
        string noteText,
        ManuscriptAnnotationRange range,
        long expectedManuscriptRevision)
    {
        if (!AllowAnnotations)
            throw new InvalidOperationException("Review annotations are not available in this editor.");
        var parsedKind = Enum.TryParse<ManuscriptAnnotationKind>(kind, ignoreCase: true, out var value)
            ? value
            : throw new InvalidDataException("Choose a supported review annotation kind.");
        var annotation = await Annotations.CreateAsync(
            ProjectId,
            ContentTarget,
            ChapterId,
            parsedKind,
            noteText,
            range,
            expectedManuscriptRevision);
        await AnnotationsChanged.InvokeAsync();
        return annotation;
    }

    [JSInvokable]
    public Task OnAnnotationSelected(Guid annotationId) =>
        AllowAnnotations ? AnnotationSelected.InvokeAsync(annotationId) : Task.CompletedTask;

    [JSInvokable]
    public Task<IReadOnlyList<ManuscriptAnnotationView>> GetReviewAnnotations() =>
        AllowAnnotations
            ? Annotations.ListChapterAsync(ProjectId, ContentTarget, ChapterId)
            : Task.FromResult<IReadOnlyList<ManuscriptAnnotationView>>([]);

    public async Task<ManuscriptAnnotationRange?> GetAnnotationRangeAsync()
    {
        if (!AllowAnnotations || _disposed || _handle is null)
            return null;
        try { return await _handle.InvokeAsync<ManuscriptAnnotationRange>("getAnnotationRange"); }
        catch (JSException) { return null; }
        catch (JSDisconnectedException) { return null; }
    }

    public async Task SelectAnnotationAsync(Guid annotationId)
    {
        if (!AllowAnnotations || _disposed || _handle is null)
            return;
        try { await _handle.InvokeVoidAsync("selectAnnotation", annotationId); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    public async Task SetAnnotationsAsync(IReadOnlyList<ManuscriptAnnotationView> annotations)
    {
        if (!AllowAnnotations || _disposed || _handle is null)
            return;
        try
        {
            await _handle.InvokeVoidAsync(
                "setAnnotations",
                JsonSerializer.Serialize(annotations, ManuscriptCodec.JsonOptions));
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    public async Task SelectProjectImageAsync(ProjectImageView image)
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            await _handle.InvokeVoidAsync("selectProjectImage", image);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    [JSInvokable]
    public async Task<object> OnCreateParagraphStyleFromBlock(
        string name,
        string blockId,
        long expectedRevision)
    {
        var document = ReadDocumentOverrideAsync is null
            ? (await Manuscripts.GetManuscriptAsync(ContentTarget, ChapterId)
                ?? throw new InvalidOperationException("The chapter manuscript was not found.")).Document
            : await ReadDocumentOverrideAsync(expectedRevision);
        if (document.Revision != expectedRevision)
            throw new ManuscriptRevisionConflictException(expectedRevision, document.Revision);
        var block = document.Content.FirstOrDefault(candidate =>
                string.Equals(candidate.Id, blockId, StringComparison.Ordinal))
            ?? throw new InvalidOperationException("The selected paragraph was not found.");
        var definition = ManuscriptStyleTemplateExtractor.Extract(
            block,
            await Styles.ListAsync(ProjectId));
        var style = await Styles.UpsertAsync(
            ProjectId,
            new ManuscriptStyleInput(
                null,
                name,
                ManuscriptStyleKind.Paragraph,
                ManuscriptStyleService.RoleFromName(name),
                definition));
        await StyleCatalogChanged.InvokeAsync();
        return new
        {
            style.Id,
            style.Name,
            kind = style.Kind.ToString().ToLowerInvariant(),
            style.SemanticRole,
            style.Definition,
            style.Revision,
        };
    }

    private async Task<IReadOnlyList<DesignedPageEditorSummary>> LoadDesignedPageSummariesAsync()
    {
        return (await DesignedPages.ListAsync(ProjectId, ContentTarget))
            .OrderBy(page => page.Page.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(page => page.Page.Id)
            .Select(BuildDesignedPageSummary)
            .ToList();
    }

    private DesignedPageEditorSummary BuildDesignedPageSummary(DesignedPageView page)
    {
        CompositionScene? selectedScene = null;
        foreach (var variant in page.Content.Variants.OrderByDescending(item => item.UpdatedAt))
        {
            CompositionScene? scene;
            try
            {
                scene = JsonSerializer.Deserialize<CompositionScene>(variant.SceneJson, ManuscriptCodec.JsonOptions);
            }
            catch (JsonException)
            {
                continue;
            }
            if (scene is null)
                continue;
            selectedScene ??= scene;
            if (scene.Objects.Count > 0)
            {
                selectedScene = scene;
                break;
            }
        }

        var firstImageId = selectedScene?.Objects
            .Where(item => item.Visible && item.Kind == CompositionObjectKind.Image && item.ImageId is not null)
            .OrderBy(item => item.ZIndex)
            .Select(item => item.ImageId)
            .FirstOrDefault();
        var previewUrl = firstImageId is Guid imageId
            ? $"/projects/{ProjectId:N}/images/{imageId:N}/content?maxEdge=720"
            : null;
        var surfaceLabel = selectedScene?.Surface.Kind switch
        {
            CompositionSurfaceKind.FacingSpread => "Facing spread",
            CompositionSurfaceKind.IndependentPage => "Independent page",
            CompositionSurfaceKind.SinglePage => "Single page",
            _ => "Geometry not configured",
        };
        var imageCount = selectedScene?.Objects.Count(item => item.Visible && item.Kind == CompositionObjectKind.Image) ?? 0;
        var objectCount = selectedScene?.Objects.Count(item => item.Visible) ?? 0;
        var status = selectedScene is null
            ? "No layout variant"
            : objectCount == 0
                ? "Empty layout"
                : imageCount == 1 && objectCount == 1
                    ? "1 image"
                    : $"{objectCount} objects · {imageCount} images";
        return new DesignedPageEditorSummary(
            page.Page.Id,
            page.Page.Name,
            surfaceLabel,
            status,
            previewUrl);
    }

    [JSInvokable]
    public async Task<AuthoringSessionOpenResultV1> InitializeAuthoringSession(JsonElement request)
    {
        var projectId = request.GetProperty("projectId").GetGuid();
        var sessionId = request.GetProperty("sessionId").GetGuid();
        var protocolId = request.GetProperty("protocolId").GetString();
        var targets = request.GetProperty("targets");
        if (projectId != ProjectId
            || !string.Equals(protocolId, AuthoringProtocolV1.ProtocolId, StringComparison.Ordinal)
            || targets.GetArrayLength() != 1
            || !string.Equals(targets[0].GetProperty("targetId").GetString(), AuthoringTargetId(), StringComparison.Ordinal))
        {
            throw new InvalidOperationException("The authoring session does not match this editor target.");
        }

        var opened = await AuthoringBatches.OpenSessionAsync(new(
            ProjectId,
            sessionId,
            [new AuthoringSessionTargetV1(AuthoringTargetId())]));
        _authoringSessionId = opened.SessionId;
        _authoringGeneration = opened.Targets.Single().Generation;
        return opened;
    }

    [JSInvokable]
    public async Task<JsonElement> DispatchAuthoringBatch(JsonElement payload)
    {
        var batch = payload.Deserialize<AuthoringBatchV1>(ManuscriptCodec.JsonOptions)
            ?? throw new InvalidDataException("The authoring batch is missing.");
        ValidateAuthoringBatch(batch);
        var result = await AuthoringBatches.ApplyBatchAsync(batch, payload);
        if (result.Status is AuthoringBatchStatusV1.Committed or AuthoringBatchStatusV1.Replayed)
        {
            await AuthoringSaved.InvokeAsync(result);
            if (batch.ImportResources?.Styles.Count > 0) await StyleCatalogChanged.InvokeAsync();
        }
        return JsonSerializer.SerializeToElement(result, ManuscriptCodec.JsonOptions);
    }

    [JSInvokable]
    public Task AcknowledgeAuthoringReceipt(AuthoringReceiptAcknowledgementV1 acknowledgement)
    {
        if (acknowledgement.ProjectId != ProjectId)
            throw new InvalidOperationException("The authoring receipt does not match this project.");
        return AuthoringBatches.AcknowledgeReceiptAsync(acknowledgement);
    }

    [JSInvokable]
    public async Task<JsonElement> OnUndoAuthoringBatch(AuthoringHistoryRequestV1 request)
    {
        ValidateAuthoringHistoryRequest(request);
        return JsonSerializer.SerializeToElement(await AuthoringBatches.UndoAsync(request), ManuscriptCodec.JsonOptions);
    }

    [JSInvokable]
    public async Task<JsonElement> OnRedoAuthoringBatch(AuthoringHistoryRequestV1 request)
    {
        ValidateAuthoringHistoryRequest(request);
        return JsonSerializer.SerializeToElement(await AuthoringBatches.RedoAsync(request), ManuscriptCodec.JsonOptions);
    }

    [JSInvokable]
    public Task OnAuthoringJournalState(bool recoverable, string? message)
    {
        if (!recoverable)
        {
            _authoringDirty = true;
            _authoringRecoverable = false;
            UpdateAuthoringWriterState(isReachable: true);
            _initializationError = message ?? "Edits are visible but cannot be safely recovered locally. Saving is paused.";
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    private void ValidateAuthoringBatch(AuthoringBatchV1 batch)
    {
        if (batch.ProjectId != ProjectId
            || !string.Equals(batch.ProtocolId, AuthoringProtocolV1.ProtocolId, StringComparison.Ordinal)
            || batch.Targets.Count != 1
            || !string.Equals(batch.Targets[0].TargetId, AuthoringTargetId(), StringComparison.Ordinal))
        {
            throw new InvalidOperationException("The authoring batch does not match this editor target.");
        }
    }

    private void ValidateAuthoringHistoryRequest(AuthoringHistoryRequestV1 request)
    {
        if (request.ProjectId != ProjectId
            || !string.Equals(request.TargetId, AuthoringTargetId(), StringComparison.Ordinal))
        {
            throw new InvalidOperationException("The authoring history request does not match this editor target.");
        }
    }

    private async Task RegisterAuthoringWriterAsync()
    {
        if (_authoringWriterLease is not null || _authoringSessionId is not Guid sessionId)
            return;

        _authoringWriterLease = await AuthoringFence.RegisterWriterAsync(new(
            new AuthoringTargetReferenceV1(ProjectId, AuthoringTargetId()),
            sessionId,
            _authoringWriterId,
            FreezeAndFlushAuthoringAsync,
            ResumeAuthoringAsync));
        // A same-session remount atomically reattaches an unreachable writer.
        // Do not overwrite its retained dirty state here: the JS handle reports
        // its recovered journal/queue state immediately after registration.
    }

    private async Task<AuthoringWriterFlushResult> FreezeAndFlushAuthoringAsync(long sequence, CancellationToken cancellationToken)
    {
        if (_handle is null || _disposed || _disposing)
            return new(_lastAcknowledgedAuthoringSequence, _authoringDirty, _authoringRecoverable, false,
                "AUTHORING_CLIENT_UNREACHABLE", "The editor is no longer reachable.");
        try
        {
            var result = await _handle.InvokeAsync<AuthoringWriterFlushResult>("freezeAndFlush", cancellationToken, sequence);
            _lastAcknowledgedAuthoringSequence = Math.Max(_lastAcknowledgedAuthoringSequence, result.FlushedSequence);
            _authoringDirty = result.IsDirty;
            _authoringRecoverable = result.IsRecoverable;
            UpdateAuthoringWriterState(isReachable: result.IsReachable);
            return result;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or OperationCanceledException)
        {
            UpdateAuthoringWriterState(isReachable: false);
            return new(_lastAcknowledgedAuthoringSequence, _authoringDirty, _authoringRecoverable, false,
                "AUTHORING_CLIENT_UNREACHABLE", exception.Message);
        }
    }

    private async Task ResumeAuthoringAsync(CancellationToken cancellationToken)
    {
        if (_handle is null)
            return;
        await _handle.InvokeVoidAsync("resumeAfterFence", cancellationToken);
        UpdateAuthoringWriterState(isReachable: true);
    }

    [JSInvokable]
    public Task OnAuthoringWriterState(
        long generation,
        long highestLocalSequence,
        long lastDispatchedSequence,
        long lastAcknowledgedSequence,
        bool isDirty,
        bool isRecoverable,
        bool isReachable)
    {
        _authoringGeneration = generation;
        _highestAuthoringSequence = highestLocalSequence;
        _lastDispatchedAuthoringSequence = lastDispatchedSequence;
        _lastAcknowledgedAuthoringSequence = lastAcknowledgedSequence;
        _authoringDirty = isDirty;
        _authoringRecoverable = isRecoverable;
        UpdateAuthoringWriterState(isReachable);
        return Task.CompletedTask;
    }

    private void UpdateAuthoringWriterState(bool isReachable)
    {
        if (_authoringWriterLease is null || _authoringSessionId is not Guid sessionId)
            return;
        try
        {
            AuthoringFence.UpdateWriterState(new(
                new AuthoringTargetReferenceV1(ProjectId, AuthoringTargetId()),
                sessionId,
                _authoringWriterId,
                _authoringGeneration,
                _highestAuthoringSequence,
                _lastDispatchedAuthoringSequence,
                _lastAcknowledgedAuthoringSequence,
                _authoringDirty,
                _authoringRecoverable,
                isReachable));
        }
        catch (AuthoringMutationFenceException exception)
            when (string.Equals(exception.Code, "AUTHORING_WRITER_STALE", StringComparison.Ordinal))
        {
            // A same-session reattach replaced this component's callbacks.
            // Its late dispose/interop notification must not affect the new
            // writer or turn disposal into a circuit error.
        }
    }

    [JSInvokable]
    public async Task<JsonElement> GetAuthoringHistoryState()
    {
        var history = await AuthoringBatches.ReadHistoryStateAsync(new(ProjectId, AuthoringTargetId()));
        return JsonSerializer.SerializeToElement(new
        {
            state = HistoryPayload(history.State),
            cursor = history.Cursor,
        }, ManuscriptCodec.JsonOptions);
    }

    private static object HistoryPayload(AuthoringHistoryState state) => new
    {
        state.CanUndo,
        state.CanRedo,
        state.UndoLabel,
        state.RedoLabel,
    };

    private string AuthoringTargetId()
    {
        if (!string.IsNullOrWhiteSpace(AuthoringTargetIdOverride))
            return AuthoringTargetIdOverride;
        return ContentTarget.IsCore
            ? $"chapter:{ChapterId:D}"
            : $"release:{ContentTarget.EditionId:D}:chapter:{ChapterId:D}";
    }

    [JSInvokable]
    public Task OnPasteNormalized(string[] warnings)
    {
        if (warnings.Length > 0)
        {
            _pasteWarning = "Paste normalization: " + string.Join("; ", warnings);
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void RecordPerformanceTrace(string metric, double durationMilliseconds, long sequence) =>
        PerformanceTrace.Record(metric, durationMilliseconds, sequence);

    public async Task<bool> FlushAsync()
    {
        if (_disposed || _handle is null)
            return true;

        try
        {
            return await _handle.InvokeAsync<bool>("flush");
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (JSException)
        {
            return false;
        }
    }

    public async Task ApplyReadOnlyAsync(bool readOnly)
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            await _handle.InvokeVoidAsync("setReadOnly", readOnly);
            _appliedReadOnly = readOnly;
            if (!readOnly && IsVisible)
                await _handle.InvokeVoidAsync("focus");
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    internal async Task<ManuscriptViewLocation?> CaptureLocationAsync()
    {
        if (_disposed || _handle is null)
            return null;

        try
        {
            return await _handle.InvokeAsync<ManuscriptViewLocation?>("getLocation");
        }
        catch (JSDisconnectedException) { return null; }
        catch (OperationCanceledException) { return null; }
        catch (JSException) { return null; }
    }

    internal async Task<bool> RestoreLocationAsync(ManuscriptViewLocation location)
    {
        if (_disposed)
            return false;

        if (_handle is null)
        {
            _pendingLocation = location;
            return false;
        }

        try
        {
            var restored = await _handle.InvokeAsync<bool>("setLocation", location);
            if (restored && IsVisible && !IsReadOnly)
                await _handle.InvokeVoidAsync("focus");
            return restored;
        }
        catch (JSDisconnectedException) { return false; }
        catch (OperationCanceledException) { return false; }
        catch (JSException) { return false; }
    }

    private async Task ApplyPendingLocationAsync()
    {
        if (_pendingLocation is not { } location || _handle is null)
            return;

        _pendingLocation = null;
        await RestoreLocationAsync(location);
    }

    private async Task FocusAsync()
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            await _handle.InvokeVoidAsync("focus");
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    private async Task RefreshTypographyAsync()
    {
        if (_disposed || _handle is null)
            return;

        try
        {
            var pageSetup = await PageSetups.GetOrCreateAsync(ProjectId);
            if (_appliedTypographyRevision == pageSetup.Revision)
                return;
            var typographyJson = JsonSerializer.Serialize(
                TypographyDefaults.CreateEditorConfiguration(pageSetup),
                ManuscriptCodec.JsonOptions);
            await _handle.InvokeVoidAsync("updateTypography", typographyJson);
            _appliedTypographyRevision = pageSetup.Revision;
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (JSException) { }
    }

    private void RetryInitialization()
    {
        if (_disposed || _disposing)
            return;
        _initializationError = null;
    }

    private async Task SetInitializationErrorAsync(string message, Exception exception, LogLevel level)
    {
        if (level == LogLevel.Warning)
        {
            Logger.LogWarning(
                exception,
                "Chapter editor target was unavailable during initialization. ProjectId={ProjectId}, ChapterId={ChapterId}, ContentTarget={ContentTarget}",
                ProjectId,
                ChapterId,
                ContentTarget.StorageKey);
        }
        else
        {
            Logger.LogError(
                exception,
                "Chapter editor initialization failed. ProjectId={ProjectId}, ChapterId={ChapterId}, ContentTarget={ContentTarget}",
                ProjectId,
                ChapterId,
                ContentTarget.StorageKey);
        }

        if (!_disposed && !_disposing)
        {
            _initializationError = message;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) when (_disposed || _disposing) { }
        }
    }

    private async Task DisposeFailedInitializationAsync()
    {
        var handle = _handle;
        _handle = null;
        if (handle is not null)
        {
            try { await handle.InvokeVoidAsync("dispose"); } catch { }
            try { await handle.DisposeAsync(); } catch { }
        }

        var module = _module;
        _module = null;
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch { }
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }

    private string RootClass()
    {
        var classes = "chapter-edit-surface semantic-editor";
        if (!IsVisible)
            classes += " chapter-edit-surface--hidden";
        if (IsReadOnly)
            classes += " chapter-edit-surface--locked";
        return classes;
    }

    public async ValueTask DisposeAsync()
    {
        _importCancellation?.Cancel();
        if (_disposed || _disposing)
            return;

        _disposing = true;
        if (_handle is not null)
        {
            try { await FreezeAndFlushAuthoringAsync(_highestAuthoringSequence, CancellationToken.None); } catch { }
            try { await _handle.InvokeAsync<bool>("waitForSaves"); } catch { }
            try { await _handle.InvokeVoidAsync("dispose"); } catch { }
            try { await _handle.DisposeAsync(); } catch { }
            _handle = null;
        }
        if (_authoringWriterLease is not null)
        {
            if (_authoringDirty)
                UpdateAuthoringWriterState(isReachable: false);
            else
            {
                await _authoringWriterLease.DisposeAsync();
                _authoringWriterLease = null;
            }
        }
        _disposed = true;

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
            _module = null;
        }
        _selfRef?.Dispose();
        _disposing = false;
    }

    private sealed record DesignedPageEditorSummary(
        Guid Id,
        string Name,
        string SurfaceLabel,
        string Status,
        string? PreviewUrl);
}
