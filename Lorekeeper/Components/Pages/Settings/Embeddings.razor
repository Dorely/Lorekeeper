@page "/settings/embeddings"
@using Lorekeeper.Llm
@using Lorekeeper.Models
@rendermode InteractiveServer
@inject IEmbeddingConfigurationService EmbeddingConfig
@inject IModelCatalogService ModelCatalog

<PageTitle>Embeddings</PageTitle>

<ConfigurationShell Title="Embeddings" Description="Choose the single model that powers semantic search, memory retrieval, and context recommendations.">
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-@_statusKind alert-dismissible fade show" role="alert">@_statusMessage<button type="button" class="btn-close" aria-label="Dismiss" @onclick="ClearStatus"></button></div>
    }

    @if (_loading)
    {
        <div class="lk-empty-state" role="status"><span class="spinner-border spinner-border-sm"></span><span>Loading embedding configuration…</span></div>
    }
    else if (_connections.Count == 0)
    {
        <div class="lk-empty-state"><h2>Connect a model provider first</h2><p>Embedding models use an existing provider connection for endpoint and credentials.</p><a class="btn btn-primary" href="/settings/providers">Configure providers</a></div>
    }
    else
    {
        <div class="embedding-layout">
            <section class="lk-section-card active-embedding" aria-labelledby="active-embedding-title">
                <div class="lk-section-heading"><div><span class="lk-section-kicker">Current state</span><h2 id="active-embedding-title">Active model</h2><p>The embedding configuration currently used by every project.</p></div>@if (_active is not null){<span class="lk-status-pill is-success">Active</span>}else{<span class="lk-status-pill is-warning">Disabled</span>}</div>
                @if (_active is null)
                {
                    <div class="embedding-disabled"><strong>Semantic features are disabled</strong><span>Manual and lexical search remain available until an embedding model is configured.</span></div>
                }
                else
                {
                    <dl class="embedding-facts">
                        <div><dt>Connection</dt><dd>@ConnectionLabel(_active.Provider)</dd></div>
                        <div><dt>API</dt><dd>@_active.ApiKind</dd></div>
                        <div><dt>Model</dt><dd>@_active.ModelId</dd></div>
                        <div><dt>Dimensions</dt><dd>@_active.Dimensions.ToString("N0")</dd></div>
                        <div><dt>Last tested</dt><dd>@_active.LastTestedAt.ToLocalTime().ToString("g")</dd></div>
                    </dl>
                }
            </section>

            <section class="lk-section-card embedding-config" aria-labelledby="configure-embedding-title">
                <div class="lk-section-heading"><div><span class="lk-section-kicker">Model selection</span><h2 id="configure-embedding-title">Configure active model</h2><p>Test the exact connection, API, and model combination before saving.</p></div></div>
                <div class="embedding-form">
                    <label><span>Connection</span><select class="form-select" value="@_providerId" @onchange="OnProviderChanged">@foreach (var connection in _connections){<option value="@connection.Id">@ConnectionLabel(connection)</option>}</select></label>
                    <label><span>Embedding API</span><select class="form-select" @bind="_apiKind" @bind:after="DraftChanged" disabled="@SelectedConnectionIsCodex">@if (!SelectedConnectionIsCodex){<option value="@EmbeddingApiKind.OllamaNative">Ollama native</option>}<option value="@EmbeddingApiKind.OpenAICompatible">OpenAI compatible</option></select></label>
                    <label class="field-wide">
                        <span>Embedding model ID</span>
                        <div class="model-id-field">
                            <input class="form-control" value="@_modelId" @oninput="OnModelChanged" placeholder="@ModelPlaceholder" />
                            @if (!SelectedConnectionIsCodex)
                            {
                                <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="ListModelsAsync">@(_listingModels ? "Listing…" : "List models")</button>
                            }
                        </div>
                        @if (_availableModels.Count > 0)
                        {
                            <select class="form-select form-select-sm" value="@_modelId" @onchange="OnAvailableModelSelected">
                                <option value="">-- Select a model --</option>
                                @foreach (var candidate in _availableModels)
                                {
                                    <option value="@candidate">@candidate</option>
                                }
                            </select>
                            <small class="model-list-note">Pick a discovered model or keep your typed ID.</small>
                        }
                        else if (SelectedConnectionIsCodex)
                        {
                            <small class="model-list-note">OpenAI account model lists are not fetched dynamically. Keep the suggested model or enter an exact model ID, then test it.</small>
                        }
                    </label>
                </div>

                @if (SelectedConnectionIsCodex){<div class="embedding-note">OpenAI account embeddings use <code>@CodexProvider.PlatformEmbeddingsEndpoint</code> automatically; the chat endpoint is unchanged.</div>}
                @if (_tested is not null && TestMatchesDraft){<div class="embedding-test-success"><span class="lk-status-pill is-success">Test passed</span><strong>@_tested.Dimensions.ToString("N0") dimensions</strong><span>This exact configuration is ready to save.</span></div>}
                @if (WillSwitchActiveModel)
                {
                    <div class="embedding-warning"><strong>Existing vectors must be rebuilt</strong><span>Switching models clears and rebuilds project vectors in the background.</span><label><input class="form-check-input" type="checkbox" id="confirmReembed" @bind="_confirmReembed" disabled="@Busy" /><span>I understand this will trigger a full project re-embed.</span></label></div>
                }
                <div class="lk-toolbar embedding-actions"><button type="button" class="btn btn-outline-info" disabled="@Busy" @onclick="TestAsync">@(_testing ? "Testing model…" : "Test model")</button><button type="button" class="btn btn-primary" disabled="@(!CanSave)" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save active model")</button></div>
            </section>
        </div>

        @if (_active is not null)
        {
            <section class="lk-danger-zone embedding-danger" aria-labelledby="disable-embeddings-title"><div><span class="lk-section-kicker">Danger zone</span><h2 id="disable-embeddings-title">Disable semantic features</h2><p>Existing vectors remain stored and will be rebuilt if a model is configured again.</p></div><label><input class="form-check-input" type="checkbox" id="confirmUnsetEmbedding" @bind="_confirmUnset" disabled="@Busy" /><span>I understand vector search and semantic recommendations will be disabled.</span></label><button type="button" class="btn btn-outline-danger" disabled="@(!CanUnset)" @onclick="UnsetAsync">@(_unsetting ? "Disabling…" : "Unset active model")</button></section>
        }
    }
</ConfigurationShell>

@code {
    private List<LlmProvider> _connections = [];
    private EmbeddingConfiguration? _active;
    private int _providerId;
    private EmbeddingApiKind _apiKind = EmbeddingApiKind.OllamaNative;
    private string _modelId = string.Empty;
    private EmbeddingTestResult? _tested;
    private bool _confirmReembed;
    private bool _confirmUnset;
    private bool _loading = true;
    private bool _testing;
    private bool _saving;
    private bool _unsetting;
    private bool _listingModels;
    private IReadOnlyList<string> _availableModels = [];
    private string? _statusMessage;
    private string _statusKind = "success";

    private bool Busy => _testing || _saving || _unsetting;
    private LlmProvider? SelectedConnection =>
        _connections.FirstOrDefault(connection => connection.Id == _providerId);
    private bool SelectedConnectionIsCodex =>
        SelectedConnection is { } selected && CodexProvider.IsAccountBacked(selected);
    private string ModelPlaceholder =>
        SelectedConnectionIsCodex
            ? CodexProvider.DefaultEmbeddingModel
            : "nomic-embed-text or text-embedding-3-small";

    private bool TestMatchesDraft =>
        _tested is not null
        && _tested.ProviderId == _providerId
        && _tested.ApiKind == _apiKind
        && string.Equals(_tested.ModelId, _modelId.Trim(), StringComparison.Ordinal);

    private bool WillSwitchActiveModel =>
        _active is not null
        && (_active.ProviderId != _providerId
            || _active.ApiKind != _apiKind
            || !string.Equals(_active.ModelId, _modelId.Trim(), StringComparison.Ordinal)
            || (TestMatchesDraft && _tested!.Dimensions != _active.Dimensions));

    private bool CanSave =>
        !Busy
        && _providerId > 0
        && !string.IsNullOrWhiteSpace(_modelId)
        && TestMatchesDraft
        && (!WillSwitchActiveModel || _confirmReembed);

    private bool CanUnset =>
        !Busy
        && _active is not null
        && _confirmUnset;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _connections = (await EmbeddingConfig.ListConnectionProvidersAsync()).ToList();
        _active = await EmbeddingConfig.GetActiveAsync();

        if (_active is not null)
        {
            _providerId = _active.ProviderId;
            _apiKind = _active.ApiKind;
            _modelId = _active.ModelId;
            _tested = new EmbeddingTestResult(
                _active.LastTestedProviderId,
                _active.LastTestedApiKind,
                _active.LastTestedModelId,
                _active.LastTestedDimensions,
                _active.LastTestedAt);
        }
        else if (_connections.FirstOrDefault() is { } first)
        {
            _providerId = first.Id;
            _modelId = string.Empty;
            ApplyProviderDefaults(first, defaultModelWhenEmpty: true);
            _tested = null;
        }
        else
        {
            _providerId = 0;
            _modelId = string.Empty;
            _tested = null;
        }

        _confirmReembed = false;
        _confirmUnset = false;
        _loading = false;
    }

    private async Task TestAsync()
    {
        NormalizeSelectedProviderDraft();
        _testing = true;
        _tested = null;
        try
        {
            _tested = await EmbeddingConfig.TestAsync(new EmbeddingTestRequest(_providerId, _apiKind, _modelId));
            SetStatus($"Embedding model tested. Dimensions: {_tested.Dimensions}.", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Embedding test failed: {ex.Message}", "danger");
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SaveAsync()
    {
        NormalizeSelectedProviderDraft();
        if (!CanSave)
            return;

        if (_tested is null || !TestMatchesDraft)
        {
            SetStatus("Run Test successfully before saving this embedding model.", "danger");
            return;
        }

        _saving = true;
        try
        {
            var result = await EmbeddingConfig.SaveAsync(new EmbeddingConfigurationDraft(
                _providerId,
                _apiKind,
                _modelId.Trim(),
                _tested.Dimensions,
                _tested.ProviderId,
                _tested.ApiKind,
                _tested.ModelId));
            SetStatus(result.RebuildQueued
                ? "Active embedding model saved. Full project re-embed queued."
                : "Active embedding model saved.",
                "success");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UnsetAsync()
    {
        if (!CanUnset)
            return;

        _unsetting = true;
        try
        {
            var result = await EmbeddingConfig.UnsetAsync();
            SetStatus(result.Removed
                ? "Embedding model unset. Vector features are disabled."
                : "No active embedding model was set.",
                result.Removed ? "success" : "info");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Unset failed: {ex.Message}", "danger");
        }
        finally
        {
            _unsetting = false;
        }
    }

    private async Task ListModelsAsync()
    {
        NormalizeSelectedProviderDraft();
        if (SelectedConnection is not { } connection)
            return;

        _listingModels = true;
        try
        {
            _availableModels = await ModelCatalog.ListEmbeddingModelsAsync(connection, _apiKind);
            if (_availableModels.Count == 0)
                SetStatus("The provider returned an empty model list; enter the embedding model ID manually.", "info");
        }
        catch (Exception ex)
        {
            _availableModels = [];
            SetStatus($"Model discovery failed: {ex.Message} Enter the embedding model ID manually.", "info");
        }
        finally
        {
            _listingModels = false;
        }
    }

    private void OnAvailableModelSelected(ChangeEventArgs args)
    {
        var value = args.Value?.ToString()?.Trim();
        if (!string.IsNullOrWhiteSpace(value))
        {
            _modelId = value;
            DraftChanged();
        }
    }

    private void OnProviderChanged(ChangeEventArgs args)
    {
        _availableModels = [];
        if (int.TryParse(args.Value?.ToString(), out var providerId))
            _providerId = providerId;
        if (_connections.FirstOrDefault(connection => connection.Id == _providerId) is { } selected)
            ApplyProviderDefaults(selected, defaultModelWhenEmpty: true);
        DraftChanged();
    }

    private void OnModelChanged(ChangeEventArgs args)
    {
        _modelId = args.Value?.ToString() ?? string.Empty;
        DraftChanged();
    }

    private void DraftChanged()
    {
        NormalizeSelectedProviderDraft();
        _tested = null;
        _confirmReembed = false;
    }

    private static EmbeddingApiKind GuessDefaultApiKind(LlmProvider provider)
    {
        if (CodexProvider.IsAccountBacked(provider))
            return EmbeddingApiKind.OpenAICompatible;

        var endpoint = provider.EndpointUrl.TrimEnd('/');
        return endpoint.EndsWith("/v1", StringComparison.OrdinalIgnoreCase)
            ? EmbeddingApiKind.OpenAICompatible
            : EmbeddingApiKind.OllamaNative;
    }

    private void ApplyProviderDefaults(LlmProvider provider, bool defaultModelWhenEmpty)
    {
        _apiKind = GuessDefaultApiKind(provider);
        if (defaultModelWhenEmpty
            && CodexProvider.IsAccountBacked(provider)
            && string.IsNullOrWhiteSpace(_modelId))
        {
            _modelId = CodexProvider.DefaultEmbeddingModel;
        }
    }

    private void NormalizeSelectedProviderDraft()
    {
        if (SelectedConnection is { } selected && CodexProvider.IsAccountBacked(selected))
            ApplyProviderDefaults(selected, defaultModelWhenEmpty: true);
    }

    private static string ConnectionLabel(LlmProvider provider) =>
        $"{(string.IsNullOrWhiteSpace(provider.DisplayName) ? provider.Name : provider.DisplayName)} - {provider.EndpointUrl}";

    private void ClearStatus() => _statusMessage = null;

    private void SetStatus(string message, string kind)
    {
        _statusMessage = message;
        _statusKind = kind;
    }
}
