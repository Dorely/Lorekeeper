    private async Task AddChildModelAsync(LlmProvider parent, ChildDraft draft)
    {
        var displayName = (draft.DisplayName ?? string.Empty).Trim();
        var modelId = (draft.ModelId ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(modelId))
        {
            SetStatus("Display Name and Model ID are required.", "danger");
            return;
        }

        var child = new LlmProvider
        {
            Name = $"{parent.Name}-{modelId.Replace("/", "-").Replace(":", "-")}",
            DisplayName = displayName,
            EndpointUrl = parent.EndpointUrl,
            ModelId = modelId,
            ReasoningEffort = draft.ReasoningEffort,
            MaxOutputTokens = draft.MaxOutputTokens,
            MaxInputTokens = draft.MaxInputTokens,
            MaxTokensField = draft.MaxTokensField,
            AuthType = parent.AuthType,
            OpenAiAccountId = parent.OpenAiAccountId,
            CredentialSourceId = parent.OpenAiAccountId is null ? parent.Id : null,
        };

        try
        {
            await ChatClientFactory.TestModelAsync(child);
            child.MarkChatTestSucceeded(DateTime.UtcNow);
            string? visionError = null;
            try
            {
                await VisionModelClientFactory.TestVisionModelAsync(child);
                child.MarkVisionTestSucceeded(DateTime.UtcNow);
            }
            catch (Exception visionEx)
            {
                visionError = visionEx.Message;
                child.MarkVisionTestFailed(visionEx.Message, DateTime.UtcNow);
            }
            await ProviderService.CreateAsync(child);
            SetStatus(visionError is null
                ? $"Model '{displayName}' ({modelId}) added under {parent.DisplayName ?? parent.Name} and verified for chat and vision."
                : $"Model '{displayName}' ({modelId}) added under {parent.DisplayName ?? parent.Name}; chat verified, but the vision check failed: {visionError}",
                visionError is null ? "success" : "warning");
            _childForms.Remove(parent.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Add failed: {ex.Message}", "danger");
        }
    }

    private async Task ConnectAccountAsync(AccountSection section)
    {
        section.CallbackOrigin = CallbackOrigin.Validate(section.Kind);
        if (!section.CallbackOrigin.IsValid)
        {
            SetStatus(section.CallbackOrigin.Message, "warning");
            return;
        }

        try
        {
            var account = section.Account ?? await OpenAiAccounts.CreateAsync(section.Kind);
            section.Account = account;
            await OpenAiCatalog.EnsureCatalogAsync(account.Id);
            var started = await OpenAiAuthorization.StartAsync(account.Id);
            _authorizationFlow = started.Flow;
            _authorizationKind = section.Kind;
            _authorizationTarget = started.Launch.Disposition == ExternalAuthorizationLaunchDisposition.UserActivationRequired
                ? started.Launch.Target
                : null;
            SetStatus(
                started.Launch.Disposition == ExternalAuthorizationLaunchDisposition.OpenedExternally
                    ? "OpenAI authorization opened in your system browser. Return here after approving it."
                    : "OpenAI authorization is ready. Use the external link below, then return here.",
                "info");
            StartAuthorizationPolling(account.Id, started.Flow.FlowId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to start OpenAI authorization");
            SetStatus("OpenAI authorization could not be started. Check the callback configuration and try again.", "danger");
        }
    }

    private void StartAuthorizationPolling(int accountId, Guid flowId)
    {
        _authorizationPollingCancellation?.Cancel();
        _authorizationPollingCancellation?.Dispose();
        _authorizationPollingCancellation = new CancellationTokenSource();
        _authorizationPollingTask = PollAuthorizationAsync(
            accountId,
            flowId,
            _authorizationPollingCancellation.Token);
    }

    private async Task PollAuthorizationAsync(
        int accountId,
        Guid flowId,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                var flow = OpenAiAuthorization.GetFlow(accountId);
                if (flow is null || flow.FlowId != flowId)
                    return;

                _authorizationFlow = flow;
                if (flow.IsPending)
                {
                    if (!_disposed)
                        await InvokeAsync(StateHasChanged);
                    continue;
                }

                _authorizationTarget = null;
                if (flow.Status == OpenAiAuthorizationFlowStatus.Succeeded)
                    await FinishOpenAiConnectionAsync(accountId, cancellationToken);
                else
                {
                    SetStatus(
                        flow.Message ?? "OpenAI authorization was not completed. Start a new connection attempt.",
                        flow.Status == OpenAiAuthorizationFlowStatus.Failed ? "danger" : "warning");
                    await ReloadAsync();
                }

                _authorizationFlow = null;
                _authorizationKind = null;
                if (!_disposed)
                    await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to finish OpenAI authorization {FlowId}", flowId);
            if (!_disposed)
            {
                SetStatus("OpenAI connected, but local account setup could not be completed. Reopen Settings to retry.", "warning");
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task FinishOpenAiConnectionAsync(int accountId, CancellationToken cancellationToken)
    {
        var kind = _authorizationKind ?? OpenAiAccountKind.Codex;
        var section = SectionFor(kind);
        await OpenAiCatalog.EnsureCatalogAsync(accountId, cancellationToken);
        if (kind == OpenAiAccountKind.ChatGptPlan
            && await OpenAiAccounts.GetByIdAsync(accountId, cancellationToken) is { PlanUsageGranted: false })
        {
            // Without the plan-usage grant there is no access to list models with.
            SetStatus(CodexProvider.PlanUsageNotGrantedMessage, "warning");
            await ReloadAsync();
            return;
        }

        // A refresh failure replaces this status, which keeps the warning visible.
        SetStatus(kind == OpenAiAccountKind.ChatGptPlan ? "ChatGPT plan connected." : "OpenAI account connected.", "success");
        await RefreshOpenAiModelsAsync(section, accountId, automatic: true);

        if (kind == OpenAiAccountKind.ChatGptPlan && section.Account is { WelcomeAcknowledgedAt: null } account)
            _welcomeAccountId = account.Id;
    }

    private AccountSection SectionFor(OpenAiAccountKind kind) =>
        kind == OpenAiAccountKind.ChatGptPlan ? _planSection : _codexSection;

    private Task RefreshOpenAiModelsAsync(AccountSection section) =>
        section.Account is null ? Task.CompletedTask : RefreshOpenAiModelsAsync(section, section.Account.Id, automatic: false);

    private async Task RefreshOpenAiModelsAsync(AccountSection section, int accountId, bool automatic)
    {
        if (section.Refreshing)
            return;

        section.Refreshing = true;
        if (!_disposed)
            await InvokeAsync(StateHasChanged);
        try
        {
            var result = await OpenAiCatalog.RefreshAvailabilityAsync(accountId);
            if (!result.Succeeded)
                SetStatus(result.Error ?? "Model refresh failed.", "warning");
            else if (!automatic)
                SetStatus($"Models refreshed: {result.AvailableCount} available, {result.UnavailableCount} not on your plan.", "success");
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning("OpenAI account {AccountId} model refresh failed: {ErrorType}", accountId, ex.GetType().Name);
            SetStatus("Model refresh failed. Try again.", "warning");
        }
        finally
        {
            section.Refreshing = false;
        }

        await ReloadAsync();
    }

    private async Task CancelOpenAiAuthorizationAsync()
    {
        if (_authorizationFlow?.IsPending == true)
            await OpenAiAuthorization.CancelAsync(_authorizationFlow.AccountId);
        _authorizationPollingCancellation?.Cancel();
        _authorizationTarget = null;
        _authorizationFlow = null;
        _authorizationKind = null;
        SetStatus("OpenAI authorization was canceled. Existing credentials were kept.", "info");
    }

    private async Task DisconnectAccountAsync(AccountSection section)
    {
        if (section.Account is not { } account)
            return;
        await CancelOpenAiAuthorizationAsync();
        var warning = await OpenAiTokens.DisconnectAsync(account.Id);
        SetStatus(
            warning ?? (section.Kind == OpenAiAccountKind.ChatGptPlan
                ? "ChatGPT plan disconnected."
                : "OpenAI account disconnected."),
            warning is null ? "success" : "warning");
        await ReloadAsync();
    }

    private async Task ForgetRegistrationAsync()
    {
        var section = _forgetRegistrationSection;
        _forgetRegistrationSection = null;
        if (section?.Account is not { } account)
            return;

        await CancelOpenAiAuthorizationAsync();
        var warning = await OpenAiTokens.ForgetRegistrationAsync(account.Id);
        SetStatus(warning ?? "ChatGPT registration forgotten.", warning is null ? "success" : "warning");
        await ReloadAsync();
    }

    private async Task AcknowledgeWelcomeAsync()
    {
        var accountId = _welcomeAccountId;
        _welcomeAccountId = null;
        if (accountId is not int id)
            return;

        try
        {
            await OpenAiAccounts.AcknowledgeWelcomeAsync(id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to acknowledge the ChatGPT plan welcome notice {AccountId}", id);
        }

        await ReloadAsync();
    }




    private static bool IsAccountListed(LlmProvider provider) =>
        provider.ModelOrigin is LlmModelOrigin.BundledCatalog or LlmModelOrigin.AccountDiscovered;

    private bool IsChatReady(LlmProvider provider) =>
        (IsAccountListed(provider) || provider.HasCurrentChatTestSnapshot)
        && _chatReadyStatus.TryGetValue(provider.Id, out var ready)
        && ready;

    private bool IsVisionReady(LlmProvider provider) =>
        (IsAccountListed(provider) || provider.HasCurrentVisionTestSnapshot)
        && _visionReadyStatus.TryGetValue(provider.Id, out var ready)
        && ready;

    private string DefaultButtonTitle(LlmProvider provider) =>
        IsChatReady(provider)
            ? "Set as the default chat provider"
            : IsAccountListed(provider) && provider.AccountAvailability == LlmAccountModelAvailability.Unavailable
                ? "This model isn't available on your ChatGPT plan."
                : IsAccountListed(provider)
                    ? "Connect the OpenAI account before setting this model as default."
                    : "Run Test successfully before setting this provider as default.";

    private RenderFragment RenderChatStatus(LlmProvider provider) => __builder =>
    {
        if (IsChatReady(provider))
        {
            <span class="lk-status-pill is-success" title="This model is ready for LLM chat features.">Ready</span>
            return;
        }

        if (IsAccountListed(provider) && provider.AccountAvailability == LlmAccountModelAvailability.Unavailable)
        {
            <span class="lk-status-pill is-warning" title="Your ChatGPT plan doesn't offer this model. Use Refresh models after changing plans.">Not on your plan</span>
            return;
        }

        if (IsAccountListed(provider))
        {
            <span class="lk-status-pill is-warning" title="Connect the OpenAI account to use this catalog model.">Needs account</span>
            return;
        }

        if (provider.LastChatTestedAt is null)
        {
            <span class="lk-status-pill" title="Run Test before using this model.">Untested</span>
            return;
        }

        if (provider.LastChatTestSucceeded && !provider.HasCurrentChatTestSnapshot)
        {
            <span class="lk-status-pill is-warning" title="Connection or model settings changed after the last successful test.">Retest</span>
            return;
        }

        <span class="lk-status-pill is-danger" title="@provider.LastChatTestError">Failed</span>
    };

    private RenderFragment RenderVisionStatus(LlmProvider provider) => __builder =>
    {
        if (IsVisionReady(provider))
        {
            <span class="lk-status-pill is-success" title="This model is ready for image-reading and PDF ingestion.">Ready</span>
            return;
        }

        if (IsAccountListed(provider) && provider.AccountAvailability == LlmAccountModelAvailability.Unavailable)
        {
            <span class="lk-status-pill is-warning" title="Your ChatGPT plan doesn't offer this model. Use Refresh models after changing plans.">Not on your plan</span>
            return;
        }

        if (IsAccountListed(provider))
        {
            <span class="lk-status-pill is-warning" title="Connect the OpenAI account to use this catalog model.">Needs account</span>
            return;
        }

        if (provider.LastVisionTestedAt is null)
        {
            <span class="lk-status-pill" title="Run Test before using this model for image reading.">Untested</span>
            return;
        }

        if (provider.LastVisionTestSucceeded && !provider.HasCurrentVisionTestSnapshot)
        {
            <span class="lk-status-pill is-warning" title="Connection or model settings changed after the last successful vision test.">Retest</span>
            return;
        }

        <span class="lk-status-pill is-danger" title="@provider.LastVisionTestError">Failed</span>
    };

    private RenderFragment RenderPlanDefaultBanner(AccountSection section) => __builder =>
    {
        if (UnavailableDefault(section) is { } unavailable
            && BestAvailableAccountModel(section) is { } best
            && best.Id != unavailable.Id)
        {
            <div class="alert alert-warning plan-default-banner">
                <span>Your default model, @(unavailable.DisplayName ?? unavailable.ModelId), isn't available on your ChatGPT plan.</span>
                <button type="button" class="btn btn-sm btn-primary" @onclick="() => SetDefaultAsync(best.Id)">Use @(best.DisplayName ?? best.ModelId)</button>
            </div>
        }
    };

    private RenderFragment RenderAccountSection(AccountSection section) => __builder =>
    {
        var sectionKey = section.SectionKey;
        var expanded = IsSectionExpanded(sectionKey);
        var bodyId = $"{sectionKey}-body";
        var models = ModelsFor(section);
        var readyModelCount = models.Count(model => IsChatReady(model));
        var firstModel = FirstModel(section);
        var isPlan = section.Kind == OpenAiAccountKind.ChatGptPlan;
        var pending = _authorizationFlow?.IsPending == true && _authorizationKind == section.Kind;
        var currentAccount = section.Account;

        <article class="connection-section @(isPlan ? null : "codex-card")">
            <header class="connection-header">
                <button type="button" class="connection-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@bodyId" @onclick="() => ToggleSection(sectionKey)">
                    <span class="connection-chevron" aria-hidden="true"></span>
                    <div class="connection-identity">
                        <span class="connection-mark">AI</span>
                        <div>
                            <span class="lk-section-kicker">@(isPlan ? "ChatGPT plan" : "ChatGPT (Codex)")</span>
                            <h2>@(isPlan ? "ChatGPT plan" : "ChatGPT (Codex)")</h2>
                            @if (isPlan && currentAccount?.Email is { Length: > 0 } email)
                            {
                                <p class="account-email">@email</p>
                            }
                            <p>@(isPlan
                                ? "Chat with your ChatGPT Plus or Pro plan's usage, with usage limits managed in ChatGPT. Not used for images."
                                : "Sign in with the Codex login. Works with every ChatGPT plan and is used for image generation.")</p>
                        </div>
                    </div>
                </button>
                <span class="connection-summary">@($"{models.Count} model(s) · {readyModelCount} chat-ready")</span>
                <div class="connection-actions">
                    @if (pending)
                    {
                        <span class="lk-status-pill is-warning">Authorization pending</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelOpenAiAuthorizationAsync">Cancel</button>
                    }
                    @if (isPlan)
                    {
                        @if (!pending)
                        {
                            @if (currentAccount?.PlanIneligibleAt is not null)
                            {
                                <span class="lk-status-pill is-warning">Not eligible</span>
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Continue with ChatGPT</button>
                                @if (section.Connected || currentAccount?.ExternalAccountId is not null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DisconnectAccountAsync(section)">Disconnect</button>
                                }
                            }
                            else if (currentAccount?.RequiresReauthenticationAt is not null)
                            {
                                <span class="lk-status-pill is-warning">Reconnect required</span>
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Continue with ChatGPT</button>
                            }
                            else if (currentAccount is { ExternalAccountId: not null, PlanUsageGranted: false })
                            {
                                <span class="lk-status-pill is-warning">Plan usage not granted</span>
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Continue with ChatGPT</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DisconnectAccountAsync(section)">Disconnect</button>
                            }
                            else if (section.Connected)
                            {
                                <span class="lk-status-pill is-success">Using ChatGPT plan</span>
                                <a class="btn btn-sm btn-outline-secondary" href="@CodexProvider.ManageUsageUrl" target="_blank" rel="noopener noreferrer">Manage usage</a>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@section.Refreshing" @onclick="() => RefreshOpenAiModelsAsync(section)">@(section.Refreshing ? "Refreshing…" : "Refresh models")</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Reconnect</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DisconnectAccountAsync(section)">Disconnect</button>
                            }
                            else
                            {
                                <span class="lk-status-pill is-warning">Not connected</span>
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Continue with ChatGPT</button>
                            }
                        }
                        @if (currentAccount?.IssuedClientId is not null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _forgetRegistrationSection = section">Forget registration</button>
                        }
                    }
                    else
                    {
                        @if (section.Connected)
                        {
                            <span class="lk-status-pill is-success">Connected</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@section.Refreshing" @onclick="() => RefreshOpenAiModelsAsync(section)">@(section.Refreshing ? "Refreshing…" : "Refresh models")</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Reconnect</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DisconnectAccountAsync(section)">Disconnect</button>
                        }
                        else
                        {
                            <span class="lk-status-pill is-warning">Not connected</span>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanStartOpenAiAuthorization(section))" @onclick="() => ConnectAccountAsync(section)">Connect ChatGPT (Codex)</button>
                        }
                        @if (firstModel is not null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => { _collapsedSections.Remove(sectionKey); ToggleAddChild(firstModel.Id); }">Add manual model</button>
                        }
                    }
                </div>
            </header>
            @if (!expanded)
            {
                @RenderPlanDefaultBanner(section)
            }
            @if (expanded)
            {
                <div class="connection-body" id="@bodyId">
                    @if (currentAccount is { } account)
                    {
                        <p class="model-refresh-note">
                            @if (account.LastModelRefreshAt is { } lastModelRefresh)
                            {
                                @($"Models checked {lastModelRefresh.ToLocalTime():g}")
                            }
                            else
                            {
                                @("Models have not been checked against your plan yet.")
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(account.LastModelRefreshError))
                        {
                            <div class="alert alert-warning">@account.LastModelRefreshError</div>
                        }
                    }
                    @RenderPlanDefaultBanner(section)
                    @if (section.CallbackOrigin is { IsValid: false })
                    {
                        <div class="alert alert-warning">@section.CallbackOrigin.Message</div>
                    }
                    @if (isPlan)
                    {
                        @RenderPlanStateAlert(section)
                    }
                    else if (!string.IsNullOrWhiteSpace(currentAccount?.LastAuthenticationError))
                    {
                        <div class="alert alert-warning">@currentAccount.LastAuthenticationError</div>
                    }
                    @if (_authorizationTarget is not null && _authorizationKind == section.Kind)
                    {
                        <div class="alert alert-info">
                            OpenAI authorization is ready. Use this explicit external link, then return to this page while Lorekeeper completes the connection.
                            <a class="btn btn-sm btn-outline-primary ms-2" href="@_authorizationTarget.AbsoluteUri" target="_blank" rel="noopener noreferrer">Open OpenAI authorization</a>
                        </div>
                    }
                    @if (isPlan && models.Count > 0)
                    {
                        @RenderModelGrid(models, true)
                    }
                    else if (firstModel is not null)
                    {
                        @RenderModelGrid(models, true)
                        @RenderChildForm(firstModel)
                    }
                </div>
            }
        </article>
    };

    private RenderFragment RenderPlanStateAlert(AccountSection section) => __builder =>
    {
        if (section.Account is not { } account)
            return;

        if (account.PlanIneligibleAt is not null)
        {
            <div class="alert alert-warning">@CodexProvider.PlanNotEligibleMessage</div>
        }
        else if (account.RequiresReauthenticationAt is not null)
        {
            if (!string.IsNullOrWhiteSpace(account.LastAuthenticationError))
            {
                <div class="alert alert-warning">@account.LastAuthenticationError</div>
            }
        }
        else if (account is { ExternalAccountId: not null, PlanUsageGranted: false })
        {
            <div class="alert alert-warning">@CodexProvider.PlanUsageNotGrantedMessage</div>
        }
    };

    private List<LlmProvider> ModelsFor(LlmProvider connection)
    {
        var models = new List<LlmProvider> { connection };
        if (_children.TryGetValue(connection.Id, out var children))
            models.AddRange(children);
        return models;
    }

    private RenderFragment RenderModelGrid(IReadOnlyList<LlmProvider> models, bool accountBacked) => __builder =>
    {
        <div class="model-grid" role="table" aria-label="Models">
            <div class="model-grid-head" role="row">
                <span role="columnheader">Display name</span>
                <span role="columnheader">Model ID</span>
                <span role="columnheader">Thinking effort</span>
                <span role="columnheader">Chat</span>
                <span role="columnheader">Vision</span>
                <span role="columnheader">Default</span>
                <span role="columnheader" class="model-grid-actions-head">Actions</span>
            </div>
            @foreach (var model in models)
            {
                var detailsId = $"model-details-{model.Id}";
                var showDetails = _expandedModelDetails.Contains(model.Id);
                <div class="model-grid-item" role="rowgroup">
                    <div class="model-grid-row" role="row">
                        <div class="model-grid-cell" role="cell" data-label="Display name">
                            <input class="form-control form-control-sm" @bind="model.DisplayName" disabled="@(accountBacked && IsAccountListed(model))" aria-label="Display name" />
                            @if (accountBacked)
                            {
                                <span class="model-origin">@OriginLabel(model)</span>
                            }
                        </div>
                        <div class="model-grid-cell" role="cell" data-label="Model ID">
                            <input class="form-control form-control-sm" @bind="model.ModelId" disabled="@(accountBacked && IsAccountListed(model))" aria-label="Model ID" />
                        </div>
                        <div class="model-grid-cell" role="cell" data-label="Thinking effort">
                            @if (accountBacked)
                            {
                                <select class="form-select form-select-sm" aria-label="Thinking effort" @bind="model.ReasoningEffort">
                                    <option value="">@ReasoningDefaultLabel(model)</option>
                                    @foreach (var choice in ReasoningChoicesFor(model))
                                    {
                                        <option value="@choice.Value">@choice.Label</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <select class="form-select form-select-sm" aria-label="Thinking effort" @bind="model.ReasoningEffort">
                                    <option value="">Provider default</option>
                                    @foreach (var choice in ReasoningEffortChoices)
                                    {
                                        <option value="@choice.Value">@choice.Label</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="model-grid-cell" role="cell" data-label="Chat">@RenderChatStatus(model)</div>
                        <div class="model-grid-cell" role="cell" data-label="Vision">@RenderVisionStatus(model)</div>
                        <div class="model-grid-cell" role="cell" data-label="Default">
                            @if (model.IsDefault)
                            {
                                <span class="lk-status-pill is-accent">Default</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!IsChatReady(model))" title="@DefaultButtonTitle(model)" @onclick="() => SetDefaultAsync(model.Id)">Set default</button>
                            }
                        </div>
                        <div class="model-grid-cell model-grid-actions" role="cell" data-label="Actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-expanded="@(showDetails ? "true" : "false")" aria-controls="@detailsId" @onclick="() => ToggleModelDetails(model.Id)">@(showDetails ? "Hide details" : "Details")</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SaveProviderAsync(model)">Save</button>
                            @if (!accountBacked || model.ModelOrigin == LlmModelOrigin.Manual)
                            {
                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestProviderAsync(model)">@(_testingProviderId == model.Id ? "Testing…" : "Test")</button>
                            }
                            @if ((accountBacked && model.ModelOrigin == LlmModelOrigin.Manual) || (!accountBacked && model.CredentialSourceId is not null))
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleModelDelete(model.Id)">Delete</button>
                            }
                        </div>
                    </div>
                    @if (showDetails)
                    {
                        <div class="model-fields model-grid-details" id="@detailsId">
                            @if (ModelReadinessDetail(model) is { } detail)
                            {
                                <div class="model-detail field-wide">@detail</div>
                            }
                            @if (!accountBacked)
                            {
                                <div class="model-grid-discovery field-wide">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_listingRowModelId is not null)" @onclick="() => ListRowModelsAsync(model)">@(_listingRowModelId == model.Id ? "Listing…" : "List models")</button>
                                    @if (_rowModels.TryGetValue(model.Id, out var rowModels) && rowModels.Count > 0)
                                    {
                                        <select class="form-select form-select-sm" value="@model.ModelId" @onchange="args => OnRowModelSelected(model, args)">
                                            <option value="">-- Select a model --</option>
                                            @foreach (var candidate in rowModels)
                                            {
                                                <option value="@candidate">@candidate</option>
                                            }
                                        </select>
                                        <small class="field-note">Pick a discovered model or keep your typed ID.</small>
                                    }
                                </div>
                            }
                            else if (model.ModelOrigin == LlmModelOrigin.Manual)
                            {
                                <div class="model-detail field-wide">Enter an exact model ID, then use Test before saving it as the default.</div>
                            }
                            <div class="field-wide">
                                <small class="field-note">@(IsAccountListed(model) ? "Only efforts supported by this model are offered." : "Higher levels use more time and tokens; model support varies.")</small>
                            </div>
                            @RenderMaxTokenControls(model)
                        </div>
                    }
                    @if (_confirmDeleteModelId == model.Id)
                    {
                        <div class="inline-confirm"><span>Delete this model configuration?</span><button class="btn btn-sm btn-danger" @onclick="() => DeleteProviderAsync(model)">Delete</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteModelId = null">Cancel</button></div>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment RenderMaxTokenControls(LlmProvider model) => __builder =>
    {
        var accountDefaultBudget = model.ModelOrigin == LlmModelOrigin.AccountDiscovered
            ? model.ResolvedMetadata?.UsableInputBudgetTokens
            : null;
        var inputPlaceholder = model.ModelOrigin switch
        {
            LlmModelOrigin.BundledCatalog => "Catalog default (272,000)",
            LlmModelOrigin.AccountDiscovered => accountDefaultBudget is { } budget
                ? $"Account default ({budget:N0})"
                : "Account default",
            _ => "Auto (model/default)",
        };
        var inputNote = model.ModelOrigin switch
        {
            LlmModelOrigin.BundledCatalog => "Blank uses the catalog's 272,000-token usable input budget.",
            LlmModelOrigin.AccountDiscovered => accountDefaultBudget is { } budget
                ? $"Blank uses the account's {budget:N0}-token usable input budget."
                : "Blank uses the account-reported usable input budget.",
            _ => "Advisory context budget used to decide when assistant tool results are compacted. Blank uses a configured per-model value when available, then the general default.",
        };

        <label>
            <span>Max output tokens</span>
            <input type="number" min="1" step="1" class="form-control form-control-sm" placeholder="Provider default" @bind="model.MaxOutputTokens" />
            <small class="field-note">Blank uses the provider default (Claude: the model's output ceiling).</small>
        </label>
        <label>
            <span>Max input tokens</span>
            <input type="number" min="1" step="1" class="form-control form-control-sm" placeholder="@inputPlaceholder" @bind="model.MaxInputTokens" />
            <small class="field-note">@inputNote</small>
        </label>
        @if (UsesChatCompletions(model.EndpointUrl, model.ModelId, model.OpenAiAccountId))
        {
            <label>
                <span>Max tokens field</span>
                <select class="form-select form-select-sm" @bind="model.MaxTokensField">
                    @foreach (var choice in MaxTokensFieldChoices)
                    {
                        <option value="@choice.Value">@choice.Label</option>
                    }
                </select>
            </label>
        }
    };

    private RenderFragment RenderChildForm(LlmProvider parent) => __builder =>
    {
        if (!_childForms.TryGetValue(parent.Id, out var draft))
            return;

        <div class="child-model-form">
            <div class="child-model-header">
                <div class="child-model-heading"><span class="lk-section-kicker">Shared connection</span><strong>Add another model</strong><small>Credentials and endpoint come from @(parent.DisplayName ?? parent.Name).</small></div>
                <div class="lk-toolbar child-model-actions"><button type="button" class="btn btn-sm btn-primary" @onclick="() => AddChildModelAsync(parent, draft)">Test and add</button><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _childForms.Remove(parent.Id)">Cancel</button></div>
            </div>
            <div class="model-fields child-model-fields">
                <label><span>Display name</span><input class="form-control form-control-sm" placeholder="GPT-5 Mini" @bind="draft.DisplayName" /></label>
                <label>
                    <span>Model ID</span>
                    <div class="model-id-field">
                        <input class="form-control form-control-sm" placeholder="gpt-5-mini" @bind="draft.ModelId" />
                        @if (!CodexProvider.IsAccountBacked(parent))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_listingChildModelParentId is not null)" @onclick="() => ListChildModelsAsync(parent)">@(_listingChildModelParentId == parent.Id ? "Listing…" : "List models")</button>
                        }
                    </div>
                    @if (CodexProvider.IsAccountBacked(parent))
                    {
                        <small class="field-note">Enter an exact model ID. OpenAI account model lists are not fetched dynamically.</small>
                    }
                    else if (_childModels.TryGetValue(parent.Id, out var childModels) && childModels.Count > 0)
                    {
                        <select class="form-select form-select-sm" value="@draft.ModelId" @onchange="args => OnChildModelSelected(parent.Id, args)">
                            <option value="">-- Select a model --</option>
                            @foreach (var candidate in childModels)
                            {
                                <option value="@candidate">@candidate</option>
                            }
                        </select>
                        <small class="field-note">Pick a discovered model or keep your typed ID.</small>
                    }
                </label>
                <label>
                    <span>Thinking effort</span>
                    <select class="form-select form-select-sm" @bind="draft.ReasoningEffort">
                        <option value="">Provider default</option>
                        @foreach (var choice in ReasoningEffortChoices)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                    <small class="field-note">Support depends on the model.</small>
                </label>
                <label>
                    <span>Max output tokens</span>
                    <input type="number" min="1" step="1" class="form-control form-control-sm" placeholder="Provider default" @bind="draft.MaxOutputTokens" />
                    <small class="field-note">Blank uses the provider default (Claude: the model's output ceiling).</small>
                </label>
                <label>
                    <span>Max input tokens</span>
                    <input type="number" min="1" step="1" class="form-control form-control-sm" placeholder="Auto (model/default)" @bind="draft.MaxInputTokens" />
                    <small class="field-note">Advisory context budget used to decide when assistant tool results are compacted. Blank uses a configured per-model value when available, then the general default.</small>
                </label>
                @if (UsesChatCompletions(parent.EndpointUrl, draft.ModelId, parent.OpenAiAccountId))
                {
                    <label>
                        <span>Max tokens field</span>
                        <select class="form-select form-select-sm" @bind="draft.MaxTokensField">
                            @foreach (var choice in MaxTokensFieldChoices)
                            {
                                <option value="@choice.Value">@choice.Label</option>
                            }
                        </select>
                    </label>
                }
            </div>
        </div>
    };

    private string? ModelReadinessDetail(LlmProvider provider)
    {
        if (IsAccountListed(provider) && provider.AccountAvailability == LlmAccountModelAvailability.Unavailable)
            return "Not offered on your ChatGPT plan at the last refresh.";

        if (provider.ModelOrigin == LlmModelOrigin.AccountDiscovered)
        {
            return provider.EffectiveMaxInputTokens is { } budget
                ? $"Listed by your ChatGPT account; usable input budget {budget:N0} tokens."
                : "Listed by your ChatGPT account.";
        }

        if (provider.ModelOrigin == LlmModelOrigin.BundledCatalog)
            return $"Bundled catalog v{OpenAiAccountModelCatalog.SchemaVersion}; usable input budget {provider.EffectiveMaxInputTokens:N0} tokens.";

        if (!string.IsNullOrWhiteSpace(provider.LastChatTestError) && !IsChatReady(provider))
            return $"Chat: {provider.LastChatTestError}";
        if (!string.IsNullOrWhiteSpace(provider.LastVisionTestError) && !IsVisionReady(provider))
            return $"Vision: {provider.LastVisionTestError}";
        if (provider.LastChatTestedAt is not null || provider.LastVisionTestedAt is not null)
        {
            var latest = new[] { provider.LastChatTestedAt, provider.LastVisionTestedAt }.Where(value => value is not null).Max();
            return latest is null ? null : $"Last verified {latest.Value.ToLocalTime():g}";
        }
        return null;
    }

    private static IEnumerable<(LlmReasoningEffort Value, string Label)> ReasoningChoicesFor(LlmProvider provider)
    {
        var supported = provider.ResolvedMetadata?.SupportedEfforts;
        return IsAccountListed(provider) && supported is { Count: > 0 }
            ? ReasoningEffortChoices.Where(choice => supported.Contains(choice.Value))
            : ReasoningEffortChoices;
    }

    private static string ReasoningDefaultLabel(LlmProvider provider)
    {
        if (provider.ModelOrigin == LlmModelOrigin.AccountDiscovered)
        {
            var defaultEffort = OpenAiAccountModelCatalog.ReadDiscoveredMetadata(provider)?.DefaultEffort;
            return defaultEffort is { } effort
                ? $"Account default ({ReasoningLabel(effort)})"
                : "Account default";
        }

        var entry = provider.ModelOrigin == LlmModelOrigin.BundledCatalog
            ? OpenAiAccountModelCatalog.Find(provider.ModelId)
            : null;
        return entry is null
            ? "Provider default"
            : $"Catalog default ({ReasoningLabel(entry.DefaultEffort)})";
    }

    private static string OriginLabel(LlmProvider provider) => provider.ModelOrigin switch
    {
        LlmModelOrigin.BundledCatalog => "Catalog",
        LlmModelOrigin.AccountDiscovered => "From account",
        _ => "Manual",
    };

    private static string ReasoningLabel(LlmReasoningEffort effort) => effort switch
    {
        LlmReasoningEffort.ExtraHigh => "Extra high",
        LlmReasoningEffort.Maximum => "Maximum",
        _ => effort.ToString(),
    };

    private static string ConnectionInitial(LlmProvider connection) =>
        (connection.DisplayName ?? connection.Name).Trim().FirstOrDefault().ToString().ToUpperInvariant();

    private static string AuthLabel(LlmProvider connection) => connection.AuthType switch
    {
        AuthType.ApiKey => "API key connection",
        AuthType.OAuth => "OAuth connection",
        _ => "Local / no authentication"
    };

    private LlmProviderPreset? SelectedNewProviderPreset =>
        LlmProviderCatalog.Find(_newProviderPresetSlug);

    private void OnNewProviderPresetChanged(ChangeEventArgs args)
    {
        _newProviderPresetSlug = args.Value?.ToString() ?? string.Empty;
        if (LlmProviderCatalog.Find(_newProviderPresetSlug) is not { } preset)
            return;

        if (string.IsNullOrWhiteSpace(_newProvider.Name))
            _newProvider.Name = preset.Slug;
        _newProvider.DisplayName = preset.DisplayName;
        _newProvider.EndpointUrl = preset.EndpointUrl;
        _newProvider.AuthType = preset.AuthType;
        if (preset.AuthType != AuthType.ApiKey)
            _newProvider.ApiKey = null;
        _newProviderModels = preset.SeededModels;
        _newProvider.MaxOutputTokens = null;
        if (string.IsNullOrWhiteSpace(_newProvider.ModelId) && preset.SeededModels.Count > 0)
            _newProvider.ModelId = preset.SeededModels[0];
    }

    private void OnNewProviderModelSelected(ChangeEventArgs args)
    {
        var value = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(value))
            return;
        _newProvider.ModelId = value;
        if (_newProvider.MaxInputTokens is null
            && _newProviderContextLengths.TryGetValue(value, out var contextLength))
            _newProvider.MaxInputTokens = contextLength;
    }

    private void OnRowModelSelected(LlmProvider model, ChangeEventArgs args)
    {
        var value = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(value))
            return;
        model.ModelId = value;
        if (model.MaxInputTokens is null
            && _rowContextLengths.TryGetValue(model.Id, out var lengths)
            && lengths.TryGetValue(value, out var contextLength))
            model.MaxInputTokens = contextLength;
    }

    private void OnChildModelSelected(int parentId, ChangeEventArgs args)
    {
        if (!_childForms.TryGetValue(parentId, out var draft))
            return;
        var value = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(value))
            return;
        draft.ModelId = value;
        if (draft.MaxInputTokens is null
            && _childContextLengths.TryGetValue(parentId, out var lengths)
            && lengths.TryGetValue(value, out var contextLength))
            draft.MaxInputTokens = contextLength;
    }

    private static Dictionary<string, int> BuildContextLengthMap(IReadOnlyList<LlmDiscoveredModel> models) =>
        models
            .Where(model => model.ContextLengthTokens is > 0)
            .ToDictionary(
                model => model.Id,
                model => (int)Math.Min(model.ContextLengthTokens!.Value, int.MaxValue),
                StringComparer.Ordinal);

    private async Task ListNewProviderModelsAsync()
    {
        var provider = BuildNewProviderOrSetStatus(requireApiKey: false, requireModel: false);
        if (provider is null)
            return;

        if (string.IsNullOrWhiteSpace(provider.ModelId))
            provider.ModelId = "models-discovery-placeholder";

        _listingNewProviderModels = true;
        try
        {
            var discovered = await ModelCatalog.ListChatModelsAsync(provider);
            _newProviderModels = [.. discovered.Select(model => model.Id)];
            _newProviderContextLengths.Clear();
            foreach (var (id, tokens) in BuildContextLengthMap(discovered))
                _newProviderContextLengths[id] = tokens;
            if (_newProviderModels.Count == 0)
                SetStatus("The provider returned an empty model list; enter the model ID manually.", "info");
        }
        catch (Exception ex)
        {
            _newProviderModels = [];
            _newProviderContextLengths.Clear();
            SetStatus($"Model discovery failed: {ex.Message} Enter the model ID manually.", "info");
        }
        finally
        {
            _listingNewProviderModels = false;
        }
    }

    private async Task ListRowModelsAsync(LlmProvider model)
    {
        _listingRowModelId = model.Id;
        try
        {
            var discovered = await ModelCatalog.ListChatModelsAsync(model);
            _rowModels[model.Id] = [.. discovered.Select(item => item.Id)];
            _rowContextLengths[model.Id] = BuildContextLengthMap(discovered);
            if (_rowModels[model.Id].Count == 0)
                SetStatus("The provider returned an empty model list; enter the model ID manually.", "info");
        }
        catch (Exception ex)
        {
            _rowModels.Remove(model.Id);
            _rowContextLengths.Remove(model.Id);
            SetStatus($"Model discovery failed: {ex.Message} Enter the model ID manually.", "info");
        }
        finally
        {
            _listingRowModelId = null;
        }
    }

    private async Task ListChildModelsAsync(LlmProvider parent)
    {
        _listingChildModelParentId = parent.Id;
        try
        {
            var discovered = await ModelCatalog.ListChatModelsAsync(parent);
            _childModels[parent.Id] = [.. discovered.Select(item => item.Id)];
            _childContextLengths[parent.Id] = BuildContextLengthMap(discovered);
            if (_childModels[parent.Id].Count == 0)
                SetStatus("The provider returned an empty model list; enter the model ID manually.", "info");
        }
        catch (Exception ex)
        {
            _childModels.Remove(parent.Id);
            _childContextLengths.Remove(parent.Id);
            SetStatus($"Model discovery failed: {ex.Message} Enter the model ID manually.", "info");
        }
        finally
        {
            _listingChildModelParentId = null;
        }
    }
    private LlmProvider? BuildNewProviderOrSetStatus(bool requireApiKey = true, bool requireModel = true)
    {
        var name = (_newProvider.Name ?? string.Empty).Trim();
        var endpoint = (_newProvider.EndpointUrl ?? string.Empty).Trim();
        var model = (_newProvider.ModelId ?? string.Empty).Trim();
        var apiKey = string.IsNullOrWhiteSpace(_newProvider.ApiKey) ? null : _newProvider.ApiKey.Trim();

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(endpoint) || (requireModel && string.IsNullOrWhiteSpace(model)))
        {
            SetStatus(requireModel
                ? "Name, Endpoint URL, and Model ID are required."
                : "Name and Endpoint URL are required.", "danger");
            return null;
        }

        if (requireApiKey && _newProvider.AuthType == AuthType.ApiKey && string.IsNullOrWhiteSpace(apiKey))
        {
            SetStatus("API Key is required when Auth is API Key.", "danger");
            return null;
        }

        return new LlmProvider
        {
            Name = name,
            DisplayName = string.IsNullOrWhiteSpace(_newProvider.DisplayName) ? null : _newProvider.DisplayName.Trim(),
            EndpointUrl = endpoint,
            ModelId = model,
            ReasoningEffort = _newProvider.ReasoningEffort,
            MaxOutputTokens = _newProvider.MaxOutputTokens,
            MaxInputTokens = _newProvider.MaxInputTokens,
            MaxTokensField = _newProvider.MaxTokensField,
            AuthType = _newProvider.AuthType,
            ApiKey = _newProvider.AuthType == AuthType.ApiKey ? apiKey : null,
            IsDefault = _newProvider.IsDefault
        };
    }

    private NewProviderConnectionSnapshot GetNewProviderConnectionSnapshot() =>
        new(
            (_newProvider.EndpointUrl ?? string.Empty).Trim(),
            (_newProvider.ModelId ?? string.Empty).Trim(),
            _newProvider.ReasoningEffort,
            _newProvider.MaxOutputTokens,
            _newProvider.MaxTokensField,
            _newProvider.AuthType,
            _newProvider.AuthType == AuthType.ApiKey ? (_newProvider.ApiKey ?? string.Empty).Trim() : string.Empty);

    private void SetStatus(string message, string kind)
    {
        _statusMessage = message;
        _statusKind = kind;
    }

    private sealed class AccountSection(OpenAiAccountKind kind)
    {
        public OpenAiAccountKind Kind { get; } = kind;
        public OpenAiAccount? Account { get; set; }
        public bool Connected { get; set; }
        public bool Refreshing { get; set; }
        public bool AutoRefreshAttempted { get; set; }
        public OpenAiCallbackOriginValidation? CallbackOrigin { get; set; }
        public string SectionKey => Kind == OpenAiAccountKind.Codex ? "openai-account" : "chatgpt-plan";
    }

    private static bool UsesChatCompletions(string? endpoint, string? model, int? accountId = null) =>
        ProviderChatProtocol.For(new LlmProvider
        {
            Name = "", EndpointUrl = endpoint ?? "", ModelId = model ?? "", OpenAiAccountId = accountId,
        }) == ProviderChatProtocol.ChatCompletions;

