@page "/settings/providers"
@using Lorekeeper.Authorization
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject ILlmProviderService ProviderService
@inject IOpenAiAccountService OpenAiAccounts
@inject IOpenAiAccountModelCatalogService OpenAiCatalog
@inject IOpenAiAccountAuthorizationService OpenAiAuthorization
@inject IOpenAiAccountTokenService OpenAiTokens
@inject IOpenAiCallbackOriginValidator CallbackOrigin
@inject IEmbeddingConfigurationService EmbeddingConfiguration
@inject IChatClientFactory ChatClientFactory
@inject IVisionModelClientFactory VisionModelClientFactory
@inject IModelCatalogService ModelCatalog
@inject NavigationManager Nav
@inject ILogger<Providers> Logger
@implements IAsyncDisposable

<PageTitle>LLM Providers</PageTitle>

<ConfigurationShell Title="Model providers" Description="Connect language and vision models, verify their capabilities, and choose the default used across Lorekeeper.">
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-@_statusKind alert-dismissible fade show" role="alert">
            @_statusMessage
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="ClearStatus"></button>
        </div>
    }

    <section class="provider-overview" aria-label="Provider readiness">
        <div><span class="lk-section-kicker">Connections</span><strong>@(OtherParents.Count() + (_openAiAccount is null ? 0 : 1))</strong><small>credential sources</small></div>
        <div><span class="lk-section-kicker">Chat ready</span><strong>@_chatReadyStatus.Count(item => item.Value)</strong><small>usable models</small></div>
        <div><span class="lk-section-kicker">Vision ready</span><strong>@_visionReadyStatus.Count(item => item.Value)</strong><small>image-capable models</small></div>
        <div class="provider-overview-action">
            <button type="button" class="btn btn-primary" @onclick="ToggleAddConnection">@(_addingConnection ? "Close form" : "Add connection")</button>
        </div>
    </section>

    @if (!_hasWorkingChatProvider)
    {
        <div class="alert alert-warning"><strong>LLM features are not ready.</strong> Connect an OpenAI account, or add and verify a manual provider.</div>
    }

    @if (_addingConnection)
    {
        <section class="lk-section-card provider-add-card" aria-labelledby="add-connection-title">
            <div class="lk-section-heading">
                <div><span class="lk-section-kicker">OpenAI-compatible API</span><h2 id="add-connection-title">Add a connection</h2><p>Enter the endpoint and initial model, test it, then save the verified connection.</p></div>
            </div>
            <div class="connection-form-grid">
                <label class="field-wide">
                    <span>Provider preset</span>
                    <select class="form-select" value="@_newProviderPresetSlug" @onchange="OnNewProviderPresetChanged">
                        <option value="">Custom / manual entry</option>
                        @foreach (var preset in LlmProviderCatalog.Presets.Where(preset => preset.Slug != LlmProviderCatalog.CustomPresetSlug))
                        {
                            <option value="@preset.Slug">@preset.DisplayName</option>
                        }
                    </select>
                    @if (SelectedNewProviderPreset is { } selectedPreset)
                    {
                        <small class="field-note">
                            @selectedPreset.Note
                            @if (selectedPreset.KeyManagementUrl is { } keyUrl)
                            {
                                <a href="@keyUrl" target="_blank" rel="noopener">Get an API key</a>
                            }
                        </small>
                    }
                </label>

                <label><span>Name (slug)</span><input class="form-control" @bind="_newProvider.Name" placeholder="ollama-local" /></label>
                <label><span>Display name</span><input class="form-control" @bind="_newProvider.DisplayName" placeholder="Local Ollama" /></label>
                <label class="field-wide"><span>Endpoint URL</span><input class="form-control" @bind="_newProvider.EndpointUrl" placeholder="http://localhost:11434/v1" /></label>
                <label>
                    <span>Initial model ID</span>
                    <div class="model-id-field">
                        <input class="form-control" @bind="_newProvider.ModelId" placeholder="llama3" />
                        <button type="button" class="btn btn-outline-secondary" disabled="@AnyTestRunning" @onclick="ListNewProviderModelsAsync">@(_listingNewProviderModels ? "Listing…" : "List models")</button>
                    </div>
                    @if (_newProviderModels.Count > 0)
                    {
                        <select class="form-select form-select-sm" value="@_newProvider.ModelId" @onchange="OnNewProviderModelSelected">
                            <option value="">-- Select a model --</option>
                            @foreach (var candidate in _newProviderModels)
                            {
                                <option value="@candidate">@candidate</option>
                            }
                        </select>
                        <small class="field-note">Pick a discovered model, or type any model ID above.</small>
                    }
                </label>
                <label>
                    <span>Thinking effort</span>
                    <select class="form-select" @bind="_newProvider.ReasoningEffort">
                        <option value="">Provider default</option>
                        @foreach (var choice in ReasoningEffortChoices)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                    <small class="field-note">Higher effort can improve complex work, with more latency and token use. Support depends on the model. "Provider default" omits the parameter entirely — use it for gateways that reject <code>reasoning_effort</code>.</small>
                </label>
                <label>
                    <span>Max output tokens</span>
                    <input type="number" min="1" step="1" class="form-control" placeholder="Auto" @bind="_newProvider.MaxOutputTokens" />
                    <small class="field-note">Caps the response budget. Leave blank to auto-apply a per-endpoint default: standard field with 16,384 for generic/unknown gateways, none for OpenAI and local servers.</small>
                </label>
                <label>
                    <span>Max input tokens</span>
                    <input type="number" min="1" step="1" class="form-control" placeholder="Auto (model/default)" @bind="_newProvider.MaxInputTokens" />
                    <small class="field-note">Advisory context budget used to decide when assistant tool results are compacted. Blank uses a configured per-model value when available, then the general default.</small>
                </label>
                <label>
                    <span>Max tokens field</span>
                    <select class="form-select" @bind="_newProvider.MaxTokensField">
                        @foreach (var choice in MaxTokensFieldChoices)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                    <small class="field-note">Field name carrying the output budget. "Auto" follows the endpoint (legacy <code>max_tokens</code> for DeepSeek/Together and local servers, OpenAI <code>max_completion_tokens</code> otherwise). Override for gateways that reject the auto-chosen field.</small>
                </label>
                <label><span>Authentication</span><select class="form-select" @bind="_newProvider.AuthType"><option value="@AuthType.None">None</option><option value="@AuthType.ApiKey">API key</option></select></label>
                @if (_newProvider.AuthType == AuthType.ApiKey)
                {
                    <label class="field-wide"><span>API key</span><input type="password" class="form-control" @bind="_newProvider.ApiKey" autocomplete="off" /></label>
                }
                <label class="connection-checkbox"><input type="checkbox" class="form-check-input" @bind="_newProvider.IsDefault" /><span>Make this the default after verification</span></label>
            </div>
            <div class="provider-form-actions">
                <button type="button" class="btn btn-outline-info" disabled="@AnyTestRunning" @onclick="TestNewProviderAsync">@(_isTestingNewProvider ? "Testing…" : "Test")</button>
                <button type="button" class="btn btn-primary" disabled="@(!CanAddNewProvider)" @onclick="CreateProviderAsync">Save connection</button>
                <span class="form-hint">A successful chat test is required before saving; the vision check reports separately.</span>
            </div>
        </section>
    }

    <section class="provider-list" aria-label="Configured provider connections">
        <article class="connection-card codex-card">
            <header class="connection-header">
                <div class="connection-identity">
                    <span class="connection-mark">AI</span>
                    <div><span class="lk-section-kicker">OpenAI account</span><h2>OpenAI account</h2><p>Use the bundled model catalog without managing an API key or running manual model tests.</p></div>
                </div>
                <div class="connection-actions">
                    @if (_authorizationFlow?.IsPending == true)
                    {
                        <span class="lk-status-pill is-warning">Authorization pending</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelOpenAiAuthorizationAsync">Cancel</button>
                    }
                    @if (_codexConnected)
                    {
                        <span class="lk-status-pill is-success">Connected</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_refreshingOpenAiCatalog" @onclick="RefreshOpenAiCatalogAsync">@(_refreshingOpenAiCatalog ? "Refreshing…" : "Refresh models")</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!CanStartOpenAiAuthorization)" @onclick="ConnectCodexAsync">Reconnect</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DisconnectCodexAsync">Disconnect</button>
                    }
                    else
                    {
                        <span class="lk-status-pill is-warning">Not connected</span>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(!CanStartOpenAiAuthorization)" @onclick="ConnectCodexAsync">Connect OpenAI</button>
                    }
                </div>
            </header>
            @if (_callbackOrigin is { IsValid: false })
            {
                <div class="alert alert-warning">@_callbackOrigin.Message</div>
            }
            @if (!string.IsNullOrWhiteSpace(_openAiAccount?.LastAuthenticationError))
            {
                <div class="alert alert-warning">@_openAiAccount.LastAuthenticationError</div>
            }
            @if (_authorizationTarget is not null)
            {
                <div class="alert alert-info">
                    OpenAI authorization is ready. Use this explicit external link, then return to this page while Lorekeeper completes the connection.
                    <a class="btn btn-sm btn-outline-primary ms-2" href="@_authorizationTarget.AbsoluteUri" target="_blank" rel="noopener noreferrer">Open OpenAI authorization</a>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_openAiAccount?.LastCatalogRefreshError))
            {
                <div class="alert alert-warning">@_openAiAccount.LastCatalogRefreshError</div>
            }
            @if (_codexProvider is not null)
            {
                <div class="model-list">
                    @foreach (var model in CodexModels)
                    {
                        <div class="model-row">
                            <div class="model-row-main">
                                <div class="model-fields">
                                    <label><span>Display name · @(model.ModelOrigin == LlmModelOrigin.BundledCatalog ? "Catalog" : "Manual")</span><input class="form-control form-control-sm" @bind="model.DisplayName" disabled="@(model.ModelOrigin == LlmModelOrigin.BundledCatalog)" /></label>
                                    <label>
                                        <span>Model ID</span>
                                        <div class="model-id-field">
                                            <input class="form-control form-control-sm" @bind="model.ModelId" disabled="@(model.ModelOrigin == LlmModelOrigin.BundledCatalog)" />
                                            @if (model.ModelOrigin == LlmModelOrigin.Manual)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_listingRowModelId is not null)" @onclick="() => ListRowModelsAsync(model)">@(_listingRowModelId == model.Id ? "Listing…" : "List models")</button>
                                            }
                                        </div>
                                        @if (_rowModels.TryGetValue(model.Id, out var rowModels) && rowModels.Count > 0)
                                        {
                                            <select class="form-select form-select-sm" value="@model.ModelId" @onchange="args => OnRowModelSelected(model, args)">
                                                <option value="">-- Select a model --</option>
                                                @foreach (var candidate in rowModels)
                                                {
                                                    <option value="@candidate">@candidate</option>
                                                }
                                            </select>
                                            <small class="field-note">Pick a discovered model or keep your typed ID.</small>
                                        }
                                    </label>
                                    <label>
                                        <span>Thinking effort</span>
                                        <select class="form-select form-select-sm" @bind="model.ReasoningEffort">
                                            <option value="">@ReasoningDefaultLabel(model)</option>
                                            @foreach (var choice in ReasoningChoicesFor(model))
                                            {
                                                <option value="@choice.Value">@choice.Label</option>
                                            }
                                        </select>
                                        <small class="field-note">@(model.ModelOrigin == LlmModelOrigin.BundledCatalog ? "Only efforts supported by this catalog model are offered." : "Higher levels use more time and tokens; model support varies.")</small>
                                    </label>
                                    @RenderMaxTokenControls(model)
                                </div>
                                <div class="model-status-panel">
                                    <div class="model-readiness"><div><span>Chat</span>@RenderChatStatus(model)</div><div><span>Vision</span>@RenderVisionStatus(model)</div>@if (model.IsDefault){<span class="lk-status-pill is-accent">Default</span>}</div>
                                    @if (ModelReadinessDetail(model) is { } detail){<div class="model-detail">@detail</div>}
                                    <div class="model-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SaveProviderAsync(model)">Save</button>
                                        @if (model.ModelOrigin == LlmModelOrigin.Manual)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestProviderAsync(model)">@(_testingProviderId == model.Id ? "Testing…" : "Test")</button>
                                        }
                                        @if (!model.IsDefault){<button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!IsChatReady(model))" title="@DefaultButtonTitle(model)" @onclick="() => SetDefaultAsync(model.Id)">Set default</button>}
                                        @if (model.ModelOrigin == LlmModelOrigin.Manual){<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleModelDelete(model.Id)">Delete</button>}
                                    </div>
                                </div>
                            </div>
                            @if (_confirmDeleteModelId == model.Id){<div class="inline-confirm"><span>Delete this model configuration?</span><button class="btn btn-sm btn-danger" @onclick="() => DeleteProviderAsync(model)">Delete</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteModelId = null">Cancel</button></div>}
                        </div>
                    }
                </div>
                <div class="connection-footer"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAddChild(_codexProvider.Id)">Advanced: add manual model</button></div>
                @RenderChildForm(_codexProvider)
            }
        </article>

        @foreach (var connection in OtherParents)
        {
            <article class="connection-card">
                <header class="connection-header">
                    <div class="connection-identity">
                        <span class="connection-mark">@ConnectionInitial(connection)</span>
                        <div><span class="lk-section-kicker">@AuthLabel(connection)</span><h2>@(connection.DisplayName ?? connection.Name)</h2><p title="@connection.EndpointUrl">@connection.EndpointUrl</p></div>
                    </div>
                    <div class="connection-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditConnection(connection)">@(_editingConnectionId == connection.Id ? "Close edit" : "Edit connection")</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAddChild(connection.Id)">Add model</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleConnectionDelete(connection.Id)">Delete</button>
                    </div>
                </header>

                @if (_editingConnectionId == connection.Id && _connectionEdit is not null)
                {
                    <div class="connection-edit-panel">
                        <label><span>Display name</span><input class="form-control form-control-sm" @bind="_connectionEdit.DisplayName" /></label>
                        <label class="field-wide"><span>Endpoint URL</span><input class="form-control form-control-sm" @bind="_connectionEdit.EndpointUrl" /></label>
                        <label><span>Authentication</span><select class="form-select form-select-sm" @bind="_connectionEdit.AuthType"><option value="@AuthType.None">None</option><option value="@AuthType.ApiKey">API key</option></select></label>
                        @if (_connectionEdit.AuthType == AuthType.ApiKey){<label class="field-wide"><span>API key</span><input type="password" class="form-control form-control-sm" @bind="_connectionEdit.ApiKey" autocomplete="off" /></label>}
                        <div class="provider-form-actions field-wide"><button class="btn btn-sm btn-primary" @onclick="SaveConnectionAsync">Save connection</button><span class="form-hint">All nested models will require new readiness tests.</span></div>
                    </div>
                }

                <div class="model-list">
                    @foreach (var model in ModelsFor(connection))
                    {
                        <div class="model-row">
                            <div class="model-row-main">
                                <div class="model-fields">
                                    <label><span>@(model.Id == connection.Id ? "Primary model name" : "Model name")</span><input class="form-control form-control-sm" @bind="model.DisplayName" /></label>
                                    <label>
                                        <span>Model ID</span>
                                        <div class="model-id-field">
                                            <input class="form-control form-control-sm" @bind="model.ModelId" />
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_listingRowModelId is not null)" @onclick="() => ListRowModelsAsync(model)">@(_listingRowModelId == model.Id ? "Listing…" : "List models")</button>
                                        </div>
                                        @if (_rowModels.TryGetValue(model.Id, out var rowModels) && rowModels.Count > 0)
                                        {
                                            <select class="form-select form-select-sm" value="@model.ModelId" @onchange="args => OnRowModelSelected(model, args)">
                                                <option value="">-- Select a model --</option>
                                                @foreach (var candidate in rowModels)
                                                {
                                                    <option value="@candidate">@candidate</option>
                                                }
                                            </select>
                                            <small class="field-note">Pick a discovered model or keep your typed ID.</small>
                                        }
                                    </label>
                                    <label>
                                        <span>Thinking effort</span>
                                        <select class="form-select form-select-sm" @bind="model.ReasoningEffort">
                                            <option value="">Provider default</option>
                                            @foreach (var choice in ReasoningEffortChoices)
                                            {
                                                <option value="@choice.Value">@choice.Label</option>
                                            }
                                        </select>
                                        <small class="field-note">Higher levels use more time and tokens; model support varies.</small>
                                    </label>
                                    @RenderMaxTokenControls(model)
                                </div>
                                <div class="model-status-panel">
                                    <div class="model-readiness"><div><span>Chat</span>@RenderChatStatus(model)</div><div><span>Vision</span>@RenderVisionStatus(model)</div>@if (model.IsDefault){<span class="lk-status-pill is-accent">Default</span>}</div>
                                    @if (ModelReadinessDetail(model) is { } detail){<div class="model-detail">@detail</div>}
                                    <div class="model-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SaveProviderAsync(model)">Save</button>
                                        <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestProviderAsync(model)">@(_testingProviderId == model.Id ? "Testing…" : "Test")</button>
                                        @if (!model.IsDefault){<button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!IsChatReady(model))" title="@DefaultButtonTitle(model)" @onclick="() => SetDefaultAsync(model.Id)">Set default</button>}
                                        @if (model.CredentialSourceId is not null){<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleModelDelete(model.Id)">Delete</button>}
                                    </div>
                                </div>
                            </div>
                            @if (_confirmDeleteModelId == model.Id){<div class="inline-confirm"><span>Delete this model configuration?</span><button class="btn btn-sm btn-danger" @onclick="() => DeleteProviderAsync(model)">Delete</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteModelId = null">Cancel</button></div>}
                        </div>
                    }
                </div>
                @RenderChildForm(connection)
                @if (_confirmDeleteConnectionId == connection.Id)
                {
                    <div class="connection-delete-confirm"><div><strong>Delete this connection and its nested models?</strong><span>This removes @ModelsFor(connection).Count model configuration(s). This cannot be undone.</span></div><button class="btn btn-sm btn-danger" @onclick="() => DeleteConnectionAsync(connection)">Delete connection</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteConnectionId = null">Cancel</button></div>
                }
            </article>
        }

        @if (_codexProvider is null && !OtherParents.Any())
        {
            <div class="lk-empty-state"><h2>No model connections yet</h2><p>Connect OpenAI above or add an OpenAI-compatible endpoint.</p><button class="btn btn-primary" @onclick="ToggleAddConnection">Add a connection</button></div>
        }
    </section>
</ConfigurationShell>

@code {
    private List<LlmProvider> _parents = [];
    private Dictionary<int, List<LlmProvider>> _children = [];
    private Dictionary<int, bool> _chatReadyStatus = [];
    private Dictionary<int, bool> _visionReadyStatus = [];
    private LlmProvider? _codexProvider;
    private OpenAiAccount? _openAiAccount;
    private bool _codexConnected;
    private bool _refreshingOpenAiCatalog;
    private bool _hasWorkingChatProvider;
    private OpenAiCallbackOriginValidation? _callbackOrigin;
    private OpenAiAuthorizationFlowSnapshot? _authorizationFlow;
    private Uri? _authorizationTarget;
    private CancellationTokenSource? _authorizationPollingCancellation;
    private Task? _authorizationPollingTask;
    private bool _disposed;

    private readonly Dictionary<int, ChildDraft> _childForms = [];
    private NewProviderDraft _newProvider = new();
    private ConnectionEditDraft? _connectionEdit;
    private NewProviderConnectionSnapshot? _testedNewProviderSnapshot;
    private bool _addingConnection;
    private int? _editingConnectionId;
    private int? _confirmDeleteConnectionId;
    private int? _confirmDeleteModelId;
    private bool _isTestingNewProvider;
    private int? _testingProviderId;
    private string _newProviderPresetSlug = "";
    private IReadOnlyList<string> _newProviderModels = [];
    private readonly Dictionary<string, int> _newProviderContextLengths = [];
    private bool _listingNewProviderModels;
    private bool _newProviderVisionSucceeded;
    private string? _newProviderVisionError;
    private readonly Dictionary<int, IReadOnlyList<string>> _rowModels = [];
    private readonly Dictionary<int, Dictionary<string, int>> _rowContextLengths = [];
    private readonly Dictionary<int, IReadOnlyList<string>> _childModels = [];
    private readonly Dictionary<int, Dictionary<string, int>> _childContextLengths = [];
    private int? _listingRowModelId;
    private int? _listingChildModelParentId;

    private string? _statusMessage;
    private string _statusKind = "success";

    private static readonly (LlmReasoningEffort Value, string Label)[] ReasoningEffortChoices =
    [
        (LlmReasoningEffort.None, "None"),
        (LlmReasoningEffort.Minimal, "Minimal"),
        (LlmReasoningEffort.Low, "Low"),
        (LlmReasoningEffort.Medium, "Medium"),
        (LlmReasoningEffort.High, "High"),
        (LlmReasoningEffort.ExtraHigh, "Extra high"),
        (LlmReasoningEffort.Maximum, "Maximum"),
    ];

    private static readonly (LlmMaxTokensField Value, string Label)[] MaxTokensFieldChoices =
    [
        (LlmMaxTokensField.Default, "Auto"),
        (LlmMaxTokensField.Standard, "max_completion_tokens"),
        (LlmMaxTokensField.Legacy, "max_tokens"),
    ];

    private bool AnyTestRunning => _testingProviderId is not null || _isTestingNewProvider || _listingNewProviderModels || _listingRowModelId is not null || _listingChildModelParentId is not null;
    private bool CanStartOpenAiAuthorization =>
        _callbackOrigin?.IsValid == true && _authorizationFlow?.IsPending != true;
    private IEnumerable<LlmProvider> OtherParents => _parents.Where(provider => !CodexProvider.IsAccountBacked(provider));
    private IReadOnlyList<LlmProvider> CodexModels => _openAiAccount is null
        ? []
        : _parents
            .Where(provider => provider.OpenAiAccountId == _openAiAccount.Id)
            .OrderByDescending(provider => provider.ModelOrigin == LlmModelOrigin.BundledCatalog
                && OpenAiAccountModelCatalog.Find(provider.ModelId)?.IsPreferred == true)
            .ThenByDescending(provider => provider.ModelOrigin == LlmModelOrigin.BundledCatalog)
            .ThenBy(provider => provider.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(provider => provider.Id)
            .ToList();

    private bool CanAddNewProvider =>
        !_isTestingNewProvider
        && !string.IsNullOrWhiteSpace(_newProvider.Name)
        && _testedNewProviderSnapshot is not null
        && _testedNewProviderSnapshot == GetNewProviderConnectionSnapshot();

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ConsumeStatusFromQuery();
        _callbackOrigin = CallbackOrigin.Validate();
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        if (_authorizationFlow?.IsPending == true)
            await OpenAiAuthorization.CancelAsync(_authorizationFlow.AccountId);
        _authorizationPollingCancellation?.Cancel();
        if (_authorizationPollingTask is not null)
        {
            try
            {
                await _authorizationPollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _authorizationPollingCancellation?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ConsumeStatusFromQuery();
        InvokeAsync(StateHasChanged);
    }

    private void ConsumeStatusFromQuery()
    {
        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("message", out var msg))
        {
            _statusMessage = msg.ToString();
            _statusKind = query.TryGetValue("statusKind", out var kind) && IsSupportedStatusKind(kind.ToString())
                ? kind.ToString()
                : _statusMessage.Contains("fail", StringComparison.OrdinalIgnoreCase) ? "danger" : "success";
        }
    }

    private static bool IsSupportedStatusKind(string statusKind) =>
        statusKind is "success" or "info" or "warning" or "danger";

    private void ClearStatus()
    {
        _statusMessage = null;
    }

    private async Task ReloadAsync()
    {
        _openAiAccount = (await OpenAiAccounts.GetAllAsync()).FirstOrDefault();
        if (_openAiAccount is not null)
        {
            try
            {
                await OpenAiCatalog.EnsureCatalogAsync(_openAiAccount.Id);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to reconcile OpenAI catalog {AccountId}", _openAiAccount.Id);
                SetStatus($"OpenAI catalog setup failed: {ex.Message}", "danger");
            }
        }
        var all = await ProviderService.GetAllAsync();
        _parents = all.Where(p => p.CredentialSourceId is null).ToList();
        _children = all
            .Where(p => p.CredentialSourceId is int)
            .GroupBy(p => p.CredentialSourceId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.ModelId).ToList());

        _codexConnected = false;
        if (_openAiAccount is not null)
        {
            try
            {
                _codexConnected = await OpenAiTokens.GetValidAccessAsync(_openAiAccount.Id) is not null;
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to validate OpenAI account {AccountId}", _openAiAccount.Id);
                if (_statusMessage is null)
                {
                    _statusMessage = "The OpenAI connection could not be checked. Retry or reconnect the account.";
                    _statusKind = "warning";
                }
            }

            _openAiAccount = await OpenAiAccounts.GetByIdAsync(_openAiAccount.Id);
        }

        _chatReadyStatus = new Dictionary<int, bool>();
        foreach (var provider in all)
            _chatReadyStatus[provider.Id] = await ProviderService.IsChatProviderWorkingAsync(provider.Id);
        _hasWorkingChatProvider = _chatReadyStatus.Values.Any(ready => ready);

        _visionReadyStatus = new Dictionary<int, bool>();
        foreach (var provider in all)
            _visionReadyStatus[provider.Id] = await ProviderService.IsVisionProviderWorkingAsync(provider.Id);

        _codexProvider = CodexModels.FirstOrDefault();
    }

    private async Task CreateProviderAsync()
    {
        var provider = BuildNewProviderOrSetStatus();
        if (provider is null)
            return;

        if (_testedNewProviderSnapshot != GetNewProviderConnectionSnapshot())
        {
            SetStatus("Run Test successfully before adding this provider.", "danger");
            return;
        }

        try
        {
            provider.MarkChatTestSucceeded(DateTime.UtcNow);
            if (_newProviderVisionSucceeded)
                provider.MarkVisionTestSucceeded(DateTime.UtcNow);
            else if (_newProviderVisionError is not null)
                provider.MarkVisionTestFailed(_newProviderVisionError, DateTime.UtcNow);
            await ProviderService.CreateAsync(provider);
            if (provider.IsDefault)
                await ProviderService.SetDefaultAsync(provider.Id);
            SetStatus($"Provider '{provider.Name}' created.", "success");
            _newProvider = new NewProviderDraft();
            _testedNewProviderSnapshot = null;
            _addingConnection = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to create provider: {ex.Message}", "danger");
        }
    }

    private async Task TestNewProviderAsync()
    {
        var provider = BuildNewProviderOrSetStatus();
        if (provider is null)
            return;

        _isTestingNewProvider = true;
        _testedNewProviderSnapshot = null;
        _newProviderVisionSucceeded = false;
        _newProviderVisionError = null;

        try
        {
            await ChatClientFactory.TestModelAsync(provider);
            _testedNewProviderSnapshot = GetNewProviderConnectionSnapshot();
            provider.MarkChatTestSucceeded(DateTime.UtcNow);

            try
            {
                await VisionModelClientFactory.TestVisionModelAsync(provider);
                provider.MarkVisionTestSucceeded(DateTime.UtcNow);
                _newProviderVisionSucceeded = true;
                SetStatus($"Provider '{provider.DisplayName ?? provider.Name}' endpoint and model verified for chat and vision.", "success");
            }
            catch (Exception visionEx)
            {
                provider.MarkVisionTestFailed(visionEx.Message, DateTime.UtcNow);
                _newProviderVisionError = visionEx.Message;
                SetStatus($"Provider '{provider.DisplayName ?? provider.Name}' verified for chat, but the vision check failed: {visionEx.Message} You can still save this connection; it will not be used for image reading.", "warning");
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Provider test failed: {ex.Message}", "danger");
        }
        finally
        {
            _isTestingNewProvider = false;
        }
    }

    private async Task SaveProviderAsync(LlmProvider p)
    {
        try
        {
            await ProviderService.UpdateAsync(p);
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' updated.", "success");
