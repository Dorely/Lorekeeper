    private void StartEditConnection(LlmProvider connection)
    {
        if (_editingConnectionId == connection.Id)
        {
            _editingConnectionId = null;
            _connectionEdit = null;
            return;
        }

        _editingConnectionId = connection.Id;
        _connectionEdit = new ConnectionEditDraft
        {
            Id = connection.Id,
            DisplayName = connection.DisplayName,
            EndpointUrl = connection.EndpointUrl,
            AuthType = connection.AuthType,
            ApiKey = connection.ApiKey
        };
    }

    private async Task SaveConnectionAsync()
    {
        if (_connectionEdit is null || string.IsNullOrWhiteSpace(_connectionEdit.EndpointUrl))
        {
            SetStatus("Endpoint URL is required.", "danger");
            return;
        }
        if (_connectionEdit.AuthType == AuthType.ApiKey && string.IsNullOrWhiteSpace(_connectionEdit.ApiKey))
        {
            SetStatus("API key is required for API-key authentication.", "danger");
            return;
        }

        try
        {
            await ProviderService.UpdateConnectionAsync(new LlmConnectionUpdate(
                _connectionEdit.Id,
                _connectionEdit.DisplayName,
                _connectionEdit.EndpointUrl,
                _connectionEdit.AuthType,
                _connectionEdit.ApiKey));
            SetStatus("Connection updated. Retest its models before using them.", "success");
            _editingConnectionId = null;
            _connectionEdit = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Connection update failed: {ex.Message}", "danger");
        }
    }

