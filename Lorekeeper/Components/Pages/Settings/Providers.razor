        }
        await ReloadAsync();
    }

    private async Task TestProviderAsync(LlmProvider p)
    {
        _testingProviderId = p.Id;

        try
        {
            await ChatClientFactory.TestModelAsync(p);
            await ProviderService.MarkChatTestSucceededAsync(p);

            string? visionError = null;
            try
            {
                await VisionModelClientFactory.TestVisionModelAsync(p);
                await ProviderService.MarkVisionTestSucceededAsync(p);
            }
            catch (Exception visionEx)
            {
                visionError = visionEx.Message;
                await MarkVisionFailureAsync(p, visionEx.Message);
            }

            SetStatus(visionError is null
                ? $"Provider '{p.DisplayName ?? p.Name}' model '{p.ModelId}' verified for chat and vision."
                : $"Provider '{p.DisplayName ?? p.Name}' model '{p.ModelId}' verified for chat, but the vision check failed: {visionError}",
                visionError is null ? "success" : "warning");
        }
        catch (Exception ex)
        {
            try
            {
                await ProviderService.MarkChatTestFailedAsync(p, ex.Message);
            }
            catch
            {
                // Keep the original test failure visible to the user.
            }
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' test failed: {ex.Message}", "danger");
        }
        finally
        {
            _testingProviderId = null;
            await ReloadAsync();
        }
    }

    private async Task MarkVisionFailureAsync(LlmProvider provider, string error)
    {
        try
        {
            await ProviderService.MarkVisionTestFailedAsync(provider, error);
        }
        catch
        {
            // Keep the original vision failure visible to the user.
        }
    }


