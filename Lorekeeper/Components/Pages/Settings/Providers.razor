@page "/settings/providers"
@using Lorekeeper.Llm
@using Lorekeeper.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject ILlmProviderService ProviderService
@inject ICodexAuthService CodexAuth
@inject IChatClientFactory ChatClientFactory
@inject IVisionModelClientFactory VisionModelClientFactory
@inject NavigationManager Nav
@inject ILogger<Providers> Logger
@implements IDisposable

<PageTitle>LLM Providers</PageTitle>

<ConfigurationShell Title="Model providers" Description="Connect language and vision models, verify their capabilities, and choose the default used across Lorekeeper.">
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-@_statusKind alert-dismissible fade show" role="alert">
            @_statusMessage
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="ClearStatus"></button>
        </div>
    }

    <section class="provider-overview" aria-label="Provider readiness">
        <div><span class="lk-section-kicker">Connections</span><strong>@_parents.Count</strong><small>credential sources</small></div>
        <div><span class="lk-section-kicker">Chat ready</span><strong>@_chatReadyStatus.Count(item => item.Value)</strong><small>verified models</small></div>
        <div><span class="lk-section-kicker">Vision ready</span><strong>@_visionReadyStatus.Count(item => item.Value)</strong><small>image-capable models</small></div>
        <div class="provider-overview-action">
            <button type="button" class="btn btn-primary" @onclick="ToggleAddConnection">@(_addingConnection ? "Close form" : "Add connection")</button>
        </div>
    </section>

    @if (!_hasWorkingChatProvider)
    {
        <div class="alert alert-warning"><strong>LLM features are not ready.</strong> Connect a provider and pass a Chat test to enable them.</div>
    }

    @if (_addingConnection)
    {
        <section class="lk-section-card provider-add-card" aria-labelledby="add-connection-title">
            <div class="lk-section-heading">
                <div><span class="lk-section-kicker">OpenAI-compatible API</span><h2 id="add-connection-title">Add a connection</h2><p>Enter the endpoint and initial model, test it, then save the verified connection.</p></div>
            </div>
            <div class="connection-form-grid">
                <label><span>Name (slug)</span><input class="form-control" @bind="_newProvider.Name" placeholder="ollama-local" /></label>
                <label><span>Display name</span><input class="form-control" @bind="_newProvider.DisplayName" placeholder="Local Ollama" /></label>
                <label class="field-wide"><span>Endpoint URL</span><input class="form-control" @bind="_newProvider.EndpointUrl" placeholder="http://localhost:11434/v1" /></label>
                <label><span>Initial model ID</span><input class="form-control" @bind="_newProvider.ModelId" placeholder="llama3" /></label>
                <label>
                    <span>Thinking effort</span>
                    <select class="form-select" @bind="_newProvider.ReasoningEffort">
                        <option value="">Provider default</option>
                        @foreach (var choice in ReasoningEffortChoices)
                        {
                            <option value="@choice.Value">@choice.Label</option>
                        }
                    </select>
                    <small class="field-note">Higher effort can improve complex work, with more latency and token use. Support depends on the model.</small>
                </label>
                <label><span>Authentication</span><select class="form-select" @bind="_newProvider.AuthType"><option value="@AuthType.None">None</option><option value="@AuthType.ApiKey">API key</option></select></label>
                @if (_newProvider.AuthType == AuthType.ApiKey)
                {
                    <label class="field-wide"><span>API key</span><input type="password" class="form-control" @bind="_newProvider.ApiKey" autocomplete="off" /></label>
                }
                <label class="connection-checkbox"><input type="checkbox" class="form-check-input" @bind="_newProvider.IsDefault" /><span>Make this the default after verification</span></label>
            </div>
            <div class="provider-form-actions">
                <button type="button" class="btn btn-outline-info" disabled="@(_isTestingNewProvider || _testingVisionProviderId is not null)" @onclick="TestNewProviderAsync">@(_isTestingNewProvider ? "Testing chat…" : "Test chat")</button>
                <button type="button" class="btn btn-primary" disabled="@(!CanAddNewProvider)" @onclick="CreateProviderAsync">Save connection</button>
                <span class="form-hint">A successful Chat test is required before saving.</span>
            </div>
        </section>
    }

    <section class="provider-list" aria-label="Configured provider connections">
        <article class="connection-card codex-card">
            <header class="connection-header">
                <div class="connection-identity">
                    <span class="connection-mark">AI</span>
                    <div><span class="lk-section-kicker">OpenAI account</span><h2>OpenAI Codex</h2><p>Use your OpenAI account without managing an API key.</p></div>
                </div>
                <div class="connection-actions">
                    @if (_codexConnected)
                    {
                        <span class="lk-status-pill is-success">Connected</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DisconnectCodexAsync">Disconnect</button>
                    }
                    else
                    {
                        <span class="lk-status-pill is-warning">Not connected</span>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ConnectCodexAsync">Connect OpenAI</button>
                    }
                </div>
            </header>
            @if (_codexProvider is not null)
            {
                <div class="model-list">
                    @foreach (var model in CodexModels)
                    {
                        <div class="model-row">
                            <div class="model-fields">
                                <label><span>@(model.Id == _codexProvider.Id ? "Connection model" : "Display name")</span><input class="form-control form-control-sm" @bind="model.DisplayName" disabled="@(model.Id == _codexProvider.Id)" /></label>
                                <label><span>Model ID</span><input class="form-control form-control-sm" @bind="model.ModelId" /></label>
                                <label>
                                    <span>Thinking effort</span>
                                    <select class="form-select form-select-sm" @bind="model.ReasoningEffort">
                                        <option value="">Provider default</option>
                                        @foreach (var choice in ReasoningEffortChoices)
                                        {
                                            <option value="@choice.Value">@choice.Label</option>
                                        }
                                    </select>
                                    <small class="field-note">Higher levels use more time and tokens; model support varies.</small>
                                </label>
                            </div>
                            <div class="model-readiness"><div><span>Chat</span>@RenderChatStatus(model)</div><div><span>Vision</span>@RenderVisionStatus(model)</div>@if (model.IsDefault){<span class="lk-status-pill is-accent">Default</span>}</div>
                            <div class="model-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SaveProviderAsync(model)">Save</button>
                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestProviderAsync(model)">@(_testingProviderId == model.Id ? "Testing…" : "Test chat")</button>
                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestVisionProviderAsync(model)">@(_testingVisionProviderId == model.Id ? "Testing…" : "Test vision")</button>
                                @if (!model.IsDefault){<button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!IsChatReady(model))" title="@DefaultButtonTitle(model)" @onclick="() => SetDefaultAsync(model.Id)">Set default</button>}
                                @if (model.CredentialSourceId is not null){<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleModelDelete(model.Id)">Delete</button>}
                            </div>
                            @if (ModelReadinessDetail(model) is { } detail){<div class="model-detail">@detail</div>}
                            @if (_confirmDeleteModelId == model.Id){<div class="inline-confirm"><span>Delete this model configuration?</span><button class="btn btn-sm btn-danger" @onclick="() => DeleteProviderAsync(model)">Delete</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteModelId = null">Cancel</button></div>}
                        </div>
                    }
                </div>
                <div class="connection-footer"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAddChild(_codexProvider.Id)">Add model</button></div>
                @RenderChildForm(_codexProvider)
            }
        </article>

        @foreach (var connection in OtherParents)
        {
            <article class="connection-card">
                <header class="connection-header">
                    <div class="connection-identity">
                        <span class="connection-mark">@ConnectionInitial(connection)</span>
                        <div><span class="lk-section-kicker">@AuthLabel(connection)</span><h2>@(connection.DisplayName ?? connection.Name)</h2><p title="@connection.EndpointUrl">@connection.EndpointUrl</p></div>
                    </div>
                    <div class="connection-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditConnection(connection)">@(_editingConnectionId == connection.Id ? "Close edit" : "Edit connection")</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAddChild(connection.Id)">Add model</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleConnectionDelete(connection.Id)">Delete</button>
                    </div>
                </header>

                @if (_editingConnectionId == connection.Id && _connectionEdit is not null)
                {
                    <div class="connection-edit-panel">
                        <label><span>Display name</span><input class="form-control form-control-sm" @bind="_connectionEdit.DisplayName" /></label>
                        <label class="field-wide"><span>Endpoint URL</span><input class="form-control form-control-sm" @bind="_connectionEdit.EndpointUrl" /></label>
                        <label><span>Authentication</span><select class="form-select form-select-sm" @bind="_connectionEdit.AuthType"><option value="@AuthType.None">None</option><option value="@AuthType.ApiKey">API key</option></select></label>
                        @if (_connectionEdit.AuthType == AuthType.ApiKey){<label class="field-wide"><span>API key</span><input type="password" class="form-control form-control-sm" @bind="_connectionEdit.ApiKey" autocomplete="off" /></label>}
                        <div class="provider-form-actions field-wide"><button class="btn btn-sm btn-primary" @onclick="SaveConnectionAsync">Save connection</button><span class="form-hint">All nested models will require new readiness tests.</span></div>
                    </div>
                }

                <div class="model-list">
                    @foreach (var model in ModelsFor(connection))
                    {
                        <div class="model-row">
                            <div class="model-fields">
                                <label><span>@(model.Id == connection.Id ? "Primary model name" : "Model name")</span><input class="form-control form-control-sm" @bind="model.DisplayName" /></label>
                                <label><span>Model ID</span><input class="form-control form-control-sm" @bind="model.ModelId" /></label>
                                <label>
                                    <span>Thinking effort</span>
                                    <select class="form-select form-select-sm" @bind="model.ReasoningEffort">
                                        <option value="">Provider default</option>
                                        @foreach (var choice in ReasoningEffortChoices)
                                        {
                                            <option value="@choice.Value">@choice.Label</option>
                                        }
                                    </select>
                                    <small class="field-note">Higher levels use more time and tokens; model support varies.</small>
                                </label>
                            </div>
                            <div class="model-readiness"><div><span>Chat</span>@RenderChatStatus(model)</div><div><span>Vision</span>@RenderVisionStatus(model)</div>@if (model.IsDefault){<span class="lk-status-pill is-accent">Default</span>}</div>
                            <div class="model-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SaveProviderAsync(model)">Save</button>
                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestProviderAsync(model)">@(_testingProviderId == model.Id ? "Testing…" : "Test chat")</button>
                                <button type="button" class="btn btn-sm btn-outline-info" disabled="@AnyTestRunning" @onclick="() => TestVisionProviderAsync(model)">@(_testingVisionProviderId == model.Id ? "Testing…" : "Test vision")</button>
                                @if (!model.IsDefault){<button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!IsChatReady(model))" title="@DefaultButtonTitle(model)" @onclick="() => SetDefaultAsync(model.Id)">Set default</button>}
                                @if (model.CredentialSourceId is not null){<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ToggleModelDelete(model.Id)">Delete</button>}
                            </div>
                            @if (ModelReadinessDetail(model) is { } detail){<div class="model-detail">@detail</div>}
                            @if (_confirmDeleteModelId == model.Id){<div class="inline-confirm"><span>Delete this model configuration?</span><button class="btn btn-sm btn-danger" @onclick="() => DeleteProviderAsync(model)">Delete</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteModelId = null">Cancel</button></div>}
                        </div>
                    }
                </div>
                @RenderChildForm(connection)
                @if (_confirmDeleteConnectionId == connection.Id)
                {
                    <div class="connection-delete-confirm"><div><strong>Delete this connection and its nested models?</strong><span>This removes @ModelsFor(connection).Count model configuration(s). This cannot be undone.</span></div><button class="btn btn-sm btn-danger" @onclick="() => DeleteConnectionAsync(connection)">Delete connection</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteConnectionId = null">Cancel</button></div>
                }
            </article>
        }

        @if (_codexProvider is null && !OtherParents.Any())
        {
            <div class="lk-empty-state"><h2>No model connections yet</h2><p>Connect OpenAI above or add an OpenAI-compatible endpoint.</p><button class="btn btn-primary" @onclick="ToggleAddConnection">Add a connection</button></div>
        }
    </section>
</ConfigurationShell>

@code {
    private List<LlmProvider> _parents = [];
    private Dictionary<int, List<LlmProvider>> _children = [];
    private Dictionary<int, bool> _oauthStatus = [];
    private Dictionary<int, bool> _chatReadyStatus = [];
    private Dictionary<int, bool> _visionReadyStatus = [];
    private LlmProvider? _codexProvider;
    private bool _codexConnected;
    private bool _hasWorkingChatProvider;

    private readonly Dictionary<int, ChildDraft> _childForms = [];
    private NewProviderDraft _newProvider = new();
    private ConnectionEditDraft? _connectionEdit;
    private NewProviderConnectionSnapshot? _testedNewProviderSnapshot;
    private bool _addingConnection;
    private int? _editingConnectionId;
    private int? _confirmDeleteConnectionId;
    private int? _confirmDeleteModelId;
    private bool _isTestingNewProvider;
    private int? _testingProviderId;
    private int? _testingVisionProviderId;

    private string? _statusMessage;
    private string _statusKind = "success";

    private static readonly (LlmReasoningEffort Value, string Label)[] ReasoningEffortChoices =
    [
        (LlmReasoningEffort.None, "None"),
        (LlmReasoningEffort.Minimal, "Minimal"),
        (LlmReasoningEffort.Low, "Low"),
        (LlmReasoningEffort.Medium, "Medium"),
        (LlmReasoningEffort.High, "High"),
        (LlmReasoningEffort.ExtraHigh, "Extra high"),
        (LlmReasoningEffort.Maximum, "Maximum"),
    ];

    private bool AnyTestRunning => _testingProviderId is not null || _testingVisionProviderId is not null || _isTestingNewProvider;
    private IEnumerable<LlmProvider> OtherParents => _parents.Where(provider => !CodexProvider.IsCodex(provider));
    private IReadOnlyList<LlmProvider> CodexModels => _codexProvider is null ? [] : ModelsFor(_codexProvider);

    private bool CanAddNewProvider =>
        !_isTestingNewProvider
        && !string.IsNullOrWhiteSpace(_newProvider.Name)
        && _testedNewProviderSnapshot is not null
        && _testedNewProviderSnapshot == GetNewProviderConnectionSnapshot();

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ConsumeStatusFromQuery();
        await ReloadAsync();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ConsumeStatusFromQuery();
        InvokeAsync(StateHasChanged);
    }

    private void ConsumeStatusFromQuery()
    {
        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("message", out var msg))
        {
            _statusMessage = msg.ToString();
            _statusKind = query.TryGetValue("statusKind", out var kind) && IsSupportedStatusKind(kind.ToString())
                ? kind.ToString()
                : _statusMessage.Contains("fail", StringComparison.OrdinalIgnoreCase) ? "danger" : "success";
        }
    }

    private static bool IsSupportedStatusKind(string statusKind) =>
        statusKind is "success" or "info" or "warning" or "danger";

    private void ClearStatus()
    {
        _statusMessage = null;
    }

    private async Task ReloadAsync()
    {
        var all = await ProviderService.GetAllAsync();
        _parents = all.Where(p => p.CredentialSourceId is null).ToList();
        _children = all
            .Where(p => p.CredentialSourceId is int)
            .GroupBy(p => p.CredentialSourceId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(c => c.ModelId).ToList());

        _oauthStatus = new Dictionary<int, bool>();
        foreach (var p in _parents.Where(p => p.AuthType == AuthType.OAuth))
        {
            try
            {
                var token = await CodexAuth.GetValidTokenAsync(p.Id);
                _oauthStatus[p.Id] = token is not null;
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to validate OAuth connection {ProviderId}", p.Id);
                _oauthStatus[p.Id] = false;
                if (_statusMessage is null)
                {
                    _statusMessage = "An OAuth connection could not be checked. Retry or reconnect the account.";
                    _statusKind = "warning";
                }
            }
        }

        _chatReadyStatus = new Dictionary<int, bool>();
        foreach (var provider in all)
            _chatReadyStatus[provider.Id] = await ProviderService.IsChatProviderWorkingAsync(provider.Id);
        _hasWorkingChatProvider = _chatReadyStatus.Values.Any(ready => ready);

        _visionReadyStatus = new Dictionary<int, bool>();
        foreach (var provider in all)
            _visionReadyStatus[provider.Id] = await ProviderService.IsVisionProviderWorkingAsync(provider.Id);

        _codexProvider = _parents.FirstOrDefault(p => p.Name == CodexProvider.Name);
        _codexConnected = _codexProvider is not null
            && _oauthStatus.TryGetValue(_codexProvider.Id, out var c) && c;
    }

    private async Task CreateProviderAsync()
    {
        var provider = BuildNewProviderOrSetStatus();
        if (provider is null)
            return;

        if (_testedNewProviderSnapshot != GetNewProviderConnectionSnapshot())
        {
            SetStatus("Run Test successfully before adding this provider.", "danger");
            return;
        }

        try
        {
            provider.MarkChatTestSucceeded(DateTime.UtcNow);
            await ProviderService.CreateAsync(provider);
            if (provider.IsDefault)
                await ProviderService.SetDefaultAsync(provider.Id);
            SetStatus($"Provider '{provider.Name}' created.", "success");
            _newProvider = new NewProviderDraft();
            _testedNewProviderSnapshot = null;
            _addingConnection = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to create provider: {ex.Message}", "danger");
        }
    }

    private async Task TestNewProviderAsync()
    {
        var provider = BuildNewProviderOrSetStatus();
        if (provider is null)
            return;

        _isTestingNewProvider = true;
        _testedNewProviderSnapshot = null;

        try
        {
            await ChatClientFactory.TestModelAsync(provider);
            _testedNewProviderSnapshot = GetNewProviderConnectionSnapshot();
            provider.MarkChatTestSucceeded(DateTime.UtcNow);
            SetStatus($"Provider '{provider.DisplayName ?? provider.Name}' endpoint and model verified.", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Provider test failed: {ex.Message}", "danger");
        }
        finally
        {
            _isTestingNewProvider = false;
        }
    }

    private async Task SaveProviderAsync(LlmProvider p)
    {
        try
        {
            await ProviderService.UpdateAsync(p);
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' updated.", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Save failed: {ex.Message}", "danger");
        }
        await ReloadAsync();
    }

    private async Task TestProviderAsync(LlmProvider p)
    {
        _testingProviderId = p.Id;

        try
        {
            await ChatClientFactory.TestModelAsync(p);
            await ProviderService.MarkChatTestSucceededAsync(p);
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' model '{p.ModelId}' saved and verified.", "success");
        }
        catch (Exception ex)
        {
            try
            {
                await ProviderService.MarkChatTestFailedAsync(p, ex.Message);
            }
            catch
            {
                // Keep the original test failure visible to the user.
            }
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' test failed: {ex.Message}", "danger");
        }
        finally
        {
            _testingProviderId = null;
            await ReloadAsync();
        }
    }

    private async Task TestVisionProviderAsync(LlmProvider p)
    {
        _testingVisionProviderId = p.Id;

        try
        {
            await VisionModelClientFactory.TestVisionModelAsync(p);
            await ProviderService.MarkVisionTestSucceededAsync(p);
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' model '{p.ModelId}' saved and vision-verified.", "success");
        }
        catch (Exception ex)
        {
            try
            {
                await ProviderService.MarkVisionTestFailedAsync(p, ex.Message);
            }
            catch
            {
                // Keep the original test failure visible to the user.
            }
            SetStatus($"Provider '{p.DisplayName ?? p.Name}' vision test failed: {ex.Message}", "danger");
        }
        finally
        {
            _testingVisionProviderId = null;
            await ReloadAsync();
        }
    }

    private async Task SetDefaultAsync(int id)
    {
        try
        {
            await ProviderService.SetDefaultAsync(id);
            SetStatus("Default provider updated.", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"Default provider update failed: {ex.Message}", "danger");
        }
        await ReloadAsync();
    }

    private async Task DeleteProviderAsync(LlmProvider p)
    {
        await ProviderService.DeleteAsync(p.Id);
        SetStatus($"Provider '{p.DisplayName ?? p.Name}' deleted.", "success");
        _confirmDeleteModelId = null;
        await ReloadAsync();
    }

    private async Task DeleteConnectionAsync(LlmProvider connection)
    {
        try
        {
            await ProviderService.DeleteConnectionAsync(connection.Id);
            SetStatus($"Connection '{connection.DisplayName ?? connection.Name}' and its models were deleted.", "success");
            _confirmDeleteConnectionId = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Connection delete failed: {ex.Message}", "danger");
        }
    }

    private void ToggleAddConnection()
    {
        _addingConnection = !_addingConnection;
        if (!_addingConnection)
        {
            _newProvider = new NewProviderDraft();
            _testedNewProviderSnapshot = null;
        }
    }

    private void StartEditConnection(LlmProvider connection)
    {
        if (_editingConnectionId == connection.Id)
        {
            _editingConnectionId = null;
            _connectionEdit = null;
            return;
        }

        _editingConnectionId = connection.Id;
        _connectionEdit = new ConnectionEditDraft
        {
            Id = connection.Id,
            DisplayName = connection.DisplayName,
            EndpointUrl = connection.EndpointUrl,
            AuthType = connection.AuthType,
            ApiKey = connection.ApiKey
        };
    }

    private async Task SaveConnectionAsync()
    {
        if (_connectionEdit is null || string.IsNullOrWhiteSpace(_connectionEdit.EndpointUrl))
        {
            SetStatus("Endpoint URL is required.", "danger");
            return;
        }
        if (_connectionEdit.AuthType == AuthType.ApiKey && string.IsNullOrWhiteSpace(_connectionEdit.ApiKey))
        {
            SetStatus("API key is required for API-key authentication.", "danger");
            return;
        }

        try
        {
            await ProviderService.UpdateConnectionAsync(new LlmConnectionUpdate(
                _connectionEdit.Id,
                _connectionEdit.DisplayName,
                _connectionEdit.EndpointUrl,
                _connectionEdit.AuthType,
                _connectionEdit.ApiKey));
            SetStatus("Connection updated. Retest its models before using them.", "success");
            _editingConnectionId = null;
            _connectionEdit = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Connection update failed: {ex.Message}", "danger");
        }
    }

    private void ToggleConnectionDelete(int id) =>
        _confirmDeleteConnectionId = _confirmDeleteConnectionId == id ? null : id;

    private void ToggleModelDelete(int id) =>
        _confirmDeleteModelId = _confirmDeleteModelId == id ? null : id;

    private async Task RevokeOAuthAsync(int id)
    {
        await CodexAuth.RevokeTokenAsync(id);
        SetStatus("OAuth token revoked.", "success");
        await ReloadAsync();
    }

    private void ToggleAddChild(int parentId)
    {
        if (!_childForms.Remove(parentId))
            _childForms[parentId] = new ChildDraft();
    }

    private async Task AddChildModelAsync(LlmProvider parent, ChildDraft draft)
    {
        var displayName = (draft.DisplayName ?? string.Empty).Trim();
        var modelId = (draft.ModelId ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(modelId))
        {
            SetStatus("Display Name and Model ID are required.", "danger");
            return;
        }

        var child = new LlmProvider
        {
            Name = $"{parent.Name}-{modelId.Replace("/", "-").Replace(":", "-")}",
            DisplayName = displayName,
            EndpointUrl = parent.EndpointUrl,
            ModelId = modelId,
            ReasoningEffort = draft.ReasoningEffort,
            AuthType = parent.AuthType,
            CredentialSourceId = parent.Id
        };

        try
        {
            await ChatClientFactory.TestModelAsync(child);
            child.MarkChatTestSucceeded(DateTime.UtcNow);
            await ProviderService.CreateAsync(child);
            SetStatus($"Model '{displayName}' ({modelId}) added under {parent.DisplayName ?? parent.Name}.", "success");
            _childForms.Remove(parent.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Add failed: {ex.Message}", "danger");
        }
    }

    private async Task ConnectCodexAsync()
    {
        var codex = _codexProvider;
        if (codex is null)
        {
            codex = new LlmProvider
            {
                Name = CodexProvider.Name,
                DisplayName = "OpenAI (Codex)",
                EndpointUrl = CodexProvider.ResponsesEndpoint,
                ModelId = "gpt-5.4-mini",
                AuthType = AuthType.OAuth,
                IsDefault = false
            };
            await ProviderService.CreateAsync(codex);
        }

        Nav.NavigateTo($"/auth/start/{codex.Id}", forceLoad: true);
    }

    private async Task DisconnectCodexAsync()
    {
        if (_codexProvider is null) return;
        await CodexAuth.RevokeTokenAsync(_codexProvider.Id);
        SetStatus("Codex disconnected.", "success");
        await ReloadAsync();
    }

    private async Task SaveCodexModelAsync()
    {
        if (_codexProvider is null) return;
        await SaveProviderAsync(_codexProvider);
    }

    private async Task TestCodexModelAsync()
    {
        if (_codexProvider is null) return;
        await TestProviderAsync(_codexProvider);
    }

    private async Task TestCodexVisionModelAsync()
    {
        if (_codexProvider is null) return;
        await TestVisionProviderAsync(_codexProvider);
    }

    private bool IsChatReady(LlmProvider provider) =>
        provider.HasCurrentChatTestSnapshot
        && _chatReadyStatus.TryGetValue(provider.Id, out var ready)
        && ready;

    private bool IsVisionReady(LlmProvider provider) =>
        provider.HasCurrentVisionTestSnapshot
        && _visionReadyStatus.TryGetValue(provider.Id, out var ready)
        && ready;

    private string DefaultButtonTitle(LlmProvider provider) =>
        IsChatReady(provider)
            ? "Set as the default chat provider"
            : "Run Test successfully before setting this provider as default.";

    private RenderFragment RenderChatStatus(LlmProvider provider) => __builder =>
    {
        if (IsChatReady(provider))
        {
            <span class="lk-status-pill is-success" title="This model is ready for LLM chat features.">Ready</span>
            return;
        }

        if (provider.LastChatTestedAt is null)
        {
            <span class="lk-status-pill" title="Run Test Chat before using this model.">Untested</span>
            return;
        }

        if (provider.LastChatTestSucceeded && !provider.HasCurrentChatTestSnapshot)
        {
            <span class="lk-status-pill is-warning" title="Connection or model settings changed after the last successful test.">Retest</span>
            return;
        }

        <span class="lk-status-pill is-danger" title="@provider.LastChatTestError">Failed</span>
    };

    private RenderFragment RenderVisionStatus(LlmProvider provider) => __builder =>
    {
        if (IsVisionReady(provider))
        {
            <span class="lk-status-pill is-success" title="This model is ready for image-reading and PDF ingestion.">Ready</span>
            return;
        }

        if (provider.LastVisionTestedAt is null)
        {
            <span class="lk-status-pill" title="Run Test Vision before using this model for image reading.">Untested</span>
            return;
        }

        if (provider.LastVisionTestSucceeded && !provider.HasCurrentVisionTestSnapshot)
        {
            <span class="lk-status-pill is-warning" title="Connection or model settings changed after the last successful vision test.">Retest</span>
            return;
        }

        <span class="lk-status-pill is-danger" title="@provider.LastVisionTestError">Failed</span>
    };

    private List<LlmProvider> ModelsFor(LlmProvider connection)
    {
        var models = new List<LlmProvider> { connection };
        if (_children.TryGetValue(connection.Id, out var children))
            models.AddRange(children);
        return models;
    }

    private RenderFragment RenderChildForm(LlmProvider parent) => __builder =>
    {
        if (!_childForms.TryGetValue(parent.Id, out var draft))
            return;

        <div class="child-model-form">
            <div><span class="lk-section-kicker">Shared connection</span><strong>Add another model</strong><small>Credentials and endpoint come from @(parent.DisplayName ?? parent.Name).</small></div>
            <label><span>Display name</span><input class="form-control form-control-sm" placeholder="GPT-5 Mini" @bind="draft.DisplayName" /></label>
            <label><span>Model ID</span><input class="form-control form-control-sm" placeholder="gpt-5-mini" @bind="draft.ModelId" /></label>
            <label>
                <span>Thinking effort</span>
                <select class="form-select form-select-sm" @bind="draft.ReasoningEffort">
                    <option value="">Provider default</option>
                    @foreach (var choice in ReasoningEffortChoices)
                    {
                        <option value="@choice.Value">@choice.Label</option>
                    }
                </select>
                <small class="field-note">Support depends on the model.</small>
            </label>
            <div class="lk-toolbar"><button type="button" class="btn btn-sm btn-primary" @onclick="() => AddChildModelAsync(parent, draft)">Test and add</button><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _childForms.Remove(parent.Id)">Cancel</button></div>
        </div>
    };

    private string? ModelReadinessDetail(LlmProvider provider)
    {
        if (!string.IsNullOrWhiteSpace(provider.LastChatTestError) && !IsChatReady(provider))
            return $"Chat: {provider.LastChatTestError}";
        if (!string.IsNullOrWhiteSpace(provider.LastVisionTestError) && !IsVisionReady(provider))
            return $"Vision: {provider.LastVisionTestError}";
        if (provider.LastChatTestedAt is not null || provider.LastVisionTestedAt is not null)
        {
            var latest = new[] { provider.LastChatTestedAt, provider.LastVisionTestedAt }.Where(value => value is not null).Max();
            return latest is null ? null : $"Last verified {latest.Value.ToLocalTime():g}";
        }
        return null;
    }

    private static string ConnectionInitial(LlmProvider connection) =>
        (connection.DisplayName ?? connection.Name).Trim().FirstOrDefault().ToString().ToUpperInvariant();

    private static string AuthLabel(LlmProvider connection) => connection.AuthType switch
    {
        AuthType.ApiKey => "API key connection",
        AuthType.OAuth => "OAuth connection",
        _ => "Local / no authentication"
    };

    private LlmProvider? BuildNewProviderOrSetStatus()
    {
        var name = (_newProvider.Name ?? string.Empty).Trim();
        var endpoint = (_newProvider.EndpointUrl ?? string.Empty).Trim();
        var model = (_newProvider.ModelId ?? string.Empty).Trim();
        var apiKey = string.IsNullOrWhiteSpace(_newProvider.ApiKey) ? null : _newProvider.ApiKey.Trim();

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(endpoint) || string.IsNullOrWhiteSpace(model))
        {
            SetStatus("Name, Endpoint URL, and Model ID are required.", "danger");
            return null;
        }

        if (_newProvider.AuthType == AuthType.ApiKey && string.IsNullOrWhiteSpace(apiKey))
        {
            SetStatus("API Key is required when Auth is API Key.", "danger");
            return null;
        }

        return new LlmProvider
        {
            Name = name,
            DisplayName = string.IsNullOrWhiteSpace(_newProvider.DisplayName) ? null : _newProvider.DisplayName.Trim(),
            EndpointUrl = endpoint,
            ModelId = model,
            ReasoningEffort = _newProvider.ReasoningEffort,
            AuthType = _newProvider.AuthType,
            ApiKey = _newProvider.AuthType == AuthType.ApiKey ? apiKey : null,
            IsDefault = _newProvider.IsDefault
        };
    }

    private NewProviderConnectionSnapshot GetNewProviderConnectionSnapshot() =>
        new(
            (_newProvider.EndpointUrl ?? string.Empty).Trim(),
            (_newProvider.ModelId ?? string.Empty).Trim(),
            _newProvider.ReasoningEffort,
            _newProvider.AuthType,
            _newProvider.AuthType == AuthType.ApiKey ? (_newProvider.ApiKey ?? string.Empty).Trim() : string.Empty);

    private void SetStatus(string message, string kind)
    {
        _statusMessage = message;
        _statusKind = kind;
    }

