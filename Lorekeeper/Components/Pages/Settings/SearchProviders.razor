@page "/settings/search-providers"
@using Lorekeeper.Models
@using Lorekeeper.Search
@rendermode InteractiveServer
@inject ISearchProviderService SearchProviderService

<PageTitle>Search Providers</PageTitle>

<ConfigurationShell Title="Search provider" Description="Connect the web search service used by World for discovery and source-grounded investigation.">
    @if (!string.IsNullOrWhiteSpace(_statusMessage)){<div class="alert alert-@_statusKind alert-dismissible fade show" role="alert">@_statusMessage<button type="button" class="btn-close" aria-label="Dismiss" @onclick="ClearStatus"></button></div>}
    <div class="search-toolbar"><div><span class="lk-section-kicker">Web search integration</span><strong>@(_providers.FirstOrDefault(provider => provider.IsActive)?.DisplayName ?? _providers.FirstOrDefault(provider => provider.IsActive)?.Name ?? "No active provider")</strong><small>@(_providers.Any(provider => provider.IsActive) ? "Web search is enabled" : "Web search is unavailable")</small></div><button class="btn btn-primary" @onclick="ToggleAdd">@(_adding ? "Close form" : "Add provider")</button></div>

    @if (_adding)
    {
        <section class="lk-section-card search-add-card"><div class="lk-section-heading"><div><span class="lk-section-kicker">New integration</span><h2>Add a search provider</h2><p>Lorekeeper currently supports SerpApi and Brave Search.</p></div></div><div class="search-form"><label><span>Name (slug)</span><input class="form-control" placeholder="serpapi" @bind="_newProvider.Name" /></label><label><span>Display name</span><input class="form-control" placeholder="SerpApi" @bind="_newProvider.DisplayName" /></label><label><span>Provider</span><select class="form-select" @bind="_newProvider.ProviderKind">@foreach (var kind in SupportedKinds){<option value="@kind">@ProviderKindLabel(kind)</option>}</select></label><label class="field-wide"><span>API key</span><input type="password" class="form-control" @bind="_newProvider.ApiKey" autocomplete="off" /></label><label class="search-active-check"><input type="checkbox" class="form-check-input" @bind="_newProvider.IsActive" /><span>Make active immediately</span></label></div><div class="lk-toolbar search-form-actions"><button class="btn btn-outline-info" disabled="@_testingNew" @onclick="TestNewAsync">@(_testingNew ? "Testing…" : "Test connection")</button><button class="btn btn-primary" disabled="@(!CanCreate)" @onclick="CreateAsync">Save provider</button></div></section>
    }

    @if (_loading)
    {
        <div class="lk-empty-state"><span class="spinner-border spinner-border-sm"></span><span>Loading search providers…</span></div>
    }
    else if (_providers.Count == 0)
    {
        <div class="lk-empty-state"><h2>Web search needs a provider</h2><p>Add SerpApi or Brave Search to enable web search in World.</p><button class="btn btn-primary" @onclick="ToggleAdd">Add search provider</button></div>
    }
    else
    {
        <section class="search-provider-list" aria-label="Configured search providers">
            @foreach (var provider in _providers)
            {
                <article class="search-provider-card @(provider.IsActive ? "is-active" : null)">
                    <header><div class="search-provider-mark">@ProviderInitial(provider)</div><div><span class="lk-section-kicker">@ProviderKindLabel(provider.ProviderKind)</span><h2>@(provider.DisplayName ?? provider.Name)</h2><p>@(provider.IsActive ? "Used by World now" : "Available connection")</p></div>@if (provider.IsActive){<span class="lk-status-pill is-success">Active</span>}</header>
                    <div class="search-provider-fields"><label><span>Name (slug)</span><input class="form-control form-control-sm" @bind="provider.Name" /></label><label><span>Display name</span><input class="form-control form-control-sm" @bind="provider.DisplayName" /></label><label><span>Provider</span><select class="form-select form-select-sm" @bind="provider.ProviderKind">@foreach (var kind in SupportedKinds){<option value="@kind">@ProviderKindLabel(kind)</option>}</select></label><label><span>API key</span><input type="password" class="form-control form-control-sm" @bind="provider.ApiKey" autocomplete="off" /></label></div>
                    <footer><button class="btn btn-sm btn-outline-secondary" @onclick="() => SaveAsync(provider)">Save changes</button><button class="btn btn-sm btn-outline-info" disabled="@(_testingProviderId is not null)" @onclick="() => TestExistingAsync(provider)">@(_testingProviderId == provider.Id ? "Testing…" : "Test connection")</button>@if (!provider.IsActive){<button class="btn btn-sm btn-outline-primary" @onclick="() => SetActiveAsync(provider.Id)">Make active</button>}<button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => ToggleDelete(provider.Id)">Delete</button></footer>
                    @if (_confirmDeleteId == provider.Id){<div class="search-delete-confirm"><span><strong>Delete this provider?</strong> Web search will be unavailable if it is the active connection.</span><button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(provider)">Delete provider</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteId = null">Cancel</button></div>}
                </article>
            }
        </section>
    }
</ConfigurationShell>

@code {
    private static readonly SearchProviderKind[] SupportedKinds = [SearchProviderKind.SerpApi, SearchProviderKind.Brave];

    private List<SearchProvider> _providers = [];
    private SearchProviderDraft _newProvider = new();
    private bool _loading = true;
    private bool _adding;
    private bool _testingNew;
    private int? _testingProviderId;
    private int? _confirmDeleteId;
    private string? _statusMessage;
    private string _statusKind = "success";

    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(_newProvider.Name)
        && !string.IsNullOrWhiteSpace(_newProvider.ApiKey)
        && !_testingNew;

    protected override async Task OnInitializedAsync() =>
        await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _providers = await SearchProviderService.GetAllAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            await SearchProviderService.CreateAsync(BuildProvider(_newProvider));
            SetStatus($"Search provider '{_newProvider.Name}' created.", "success");
            _newProvider = new SearchProviderDraft();
            _adding = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Create failed: {ex.Message}", "danger");
        }
    }

    private async Task SaveAsync(SearchProvider provider)
    {
        try
        {
            await SearchProviderService.UpdateAsync(provider);
            SetStatus($"Search provider '{provider.DisplayName ?? provider.Name}' updated.", "success");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Save failed: {ex.Message}", "danger");
        }
    }

    private async Task SetActiveAsync(int id)
    {
        try
        {
            await SearchProviderService.SetActiveAsync(id);
            SetStatus("Active search provider updated.", "success");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Could not set active provider: {ex.Message}", "danger");
        }
    }

    private async Task DeleteAsync(SearchProvider provider)
    {
        await SearchProviderService.DeleteAsync(provider.Id);
        SetStatus($"Search provider '{provider.DisplayName ?? provider.Name}' deleted.", "success");
        _confirmDeleteId = null;
        await ReloadAsync();
    }

    private async Task TestExistingAsync(SearchProvider provider)
    {
        _testingProviderId = provider.Id;
        try
        {
            var result = await SearchProviderService.TestAsync(provider);
            SetStatus(result.Message, result.Success ? "success" : "danger");
        }
        finally
        {
            _testingProviderId = null;
        }
    }

    private async Task TestNewAsync()
    {
        _testingNew = true;
        try
        {
            var result = await SearchProviderService.TestAsync(BuildProvider(_newProvider));
            SetStatus(result.Message, result.Success ? "success" : "danger");
        }
        catch (Exception ex)
        {
            SetStatus($"Test failed: {ex.Message}", "danger");
        }
        finally
        {
            _testingNew = false;
        }
    }

    private static SearchProvider BuildProvider(SearchProviderDraft draft) => new()
    {
        Name = draft.Name?.Trim() ?? string.Empty,
        DisplayName = string.IsNullOrWhiteSpace(draft.DisplayName) ? null : draft.DisplayName.Trim(),
        ProviderKind = draft.ProviderKind,
        ApiKey = draft.ApiKey?.Trim(),
        IsActive = draft.IsActive,
    };

    private static string ProviderKindLabel(SearchProviderKind kind) => kind switch
    {
        SearchProviderKind.SerpApi => "SerpApi",
        SearchProviderKind.Brave => "Brave Search",
        _ => kind.ToString(),
    };

    private void ToggleAdd() => _adding = !_adding;
    private void ToggleDelete(int id) => _confirmDeleteId = _confirmDeleteId == id ? null : id;
    private static string ProviderInitial(SearchProvider provider) =>
        (provider.DisplayName ?? provider.Name).Trim().FirstOrDefault().ToString().ToUpperInvariant();

    private void SetStatus(string message, string kind)
    {
        _statusMessage = message;
        _statusKind = kind;
    }

    private void ClearStatus() => _statusMessage = null;

    private sealed class SearchProviderDraft
    {
        public string? Name { get; set; }
        public string? DisplayName { get; set; }
        public SearchProviderKind ProviderKind { get; set; } = SearchProviderKind.SerpApi;
        public string? ApiKey { get; set; }
        public bool IsActive { get; set; }
    }
}
