<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <LorekeeperDistributionChannel Condition="'$(LorekeeperDistributionChannel)' == '' and '$(Configuration)' == 'Release'">Free</LorekeeperDistributionChannel>
    <LorekeeperDistributionChannel Condition="'$(LorekeeperDistributionChannel)' == ''">Development</LorekeeperDistributionChannel>
    <Title>Lorekeeper</Title>
    <Description>AI-assisted narrative coherence engine.</Description>
    <Version>0.3.17</Version>
    <PackageId>Lorekeeper</PackageId>
    <ElectronVersion>43.6.0</ElectronVersion>
    <ElectronBuilderVersion>26.15.3</ElectronBuilderVersion>
    <ElectronPackageId>com.lorekeeper.app</ElectronPackageId>
    <ElectronSingleInstance>true</ElectronSingleInstance>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">wwwroot\branding\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElectronNET.Core" Version="0.5.1" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.7" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lorekeeper.Tests" />
    <AssemblyMetadata Include="LorekeeperDistributionChannel" Value="$(LorekeeperDistributionChannel)" />
    <Content Include="ElectronHostHook\index.js" Link=".electron\ElectronHostHook\index.js" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="..\Lorekeeper.Press\assets\print-artifact-profiles-v1.json" Link="PrintArtifactProfiles\print-artifact-profiles-v1.json" />
    <EmbeddedResource Include="..\Lorekeeper.Press\assets\manuscript-typography-v2.json" Link="Typography\manuscript-typography-v2.json" />
  </ItemGroup>

  <Target Name="ValidateLorekeeperDistributionChannel" BeforeTargets="CoreCompile">
    <Error Condition="'$(LorekeeperDistributionChannel)' != 'Development' and '$(LorekeeperDistributionChannel)' != 'Free' and '$(LorekeeperDistributionChannel)' != 'Store'"
           Text="LorekeeperDistributionChannel must be Development, Free, or Store." />
  </Target>

  <!-- Keep the pinned connector/template metadata; replace only its empty hook. -->
  <Target Name="UseLorekeeperPrintHook" AfterTargets="ElectronResolvePaths">
    <ItemGroup>
      <Content Remove="$(ElectronSourceFilesPath)\ElectronHostHook\index.js" />
      <ContentWithTargetPath Remove="$(ElectronSourceFilesPath)\ElectronHostHook\index.js" />
      <FilesForPackagingFromProject Remove="$(ElectronSourceFilesPath)\ElectronHostHook\index.js" />
      <ElectronSourceFiles Remove="$(ElectronSourceFilesPath)\ElectronHostHook\index.js" />
      <ElectronSourceFilesWithTargetPath Remove="$(ElectronSourceFilesPath)\ElectronHostHook\index.js" />
    </ItemGroup>
  </Target>

  <Target Name="BuildLorekeeperPressRuntime" AfterTargets="Build">
    <PropertyGroup>
      <PressBuildConfiguration Condition="'$(Configuration)' == 'Release'">Release</PressBuildConfiguration>
      <PressBuildConfiguration Condition="'$(PressBuildConfiguration)' == ''">Debug</PressBuildConfiguration>
      <PressPowerShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell -ExecutionPolicy Bypass</PressPowerShell>
      <PressPowerShell Condition="'$(PressPowerShell)' == ''">pwsh</PressPowerShell>
    </PropertyGroup>
    <Exec Command="$(PressPowerShell) -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\eng\BuildPressRuntime.ps1&quot; -PressProjectDirectory &quot;$(MSBuildProjectDirectory)\..\Lorekeeper.Press&quot; -RuntimeDirectory &quot;$(TargetDir)press-runtime&quot; -Configuration $(PressBuildConfiguration)" />
  </Target>

  <Target Name="PrepareLorekeeperPressRuntimeForPublish" AfterTargets="CopyFilesToPublishDirectory">
    <PropertyGroup>
      <PressBuildConfiguration Condition="'$(Configuration)' == 'Release'">Release</PressBuildConfiguration>
      <PressBuildConfiguration Condition="'$(PressBuildConfiguration)' == ''">Debug</PressBuildConfiguration>
      <PressPowerShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell -ExecutionPolicy Bypass</PressPowerShell>
      <PressPowerShell Condition="'$(PressPowerShell)' == ''">pwsh</PressPowerShell>
    </PropertyGroup>
    <Exec Command="$(PressPowerShell) -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\eng\BuildPressRuntime.ps1&quot; -PressProjectDirectory &quot;$(MSBuildProjectDirectory)\..\Lorekeeper.Press&quot; -RuntimeDirectory &quot;$(PublishDir)press-runtime&quot; -Configuration $(PressBuildConfiguration)" />
  </Target>

</Project>
